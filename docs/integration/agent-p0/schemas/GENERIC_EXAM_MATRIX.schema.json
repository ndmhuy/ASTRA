{
  "$defs": {
    "Difficulty": {
      "enum": [
        "easy",
        "medium",
        "hard"
      ],
      "title": "Difficulty",
      "type": "string"
    },
    "LearningObjective": {
      "additionalProperties": false,
      "properties": {
        "id": {
          "maxLength": 100,
          "minLength": 1,
          "title": "Id",
          "type": "string"
        },
        "description": {
          "maxLength": 30000,
          "minLength": 1,
          "title": "Description",
          "type": "string"
        }
      },
      "required": [
        "id",
        "description"
      ],
      "title": "LearningObjective",
      "type": "object"
    },
    "QuestionType": {
      "enum": [
        "multiple_choice",
        "short_answer",
        "essay",
        "true_false"
      ],
      "title": "QuestionType",
      "type": "string"
    },
    "Topic": {
      "additionalProperties": false,
      "properties": {
        "id": {
          "maxLength": 100,
          "minLength": 1,
          "title": "Id",
          "type": "string"
        },
        "name": {
          "maxLength": 30000,
          "minLength": 1,
          "title": "Name",
          "type": "string"
        },
        "subtopics": {
          "items": {
            "maxLength": 100,
            "minLength": 1,
            "type": "string"
          },
          "maxItems": 100,
          "title": "Subtopics",
          "type": "array"
        },
        "learning_objectives": {
          "items": {
            "$ref": "#/$defs/LearningObjective"
          },
          "maxItems": 100,
          "title": "Learning Objectives",
          "type": "array"
        },
        "question_count": {
          "minimum": 0,
          "title": "Question Count",
          "type": "integer"
        },
        "points": {
          "anyOf": [
            {
              "minimum": 0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Points"
        }
      },
      "required": [
        "id",
        "name",
        "question_count"
      ],
      "title": "Topic",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "subject": {
      "maxLength": 30000,
      "minLength": 1,
      "title": "Subject",
      "type": "string"
    },
    "title": {
      "maxLength": 30000,
      "minLength": 1,
      "title": "Title",
      "type": "string"
    },
    "topics": {
      "items": {
        "$ref": "#/$defs/Topic"
      },
      "maxItems": 200,
      "minItems": 1,
      "title": "Topics",
      "type": "array"
    },
    "question_count": {
      "exclusiveMinimum": 0,
      "maximum": 500,
      "title": "Question Count",
      "type": "integer"
    },
    "question_type_distribution": {
      "additionalProperties": {
        "minimum": 0,
        "type": "integer"
      },
      "propertyNames": {
        "$ref": "#/$defs/QuestionType"
      },
      "title": "Question Type Distribution",
      "type": "object"
    },
    "difficulty_distribution": {
      "additionalProperties": {
        "minimum": 0,
        "type": "integer"
      },
      "propertyNames": {
        "$ref": "#/$defs/Difficulty"
      },
      "title": "Difficulty Distribution",
      "type": "object"
    },
    "total_points": {
      "exclusiveMinimum": 0,
      "title": "Total Points",
      "type": "number"
    },
    "points_by_type": {
      "anyOf": [
        {
          "additionalProperties": {
            "minimum": 0,
            "type": "number"
          },
          "propertyNames": {
            "$ref": "#/$defs/QuestionType"
          },
          "type": "object"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Points By Type"
    },
    "duration_minutes": {
      "exclusiveMinimum": 0,
      "maximum": 1440,
      "title": "Duration Minutes",
      "type": "integer"
    },
    "additional_constraints": {
      "items": {
        "maxLength": 30000,
        "minLength": 1,
        "type": "string"
      },
      "maxItems": 100,
      "title": "Additional Constraints",
      "type": "array"
    }
  },
  "required": [
    "subject",
    "title",
    "topics",
    "question_count",
    "question_type_distribution",
    "difficulty_distribution",
    "total_points",
    "duration_minutes"
  ],
  "title": "ExamMatrix",
  "type": "object",
  "$schema": "https://json-schema.org/draft/2020-12/schema"
}
