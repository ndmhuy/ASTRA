# ============================================================
# ASTRA Frontend — Environment Config Example
# ============================================================
# Chế độ chạy: "mock" (offline demo) hoặc "api" (kết nối backend thật)
VITE_SERVICE_MODE=mock

# URL backend thật (chỉ dùng khi VITE_SERVICE_MODE=api)
# Ví dụ: http://localhost:8000 hoặc https://astra-backend.yourserver.com
VITE_API_BASE_URL=http://localhost:8000/api
