# Copy to .env.local in this directory. The local file is git-ignored.
AGENT_HOST=127.0.0.1
AGENT_PORT=8010
AGENT_ALLOWED_ORIGINS=http://127.0.0.1:5173,http://localhost:5173
# gemini = every interpretation calls Gemini and fails explicitly if the provider is unavailable.
AGENT_MODE=gemini
GEMINI_MODEL=gemini-3.1-flash-lite
GEMINI_API_KEY=
# For an explicitly labelled deterministic demo with no network inference:
# AGENT_MODE=offline
