# start.cmd opens the key dialog; no need to copy this file.
# The app writes these four values to the ignored root .env when you press Save.
# The same Claude/Anthropic credential is used for Chat and exam generation.
EXAM_PROVIDER=anthropic
EXAM_MODEL=nghi/claude-haiku-4.5
ANTHROPIC_API_KEY=
EXAM_BASE_URL=https://api.nghimmo.com/v1

# Existing academic/runtime settings remain available. These are not API probes.
EXAM_PROMPT_VERSION=v1
EXAM_MAX_PROMPT_CHARS=200000
EXAM_TIMEOUT_SECONDS=90
EXAM_MAX_OUTPUT_TOKENS=8192
EXAM_SUPPORTS_IMAGES=false
EXAM_UI_OUTPUT_ROOT=runs/ui
EXAM_RAG_CORPUS_REF=8b8fb7b09182b3d9d1eee0b95818027f52ab004d
# EXAM_RAG_PACK_DIR=data/profile-pack
EXAM_LATEX_TIMEOUT_SECONDS=300
EXAM_LATEX_CACHE_DIR=runs/latex-cache
# EXAM_LATEX_COMPILER=

# Native Anthropic Messages carries the original academic schema as a tool input.
# EXAM_SCHEMA_AS_TOOL remains an option for separate legacy Chat Completions runs.

# Optional application estimate guard; omitted by default. No request allowance
# or two-hour window is imposed by the local connection flow.
# EXAM_SPEND_LIMIT_USD=
# EXAM_INPUT_PRICE_PER_MILLION=
# EXAM_OUTPUT_PRICE_PER_MILLION=
# EXAM_SPEND_LEDGER=runs/provider-spend.sqlite3
# EXAM_SPEND_BUDGET_ID=
# EXAM_EVALUATION_JSONL=
# EXAM_TEMPERATURE=
# EXAM_SEED=
