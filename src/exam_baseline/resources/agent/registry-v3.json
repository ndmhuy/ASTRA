        "value": "string"
      }
    },
    "PAUSE_GENERATION": {
      "purpose": "Request a cooperative durable generation pause",
      "args": {
        "title": "string?"
      }
    },
    "RESUME_GENERATION": {
      "purpose": "Resume the same paused/interrupted generation job",
      "args": {
        "title": "string?"
      }
    },
    "RETRY_GENERATION": {
      "purpose": "Explicitly retry unfinished saved academic work",
      "args": {
        "title": "string?"
      }
    },
    "CANCEL_GENERATION": {
      "purpose": "Stop the current generation execution",
      "args": {
        "title": "string?"
      }
    },
    "RECOVERABLE_JOBS": {
      "purpose": "Inspect paused or interrupted generation jobs",
      "args": {}
    },
    "OPEN_HISTORY": {
      "purpose": "Open the existing exam version history",
      "args": {}
    },
    "EXPORT_DOCUMENT": {
      "purpose": "Use the existing approved student Word/Markdown export",
      "args": {
        "format": "docx|md"
      }
    },
    "ITEM_REGENERATION_STATUS": {
      "purpose": "Read the actual question-regeneration operation status",
      "args": {}
    },
    "STOP_ITEM_REGENERATION": {
      "purpose": "Stop only the active question-regeneration operation",
      "args": {}
    },
    "LIST_VERSIONS": {
      "purpose": "List actual versions and change records",
      "args": {}
    },
    "INSPECT_VERSION": {
      "purpose": "Read stored version without restoring",
      "args": {
        "version": "integer?",
        "relative": "initial|previous?",
        "title": "string?"
      }
    },
    "RESTORE_VERSION": {
      "purpose": "Restore an explicitly resolved stored version",
      "args": {
        "version": "integer?",
        "relative": "initial|previous?",
        "title": "string?"
      }
    },
    "UNDO_CHANGE": {
      "purpose": "Undo the latest eligible actual change",
      "args": {}
    },
    "LIST_DOCUMENTS": {
      "purpose": "List workspace attachment metadata and available preview",
