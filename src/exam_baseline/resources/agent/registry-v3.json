        "name": "string?"
      }
    },
    "DETACH_DOCUMENT": {
      "purpose": "Detach one uniquely named document from this workspace",
      "args": {
        "name": "string"
      }
    },
    "UPLOAD_GUIDANCE": {
      "purpose": "Explain the existing user-gesture file upload path",
      "args": {}
    },
    "SAVE_EDITOR": {
      "purpose": "Save the current question editor draft through existing validation",
      "args": {}
    },
    "APPROVE_QUESTION": {
      "purpose": "Approve one eligible question at the current revision",
      "args": {
        "number": "integer?",
        "part": "string?"
      }
    },
    "EXPORT_ARTIFACT": {
      "purpose": "Download the requested approved student, teacher key, or matrix artifact",
      "args": {
        "artifact": "student|teacher|matrix",
        "format": "pdf|tex|json|docx|md"
      }
