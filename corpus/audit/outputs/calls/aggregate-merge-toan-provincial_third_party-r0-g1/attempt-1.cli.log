ion": "Cho bảng lớp và tần số; xác định vị trí phân vị, tìm lớp chứa rồi nội suy bằng cận lớp, độ rộng lớp và tần số tích lũy trước lớp.", "wrong_options": "Dùng trung điểm lớp thay giá trị nội suy; các nhiễu còn lại chưa đủ căn cứ gán lỗi cụ thể.", "difficulty_source": "Phân biệt tìm lớp chứa với tính giá trị phân vị.", "discrimination": "low", "typical_steps": 3, "refs": ["54e9a2a276ca|P1|9|None"]}, {"part_kind": "multiple_choice", "topic": "Vectơ chỉ phương của đường thẳng", "grade": 12, "construction": "Cho các điểm xác định đường thẳng hoặc phương trình chính tắc; lập hay đọc vectơ chỉ phương rồi chọn vectơ cùng phương khác không.", "wrong_options": "Dùng tổng tọa độ, vectơ vị trí, bỏ dấu hoặc đổi dấu không đồng bộ.", "difficulty_source": "Giữ nhất quán phép trừ và nhận ra vectơ chỉ phương có thể được nhân với hệ số chung.", "discrimination": "low", "typical_steps": 2, "refs": ["54e9a2a276ca|P1|10|None", "0968e8bc9e2d|P1|2|None"]}, {"part_kind": "multiple_choice", "topic": "Phương trình mặt phẳng tọa độ", "grade": 12, "construction": "Cho mặt phẳng được xác định bởi các trục tọa độ; tìm tọa độ luôn triệt tiêu rồi đối chiếu phương trình.", "wrong_options": "Các lựa chọn thay tọa độ triệt tiêu hoặc chỉ bảo đảm đi qua gốc; chưa xác nhận phương án sai theo khóa.", "difficulty_source": "Liên hệ tên mặt phẳng với tọa độ vuông góc với nó.", "discrimination": "low", "typical_steps": 2, "refs": ["fc12a8146279|P1|10|None"]}, {"part_kind": "multiple_choice", "topic": "Phương trình mặt phẳng theo đoạn chắn", "grade": 12, "construction": "Cho các giao điểm với trục tọa độ; đọc đoạn chắn có dấu, lập dạng phương trình tương ứng rồi đối chiếu.", "wrong_options": "Hoán đổi trục, bỏ dấu đoạn chắn hoặc dùng sai vế hằng.", "difficulty_source": "Gắn đúng đoạn chắn với biến tọa độ.", "discrimination": "low", "typical_steps": 3, "refs": ["54e9a2a276ca|P1|11|None"]}, {"part_kind": "multiple_choice", "topic": "Điểm thuộc đường thẳng không gian", "grade": 12, "construction": "Cho phương trình chính tắc và các điểm ứng viên; đọc điểm gốc, vectơ chỉ phương rồi kiểm tra các tọa độ ứng với cùng tham số.", "wrong_options": "Các bộ tọa độ đổi dấu hoặc trộn điểm gốc với vectơ chỉ phương; chưa xác nhận lỗi của từng phương án.", "difficulty_source": "Đọc đúng dấu và kiểm tra đồng thời các tọa độ.", "discrimination": "low", "typical_steps": 3, "refs": ["fc12a8146279|P1|11|None"]}, {"part_kind": "multiple_choice", "topic": "Lập phương trình mặt cầu", "grade": 12, "construction": "Cho tâm và đường kính; chuyển sang bán kính, lập tổng bình phương hiệu tọa độ và đối chiếu vế phải.", "wrong_options": "Các lựa chọn biến đổi dấu tâm hoặc đại lượng biểu diễn kích thước; cơ chế sai cụ thể chưa được khóa xác nhận.", "difficulty_source": "Phân biệt đường kính, bán kính và bình phương bán kính.", "discrimination": "low", "typical_steps": 3, "refs": ["fc12a8146279|P1|12|None"]}, {"part_kind": "multiple_choice", "topic": "Số hạng tổng quát của cấp số nhân", "grade": 11, "construction": "Cho dữ kiện về số hạng và công bội; viết số hạng tổng quát, lập phương trình lũy thừa rồi tìm chỉ số hoặc công bội còn thiếu.", "wrong_options": "Lệch chỉ số, đảo tỉ số, hiệu chỉnh chỉ số thừa hoặc chọn dấu công bội không phù hợp.", "difficulty_source": "Phân biệt vị trí số hạng với số lần nhân công bội.", "discrimination": "low", "typical_steps": 3, "refs": ["54e9a2a276ca|P1|12|None", "0968e8bc9e2d|P1|5|None"]}, {"part_kind": "multiple_choice", "topic": "Nguyên hàm cơ bản", "grade": 12, "construction": "Cho hàm sơ cấp và các họ hàm; nhận diện công thức, xử lý hệ số từng hạng tử rồi giữ hằng số tùy ý.", "wrong_options": "Sai hệ số nguyên hàm hoặc bỏ đóng góp của hằng số; với hàm mũ, các biến đổi cơ số và vai trò biến mới là dấu hiệu nghi vấn khi thiếu khóa.", "difficulty_source": "Áp dụng đúng hệ số trong bảng nguyên hàm.", "discrimination": "low", "typical_steps": 2, "refs": ["fc12a8146279|P1|8|None", "0968e8bc9e2d|P1|7|None"]}, {"part_kind": "multiple_choice", "topic": "Hình chiếu vuông góc của đoạn thẳng", "grade": 11, "construction": "Cho hình không gian có đường cao; giữ đầu mút thuộc mặt phẳng chiếu, tìm chân chiếu của đầu mút còn lại rồi nối các ảnh.", "wrong_options": "Chiếu lên sai mặt phẳng, thay điểm vốn phải giữ nguyên hoặc nhầm phương chiếu với đoạn ảnh.", "difficulty_source": "Theo dõi riêng ảnh của từng đầu mút.", "discrimination": "medium", "typical_steps": 3, "refs": ["0968e8bc9e2d|P1|8|None"]}, {"part_kind": "true_false", "topic": "Điểm thuộc đồ thị hàm phân thức", "grade": 10, "construction": "Cho hàm phân thức và điểm đề xuất; kiểm tra miền xác định, thay hoành độ rồi so tung độ.", "wrong_options": "Chưa xác định phát biểu sai; cần kiểm tra điều kiện mẫu và việc thay tọa độ.", "difficulty_source": "Không bỏ điều kiện xác định khi thế trực tiếp.", "discrimination": "low", "typical_steps": 3, "refs": ["fc12a8146279|P2|1|a"]}, {"part_kind": "true_false", "topic": "Tiệm cận xiên của hàm phân thức", "grade": 12, "construction": "Cho phân thức và đường thẳng đề xuất; chia đa thức, xét phần dư ở vô cực rồi kiểm tra đường thẳng.", "wrong_options": "Chưa xác định phát biểu sai; thương đầy đủ của phép chia là yếu tố cần kiểm tra.", "difficulty_source": "Tách phần tuyến tính khỏi phần tiến về không.", "discrimination": "low", "typical_steps": 3, "refs": ["fc12a8146279|P2|1|b"]}, {"part_kind": "true_false", "topic": "Tâm đối xứng của đồ thị", "grade": 12, "construction": "Cho hàm số và tâm đề xuất; xác định điểm đặc trưng tạo đối xứng bằng giao tiệm cận hoặc điểm uốn, tính đủ tọa độ rồi đối chiếu.", "wrong_options": "Nhận định có khóa là đúng; phần thiếu khóa chỉ cho phép nêu yêu cầu kiểm tra đủ tọa độ, không kết luận lỗi.", "difficulty_source": "Chọn công cụ xác định tâm theo loại hàm.", "discrimination": "medium", "typical_steps": 3, "refs": ["fc12a8146279|P2|1|c", "54e9a2a276ca|P2|1|c"]}, {"part_kind": "true_false", "topic": "Tiếp tuyến và tổ hợp hệ số", "grade": 11, "construction": "Cho hàm số, hoành độ tiếp xúc và quan hệ giữa hệ số; tính giá trị hàm, đạo hàm, lập tiếp tuyến rồi tính tổ hợp được hỏi.", "wrong_options": "Chưa xác định phát biểu sai; cần phân biệt giá trị hàm, hệ số góc và hệ số tự do.", "difficulty_source": "Giữ dấu qua đạo hàm và khai triển tiếp tuyến.", "discrimination": "medium", "typical_steps": 4, "refs": ["fc12a8146279|P2|1|d"]}, {"part_kind": "true_false", "topic": "Đạo hàm đa thức", "grade": 11, "construction": "Cho đa thức và đạo hàm đề xuất; lấy đạo hàm từng hạng tử rồi đối chiếu.", "wrong_options": "Giữ lại biến khi đạo hàm hạng tử bậc nhất.", "difficulty_source": "Thực hiện đúng quy tắc giảm bậc.", "discrimination": "low", "typical_steps": 2, "refs": ["54e9a2a276ca|P2|1|a"]}, {"part_kind": "true_false", "topic": "Kiểm tra tính biến thiên và hình đồ thị", "grade": 12, "construction": "Cho hàm đa thức và nhận định bằng lời hoặc hình; tính đạo hàm, xác định dấu hay cực trị rồi đối chiếu các đặc trưng quyết định.", "wrong_options": null, "difficulty_source": "Chọn đúng đặc trưng cần kiểm tra thay vì dựng lại toàn bộ đồ thị.", "discrimination": "low", "typical_steps": 3, "refs": ["54e9a2a276ca|P2|1|b", "54e9a2a276ca|P2|1|d"]}, {"part_kind": "true_false", "topic": "Khôi phục lượng tích lũy từ tốc độ", "grade": 12, "construction": "Cho tốc độ gồm thành phần hằng và mũ; lấy nguyên hàm theo từng thành phần, điều chỉnh hệ số đối số và dùng điều kiện ban đầu nếu yêu cầu một hàm tích lũy xác định.", "wrong_options": "Phát biểu có khóa là đúng; phần thiếu khóa yêu cầu kiểm tra hệ số và dấu, chưa xác nhận phát biểu sai.", "difficulty_source": "Phân biệt họ nguyên hàm với hàm được xác định bởi điều kiện ban đầu.", "discrimination": "low", "typical_steps": 3, "refs": ["fc12a8146279|P2|2|a", "54e9a2a276ca|P2|2|a"]}, {"part_kind": "true_false", "topic": "Hiệu chỉnh tham số bằng lượng tích lũy", "grade": 12, "construction": "Cho tốc độ chứa tham số và tổng lượng trên khoảng; lập tích phân, giải phương trình tham số rồi làm tròn để kiểm tra.", "wrong_options": "Phát biểu có khóa là đúng; với phần thiếu khóa, cần kiểm tra việc dùng tổng lượng thay vì tốc độ tức thời và tránh làm tròn sớm.", "difficulty_source": "Chuyển dữ kiện tích lũy thành phương trình.", "discrimination": "medium", "typical_steps": 3, "refs": ["fc12a8146279|P2|2|b", "54e9a2a276ca|P2|2|b"]}, {"part_kind": "true_false", "topic": "So sánh lượng tích lũy trên khoảng con", "grade": 12, "construction": "Cho mô hình tốc độ được hiệu chỉnh bởi tổng lượng; giữ tham số đủ chính xác, tích phân trên khoảng con rồi so với ngưỡng.", "wrong_options": "Phát biểu sai đã xác nhận khai thác việc chia đều tổng lượng theo thời gian dù tốc độ thay đổi.", "difficulty_source": "Chọn đúng khoảng và phân biệt tốc độ biến thiên với phân bố đều.", "discrimination": "medium", "typical_steps": 3, "refs": ["fc12a8146279|P2|2|c", "54e9a2a276ca|P2|2|c"]}, {"part_kind": "true_false", "topic": "Giá trị trung bình của tốc độ", "grade": 12, "construction": "Cho tốc độ và dữ kiện hiệu chỉnh mô hình; tính lượng trên khoảng cần xét, chia độ dài khoảng rồi làm tròn.", "wrong_options": "Phát biểu có khóa là đúng; phần thiếu khóa cần kiểm tra nhầm lẫn giữa trung bình trên khoảng và giá trị tại thời điểm.", "difficulty_source": "Giữ đúng khoảng lấy trung bình và độ chính xác trung gian.", "discrimination": "medium", "typical_steps": 4, "refs": ["fc12a8146279|P2|2|d", "54e9a2a276ca|P2|2|d"]}, {"part_kind": "true_false", "topic": "Xác suất biến cố đối", "grade": 10, "construction": "Cho tỉ lệ của nhóm trong một phân hoạch bổ sung; nhận diện phần bù rồi tính xác suất nhóm còn lại.", "wrong_options": "Chưa xác định phát biểu sai.", "difficulty_source": "Đọc đúng quan hệ bổ sung trong cùng quần thể.", "discrimination": "low", "typical_steps": 3, "refs": ["fc12a8146279|P2|3|a"]}, {"part_kind": "true_false", "topic": "Biến cố đối trong xác suất có điều kiện", "grade": 12, "construction": "Cho xác suất kết quả trong nhóm; giữ nguyên nhóm điều kiện rồi lấy phần bù để kiểm tra kết quả đối.", "wrong_options": "Lấy phần bù của xác suất thuộc nhóm điều kiện khác; phần thiếu khóa chưa cho phép kết luận phát biểu sai.", "difficulty_source": "Không đổi không gian điều kiện khi lấy phần bù.", "discrimination": "low", "typical_steps": 3, "refs": ["fc12a8146279|P2|3|b", "54e9a2a276ca|P2|3|c"]}, {"part_kind": "true_false", "topic": "Xác suất toàn phần", "grade": 12, "construction": "Cho tỉ lệ nhóm và xác suất kết quả trong từng nhóm; hoàn thiện dữ kiện bằng phần bù nếu cần, nhân theo nhánh rồi cộng các nhánh loại trừ.", "wrong_options": "Phát biểu có khóa là đúng; phần thiếu khóa cần kiểm tra việc dùng trọng số nhóm thay vì trung bình không trọng số.", "difficulty_source": "Ghép đúng xác suất nhóm với xác suất có điều kiện tương ứng.", "discrimination": "medium", "typical_steps": 3, "refs": ["fc12a8146279|P2|3|c", "54e9a2a276ca|P2|3|a"]}, {"part_kind": "true_false", "topic": "Đảo điều kiện bằng công thức Bayes", "grade": 12, "construction": "Cho tỉ lệ nhóm và kết quả theo nhóm; tính xác suất giao, tính xác suất kết quả bằng toàn phần rồi chuẩn hóa để kiểm tra giá trị hoặc ngưỡng.", "wrong_options": "Phát biểu có khóa là đúng; phần thiếu khóa cần kiểm tra việc hoán đổi trực tiếp chiều điều kiện hoặc dùng sai mẫu số.", "difficulty_source": "Đổi quần thể điều kiện và chuẩn hóa lại.", "discrimination": "medium", "typical_steps": 4, "refs": ["fc12a8146279|P2|3|d", "54e9a2a276ca|P2|3|b"]}, {"part_kind": "true_false", "topic": "Chọn nhiều đối tượng sau khi điều kiện hóa", "grade": 12, "construction": "Cho tỉ lệ phân nhóm và yêu cầu có ít nhất một đối tượng mang thuộc tính; đổi quần thể điều kiện rồi xét biến cố đối. Bước nhân xác suất chỉ hợp lệ khi cơ chế chọn bảo đảm độc lập; hàng dữ liệu chưa bảo đảm điều này.", "wrong_options": null, "difficulty_source": "Phân biệt điều kiện hóa với giả thiết độc lập. Mức phân hóa dưới đây chỉ áp dụng cho cấu trúc sau khi cơ chế chọn được làm rõ.", "discrimination": "medium", "typical_steps": 4, "refs": ["54e9a2a276ca|P2|3|d"]}, {"part_kind": "true_false", "topic": "Biểu diễn và định vị trên quỹ đạo thẳng", "grade": 12, "construction": "Cho các vị trí xác định quỹ đạo; lập vectơ chỉ phương và phương trình tham số. Kiểm tra biểu diễn hoặc dùng độ cao đã đổi đơn vị để tìm tham số, suy vị trí và kiểm tra đoạn chuyển động.", "wrong_options": "Thiếu khóa phù hợp nên chưa xác định phát biểu sai hoặc lỗi gây nhiễu.", "difficulty_source": "Phối hợp điểm gốc, hướng, đơn vị và miền tham số.", "discrimination": "low", "typical_steps": 4, "refs": ["fc12a8146279|P2|4|a", "fc12a8146279|P2|4|b"]}, {"part_kind": "true_false", "topic": "Giao quỹ đạo thẳng với mặt phẳng", "grade": 12, "construction": "Cho quỹ đạo và các giao trục của mặt phẳng; lập phương trình mặt phẳng, thế tham số đường thẳng, kiểm tra đoạn chuyển động rồi lấy tọa độ cần hỏi.", "wrong_options": "Thiếu khóa phù hợp nên chưa gán lỗi cho nhận định.", "difficulty_source": "Nối biểu diễn đoạn chắn với biểu diễn tham số.", "discrimination": "medium", "typical_steps": 4, "refs": ["fc12a8146279|P2|4|c"]}, {"part_kind": "true_false", "topic": "Điều kiện khoảng cách trên đoạn quỹ đạo", "grade": 12, "construction": "Cho quỹ đạo, miền che khuất, giới hạn độ cao và cự ly; xác định đoạn được phép, biểu diễn khoảng cách theo tham số, xét biến thiên rồi so ngưỡng.", "wrong_options": "Thiếu khóa phù hợp nên chưa gán lỗi cho nhận định.", "difficulty_source": "Áp dụng điều kiện khoảng cách trên đúng đoạn còn thỏa các giới hạn.", "discrimination": "medium", "typical_steps": 5, "refs": ["fc12a8146279|P2|4|d"]}, {"part_kind": "true_false", "topic": "Đọc tâm và bán kính mặt cầu", "grade": 12, "construction": "Cho phương trình chính tắc; đọc dấu tọa độ tâm, lấy căn hằng số để tìm bán kính rồi đối chiếu.", "wrong_options": "Đồng nhất bán kính với bình phương bán kính.", "difficulty_source": "Hiểu ý nghĩa hình học của các thành phần phương trình.", "discrimination": "low", "typical_steps": 3, "refs": ["54e9a2a276ca|P2|4|a"]}, {"part_kind": "true_false", "topic": "Tiếp tuyến và giao cắt mặt cầu", "grade": 12, "construction": "Cho mặt cầu và đối tượng ngoài; tính khoảng cách thích hợp rồi dùng quan hệ với bán kính để kiểm tra độ dài tiếp tuyến hoặc vị trí tương đối của đường thẳng.", "wrong_options": null, "difficulty_source": "Chọn đúng khoảng cách và chuyển diễn đạt ngữ cảnh thành quan hệ hình học.", "discrimination": "medium", "typical_steps": 3, "refs": ["54e9a2a276ca|P2|4|b", "54e9a2a276ca|P2|4|c"]}, {"part_kind": "true_false", "topic": "Tâm đường tròn tiếp điểm", "grade": 12, "construction": "Cho mặt cầu và điểm ngoài; dùng vuông góc tại tiếp điểm để tìm mặt phẳng quỹ tích, đặt tâm đường tròn trên đường nối tâm cầu với điểm ngoài rồi dùng hình chiếu để tính tọa độ.", "wrong_options": null, "difficulty_source": "Phát hiện mặt phẳng tiếp điểm và vị trí tâm quỹ tích trước khi tính.", "discrimination": "high", "typical_steps": 4, "refs": ["54e9a2a276ca|P2|4|d"]}, {"part_kind": "short_answer", "topic": "Thể tích từ góc và hình phụ", "grade": 11, "construction": "Cho góc không gian cùng dữ kiện đáy hoặc tiết diện; dựng hình phụ vuông góc, chuyển góc thành quan hệ độ dài, suy chiều cao thích hợp rồi tính thể tích trực tiếp hoặc qua khối phụ.", "wrong_options": null, "difficulty_source": "Chọn đúng chiều cao và nhận ra quan hệ thể tích khi mặt phẳng đã cho không phải đáy tự nhiên.", "discrimination": "high", "typical_steps": 5, "refs": ["fc12a8146279|P3|1|None", "54e9a2a276ca|P3|2|None"]}, {"part_kind": "short_answer", "topic": "Truy hồi tài chính và ngưỡng kỳ nguyên", "grade": 11, "construction": "Cho lượng ban đầu, tăng trưởng theo kỳ và khoản giảm định kỳ; xác định thứ tự cập nhật, lập truy hồi, dùng tổng cấp số nhân rồi tìm kỳ nguyên đầu tiên thỏa ngưỡng và kiểm tra kỳ trước.", "wrong_options": null, "difficulty_source": "Mô hình hóa lịch cập nhật và xử lý kỳ cuối không trọn mức.", "discrimination": "medium", "typical_steps": 5, "refs": ["fc12a8146279|P3|2|None"]}, {"part_kind": "short_answer", "topic": "Đếm cấu hình dưới ràng buộc đồng thời", "grade": [10, 11], "construction": "Cho cấu hình vị trí hoặc phân phối có nhiều giới hạn; chuyển điều kiện thành trạng thái, quan hệ đại số hoặc biến nguyên, phân loại theo yếu tố quyết định rồi đếm và ghép các phần hợp lệ. Nếu hỏi xác suất, cần xác lập không gian đồng khả năng trước khi chia.", "wrong_options": null, "difficulty_source": "Giữ đồng thời điều kiện kề nhau, không lặp, thứ tự vị trí hoặc chặn từng biến; tránh đếm thiếu và đếm lặp. Mô hình đồng khả năng của hàng tô ô là cách hiểu được nêu trong dữ liệu, chưa được đề phát biểu riêng.", "discrimination": "high", "typical_steps": 5, "refs": ["fc12a8146279|P3|3|None", "fc12a8146279|P3|6|None", "54e9a2a276ca|P3|4|None"]}, {"part_kind": "short_answer", "topic": "Tối ưu bằng mô hình mục tiêu và miền khả thi", "grade": [10, 12], "construction": "Cho lợi ích, chi phí hoặc nguồn lực; đặt biến, lập mục tiêu và ràng buộc, tìm vùng tối ưu bằng đạo hàm hoặc miền nghiệm tuyến tính rồi kiểm tra biên và tính nguyên khi đối tượng phải đếm.", "wrong_options": null, "difficulty_source": "Phân biệt đại lượng đơn vị với tổng, đưa đủ thành phần vào mục tiêu và không dừng ở nghiệm liên tục khi cần nghiệm nguyên.", "discrimination": "medium", "typical_steps": 5, "refs": ["fc12a8146279|P3|4|None", "54e9a2a276ca|P3|1|None", "54e9a2a276ca|P3|6|None"]}, {"part_kind": "short_answer", "topic": "Tích phân thể tích của phần khối được chọn", "grade": 12, "construction": "Cho hình và kích thước của vật thể có phần lõm hoặc bị cắt; chọn tọa độ hay họ tiết diện, biểu diễn biên, xác định miền cần giữ rồi tích phân diện tích tiết diện hoặc trừ phần khuyết.", "wrong_options": null, "difficulty_source": "Tự xây dựng hàm tiết diện và cận từ hình học, tránh tính nhầm cả phần không thuộc vật thể.", "discrimination": "high", "typical_steps": 5, "refs": ["fc12a8146279|P3|5|None", "54e9a2a276ca|P3|5|None"]}], "additional_local_observation": {"part_kind": "short_answer", "topic": "Tối ưu đường đi có tiếp xúc và chuyển động trên mặt cầu", "grade": 12, "construction": "Cho điểm ngoài, mặt cầu, điểm đích và tốc độ từng chặng; nhận ra đoạn tiếp tuyến có độ dài bất biến, quy phần tối ưu về chọn tiếp điểm rồi dùng góc ở tâm để tính cung ngắn nhất và tổng thời gian.", "wrong_options": null, "difficulty_source": "Tách phần bất biến khỏi phần cần tối ưu và dùng đúng khoảng cách trên mặt cầu. Dữ liệu có diễn đạt chuyển động chưa hoàn toàn nhất quán; phân tích dựa vào điều kiện tiếp tuyến tường minh.", "discrimination": "high", "typical_steps": 5, "refs": ["54e9a2a276ca|P3|3|None"], "evidence_status": "Quan sát riêng, chưa có bằng chứng tái diễn."}, "discrimination_moves": [{"move": "Dựng biểu diễn trung gian trước khi tính", "how_to_apply": "Cho dữ kiện hình học đủ xác định nhưng chưa có sẵn hàm tiết diện hoặc chiều cao cần dùng; buộc người giải chọn hình phụ, hệ tọa độ hay mặt cắt. Đây là cách xây độ khó xuất hiện qua các mã đề khác nhau.", "refs": ["fc12a8146279|P3|5|None", "54e9a2a276ca|P3|2|None", "54e9a2a276ca|P3|5|None"]}, {"move": "Buộc giữ nhiều ràng buộc trong cùng phép đếm", "how_to_apply": "Kết hợp điều kiện cục bộ của từng vị trí với điều kiện toàn cấu hình; yêu cầu phân loại có hệ thống rồi kiểm tra trùng lặp. Có bằng chứng qua các mã đề khác nhau.", "refs": ["fc12a8146279|P3|3|None", "fc12a8146279|P3|6|None", "54e9a2a276ca|P3|4|None"]}, {"move": "Tìm yếu tố chung để tổ chức trường hợp", "how_to_apply": "Đặt các điều kiện giao nhau tại một thành phần chung hoặc quy mọi phương án về cùng một nhóm biến; xác định khả năng của thành phần đó trước khi đếm phần còn lại. Sự kết hợp cụ thể giữa cấp số nhân và ô chung là quan sát riêng.", "refs": ["fc12a8146279|P3|6|None", "54e9a2a276ca|P3|4|None"]}, {"move": "Phân biệt toàn khối với đúng phần khối được hỏi", "how_to_apply": "Để hình ngoài dễ nhận diện nhưng phần cần tính có miền bị loại hoặc mặt cắt lệch; người giải phải xác định miền trước khi áp công thức tích phân. Có bằng chứng qua các mã đề khác nhau.", "refs": ["fc12a8146279|P3|5|None", "54e9a2a276ca|P3|5|None"]}, {"move": "Suy cấu trúc quỹ tích từ điều kiện tiếp xúc", "how_to_apply": "Dùng vuông góc tại tiếp điểm để tìm mặt phẳng quỹ tích, sau đó mới xác định tâm hoặc tối ưu đường đi. Chỉ là quan sát trong cùng mã đề.", "refs": ["54e9a2a276ca|P2|4|d", "54e9a2a276ca|P3|3|None"]}, {"move": "Loại phần bất biến để giảm bài toán tối ưu", "how_to_apply": "Thiết kế mục tiêu gồm phần không phụ thuộc lựa chọn và phần còn biến thiên; lời giải mạnh nhận ra phần bất biến rồi chỉ tối ưu phần còn lại. Đây là quan sát riêng.", "refs": ["54e9a2a276ca|P3|3|None"]}], "easy_vs_hard": [{"topic": "Tích phân và hình học", "easy": "Đồ thị đã thể hiện các miền; người giải chỉ chuyển diện tích sang đóng góp có dấu.", "hard": "Người giải phải tự chọn mặt cắt, biểu diễn biên và loại phần không thuộc vật thể trước khi tích phân.", "easy_refs": ["54e9a2a276ca|P1|4|None"], "hard_refs": ["fc12a8146279|P3|5|None", "54e9a2a276ca|P3|5|None"]}, {"topic": "Cấp số nhân", "easy": "Dùng số hạng tổng quát để tìm công bội hoặc chỉ số.", "hard": "Dùng quan hệ giữa các số hạng làm điều kiện cho phép đếm có ô chung, thứ tự và ràng buộc không lặp.", "easy_refs": ["54e9a2a276ca|P1|12|None", "0968e8bc9e2d|P1|5|None"], "hard_refs": ["fc12a8146279|P3|6|None"]}, {"topic": "Mặt cầu", "easy": "Đọc tâm, bán kính hoặc lập phương trình từ thông số hình học.", "hard": "Suy mặt phẳng tiếp điểm, tâm quỹ tích hoặc tối ưu cung dưới ràng buộc tiếp xúc.", "easy_refs": ["fc12a8146279|P1|12|None", "54e9a2a276ca|P2|4|a"], "hard_refs": ["54e9a2a276ca|P2|4|d", "54e9a2a276ca|P3|3|None"]}, {"topic": "Xác suất", "easy": "Lấy phần bù trong quần thể hoặc nhóm điều kiện đã xác định.", "hard": "Tự tổ chức không gian cấu hình và đếm biến cố chịu nhiều ràng buộc trước khi lập tỉ số xác suất.", "easy_refs": ["fc12a8146279|P2|3|a", "fc12a8146279|P2|3|b", "54e9a2a276ca|P2|3|c"], "hard_refs": ["fc12a8146279|P3|3|None"]}, {"topic": "Hình học không gian", "easy": "Kiểm tra tiêu chuẩn vuông góc từ quan hệ nền đã cho.", "hard": "Chọn khối phụ và suy khoảng cách tới mặt phẳng để chuyển góc thành chiều cao phục vụ tính thể tích.", "easy_refs": ["54e9a2a276ca|P1|1|None", "0968e8bc9e2d|P1|1|None"], "hard_refs": ["54e9a2a276ca|P3|2|None"]}], "fact_use": {"common": [{"use": "Tri thức ghi nhớ là công thức và định nghĩa toán học; câu trực tiếp yêu cầu nhận diện đúng công thức rồi xử lý hệ số, dấu hoặc điều kiện.", "refs": ["fc12a8146279|P1|8|None", "0968e8bc9e2d|P1|7|None", "54e9a2a276ca|P1|2|None", "0968e8bc9e2d|P1|9|None"]}, {"use": "Dữ kiện định lượng được cung cấp để lập mô hình, đổi đơn vị, xác định tham số và kiểm tra ngưỡng; không cần nhớ giá trị ngoài đề.", "refs": ["fc12a8146279|P2|2|b", "54e9a2a276ca|P2|2|b", "fc12a8146279|P2|4|b", "fc12a8146279|P3|4|None"]}, {"use": "Định nghĩa quyết định cách đọc dữ liệu: giá trị cực trị khác vị trí cực trị, phân vị là vị trí tích lũy, bán kính khác đại lượng bình phương trong phương trình.", "refs": ["54e9a2a276ca|P1|3|None", "fc12a8146279|P1|9|None", "0968e8bc9e2d|P1|6|None", "54e9a2a276ca|P2|4|a"]}, {"use": "Công thức có thể được cung cấp ngay trong dữ kiện; phần cần kiểm tra chuyển sang chọn đúng khoảng và vận dụng đúng ý nghĩa đại lượng.", "refs": ["fc12a8146279|P2|2|d"]}], "not_observed": [{"use": "Không thấy yêu cầu nhớ ngày tháng, nhân danh hoặc thông tin bối cảnh ngoài đề để xác định đáp án. Phạm vi nhận xét chỉ là các hàng được cung cấp.", "refs": ["fc12a8146279|P3|2|None", "fc12a8146279|P3|4|None", "54e9a2a276ca|P3|1|None", "54e9a2a276ca|P3|6|None"]}, {"use": "Không thấy yêu cầu phát biểu thuộc lòng định nghĩa hoặc chứng minh lại công thức như sản phẩm trả lời; các kiến thức đó được dùng để chọn, kiểm tra hoặc tính.", "refs": ["54e9a2a276ca|P1|2|None", "0968e8bc9e2d|P1|5|None", "fc12a8146279|P2|1|d", "54e9a2a276ca|P3|5|None"]}]}, "anti_patterns": [{"avoid": "Biến tên gọi và bối cảnh thành câu hỏi kiến thức ngoài toán.", "basis": "Các hàng ngữ cảnh cung cấp dữ kiện để mô hình hóa; không quan sát thấy đáp án phụ thuộc việc nhớ thông tin bên ngoài.", "refs": ["fc12a8146279|P3|2|None", "fc12a8146279|P3|4|None", "54e9a2a276ca|P3|6|None"]}, {"avoid": "Tăng độ khó chỉ bằng lời văn dài hoặc thông tin trang trí.", "basis": "Các hàng phân hóa cao được mô tả bằng trở ngại cấu trúc cụ thể: dựng hình phụ, chọn miền, ràng buộc đếm hoặc quỹ tích; không có bằng chứng rằng độ dài lời văn tự nó là nguồn khó.", "refs": ["fc12a8146279|P3|3|None", "fc12a8146279|P3|5|None", "54e9a2a276ca|P3|2|None", "54e9a2a276ca|P2|4|d"]}, {"avoid": "Cho phép hình phối cảnh thay thế điều kiện hình học.", "basis": "Các hàng kiểm tra vuông góc và phép chiếu đòi suy luận từ giả thiết, không chấp nhận quan hệ chỉ trông có vẻ đúng trên hình.", "refs": ["54e9a2a276ca|P1|1|None", "0968e8bc9e2d|P1|1|None", "0968e8bc9e2d|P1|8|None"]}, {"avoid": "Viết lời giải dài như yêu cầu đầu ra của câu trả lời ngắn.", "basis": "Các hàng trả lời ngắn yêu cầu kết quả tính, đếm hoặc tối ưu; chuỗi suy luận dài nằm trong quá trình giải, không được mô tả là sản phẩm tự luận cần nộp.", "refs": ["fc12a8146279|P3|6|None", "54e9a2a276ca|P3|4|None", "54e9a2a276ca|P3|5|None"]}]}, {"evidence_scope": {"class": "provincial_third_party", "interpretation": "Chỉ coi một cấu trúc là lặp lại khi có bằng chứng từ các đề khác nhau. Các ý chung một bài hoặc cùng một đề không tạo bằng chứng tái diễn độc lập.", "limitation": "Các hàng chưa đủ để lập danh sách mẫu lặp lại đạt độ dài yêu cầu mà không tách vụn cấu trúc hoặc biến quan sát riêng thành quy luật. Danh sách dưới đây giữ những cấu trúc có bằng chứng liên đề; các thủ pháp phân hóa chỉ được khái quát trong phạm vi ghi rõ.", "uncertainty": "Các hàng thiếu khóa hợp lệ chỉ hỗ trợ nhận diện cấu trúc và khả năng tạo nhiễu, không xác nhận lỗi của từng phương án. Những điểm phụ thuộc hình cắt hoặc lời văn chưa tường minh được giữ như giới hạn bằng chứng."}, "patterns": [{"part_kind": "multiple_choice", "topic": "Vectơ không gian qua quan hệ trung điểm", "grade": 12, "construction": "Cho trung điểm trên các cạnh của hình không gian; rút gọn hoặc chuyển đổi vectơ nối trung điểm, dùng đường trung bình để liên hệ với vectơ cần tìm, rồi kiểm tra hướng và hệ số. Có thể cần chuyển sang vectơ bằng nó trên mặt song song.", "wrong_options": "Đảo hướng, thiếu hoặc đảo hệ số tỉ lệ, chọn nhầm cạnh hay đường chéo. Khi thiếu khóa hợp lệ, đây chỉ là cơ chế kiểm tra thể hiện qua lựa chọn.", "difficulty_source": "Phối hợp tỉ lệ hình học với hướng vectơ trên hình không gian.", "discrimination": "medium", "typical_steps": 3, "refs": ["0968e8bc9e2d|P1|11|None", "525d3542283a|P1|7|None"]}, {"part_kind": "multiple_choice", "topic": "Thể tích khối chóp từ diện tích đáy và chiều cao", "grade": 11, "construction": "Cho hình chóp cùng dữ kiện kích thước hoặc quan hệ vuông góc; xác định đúng phần đáy được hỏi và đường cao, tính các đại lượng còn thiếu rồi áp dụng công thức thể tích.", "wrong_options": "Dùng toàn bộ đáy thay phần đáy cần xét, nhầm cạnh với đường chéo, suy sai chiều cao hoặc thiếu hệ số thể tích. Việc gán lỗi cho lựa chọn ở hàng thiếu khóa chưa được xác nhận.", "difficulty_source": "Mức khó tăng khi đáy và chiều cao phải suy ra từ mặt cắt thay vì được cho trực tiếp.", "discrimination": "medium", "typical_steps": 4, "refs": ["9ed45d16a975|P1|3|None", "525d3542283a|P1|1|None"]}, {"part_kind": "multiple_choice", "topic": "Cấp số cộng qua quan hệ giữa các số hạng", "grade": 11, "construction": "Cho giá trị hoặc quan hệ đại số giữa các số hạng; biểu diễn chúng qua số hạng đầu và công sai, giải điều kiện rồi suy ra tham số hoặc số hạng được yêu cầu.", "wrong_options": "Nhầm số hạng đầu với công sai, lấy hiệu số hạng mà không chia cho chênh lệch chỉ số, đảo dấu hoặc lệch chỉ số.", "difficulty_source": "Chuyển quan hệ giữa số hạng thành quan hệ giữa các tham số và giữ đúng khoảng cách chỉ số.", "discrimination": "low", "typical_steps": 3, "refs": ["9ed45d16a975|P1|11|None", "525d3542283a|P1|4|None"]}, {"part_kind": "multiple_choice", "topic": "Nghiệm tổng quát của phương trình lượng giác cơ bản", "grade": 11, "construction": "Cho phương trình lượng giác tại giá trị đặc biệt; nhận diện vị trí nghiệm trong chu kì rồi dùng chu kì đúng để viết đầy đủ họ nghiệm.", "wrong_options": "Đổi pha, dùng sai chu kì, bỏ họ nghiệm hoặc lấy điểm không xác định làm nghiệm. Các lỗi cụ thể phụ thuộc hàm lượng giác.", "difficulty_source": "Phân biệt vị trí nghiệm, miền xác định và chu kì của từng hàm.", "discrimination": "low", "typical_steps": 2, "refs": ["9ed45d16a975|P1|7|None", "525d3542283a|P1|11|None"]}, {"part_kind": "multiple_choice", "topic": "Quan hệ định nghĩa giữa nguyên hàm và đạo hàm", "grade": 12, "construction": "Cho một nguyên hàm hoặc quan hệ nguyên hàm; xác định đúng hàm phải lấy đạo hàm để chọn hệ thức định nghĩa hoặc khôi phục hàm dưới dấu nguyên hàm.", "wrong_options": "Đảo chiều quan hệ, đổi dấu, tiếp tục lấy nguyên hàm hoặc dùng nhầm quy tắc đạo hàm.", "difficulty_source": "Đọc đúng chiều suy luận từ nguyên hàm về hàm ban đầu.", "discrimination": "low", "typical_steps": 2, "refs": ["9ed45d16a975|P1|5|None", "525d3542283a|P1|6|None"]}, {"part_kind": "true_false", "topic": "Phương trình mặt cầu từ tâm và bán kính", "grade": 12, "construction": "Cho tâm và bán kính trong bối cảnh tọa độ; đồng nhất đơn vị nếu cần, lập biểu thức khoảng cách bình phương rồi kiểm tra phương trình được nêu.", "wrong_options": "Dùng bán kính thay bình phương bán kính hoặc giữ bán kính theo đơn vị vật lí khi phương trình dùng đơn vị tọa độ khác.", "difficulty_source": "Kiểm tra ý nghĩa và đơn vị của đại lượng trước khi thế vào công thức.", "discrimination": "low", "typical_steps": 3, "refs": ["0968e8bc9e2d|P2|2|a", "9ed45d16a975|P2|3|a"]}, {"part_kind": "true_false", "topic": "Tìm hàm lượng từ tốc độ biến thiên", "grade": 12, "construction": "Cho tốc độ biến thiên của một đại lượng; xác định quan hệ đạo hàm, xử lí dấu tăng giảm rồi lấy nguyên hàm để kiểm tra dạng hàm lượng hoặc quan hệ nguyên hàm.", "wrong_options": null, "difficulty_source": "Hiểu chiều biến thiên của đại lượng và giữ đúng dấu, hệ số khi lấy nguyên hàm.", "discrimination": "low", "typical_steps": 2, "refs": ["0968e8bc9e2d|P2|4|a", "0968e8bc9e2d|P2|4|b", "9ed45d16a975|P2|1|a"]}, {"part_kind": "true_false", "topic": "Hiệu chỉnh mô hình tích lũy bằng điều kiện đã biết", "grade": 12, "construction": "Cho tốc độ biến thiên có hệ số chưa biết cùng các điều kiện về lượng; lấy nguyên hàm, dùng điều kiện để xác định hằng số cộng và hệ số, rồi kiểm tra hệ số hoặc lượng tại thời điểm được hỏi.", "wrong_options": "Có nhận định nêu lượng sai nhưng dữ liệu không xác định được một cơ chế tính sai riêng biệt; không nên tự gán lỗi.", "difficulty_source": "Phân biệt tổng lượng với phần thay đổi và dùng đúng vai trò của các điều kiện.", "discrimination": "medium", "typical_steps": 4, "refs": ["0968e8bc9e2d|P2|4|c", "9ed45d16a975|P2|1|b", "9ed45d16a975|P2|1|c"]}, {"part_kind": "true_false", "topic": "Xác suất thuộc tính khi đã biết nhóm", "grade": 12, "construction": "Cho cơ cấu thuộc tính trong các nhóm và thông tin xác định nhóm của phần tử được chọn; lấy nhóm đã biết làm không gian điều kiện, rút gọn quy trình chọn bằng tính đối xứng nếu cần, rồi tính tỉ lệ thuộc tính.", "wrong_options": "Dùng cơ cấu của nhóm khác thay cho nhóm đã được điều kiện hóa.", "difficulty_source": "Chọn đúng quần thể điều kiện; quy trình nhiều giai đoạn có thể che khuất tỉ lệ cần dùng.", "discrimination": "medium", "typical_steps": 3, "refs": ["0968e8bc9e2d|P2|3|b", "9ed45d16a975|P2|2|a"], "evidence_note": "Hàng có lời văn chưa tường minh chỉ hỗ trợ mẫu này theo cách hiểu xác suất có điều kiện phù hợp với khóa."}, {"part_kind": "true_false", "topic": "Xác suất toàn phần qua các nhóm nguồn", "grade": 12, "construction": "Cho các nhóm rời nhau cùng cơ cấu thuộc tính; xác định đóng góp của từng nhóm, cộng số trường hợp thuận lợi hoặc tổng xác suất có trọng số rồi kiểm tra xác suất trên toàn thể.", "wrong_options": "Có giá trị xác suất toàn thể sai nhưng chưa nhận diện được lỗi đơn giản tạo ra riêng giá trị đó.", "difficulty_source": "Phân biệt trọng số do quy mô quần thể với trọng số do quy trình tuyển chọn.", "discrimination": "medium", "typical_steps": 3, "refs": ["0968e8bc9e2d|P2|3|c", "9ed45d16a975|P2|2|b"]}, {"part_kind": "true_false", "topic": "Đảo điều kiện để truy nguồn", "grade": 12, "construction": "Cho cơ cấu nhóm và một thuộc tính đã quan sát; tính xác suất giao của nhóm đích với thuộc tính, tìm tổng xác suất thuộc tính rồi chuẩn hóa để suy ra xác suất nguồn.", "wrong_options": null, "difficulty_source": "Giữ nguyên biến cố giao nhưng đổi đúng mẫu số khi đảo chiều điều kiện.", "discrimination": "medium", "typical_steps": 3, "refs": ["0968e8bc9e2d|P2|3|d", "9ed45d16a975|P2|2|c"], "evidence_note": "Cách hiểu điều kiện đảo ở hàng có lời văn mơ hồ dựa trên khóa được cung cấp; không coi sự mơ hồ là thủ pháp phân hóa."}, {"part_kind": "true_false", "topic": "Khoảng cách gần nhất trên đoạn chuyển động", "grade": 12, "construction": "Cho đoạn chuyển động thẳng và điểm cố định; tham số hóa vị trí, tìm cực tiểu bình phương khoảng cách hoặc hình chiếu, kiểm tra tham số thuộc đoạn rồi suy ra thời điểm gần nhất hoặc khả năng xâm nhập vùng cầu.", "wrong_options": "Có nhận định nêu thời điểm sai nhưng chưa đủ căn cứ xác định cơ chế tạo giá trị sai.", "difficulty_source": "Phân biệt tối ưu trên đường thẳng kéo dài với tối ưu trên đoạn hành trình hữu hạn.", "discrimination": "medium", "typical_steps": 4, "refs": ["0968e8bc9e2d|P2|2|d", "9ed45d16a975|P2|3|c"]}, {"part_kind": "short_answer", "topic": "Tối ưu mô hình có ràng buộc nguyên", "grade": [10, 12], "construction": "Cho quy luật định lượng và các giới hạn thực tế; lập biến, miền khả thi và hàm mục tiêu, tìm ứng viên theo mô hình liên tục thích hợp rồi kiểm tra tính nguyên, biên và giá trị tối ưu toàn miền.", "wrong_options": null, "difficulty_source": "Chuyển lời văn thành miền hợp lệ và không đồng nhất nghiệm tối ưu liên tục với phương án nguyên.", "discrimination": "medium", "typical_steps": 5, "refs": ["0968e8bc9e2d|P3|2|None", "9ed45d16a975|P3|1|None"], "evidence_note": "Cấu trúc chung là mô hình hóa, tìm ứng viên và kiểm tra nguyên; công cụ tìm ứng viên khác nhau theo dạng hàm."}, {"part_kind": "short_answer", "topic": "Diện tích giới hạn bởi đồ thị", "grade": 12, "construction": "Cho đồ thị hoặc dữ kiện xác định các miền; tìm giao điểm, xác định biên trên và biên dưới, chia miền khi cần rồi lập tích phân diện tích. Dữ kiện diện tích có thể được dùng ngược để tìm tham số.", "wrong_options": null, "difficulty_source": "Xác định đúng miền hình học và dấu của hiệu hàm trước khi tính tích phân.", "discrimination": "medium", "typical_steps": 5, "refs": ["0968e8bc9e2d|P3|6|None", "9ed45d16a975|P3|5|None"], "evidence_note": "Phần khôi phục hàm từ tiệm cận và tránh tích phân qua tiệm cận chỉ được quan sát riêng; phần tô ở hàng còn lại chưa được kiểm chứng độc lập."}], "discrimination_moves": [{"move": "Buộc khôi phục mô hình trước khi thực hiện phép tính quen thuộc", "how_to_apply": "Ẩn hệ số hoặc biểu thức hàm sau các đặc trưng hình học; yêu cầu dùng nghiệm, tiệm cận, giao điểm hoặc cực trị đã biết để dựng mô hình rồi mới tính đại lượng đích.", "refs": ["0968e8bc9e2d|P3|3|None", "0968e8bc9e2d|P3|6|None"], "evidence_scope": "Các hàng phân hóa cao cùng một đề; chưa đủ xác nhận thủ pháp này tái diễn liên đề."}, {"move": "Chọn biểu diễn làm lộ cấu trúc ẩn", "how_to_apply": "Để lời giải trực tiếp trở nên dài, trong khi tịnh tiến về tâm đối xứng, chọn tọa độ hoặc dựng mặt phẳng phụ giúp biến quan hệ hình học thành biểu thức có thể xử lí.", "refs": ["9ed45d16a975|P2|4|d", "9ed45d16a975|P3|4|None"], "evidence_scope": "Quan sát trong cùng một đề; không coi việc đổi công cụ đơn thuần là một mẫu tái diễn độc lập."}, {"move": "Cập nhật trạng thái sau khi nhận thông tin điều kiện", "how_to_apply": "Sau quan sát ban đầu, yêu cầu điều chỉnh cả trọng số các nhánh lẫn thành phần còn lại trong từng nhánh trước khi tính xác suất tiếp theo.", "refs": ["9ed45d16a975|P2|2|d"], "evidence_scope": "Quan sát riêng có mức phân hóa cao."}, {"move": "Yêu cầu suy ra quan hệ trung gian thay vì cấp sẵn công thức", "how_to_apply": "Cho điều kiện hình học cơ bản để người làm tự thiết lập quan hệ tích vô hướng hoặc phương trình phụ, rồi kết hợp với ràng buộc vị trí để tìm đại lượng cần tính.", "refs": ["9ed45d16a975|P3|6|None"], "evidence_scope": "Quan sát riêng có mức phân hóa cao."}, {"move": "Đặt bước kiểm tra tính hợp lệ sau biến đổi", "how_to_apply": "Sau khi có nghiệm đại số hoặc ứng viên tối ưu, yêu cầu kiểm tra điều kiện giao điểm, khả năng đạt dấu bằng, vị trí hình học hoặc miền tích phân trước khi kết luận.", "refs": ["0968e8bc9e2d|P3|6|None", "9ed45d16a975|P2|4|d", "9ed45d16a975|P3|6|None"], "evidence_scope": "Có bằng chứng liên đề cho bước kiểm tra điều kiện; các điều kiện cụ thể thuộc từng cấu trúc riêng."}], "easy_vs_hard": [{"topic": "Hàm số và cực trị", "easy": "Cho sẵn biểu thức hàm; tính đạo hàm và kiểm tra loại cực trị tại vị trí được nêu.", "hard": "Cho các đặc trưng của đồ thị; dựng hàm chứa hệ số chưa biết, dùng cực trị đã biết để hiệu chỉnh rồi suy ra cực trị còn lại.", "difference": "Độ khó chuyển từ khảo sát hàm đã có sang xây dựng và hiệu chỉnh mô hình.", "easy_refs": ["0968e8bc9e2d|P2|1|d"], "hard_refs": ["0968e8bc9e2d|P3|3|None"], "evidence_scope": "Đối chiếu nội bộ một đề."}, {"topic": "Diện tích bằng tích phân", "easy": "Cho sẵn các tích phân và hình đồ thị; chọn dấu để ghép thành diện tích không âm.", "hard": "Phải khôi phục đường cong, tìm giao điểm và chia miền giữa các nhánh trước khi lập tích phân.", "difference": "Phần khó nằm ở xác lập mô hình và miền tích phân hơn là thao tác nguyên hàm.", "easy_refs": ["525d3542283a|P1|2|None"], "hard_refs": ["0968e8bc9e2d|P3|6|None"], "evidence_scope": "Đối chiếu liên đề; hàng dễ thiếu khóa hợp lệ, hàng khó có giới hạn kiểm chứng hình."}, {"topic": "Xác suất có điều kiện", "easy": "Xác định nhóm đã biết rồi lấy tỉ lệ thuộc tính trong nhóm.", "hard": "Dùng thông tin quan sát để cập nhật nguồn xuất phát, loại phần tử đã được xác định và tính thành phần còn lại theo từng nhánh.", "difference": "Điều kiện không chỉ đổi mẫu số mà còn thay đổi trạng thái của phép chọn tiếp theo.", "easy_refs": ["0968e8bc9e2d|P2|3|b"], "hard_refs": ["9ed45d16a975|P2|2|d"], "evidence_scope": "Đối chiếu liên đề; cách đọc điều kiện ở hàng dễ còn phụ thuộc khóa."}, {"topic": "Mặt cầu trong tọa độ không gian", "easy": "Cho tâm và bán kính; kiểm tra phương trình sau khi thống nhất đơn vị.", "hard": "Từ điều kiện tiếp xúc, tự suy ra mặt phẳng chứa các tiếp điểm rồi kết hợp đường chuyển động và điều kiện đi qua điểm để xác định vị trí.", "difference": "Từ nhận diện công thức chuẩn sang thiết lập quan hệ hình học trung gian.", "easy_refs": ["0968e8bc9e2d|P2|2|a", "9ed45d16a975|P2|3|a"], "hard_refs": ["9ed45d16a975|P3|6|None"], "evidence_scope": "Dạng dễ tái diễn liên đề; dạng khó là quan sát riêng."}, {"topic": "Hình học không gian", "easy": "Nhận diện đáy và đường cao đã cho để thế công thức thể tích.", "hard": "Tái dựng độ lệch và chiều cao từ cấu trúc hình đều, sau đó chọn mặt phẳng phụ hoặc tọa độ để tính khoảng cách chéo nhau.", "difference": "Độ khó tăng ở bước dựng quan hệ không gian và chọn cách biểu diễn.", "easy_refs": ["525d3542283a|P1|1|None"], "hard_refs": ["9ed45d16a975|P3|4|None"], "evidence_scope": "Đối chiếu liên đề ở chủ đề rộng, không phải cùng một cấu trúc câu."}], "fact_use": {"common": [{"use": "Kiến thức nhớ được thường là định nghĩa, công thức và quan hệ chuẩn; người làm phải chọn đúng chiều áp dụng hoặc đúng đại lượng trong công thức.", "refs": ["9ed45d16a975|P1|5|None", "525d3542283a|P1|6|None", "0968e8bc9e2d|P2|2|a", "9ed45d16a975|P2|3|a"]}, {"use": "Giá trị lượng giác đặc biệt và chu kì được huy động trực tiếp để viết nghiệm đầy đủ.", "refs": ["9ed45d16a975|P1|7|None", "525d3542283a|P1|11|None"]}, {"use": "Số liệu là đầu vào để đếm, tính toán, hiệu chỉnh hệ số hoặc kiểm tra ràng buộc; không phải nội dung cần nhớ từ bên ngoài.", "refs": ["0968e8bc9e2d|P2|3|a", "0968e8bc9e2d|P2|4|c", "9ed45d16a975|P2|1|b", "9ed45d16a975|P3|1|None"]}, {"use": "Hình học quen thuộc cung cấp quan hệ trung điểm, tỉ lệ, vuông góc và công thức đo; các quan hệ này được ghép vào chuỗi suy luận.", "refs": ["0968e8bc9e2d|P1|11|None", "525d3542283a|P1|7|None", "9ed45d16a975|P1|3|None"]}], "not_observed": [{"use": "Không thấy yêu cầu nhớ ngày tháng, tên riêng hoặc dữ kiện thực tế ngoài đề để giải toán. Bối cảnh trong các hàng ứng dụng được chuyển thành dữ kiện định lượng đã cho.", "refs": ["0968e8bc9e2d|P3|2|None", "9ed45d16a975|P3|1|None", "9ed45d16a975|P3|3|None"], "scope": "Chỉ kết luận cho các hàng được cung cấp."}, {"use": "Không thấy yêu cầu chép lại phát biểu dài hoặc kể lịch sử kiến thức; ngay cả câu nhận biết cũng yêu cầu chọn quan hệ, nghiệm hoặc biểu thức.", "refs": ["525d3542283a|P1|6|None", "9ed45d16a975|P1|7|None", "0968e8bc9e2d|P1|12|None"], "scope": "Không suy rộng sang phần đề chưa có trong dữ liệu."}]}, "anti_patterns": [{"avoid": "Biến bối cảnh thành bài kiểm tra kiến thức đời sống ngoài dữ kiện đã cho.", "basis": "Các bài ứng dụng được giải bằng mô hình toán từ thông tin trong đề; không có bước tra cứu sự kiện hay hiểu biết chuyên ngành ngoài mô hình.", "refs": ["0968e8bc9e2d|P3|2|None", "9ed45d16a975|P2|3|b", "9ed45d16a975|P3|1|None"]}, {"avoid": "Đồng nhất câu khó với việc kéo dài phép tính thuần túy.", "basis": "Các hàng phân hóa cao có bước chọn biểu diễn, cập nhật điều kiện, khôi phục mô hình hoặc suy ra quan hệ trung gian.", "refs": ["0968e8bc9e2d|P3|3|None", "9ed45d16a975|P2|2|d", "9ed45d16a975|P2|4|d", "9ed45d16a975|P3|6|None"]}, {"avoid": "Viết mọi câu ứng dụng như một phép thế trực tiếp vào công thức được cấp sẵn.", "basis": "Các hàng khó yêu cầu tự dựng hàm hoặc thiết lập phương trình phụ trước khi tính kết quả.", "refs": ["0968e8bc9e2d|P3|6|None", "9ed45d16a975|P3|6|None"]}, {"avoid": "Buộc phần trả lời ngắn trở thành bài tự luận chứng minh dài.", "basis": "Các hàng trả lời ngắn yêu cầu kết quả định lượng hoặc biểu thức, dù quá trình giải có thể cần nhiều phép suy luận.", "refs": ["0968e8bc9e2d|P3|3|None", "0968e8bc9e2d|P3|5|None", "9ed45d16a975|P3|4|None", "9ed45d16a975|P3|5|None"]}, {"avoid": "Cho rằng hình minh họa luôn chứa dữ kiện bắt buộc hoặc luôn chỉ để trang trí.", "basis": "Có hàng dùng hình để xác định kích thước và miền, đồng thời có hàng mà dữ kiện chữ đã đủ và hình chỉ gợi bối cảnh.", "refs": ["0968e8bc9e2d|P3|1|None", "0968e8bc9e2d|P3|6|None", "9ed45d16a975|P2|1|a", "9ed45d16a975|P2|3|a"]}]}, {"evidence_limits": {"scope": "Hồ sơ chỉ khái quát trong tập dữ liệu đề địa phương do bên thứ ba cung cấp.", "recurrence": "Chỉ đưa vào patterns những cấu trúc có bằng chứng từ các paper_id khác nhau. Không kéo dài danh sách đến độ dài yêu cầu bằng cách coi các ý trong cùng đề là bằng chứng lặp lại độc lập hoặc tách vụn cùng một cấu trúc.", "uncertainty": "Thiếu khóa khớp mã thì chỉ mô tả điểm nhận định kiểm tra, không xác nhận phương án sai. Các động tác phân hóa dựa trên mô tả suy luận của những hàng được đánh giá high, chưa phải kết quả đo lường thực nghiệm."}, "patterns": [{"part_kind": "multiple_choice", "topic": "Tứ phân vị của số liệu ghép nhóm", "grade": 11, "construction": "Cho bảng khoảng lớp và tần số; yêu cầu xác định tứ phân vị. Tìm vị trí trong mẫu, dùng tần số tích lũy xác định lớp chứa rồi nội suy và đối chiếu lựa chọn.", "wrong_options": "Dùng mốc lớp hoặc trung điểm thay cho kết quả nội suy, chọn lệch lớp. Cơ chế đã được mô tả ở đề có khóa; đề thiếu khóa chỉ hỗ trợ nhận diện những điểm cần kiểm tra.", "difficulty_source": "Phải xác định đúng lớp chứa trước khi áp dụng công thức.", "discrimination": "low", "typical_steps": 3, "refs": ["7ab78715480e|P1|7|None", "3f1b2aa3cb72|P1|1|None"]}, {"part_kind": "multiple_choice", "topic": "Đọc tiệm cận ngang từ đồ thị", "grade": 12, "construction": "Cho đồ thị có nhánh tiến gần các đường song song với trục tọa độ; yêu cầu phương trình tiệm cận ngang. Nhận diện xu hướng khi hoành độ đi xa, đọc tung độ rồi viết phương trình tương ứng.", "wrong_options": "Hoán đổi tiệm cận đứng với tiệm cận ngang, lấy nhầm tọa độ hoặc viết sai biến trong phương trình. Không gán lỗi cho từng lựa chọn ở đề thiếu khóa.", "difficulty_source": "Phân biệt hướng của đường thẳng với tọa độ dùng để biểu diễn nó.", "discrimination": "low", "typical_steps": 2, "refs": ["7ab78715480e|P1|2|None", "3f1b2aa3cb72|P1|10|None"]}, {"part_kind": "multiple_choice", "topic": "Đọc tính đơn điệu từ đồ thị", "grade": 12, "construction": "Cho đồ thị có điểm đổi chiều; yêu cầu chọn khoảng tăng hoặc giảm. Đọc đồ thị theo chiều hoành độ tăng và kiểm tra toàn bộ khoảng lựa chọn có giữ cùng chiều biến thiên hay không.", "wrong_options": "Chọn nhánh có chiều ngược yêu cầu hoặc kéo khoảng qua điểm đổi chiều. Khả năng nhầm tính đơn điệu với dấu của hàm chỉ được nêu như điểm cần kiểm tra ở hàng thiếu khóa.", "difficulty_source": "Đánh giá tính chất trên toàn khoảng thay vì nhìn một vị trí riêng lẻ.", "discrimination": "low", "typical_steps": 3, "refs": ["7ab78715480e|P1|5|None", "3f1b2aa3cb72|P1|11|None"]}, {"part_kind": "multiple_choice", "topic": "Giá trị nhỏ nhất của đa thức trên đoạn", "grade": 12, "construction": "Cho đa thức và đoạn đóng; yêu cầu giá trị nhỏ nhất. Tìm điểm dừng thuộc đoạn, tính giá trị tại các điểm đó và đầu mút rồi so sánh.", "wrong_options": "Bỏ điểm dừng bên trong hoặc bỏ thành phần của hàm khi tính giá trị. Nhầm hoành độ với giá trị cực trị chỉ là khả năng khảo sát trong hàng chưa có khóa.", "difficulty_source": "Lập đủ tập điểm cần so sánh và trả lời bằng giá trị hàm.", "discrimination": "low", "typical_steps": 3, "refs": ["7ab78715480e|P1|11|None", "3f1b2aa3cb72|P1|5|None"]}, {"part_kind": "multiple_choice", "topic": "Bất phương trình lôgarit với đối số bậc nhất", "grade": 11, "construction": "Cho bất phương trình lôgarit; yêu cầu tập nghiệm. Đặt điều kiện dương của đối số, chuyển sang bất phương trình đại số theo tính đơn điệu của cơ số, rồi giao nghiệm và xét đầu mút.", "wrong_options": "Bỏ phần dịch chuyển của đối số, xử lý sai chiều bất phương trình hoặc coi miền xác định là tập nghiệm. Với đề thiếu khóa, chưa xác nhận cơ chế của từng lựa chọn.", "difficulty_source": "Kiểm soát đồng thời điều kiện xác định, chiều biến đổi và việc lấy biên.", "discrimination": "low", "typical_steps": 3, "refs": ["7ab78715480e|P1|10|None", "3f1b2aa3cb72|P1|8|None"]}, {"part_kind": "true_false", "topic": "Kiểm tra giá trị hàm số bằng phép thế", "grade": [10, 11], "construction": "Cho sẵn công thức hàm và nhận định về giá trị tại đối số hoặc mốc ban đầu. Xác định đúng đối số, thế vào công thức rồi đối chiếu giá trị hay quan hệ được nêu.", "wrong_options": "Hàng chưa có khóa chỉ cho thấy việc kiểm tra phép thế và dấu; hàng có khóa là nhận định đúng, không cung cấp cơ chế tạo nhận định sai.", "difficulty_source": "Đọc đúng mốc của biến và tính đúng biểu thức có dấu hoặc lôgarit.", "discrimination": "low", "typical_steps": 3, "refs": ["525d3542283a|P2|3|b", "7ab78715480e|P2|1|a"]}, {"part_kind": "true_false", "topic": "Kiểm tra công thức đạo hàm", "grade": 11, "construction": "Cho hàm số và biểu thức đạo hàm được đề nghị. Áp dụng quy tắc đạo hàm theo cấu trúc hàm, giữ đúng hệ số và dấu rồi đối chiếu.", "wrong_options": "Hàng đa thức chưa có khóa nên chỉ xác định quy tắc đang được kiểm tra; hàng lôgarit có khóa là nhận định đúng. Chưa đủ bằng chứng mô tả một cơ chế nhận định sai lặp lại.", "difficulty_source": "Áp dụng đúng quy tắc cho từng thành phần hoặc hàm hợp đơn giản.", "discrimination": "low", "typical_steps": 2, "refs": ["525d3542283a|P2|3|a", "7ab78715480e|P2|1|b"]}, {"part_kind": "true_false", "topic": "Khôi phục đại lượng từ tốc độ thay đổi", "grade": 12, "construction": "Cho tốc độ thay đổi trực tiếp hoặc thông qua quan hệ giữa các đạo hàm, kèm giá trị tại một mốc. Lấy nguyên hàm, xác định hằng số bằng điều kiện đã cho, rồi kiểm tra biểu thức hoặc giá trị và ngưỡng được đề nghị.", "wrong_options": "Có bằng chứng về việc nhầm quan hệ giữa các đạo hàm với quan hệ giữa giá trị các hàm, bỏ qua điều kiện ban đầu. Các hàng thiếu khóa chỉ hỗ trợ kiểm tra hệ số nguyên hàm, hằng số và đơn vị; không xác nhận nhận định sai.", "difficulty_source": "Phân biệt tốc độ thay đổi với mức đại lượng và giữ điều kiện ban đầu khi chuyển giữa chúng.", "discrimination": "medium", "typical_steps": 3, "refs": ["525d3542283a|P2|2|c", "7ab78715480e|P2|1|d", "3f1b2aa3cb72|P2|1|a", "3f1b2aa3cb72|P2|1|b"]}, {"part_kind": "short_answer", "topic": "Dựng biên hình học rồi tích phân diện tích", "grade": 12, "construction": "Cho hình có miền cần tính nhưng chưa cho trực tiếp đầy đủ hàm biên. Chọn hệ tọa độ, dùng các ràng buộc hình học để xác định hàm và điểm chuyển biên, chia miền rồi lập tích phân diện tích.", "wrong_options": null, "difficulty_source": "Khó ở việc dựng đúng mô hình và phân chia miền trước khi thực hiện tích phân; đối xứng hoặc phần bù có thể giúp rút gọn.", "discrimination": "high", "typical_steps": 5, "refs": ["525d3542283a|P3|1|None", "7ab78715480e|P3|1|None"]}, {"part_kind": "short_answer", "topic": "Tối ưu đại lượng được suy ra từ mô hình", "grade": 12, "construction": "Cho dữ kiện mô hình và miền biến thiên hữu hạn; yêu cầu giá trị lớn nhất của đại lượng phải lập thêm. Biểu diễn đúng đại lượng mục tiêu, tìm điểm có thể tối ưu, kiểm tra miền và biên rồi tính giá trị.", "wrong_options": null, "difficulty_source": "Đại lượng cần tối ưu có thể là đạo hàm của hàm đã cho hoặc hiệu giữa các thành phần của mô hình; phải lập đúng mục tiêu trước khi tối ưu.", "discrimination": "medium", "typical_steps": 4, "refs": ["525d3542283a|P3|2|None", "525d3542283a|P3|5|None", "7ab78715480e|P3|3|None"], "qualification": "Mức phân hóa của mẫu là đánh giá thận trọng cho cấu trúc chung. Hàng có dữ kiện văn bản và hình không thống nhất chưa hỗ trợ kết luận riêng về phân hóa."}, {"part_kind": "short_answer", "topic": "Khoảng cách không gian sau khi dựng biểu diễn", "grade": 11, "construction": "Cho cấu hình không gian với quan hệ vuông góc, vị trí điểm và độ dài hoặc góc; yêu cầu khoảng cách. Suy ra dữ kiện còn thiếu, chọn hệ tọa độ hoặc dựng đoạn vuông góc thích hợp, rồi chuyển yêu cầu thành phép tính khoảng cách.", "wrong_options": null, "difficulty_source": "Phải chọn biểu diễn phù hợp với đối tượng cần đo; công thức cuối phụ thuộc việc đo từ điểm đến mặt phẳng hay giữa các đường chéo nhau.", "discrimination": "medium", "typical_steps": 4, "refs": ["525d3542283a|P3|4|None", "7ab78715480e|P3|6|None"], "qualification": "Sự lặp lại nằm ở chuỗi dựng biểu diễn rồi tính khoảng cách; không coi các công thức khoảng cách khác nhau là đồng nhất. Cấu hình đường chéo nhau có đánh giá phân hóa cao hơn."}], "discrimination_moves": [{"move": "Giấu hàm cần tính sau các ràng buộc hình học", "how_to_apply": "Cho quan hệ đủ để xác định hàm nhưng yêu cầu người làm tự chọn tọa độ, dịch các ràng buộc thành phương trình và tìm hệ số trước khi tính đại lượng đích.", "refs": ["525d3542283a|P3|1|None", "7ab78715480e|P3|1|None"]}, {"move": "Buộc nhận ra nơi thay đổi biên của miền", "how_to_apply": "Dùng miền có biên do các đoạn hoặc nhánh khác nhau đảm nhiệm. Độ khó nằm ở xác định điểm chuyển biên và lập các tích phân phù hợp.", "refs": ["525d3542283a|P3|1|None", "7ab78715480e|P3|1|None"]}, {"move": "Đặt lựa chọn biểu diễn trước công thức", "how_to_apply": "Cho dữ kiện dưới dạng hình học; yêu cầu tự nhận ra hình chiếu, tọa độ hoặc mặt phẳng phụ giúp nối dữ kiện với đại lượng đích. Không cho sẵn toàn bộ thành phần để thế vào công thức.", "refs": ["525d3542283a|P3|1|None", "7ab78715480e|P3|1|None", "7ab78715480e|P3|6|None"]}, {"move": "Chuyển quy tắc vận hành thành điều kiện khả thi toàn cục", "how_to_apply": "Mô tả cơ chế phân bổ tuần tự, sau đó yêu cầu tìm tiêu chuẩn cần và đủ cho toàn bộ đầu vào được xử lý trước khi đếm. Đây là quan sát riêng, chưa phải cấu trúc lặp lại giữa các đề.", "refs": ["525d3542283a|P3|3|None"]}, {"move": "Phối hợp phân loại khả thi với xử lý phần tử lặp", "how_to_apply": "Sau khi xác định các cấu hình hợp lệ, yêu cầu đếm thứ tự của từng cấu hình, loại sự phân biệt giả giữa các phần tử cùng loại và kiểm tra không đếm trùng. Đây là quan sát riêng.", "refs": ["525d3542283a|P3|3|None"]}], "easy_vs_hard": [{"topic": "Tích phân diện tích", "easy": "Nguyên hàm và các giá trị cần dùng đã được cung cấp; chỉ cần áp dụng quan hệ giữa tích phân và giá trị nguyên hàm.", "hard": "Hàm biên còn ẩn trong hình; phải dựng mô hình, tìm điểm chuyển biên và chia miền trước khi tích phân.", "easy_refs": ["7ab78715480e|P1|8|None"], "hard_refs": ["525d3542283a|P3|1|None", "7ab78715480e|P3|1|None"]}, {"topic": "Khoảng cách trong không gian", "easy": "Tọa độ hoặc quan hệ trục đã rõ; chủ yếu thực hiện phép toán tọa độ trực tiếp.", "hard": "Phải suy chiều cao từ hình chiếu và góc, rồi chọn biểu diễn phù hợp cho khoảng cách giữa các đường chéo nhau.", "easy_refs": ["525d3542283a|P2|1|b", "3f1b2aa3cb72|P1|3|None"], "hard_refs": ["7ab78715480e|P3|6|None"]}, {"topic": "Tổ hợp", "easy": "Phép chọn không xét thứ tự đã rõ; đếm mẫu thuận lợi và mẫu bất kỳ bằng tổ hợp.", "hard": "Phải suy điều kiện khả thi từ cơ chế tuần tự, phân loại cấu hình rồi đếm thứ tự có phần tử lặp.", "easy_refs": ["525d3542283a|P2|4|d", "3f1b2aa3cb72|P1|6|None"], "hard_refs": ["525d3542283a|P3|3|None"]}, {"topic": "Tối ưu hàm số", "easy": "Cho trực tiếp hàm mục tiêu và đoạn xét; chỉ cần tìm điểm dừng, xét đầu mút và so sánh.", "hard": "Phải lập hàm mục tiêu từ các đại lượng khác nhau, giữ đúng ý nghĩa và đơn vị rồi mới tối ưu trong miền hợp lệ.", "easy_refs": ["525d3542283a|P2|3|d", "7ab78715480e|P1|11|None", "3f1b2aa3cb72|P1|5|None"], "hard_refs": ["7ab78715480e|P3|3|None"], "qualification": "Dạng khó hơn trong đối chiếu này được đánh giá medium, không phải high."}, {"topic": "Xác suất", "easy": "Đọc trực tiếp thông số có điều kiện hoặc dùng biến cố đối.", "hard": "Phải tổng hợp các nhánh theo tỉ lệ nền rồi đảo chiều điều kiện bằng tỉ số xác suất.", "easy_refs": ["7ab78715480e|P2|4|a", "7ab78715480e|P2|4|b"], "hard_refs": ["7ab78715480e|P2|4|c", "7ab78715480e|P2|4|d"], "qualification": "Đây là đối chiếu nội bộ cùng đề; chưa chứng minh sự lặp lại giữa các đề."}], "fact_use": {"common": [{"use": "Kiến thức nhớ được chủ yếu là công thức, định nghĩa và quy tắc toán học: nhận dạng nguyên hàm, công thức thể tích, nghiệm lượng giác hoặc quan hệ giữa tích phân với nguyên hàm.", "refs": ["3f1b2aa3cb72|P1|4|None", "3f1b2aa3cb72|P1|9|None", "7ab78715480e|P1|12|None", "7ab78715480e|P1|8|None"]}, {"use": "Các số liệu là đầu vào được cung cấp để tính toán, nội suy, dựng mô hình hoặc so sánh; không đòi nhớ số liệu của bối cảnh ngoài đề.", "refs": ["7ab78715480e|P1|7|None", "3f1b2aa3cb72|P1|1|None", "7ab78715480e|P3|3|None", "7ab78715480e|P2|4|c"]}, {"use": "Có nhận định chỉ yêu cầu đọc lại đúng thông số đã cho; không phải mọi nhận định đều buộc suy luận dài.", "refs": ["7ab78715480e|P2|4|b"]}, {"use": "Ở các hàng phân hóa cao, công thức quen thuộc phục vụ chuỗi dựng mô hình; nhớ công thức riêng lẻ chưa đủ giải quyết yêu cầu.", "refs": ["525d3542283a|P3|1|None", "525d3542283a|P3|3|None", "7ab78715480e|P3|1|None", "7ab78715480e|P3|6|None"]}], "not_observed": [{"use": "Không thấy yêu cầu nhớ niên đại, tên riêng hoặc số liệu thực tế ngoài dữ kiện đề để xác định đáp án. Đây là giới hạn quan sát của tập hàng được cung cấp.", "refs": ["7ab78715480e|P2|1|a", "7ab78715480e|P2|4|b", "7ab78715480e|P3|3|None", "3f1b2aa3cb72|P2|1|a"]}]}, "anti_patterns": [{"avoid": "Đặt kiến thức thực tế ngoài đề làm điều kiện ngầm để giải mô hình.", "basis": "Các hàng ứng dụng cung cấp quy luật, thông số và ràng buộc cần dùng; không quan sát thấy yêu cầu tra cứu hoặc nhớ dữ kiện của bối cảnh.", "refs": ["525d3542283a|P2|2|a", "7ab78715480e|P2|4|c", "7ab78715480e|P3|3|None", "3f1b2aa3cb72|P2|1|a"]}, {"avoid": "Thay đáp án toán học xác định bằng bình luận mở hoặc đánh giá chủ quan.", "basis": "Các nhiệm vụ được mô tả yêu cầu chọn phương án, kiểm tra nhận định hoặc trả kết quả tính toán; không thấy yêu cầu nghị luận tự do.", "refs": ["7ab78715480e|P1|11|None", "7ab78715480e|P2|4|d", "525d3542283a|P3|3|None", "7ab78715480e|P3|6|None"]}, {"avoid": "Dùng kiến thức ngoài chuỗi công cụ được thể hiện để tạo độ khó giả.", "basis": "Những hàng được đánh giá phân hóa cao tạo khó bằng dựng biểu diễn, phối hợp kiến thức và kiểm soát trường hợp; không thể hiện yêu cầu gọi tên một định lý chuyên biệt ngoài chuỗi suy luận đã mô tả.", "refs": ["525d3542283a|P3|1|None", "525d3542283a|P3|3|None", "7ab78715480e|P3|1|None", "7ab78715480e|P3|6|None"]}]}, {"evidence_note": "Các kết luận chỉ áp dụng cho dữ liệu được cung cấp từ nguồn đề cấp tỉnh bên thứ ba. Trường evidence_scope phân biệt cấu trúc xuất hiện ở các đề khác nhau với quan sát riêng trong một đề; quan sát riêng không được coi là bằng chứng tái diễn. Không ép các thao tác khác nhau thành cùng mẫu chỉ vì chung chủ đề. Các mô tả nhiễu chỉ nêu đặc điểm lựa chọn hoặc nguy cơ nhầm lẫn có căn cứ; thiếu khóa đáp án phù hợp nên không xác nhận lỗi của từng phương án. Mức phân hóa là đánh giá theo cấu trúc suy luận, chưa phải kết quả thực nghiệm.", "patterns": [{"part_kind": "multiple_choice", "topic": "Nguyên hàm cơ bản", "grade": 12, "construction": "Cho hàm thuộc các dạng nguyên hàm quen thuộc hoặc tổng của chúng; yêu cầu chọn họ nguyên hàm. Nhận dạng từng thành phần, áp dụng công thức, ghép kết quả cùng hằng số tùy ý.", "wrong_options": "Các biểu thức thay đổi dấu, hệ số hoặc loại hàm, tạo đối chiếu giữa thao tác đạo hàm và nguyên hàm; chưa xác nhận lỗi của từng lựa chọn.", "difficulty_source": "Nhớ đúng công thức và hệ số, không cần dựng mô hình.", "discrimination": "low", "typical_steps": 3, "evidence_scope": "lặp giữa các đề", "refs": ["beee25b53250|P1|6|None", "acc00d945397|P1|2|None"]}, {"part_kind": "multiple_choice", "topic": "Đọc cực trị từ biểu diễn trực quan", "grade": 12, "construction": "Cho đồ thị hoặc bảng biến thiên; yêu cầu đọc vị trí hay giá trị cực tiểu. Nhận diện chuyển từ giảm sang tăng rồi lấy đúng loại tọa độ được hỏi.", "wrong_options": "Các lựa chọn lấy những mốc có sẵn trong biểu diễn, đan xen vị trí với giá trị và các loại cực trị; chưa phân loại từng lựa chọn.", "difficulty_source": "Phân biệt nơi xảy ra cực trị với giá trị hàm tại đó.", "discrimination": "low", "typical_steps": 3, "evidence_scope": "lặp giữa các đề", "refs": ["beee25b53250|P1|12|None", "acc00d945397|P1|5|None"]}, {"part_kind": "multiple_choice", "topic": "Tứ phân vị của mẫu ghép nhóm", "grade": [11, 12], "construction": "Cho bảng khoảng lớp và tần số; yêu cầu một tứ phân vị hoặc đại lượng suy ra từ các tứ phân vị. Tính vị trí, tìm lớp bằng tần số tích lũy, nội suy rồi thực hiện phép tổng hợp nếu cần.", "wrong_options": "Các lựa chọn là những giá trị hoặc độ rộng khác nhau; độ gần nhau chưa đủ chứng minh chúng được tạo bằng lỗi nội suy cụ thể.", "difficulty_source": "Chọn đúng lớp chứa tứ phân vị trước khi thay công thức.", "discrimination": "medium", "typical_steps": 4, "evidence_scope": "lặp giữa các đề", "refs": ["beee25b53250|P1|11|None", "acc00d945397|P1|4|None"]}, {"part_kind": "multiple_choice", "topic": "Tiệm cận của hàm phân thức", "grade": 12, "construction": "Cho phân thức và yêu cầu phương trình tiệm cận. Với tiệm cận ngang, xét hệ số dẫn đầu để xác định giới hạn; với tiệm cận đứng, tìm nghiệm mẫu và kiểm tra tử không đồng thời triệt tiêu.", "wrong_options": "Các lựa chọn biến đổi dấu, tỉ số hệ số, nghiệm tử hoặc mẫu và hướng đường thẳng; chưa xác nhận cơ chế sai của từng lựa chọn.", "difficulty_source": "Chọn đúng dữ kiện đại số tương ứng với loại tiệm cận được hỏi.", "discrimination": "low", "typical_steps": 3, "evidence_scope": "lặp giữa các đề ở cấu trúc nhận diện tiệm cận; từng loại có thao tác riêng", "refs": ["beee25b53250|P1|5|None", "acc00d945397|P1|7|None"]}, {"part_kind": "multiple_choice", "topic": "Tính đơn điệu từ đồ thị", "grade": 12, "construction": "Cho đồ thị có các mốc đổi chiều; yêu cầu chọn khoảng đồng biến. Đọc chiều đồ thị khi đối số tăng và kiểm tra toàn bộ khoảng ứng viên.", "wrong_options": "Các khoảng thay đổi chiều biến thiên hoặc đi qua điểm đổi chiều; chưa phân loại từng lựa chọn.", "difficulty_source": "Không suy tính đơn điệu của cả khoảng từ một đoạn bên trong.", "discrimination": "low", "typical_steps": 3, "evidence_scope": "quan sát riêng trong một đề", "refs": ["beee25b53250|P1|4|None"]}, {"part_kind": "multiple_choice", "topic": "Tính đơn điệu từ công thức", "grade": 12, "construction": "Cho đa thức; yêu cầu chọn khoảng nghịch biến. Tính đạo hàm, tìm các mốc đổi dấu và đối chiếu khoảng ứng viên với miền đạo hàm âm.", "wrong_options": "Các khoảng thay đổi phía hoặc độ rộng, có thể bao gồm cả miền tăng và giảm; chưa phân loại từng lựa chọn.", "difficulty_source": "Kiểm tra dấu trên toàn khoảng.", "discrimination": "low", "typical_steps": 3, "evidence_scope": "quan sát riêng trong một đề", "refs": ["acc00d945397|P1|12|None"]}, {"part_kind": "multiple_choice", "topic": "Nhận dạng công thức từ đồ thị", "grade": 12, "construction": "Cho hình đồ thị và các công thức ứng viên; yêu cầu chọn công thức phù hợp. Dùng tính liên tục, hướng nhánh và cấu trúc cực trị để loại ứng viên.", "wrong_options": "Các công thức khác nhau về loại hàm và hướng nhánh; chưa phân loại từng lựa chọn.", "difficulty_source": "Chọn dấu hiệu hình dạng đủ quyết định thay vì khảo sát toàn bộ từng hàm.", "discrimination": "low", "typical_steps": 3, "evidence_scope": "quan sát riêng trong một đề", "refs": ["beee25b53250|P1|7|None"]}, {"part_kind": "true_false", "topic": "Tối ưu đại lượng từ tốc độ biến thiên", "grade": 12, "construction": "Cho tốc độ biến thiên cùng miền xét và dữ kiện giá trị; yêu cầu kiểm tra vị trí tối ưu, giá trị lớn nhất hoặc khả năng vượt ngưỡng. Xét dấu tốc độ để tìm cực đại toàn miền; chỉ khôi phục hàm bằng nguyên hàm khi cần giá trị của đại lượng.", "wrong_options": "Nguy cơ nhầm vị trí tối ưu với giá trị tối ưu, chỉ giải điều kiện dừng hoặc bỏ điều kiện ban đầu; chưa xác nhận nhận định nào sai.", "difficulty_source": "Phân biệt yêu cầu tìm đối số với yêu cầu tính giá trị và kiểm tra tính toàn miền.", "discrimination": "medium", "typical_steps": 4, "evidence_scope": "lặp giữa các đề", "refs": ["3f1b2aa3cb72|P2|1|c", "3f1b2aa3cb72|P2|1|d", "beee25b53250|P2|3|b"]}, {"part_kind": "true_false", "topic": "Lấy mẫu không hoàn lại", "grade": 10, "construction": "Cho thành phần một tập vật và yêu cầu kiểm tra xác suất nhóm được chọn có thành phần nhất định. Đếm số nhóm thuận lợi và chia cho số nhóm có thể chọn.", "wrong_options": "Nguy cơ dùng tỉ lệ của một phần tử thay cho xác suất của cả nhóm hoặc bỏ tính không hoàn lại; chưa xác nhận nhận định sai.", "difficulty_source": "Chọn đúng mô hình đếm nhóm.", "discrimination": "low", "typical_steps": 3, "evidence_scope": "quan sát riêng trong một đề", "refs": ["3f1b2aa3cb72|P2|2|a"]}, {"part_kind": "true_false", "topic": "Xác suất đồng thời trong quy trình liên tiếp", "grade": 12, "construction": "Cho quy trình chuyển rồi lấy mẫu; yêu cầu kiểm tra xác suất các kết quả xảy ra theo thứ tự. Tính xác suất giai đoạn đầu, cập nhật thành phần rồi nhân với xác suất có điều kiện ở giai đoạn sau.", "wrong_options": "Nguy cơ coi các giai đoạn độc lập hoặc giữ nguyên thành phần sau chuyển; chưa xác nhận nhận định sai.", "difficulty_source": "Theo dõi sự thay đổi không gian lấy mẫu.", "discrimination": "medium", "typical_steps": 4, "evidence_scope": "quan sát riêng trong một đề", "refs": ["3f1b2aa3cb72|P2|2|b"]}, {"part_kind": "true_false", "topic": "Xác suất toàn phần", "grade": 12, "construction": "Cho kết quả cuối phụ thuộc vào thành phần trung gian chưa biết; yêu cầu kiểm tra xác suất kết quả cuối. Phân hoạch các trường hợp trung gian, tính xác suất có điều kiện rồi cộng các tích có trọng số.", "wrong_options": "Nguy cơ bỏ nhánh, cộng xác suất có điều kiện không trọng số hoặc không cập nhật thành phần; chưa xác nhận nhận định sai.", "difficulty_source": "Lập phân hoạch đầy đủ trước khi tổng hợp.", "discrimination": "medium", "typical_steps": 4, "evidence_scope": "quan sát riêng trong một đề", "refs": ["3f1b2aa3cb72|P2|2|c"]}, {"part_kind": "true_false", "topic": "Xác suất nguyên nhân khi biết kết quả", "grade": 12, "construction": "Cho kết quả quan sát và giả thuyết về giai đoạn trước; yêu cầu kiểm tra xác suất hậu nghiệm. Xác định chiều điều kiện, tính xác suất giao và xác suất kết quả rồi lập tỉ số.", "wrong_options": "Nguy cơ đảo chiều điều kiện hoặc dùng sai mẫu số; chưa xác nhận nhận định sai.", "difficulty_source": "Suy ngược từ kết quả về nguyên nhân.", "discrimination": "medium", "typical_steps": 4, "evidence_scope": "quan sát riêng trong một đề", "refs": ["3f1b2aa3cb72|P2|2|d"]}, {"part_kind": "true_false", "topic": "Vị trí trong chuyển động đều", "grade": 12, "construction": "Cho vị trí ở các mốc thời gian và giả thiết chuyển động đều; yêu cầu kiểm tra vị trí tiếp theo. Lấy hiệu tọa độ, suy vận tốc rồi dịch chuyển theo khoảng thời gian cần xét.", "wrong_options": "Nguy cơ nhầm mốc thời gian hoặc dùng vectơ dịch chuyển như tọa độ vị trí; chưa xác nhận nhận định sai.", "difficulty_source": "Tỉ lệ hóa đúng vectơ dịch chuyển.", "discrimination": "low", "typical_steps": 3, "evidence_scope": "quan sát riêng trong một đề", "refs": ["3f1b2aa3cb72|P2|3|a"]}, {"part_kind": "multiple_choice", "topic": "Khoảng cách trong không gian tọa độ", "grade": 12, "construction": "Cho tọa độ các đầu mút; yêu cầu chọn độ dài đoạn nối. Lấy hiệu từng thành phần rồi tính chuẩn của vectơ.", "wrong_options": "Các lựa chọn gồm độ lớn theo riêng từng phương hoặc đại lượng chưa lấy căn; chưa phân loại từng lựa chọn.", "difficulty_source": "Giữ đủ các thành phần và hoàn thành phép lấy căn.", "discrimination": "low", "typical_steps": 2, "evidence_scope": "quan sát riêng trong một đề; thao tác chuẩn vectơ còn xuất hiện ở dạng kiểm tra nhận định", "refs": ["acc00d945397|P1|3|None"]}, {"part_kind": "true_false", "topic": "Độ dài vectơ trong chuyển động", "grade": 12, "construction": "Cho các vị trí đồng thời hoặc các đầu mút của chuyển động thẳng; yêu cầu kiểm tra khoảng cách hoặc tốc độ trung bình. Tính chuẩn vectơ nối đúng các vị trí, chia thời gian nếu hỏi tốc độ rồi xử lý đơn vị và làm tròn.", "wrong_options": "Nguy cơ bỏ thành phần, nhầm khoảng cách tương đối với khoảng cách tới gốc hoặc đổi sai đơn vị; chưa xác nhận nhận định sai.", "difficulty_source": "Chọn đúng vectơ trước khi áp dụng công thức độ dài.", "discrimination": "low", "typical_steps": 3, "evidence_scope": "quan sát riêng trong một đề", "refs": ["3f1b2aa3cb72|P2|3|b", "3f1b2aa3cb72|P2|3|c"]}, {"part_kind": "true_false", "topic": "Tốc độ thay đổi khoảng cách", "grade": 12, "construction": "Cho hướng, quãng dịch chuyển và vận tốc tức thời; yêu cầu kiểm tra tốc độ biến thiên khoảng cách. Chuẩn hóa hướng, lập vectơ vị trí và vận tốc tương đối, đạo hàm hệ thức độ dài rồi tính đại lượng có dấu.", "wrong_options": "Nguy cơ thay tốc độ biến thiên khoảng cách bằng tổng tốc độ hoặc chuẩn vận tốc tương đối; chưa xác nhận nhận định sai.", "difficulty_source": "Chuyển dữ kiện chuyển động thành đạo hàm của độ dài.", "discrimination": "high", "typical_steps": 4, "evidence_scope": "quan sát riêng trong một đề", "refs": ["3f1b2aa3cb72|P2|3|d"]}, {"part_kind": "true_false", "topic": "Nguyên hàm phân thức và điều kiện giá trị", "grade": 12, "construction": "Cho phân thức tách được thành các hàm cơ bản; yêu cầu kiểm tra họ nguyên hàm hoặc nguyên hàm thỏa điều kiện. Tách biểu thức, lấy nguyên hàm đúng miền rồi xác định hằng số nếu có dữ kiện giá trị.", "wrong_options": "Nguy cơ sai dạng lôgarit, bỏ điều kiện miền hoặc xác định sai hằng số; chưa xác nhận nhận định sai.", "difficulty_source": "Kết hợp biến đổi biểu thức với miền xác định và điều kiện ban đầu.", "discrimination": "low", "typical_steps": 3, "evidence_scope": "quan sát riêng trong một đề", "refs": ["3f1b2aa3cb72|P2|4|a", "3f1b2aa3cb72|P2|4|b"]}, {"part_kind": "true_false", "topic": "Thay đối số trong biểu thức đạo hàm", "grade": 12, "construction": "Cho hàm và biểu thức đạo hàm được lấy tại đối số tuyến tính; yêu cầu kiểm tra nguyên hàm. Tính đạo hàm gốc, thay đối số, lấy nguyên hàm theo biến đang xét rồi kiểm tra ngược.", "wrong_options": "Nguy cơ đánh đồng đạo hàm tại đối số mới với đạo hàm của hàm hợp; chưa xác nhận nhận định sai.", "difficulty_source": "Kiểm soát hệ số phát sinh do hàm hợp.", "discrimination": "medium", "typical_steps": 4, "evidence_scope": "quan sát riêng trong một đề", "refs": ["3f1b2aa3cb72|P2|4|c"]}, {"part_kind": "true_false", "topic": "Tích vô hướng và góc trong tọa độ", "grade": 12, "construction": "Cho tọa độ điểm xác định các vectơ; yêu cầu kiểm tra tích vô hướng hoặc côsin góc. Lập vectơ đúng chiều, cộng tích các thành phần và chuẩn hóa bằng tích độ dài khi hỏi góc.", "wrong_options": "Nguy cơ sai chiều vectơ, sai dấu hoặc thiếu phép chuẩn hóa; chưa xác nhận nhận định sai.", "difficulty_source": "Phân biệt tích vô hướng với côsin góc.", "discrimination": "low", "typical_steps": 3, "evidence_scope": "quan sát riêng trong một đề", "refs": ["beee25b53250|P2|1|a", "beee25b53250|P2|1|d"]}, {"part_kind": "true_false", "topic": "Khôi phục đỉnh từ điều kiện hình học", "grade": 12, "construction": "Cho các đỉnh đã biết, quan hệ song song và vuông góc cùng diện tích; yêu cầu kiểm tra biểu thức theo đỉnh còn lại. Suy các độ dài từ tọa độ và diện tích rồi dựng vectơ cạnh đúng hướng.", "wrong_options": "Chưa đủ căn cứ quy nhận định cho lỗi chọn hướng cạnh hoặc dùng sai diện tích.", "difficulty_source": "Chuyển đồng thời điều kiện hình dạng và diện tích thành tọa độ.", "discrimination": "medium", "typical_steps": 5, "evidence_scope": "quan sát riêng trong một đề", "refs": ["beee25b53250|P2|1|b"]}, {"part_kind": "true_false", "topic": "Cực tiểu tổng bình phương khoảng cách", "grade": 12, "construction": "Cho các điểm cố định, trọng số và điểm di động trên mặt phẳng tọa độ; yêu cầu kiểm tra tọa độ vị trí tối ưu. Quy tổng bình phương về trọng tâm có trọng số rồi chiếu lên miền ràng buộc.", "wrong_options": "Chưa đủ căn cứ quy nhận định cho lỗi bỏ trọng số hoặc bỏ ràng buộc.", "difficulty_source": "Nhận diện cấu trúc trọng tâm ẩn trong biểu thức tối ưu.", "discrimination": "medium", "typical_steps": 4, "evidence_scope": "quan sát riêng trong một đề", "refs": ["beee25b53250|P2|1|c"]}, {"part_kind": "true_false", "topic": "Nghiệm lượng giác dưới ràng buộc thời gian", "grade": 11, "construction": "Cho quy luật lượng giác theo thời gian và điều kiện vị trí; yêu cầu kiểm tra thời điểm đầu tiên hoặc số lần đạt vị trí. Viết đầy đủ các họ nghiệm, chuyển sang thời gian rồi lọc theo miền và đầu mút trước khi chọn hoặc đếm.", "wrong_options": "Nguy cơ bỏ họ nghiệm, bỏ pha ban đầu, chọn sai lần đầu hoặc đếm theo chu kỳ mà không kiểm tra đầu mút; chưa xác nhận nhận định sai.", "difficulty_source": "Xử lý nghiệm tổng quát cùng ràng buộc thời gian.", "discrimination": "medium", "typical_steps": 4, "evidence_scope": "quan sát riêng trong một đề", "refs": ["beee25b53250|P2|2|b", "beee25b53250|P2|2|d"]}, {"part_kind": "true_false", "topic": "Giá trị đại lượng tại thời điểm tốc độ lớn nhất", "grade": 12, "construction": "Cho tốc độ biến thiên và giá trị ban đầu; yêu cầu kiểm tra mức đại lượng khi nó tăng nhanh nhất. Tối ưu hàm tốc độ, khôi phục hàm đại lượng rồi tính tại thời điểm vừa tìm.", "wrong_options": "Nguy cơ nhầm cực đại của tốc độ với cực đại của đại lượng; chưa xác nhận nhận định sai.", "difficulty_source": "Nối hai tầng hàm số có quan hệ đạo hàm.", "discrimination": "medium", "typical_steps": 5, "evidence_scope": "quan sát riêng trong một đề", "refs": ["beee25b53250|P2|3|a"]}, {"part_kind": "true_false", "topic": "Thay giá trị vào hàm đã cho", "grade": [10, 11], "construction": "Cho trực tiếp biểu thức của đại lượng cần kiểm tra; yêu cầu giá trị tại đối số chỉ định. Thay vào biểu thức, rút gọn rồi đối chiếu cả ý nghĩa đại lượng và đơn vị nếu có.", "wrong_options": "Chưa xác nhận nhận định sai hoặc cơ chế tạo sai lệch.", "difficulty_source": "Chọn đúng hàm cần tính thay vì thực hiện thêm phép đạo hàm hay nguyên hàm không cần thiết.", "discrimination": "low", "typical_steps": 2, "evidence_scope": "quan sát riêng trong một đề", "refs": ["beee25b53250|P2|3|c", "beee25b53250|P2|4|a"]}, {"part_kind": "true_false", "topic": "Kiểm tra tăng giảm bằng dấu tốc độ", "grade": 12, "construction": "Cho hàm đại lượng hoặc trực tiếp tốc độ của nó; yêu cầu kiểm tra khoảng nghịch biến hay thời lượng tăng. Tìm đạo hàm nếu cần, xét dấu rồi giao với miền được hỏi.", "wrong_options": "Nguy cơ xét riêng một thừa số, nhầm tăng trưởng với tăng tốc hoặc suy dấu từ một phần của khoảng; chưa xác nhận nhận định sai.", "difficulty_source": "Xác định đúng hàm đóng vai trò đạo hàm và kiểm tra toàn miền.", "discrimination": "medium", "typical_steps": 4, "evidence_scope": "quan sát riêng trong một đề", "refs": ["beee25b53250|P2|3|d", "beee25b53250|P2|4|b"]}, {"part_kind": "true_false", "topic": "Đạo hàm của tích", "grade": 11, "construction": "Cho tích đa thức với hàm mũ và công thức đạo hàm đề xuất; yêu cầu kiểm tra. Áp dụng đầy đủ quy tắc đạo hàm tích, tính từng thành phần rồi rút gọn.", "wrong_options": "Nguy cơ thiếu một hạng của quy tắc tích; chưa xác nhận đây là lỗi của nhận định.", "difficulty_source": "Giữ đủ các hạng và hệ số.", "discrimination": "low", "typical_steps": 3, "evidence_scope": "quan sát riêng trong một đề", "refs": ["beee25b53250|P2|4|c"]}, {"part_kind": "true_false", "topic": "Cực trị toàn cục trên đoạn", "grade": 12, "construction": "Cho hàm trên đoạn đóng và giá trị nhỏ nhất đề xuất; yêu cầu kiểm tra. Tìm điểm tới hạn trong đoạn, tính giá trị tại các ứng viên bên trong và đầu mút rồi so sánh.", "wrong_options": "Nguy cơ chỉ xét đầu mút hoặc bỏ điểm tới hạn; chưa xác nhận nhận định sai.", "difficulty_source": "Liệt kê đủ tập ứng viên trước khi kết luận.", "discrimination": "medium", "typical_steps": 4, "evidence_scope": "quan sát riêng trong một đề", "refs": ["beee25b53250|P2|4|d"]}, {"part_kind": "short_answer", "topic": "Diện tích từ điều kiện khoảng cách", "grade": 12, "construction": "Cho miền hình học được xác định bằng so sánh khoảng cách; yêu cầu diện tích. Đặt tọa độ, chia miền theo đối xứng và đối tượng gần nhất, suy phương trình biên rồi lập tích phân.", "wrong_options": null, "difficulty_source": "Tự dựng miền tích phân từ điều kiện hình học có phân nhánh.", "discrimination": "high", "typical_steps": 5, "evidence_scope": "quan sát riêng trong một đề", "refs": ["3f1b2aa3cb72|P3|1|None"]}, {"part_kind": "short_answer", "topic": "Tổng diện tích của cấu hình lặp", "grade": 11, "construction": "Cho quy luật tạo các hình nội tiếp và phần diện tích được chọn ở mỗi lượt; yêu cầu tổng hữu hạn. Tính phần đầu, suy tỉ số diện tích, kiểm tra không chồng lấn rồi dùng tổng cấp số nhân.", "wrong_options": null, "difficulty_source": "Nhận ra quy luật nhân của diện tích thay vì cộng từng hình.", "discrimination": "medium", "typical_steps": 4, "evidence_scope": "quan sát riêng trong một đề", "refs": ["3f1b2aa3cb72|P3|2|None"]}, {"part_kind": "short_answer", "topic": "Đếm phép gán không lặp dưới ràng buộc", "grade": [10, 11], "construction": "Cho tập giá trị hữu hạn và bố trí ô có ràng buộc giữa các vị trí; yêu cầu số phép gán. Dùng vị trí đặc biệt để xác định mốc hoặc tham số, chọn các nhóm giá trị hợp lệ, xử lý thứ tự và cộng các trường hợp rời nhau.", "wrong_options": null, "difficulty_source": "Biến bố trí hình thành cấu trúc đếm và đồng thời giữ điều kiện không lặp. Ràng buộc thứ tự và ràng buộc tổng là các biến thể riêng.", "discrimination": "high", "typical_steps": 6, "evidence_scope": "lặp giữa các đề ở khung đếm có ràng buộc; điều kiện cụ thể khác nhau", "refs": ["3f1b2aa3cb72|P3|3|None", "beee25b53250|P3|1|None"]}, {"part_kind": "short_answer", "topic": "Góc nhị diện qua các phương vuông góc cạnh", "grade": 11, "construction": "Cho quan hệ hình học hoặc góc giữa các cạnh; yêu cầu đại lượng lượng giác của góc nhị diện. Dựng thiết diện hoặc chiếu các phương lên mặt phẳng vuông góc cạnh nhị diện, xác định đúng góc rồi tính bằng hệ thức lượng.", "wrong_options": null, "difficulty_source": "Chuyển góc giữa các mặt thành góc giữa các phương đúng và giữ đúng hai nửa mặt phẳng.", "discrimination": "high", "typical_steps": 5, "evidence_scope": "lặp giữa các đề", "refs": ["3f1b2aa3cb72|P3|5|None", "beee25b53250|P3|2|None"]}, {"part_kind": "short_answer", "topic": "Khôi phục mô hình từ tốc độ phụ thuộc đại lượng", "grade": 12, "construction": "Cho tốc độ phụ thuộc vào chính đại lượng và các quan sát theo thời gian; yêu cầu thời điểm đạt trạng thái hoặc giá trị dự báo. Chọn biến đổi có đạo hàm hằng, tích phân, xác định tham số từ dữ kiện rồi trở lại đại lượng và kiểm tra miền mô hình.", "wrong_options": null, "difficulty_source": "Nhận ra biến đổi phù hợp thay vì giả định đại lượng biến thiên tuyến tính.", "discrimination": "medium", "typical_steps": 5, "evidence_scope": "lặp giữa các đề ở bước tuyến tính hóa; dạng phụ thuộc khác nhau", "refs": ["3f1b2aa3cb72|P3|6|None", "beee25b53250|P3|5|None"]}, {"part_kind": "short_answer", "topic": "Khoảng cách nhỏ nhất đến đường chuyển động", "grade": 12, "construction": "Cho đường chuyển động qua các vị trí và điểm cố định; yêu cầu biểu thức tọa độ tại vị trí gần nhất. Lập phương trình tham số, dùng điều kiện vuông góc của hình chiếu rồi tính tọa độ cần thiết.", "wrong_options": null, "difficulty_source": "Nhận diện cực tiểu khoảng cách thành phép chiếu và dùng đúng miền đường chuyển động.", "discrimination": "medium", "typical_steps": 4, "evidence_scope": "quan sát riêng trong một đề", "refs": ["3f1b2aa3cb72|P3|4|None"]}, {"part_kind": "short_answer", "topic": "Xác suất gắn với điều kiện hình học", "grade": 10, "construction": "Cho các kết quả ngẫu nhiên xác định dữ kiện hình học; yêu cầu xác suất hình thỏa một tính chất. Lập phân bố của đại lượng trung gian, phân loại đầy đủ trường hợp hình học, tìm các bộ hợp lệ rồi cộng xác suất đúng trọng số.", "wrong_options": null, "difficulty_source": "Kết hợp phân bố không đồng đều với điều kiện hình học có nhiều trường hợp.", "discrimination": "high", "typical_steps": 6, "evidence_scope": "quan sát riêng trong một đề", "refs": ["beee25b53250|P3|4|None"]}, {"part_kind": "short_answer", "topic": "Tối ưu tổng khoảng cách bằng đối xứng", "grade": 12, "construction": "Cho điểm di động trên mặt phẳng và các điểm cố định; yêu cầu đại lượng phụ thuộc vị trí tối ưu. Phản xạ điểm qua mặt phẳng, dùng bất đẳng thức tam giác cùng điều kiện đẳng thức để xác định vị trí rồi tính các khoảng cách được hỏi.", "wrong_options": null, "difficulty_source": "Chọn phép biến đổi làm lộ trường hợp đạt cực tiểu trước khi tính toán tọa độ.", "discrimination": "high", "typical_steps": 6, "evidence_scope": "quan sát riêng trong một đề", "refs": ["beee25b53250|P3|6|None"]}], "discrimination_moves": [{"move": "Buộc người giải tự chọn biểu diễn trung gian", "how_to_apply": "Cho dữ kiện hình học hoặc chuyển động nhưng không cho sẵn biểu thức đích; yêu cầu chuyển sang tọa độ, miền tích phân hoặc cấu trúc đếm trước khi tính. Đây là nét chung giữa các đề, không phải bằng chứng từng mô hình cụ thể tái diễn.", "refs": ["3f1b2aa3cb72|P2|3|d", "3f1b2aa3cb72|P3|1|None", "3f1b2aa3cb72|P3|3|None", "beee25b53250|P3|1|None", "beee25b53250|P3|6|None"]}, {"move": "Đặt nhiều ràng buộc phải thỏa đồng thời", "how_to_apply": "Kết hợp điều kiện thứ tự, quan hệ đại số hoặc tổng với tính không lặp; lời giải phải kiểm tra tính hợp lệ của cả cấu hình, không chỉ từng vị trí riêng.", "refs": ["3f1b2aa3cb72|P3|3|None", "beee25b53250|P3|1|None"]}, {"move": "Yêu cầu phân chia trường hợp đầy đủ", "how_to_apply": "Đặt điều kiện mà đối tượng quyết định thay đổi theo miền hoặc theo trường hợp; người giải phải lập phân hoạch không bỏ sót và không đếm lặp trước khi tổng hợp.", "refs": ["3f1b2aa3cb72|P3|1|None", "3f1b2aa3cb72|P3|3|None", "beee25b53250|P3|1|None", "beee25b53250|P3|4|None"]}, {"move": "Chuyển quan hệ không gian sang các phương chiếu đúng", "how_to_apply": "Cho dữ kiện về cạnh hoặc góc ở đỉnh rồi yêu cầu góc giữa các mặt; không cung cấp trực tiếp góc phẳng cần tính. Người giải phải dựng hoặc chiếu vuông góc với cạnh nhị diện.", "refs": ["beee25b53250|P3|2|None"]}, {"move": "Phân biệt đại lượng đích với đại lượng gần giống", "how_to_apply": "Hỏi tốc độ biến thiên của khoảng cách khi dữ kiện trực tiếp là vận tốc các vật; yêu cầu giữ phép chiếu và dấu thay vì chỉ tính một chuẩn vectơ. Đây là quan sát riêng, chưa có bằng chứng tái diễn của cách hỏi cụ thể.", "refs": ["3f1b2aa3cb72|P2|3|d"]}, {"move": "Làm mất tính đồng khả năng ở tầng đại lượng trung gian", "how_to_apply": "Cho kết quả sơ cấp đồng khả năng nhưng yêu cầu xét đại lượng tổng hợp; lời giải phải lập phân bố có trọng số trước khi kiểm tra điều kiện hình học. Đây là quan sát riêng.", "refs": ["beee25b53250|P3|4|None"]}, {"move": "Giấu vị trí tối ưu sau phép biến đổi hình học", "how_to_apply": "Dùng tổng khoảng cách có điểm bị ràng buộc trên mặt phẳng; người giải cần tìm phép phản xạ và điều kiện đẳng thức trước khi tính đại lượng cuối. Đây là quan sát riêng.", "refs": ["beee25b53250|P3|6|None"]}], "easy_vs_hard": [{"topic": "Tọa độ và chuyển động", "easy": "Tính khoảng cách trực tiếp từ các vị trí hoặc ngoại suy vị trí theo chuyển động đều.", "hard": "Dựng vị trí và vận tốc tương đối rồi lấy đạo hàm độ dài, phân biệt tốc độ biến thiên khoảng cách với chuẩn vận tốc tương đối.", "easy_refs": ["acc00d945397|P1|3|None", "3f1b2aa3cb72|P2|3|a", "3f1b2aa3cb72|P2|3|b"], "hard_refs": ["3f1b2aa3cb72|P2|3|d"]}, {"topic": "Góc nhị diện", "easy": "Cấu hình vuông góc và quan hệ độ dài làm thiết diện thích hợp dễ nhận ra.", "hard": "Dữ kiện là các góc giữa cạnh; phải tự chiếu các phương rồi khôi phục góc nhị diện.", "easy_refs": ["acc00d945397|P1|9|None", "3f1b2aa3cb72|P3|5|None"], "hard_refs": ["beee25b53250|P3|2|None"]}, {"topic": "Nguyên hàm và tích phân", "easy": "Nhận dạng công thức nguyên hàm từ biểu thức đã cho.", "hard": "Tự chuyển điều kiện khoảng cách thành biên hình học, chia miền rồi mới lập tích phân diện tích.", "easy_refs": ["beee25b53250|P1|6|None", "acc00d945397|P1|2|None"], "hard_refs": ["3f1b2aa3cb72|P3|1|None"]}, {"topic": "Cấp số cộng", "easy": "Dùng quan hệ giữa số hạng và chỉ số để tìm công sai.", "hard": "Dùng điều kiện cấp số cộng làm ràng buộc trong bài toán gán giá trị có thứ tự và đếm các khoảng xen giữa.", "easy_refs": ["beee25b53250|P1|9|None"], "hard_refs": ["3f1b2aa3cb72|P3|3|None"]}, {"topic": "Tối ưu khoảng cách", "easy": "Vị trí gần nhất quy trực tiếp về hình chiếu vuông góc.", "hard": "Phải phản xạ để tìm vị trí tối ưu của tổng khoảng cách rồi mới tính các đại lượng phụ.", "easy_refs": ["3f1b2aa3cb72|P3|4|None"], "hard_refs": ["beee25b53250|P3|6|None"]}, {"topic": "Xác suất cổ điển", "easy": "Đếm nhóm thuận lợi trong không gian chọn mẫu được cho trực tiếp.", "hard": "Lập phân bố đại lượng trung gian, phân loại điều kiện hình học và cộng xác suất có trọng số.", "easy_refs": ["3f1b2aa3cb72|P2|2|a"], "hard_refs": ["beee25b53250|P3|4|None"]}], "fact_use": {"common": [{"use": "Kiến thức nhớ được dùng như công cụ thao tác: công thức nguyên hàm, đạo hàm, thể tích, lôgarit và số hạng của dãy.", "refs": ["acc00d945397|P1|2|None", "beee25b53250|P1|6|None", "beee25b53250|P2|4|c", "beee25b53250|P1|1|None", "beee25b53250|P1|3|None", "acc00d945397|P1|11|None", "beee25b53250|P1|9|None"]}, {"use": "Định nghĩa được kiểm tra qua việc phân biệt đối tượng gần nhau: vị trí và giá trị cực trị, miền công thức và miền mô hình, đường song song mặt phẳng và đường có điểm chung.", "refs": ["beee25b53250|P1|12|None", "acc00d945397|P1|5|None", "beee25b53250|P2|2|c", "beee25b53250|P1|2|None"]}, {"use": "Dữ kiện định lượng được cung cấp để tính toán, xác định tham số, đặt ràng buộc hoặc chọn miền; không phải kiến thức thực tế phải nhớ từ bên ngoài.", "refs": ["acc00d945397|P1|4|None", "acc00d945397|P1|10|None", "beee25b53250|P3|3|None", "beee25b53250|P3|5|None", "3f1b2aa3cb72|P3|6|None"]}, {"use": "Các bài phân hóa huy động công thức quen thuộc sau một bước dựng biểu diễn hoặc nhận ra cấu trúc ẩn; việc nhớ công thức không tự quyết định lời giải.", "refs": ["3f1b2aa3cb72|P3|1|None", "3f1b2aa3cb72|P3|3|None", "beee25b53250|P3|2|None", "beee25b53250|P3|4|None", "beee25b53250|P3|6|None"]}], "not_observed": [{"observation": "Không thấy yêu cầu nhớ ngày tháng, nhân danh hoặc sự kiện bên ngoài để giải bài. Kết luận này chỉ nói về các hàng được cung cấp.", "refs": ["beee25b53250|P2|3|a", "beee25b53250|P3|3|None", "beee25b53250|P3|5|None", "3f1b2aa3cb72|P3|6|None"]}, {"observation": "Không thấy yêu cầu chép nguyên văn định nghĩa hay trình bày lịch sử khái niệm; các khái niệm được nhận diện hoặc vận dụng vào một kết quả cần chọn, kiểm tra hay tính.", "refs": ["beee25b53250|P1|2|None", "acc00d945397|P1|5|None", "acc00d945397|P1|6|None", "beee25b53250|P2|2|c"]}]}, "anti_patterns": [{"avoid": "Không thay chuỗi suy luận bằng yêu cầu kể lại kiến thức nền của bối cảnh.", "basis": "Ở các bài mô hình được cung cấp, bối cảnh đưa ra quan hệ định lượng đủ dùng và đầu ra vẫn là kết quả toán học.", "refs": ["beee25b53250|P3|3|None", "beee25b53250|P3|5|None", "3f1b2aa3cb72|P3|6|None"]}, {"avoid": "Không mặc định một hình minh họa chứa dữ kiện định lượng ngoài văn bản.", "basis": "Các hàng về chuyển vật và đường chuyển động xác định dữ kiện tính toán bằng văn bản; hình được mô tả là minh họa.", "refs": ["3f1b2aa3cb72|P2|2|a", "3f1b2aa3cb72|P2|2|b", "3f1b2aa3cb72|P2|2|c", "3f1b2aa3cb72|P2|2|d", "3f1b2aa3cb72|P3|4|None"]}, {"avoid": "Không tạo đáp án nhiễu tùy tiện, không liên hệ với biểu thức hoặc biểu diễn đã cho.", "basis": "Các lựa chọn được mô tả có biến đổi cục bộ về dấu, thành phần, hệ số hoặc lấy các mốc trong biểu diễn. Chưa đủ khóa để xác nhận lỗi cụ thể của từng lựa chọn.", "refs": ["beee25b53250|P1|10|None", "acc00d945397|P1|2|None", "acc00d945397|P1|3|None", "acc00d945397|P1|5|None", "acc00d945397|P1|6|None"]}, {"avoid": "Không tạo độ khó chỉ bằng cách kéo dài phép tính.", "basis": "Các hàng được đánh giá phân hóa cao đặt nút thắt ở mô hình hóa, phân hoạch, phép chiếu, trọng số xác suất hoặc phép phản xạ.", "refs": ["3f1b2aa3cb72|P2|3|d", "3f1b2aa3cb72|P3|1|None", "3f1b2aa3cb72|P3|3|None", "beee25b53250|P3|2|None", "beee25b53250|P3|4|None", "beee25b53250|P3|6|None"]}, {"avoid": "Không thay câu trả lời ngắn bằng yêu cầu nghị luận mở về bối cảnh.", "basis": "Các hàng trả lời ngắn hướng tới đại lượng xác định: diện tích, số cách, giá trị lượng giác, thời gian, xác suất hoặc giá trị tối ưu.", "refs": ["3f1b2aa3cb72|P3|1|None", "3f1b2aa3cb72|P3|3|None", "3f1b2aa3cb72|P3|5|None", "3f1b2aa3cb72|P3|6|None", "beee25b53250|P3|3|None", "beee25b53250|P3|4|None"]}], "excluded_from_recurrence": [{"reason": "Không dùng nhận định có đại lượng biểu diễn chưa xác định duy nhất làm mẫu phân hóa hoặc chuẩn thiết kế. Hàng này còn thiếu khóa phù hợp và điều kiện bảo đảm tính duy nhất của đại lượng được hỏi; dữ liệu không hỗ trợ khẳng định mọi đề đều tránh lỗi này.", "refs": ["3f1b2aa3cb72|P2|4|d"]}]}, {"evidence_limits": {"scope": "Các kết luận chỉ áp dụng cho những hàng được cung cấp thuộc nguồn đề cấp tỉnh bên thứ ba; không đại diện cho toàn bộ dạng đề.", "pattern_limit": "Không đủ bằng chứng liên đề để lập danh mục mẫu lặp lại theo độ dài yêu cầu mà không tách vụn cùng một cấu trúc hoặc nâng quan sát riêng thành sự lặp lại. Mục patterns chỉ giữ những cấu trúc có bằng chứng từ các đề khác nhau.", "uncertainty": "Không suy đoán đúng sai hoặc nguồn tạo giá trị nhiễu khi hàng dữ liệu chưa xác nhận. Các thủ pháp phân hóa được mô tả như quan sát có dẫn chứng, không mặc nhiên là thủ pháp lặp lại liên đề."}, "patterns": [{"part_kind": "multiple_choice", "topic": "Đọc vectơ từ biểu diễn tọa độ", "grade": 12, "construction": "Cho biểu diễn theo vectơ đơn vị hoặc phương trình hình học có chứa các thành phần vectơ. Nhận diện đúng vị trí mang thông tin, đọc các thành phần theo thứ tự trục, giữ dấu và đối chiếu vectơ phù hợp. Với pháp tuyến hoặc chỉ phương, chấp nhận các vectơ cùng phương.", "wrong_options": "Đổi thứ tự thành phần, mất dấu, đặt sai thành phần triệt tiêu hoặc trộn hệ số vectơ với hằng số và tọa độ điểm.", "difficulty_source": "Đọc đúng cấu trúc biểu diễn thay vì gom các hệ số xuất hiện trong đề.", "discrimination": "low", "typical_steps": 2, "refs": ["3b4cca11ea82|P1|2|None", "3b4cca11ea82|P1|8|None", "de5833d227dd|P1|10|None"]}, {"part_kind": "multiple_choice", "topic": "Số hạng của cấp số nhân", "grade": 11, "construction": "Cho công bội trực tiếp hoặc cho các số hạng liên tiếp để suy ra công bội. Xác định số lần nhân từ số hạng đầu đến vị trí cần tìm rồi tính số hạng.", "wrong_options": "Dùng quy luật cộng thay quy luật nhân, bỏ số hạng đầu hoặc lệch chỉ số khi lấy lũy thừa công bội.", "difficulty_source": "Kiểm soát vị trí số hạng và số lần nhân.", "discrimination": "low", "typical_steps": 3, "refs": ["3b4cca11ea82|P1|3|None", "de5833d227dd|P1|3|None"]}, {"part_kind": "multiple_choice", "topic": "Phân tích vectơ bằng quy tắc hình hộp", "grade": 12, "construction": "Cho hình không gian có các đỉnh được ký hiệu. Biểu diễn vectơ đường chéo bằng tổng các vectơ cạnh cùng gốc, sau đó kiểm tra hướng và điểm cuối của tổng.", "wrong_options": "Thiếu thành phần, đảo chiều cạnh, dùng đường chéo thay cạnh gây cộng lặp hoặc ghép đường đi đến sai đỉnh.", "difficulty_source": "Theo dõi độ dời có hướng trên hình phối cảnh.", "discrimination": "low", "typical_steps": 3, "refs": ["3b4cca11ea82|P1|4|None", "de5833d227dd|P1|4|None"]}, {"part_kind": "multiple_choice", "topic": "Nguyên hàm của tổng các hàm cơ bản", "grade": 12, "construction": "Cho tổng các hàm cơ bản có thành phần lượng giác. Tách nguyên hàm theo tính tuyến tính, áp dụng công thức cho từng thành phần và ghép lại với hằng số tùy ý.", "wrong_options": "Giữ nguyên thành phần lượng giác, đổi dấu sai hoặc dùng kết quả đạo hàm thay cho nguyên hàm.", "difficulty_source": "Nhớ đúng phép đổi hàm và dấu của nguyên hàm lượng giác.", "discrimination": "low", "typical_steps": 3, "refs": ["3b4cca11ea82|P1|6|None", "de5833d227dd|P1|7|None"]}, {"part_kind": "multiple_choice", "topic": "Tiệm cận đứng của hàm phân thức", "grade": 12, "construction": "Cho hàm phân thức có mẫu bậc nhất. Giải điều kiện mẫu triệt tiêu, kiểm tra tử tại vị trí đó rồi chọn phương trình đường thẳng đứng.", "wrong_options": "Viết đường ngang, nhầm với tiệm cận ngang hoặc lấy hệ số và thông tin từ tử thay cho nghiệm của mẫu.", "difficulty_source": "Phân biệt vị trí tiệm cận với hệ số của biểu thức và phân biệt các loại tiệm cận.", "discrimination": "low", "typical_steps": 3, "refs": ["3b4cca11ea82|P1|7|None", "de5833d227dd|P1|1|None"]}, {"part_kind": "multiple_choice", "topic": "Phương trình mũ và lôgarit quy về phương trình bậc nhất", "grade": 11, "construction": "Cho phép mũ hoặc lôgarit tác động lên biểu thức bậc nhất. Dùng quan hệ ngược giữa mũ và lôgarit hoặc quy về cùng cơ số để tách biểu thức chứa ẩn, giải phương trình bậc nhất và kiểm tra điều kiện thích hợp.", "wrong_options": "Dừng ở giá trị trung gian, bỏ phần dịch chuyển của ẩn, chuyển vế sai hoặc nhầm phép lũy thừa với phép nhân. Một số nhiễu chưa có nguồn sai xác định.", "difficulty_source": "Phân biệt giá trị của biểu thức chứa ẩn với nghiệm cần trả lời.", "discrimination": "low", "typical_steps": 3, "refs": ["3b4cca11ea82|P1|9|None", "de5833d227dd|P1|2|None"]}, {"part_kind": "multiple_choice", "topic": "Phương trình lượng giác tại giá trị cực trị", "grade": 11, "construction": "Cho phương trình lượng giác tại giá trị cực trị. Xác định vị trí nghiệm trên đường tròn lượng giác rồi dùng chu kỳ để viết tập nghiệm đầy đủ.", "wrong_options": "Đổi hàm lượng giác, dùng vị trí giao trục hoặc chọn bước lặp đưa thêm nghiệm có giá trị trái dấu.", "difficulty_source": "Phối hợp đúng vị trí nghiệm với chu kỳ của tập nghiệm.", "discrimination": "low", "typical_steps": 3, "refs": ["3b4cca11ea82|P1|10|None", "de5833d227dd|P1|6|None"]}, {"part_kind": "true_false", "topic": "Khôi phục hàm từ biểu thức đạo hàm hoặc hàm dưới dấu nguyên hàm", "grade": 12, "construction": "Cho biểu thức cần lấy nguyên hàm và một công thức ứng viên. Tính nguyên hàm từng thành phần, xử lý hằng số theo dữ kiện hiện có rồi đối chiếu; có thể lấy đạo hàm công thức ứng viên để kiểm tra.", "wrong_options": "Có bằng chứng về lỗi tăng bậc nhưng không điều chỉnh hệ số và tự ấn định hằng số khi thiếu điều kiện đầu. Với các nhận định chưa có khóa xác nhận, chỉ xác định nội dung được kiểm tra, không gán đúng sai.", "difficulty_source": "Áp dụng đúng quy tắc nguyên hàm và phân biệt hằng số tùy ý với giá trị hàm tại một điểm.", "discrimination": "low", "typical_steps": 3, "refs": ["acc00d945397|P2|1|a", "acc00d945397|P2|1|b", "3b4cca11ea82|P2|3|a"]}, {"part_kind": "true_false", "topic": "Thể tích khối tròn xoay bằng tích phân thiết diện", "grade": 12, "construction": "Cho miền phẳng và nhận định về thể tích khi quay. Xác định bán kính thiết diện theo đường biên, dùng diện tích đĩa hoặc hiệu diện tích các đĩa khi có phần khuyết, tích phân trên miền thích hợp rồi làm tròn để đối chiếu.", "wrong_options": "Nội dung kiểm tra gồm bình phương bán kính, hệ số diện tích và phần thể tích bị loại. Không đủ bằng chứng để gán một giá trị sai cụ thể cho từng cơ chế; có nhận định được xác nhận đúng.", "difficulty_source": "Chuyển đúng miền phẳng sang thiết diện của vật thể trước khi tính toán.", "discrimination": "medium", "typical_steps": 4, "refs": ["acc00d945397|P2|1|d", "de5833d227dd|P2|1|d"]}, {"part_kind": "true_false", "topic": "Tìm tọa độ điểm từ quan hệ vectơ", "grade": 12, "construction": "Cho các điểm đã biết và quan hệ vectơ xác định điểm cần xét. Viết điểm đó dưới dạng điểm xuất phát cộng vectơ dịch chuyển hoặc một phần vectơ nối các điểm, tính tọa độ hay thành phần được hỏi rồi đối chiếu.", "wrong_options": "Nội dung kiểm tra gồm hướng dịch chuyển, điểm xuất phát và hệ số chia đoạn. Không có bằng chứng xác nhận một nhận định sai cụ thể cho cấu trúc này.", "difficulty_source": "Dịch đúng quan hệ hình học thành phép toán tọa độ và chỉ tính thành phần cần thiết khi có thể.", "discrimination": "low", "typical_steps": 3, "refs": ["acc00d945397|P2|3|b", "3b4cca11ea82|P2|4|b"]}, {"part_kind": "short_answer", "topic": "Đếm cấu hình thỏa điều kiện chia hết bằng lớp dư", "grade": 10, "construction": "Cho tập phần tử và các vị trí phân biệt, kèm điều kiện chia hết của biểu thức tổng. Phân loại phần tử theo phần dư thích hợp, tìm các kiểu phối hợp hợp lệ, đếm theo kích thước từng nhóm rồi xử lý thứ tự và điều kiện lặp. Từ kết quả đếm, tính đại lượng cuối theo yêu cầu.", "wrong_options": null, "difficulty_source": "Chọn đúng đối tượng lấy phần dư, giữ trọng số của từng nhóm và phân biệt chọn phần tử với gán vào vị trí.", "discrimination": "medium", "typical_steps": 5, "refs": ["acc00d945397|P3|6|None", "3b4cca11ea82|P3|6|None"]}], "discrimination_moves": [{"move": "Tối ưu tiếp trên toàn bộ tập phương án tối ưu", "how_to_apply": "Sau mục tiêu chính, thêm điều kiện và yêu cầu phụ buộc người giải xác định toàn bộ tập đạt cực trị trước khi chọn phương án. Bằng chứng hiện có là quan sát riêng.", "refs": ["acc00d945397|P2|4|c"]}, {"move": "Buộc người giải tự chọn biểu diễn làm lộ quan hệ vuông góc", "how_to_apply": "Cho dữ kiện hình học đủ xác định nhưng chưa chỉ sẵn đường vuông góc cần dùng; yêu cầu lựa chọn mặt cắt hoặc hệ tọa độ thuận lợi để tính khoảng cách. Bằng chứng hiện có là quan sát riêng.", "refs": ["3b4cca11ea82|P3|2|None"]}, {"move": "Để vị trí chuyển tiếp trở thành biến quyết định", "how_to_apply": "Cho các miền có quy luật chi phí khác nhau và cho phép lựa chọn điểm chuyển miền. Người giải phải lập hàm mục tiêu từ từng chặng và tìm cách rút gọn biến. Bằng chứng hiện có là quan sát riêng.", "refs": ["3b4cca11ea82|P3|3|None"]}, {"move": "Yêu cầu chứng minh nghiệm tối ưu khả thi", "how_to_apply": "Thiết kế bài sao cho nghiệm từ đạo hàm chưa đủ kết luận; cần kiểm tra miền biến, phương án biên và phương án cạnh tranh trực tiếp. Bằng chứng hiện có là quan sát riêng.", "refs": ["3b4cca11ea82|P3|3|None"]}, {"move": "Ẩn giới hạn tích phân trong hình học của phần còn lại", "how_to_apply": "Cho vật thể bị loại một phần để người giải phải suy ra khoảng tồn tại của thiết diện và diện tích còn lại trước khi tích phân. Bằng chứng hiện có là quan sát riêng.", "refs": ["3b4cca11ea82|P3|5|None"]}], "easy_vs_hard": [{"topic": "Tối ưu tuyến tính", "easy": "Đọc ý nghĩa biến và ghép hệ số để viết hàm mục tiêu.", "hard": "Xác định toàn bộ tập đạt mục tiêu chính, thêm ràng buộc rồi tối ưu một đại lượng khác trên tập đó.", "difficulty_change": "Chuyển từ lập biểu thức sang suy luận về tập phương án tối ưu.", "easy_refs": ["acc00d945397|P2|4|a", "acc00d945397|P2|4|b"], "hard_refs": ["acc00d945397|P2|4|c"]}, {"topic": "Ứng dụng tích phân tính thể tích", "easy": "Nhận dạng bán kính và chọn biểu thức tích phân của khối tròn xoay.", "hard": "Tự dựng thiết diện của vật thể có phần bị loại và suy ra giới hạn tồn tại của thiết diện.", "difficulty_change": "Phần phân hóa nằm ở mô hình hình học và cận tích phân.", "easy_refs": ["de5833d227dd|P1|8|None"], "hard_refs": ["3b4cca11ea82|P3|5|None"]}, {"topic": "Đạo hàm và tối ưu", "easy": "Tính đạo hàm của hàm đã cho và kiểm tra cực trị bằng dấu đạo hàm.", "hard": "Tự chọn biến, lập thời gian theo các chặng, rút gọn mô hình và so sánh nghiệm trong miền với các phương án biên.", "difficulty_change": "Chuyển từ thao tác trên hàm có sẵn sang xây dựng và kiểm chứng mô hình tối ưu.", "easy_refs": ["3b4cca11ea82|P2|1|a", "3b4cca11ea82|P2|1|c"], "hard_refs": ["3b4cca11ea82|P3|3|None"]}, {"topic": "Khoảng cách trong không gian", "easy": "Đọc tọa độ rồi áp dụng công thức khoảng cách giữa các điểm.", "hard": "Tìm khoảng cách đến mặt phẳng khi đường vuông góc chưa hiện rõ, phải dựng mặt cắt hoặc chọn hệ tọa độ.", "difficulty_change": "Chuyển từ thế tọa độ sang lựa chọn biểu diễn hình học.", "easy_refs": ["3b4cca11ea82|P2|4|a"], "hard_refs": ["3b4cca11ea82|P3|2|None"]}, {"topic": "Tích phân của đại lượng biên", "easy": "Tính độ thay đổi trên khoảng có các cận đã biết.", "hard": "Để cận trên chưa biết, chuyển yêu cầu vượt ngưỡng thành bất phương trình và xét điều kiện biên cùng miền của biến.", "difficulty_change": "Thêm quyết định về dấu nghiêm ngặt và ý nghĩa rời rạc hoặc liên tục; dữ liệu còn ghi nhận sự chưa rõ của miền biến.", "easy_refs": ["3b4cca11ea82|P2|3|c"], "hard_refs": ["3b4cca11ea82|P2|3|d"]}], "fact_use": {"common": [{"use": "Công thức và định nghĩa toán học được huy động trực tiếp; lỗi nhớ sai được chuyển thành nhiễu về dấu, phép toán, chu kỳ hoặc hệ số.", "refs": ["3b4cca11ea82|P1|6|None", "de5833d227dd|P1|7|None", "3b4cca11ea82|P1|10|None", "de5833d227dd|P1|6|None", "3b4cca11ea82|P1|12|None"]}, {"use": "Giá trị định lượng trong đề đóng vai trò đầu vào của phép tính hoặc ràng buộc. Người giải phải giữ đúng ý nghĩa, đơn vị và vị trí của chúng trong mô hình.", "refs": ["acc00d945397|P2|2|d", "acc00d945397|P3|1|None", "3b4cca11ea82|P2|4|a", "3b4cca11ea82|P3|4|None"]}, {"use": "Có hàng cung cấp sẵn công thức hoặc tỉ lệ cần dùng; khi đó yêu cầu nằm ở đọc đúng dữ kiện, xác định khoảng thời gian hoặc nhận diện điều kiện.", "refs": ["acc00d945397|P3|4|None", "3b4cca11ea82|P2|2|b"]}, {"use": "Kiến thức nền về chia hết và phần dư được dùng như công cụ tổ chức phép đếm.", "refs": ["acc00d945397|P3|6|None", "3b4cca11ea82|P3|6|None"]}], "not_observed": [{"use": "Không thấy yêu cầu nhớ mốc lịch sử, tên riêng hoặc dữ kiện thời sự để có thể giải bài. Các mốc thời gian xuất hiện trong mô hình được cung cấp làm dữ kiện.", "refs": ["acc00d945397|P3|4|None", "acc00d945397|P3|5|None"]}, {"use": "Không thấy yêu cầu tự tra đơn giá, vận tốc hoặc định mức ngoài đề trong các bài mô hình được dẫn. Những đại lượng cần thiết được đưa vào dữ kiện.", "refs": ["acc00d945397|P2|2|b", "acc00d945397|P3|3|None", "3b4cca11ea82|P3|3|None", "3b4cca11ea82|P3|4|None"]}], "limit": "Không quan sát thấy trong các hàng không đủ để kết luận một dạng yêu cầu không bao giờ xuất hiện ở các đề khác."}, "anti_patterns": [{"avoid": "Tăng độ khó chỉ bằng cách kéo dài tính toán.", "basis": "Các hàng phân hóa cao được dẫn đặt nút khó ở lựa chọn mô hình, biểu diễn hình học, tập nghiệm tối ưu hoặc giới hạn thiết diện.", "refs": ["acc00d945397|P2|4|c", "3b4cca11ea82|P3|2|None", "3b4cca11ea82|P3|3|None", "3b4cca11ea82|P3|5|None"]}, {"avoid": "Dùng hình thức phương trình hoặc một dấu hiệu cục bộ thay cho đúng đối tượng cần xét.", "basis": "Các nhiễu có thể khai thác việc nhầm đường đứng với đường ngang, nhầm họ đồ thị hoặc trộn tọa độ điểm với vectơ.", "refs": ["3b4cca11ea82|P1|7|None", "de5833d227dd|P1|5|None", "de5833d227dd|P1|10|None"]}, {"avoid": "Kết thúc bài tối ưu ngay khi tìm được nghiệm đại số.", "basis": "Những hàng được dẫn còn yêu cầu xét tính khả thi, toàn bộ tập đạt cực trị, phương án biên hoặc điều kiện của biến đếm.", "refs": ["acc00d945397|P2|4|c", "acc00d945397|P2|4|d", "3b4cca11ea82|P3|3|None", "3b4cca11ea82|P3|4|None"]}, {"avoid": "Tách dữ kiện thực tế khỏi chuỗi suy luận để chỉ tạo phần dẫn trang trí.", "basis": "Trong các hàng được dẫn, đơn giá, miền chuyển động, đơn vị và quan hệ kích thước tham gia trực tiếp vào mô hình hoặc kết quả.", "refs": ["acc00d945397|P2|2|d", "acc00d945397|P3|1|None", "3b4cca11ea82|P2|4|d", "3b4cca11ea82|P3|3|None"]}, {"avoid": "Gán chắc chắn một lỗi tư duy cho mọi phương án nhiễu.", "basis": "Dữ liệu có những giá trị sai không truy được về một thao tác duy nhất và những nhận định chưa có khóa xác nhận. Không thể dùng chúng làm bằng chứng cho cơ chế nhiễu cụ thể.", "refs": ["acc00d945397|P2|1|d", "3b4cca11ea82|P2|2|c", "3b4cca11ea82|P2|4|d", "de5833d227dd|P1|2|None"]}]}]
