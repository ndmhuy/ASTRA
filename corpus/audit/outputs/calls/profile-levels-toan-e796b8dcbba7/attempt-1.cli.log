 đỉnh và trên cạnh; hình vẽ thể hiện các bộ vị trí liên quan.", "task": "Tính nghịch đảo xác suất để các bộ vị trí đều thỏa mãn điều kiện cấp số cộng.", "reasoning": ["Mô hình hóa không gian mẫu bằng các phép gán không lặp vào vị trí có nhãn.", "Dùng tính chất trung bình cộng để biểu diễn giá trị tại mỗi vị trí trên cạnh theo hai đỉnh.", "Suy ra điều kiện chẵn lẻ và điều kiện thuộc tập cho các giá trị đỉnh.", "Loại các cấu hình làm trùng giá trị giữa những vị trí khác nhau.", "Đếm các cấu hình hợp lệ có xét thứ tự vị trí.", "Lập xác suất rồi lấy nghịch đảo."], "combines": ["Cấp số cộng", "Chỉnh hợp", "Tính chẵn lẻ", "Xác suất cổ điển"], "cue_use": "needed in reasoning", "evidence_uncertainty": "Chủ đề chính đặt ở lớp học cấp số cộng; công cụ đếm và xác suất cổ điển thuộc lớp trước."}, {"ref": "163f20908cf7|P3|2|None", "part": "P3", "idx": 2, "sub": null, "topic": "Ứng dụng bất phương trình bậc hai trong bài toán lợi nhuận", "grade": 10, "given": "Doanh thu theo sản lượng, chi phí bình quân mỗi đơn vị, miền sản lượng nguyên bị chặn và một ngưỡng lợi nhuận.", "task": "Tìm sản lượng nguyên nhỏ nhất để lợi nhuận vượt ngưỡng.", "reasoning": ["Nhân chi phí bình quân với sản lượng để có tổng chi phí.", "Lấy doanh thu trừ tổng chi phí và thống nhất đơn vị tiền.", "Lập rồi giải bất phương trình lợi nhuận vượt ngưỡng.", "Giao miền nghiệm với điều kiện sản lượng và chọn số nguyên nhỏ nhất thỏa bất đẳng thức nghiêm."], "combines": ["Mô hình doanh thu và chi phí", "Dấu tam thức bậc hai", "Bất phương trình", "Điều kiện số nguyên"], "cue_use": "needed in reasoning", "evidence_uncertainty": null}, {"ref": "163f20908cf7|P3|3|None", "part": "P3", "idx": 3, "sub": null, "topic": "Ứng dụng hệ bất phương trình bậc nhất hai ẩn trong tối ưu", "grade": 10, "given": "Các gói bán hàng tiêu hao những nguồn lực chung theo mức khác nhau, giá bán từng gói và giới hạn nguồn lực.", "task": "Tìm doanh thu lớn nhất trong miền phương án khả thi.", "reasoning": ["Đặt biến đếm số gói từng loại và điều kiện không âm, nguyên.", "Lập các bất phương trình giới hạn nguồn lực.", "Biểu diễn doanh thu bằng hàm mục tiêu tuyến tính.", "Xác định các đỉnh miền nghiệm và so sánh giá trị mục tiêu.", "Kiểm tra phương án tối ưu đáp ứng điều kiện nguyên."], "combines": ["Hệ bất phương trình bậc nhất hai ẩn", "Miền nghiệm hình học", "Tối ưu tuyến tính", "Mô hình doanh thu"], "cue_use": "needed in reasoning", "evidence_uncertainty": null}, {"ref": "163f20908cf7|P3|4|None", "part": "P3", "idx": 4, "sub": null, "topic": "Khoảng cách giữa hai đường thẳng chéo nhau", "grade": 11, "given": "Một hình chóp có đáy hình thoi, dữ kiện cạnh và góc đáy, chân đường cao là trọng tâm một tam giác trong đáy và độ dài đường cao.", "task": "Tính khoảng cách giữa một đường chéo đáy và một cạnh bên rồi làm tròn theo yêu cầu.", "reasoning": ["Khai thác hình thoi và góc đáy để xác định các quan hệ độ dài, vuông góc trong đáy.", "Chọn hệ tọa độ hoặc mặt phẳng phụ thuận lợi cho hai đường cần xét.", "Xác định vị trí đỉnh từ chân đường cao và tính chất trọng tâm.", "Tính khoảng cách bằng công thức tọa độ hoặc phép dựng đoạn vuông góc chung tương đương.", "Kiểm tra các độ dài trung gian và làm tròn kết quả cuối."], "combines": ["Hình thoi", "Trọng tâm tam giác", "Quan hệ vuông góc", "Khoảng cách trong không gian"], "cue_use": "needed in reasoning", "evidence_uncertainty": "Xếp lớp theo bài khoảng cách trong hình học không gian; lời giải dùng công thức tọa độ có thể huy động thêm kiến thức lớp sau."}, {"ref": "163f20908cf7|P3|5|None", "part": "P3", "idx": 5, "sub": null, "topic": "Quy tắc đếm: hoán vị kết hợp chia thành các nhóm có thứ tự", "grade": 10, "given": "Các vật phân biệt được xếp vào những ngăn phân biệt, mỗi ngăn không rỗng và thứ tự trong từng ngăn được tính.", "task": "Đếm các cách xếp khác nhau rồi thực hiện phép quy đổi kết quả được yêu cầu.", "reasoning": ["Mã hóa mỗi cách xếp thành một dãy các vật kèm những điểm ngăn cách.", "Đếm các hoán vị của toàn bộ vật.", "Chọn các khe bên trong dãy để đặt vách ngăn, bảo đảm mọi ngăn không rỗng.", "Nhân hai số đếm theo sự tương ứng duy nhất.", "Thực hiện phép quy đổi kết quả."], "combines": ["Hoán vị", "Tổ hợp", "Quy tắc nhân", "Mô hình vách ngăn"], "cue_use": "needed in reasoning", "evidence_uncertainty": null}, {"ref": "163f20908cf7|P3|6|None", "part": "P3", "idx": 6, "sub": null, "topic": "Ứng dụng tích phân tính thể tích phần khối cầu và thể tích vật thể ghép", "grade": 12, "given": "Một khối chóp cụt đều đáy vuông bị khoét phần chỏm cầu; hình vẽ thể hiện phần chỏm nhỏ, với kích thước khối ban đầu, bán kính cầu và bán kính đường tròn mặt cắt.", "task": "Tính thể tích vật thể còn lại và làm tròn theo yêu cầu trên ảnh gốc.", "reasoning": ["Tính thể tích khối chóp cụt từ diện tích các đáy và chiều cao.", "Dùng quan hệ vuông góc giữa bán kính mặt cắt, khoảng cách đến tâm và bán kính cầu.", "Dựa vào hình để chọn chỏm nhỏ và xác định miền tích phân.", "Lập diện tích thiết diện của cầu rồi tích phân để tính thể tích phần khoét.", "Lấy thể tích ban đầu trừ thể tích phần khoét.", "Giữ độ chính xác trung gian và làm tròn ở bước cuối."], "combines": ["Thể tích khối chóp cụt", "Hình học mặt cầu", "Định lý Pythagore", "Ứng dụng tích phân", "Phép trừ thể tích"], "cue_use": "needed in reasoning", "evidence_uncertainty": "Bản OCR ghi mức làm tròn khác ảnh gốc; ảnh gốc yêu cầu đến hàng phần mười và khóa cũng dùng mức đó. Hình gốc đủ rõ để nhận diện chỏm cầu nhỏ."}, {"ref": "023e74626dd8|P1|1|None", "part": "P1", "idx": 1, "sub": null, "topic": "Vectơ trong không gian: hai vectơ bằng nhau", "grade": 12, "given": "Một hình lập phương có hình vẽ và một vectơ nằm trên cạnh.", "task": "Chọn vectơ bằng vectơ đã cho.", "reasoning": ["Xác định hướng của vectơ đã cho trên hình.", "Tìm cạnh có cùng độ dài và cùng hướng.", "Đối chiếu với các lựa chọn."], "combines": ["Vectơ trong không gian", "Hình lập phương"], "cue_use": "none", "evidence_uncertainty": null}, {"ref": "023e74626dd8|P1|2|None", "part": "P1", "idx": 2, "sub": null, "topic": "Các quy tắc tính đạo hàm: đạo hàm của tổng", "grade": 11, "given": "Các biểu thức đạo hàm của những hàm số khả vi.", "task": "Xác định đạo hàm của tổng các hàm số.", "reasoning": ["Áp dụng quy tắc đạo hàm của tổng.", "Cộng các biểu thức đạo hàm đã biết."], "combines": ["Quy tắc đạo hàm của tổng"], "cue_use": "needed in reasoning", "evidence_uncertainty": null}, {"ref": "023e74626dd8|P1|3|None", "part": "P1", "idx": 3, "sub": null, "topic": "Biểu thức tọa độ của vectơ nối hai điểm trong không gian", "grade": 12, "given": "Tọa độ của các điểm đầu và cuối của một vectơ trong không gian.", "task": "Chọn tọa độ của vectơ nối các điểm theo thứ tự đã chỉ định.", "reasoning": ["Lấy tọa độ điểm cuối trừ tọa độ điểm đầu theo từng thành phần.", "Đối chiếu bộ tọa độ thu được với các lựa chọn."], "combines": ["Tọa độ điểm", "Tọa độ vectơ"], "cue_use": "needed in reasoning", "evidence_uncertainty": null}, {"ref": "023e74626dd8|P1|4|None", "part": "P1", "idx": 4, "sub": null, "topic": "Nguyên hàm: tính tuyến tính", "grade": 12, "given": "Một họ nguyên hàm đã biết và một biểu thức cộng thêm hằng số vào hàm dưới dấu nguyên hàm.", "task": "Chọn họ nguyên hàm của biểu thức mới.", "reasoning": ["Tách nguyên hàm của tổng thành tổng các nguyên hàm.", "Tính nguyên hàm của hằng số và sử dụng họ nguyên hàm đã cho."], "combines": ["Tính tuyến tính của nguyên hàm", "Nguyên hàm của hằng số"], "cue_use": "needed in reasoning", "evidence_uncertainty": null}, {"ref": "023e74626dd8|P1|5|None", "part": "P1", "idx": 5, "sub": null, "topic": "Cấp số nhân: số hạng tổng quát", "grade": 11, "given": "Số hạng đầu, công bội và điều kiện của một cấp số nhân.", "task": "Biểu diễn một số hạng được chỉ định theo dữ kiện ban đầu.", "reasoning": ["Xác định số lần nhân công bội từ số hạng đầu tới số hạng cần tìm.", "Áp dụng công thức số hạng tổng quát."], "combines": ["Cấp số nhân"], "cue_use": "needed in reasoning", "evidence_uncertainty": null}, {"ref": "023e74626dd8|P1|6|None", "part": "P1", "idx": 6, "sub": null, "topic": "Phương trình lôgarit cơ bản", "grade": 11, "given": "Một phương trình lôgarit có đối số là biểu thức bậc nhất.", "task": "Chọn nghiệm của phương trình.", "reasoning": ["Xác định điều kiện dương của đối số.", "Đổi phương trình lôgarit sang dạng lũy thừa.", "Giải phương trình bậc nhất và kiểm tra điều kiện."], "combines": ["Định nghĩa lôgarit", "Phương trình bậc nhất"], "cue_use": "needed in reasoning", "evidence_uncertainty": null}]}
