discrimination": "high", "typical_steps": 3, "refs": ["53f7e0c73214|P1|18|None", "30e3a77f6f23|P1|8|None", "30e3a77f6f23|P1|16|None"], "evidence_note": "Biến thể kiểm tra đồng thời tiêu chí điện hóa và sự tương thích môi trường được dữ liệu đánh giá phân hóa cao; các biến thể còn lại được đánh giá trung bình."}, {"part_kind": "true_false", "topic": "Đối chiếu cấu tạo với tín hiệu phổ", "grade": 11, "construction": "Cho cấu tạo và thông tin phổ hoặc dự đoán tín hiệu; yêu cầu đánh giá phép gán. Xác định liên kết thực có, liên hệ vùng hấp thụ, rồi kiểm tra riêng đối tượng đang được phát biểu.", "wrong_options": "Gán tín hiệu cho nhóm chức khác đang cùng hiện diện hoặc gộp tín hiệu của các chất rồi gán lại cho từng chất.", "difficulty_source": "Chuyển đúng giữa biểu diễn cấu tạo và dữ liệu phổ; biến thể khó hơn bỏ bớt hỗ trợ tra cứu.", "discrimination": "medium", "typical_steps": 3, "refs": ["53f7e0c73214|P2|1|a", "30e3a77f6f23|P2|3|b"]}, {"part_kind": "true_false", "topic": "Dụng cụ và thao tác chuẩn độ", "grade": [11, 12], "construction": "Cho hình hoặc quy trình chuẩn độ; yêu cầu đánh giá dụng cụ hay thao tác có phù hợp chức năng hay không. Nhận diện vai trò của dụng cụ, xác định yêu cầu định lượng rồi đối chiếu cách sử dụng.", "wrong_options": "Có phát biểu thay dụng cụ cấp dung dịch định lượng bằng dụng cụ chứa; các hàng còn lại không mô tả phát biểu sai riêng.", "difficulty_source": "Hiểu chức năng và yêu cầu giữ đúng nồng độ thay vì chỉ nhớ hình dạng hoặc thao tác rời rạc.", "discrimination": "low", "typical_steps": 3, "refs": ["53f7e0c73214|P2|2|a", "30e3a77f6f23|P2|1|c"]}, {"part_kind": "true_false", "topic": "Kiểm tra kết quả định lượng từ quy trình phản ứng", "grade": [11, 12], "construction": "Cho quy trình, lượng chất và kết quả định lượng được đề xuất; yêu cầu kiểm tra kết quả. Đổi dữ kiện về lượng chất, áp dụng tỉ lượng, xử lí phần dư hoặc hiệu suất khi có, rồi quy về đại lượng và cơ sở mẫu được hỏi.", "wrong_options": "Hàng có phát biểu sai khai thác việc dùng kết quả của phần mẫu phân tích cho toàn bộ mẫu; các hàng khác không cung cấp cơ chế sai cụ thể.", "difficulty_source": "Theo dõi lượng chất qua công đoạn và giữ đúng cơ sở quy đổi.", "discrimination": "medium", "typical_steps": 4, "refs": ["53f7e0c73214|P2|1|c", "53f7e0c73214|P2|2|c", "30e3a77f6f23|P2|1|a"]}, {"part_kind": "true_false", "topic": "Đánh giá giả thuyết bằng dữ liệu phân tích", "grade": [11, 12], "construction": "Cho giả thuyết và dữ liệu thực nghiệm; yêu cầu đánh giá dữ liệu có phù hợp giả thuyết hay không. Kiểm tra điều kiện so sánh, chuyển số đo thành đại lượng có ý nghĩa, chuẩn hóa cơ sở nếu cần rồi đối chiếu chiều biến đổi.", "wrong_options": null, "difficulty_source": "Nhận ra khi nào số đo được so sánh trực tiếp và khi nào cần quy đổi.", "discrimination": "medium", "typical_steps": 4, "refs": ["53f7e0c73214|P2|2|b", "30e3a77f6f23|P2|1|d"]}, {"part_kind": "true_false", "topic": "Nhận diện bản chất hóa học của công đoạn trong sơ đồ", "grade": [11, 12], "construction": "Cho sơ đồ hoặc quy trình chuyển hóa; yêu cầu đánh giá vai trò hay kiểu biến đổi tại công đoạn được chỉ định. Khoanh đúng công đoạn, xác định chất trước và sau, rồi áp dụng định nghĩa tương ứng.", "wrong_options": "Có phát biểu chuyển phản ứng của công đoạn sau sang công đoạn trước; các hàng khác không mô tả phát biểu sai riêng.", "difficulty_source": "Đọc đúng phạm vi công đoạn và dùng biến đổi thực tế làm căn cứ phân loại.", "discrimination": "low", "typical_steps": 3, "refs": ["53f7e0c73214|P2|1|b", "53f7e0c73214|P2|1|d", "30e3a77f6f23|P2|1|b", "30e3a77f6f23|P2|2|a"], "evidence_note": "Hàng phản ứng xử lí mẫu chưa được gán chắc lớp học."}, {"part_kind": "true_false", "topic": "Chiều trao đổi electron và vai trò của các tiểu phân", "grade": [11, 12], "construction": "Cho biến đổi hóa học hoặc mô tả tạo liên kết; yêu cầu đánh giá vai trò cho và nhận electron. Xác định bản chất trao đổi electron, nhận diện bên cho và bên nhận rồi đối chiếu phát biểu.", "wrong_options": "Đảo vai trò của các bên; cần phân biệt trao đổi electron trong phản ứng oxi hóa khử với sự cho nhận cặp electron khi tạo liên kết.", "difficulty_source": "Không đồng nhất tên quá trình biến đổi của chất với vai trò của chất trong quá trình.", "discrimination": "low", "typical_steps": 3, "refs": ["53f7e0c73214|P2|1|d", "53f7e0c73214|P2|4|b", "30e3a77f6f23|P2|2|c"]}, {"part_kind": "true_false", "topic": "Kiểm tra suy luận từ đặc điểm cấu tạo chung", "grade": 12, "construction": "Cho các chất có chung một đặc điểm cấu tạo và kết luận rằng chúng thuộc cùng lớp hoặc có cùng thuộc tính. Xác định điều mà đặc điểm chung thực sự bảo đảm, tìm điều kiện còn thiếu rồi đánh giá kết luận.", "wrong_options": "Coi nhóm liên kết chung là đủ để phân loại; ngầm đồng nhất độ dài mạch hoặc kiến trúc mạch từ thành phần và loại liên kết.", "difficulty_source": "Phát hiện biến số chưa được cố định và phân biệt điều kiện cần với điều kiện đủ.", "discrimination": "medium", "typical_steps": 3, "refs": ["53f7e0c73214|P2|3|b", "30e3a77f6f23|P2|4|c", "30e3a77f6f23|P2|4|d"]}, {"part_kind": "true_false", "topic": "Giải thích tính chất bằng cấu tạo và phản ứng", "grade": 12, "construction": "Cho cấu tạo hoặc quá trình hóa học cùng nhận định về tính chất hay công dụng; yêu cầu kiểm tra quan hệ giải thích. Xác định bộ phận có tác dụng, suy ra tương tác hoặc phản ứng, rồi nối với tính chất được nêu.", "wrong_options": "Đảo quan hệ cấu tạo và độ bền, nhầm sản phẩm gây biến đổi môi trường hoặc dùng loại độ bền khác để thay cho độ bền hóa học.", "difficulty_source": "Lập được chuỗi nguyên nhân từ cấu tạo hoặc phản ứng đến biểu hiện vĩ mô.", "discrimination": "medium", "typical_steps": 3, "refs": ["53f7e0c73214|P2|3|a", "53f7e0c73214|P2|4|c", "53f7e0c73214|P2|4|d", "30e3a77f6f23|P2|3|d"]}, {"part_kind": "true_false", "topic": "Nhận diện chiều biến đổi cấu tạo polymer", "grade": 12, "construction": "Cho cấu tạo trước và sau phản ứng; yêu cầu đánh giá nhận định về cách hình thành hoặc biến đổi mạch. So sánh liên kết và dạng mạch, xác định chiều thay đổi rồi đối chiếu tên quá trình.", "wrong_options": "Có phát biểu đảo chiều cắt mạch thành tăng mạch; hàng còn lại không mô tả phát biểu sai riêng.", "difficulty_source": "Đọc biến đổi liên kết trực tiếp trên hình hoặc phương trình.", "discrimination": "low", "typical_steps": 2, "refs": ["53f7e0c73214|P2|3|c", "30e3a77f6f23|P2|4|b"]}, {"part_kind": "true_false", "topic": "Phân loại polymer theo nguồn gốc", "grade": 12, "construction": "Cho thông tin nguồn hình thành hoặc phương pháp chế tạo; yêu cầu đánh giá nhóm nguồn gốc của vật liệu. Xác định vật liệu hình thành trong tự nhiên, được tổng hợp từ chất nhỏ hay được cải biến từ polymer có sẵn rồi đối chiếu phân loại.", "wrong_options": "Đánh đồng các vật liệu do con người chế tạo mà bỏ qua nguồn nguyên liệu và cách tạo polymer.", "difficulty_source": "Nhớ đúng tiêu chí nguồn gốc và áp dụng vào thông tin chế tạo.", "discrimination": "low", "typical_steps": 2, "refs": ["53f7e0c73214|P2|3|d", "30e3a77f6f23|P2|4|a"]}], "discrimination_moves": [{"move": "Kiểm tra thêm tính tương thích với môi trường sau tiêu chí lựa chọn ban đầu", "how_to_apply": "Cho một đặc tính khiến giải pháp có vẻ phù hợp, đồng thời cung cấp môi trường sử dụng làm phát sinh phản ứng cần xét. Kết luận chỉ được chấp nhận sau khi kiểm tra cả tác dụng mong muốn và phản ứng với môi trường.", "refs": ["53f7e0c73214|P1|18|None"]}, {"move": "Đặt điều kiện cần cạnh một kết luận quá mạnh", "how_to_apply": "Dùng đặc điểm đúng nhưng chưa đủ làm tiền đề của phương án; yêu cầu người làm phát hiện điều kiện còn thiếu trước khi chấp nhận kết luận.", "refs": ["53f7e0c73214|P1|18|None", "53f7e0c73214|P2|3|b", "30e3a77f6f23|P2|4|c"]}, {"move": "Buộc chọn đúng tiêu chí quyết định", "how_to_apply": "Đặt giải thích dựa trên cơ chế hóa học cạnh giải thích dựa trên đặc tính bề ngoài hoặc thuộc tính không quyết định. Đáp án phải nối được đặc tính với mục tiêu sử dụng.", "refs": ["53f7e0c73214|P1|18|None", "30e3a77f6f23|P1|8|None", "30e3a77f6f23|P1|16|None"]}, {"move": "Ẩn yêu cầu chuẩn hóa trong phép so sánh", "how_to_apply": "Cho số đo ở các cơ sở mẫu hoặc đơn vị biểu diễn khác nhau; yêu cầu chuyển về cùng cơ sở trước khi so sánh hay đánh giá giả thuyết.", "refs": ["30e3a77f6f23|P2|1|a", "30e3a77f6f23|P2|1|d", "53f7e0c73214|P3|5|None"]}, {"move": "Thay dữ kiện tổng bằng phần thực sự quyết định kết quả", "how_to_apply": "Cho lượng ban đầu nhưng yêu cầu đại lượng sau phản ứng. Người làm phải trừ phần đã tiêu thụ, xác định phần còn lại và cập nhật cơ sở tính thay vì dùng nguyên dữ kiện đầu.", "refs": ["53f7e0c73214|P3|4|None", "53f7e0c73214|P3|6|None", "30e3a77f6f23|P2|1|a"]}], "discrimination_moves_note": "Các động tác liên quan điều kiện môi trường và tính đủ được quan sát trong hàng có đánh giá phân hóa cao. Các động tác chuẩn hóa và cập nhật lượng chất được hỗ trợ bởi hàng phân hóa trung bình; chưa có bằng chứng để gọi riêng chúng là động tác phân hóa cao lặp lại giữa các đề.", "easy_vs_hard": [{"topic": "Phức chất", "easy": "Đọc chỉ số hoặc áp dụng quy tắc đếm được cung cấp để xác định số đối tượng quanh trung tâm.", "hard": "Tách thuộc tính của từng phối tử khỏi tổng thuộc tính của toàn phức trước khi đếm.", "difference": "Độ khó tăng do thay đổi phạm vi của đại lượng cần xác định.", "easy_refs": ["53f7e0c73214|P1|1|None", "30e3a77f6f23|P2|2|d"], "hard_refs": ["53f7e0c73214|P1|15|None"]}, {"topic": "Điện hóa và bảo vệ kim loại", "easy": "Xác định chiều cho nhận electron hoặc áp dụng quan hệ giữa các thế điện cực.", "hard": "Đánh giá vật liệu bảo vệ bằng cả tiêu chí điện hóa và phản ứng trong môi trường sử dụng.", "difference": "Từ áp dụng quy tắc riêng lẻ chuyển sang kiểm tra tính đủ của giải pháp.", "easy_refs": ["53f7e0c73214|P1|2|None", "30e3a77f6f23|P1|2|None", "30e3a77f6f23|P3|2|None"], "hard_refs": ["53f7e0c73214|P1|18|None"]}, {"topic": "Phổ hồng ngoại", "easy": "Đối chiếu tín hiệu với bảng vùng hấp thụ đã cho.", "hard": "Từ cấu tạo suy ra tập tín hiệu rồi kiểm tra từng chất riêng biệt.", "difference": "Giảm hỗ trợ tra cứu và tăng yêu cầu chuyển đổi biểu diễn.", "easy_refs": ["53f7e0c73214|P2|1|a"], "hard_refs": ["30e3a77f6f23|P2|3|b"]}, {"topic": "Chuẩn độ và dữ liệu thực nghiệm", "easy": "Nhận diện dụng cụ hoặc chọn thao tác giữ đúng nồng độ dung dịch.", "hard": "Tính lượng đã phản ứng qua phép chuẩn độ ngược, quy đổi mẫu rồi so sánh với giả thuyết.", "difference": "Từ kiến thức thao tác chuyển sang chuỗi định lượng có thay đổi cơ sở mẫu.", "easy_refs": ["53f7e0c73214|P2|2|a", "30e3a77f6f23|P2|1|c"], "hard_refs": ["30e3a77f6f23|P2|1|a", "30e3a77f6f23|P2|1|d"]}, {"topic": "Polymer", "easy": "Nhận diện nguồn gốc hoặc chiều biến đổi mạch được thể hiện trực tiếp.", "hard": "Kiểm tra liệu đặc điểm chung có đủ bảo đảm cùng phân loại, phân tử khối hay kiến trúc mạch.", "difference": "Từ nhận dạng dấu hiệu chuyển sang phát hiện điều kiện chưa được dữ kiện bảo đảm.", "easy_refs": ["53f7e0c73214|P2|3|c", "53f7e0c73214|P2|3|d", "30e3a77f6f23|P2|4|a", "30e3a77f6f23|P2|4|b"], "hard_refs": ["53f7e0c73214|P2|3|b", "30e3a77f6f23|P2|4|c", "30e3a77f6f23|P2|4|d"]}], "fact_use": {"common": [{"use": "Hỏi trực tiếp định nghĩa, tiêu chí phân loại, danh pháp và tính chất cơ bản; dữ kiện ghi nhớ có thể là đích trả lời.", "refs": ["53f7e0c73214|P1|3|None", "53f7e0c73214|P1|10|None", "53f7e0c73214|P1|11|None", "30e3a77f6f23|P1|7|None", "30e3a77f6f23|P1|10|None", "30e3a77f6f23|P2|4|a"]}, {"use": "Dùng kiến thức đã nhớ làm mắt xích suy luận: từ tên suy công thức, từ nhóm chức suy phản ứng hoặc từ quy tắc điện cực suy chiều biến đổi.", "refs": ["53f7e0c73214|P1|7|None", "53f7e0c73214|P2|2|c", "53f7e0c73214|P3|1|None", "30e3a77f6f23|P1|3|None", "30e3a77f6f23|P1|18|None", "30e3a77f6f23|P3|2|None"]}, {"use": "Cung cấp bảng tra, định nghĩa hoặc quy ước đếm ngay trong đề để chuyển trọng tâm sang đọc dữ liệu và áp dụng.", "refs": ["53f7e0c73214|P1|12|None", "53f7e0c73214|P1|15|None", "53f7e0c73214|P2|1|a", "30e3a77f6f23|P2|2|d"]}, {"use": "Cung cấp đại lượng thực nghiệm và đại lượng nhiệt động làm đầu vào tính toán; việc chọn quan hệ, cơ sở quy đổi và dấu của đại lượng vẫn do người làm thực hiện.", "refs": ["53f7e0c73214|P1|9|None", "53f7e0c73214|P2|2|d", "53f7e0c73214|P3|5|None", "30e3a77f6f23|P2|1|a", "30e3a77f6f23|P3|2|None"]}], "not_observed": [{"use": "Không thấy yêu cầu nhớ niên đại, tiểu sử hoặc giai thoại về người phát hiện. Tên quy luật xuất hiện để nhận diện nội dung kiến thức.", "refs": ["30e3a77f6f23|P1|4|None"]}, {"use": "Không thấy biến dữ liệu thực nghiệm hoặc bảng nhiệt động đã nêu thành bài kiểm tra nhớ nguyên giá trị. Chúng được dùng để tính toán và so sánh.", "refs": ["53f7e0c73214|P2|2|b", "53f7e0c73214|P3|5|None", "30e3a77f6f23|P2|1|d", "30e3a77f6f23|P3|2|None"]}, {"use": "Không thấy tên hợp chất luôn đủ để giải quyết câu hỏi; có hàng buộc đọc cấu tạo, nhóm chức hoặc điều kiện phản ứng thay vì chỉ nhận tên quen.", "refs": ["53f7e0c73214|P1|5|None", "53f7e0c73214|P1|15|None", "30e3a77f6f23|P1|1|None", "30e3a77f6f23|P2|3|b"]}], "scope": "Các nhận xét không xuất hiện chỉ áp dụng cho những hàng được cung cấp."}, "anti_patterns": [{"avoid": "Tạo câu khó chỉ bằng cách kéo dài phép tính mà không thêm quyết định hóa học.", "supported_inference": "Trong dữ liệu, trở ngại của các bài tính nằm ở chọn lượng phản ứng, chuẩn hóa cơ sở hoặc cập nhật thành phần sau biến đổi.", "refs": ["53f7e0c73214|P3|4|None", "53f7e0c73214|P3|5|None", "53f7e0c73214|P3|6|None", "30e3a77f6f23|P2|1|a"]}, {"avoid": "Chấp nhận giải pháp ứng dụng chỉ vì thỏa một đặc tính thuận lợi.", "supported_inference": "Các hàng đánh giá giải pháp yêu cầu nối đặc tính với cơ chế và điều kiện môi trường.", "refs": ["53f7e0c73214|P1|18|None", "30e3a77f6f23|P1|8|None", "30e3a77f6f23|P1|16|None"]}, {"avoid": "Viết câu dựa trên hình nhưng bỏ mất thông tin cấu tạo hoặc bộ phận quyết định.", "supported_inference": "Các hàng dùng hình đòi hỏi đọc liên kết, nhóm chức hoặc đặc điểm dụng cụ; nhãn đơn thuần không thay thế được thông tin đó.", "refs": ["53f7e0c73214|P1|15|None", "53f7e0c73214|P2|2|a", "53f7e0c73214|P3|3|None", "30e3a77f6f23|P1|1|None", "30e3a77f6f23|P1|9|None"]}, {"avoid": "Cho các kết quả chưa cùng cơ sở rồi coi việc so sánh trực tiếp là lời giải đúng.", "supported_inference": "Các hàng so sánh định lượng giữ điều kiện tương ứng hoặc yêu cầu quy đổi về cùng cơ sở.", "refs": ["53f7e0c73214|P2|2|b", "53f7e0c73214|P3|5|None", "30e3a77f6f23|P2|1|d"]}, {"avoid": "Suy toàn bộ tính chất từ thành phần nguyên tố hoặc một nhóm liên kết chung.", "supported_inference": "Các phát biểu kiểu này được dùng làm nhận định sai khi bỏ qua bản chất đơn vị cấu tạo, độ dài hoặc tổ chức mạch.", "refs": ["53f7e0c73214|P2|3|b", "30e3a77f6f23|P2|3|b", "30e3a77f6f23|P2|4|c", "30e3a77f6f23|P2|4|d"]}]}, {"patterns": [], "discrimination_moves": [{"move": "Tự thiết lập cơ sở tính và ẩn số", "how_to_apply": "Cho dữ liệu thành phần và quan hệ giữa các lượng; yêu cầu người làm tự chọn cơ sở tính, đặt ẩn và biểu diễn các đại lượng phụ thuộc trước khi giải.", "refs": ["30e3a77f6f23|P3|4|None", "30e3a77f6f23|P3|6|None"]}, {"move": "Liên kết các công đoạn bằng lượng chất còn dư", "how_to_apply": "Để lượng chất chưa phản ứng quyết định nhu cầu của công đoạn sau, từ đó ảnh hưởng đến thành phần cuối. Muốn giải phải theo dõi cả phần đã chuyển hóa và phần còn lại.", "refs": ["30e3a77f6f23|P3|4|None"]}, {"move": "Theo dõi thành phần đi kèm và thành phần bị tách", "how_to_apply": "Buộc người làm xác định đầy đủ những thành phần thực sự có mặt trong dòng cuối trước khi lập quan hệ tỉ lệ.", "refs": ["30e3a77f6f23|P3|4|None"]}, {"move": "Khai thác ràng buộc đặc hiệu trước ràng buộc chung", "how_to_apply": "Cho các thành phần có mức độ phân bố khác nhau giữa các pha; người làm phải dùng thành phần chỉ thuộc một pha để xác định lượng pha đó, rồi mới xử lý các thành phần dùng chung.", "refs": ["30e3a77f6f23|P3|6|None"]}, {"move": "Phân bổ rồi cập nhật phần còn lại", "how_to_apply": "Yêu cầu trừ lượng thành phần đã được phân bổ trước khi lập cân bằng tiếp theo; kết quả phụ thuộc vào việc duy trì nhất quán lượng còn lại qua chuỗi suy luận.", "refs": ["30e3a77f6f23|P3|6|None"]}], "easy_vs_hard": [], "fact_use": {"common": [{"observation": "Trong dữ liệu được cung cấp, các đại lượng định lượng là đầu vào cần dùng để lập cân bằng, xác định thành phần và chuyển đổi cách biểu diễn kết quả.", "refs": ["30e3a77f6f23|P3|4|None", "30e3a77f6f23|P3|5|None", "30e3a77f6f23|P3|6|None"]}, {"observation": "Kiến thức nền về tỉ lượng, bảo toàn, khối lượng mol và phần khối lượng được vận dụng trong suy luận; các mô tả không cho thấy việc nhớ một dữ kiện riêng lẻ đủ để trả lời.", "refs": ["30e3a77f6f23|P3|4|None", "30e3a77f6f23|P3|5|None", "30e3a77f6f23|P3|6|None"]}], "never_observed": [{"observation": "Không thấy yêu cầu nhớ ngày tháng, tên riêng hoặc nhắc lại định nghĩa như đích trả lời trực tiếp. Nhận xét này chỉ áp dụng cho các hàng được cung cấp.", "refs": ["30e3a77f6f23|P3|4|None", "30e3a77f6f23|P3|5|None", "30e3a77f6f23|P3|6|None"]}]}, "anti_patterns": [], "evidence_limits": "Các hàng đều thuộc cùng một đề nên chưa đủ chứng cứ xác lập mẫu lặp lại giữa các đề. Vì vậy không tạo danh sách mẫu theo độ dài yêu cầu bằng cách chia nhỏ hoặc suy diễn. Các động tác phân hóa chỉ mô tả cách xây dựng quan sát được, chưa được xác nhận là đặc trưng lặp lại. Không có cặp câu cùng chủ đề ở mức dễ và khó để lập đối chiếu, cũng chưa đủ căn cứ khẳng định những cách ra đề tuyệt đối không xuất hiện. Giữ nguyên sự chưa xác định về lớp học."}]
