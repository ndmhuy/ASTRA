r": null}, "questions": [{"id": "98f58fd174f2beaf", "qtype": "mcq", "stem": "Đặc điểm nào sau đây không thuộc về protein?", "options": [{"label": "A", "text": "Được cấu tạo từ các đơn phân là amino acid."}, {"label": "B", "text": "Có thể tham gia cấu tạo các thành phần của tế bào."}, {"label": "C", "text": "Được cấu tạo từ các đơn phân là nucleotide."}, {"label": "D", "text": "Có thể xúc tác các phản ứng sinh hóa trong tế bào."}], "statements": []}, {"id": "277582ccec5bad95", "qtype": "true_false", "stem": "Phân tử X là một polymer sinh học. Khi thủy phân hoàn toàn X, người ta chỉ thu được glucose, không thu được loại đơn phân nào khác. Với mỗi nhận định sau về X, hãy xác định đúng hay sai.", "options": [], "statements": [{"sub": "a", "text": "X thuộc nhóm polysaccharide."}, {"sub": "b", "text": "Các đơn phân cấu tạo nên X là nucleotide có chứa đường glucose."}, {"sub": "c", "text": "X có thể là ADN đảm nhiệm chức năng lưu giữ thông tin di truyền trong nhân tế bào."}, {"sub": "d", "text": "Chỉ từ dữ kiện về sản phẩm thủy phân, chưa thể phân biệt X là tinh bột hay cellulose."}]}, {"id": "0e46b1c974f16717", "qtype": "mcq", "stem": "Trong một thí nghiệm nuôi cấy, quần thể tế bào X được tách từ phôi. Qua nhiều lần phân chia, một phần tế bào con vẫn duy trì đặc điểm của X. Khi thay đổi điều kiện nuôi cấy thích hợp, các nhóm tế bào X có thể lần lượt tạo thành tế bào thần kinh, tế bào cơ tim hoặc tế bào biểu mô. Cách nhận diện nào sau đây phù hợp với tế bào X?", "options": [{"label": "A", "text": "Tế bào thần kinh đã chuyên hóa, vì có thể tạo ra tế bào thần kinh."}, {"label": "B", "text": "Tế bào gốc chưa chuyên hóa, vì có thể tự đổi mới và tạo nhiều loại tế bào."}, {"label": "C", "text": "Tế bào cơ tim đã chuyên hóa, vì có thể tạo ra tế bào cơ tim."}, {"label": "D", "text": "Tế bào biểu mô đã chuyên hóa, vì có thể tạo ra tế bào biểu mô."}], "statements": []}, {"id": "6ec765fc9d6b5cd4", "qtype": "true_false", "stem": "Một phân tử axit nucleic X có đường deoxyribose và thành phần base: A = 28%, T = 28%, G = 22%, C = 22%. X đại diện cho một loại axit nucleic có trong tế bào nhân thực. Xét tế bào mô giậu đang quang hợp ở lá cây đậu, hãy xác định đúng hay sai cho mỗi nhận định sau.", "options": [], "statements": [{"sub": "a", "text": "Thành phần base của X phù hợp với nguyên tắc bổ sung của ADN hai mạch."}, {"sub": "b", "text": "Loại axit nucleic mà X đại diện có thể có trong nhân tế bào."}, {"sub": "c", "text": "Loại axit nucleic mà X đại diện không thể có trong ti thể vì ti thể nằm ngoài nhân."}, {"sub": "d", "text": "Loại axit nucleic mà X đại diện là thành phần axit nucleic cấu tạo nên ribosome."}]}]}
