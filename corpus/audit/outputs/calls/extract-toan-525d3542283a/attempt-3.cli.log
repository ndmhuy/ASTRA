ertainty":"Xếp lớp theo công cụ tổ hợp; tiêu chuẩn khả thi của cơ chế phân bổ và công thức hoán vị có lặp không được liệt kê thành bài riêng trong danh mục tham chiếu. Không có đáp án chuẩn để đối chiếu."},{"part":"P3","idx":4,"sub":null,"topic":"Khoảng cách từ điểm đến mặt phẳng trong hình chóp","grade":11,"given":"Một hình chóp có đáy chữ nhật, cạnh bên vuông góc đáy, các độ dài và một trung điểm trên cạnh đáy; có hình minh họa.","task":"Tính khoảng cách từ một đỉnh đáy đến mặt phẳng qua đỉnh chóp và các điểm đã chỉ định.","reasoning":["Chọn hệ trục theo các cạnh vuông góc để biểu diễn các điểm.","Xác định tọa độ trung điểm và các điểm thuộc mặt phẳng cần xét.","Tìm pháp tuyến rồi lập phương trình mặt phẳng.","Áp dụng công thức khoảng cách từ điểm đến mặt phẳng."],"steps":4,"combines":["Quan hệ vuông góc trong không gian","Trung điểm","Tọa độ không gian","Khoảng cách đến mặt phẳng"],"wrong_options":null,"wrong_option_details":[],"cue_use":"needed in reasoning","difficulty_source":"Cần chọn biểu diễn thuận lợi cho mặt phẳng cắt chéo, sau đó tính theo công thức chuẩn.","discrimination":"medium","optional_path":null,"evidence_uncertainty":"Xếp lớp theo bài khoảng cách trong hình học không gian; chuỗi giải mô tả sử dụng thêm phương pháp tọa độ lớp sau. Không có đáp án chuẩn để đối chiếu."},{"part":"P3","idx":5,"sub":null,"topic":"Ứng dụng đạo hàm: độ dốc của đường parabol","grade":12,"given":"Một cung parabol đối xứng, độ cao đỉnh so với dây cung và độ dài dây cung; có hình vẽ nhưng số đo trong văn bản và hình không thống nhất.","task":"Tính độ dốc lớn nhất theo góc của tiếp tuyến với phương ngang.","reasoning":["Chọn hệ tọa độ theo trục đối xứng và dây cung.","Dùng đỉnh và các đầu mút để xác định phương trình parabol.","Biểu diễn độ dốc bằng độ lớn của đạo hàm.","Tìm giá trị lớn nhất trên đoạn biểu diễn cung."],"steps":4,"combines":["Mô hình parabol","Đạo hàm và hệ số góc tiếp tuyến","Giá trị lớn nhất"],"wrong_options":null,"wrong_option_details":[],"cue_use":"needed in reasoning","difficulty_source":"Nhận ra độ dốc hình học tương ứng với độ lớn của đạo hàm và xét trên đúng cung hữu hạn.","discrimination":null,"optional_path":null,"evidence_uncertainty":"Số đo chiều dài trong văn bản của ảnh gốc không thống nhất với các nhãn hình; bản OCR cũng khác ảnh ở dữ kiện này. Chưa xác định dữ kiện được dùng khi chấm nên không kết luận chắc chắn về khả năng phân hóa. Không có đáp án chuẩn."},{"part":"P3","idx":6,"sub":null,"topic":"Biểu thức tọa độ và khoảng cách giữa các điểm chuyển động trên hình hộp chữ nhật","grade":12,"given":"Một hình hộp chữ nhật, các độ dài cạnh và những chuyển động đồng thời với tốc độ không đổi trên các đường gấp khúc đã chỉ định; có hình phối cảnh.","task":"Tính khoảng cách giữa các điểm chuyển động tại thời điểm một điểm còn cách đích một đoạn cho trước.","reasoning":["Tính độ dài các chặng đường bằng hình học hình hộp.","Xác định vị trí của điểm dùng làm mốc và thời gian tương ứng.","Tính quãng đường điểm còn lại đã đi để xác định nó đang trên chặng nào.","Dùng tỉ lệ trên đoạn thẳng để biểu diễn tọa độ các vị trí.","Tính khoảng cách không gian và làm tròn theo yêu cầu."],"steps":5,"combines":["Định lý Pythagore","Chuyển động đều","Phân chia hành trình theo chặng","Tọa độ vectơ","Khoảng cách trong không gian"],"wrong_options":null,"wrong_option_details":[],"cue_use":"needed in reasoning","difficulty_source":"Đồng bộ thời gian và kiểm tra chặng chuyển động trước khi nội suy vị trí.","discrimination":"medium","optional_path":null,"evidence_uncertainty":"Không có đáp án chuẩn để đối chiếu; hình và mô tả hành trình đủ để xác định các chặng cần kiểm tra."}]}
