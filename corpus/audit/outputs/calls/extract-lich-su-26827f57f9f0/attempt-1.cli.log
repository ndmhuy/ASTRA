ntifiable_error":true,"mistake_kind":"Nhầm tác động chung với khác biệt","reason":"Chọn vai trò thúc đẩy phong trào vốn có thể gắn với cả hai hội nghị."},{"label":"D","identifiable_error":true,"mistake_kind":"Nhầm nhân tố chung với đặc điểm mới","reason":"Nhận ra vai trò của người lãnh đạo nhưng bỏ qua việc vai trò ấy hiện diện ở cả hai sự kiện."}],"cue_use":"needed in reasoning","difficulty_source":"Phân biệt nhận định đúng với nhận định thực sự tạo ra khác biệt","discrimination":"medium","optional_path":null,"evidence_uncertainty":"Không có mẫu hiệu chuẩn chính thức; mức phân hóa là nhận định từ cấu trúc câu hỏi."},{"part":"P1","idx":4,"sub":null,"topic":"Sự hình thành Liên bang Cộng hoà xã hội chủ nghĩa Xô viết","grade":11,"given":"Một sự kiện thành lập nhà nước liên bang và danh sách quốc gia.","task":"Nhận diện một thành viên sáng lập.","reasoning":["Nhớ thành phần sáng lập của nhà nước liên bang.","Ghép thành viên phù hợp với danh sách lựa chọn."],"steps":2,"combines":["Thành phần sáng lập nhà nước liên bang"],"wrong_options":"Các nhiễu đều là quốc gia nằm ngoài thành phần sáng lập; không tạo cạnh tranh giữa những thành viên có quan hệ gần với sự kiện.","wrong_option_details":[{"label":"B","identifiable_error":false,"mistake_kind":"Nhiễu ngoài tập hợp","reason":"Không có quan hệ thành lập gần gũi để tạo ra một nhầm lẫn lịch sử cụ thể có sức thuyết phục."},{"label":"C","identifiable_error":true,"mistake_kind":"Đồng nhất cùng định hướng chính trị với cùng liên bang","reason":"Có thể nhầm một quốc gia theo định hướng xã hội chủ nghĩa với một bộ phận của nhà nước liên bang."},{"label":"D","identifiable_error":false,"mistake_kind":"Nhiễu ngoài tập hợp","reason":"Khác biệt về vị trí chính trị và lịch sử khiến phương án dễ bị loại bằng kiến thức nền."}],"cue_use":"given as a cue","difficulty_source":"Nhận biết thành viên sáng lập qua các nhiễu xa","discrimination":"low","optional_path":null,"evidence_uncertainty":"Không có mẫu hiệu chuẩn chính thức; mức phân hóa là n