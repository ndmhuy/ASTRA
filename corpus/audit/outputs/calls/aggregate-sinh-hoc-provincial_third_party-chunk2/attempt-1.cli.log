 xác định loài chủ chốt", "grade": 12, "given": "Quan hệ ăn và bị ăn, đồ thị biến động quần thể trước và sau khi loại bỏ một loài, cùng các nhận định cần đánh giá.", "task": "Chọn tập hợp nhận định đúng và trình bày ký hiệu theo thứ tự yêu cầu.", "reasoning": ["Dựng quan hệ tác động từ mạng dinh dưỡng đã cho.", "So sánh trạng thái quần xã trước và sau can thiệp.", "Dùng biến đổi sau loại bỏ để đánh giá vai trò của loài bị tác động.", "Đối chiếu tổng quy mô ban đầu với trạng thái sau đó.", "Tổng hợp các nhận định được dữ liệu hỗ trợ."], "steps": 5, "combines": ["Quan hệ dinh dưỡng", "Loài chủ chốt", "Biến động quần thể", "Suy luận từ thí nghiệm loại bỏ"], "wrong_options": "Nhận định sai đồng nhất trạng thái ổn định với thời điểm có tổng số cá thể lớn nhất.", "wrong_option_details": [{"label": "3", "identifiable_error": true, "mistake_kind": "Nhầm ổn định với cực đại", "reason": "Cho rằng cân bằng sinh thái luôn làm tổng số cá thể cao nhất mà không so sánh với điều kiện ban đầu."}], "cue_use": "needed in reasoning", "difficulty_source": "Phân biệt ảnh hưởng gián tiếp của loài với xu hướng số lượng riêng lẻ", "discrimination": "medium", "evidence_uncertainty": "Các đồ thị có thang biểu diễn và phạm vi khác nhau; đánh giá tổng số cần kết hợp dữ kiện ban đầu, không cộng trực tiếp độ cao các đường.", "optional_path": null, "paper_id": "61a0198fbfda", "year": "2026", "evidence_class": "provincial_third_party", "ref": "61a0198fbfda|P3|2|None"}, {"part": "P3", "idx": 3, "sub": null, "topic": "Quần xã sinh vật: ổ sinh thái dinh dưỡng và ảnh hưởng của nguồn thức ăn", "grade": 12, "given": "Bảng liên hệ dạng cơ quan kiếm ăn với loại thức ăn và một thay đổi làm giảm nguồn tài nguyên.", "task": "Xác định nhóm sinh vật chịu tác động bất lợi trực tiếp nhất.", "reasoning": ["Xác định nguồn thức ăn bị giảm bởi thay đổi môi trường.", "Ghép nguồn đó với nhóm sử dụng chuyên biệt trong bảng."], "steps": 2, "combines": ["Ổ sinh thái dinh dưỡng", "Quan hệ sinh vật với nguồn sống"], "wrong_