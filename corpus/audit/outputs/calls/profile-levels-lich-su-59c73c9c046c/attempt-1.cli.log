{"assignments":[{"ref":"acc23c4ca4f8|P1|1|None","level":"TH","confidence":"medium","justification":"Mô tả đòi hỏi phân biệt cách khái quát phù hợp với cách diễn đạt tuyệt đối hóa, thuộc thao tác hiểu kiến thức đã học.","decisive_demand":"Phân biệt phạm vi và mức độ của nhận định khái quát.","uncertainty":"Thiếu các lựa chọn nên chưa loại trừ khả năng chỉ cần nhận ra một đặc điểm đã học, tương ứng NB."},{"ref":"acc23c4ca4f8|P1|2|None","level":"TH","confidence":"medium","justification":"Yêu cầu được mô tả là phân biệt tác động theo loại hoạt động và giai đoạn, không chỉ nhận diện một sự kiện.","decisive_demand":"Phân biệt tác động phù hợp với nguồn phát sinh và phạm vi thời gian.","uncertainty":"Nếu tác động được trình bày nguyên dạng kiến thức đã học thì thao tác tối thiểu có thể là NB; thiếu lựa chọn để xác định chắc chắn."},{"ref":"acc23c4ca4f8|P1|3|None","level":"TH","confidence":"high","justification":"Đối chiếu trình tự thời gian để kiểm tra một quan hệ giải thích là thao tác hiểu quen thuộc; chưa cần xây dựng chuỗi lập luận thực chất.","decisive_demand":"Kiểm tra tính phù hợp của quan hệ nhân quả bằng thứ tự thời gian.","uncertainty":null},{"ref":"acc23c4ca4f8|P1|4|None","level":"NB","confidence":"high","justification":"Thao tác tối thiểu là truy hồi một liên hệ đã học giữa dấu mốc và đối tượng tương ứng.","decisive_demand":"Nhận diện đối tượng từ dấu mốc đã cho.","uncertainty":null},{"ref":"acc23c4ca4f8|P1|5|None","level":"TH","confidence":"medium","justification":"Mô tả hướng tới phân biệt kết quả với chủ trương và nhân tố tác động, thuộc hiểu và phân loại kiến thức quen thuộc.","decisive_demand":"Phân biệt loại nội dung và mức độ khẳng định của nhận định.","uncertainty":"Chưa làm rõ ranh giới giữa các lựa chọn có thể cùng hợp lí; thiếu nguyên văn lựa chọn và căn cứ phân biệt để xác định chắc chắn yêu cầu tối thiểu."},{"ref":"acc23c4ca4f8|P1|6|None","level":"TH","confidence":"medium","justification":"Nhận ra đặc điểm chung rồi liên hệ với một nguyên tắc đã học là khái quát và diễn giải; mô tả chưa chứng minh cần lập luận vượt thao tác quen thuộc.","decisive_demand":"Khái quát điểm chung và nhận diện nguyên tắc tương ứng.","uncertainty":"Chưa có nội dung cụ thể của các quyết định và lựa chọn để xác định độ trực tiếp của liên hệ."},{"ref":"acc23c4ca4f8|P1|7|None","level":"NB","confidence":"medium","justification":"Có thể đáp ứng bằng việc truy hồi nhiệm vụ gắn với một giai đoạn đã học; giới hạn thời gian chủ yếu làm dấu hiệu nhận diện.","decisive_demand":"Truy hồi nhiệm vụ thuộc giai đoạn được chỉ định.","uncertainty":"Nếu các lựa chọn đòi hỏi phân biệt những phạm vi thời gian giao nhau thì có thể cần TH; bản trừu tượng chưa thể hiện điều đó."},{"ref":"acc23c4ca4f8|P1|8|None","level":"TH","confidence":"medium","justification":"Thao tác được mô tả là phân biệt các loại vai trò và nguồn tác động; yêu cầu chọn ngoại lệ tự nó không nâng mức độ.","decisive_demand":"Phân biệt vai trò trực tiếp với điều kiện tác động bên ngoài.","uncertainty":"Thiếu lựa chọn nên chưa xác định được liệu truy hồi một thuộc tính đã học có đủ hay không."},{"ref":"acc23c4ca4f8|P1|9|None","level":"NB","confidence":"high","justification":"Chỉ cần nhận ra liên hệ sự kiện và dấu mốc trong một đơn vị kiến thức đã học.","decisive_demand":"Ghép hoạt động với dấu mốc bằng trí nhớ.","uncertainty":null},{"ref":"acc23c4ca4f8|P1|10|None","level":"NB","confidence":"high","justification":"Các dấu hiệu dùng để truy hồi một liên hệ lịch sử đã học, không thể hiện yêu cầu giải thích hoặc suy luận mới.","decisive_demand":"Nhận diện đối tượng gắn với một dấu hiệu sự kiện.","uncertainty":null},{"ref":"acc23c4ca4f8|P1|11|None","level":"TH","confidence":"medium","justification":"Phân biệt phạm vi tác động và mức độ hoàn thành của một quá trình là biểu hiện hiểu ý nghĩa kiến thức.","decisive_demand":"Phân biệt phạm vi và mức độ của tác động.","uncertainty":"Có thể chỉ cần nhận ra một ý nghĩa được học trực tiếp; thiếu lựa chọn để phân định chắc chắn với NB."},{"ref":"acc23c4ca4f8|P1|12|None","level":"TH","confidence":"medium","justification":"Mô tả yêu cầu đối chiếu kết quả thực tế với cách diễn đạt nâng mức độ, thuộc phân biệt ý nghĩa và giới hạn kiến thức.","decisive_demand":"Phân biệt kết quả đạt được với kết luận vượt quá phạm vi.","uncertainty":"Nếu lựa chọn phù hợp là một đóng góp được ghi nhớ trực tiếp thì NB có thể đủ; chưa có lựa chọn để kiểm tra."},{"ref":"acc23c4ca4f8|P1|13|None","level":"NB","confidence":"high","justification":"Nhiều dấu hiệu vẫn chỉ phục vụ truy hồi một liên hệ đã học giữa sự kiện và sản phẩm tương ứng.","decisive_demand":"Nhận diện thông tin gắn với sự kiện được chỉ định.","uncertainty":null},{"ref":"acc23c4ca4f8|P1|14|None","level":"TH","confidence":"medium","justification":"Đối chiếu một bước phát triển với trạng thái tổ chức tương ứng là vận dụng kiến thức theo cách quen thuộc, chưa thể hiện chuỗi suy luận thực chất.","decisive_demand":"Đối chiếu giai đoạn phát triển với bối cảnh phù hợp.","uncertainty":"Chưa rõ bối cảnh có phải một liên hệ đã học trực tiếp hay phải được khôi phục qua đối chiếu; ranh giới NB và TH còn mở."},{"ref":"acc23c4ca4f8|P1|15|None","level":"NB","confidence":"high","justification":"Yêu cầu tối thiểu là nhớ nội dung thuộc một sự kiện đã được xác định rõ.","decisive_demand":"Truy hồi nội dung của sự kiện đã học.","uncertainty":null},{"ref":"acc23c4ca4f8|P1|16|None","level":"NB","confidence":"medium","justification":"Mô tả cho phép trả lời bằng việc nhớ bối cảnh trực tiếp gắn với một chủ trương; chưa buộc phải tự giải thích quan hệ.","decisive_demand":"Nhận diện bối cảnh đã học của một chủ trương.","uncertainty":"Thiếu lựa chọn nên chưa rõ có cần phân biệt bản chất các điều kiện gần nhau ở mức TH hay không."},{"ref":"acc23c4ca4f8|P1|17|None","level":"NB","confidence":"high","justification":"Đối tượng cần xác định là một kết quả trực tiếp thuộc đơn vị kiến thức về sự kiện đã học.","decisive_demand":"Truy hồi đối tượng gắn với kết quả sự kiện.","uncertainty":null},{"ref":"acc23c4ca4f8|P1|18|None","level":"TH","confidence":"medium","justification":"Theo mô tả, cần đối chiếu trình tự của các xu hướng với thời điểm sự kiện; đây là thao tác hiểu quen thuộc.","decisive_demand":"Đối chiếu niên biểu để nhận diện bối cảnh phù hợp.","uncertainty":"Nếu bối cảnh đã được học thành một liên hệ trực tiếp thì NB có thể đủ; thiếu lựa chọn để xác định đường trả lời tối thiểu."},{"ref":"acc23c4ca4f8|P1|19|None","level":"NB","confidence":"high","justification":"Nhận diện một mục tiêu chính thức đã học có thể hoàn thành bằng truy hồi một đơn vị kiến thức.","decisive_demand":"Nhớ và nhận ra mục tiêu chính thức.","uncertainty":null},{"ref":"acc23c4ca4f8|P1|20|None","level":"TH","confidence":"medium","justification":"Mô tả yêu cầu phân biệt cách diễn đạt về đặc điểm và mức độ phát triển, phù hợp với hiểu kiến thức trong bài tập quen thuộc.","decisive_demand":"Đối chiếu nội hàm và mức độ của mô tả với đặc điểm đã học.","uncertainty":"Chưa có căn cứ phân biệt rõ các lựa chọn gần nghĩa; cần nội dung lựa chọn và căn cứ phân biệt để xác định chắc chắn yêu cầu tối thiểu."},{"ref":"acc23c4ca4f8|P1|21|None","level":"TH","confidence":"medium","justification":"Phân loại sự kiện rồi kiểm tra sự phù hợp với hai điều kiện là quy trình đối chiếu quen thuộc, không tự tạo thành VD.","decisive_demand":"Phân loại và đối chiếu sự kiện theo các điều kiện cho trước.","uncertainty":"Nếu một sự kiện được nhận ra trực tiếp qua dấu hiệu thì NB có thể đủ; thiếu lựa chọn để loại trừ khả năng này."},{"ref":"acc23c4ca4f8|P1|22|None","level":"TH","confidence":"high","justification":"Mô tả thể hiện việc diễn giải một tác động trong tư liệu và phân biệt kết luận phù hợp với kết luận vượt phạm vi.","decisive_demand":"Diễn giải quan hệ tác động được thể hiện trong tư liệu.","uncertainty":null},{"ref":"acc23c4ca4f8|P1|23|None","level":"TH","confidence":"medium","justification":"Suy ra một hệ quả gần từ thông tin đã cho và kiến thức quen thuộc là thao tác hiểu; chưa có bằng chứng phải xây dựng chuỗi suy luận thực chất.","decisive_demand":"Diễn giải hệ quả trực tiếp đối với điều kiện thực hiện nhiệm vụ.","uncertainty":"Thiếu đoạn trích và lựa chọn nên chưa xác định được mức độ trực tiếp của liên hệ."},{"ref":"acc23c4ca4f8|P1|24|None","level":"NB","confidence":"high","justification":"Bản trừu tượng xác định thông tin cần chọn được nêu trực tiếp; thao tác tối thiểu là nhận ra và đối chiếu một thông tin.","decisive_demand":"Nhận diện thông tin trực tiếp trong biểu đạt đã cho.","uncertainty":null},{"ref":"acc23c4ca4f8|P2|1|a","level":"TH","confidence":"high","justification":"Phân biệt ý nghĩa của một dấu mốc với vị trí của nó trong tiến trình là diễn giải và đối chiếu kiến thức quen thuộc.","decisive_demand":"Phân biệt dấu mốc phát triển với điểm khởi đầu của tiến trình.","uncertainty":null},{"ref":"acc23c4ca4f8|P2|1|b","level":"TH","confidence":"high","justification":"Kiểm tra một quan hệ điều kiện bằng trình tự sự kiện là thao tác đối chiếu quen thuộc, chưa đòi hỏi tự xây dựng mô hình giải thích.","decisive_demand":"Dùng thứ tự thời gian để kiểm tra quan hệ điều kiện.","uncertainty":null},{"ref":"acc23c4ca4f8|P2|1|c","level":"TH","confidence":"medium","justification":"Liên hệ một xu hướng với nhu cầu phát triển và phân biệt mức độ tác động phù hợp với giải thích kiến thức đã học.","decisive_demand":"Giải thích quan hệ tác động và phân biệt mức độ khẳng định.","uncertainty":"Chưa rõ quan hệ này được học trực tiếp hay cần tự xây dựng qua nhiều tiền đề; mô tả chưa đủ để khẳng định VD."},{"ref":"acc23c4ca4f8|P2|1|d","level":"TH","confidence":"high","justification":"Xác định nội dung chung của một đoạn qua loại thông tin được trình bày là đọc hiểu và khái quát.","decisive_demand":"Khái quát chủ đề của đoạn từ các ý thành phần.","uncertainty":null},{"ref":"acc23c4ca4f8|P2|2|a","level":"TH","confidence":"medium","justification":"Đối chiếu chủ trương với mục đích thông qua một quan hệ giải thích quen thuộc thuộc mức hiểu.","decisive_demand":"Giải thích sự phù hợp giữa biện pháp và mục đích.","uncertainty":"Thiếu cách diễn đạt cụ thể nên chưa rõ chỉ cần nhận ra một mục đích đã học hay cần diễn giải quan hệ."},{"ref":"acc23c4ca4f8|P2|2|b","level":"TH","confidence":"medium","justification":"Phân biệt một chủ trương với lời giải thích đi kèm và kiểm tra phạm vi của lời giải thích là hiểu khái niệm; chưa đủ bằng chứng về chuỗi lập luận thực chất.","decisive_demand":"Phân biệt vai trò nền tảng với sự quy định tuyệt đối.","uncertainty":"Thiếu nội dung cụ thể và căn cứ của lời giải thích nên chưa xác định được độ sâu cần thiết của việc kết nối kiến thức."},{"ref":"acc23c4ca4f8|P2|2|c","level":"TH","confidence":"high","justification":"Đối chiếu các thành phần nhận định với sự phân biệt có trong tư liệu là thao tác đọc hiểu trực tiếp.","decisive_demand":"Phân biệt yếu tố được duy trì với yếu tố được điều chỉnh.","uncertainty":null},{"ref":"acc23c4ca4f8|P2|2|d","level":"TH","confidence":"high","justification":"Nhận định đòi hỏi hiểu quan hệ giữa các khái niệm và đối chiếu với nguyên tắc đã cho, không chỉ lặp lại một thông tin.","decisive_demand":"Diễn giải sự tương thích giữa tính ổn định và khả năng điều chỉnh.","uncertainty":null},{"ref":"acc23c4ca4f8|P2|3|a","level":"TH","confidence":"high","justification":"Phân biệt nhiệm vụ ưu tiên với phạm vi giải quyết toàn bộ nhiệm vụ là hiểu giới hạn của một chủ trương trong bối cảnh đã học.","decisive_demand":"Đối chiếu phạm vi khẳng định với thứ tự ưu tiên của nhiệm vụ.","uncertainty":null},{"ref":"acc23c4ca4f8|P2|3|b","level":"TH","confidence":"high","justification":"Đọc các thành phần của bảng rồi kiểm tra phạm vi của nhận định khái quát là diễn giải biểu diễn cho trước.","decisive_demand":"So sánh phạm vi nhận định với toàn bộ thông tin trong bảng.","uncertainty":null},{"ref":"acc23c4ca4f8|P2|3|c","level":"TH","confidence":"medium","justification":"Liên hệ các quyết định với chức năng chuẩn bị và đối chiếu ý nghĩa là giải thích quen thuộc; số mặt được nhắc tới không đủ xác lập VD.","decisive_demand":"Giải thích vai trò của các quyết định đối với một quá trình.","uncertainty":"Chưa rõ ý nghĩa có thể được truy hồi trực tiếp hay phải suy ra qua các liên hệ phụ thuộc; thiếu nội dung cụ thể để phân định."},{"ref":"acc23c4ca4f8|P2|3|d","level":"TH","confidence":"high","justification":"Phân biệt ý định với kết quả và kiểm tra mức độ khẳng định bằng kiến thức đã học thuộc thao tác hiểu.","decisive_demand":"Phân biệt mục đích hành động với kết quả thực tế.","uncertainty":null},{"ref":"acc23c4ca4f8|P2|4|a","level":"TH","confidence":"high","justification":"Liên hệ những tác động được mô tả với một khái niệm khái quát là diễn giải nội dung tư liệu.","decisive_demand":"Nhận diện vai trò khái quát từ các biểu hiện cụ thể.","uncertainty":null},{"ref":"acc23c4ca4f8|P2|4|b","level":"TH","confidence":"medium","justification":"Rút ra mục tiêu chung và phân biệt mục tiêu với hình thức thực hiện là khái quát kiến thức; chưa chứng minh cần chuỗi suy luận thực chất.","decisive_demand":"Khái quát yếu tố xuyên suốt từ các hoạt động được mô tả.","uncertainty":"Thiếu đoạn trích nên chưa rõ mục tiêu chung được nêu trực tiếp hay phải tự tổng hợp qua các quan hệ sâu hơn."},{"ref":"acc23c4ca4f8|P2|4|c","level":"TH","confidence":"high","justification":"Đối chiếu chiều tác động trong nhận định với quan hệ đã học và thông tin cho trước là kiểm tra cách hiểu nhân quả quen thuộc.","decisive_demand":"Phân biệt chiều nguyên nhân và kết quả.","uncertainty":null},{"ref":"acc23c4ca4f8|P2|4|d","level":"NB","confidence":"medium","justification":"Theo bản trừu tượng, nhận định chỉ diễn đạt lại một thông tin trực tiếp; yêu cầu tối thiểu có thể là nhận ra cùng một nội dung.","decisive_demand":"Nhận diện sự tương ứng của thông tin trực tiếp.","uncertainty":"Chưa có hai cách diễn đạt để xác định việc đối chiếu chỉ cần nhận diện hay cần diễn giải ở mức TH."}]}
