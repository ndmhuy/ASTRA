Một tổ chức quốc tế và các mục tiêu gắn với trật tự thế giới, chiến tranh và hợp tác.", "task": "Nhận diện mục tiêu chính thức của tổ chức.", "reasoning": ["Nhớ những mục tiêu cơ bản của tổ chức.", "Phân biệt mục tiêu lâu dài với nhiệm vụ của liên minh thời chiến và các vấn đề hậu chiến."], "combines": ["Mục tiêu tổ chức quốc tế", "Bối cảnh hình thành trật tự hậu chiến"], "cue_use": "given as a cue", "evidence_uncertainty": null}, {"ref": "acc23c4ca4f8|P1|20|None", "part": "P1", "idx": 20, "sub": null, "topic": "Kháng chiến chống Mỹ, cứu nước: đặc điểm phong trào đấu tranh ở miền Nam thời kì đầu", "grade": 12, "given": "Một phong trào đấu tranh và các mô tả về phương thức, địa bàn, mục tiêu, điều kiện bùng nổ.", "task": "Chọn mô tả phù hợp về đặc điểm phong trào.", "reasoning": ["Nhớ địa bàn, lực lượng, mục tiêu và kết quả chủ yếu của phong trào.", "Kiểm tra mức độ phát triển của từng mặt đấu tranh tại giai đoạn đó.", "Đối chiếu cách diễn đạt về nhiệm vụ dân tộc, dân chủ và thời cơ."], "combines": ["Đặc điểm phong trào cách mạng", "Nhiệm vụ dân tộc và dân chủ", "Hình thức đấu tranh", "Thời cơ cách mạng"], "cue_use": "given as a cue", "evidence_uncertainty": "Chưa có giải trình đủ rõ để phân biệt hoàn toàn phương án đúng với một phương án gần nghĩa; mức phân hóa chỉ là ước lượng từ thao tác cần làm."}, {"ref": "acc23c4ca4f8|P1|21|None", "part": "P1", "idx": 21, "sub": null, "topic": "Kháng chiến chống thực dân Pháp: củng cố khối đại đoàn kết dân tộc", "grade": 12, "given": "Một khoảng thời gian và yêu cầu giới hạn lĩnh vực, kèm các sự kiện thuộc nhiều mặt hoạt động.", "task": "Chọn sự kiện đồng thời đúng thời gian và lĩnh vực.", "reasoning": ["Xác định giới hạn thời gian và lĩnh vực được hỏi.", "Phân loại các sự kiện theo lĩnh vực rồi kiểm tra mốc diễn ra."], "combines": ["Niên biểu kháng chiến", "Phân loại lĩnh vực lịch sử", "Khối đại đoàn kết dân tộc"], "cue_use": "given as a cue", "evidence_uncertainty": null}, {"ref": "acc23c4ca4f8|P1|22|None", "part": "P1", "idx": 22, "sub": null, "topic": "Kháng chiến chống Mỹ, cứu nước: tác động chiến lược của tổng tiến công và nổi dậy", "grade": 12, "given": "Một trích đoạn sử học nêu kết quả của hoạt động quân sự và các nhận định giải thích chuyển biến chiến tranh.", "task": "Chọn nguyên nhân trực tiếp tạo ra chuyển biến chiến lược.", "reasoning": ["Tìm trong tư liệu tác động đối với quyết tâm và chính sách của đối phương.", "Phân biệt tác động thực tế với sự phóng đại phạm vi hoặc kết quả thuộc thời điểm khác."], "combines": ["Đọc hiểu tư liệu lịch sử", "Tác động chính trị của thắng lợi quân sự"], "cue_use": "given as a cue", "evidence_uncertainty": null}, {"ref": "acc23c4ca4f8|P1|23|None", "part": "P1", "idx": 23, "sub": null, "topic": "Kháng chiến chống Mỹ, cứu nước: ý nghĩa của phối hợp chiến trường và hậu phương", "grade": 12, "given": "Một trích đoạn về hệ quả quân sự, ngoại giao và thay đổi hoạt động chiến tranh của đối phương.", "task": "Suy ra ý nghĩa phù hợp đối với nhiệm vụ ở hậu phương.", "reasoning": ["Tách các hệ quả cụ thể được tư liệu nêu.", "Liên hệ việc giảm hoạt động phá hoại với điều kiện thực hiện nhiệm vụ ở hậu phương.", "Loại các kết luận sai thời điểm, phóng đại tương quan lực lượng hoặc tuyệt đối hóa ngoại giao."], "combines": ["Đọc hiểu tư liệu lịch sử", "Quan hệ hậu phương và tiền tuyến", "Phối hợp quân sự và ngoại giao"], "cue_use": "given as a cue", "evidence_uncertainty": null}, {"ref": "acc23c4ca4f8|P1|24|None", "part": "P1", "idx": 24, "sub": null, "topic": "Kháng chiến chống Mỹ, cứu nước: các chiến lược chiến tranh của đối phương", "grade": 12, "given": "Một trích đoạn trực tiếp nêu tên loại chiến lược bị đánh bại và các tên chiến lược để lựa chọn.", "task": "Nhận diện thông tin được nêu trực tiếp trong tư liệu.", "reasoning": ["Tìm cụm thông tin trả lời yêu cầu trong tư liệu.", "Đối chiếu với tên chiến lược trong các lựa chọn."], "combines": ["Đọc hiểu tư liệu lịch sử"], "cue_use": "given as a cue", "evidence_uncertainty": null}, {"ref": "acc23c4ca4f8|P2|1|a", "part": "P2", "idx": 1, "sub": "a", "topic": "Sự ra đời và phát triển của ASEAN: quá trình hòa giải và mở rộng thành viên", "grade": 12, "given": "Một trích đoạn đánh giá ý nghĩa hội nhập khu vực và một nhận định coi việc gia nhập là điểm bắt đầu hòa giải.", "task": "Đánh giá tính đúng sai của cách xác định điểm khởi đầu tiến trình.", "reasoning": ["Phân biệt nội dung tư liệu về ý nghĩa với nhận định về thời điểm khởi đầu.", "Nhớ quá trình cải thiện quan hệ đã diễn ra trước sự kiện gia nhập.", "Đối chiếu để bác bỏ việc đồng nhất dấu mốc phát triển với điểm bắt đầu."], "combines": ["Đọc hiểu tư liệu lịch sử", "Quá trình hòa giải khu vực", "Tiến trình mở rộng tổ chức"], "cue_use": "needed in reasoning", "evidence_uncertainty": null}, {"ref": "acc23c4ca4f8|P2|1|b", "part": "P2", "idx": 1, "sub": "b", "topic": "Hoạt động đối ngoại của Việt Nam sau thống nhất: bình thường hóa quan hệ và hội nhập khu vực", "grade": 12, "given": "Một trích đoạn về lợi ích hội nhập cùng nhận định liên kết việc gia nhập tổ chức khu vực với các bước bình thường hóa quan hệ.", "task": "Kiểm tra quan hệ điều kiện giữa các sự kiện đối ngoại.", "reasoning": ["Xác định quan hệ nhân quả mà nhận định đề xuất.", "Khôi phục thứ tự của các bước bình thường hóa và gia nhập.", "Kiểm tra xem sự kiện được coi là điều kiện có thực sự xảy ra trước các kết quả hay không."], "combines": ["Hội nhập khu vực", "Bình thường hóa quan hệ đối ngoại", "Kiểm tra quan hệ nhân quả bằng niên biểu"], "cue_use": "needed in reasoning", "evidence_uncertainty": null}, {"ref": "acc23c4ca4f8|P2|1|c", "part": "P2", "idx": 1, "sub": "c", "topic": "Sự ra đời và phát triển của ASEAN: các nhân tố thúc đẩy Việt Nam hội nhập", "grade": 12, "given": "Một trích đoạn về hội nhập khu vực và nhận định gắn quyết định hội nhập với biến đổi công nghệ, kinh tế thế giới.", "task": "Đánh giá vai trò tác động của xu hướng thế giới đối với lựa chọn hội nhập.", "reasoning": ["Nhớ tác động của tiến bộ công nghệ và liên kết kinh tế quốc tế.", "Liên hệ nhu cầu hợp tác, phát triển với quyết định tham gia liên kết khu vực.", "Kiểm tra cách diễn đạt coi đây là một nhân tố chứ không phải nguyên nhân duy nhất."], "combines": ["Hội nhập khu vực", "Cách mạng khoa học và công nghệ", "Toàn cầu hóa"], "cue_use": "given as a cue", "evidence_uncertainty": null}, {"ref": "acc23c4ca4f8|P2|1|d", "part": "P2", "idx": 1, "sub": "d", "topic": "Sự ra đời và phát triển của ASEAN: ý nghĩa của việc Việt Nam gia nhập", "grade": 12, "given": "Một đoạn đánh giá những thay đổi về quan hệ khu vực, môi trường phát triển và vị thế quốc tế.", "task": "Xác định đoạn trích có tập trung trình bày ý nghĩa của một sự kiện hay không.", "reasoning": ["Nhận diện các câu diễn đạt tác động và giá trị của sự kiện.", "Khái quát nội dung chung của đoạn trích."], "combines": ["Đọc hiểu tư liệu lịch sử", "Phân biệt nội dung và ý nghĩa sự kiện"], "cue_use": "none", "evidence_uncertainty": null}, {"ref": "acc23c4ca4f8|P2|2|a", "part": "P2", "idx": 2, "sub": "a", "topic": "Khái quát về công cuộc Đổi mới: nội dung đổi mới kinh tế", "grade": 12, "given": "Một trích đoạn về phương hướng cải cách và nhận định về mục đích phát triển cơ chế kinh tế mới.", "task": "Đánh giá sự phù hợp giữa chủ trương kinh tế và mục đích giải phóng nguồn lực.", "reasoning": ["Nhớ nội dung cơ bản của đổi mới kinh tế.", "Liên hệ việc phát huy các thành phần kinh tế với mở rộng năng lực sản xuất."], "combines": ["Đường lối đổi mới kinh tế", "Thành phần kinh tế và lực lượng sản xuất"], "cue_use": "none", "evidence_uncertainty": null}, {"ref": "acc23c4ca4f8|P2|2|b", "part": "P2", "idx": 2, "sub": "b", "topic": "Khái quát về công cuộc Đổi mới: quan hệ giữa đổi mới kinh tế và đổi mới chính trị", "grade": 12, "given": "Một trích đoạn xác định lĩnh vực trọng tâm và nhận định giải thích sự lựa chọn ấy bằng một quan hệ quyết định.", "task": "Kiểm tra tính đúng của lời giải thích về vai trò của kinh tế đối với chế độ chính trị.", "reasoning": ["Tách chủ trương lấy kinh tế làm trọng tâm khỏi lời giải thích đi kèm.", "Nhớ yêu cầu tháo gỡ khủng hoảng và phát triển sản xuất.", "Phân biệt vai trò nền tảng của kinh tế với việc quy bản chất chế độ chính trị cho riêng kinh tế."], "combines": ["Bối cảnh Đổi mới", "Quan hệ kinh tế và chính trị", "Phân biệt chủ trương với lí do"], "cue_use": "none", "evidence_uncertainty": null}, {"ref": "acc23c4ca4f8|P2|2|c", "part": "P2", "idx": 2, "sub": "c", "topic": "Khái quát về công cuộc Đổi mới: mục tiêu và phương thức thực hiện", "grade": 12, "given": "Một trích đoạn phân biệt mục tiêu với cách thực hiện và một nhận định gộp cả hai vào phạm vi thay đổi.", "task": "Đánh giá nhận định có bảo toàn ranh giới giữa mục tiêu và biện pháp hay không.", "reasoning": ["Xác định yếu tố được giữ vững và yếu tố được điều chỉnh trong tư liệu.", "Đối chiếu từng thành phần của nhận định với sự phân biệt đó."], "combines": ["Đọc hiểu tư liệu lịch sử", "Mục tiêu và phương thức Đổi mới"], "cue_use": "none", "evidence_uncertainty": null}, {"ref": "acc23c4ca4f8|P2|2|d", "part": "P2", "idx": 2, "sub": "d", "topic": "Khái quát về công cuộc Đổi mới: kiên định mục tiêu và phát triển nhận thức", "grade": 12, "given": "Một trích đoạn về điều chỉnh cách thực hiện mục tiêu cùng nhận định khái quát quan hệ giữa đổi mới nhận thức và tính kiên định.", "task": "Đánh giá khả năng đồng thời điều chỉnh nhận thức và giữ vững mục tiêu.", "reasoning": ["Nhận diện mục tiêu nền tảng được duy trì.", "Phân biệt tính linh hoạt trong nhận thức, biện pháp với sự thay đổi mục tiêu.", "Đối chiếu nhận định với nguyên tắc đó."], "combines": ["Nguyên tắc Đổi mới", "Quan hệ giữa kiên định và sáng tạo"], "cue_use": "none", "evidence_uncertainty": null}, {"ref": "acc23c4ca4f8|P2|3|a", "part": "P2", "idx": 3, "sub": "a", "topic": "Hồ Chí Minh – Anh hùng giải phóng dân tộc: xây dựng mặt trận và xác định nhiệm vụ chiến lược", "grade": 12, "given": "Một bảng niên biểu về hoạt động lãnh đạo cách mạng và nhận định suy rộng mục đích của việc tập hợp lực lượng.", "task": "Kiểm tra phạm vi nhiệm vụ mà tổ chức tập hợp lực lượng hướng tới ở giai đoạn đó.", "reasoning": ["Nhận diện vai trò tập hợp lực lượng của tổ chức.", "Nhớ thứ tự ưu tiên giữa các nhiệm vụ chiến lược trong hoàn cảnh lịch sử.", "Phân biệt tập trung giải quyết nhiệm vụ cấp bách với giải quyết triệt để mọi nhiệm vụ."], "combines": ["Mặt trận dân tộc thống nhất", "Chuyển hướng chỉ đạo chiến lược", "Nhiệm vụ dân tộc và dân chủ"], "cue_use": "given as a cue", "evidence_uncertainty": null}, {"ref": "acc23c4ca4f8|P2|3|b", "part": "P2", "idx": 3, "sub": "b", "topic": "Hồ Chí Minh – Anh hùng giải phóng dân tộc: chuẩn bị, lãnh đạo giành chính quyền và thành lập nhà nước", "grade": 12, "given": "Một bảng niên biểu gồm hoạt động chuẩn bị, lãnh đạo khởi nghĩa và xác lập chính quyền, kèm nhận định về phạm vi bảng.", "task": "Đánh giá nhận định khái quát có bao quát đúng toàn bộ bảng hay không.", "reasoning": ["Đọc phạm vi thời gian và loại hoạt động ở các hàng.", "So sánh với phạm vi hẹp mà nhận định sử dụng để mô tả toàn bảng."], "combines": ["Đọc bảng niên biểu", "Phân kì tiến trình cách mạng"], "cue_use": "given as a cue", "evidence_uncertainty": null}, {"ref": "acc23c4ca4f8|P2|3|c", "part": "P2", "idx": 3, "sub": "c", "topic": "Hồ Chí Minh – Anh hùng giải phóng dân tộc: hoàn chỉnh chủ trương giải phóng dân tộc và chuẩn bị khởi nghĩa", "grade": 12, "given": "Một bảng liệt kê hội nghị lãnh đạo và các hoạt động chuẩn bị cách mạng, kèm nhận định về ý nghĩa mở đầu một thời kì.", "task": "Đánh giá vai trò của hội nghị đối với quá trình chuẩn bị khởi nghĩa.", "reasoning": ["Nhớ những quyết định về đường lối, lực lượng và căn cứ của hội nghị.", "Liên hệ các quyết định với yêu cầu chuẩn bị trên nhiều mặt.", "Đối chiếu mức khái quát của nhận định với tác động thực tế."], "combines": ["Chuyển hướng chỉ đạo chiến lược", "Chuẩn bị lực lượng chính trị và vũ trang", "Ý nghĩa hội nghị lãnh đạo"], "cue_use": "given as a cue", "evidence_uncertainty": null}, {"ref": "acc23c4ca4f8|P2|3|d", "part": "P2", "idx": 3, "sub": "d", "topic": "Hồ Chí Minh – Anh hùng giải phóng dân tộc: hoạt động đối ngoại và nguồn lực của thắng lợi cách mạng", "grade": 12, "given": "Một bảng có hoạt động tìm kiếm phối hợp quốc tế và nhận định khẳng định đã nhận được hỗ trợ quân sự lớn.", "task": "Kiểm tra việc suy từ nỗ lực ngoại giao sang mức độ hỗ trợ thực tế.", "reasoning": ["Phân biệt mục đích tìm kiếm hợp tác với kết quả thực sự đạt được.", "Nhớ tính chất và mức độ hỗ trợ quốc tế đối với cuộc cách mạng.", "Đối chiếu để đánh giá mức độ khẳng định trong nhận định."], "combines": ["Hoạt động đối ngoại trước khi giành chính quyền", "Nguồn lực thắng lợi cách mạng", "Phân biệt ý định và kết quả"], "cue_use": "given as a cue", "evidence_uncertainty": null}, {"ref": "acc23c4ca4f8|P2|4|a", "part": "P2", "idx": 4, "sub": "a", "topic": "Hoạt động đối ngoại trong kháng chiến chống Mỹ: vai trò của mặt trận ngoại giao", "grade": 12, "given": "Một trích đoạn mô tả việc tranh thủ lực lượng quốc tế và tác động đối với tương quan lực lượng.", "task": "Đánh giá nhận định khái quát về vai trò của ngoại giao trong kháng chiến.", "reasoning": ["Nhận diện mục đích và tác động của hoạt động đối ngoại trong tư liệu.", "Liên hệ với khái niệm mặt trận ngoại giao để kiểm tra nhận định."], "combines": ["Đọc hiểu tư liệu lịch sử", "Vai trò ngoại giao trong kháng chiến"], "cue_use": "given as a cue", "evidence_uncertainty": null}, {"ref": "acc23c4ca4f8|P2|4|b", "part": "P2", "idx": 4, "sub": "b", "topic": "Hoạt động đối ngoại trong kháng chiến: nguyên tắc bảo đảm độc lập dân tộc", "grade": 12, "given": "Một trích đoạn tổng kết hoạt động ngoại giao qua các cuộc kháng chiến và nhận định về nguyên tắc xuyên suốt.", "task": "Đánh giá nguyên tắc khái quát rút ra từ thực tiễn đối ngoại.", "reasoning": ["Xác định mục tiêu chung của các hoạt động ngoại giao được nêu.", "Phân biệt mục tiêu lâu dài với hình thức và đối tác có thể thay đổi.", "Đối chiếu nguyên tắc được nhận định với mục tiêu xuyên suốt."], "combines": ["Đối ngoại trong các cuộc kháng chiến", "Mục tiêu độc lập dân tộc", "Khái quát bài học lịch sử"], "cue_use": "given as a cue", "evidence_uncertainty": null}, {"ref": "acc23c4ca4f8|P2|4|c", "part": "P2", "idx": 4, "sub": "c", "topic": "Hoạt động đối ngoại trong kháng chiến chống thực dân Pháp: quan hệ giữa thắng lợi quân sự và đàm phán", "grade": 12, "given": "Một trích đoạn về phối hợp quân sự, ngoại giao và nhận định xác định chiều tác động giữa đàm phán với thắng lợi chiến trường.", "task": "Kiểm tra chiều quan hệ nhân quả giữa thắng lợi quân sự và kết quả ngoại giao.", "reasoning": ["Xác định trình tự và quan hệ phối hợp được tư liệu mô tả.", "Nhớ vai trò của thắng lợi chiến trường đối với vị thế đàm phán.", "Đối chiếu để phát hiện sự đảo chiều nguyên nhân và kết quả."], "combines": ["Thắng lợi quân sự", "Đấu tranh ngoại giao", "Quan hệ nhân quả lịch sử"], "cue_use": "needed in reasoning", "evidence_uncertainty": null}, {"ref": "acc23c4ca4f8|P2|4|d", "part": "P2", "idx": 4, "sub": "d", "topic": "Hoạt động đối ngoại trong kháng chiến chống thực dân Pháp: thiết lập quan hệ ngoại giao và phá thế bao vây", "grade": 12, "given": "Một trích đoạn trực tiếp nêu bước mở rộng quan hệ ngoại giao và một nhận định diễn đạt lại thông tin đó.", "task": "Xác nhận nhận định có phù hợp với thông tin trực tiếp trong tư liệu hay không.", "reasoning": ["Tìm thông tin về thời điểm và phạm vi thiết lập quan hệ.", "Đối chiếu với các thành phần tương ứng của nhận định."], "combines": ["Đọc hiểu tư liệu lịch sử"], "cue_use": "given as a cue", "evidence_uncertainty": null}]}
