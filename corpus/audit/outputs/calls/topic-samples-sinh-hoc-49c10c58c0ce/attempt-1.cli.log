      ],
      "solution": "Chọn B. Trong pha sáng, NADP⁺ nhận electron và H⁺, tạo NADPH. NADPH cung cấp khả năng khử cho quá trình tổng hợp chất hữu cơ trong chu trình Calvin.",
      "distractors": [
        {
          "label": "A",
          "sub": null,
          "mistake": "Nhầm dạng khử của NADP⁺ với dạng khử của NAD⁺.",
