tatus": "Chỉ là quan sát trong một đề.", "refs": ["11d88d9a96ad|P1|1|None"]}, {"part_kind": "multiple_choice", "topic": "Thể tích lăng trụ", "grade": 11, "construction": "Cho loại đáy, kích thước đáy và chiều cao suy ra từ tính đứng; tính diện tích đáy rồi nhân chiều cao.", "wrong_options": "Sai công thức diện tích đáy, sai hệ số hoặc làm mất hệ số khi nhân căn thức.", "difficulty_source": "Ghép đúng công thức diện tích với công thức thể tích.", "discrimination": "low", "typical_steps": 2, "evidence_status": "Chỉ là quan sát trong một đề.", "refs": ["11d88d9a96ad|P1|2|None"]}, {"part_kind": "multiple_choice", "topic": "Phương trình mặt cầu từ tâm và bán kính", "grade": 12, "construction": "Cho tâm và bán kính; lập tổng bình phương các hiệu tọa độ bằng bình phương bán kính rồi đối chiếu phương trình.", "wrong_options": "Dùng bán kính thay bình phương bán kính, bình phương thừa hoặc đổi sai dấu tọa độ tâm.", "difficulty_source": "Giữ đúng dấu trong dạng chuẩn và đúng ý nghĩa vế phải.", "discrimination": "low", "typical_steps": 2, "evidence_status": "Chỉ là quan sát trong một đề.", "refs": ["11d88d9a96ad|P1|7|None"]}, {"part_kind": "true_false", "topic": "Đọc tâm, bán kính và khoảng cách giữa các tâm", "grade": 12, "construction": "Cho phương trình mặt cầu ở dạng chuẩn hoặc khai triển; đọc tâm hoặc hoàn thành bình phương, suy ra bán kính và dùng tọa độ tâm để kiểm tra thông tin hình học được nêu.", "wrong_options": null, "difficulty_source": "Hoàn thành bình phương đúng và tiếp tục dùng đúng tọa độ đã suy ra.", "discrimination": "low", "typical_steps": 3, "evidence_status": "Chỉ là quan sát trong một đề; các yêu cầu liên quan cùng dùng kết quả đọc tâm.", "refs": ["de5833d227dd|P2|2|a", "de5833d227dd|P2|2|c"]}, {"part_kind": "true_false", "topic": "Tiếp tuyến của đường tròn giao các mặt cầu", "grade": 12, "construction": "Cho đường tròn giao và họ mặt phẳng; tìm mặt phẳng chứa đường tròn, xác định tâm và bán kính, xét giao tuyến với mặt phẳng biến thiên rồi chuyển tiếp 