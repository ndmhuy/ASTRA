n duy trì ở cây trồng nhưng cần hạn chế phát tán vật chất di truyền qua sinh sản đực.","task":"Chọn vị trí hoặc biện pháp can thiệp di truyền đáp ứng yêu cầu.","reasoning":["Xác định con đường phát tán cần ngăn.","Liên hệ con đường đó với kiểu di truyền của các hệ gene trong tế bào.","Chọn nơi đưa gene phù hợp với mục tiêu biểu hiện và hạn chế truyền qua giao tử đực."],"steps":3,"combines":["Công nghệ gene","Di truyền ngoài nhân","Sinh sản ở thực vật"],"wrong_options":"Nhiễu gồm can thiệp vào hệ gene vẫn truyền qua giao tử đực, tác động không liên quan và biện pháp phá hủy cấu trúc thiết yếu.","wrong_option_details":[{"label":"B","identifiable_error":true,"mistake_kind":"Bỏ qua đường truyền gene","reason":"Chỉ xét khả năng biểu hiện tính trạng mà không xét sự truyền gene qua giao tử đực."},{"label":"C","identifiable_error":true,"mistake_kind":"Đánh đồng các dạng di truyền tế bào chất","reason":"Cho rằng biến đổi ở một bào quan tự động ngăn truyền một gene ở vị trí khác."},{"label":"D","identifiable_error":false,"mistake_kind":"Biện pháp không bảo đảm khả năng sống","reason":"Loại bỏ toàn bộ thành phần tế bào thiết yếu không phải cách khả thi để duy trì chức năng của giao tử."}],"cue_use":"none","difficulty_source":"Nối vị trí gene với con đường phát tán qua sinh sản","discrimination":"medium","evidence_uncertainty":"Đáp án dựa trên mô hình di truyền bào quan chủ yếu theo dòng mẹ; yêu cầu ngăn truyền tuyệt đối mạnh hơn tính phổ quát của cơ chế này ở thực vật.","optional_path":null},{"part":"P1","idx":5,"sub":null,"topic":"Đột biến nhiễm sắc thể: biến đổi số lượng gene trên một nhiễm sắc thể","grade":12,"given":"Các dạng biến đổi cấu trúc hoặc số lượng nhiễm sắc thể.","task":"Xác định dạng có thể làm tăng số bản sao gene trong một nhiễm sắc thể.","reasoning":["Xác định đơn vị đang được hỏi là một nhiễm sắc thể.","Đối chiếu tác động của từng dạng đột biến lên đơn vị đó."],"steps":2,"combines":["Đột biến cấu trúc nhiễm sắc thể","Đột biến số lượng nhiễm sắc thể"],"wrong_