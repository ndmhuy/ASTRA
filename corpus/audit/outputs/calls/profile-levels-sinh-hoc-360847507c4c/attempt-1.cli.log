{"assignments":[{"ref":"b68b84764a9b|P1|1|None","level":"NB","confidence":"medium","justification":"Có thể trả lời bằng cách truy hồi một quan hệ cấu tạo và chức năng đã học, chưa thấy yêu cầu suy luận vượt khỏi một đơn vị kiến thức.","decisive_demand":"Nhận ra quan hệ trực tiếp đã học.","uncertainty":"Mô tả trừu tượng chưa xác định rõ việc nhận diện trực tiếp hay diễn giải đường vận chuyển là bắt buộc."},{"ref":"b68b84764a9b|P1|2|None","level":"NB","confidence":"high","justification":"Yêu cầu tối thiểu là nhận diện một loại bằng chứng từ đặc trưng định nghĩa của nó.","decisive_demand":"Ghép đặc trưng với khái niệm đã học.","uncertainty":null},{"ref":"b68b84764a9b|P1|3|None","level":"NB","confidence":"high","justification":"Thứ tự cần chọn có thể được truy hồi như một trình tự kiến thức đã học.","decisive_demand":"Nhớ và nhận ra trình tự chuẩn.","uncertainty":null},{"ref":"b68b84764a9b|P1|4|None","level":"NB","confidence":"medium","justification":"Mô tả cho thấy việc đối chiếu trực tiếp một đặc trưng với nhóm phân loại đã học.","decisive_demand":"Nhận diện nhóm từ dấu hiệu định nghĩa.","uncertainty":"Chưa rõ dấu hiệu được trình bày trực tiếp hay phải diễn giải trước khi phân loại."},{"ref":"b68b84764a9b|P1|5|None","level":"NB","confidence":"high","justification":"Chỉ cần truy hồi sự gắn kết quen thuộc giữa đối tượng và nhóm phân loại tương ứng.","decisive_demand":"Nhớ một thuộc tính điển hình.","uncertainty":null},{"ref":"b68b84764a9b|P1|6|None","level":"NB","confidence":"high","justification":"Mô tả chức năng cho phép nhận ra trực tiếp khái niệm đã học; không bắt buộc giải thích cơ chế.","decisive_demand":"Gọi tên khái niệm từ định nghĩa.","uncertainty":null},{"ref":"b68b84764a9b|P1|7|None","level":"TH","confidence":"medium","justification":"Theo mô tả, học sinh diễn giải một cơ chế quen thuộc và kiểm tra chiều tác động trong biểu diễn đã cho.","decisive_demand":"Diễn giải quan hệ chức năng trong cơ chế chuẩn.","uncertainty":"Chưa đối chiếu biểu diễn gốc và các lựa chọn để xác định liệu có lối nhận diện trực tiếp đơn giản hơn."},{"ref":"b68b84764a9b|P1|8|None","level":"TH","confidence":"high","justification":"Yêu cầu được đáp ứng bằng quy trình suy luận di truyền cơ bản, quen thuộc.","decisive_demand":"Áp dụng quan hệ đã học để kiểm tra một phép tổ hợp chuẩn.","uncertainty":null},{"ref":"b68b84764a9b|P1|9|None","level":"TH","confidence":"medium","justification":"Mô tả yêu cầu phân biệt tác động của biện pháp theo nguyên lí đã học.","decisive_demand":"Phân biệt tác động phù hợp với một mục tiêu.","uncertainty":"Không có các lựa chọn nên chưa loại trừ khả năng chỉ cần nhận ra một biện pháp đã được học trực tiếp."},{"ref":"b68b84764a9b|P1|10|None","level":"VD","confidence":"medium","justification":"Mô tả đòi hỏi kết nối cơ chế biểu hiện với các trạng thái khác nhau rồi suy ngược điều kiện ban đầu bằng chuỗi loại trừ phụ thuộc.","decisive_demand":"Kết hợp nhiều ràng buộc cơ chế để suy ngược khả năng phù hợp.","uncertainty":"Chưa có hình gốc và các lựa chọn để kiểm tra đầy đủ các ràng buộc hoặc khả năng có lối giải ngắn hơn."},{"ref":"b68b84764a9b|P1|11|None","level":"NB","confidence":"high","justification":"Dấu hiệu được mô tả tương ứng trực tiếp với định nghĩa của một loại quan hệ đã học.","decisive_demand":"Nhận ra khái niệm từ dấu hiệu đặc trưng.","uncertainty":null},{"ref":"b68b84764a9b|P1|12|None","level":"TH","confidence":"medium","justification":"Đọc xu hướng và giải thích bằng một cơ chế chuẩn thuộc yêu cầu diễn giải kiến thức quen thuộc.","decisive_demand":"Liên hệ xu hướng dữ liệu với cơ chế đã học.","uncertainty":"Thiếu biểu diễn gốc nên chưa xác nhận được chi tiết dữ liệu ảnh hưởng đến mức suy luận tối thiểu."},{"ref":"b68b84764a9b|P1|13|None","level":"TH","confidence":"medium","justification":"Các thao tác được mô tả có thể thực hiện theo quy trình chuẩn xử lí trình tự; số thao tác chưa chứng minh cần xây dựng lập luận mới.","decisive_demand":"Thực hiện quy trình quen thuộc trên một biểu diễn trình tự.","uncertainty":"Cách căn mốc và các lựa chọn chưa được xác nhận; có thể ảnh hưởng đến việc phân biệt thao tác thường quy với suy luận tích hợp."},{"ref":"b68b84764a9b|P1|14|None","level":null,"confidence":"insufficient","justification":"Phần dữ liệu quyết định việc so sánh và suy luận đã bị lược bỏ nên chưa xác lập được công việc nhận thức tối thiểu.","decisive_demand":"Chưa xác định được từ bằng chứng hiện có.","uncertainty":"Cần diễn biến các đường dữ liệu, quan hệ giữa các đại lượng và nội dung các nhận định cần đánh giá."},{"ref":"b68b84764a9b|P1|15|None","level":"TH","confidence":"high","justification":"Liệt kê và tổ hợp các khả năng theo quy luật đã học là một quy trình giải bài tập chuẩn.","decisive_demand":"Thực hiện phép tổ hợp theo quy tắc quen thuộc.","uncertainty":null},{"ref":"b68b84764a9b|P1|16|None","level":"NB","confidence":"high","justification":"Yêu cầu chỉ là truy hồi vị trí của một quá trình đã học.","decisive_demand":"Nhớ mối liên hệ giữa quá trình và vị trí.","uncertainty":null},{"ref":"b68b84764a9b|P1|17|None","level":"VD","confidence":"medium","justification":"Mô tả yêu cầu nối cấu trúc thí nghiệm, các kết quả quan sát và điều kiện giả định để đánh giá một suy luận chức năng.","decisive_demand":"Xây dựng lập luận từ can thiệp và nhiều chỉ tiêu kết quả.","uncertainty":"Biểu đồ và các lựa chọn bị lược bỏ nên chưa loại trừ được khả năng suy luận chỉ dựa trên một đối chiếu trực tiếp."},{"ref":"b68b84764a9b|P1|18|None","level":"NB","confidence":"medium","justification":"Mức tối thiểu được mô tả là truy hồi quan hệ đặc hiệu đã học giữa một nhóm tác nhân và đối tượng tác động.","decisive_demand":"Nhận ra quan hệ đặc hiệu quen thuộc.","uncertainty":"Chưa rõ cách gọi nhóm đã cung cấp trực tiếp dấu hiệu nhận diện hay yêu cầu diễn giải chức năng."},{"ref":"b68b84764a9b|P2|1|a","level":"TH","confidence":"medium","justification":"Có thể đánh giá bằng cách giải thích một quan hệ chức năng quen thuộc từ thông tin bằng lời.","decisive_demand":"Giải thích mối liên hệ giữa chức năng và kết quả tích lũy.","uncertainty":"Thiếu nguyên văn nhận định nên chưa xác định đầy đủ phạm vi khẳng định; mô tả cho biết phần này không phụ thuộc đường dữ liệu bị thiếu."},{"ref":"b68b84764a9b|P2|1|b","level":null,"confidence":"insufficient","justification":"Không có phần biểu diễn cần thiết để xác định việc so sánh là đọc trực tiếp hay cần xử lí thêm.","decisive_demand":"Chưa xác định được thao tác đọc và so sánh tối thiểu.","uncertainty":"Cần diễn biến các đường và dấu hiệu xác định thời điểm bắt đầu biến đổi."},{"ref":"b68b84764a9b|P2|1|c","level":null,"confidence":"insufficient","justification":"Suy luận phụ thuộc vào quan hệ giữa các biến trong một khoảng quan sát nhưng quan hệ đó chưa được cung cấp.","decisive_demand":"Chưa xác định được mức suy luận từ dữ liệu.","uncertainty":"Cần diễn biến đồng thời của các đại lượng và phạm vi chính xác của nhận định."},{"ref":"b68b84764a9b|P2|1|d","level":null,"confidence":"insufficient","justification":"Chưa thể biết việc đánh giá chỉ cần nhận ra giới hạn bằng chứng hay phải xây dựng một chuỗi suy luận cơ chế.","decisive_demand":"Chưa xác định được yêu cầu đánh giá dự báo tối thiểu.","uncertainty":"Cần dữ liệu diễn biến, nội dung chính xác của giả định và mức độ khẳng định của nhận định."},{"ref":"b68b84764a9b|P2|2|a","level":"TH","confidence":"medium","justification":"Yêu cầu tối thiểu là diễn giải một quan hệ trong biểu diễn cho sẵn và áp dụng quy tắc phân loại quen thuộc.","decisive_demand":"Đọc quan hệ và xác định vị trí theo quy tắc chuẩn.","uncertainty":"Chỉ có mô tả bằng lời, dù các liên kết cần thiết được cho là đã có."},{"ref":"b68b84764a9b|P2|2|b","level":"TH","confidence":"medium","justification":"Có thể đánh giá bằng cách phân biệt hai khái niệm và đối chiếu loại bằng chứng với tiêu chí định nghĩa, không nhất thiết tái dựng toàn bộ tác động dây chuyền.","decisive_demand":"Phân biệt tiêu chí khái niệm và giới hạn bằng chứng.","uncertainty":"Thiếu nhận định đầy đủ nên chưa xác nhận liệu đối chiếu định nghĩa đã đủ để trả lời."},{"ref":"b68b84764a9b|P2|2|c","level":"TH","confidence":"high","justification":"Đọc đúng dữ liệu rồi thực hiện phép tính chênh lệch là thao tác thường quy.","decisive_demand":"Đọc bảng và tính theo quan hệ cho sẵn.","uncertainty":null},{"ref":"b68b84764a9b|P2|2|d","level":"TH","confidence":"medium","justification":"Mô tả có thể được giải thích bằng một cơ chế hệ quả quen thuộc; việc nhắc nhiều quá trình chưa đủ chứng minh yêu cầu lập luận vượt bài tập chuẩn.","decisive_demand":"Giải thích chiều biến đổi bằng cơ chế đã học.","uncertainty":"Thiếu điều kiện thời gian và phạm vi dự báo; chưa rõ cần cân nhắc các tác động cạnh tranh hay chỉ nhận diện cơ chế quen thuộc."},{"ref":"b68b84764a9b|P2|3|a","level":"TH","confidence":"high","justification":"Nhận ra mẫu quan hệ gia đình và áp dụng quy tắc suy luận cơ bản là một dạng bài tập chuẩn.","decisive_demand":"Áp dụng quy luật quen thuộc để suy ra quan hệ chi phối.","uncertainty":null},{"ref":"b68b84764a9b|P2|3|b","level":"VD","confidence":"medium","justification":"Theo mô tả, phải suy ra cơ chế từ các ràng buộc gia đình trước khi dùng cơ chế đó đánh giá khả năng ở một quan hệ tiếp theo.","decisive_demand":"Nối suy luận xác lập cơ chế với kiểm tra điều kiện truyền đạt.","uncertainty":"Bảng và nhận định đầy đủ bị lược bỏ nên chưa loại trừ một dấu hiệu đơn lẻ cho phép trả lời bằng quy tắc trực tiếp."},{"ref":"b68b84764a9b|P2|3|c","level":"VD","confidence":"high","justification":"Phải phối hợp các cơ chế, duy trì tập khả năng và loại trừ bằng ràng buộc liên quan trước khi đánh giá tính duy nhất.","decisive_demand":"Tổng hợp ràng buộc để xác định mức chắc chắn của nhiều trạng thái.","uncertainty":null},{"ref":"b68b84764a9b|P2|3|d","level":"VD","confidence":"high","justification":"Yêu cầu kết nối suy luận trạng thái chưa biết, trọng số có điều kiện và các quy luật truyền đạt thành một chuỗi phụ thuộc.","decisive_demand":"Xây dựng và kết hợp các khả năng có điều kiện.","uncertainty":null},{"ref":"b68b84764a9b|P2|4|a","level":"TH","confidence":"medium","justification":"Phân biệt các giai đoạn của một quá trình rồi diễn giải hệ quả trong biểu diễn đã cho thuộc thông hiểu.","decisive_demand":"Phân biệt trạng thái trước và sau một bước xử lí.","uncertainty":"Biểu diễn chỉ được tóm tắt bằng lời; chưa kiểm tra độc lập các chi tiết cấu trúc."},{"ref":"b68b84764a9b|P2|4|b","level":"TH","confidence":"medium","justification":"Đối chiếu thành phần trong biểu diễn và suy ra sự giống khác là thao tác diễn giải trực tiếp.","decisive_demand":"So sánh cấu trúc từ thông tin cho sẵn.","uncertainty":"Phân loại dựa trên mô tả rằng thành phần cần so sánh đã được cung cấp đầy đủ."},{"ref":"b68b84764a9b|P2|4|c","level":"TH","confidence":"medium","justification":"Các bước xác định phạm vi xử lí và tính độ dài có thể được thực hiện theo quy trình chuẩn; nhiều phép tính không tự tạo mức vận dụng.","decisive_demand":"Thực hiện quy trình xác định phạm vi và tính toán quen thuộc.","uncertainty":"Chưa có biểu diễn gốc để xác định liệu việc thiết lập phạm vi đòi hỏi suy luận thêm ngoài quy trình chuẩn."},{"ref":"b68b84764a9b|P2|4|d","level":"TH","confidence":"medium","justification":"Áp dụng trực tiếp quy tắc về điểm dừng để phân biệt phần có và không ảnh hưởng là một suy luận quen thuộc.","decisive_demand":"Định vị biến đổi theo một ranh giới chức năng đã xác định.","uncertainty":"Thứ tự cần thiết chỉ được cung cấp qua mô tả bằng lời."},{"ref":"b68b84764a9b|P3|1|None","level":"TH","confidence":"medium","justification":"Sắp xếp theo quan hệ phụ thuộc của quy trình thực hành quen thuộc có thể thực hiện bằng kiến thức chuẩn, chưa đòi hỏi thiết kế mới.","decisive_demand":"Tổ chức thao tác theo điều kiện thực hiện của quy trình quen thuộc.","uncertainty":"Nếu chỉ cần nhớ nguyên vẹn quy trình đã học thì mức nhận biết cũng có thể đủ; mô tả nhấn mạnh việc xét quan hệ phụ thuộc."},{"ref":"b68b84764a9b|P3|2|None","level":null,"confidence":"insufficient","justification":"Phần biểu diễn quyết định phép ghép bị thiếu nên chưa xác định được mức diễn giải và suy luận thực sự cần thiết.","decisive_demand":"Chưa xác định được công việc ghép đặc điểm với dữ liệu.","uncertainty":"Cần hình dạng, diễn biến và quan hệ thời gian của các đường biểu diễn."},{"ref":"b68b84764a9b|P3|3|None","level":"VD","confidence":"medium","justification":"Phải thiết lập quan hệ giữa cơ chế và biểu hiện, suy ngược các khả năng ban đầu rồi kết hợp xác suất trong phạm vi thích hợp.","decisive_demand":"Xây dựng ánh xạ cơ chế và suy ngược các khả năng trước khi tính.","uncertainty":"Biểu diễn chỉ được mô tả bằng lời; phạm vi của tỉ lệ cần được xác nhận từ yêu cầu đầy đủ."},{"ref":"b68b84764a9b|P3|4|None","level":"TH","confidence":"high","justification":"Đổi đại lượng, áp dụng tỉ lệ và tính chênh lệch đều thuộc quy trình tính toán quen thuộc.","decisive_demand":"Thực hiện chuỗi phép tính chuẩn từ các quan hệ đã biết.","uncertainty":null},{"ref":"b68b84764a9b|P3|5|None","level":"TH","confidence":"high","justification":"Đếm có trọng số và chuẩn hóa theo tổng là cách thực hiện trực tiếp một quy trình đã học.","decisive_demand":"Áp dụng quy tắc tính tần số từ bảng thành phần.","uncertainty":null},{"ref":"b68b84764a9b|P3|6|None","level":"TH","confidence":"medium","justification":"Mô tả cho phép thực hiện trực tiếp quy trình ước tính chuẩn từ dữ liệu lấy mẫu, không yêu cầu tự xây dựng phương pháp.","decisive_demand":"Tính đại lượng trung bình và ngoại suy theo quy trình cho sẵn.","uncertainty":"Dựa trên mô tả rằng dữ liệu tính toán đã đủ; chưa có yêu cầu đánh giá tính đại diện để xác lập một đòi hỏi suy luận cao hơn."}]}
