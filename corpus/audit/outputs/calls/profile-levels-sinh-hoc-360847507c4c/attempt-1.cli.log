ask": "Kiểm tra khả năng sinh con gái mắc bệnh của một cặp bố mẹ.", "reasoning": "Suy ra gene bệnh là gene lặn liên kết giới tính bằng các tổ hợp gia đình; xác định allele bố truyền cho con gái; xét điều kiện bắt buộc để con gái biểu hiện bệnh.", "combines": ["Di truyền liên kết giới tính", "Suy luận kiểu gene", "Xác suất di truyền"], "cue_use": "none", "evidence_uncertainty": null}, {"ref": "b68b84764a9b|P2|3|c", "part": "P2", "idx": 3, "sub": "c", "topic": "Di truyền học người: xác định mức độ chắc chắn của kiểu gene", "grade": 12, "given": "Bảng các kiểu hình gia đình cho các tính trạng có cơ chế di truyền khác nhau.", "task": "Kiểm tra số người có thể xác định đầy đủ kiểu gene ở tất cả locus được xét.", "reasoning": "Suy ra cơ chế di truyền từng tính trạng; lập các khả năng kiểu gene của từng người; dùng quan hệ bố mẹ con để loại khả năng; chỉ đếm người có kiểu gene duy nhất ở mọi locus.", "combines": ["Di truyền trội lặn", "Di truyền liên kết giới tính", "Suy luận ràng buộc gia đình"], "cue_use": "given as a cue", "evidence_uncertainty": null}, {"ref": "b68b84764a9b|P2|3|d", "part": "P2", "idx": 3, "sub": "d", "topic": "Di truyền học người: xác suất con mang tổ hợp tính trạng", "grade": 12, "given": "Thông tin gia đình của các cá thể dự kiến kết đôi, trong đó một phần kiểu gene chỉ biết qua xác suất có điều kiện.", "task": "Kiểm tra xác suất sinh con thuộc giới và tổ hợp kiểu hình được yêu cầu.", "reasoning": "Suy ra kiểu gene chắc chắn và các khả năng còn lại của bố mẹ; tính trọng số kiểu gene dựa trên kiểu hình đã biết; tính xác suất ở từng locus; kết hợp với xác suất giới tính và điều kiện độc lập.", "combines": ["Xác suất có điều kiện", "Di truyền liên kết giới tính", "Di truyền trên nhiễm sắc thể thường", "Quy tắc nhân xác suất"], "cue_use": "given as a cue", "evidence_uncertainty": null}, {"ref": "b68b84764a9b|P2|4|a", "part": "P2", "idx": 4, "sub": "a", "topic": "Gene và quá trình truyền đạt thông tin di truyền: tiền mRNA và cắt nối", "grade": 12, "given": "Mô tả bằng lời cấu trúc gene, tiền mRNA và các sản phẩm cắt nối khác nhau theo giới.", "task": "So sánh độ dài tiền mRNA giữa các giới.", "reasoning": "Phân biệt tiền mRNA với mRNA trưởng thành; xác định giai đoạn bắt đầu có khác biệt; so sánh cấu trúc trước cắt nối.", "combines": ["Phiên mã", "Xử lí RNA"], "cue_use": "none", "evidence_uncertainty": "Chỉ có mô tả sơ đồ; quan hệ giữa các bản RNA được nêu rõ bằng lời."}, {"ref": "b68b84764a9b|P2|4|b", "part": "P2", "idx": 4, "sub": "b", "topic": "Gene và quá trình truyền đạt thông tin di truyền: cắt nối thay thế", "grade": 12, "given": "Mô tả bằng lời các tổ hợp exon trong mRNA trưởng thành của các giới.", "task": "Đánh giá sự giống hoặc khác nhau về trình tự mRNA trưởng thành.", "reasoning": "Đối chiếu thành phần exon được giữ lại; suy ra hệ quả đối với trình tự phân tử RNA.", "combines": ["Cấu trúc gene phân mảnh", "Cắt nối thay thế"], "cue_use": "none", "evidence_uncertainty": "Hình chỉ được mô tả bằng lời; đủ thông tin để so sánh thành phần exon."}, {"ref": "b68b84764a9b|P2|4|c", "part": "P2", "idx": 4, "sub": "c", "topic": "Gene và quá trình truyền đạt thông tin di truyền: chiều dài sản phẩm dịch mã sau cắt nối", "grade": 12, "given": "Mô tả bằng lời sơ đồ exon có độ dài và vị trí tín hiệu mở đầu, kết thúc, kèm quy ước loại amino acid mở đầu.", "task": "Kiểm tra độ chênh lệch chiều dài polypeptide hoàn chỉnh giữa các giới.", "reasoning": "Xác định tổ hợp exon của mỗi mRNA; tìm tín hiệu kết thúc đầu tiên trong khung đọc; tính độ dài vùng được dịch; loại bộ ba kết thúc và amino acid mở đầu rồi so sánh.", "combines": ["Cắt nối thay thế", "Khung đọc", "Kết thúc dịch mã", "Tính độ dài polypeptide"], "cue_use": "given as a cue", "evidence_uncertainty": "Chỉ có mô tả sơ đồ; các độ dài và vị trí tín hiệu cần thiết đã được chép lại."}, {"ref": "b68b84764a9b|P2|4|d", "part": "P2", "idx": 4, "sub": "d", "topic": "Đột biến gene: tác động phụ thuộc vị trí so với điểm kết thúc dịch mã", "grade": 12, "given": "Mô tả bằng lời mRNA có nhiều tín hiệu kết thúc và một biến đổi tại tín hiệu nằm phía sau.", "task": "Đánh giá liệu biến đổi đó có làm thay đổi chiều dài polypeptide ở giới được xét.", "reasoning": "Xác định tín hiệu kết thúc đang được sử dụng; định vị đột biến so với điểm dừng đó; kiểm tra ribosome có dịch tới vị trí bị đổi hay không.", "combines": ["Đột biến thay thế nucleotide", "Kết thúc dịch mã", "Cắt nối thay thế"], "cue_use": "none", "evidence_uncertainty": "Hình chỉ được mô tả bằng lời; thứ tự các tín hiệu kết thúc được cung cấp."}, {"ref": "b68b84764a9b|P3|1|None", "part": "P3", "idx": 1, "sub": null, "topic": "Thực hành: thí nghiệm co nguyên sinh ở tế bào thực vật", "grade": 10, "given": "Các thao tác chuẩn bị tiêu bản, quan sát và thay môi trường ngoài tế bào được trình bày lộn thứ tự.", "task": "Sắp xếp thao tác thành quy trình thực hành hợp lí.", "reasoning": "Xác định quan hệ phụ thuộc khi chuẩn bị tiêu bản; đặt quan sát ban đầu trước can thiệp; đặt bước thay môi trường sau khi tiêu bản đã sẵn sàng.", "combines": ["Kĩ thuật làm tiêu bản", "Sử dụng kính hiển vi", "Thẩm thấu và co nguyên sinh"], "cue_use": "given as a cue", "evidence_uncertainty": null}, {"ref": "b68b84764a9b|P3|2|None", "part": "P3", "idx": 2, "sub": null, "topic": "Diễn thế sinh thái: thay thế các nhóm thực vật theo điều kiện ánh sáng", "grade": 12, "given": "Chỉ có mô tả trục, chú giải và danh sách nhóm thực vật của đồ thị diễn thế; hình dạng các đường theo thời gian không được chép lại.", "task": "Ghép một nhóm thực vật có đặc điểm sinh thái xác định với đường biểu diễn.", "reasoning": "Suy ra giai đoạn phát triển phù hợp từ khả năng sử dụng ánh sáng và dạng sống; tìm đường có thời điểm xuất hiện và suy giảm tương ứng; đọc mã đường từ chú giải.", "combines": ["Diễn thế sinh thái", "Đặc điểm sinh thái thực vật", "Đọc đồ thị"], "cue_use": "given as a cue", "evidence_uncertainty": "Thiếu hình dạng các đường nên không thể tái lập phép ghép hoặc đánh giá mức phân hóa. Mã trong khóa chỉ xác định kết quả, không bổ sung diễn biến còn thiếu."}, {"ref": "b68b84764a9b|P3|3|None", "part": "P3", "idx": 3, "sub": null, "topic": "Mở rộng học thuyết Mendel: tương tác gene qua các sản phẩm sắc tố", "grade": 12, "given": "Mô tả bằng lời sơ đồ các nhánh tạo sắc tố, giả thiết phân li độc lập và phân bố kiểu hình đời con của một phép lai.", "task": "Tính tỉ lệ đời con vừa có kiểu hình phối hợp vừa dị hợp tại các locus được xét.", "reasoning": "Lập ánh xạ giữa tổ hợp allele và kiểu hình từ sơ đồ; phân tách phân bố kiểu hình thành phân li ở từng locus; suy ra các dạng phép lai phù hợp; nhân xác suất tạo dị hợp ở từng locus và xác định đúng mẫu số của tỉ lệ.", "combines": ["Tương tác gene", "Phân li độc lập", "Suy ngược kiểu gene bố mẹ", "Xác suất di truyền"], "cue_use": "given as a cue", "evidence_uncertainty": "Sơ đồ chỉ được mô tả bằng lời. Khóa tương ứng với tỉ lệ trên toàn bộ đời con; cần phân biệt với tỉ lệ có điều kiện chỉ trong nhóm mang kiểu hình phối hợp."}, {"ref": "b68b84764a9b|P3|4|None", "part": "P3", "idx": 4, "sub": null, "topic": "Tuần hoàn ở động vật: nhịp tim và thời gian các pha của chu kì tim", "grade": 11, "given": "Tần số tim của các đối tượng và tỉ lệ thời gian giữa các pha được giả định giống nhau.", "task": "Tính chênh lệch thời gian của một pha trong mỗi chu kì.", "reasoning": "Đổi tần số tim thành thời gian một chu kì; xác định phần thời gian của pha từ tỉ lệ; tính thời gian pha ở từng đối tượng; lấy chênh lệch và làm tròn theo yêu cầu.", "combines": ["Chu kì tim", "Quan hệ giữa tần số và chu kì", "Tính tỉ lệ"], "cue_use": "given as a cue", "evidence_uncertainty": null}, {"ref": "b68b84764a9b|P3|5|None", "part": "P3", "idx": 5, "sub": null, "topic": "Di truyền học quần thể: tính tần số allele từ thành phần kiểu gene", "grade": 12, "given": "Bảng số lượng cá thể thuộc các kiểu gene của một locus đa allele trên nhiễm sắc thể thường.", "task": "Tính tần số của một allele trong quần thể.", "reasoning": "Chọn các kiểu gene chứa allele cần xét; đếm bản sao allele với trọng số phù hợp cho đồng hợp và dị hợp; chia cho tổng bản sao của locus trong quần thể; làm tròn theo yêu cầu.", "combines": ["Kiểu gene đa allele", "Tần số allele", "Đọc bảng"], "cue_use": "given as a cue", "evidence_uncertainty": null}, {"ref": "b68b84764a9b|P3|6|None", "part": "P3", "idx": 6, "sub": null, "topic": "Thực hành: xác định kích thước quần thể bằng phương pháp ô mẫu", "grade": 12, "given": "Mô tả bằng lời sơ đồ bố trí ô mẫu cùng diện tích vùng khảo sát, kích thước ô và số cá thể đếm được.", "task": "Ước tính tổng số cá thể của quần thể từ các ô mẫu.", "reasoning": "Tổng hợp số cá thể và diện tích đã lấy mẫu; tính mật độ trung bình; nhân mật độ với diện tích toàn vùng; làm tròn theo yêu cầu.", "combines": ["Phương pháp ô mẫu", "Mật độ quần thể", "Ước tính kích thước quần thể"], "cue_use": "given as a cue", "evidence_uncertainty": "Sơ đồ chỉ được mô tả bằng lời; đủ số liệu để tính. Kết quả là ước tính theo mật độ mẫu, chưa có bằng chứng độc lập về mức đại diện của các ô."}]}
