ved": [{"claim": "Không thấy nhiệm vụ truy xuất niên đại, nhân vật hoặc sự kiện lịch sử hóa học trong các hàng được cung cấp. Phạm vi kết luận chỉ là tập dữ liệu này.", "refs": ["a381d0bc1996|P1|11|None", "7090ca87e657|P1|4|None", "7090ca87e657|P1|6|None"]}, {"claim": "Không thấy yêu cầu chép lại dữ kiện định lượng của bối cảnh như một đáp án thuần ghi nhớ trong các bài tính được mô tả; dữ kiện phải tham gia suy luận.", "refs": ["a381d0bc1996|P1|14|None", "a381d0bc1996|P3|2|None", "a381d0bc1996|P3|6|None", "7090ca87e657|P2|1|c"]}]}, "anti_patterns": [{"avoid": "Biến bối cảnh ứng dụng thành bài kiểm tra kiến thức chuyên biệt ngoài dữ kiện hóa học.", "basis": "Trong các hàng có thông tin ứng dụng mang tính gợi dẫn, chuỗi giải vẫn dựa vào cấu tạo, danh pháp hoặc quy tắc hóa học; không thấy phải biết thêm chi tiết của ứng dụng.", "refs": ["a381d0bc1996|P1|5|None", "a381d0bc1996|P1|8|None", "a381d0bc1996|P1|9|None", "7090ca87e657|P1|3|None"]}, {"avoid": "Tạo câu phân hóa bằng cách giấu điều kiện quyết định rồi buộc người làm đoán.", "basis": "Các hàng phân hóa cao được mô tả có môi trường, chất dư, bước xử lí hoặc thành phần quy trình làm căn cứ suy luận; không thấy cơ chế khó dựa vào thông tin thiết yếu bị bỏ trống.", "refs": ["a381d0bc1996|P1|13|None", "a381d0bc1996|P1|17|None", "a381d0bc1996|P2|4|a", "a381d0bc1996|P3|2|None"]}, {"avoid": "Thay nhiệm vụ có đầu ra xác định bằng yêu cầu bình luận tự do về bối cảnh.", "basis": "Ngay cả câu có sản xuất, ứng dụng hoặc hiệu quả vận hành vẫn yêu cầu đánh giá nhận định, tuyển chọn hoặc tính đại lượng cụ thể. Không thấy yêu cầu viết bài bình luận mở trong các hàng được cung cấp.", "refs": ["7090ca87e657|P2|1|a", "a381d0bc1996|P3|1|None", "a381d0bc1996|P3|2|None", "a381d0bc1996|P3|6|None"]}]}, {"evidence_limitations": "Các hàng thuộc nguồn đề cấp tỉnh do bên thứ ba cung cấp. Không đủ căn cứ để coi mọi cấu trúc dưới đây là mẫu lặp giữa các đề; evidence_scope phân biệt cấu trúc có đối chiếu liên đề với quan sát riêng một đề. Không suy rộng sang toàn bộ định dạng thi. Giữ grade là null khi chưa đủ căn cứ gán lớp chung. Với các hàng thiếu khóa đã đối sánh, không khẳng định nhận định đúng hay sai hoặc truy nguyên lỗi nhiễu.", "patterns": [{"part_kind": "multiple_choice", "topic": "Phân loại quá trình hóa học", "grade": null, "construction": "Cho phương trình hoặc mô tả chuyển hóa; yêu cầu gọi tên loại phản ứng hay phương pháp. Đọc biến đổi chất, môi trường và tác nhân rồi đối chiếu tiêu chí phân loại.", "wrong_options": "Đưa những nhãn quen thuộc phù hợp với một dấu hiệu bề mặt nhưng không phù hợp toàn bộ biến đổi và điều kiện.", "difficulty_source": "Phân biệt bản chất quá trình với dấu hiệu riêng lẻ.", "discrimination": "low", "typical_steps": 2, "evidence_scope": "Có đối chiếu giữa các đề.", "refs": ["02f028487a62|P1|1|None", "02f028487a62|P1|2|None", "0ccfacf4a5ac|P1|3|None"]}, {"part_kind": "multiple_choice", "topic": "Định nghĩa và thuật ngữ hóa học", "grade": null, "construction": "Cho định nghĩa, tiêu chí hoặc mô tả vai trò; yêu cầu chọn nhóm chức, tiểu phân hay thuật ngữ tương ứng. Tách điều kiện quyết định rồi ghép đúng đối tượng.", "wrong_options": "Đổi sang khái niệm gần nghĩa, đảo vai trò hoặc chỉ thỏa một phần định nghĩa.", "difficulty_source": "Giữ đúng tiêu chí chuyên môn thay vì liên tưởng theo tên gọi.", "discrimination": "low", "typical_steps": 2, "evidence_scope": "Có đối chiếu giữa các đề.", "refs": ["02f028487a62|P1|5|None", "0ccfacf4a5ac|P1|10|None", "0ccfacf4a5ac|P1|13|None"]}, {"part_kind": "multiple_choice", "topic": "Dấu hiệu nhận biết thực nghiệm", "grade": null, "construction": "Cho chất, thuốc thử hoặc hiện tượng; yêu cầu ghép với dấu hiệu đặc trưng hay đối tượng tương ứng. Huy động tính tan hoặc đặc điểm phản ứng để thiết lập liên hệ.", "wrong_options": "Đổi dấu hiệu sang chất gần gũi, chuyển hiện tượng của phép thử khác hoặc chọn thuốc thử không tạo dấu hiệu cần thiết.", "difficulty_source": "Nhớ đúng liên hệ giữa đối tượng và dấu hiệu trong điều kiện đã cho.", "discrimination": "low", "typical_steps": 2, "evidence_scope": "Có đối chiếu giữa các đề; chiều suy từ chất sang hiện tượng hoặc ngược lại có thể thay đổi.", "refs": ["02f028487a62|P1|3|None", "02f028487a62|P1|12|None", "0ccfacf4a5ac|P1|4|None"]}, {"part_kind": "multiple_choice", "topic": "Giải thích ứng dụng bằng tính chất", "grade": null, "construction": "Cho công dụng hoặc yêu cầu sử dụng; yêu cầu chọn chất hay tính chất đáp ứng trực tiếp. Xác định chức năng cần thực hiện rồi nối với cơ chế phù hợp.", "wrong_options": "Đưa chất cùng lĩnh vực sử dụng hoặc tính chất có lợi cho chế tạo nhưng không quyết định chức năng đang hỏi.", "difficulty_source": "Phân biệt tính chất liên quan trực tiếp với liên tưởng cùng bối cảnh.", "discrimination": "low", "typical_steps": 2, "evidence_scope": "Quan sát trong cùng một đề; chưa xác lập lặp giữa các đề.", "refs": ["0ccfacf4a5ac|P1|2|None", "0ccfacf4a5ac|P1|5|None"]}, {"part_kind": "multiple_choice", "topic": "Đọc cấu tạo hữu cơ để phân loại", "grade": null, "construction": "Cho công thức cấu tạo và các mô tả ứng viên; yêu cầu chọn mô tả đúng. Đọc vị trí liên kết, nhóm chức và khung carbon rồi kiểm tra đủ các điều kiện phân loại.", "wrong_options": "Giữ một nét cấu tạo đúng nhưng đổi tiêu chí phân loại, bỏ nhánh hoặc bỏ phần cấu tạo thiết yếu.", "difficulty_source": "Không suy phân loại từ một bộ phận riêng lẻ của phân tử.", "discrimination": "medium", "typical_steps": 3, "evidence_scope": "Có đối chiếu giữa các đề.", "refs": ["02f028487a62|P1|7|None", "0ccfacf4a5ac|P1|9|None"]}, {"part_kind": "multiple_choice", "topic": "Đọc công thức phức chất", "grade": null, "construction": "Cho công thức phức; yêu cầu suy thành phần hoặc đặc điểm phối trí. Tách trung tâm và phối tử, đọc chỉ số hoặc cân bằng điện tích rồi suy thuộc tính được hỏi.", "wrong_options": "Lẫn trung tâm với phối tử, số loại với số lượng, hoặc áp đặt điện tích và hình học quen thuộc mà không đọc công thức.", "difficulty_source": "Đọc đúng vai trò của từng kí hiệu trước khi áp dụng quan hệ cấu tạo.", "discrimination": "low", "typical_steps": 2, "evidence_scope": "Có đối chiếu giữa các đề; thuộc tính đầu ra khác nhau.", "refs": ["02f028487a62|P1|11|None", "02f028487a62|P1|17|None", "0ccfacf4a5ac|P1|8|None"]}, {"part_kind": "multiple_choice", "topic": "Tính toán trực tiếp theo đại lượng điện hóa và nhiệt hóa", "grade": null, "construction": "Cho các giá trị thành phần và quan hệ phản ứng; yêu cầu tính đại lượng tổng hợp. Xác định chiều lấy hiệu, trọng số và quy ước dấu rồi thực hiện phép tính.", "wrong_options": "Đảo phép trừ, cộng thay lấy hiệu hoặc bỏ hệ số. Một số nhiễu số không đủ căn cứ truy về thao tác sai cụ thể.", "difficulty_source": "Giữ đúng quy ước dấu và hệ số trong công thức quen thuộc.", "discrimination": "low", "typical_steps": 3, "evidence_scope": "Quan sát trong cùng một đề; đây là họ thao tác tính toán, chưa xác lập lặp của từng nội dung giữa các đề.", "refs": ["02f028487a62|P1|8|None", "02f028487a62|P1|10|None"]}, {"part_kind": "multiple_choice", "topic": "Pin và ăn mòn điện hóa qua tập nhận định", "grade": null, "construction": "Cho hệ kim loại trong môi trường điện li và các nhận định; yêu cầu chọn số nhận định đúng. Xác định quá trình điện cực, chiều electron và sản phẩm trong môi trường rồi tổng hợp đánh giá.", "wrong_options": "Các phương án đếm phản ánh việc đảo vai trò điện cực hoặc đánh giá sai sản phẩm; không thể luôn suy duy nhất lỗi từ số đếm.", "difficulty_source": "Nối cơ chế điện hóa với điều kiện tồn tại của sản phẩm.", "discrimination": "medium", "typical_steps": 4, "evidence_scope": "Có đối chiếu giữa các đề.", "refs": ["02f028487a62|P1|15|None", "0ccfacf4a5ac|P1|1|None"]}, {"part_kind": "multiple_choice", "topic": "Kiểm tra tính chất của các nhóm hợp chất sinh học", "grade": null, "construction": "Cho các khả năng phản ứng hoặc nhận định tính chất; yêu cầu chọn, loại hoặc đếm. Đối chiếu từng nhận định với cấu tạo, điều kiện phản ứng và phạm vi khái quát.", "wrong_options": "Chuyển tính chất giữa các chất gần nhau, bỏ nhóm chức đã tham gia liên kết, khái quát hóa tính tan hoặc làm người đọc bỏ sót yêu cầu phủ định.", "difficulty_source": "Phân biệt các tính chất dễ bị học gộp và kiểm tra từng mệnh đề độc lập.", "discrimination": "medium", "typical_steps": 3, "evidence_scope": "Có đối chiếu giữa các đề.", "refs": ["02f028487a62|P1|6|None", "0ccfacf4a5ac|P1|6|None", "0ccfacf4a5ac|P1|12|None"]}, {"part_kind": "multiple_choice", "topic": "Ghi nhớ cực trị tính chất vật lí", "grade": null, "construction": "Cho các cặp đối tượng ứng viên; yêu cầu chọn cặp tương ứng với những cực trị và đúng thứ tự. Gợi nhớ dữ kiện rồi đối chiếu vị trí.", "wrong_options": "Thay đối tượng cực trị bằng đối tượng thông dụng hoặc đảo sự ghép giữa đối tượng và tính chất.", "difficulty_source": "Độ chính xác của trí nhớ về tính chất đặc trưng.", "discrimination": "low", "typical_steps": 2, "evidence_scope": "Quan sát riêng một đề.", "refs": ["02f028487a62|P1|9|None"]}, {"part_kind": "multiple_choice", "topic": "Đọc biểu diễn và phối hợp ràng buộc cấu tạo", "grade": null, "construction": "Cho vị trí nguyên tố, phổ hoặc hình tiểu phân; yêu cầu chọn cấu hình, công thức hay số đối tượng phù hợp. Đọc đúng ý nghĩa kí hiệu rồi đối chiếu các điều kiện xác định đối tượng.", "wrong_options": "Nhầm đại lượng được biểu diễn, chỉ dùng một ràng buộc hoặc nhầm kí hiệu điện tích. Không đủ căn cứ gán lỗi cụ thể khi hình chưa rõ.", "difficulty_source": "Chuyển thông tin biểu diễn thành đặc điểm hóa học; độ rõ của hình giới hạn khả năng phân tích.", "discrimination": "medium", "typical_steps": 3, "evidence_scope": "Quan sát trong cùng một đề; chưa xác lập lặp của từng dạng biểu diễn giữa các đề, và mức phân hóa của hàng hình tiểu phân chưa xác định.", "refs": ["02f028487a62|P1|13|None", "02f028487a62|P1|14|None", "02f028487a62|P1|16|None"]}, {"part_kind": "multiple_choice", "topic": "Thứ tự phóng điện của ion", "grade": null, "construction": "Cho các cation cùng có mặt trong dung dịch; yêu cầu xếp thứ tự nhận electron. Xác định quá trình tại điện cực rồi so sánh khả năng bị khử.", "wrong_options": "Đảo thứ tự tương đối hoặc lấy hoạt tính của kim loại thay cho tính oxi hóa của ion.", "difficulty_source": "Phân biệt khả năng nhường electron của kim loại với khả năng nhận electron của ion.", "discrimination": "low", "typical_steps": 3, "evidence_scope": "Quan sát riêng một đề.", "refs": ["02f028487a62|P1|18|None"]}, {"part_kind": "multiple_choice", "topic": "Điều kiện áp dụng quy tắc cân bằng và tốc độ", "grade": null, "construction": "Cho hệ phản ứng và tác động hoặc biến thiên nồng độ; yêu cầu xác định kết quả đúng. Xác định đại lượng thực sự được hỏi rồi áp dụng quy tắc với điều kiện hoặc hệ số tương ứng.", "wrong_options": "Đồng nhất tốc độ với vị trí cân bằng, hoặc tốc độ tiêu hao với tốc độ phản ứng; dùng quy tắc mà bỏ điều kiện áp dụng.", "difficulty_source": "Phân biệt những đại lượng gần tên nhưng khác ý nghĩa và cách xác định.", "discrimination": "medium", "typical_steps": 3, "evidence_scope": "Có đối chiếu giữa các đề về thao tác phân biệt đại lượng; chưa chứng minh lặp của từng dạng bài cụ thể.", "refs": ["02f028487a62|P1|4|None", "0ccfacf4a5ac|P1|11|None"]}, {"part_kind": "multiple_choice", "topic": "Tương tác giữa các phân tử", "grade": 10, "construction": "Cho hiện tượng tập hợp hoặc biến đổi cấu trúc của chất; yêu cầu chọn tương tác giải thích. Phân biệt liên kết trong phân tử với tương tác giữa các phân tử rồi nhận diện tương tác chi phối.", "wrong_options": "Đánh tráo liên kết nội phân tử, mạng ion và tương tác liên phân tử.", "difficulty_source": "Xác định đúng cấp độ cấu trúc cần giải thích.", "discrimination": "low", "typical_steps": 2, "evidence_scope": "Quan sát riêng một đề.", "refs": ["0ccfacf4a5ac|P1|7|None"]}, {"part_kind": "true_false", "topic": "Phản ứng kim loại và phạm vi suy luận điện hóa", "grade": null, "construction": "Cho phản ứng hoặc hiện tượng kim loại với môi trường; yêu cầu đánh giá quan hệ thế điện cực hay thứ tự tính khử. Xác định quá trình electron rồi kiểm tra kết luận có được dữ kiện hỗ trợ hay không.", "wrong_options": "Các nhận định đặt quan hệ giữa biểu hiện phản ứng và tính khử; thiếu khóa đối sánh nên không xác định nhận định sai hoặc lỗi đảo chiều.", "difficulty_source": "Phân biệt chiều tự diễn biến với mức độ mãnh liệt quan sát được.", "discrimination": "medium", "typical_steps": 3, "evidence_scope": "Quan sát trong cùng một đề; chưa xác lập lặp giữa các đề.", "refs": ["7090ca87e657|P2|2|c", "7090ca87e657|P2|2|d"]}, {"part_kind": "true_false", "topic": "Biến đổi acid–base và trạng thái dung dịch hữu cơ", "grade": null, "construction": "Cho chuỗi thêm tác nhân cùng hiện tượng trong hoặc đục; yêu cầu đánh giá lời giải thích. Theo dõi chuyển đổi giữa dạng phân tử và dạng muối rồi liên hệ với độ tan.", "wrong_options": "Nhận định kiểm tra việc quy hiện tượng về đúng dạng chất; thiếu khóa đối sánh để xác nhận phần sai.", "difficulty_source": "Theo dõi dạng tồn tại của chất qua thao tác thay đổi môi trường.", "discrimination": "medium", "typical_steps": 3, "evidence_scope": "Quan sát trong cùng một đề; chưa xác lập lặp giữa các đề.", "refs": ["7090ca87e657|P2|3|a", "7090ca87e657|P2|3|c"]}, {"part_kind": "true_false", "topic": "Độ mạnh acid và chỉ thị", "grade": null, "construction": "Cho hệ chất có tính acid và dự đoán màu chỉ thị; yêu cầu đánh giá. Xác định mức độ acid rồi xét môi trường có đủ điều kiện gây đổi màu hay không.", "wrong_options": "Kiểm tra sự đồng nhất giữa có tính acid và làm đổi màu chỉ thị; chưa xác định tính sai do thiếu khóa đối sánh.", "difficulty_source": "Phân biệt tính chất định tính với điều kiện biểu hiện của phép thử.", "discrimination": "medium", "typical_steps": 3, "evidence_scope": "Quan sát riêng một đề.", "refs": ["7090ca87e657|P2|3|b"]}, {"part_kind": "true_false", "topic": "Độ tan, trạng thái pha và thao tác tách", "grade": null, "construction": "Cho trạng thái hệ hoặc công đoạn làm lạnh và tách chất; yêu cầu đánh giá quan hệ giải thích. Liên hệ độ tan với pha xuất hiện rồi kiểm tra hiện tượng hoặc thao tác phù hợp.", "wrong_options": "Kiểm tra sự nhất quán giữa độ tan và trạng thái quan sát. Không có căn cứ coi mọi nhận định trong nhóm là phát biểu sai.", "difficulty_source": "Chuyển tính chất độ tan thành hệ quả quan sát hoặc khả năng tách.", "discrimination": "low", "typical_steps": 2, "evidence_scope": "Có đối chiếu giữa các đề.", "refs": ["7090ca87e657|P2|3|d", "02f028487a62|P2|1|b"]}, {"part_kind": "true_false", "topic": "Nhóm chức và phân loại hợp chất", "grade": null, "construction": "Cho cấu tạo chất hoặc monomer và một nhận định phân loại; yêu cầu đánh giá. Nhận diện đủ nhóm chức, suy loại hợp chất hoặc liên kết tạo thành rồi kiểm tra toàn bộ nhận định.", "wrong_options": "Có thể kiểm tra việc bỏ sót nhóm chức hoặc lẫn số nhóm với số loại; chỉ gán lỗi khi có khóa và cấu tạo đủ rõ.", "difficulty_source": "Đọc đủ các đặc điểm cấu tạo thay vì chỉ nhận ra nhóm chức quen thuộc nhất.", "discrimination": "medium", "typical_steps": 3, "evidence_scope": "Có đối chiếu giữa các đề.", "refs": ["7090ca87e657|P2|4|a", "02f028487a62|P2|2|a"]}, {"part_kind": "true_false", "topic": "Dự đoán phản ứng từ nhóm chức", "grade": null, "construction": "Cho cấu tạo đa chức hoặc mạch polymer và môi trường base; yêu cầu đánh giá khả năng phản ứng. Xác định các vị trí phản ứng rồi suy lượng tác nhân tiêu thụ hoặc sự biến đổi mạch.", "wrong_options": "Bỏ qua nhóm chức ngoài phần đặc trưng hoặc suy độ bền hóa học từ tính bền chung của vật liệu; hàng thiếu khóa chỉ cho phép nêu điểm cần kiểm tra.", "difficulty_source": "Xét đầy đủ vị trí phản ứng và chuyển tính chất nhóm chức sang toàn phân tử.", "discrimination": "medium", "typical_steps": 3, "evidence_scope": "Có đối chiếu giữa các đề ở cách suy từ nhóm chức; đầu ra định lượng và định tính khác nhau.", "refs": ["7090ca87e657|P2|4|b", "02f028487a62|P2|2|c"]}, {"part_kind": "true_false", "topic": "Công thức khung và khối lượng mol", "grade": null, "construction": "Cho công thức khung và giá trị khối lượng mol đề xuất; yêu cầu kiểm tra. Đếm nguyên tử hiện rõ, bổ sung hydrogen theo hóa trị rồi lập công thức và tính khối lượng.", "wrong_options": "Nhận định kiểm tra kết quả đọc cấu tạo và cộng khối lượng; chưa có căn cứ xác định lỗi cụ thể.", "difficulty_source": "Đếm đúng nguyên tử không viết tường minh trong công thức khung.", "discrimination": "low", "typical_steps": 3, "evidence_scope": "Quan sát riêng một đề.", "refs": ["7090ca87e657|P2|4|c"]}, {"part_kind": "true_false", "topic": "Dạng ion và điện di", "grade": null, "construction": "Cho thông tin về môi trường có tổng điện tích bằng không và môi trường mới; yêu cầu đánh giá chiều điện di. So sánh môi trường, suy điện tích chủ yếu rồi xác định cực hút.", "wrong_options": "Nhận định nối trạng thái ion với hướng chuyển động; thiếu khóa đối sánh để gán lỗi nhầm cực.", "difficulty_source": "Nối quan hệ acid–base với điện tích và chuyển động trong điện trường.", "discrimination": "medium", "typical_steps": 3, "evidence_scope": "Quan sát riêng một đề.", "refs": ["7090ca87e657|P2|4|d"]}, {"part_kind": "true_false", "topic": "Tuần hoàn tác nhân trong quy trình công nghiệp", "grade": null, "construction": "Cho sơ đồ công nghệ và nhận định về tái sinh hoặc tái sử dụng; yêu cầu đánh giá. Theo dõi dòng chất, bổ sung phản ứng cần thiết rồi suy vai trò của dòng tuần hoàn.", "wrong_options": "Các nhận định được đối sánh là đúng; không có phát biểu sai để truy nguyên nhiễu.", "difficulty_source": "Đọc quan hệ giữa các công đoạn thay vì xem từng phản ứng tách rời.", "discrimination": "medium", "typical_steps": 3, "evidence_scope": "Quan sát trong cùng một đề; chưa xác lập lặp giữa các đề.", "refs": ["02f028487a62|P2|1|a", "02f028487a62|P2|1|c"]}, {"part_kind": "true_false", "topic": "Khối lượng chất rắn sau nhiệt phân", "grade": null, "construction": "Cho phương trình nhiệt phân và mức giảm khối lượng đề xuất; yêu cầu kiểm tra. Xác định phần thoát khỏi hệ, tính theo tỉ lượng rồi quy về khối lượng ban đầu.", "wrong_options": "Giá trị đề xuất không phù hợp cân bằng khối lượng; chưa đủ căn cứ xác định thao tác sai tạo ra giá trị đó.", "difficulty_source": "Chọn đúng phần khối lượng mất đi và cơ sở tính phần trăm.", "discrimination": "medium", "typical_steps": 3, "evidence_scope": "Quan sát riêng một đề.", "refs": ["02f028487a62|P2|1|d"]}, {"part_kind": "true_false", "topic": "Cơ chế tạo polymer", "grade": null, "construction": "Cho monomer đa chức và tên phản ứng tổng hợp được đề xuất; yêu cầu đánh giá. Xét cách tạo liên kết và việc tách phân tử nhỏ rồi đối chiếu tiêu chí phân loại.", "wrong_options": "Đồng nhất mọi quá trình tạo polymer với cùng một loại phản ứng.", "difficulty_source": "Dùng tiêu chí cơ chế thay vì chỉ nhìn sản phẩm polymer.", "discrimination": "low", "typical_steps": 3, "evidence_scope": "Quan sát riêng một đề.", "refs": ["02f028487a62|P2|2|b"]}, {"part_kind": "true_false", "topic": "Đặc tính vật liệu và đánh giá môi trường", "grade": null, "construction": "Cho thông tin về khả năng phân hủy và công dụng tương tự; yêu cầu đánh giá chiều so sánh. Tách công dụng khỏi đặc tính phân hủy rồi kết luận trong phạm vi dữ kiện.", "wrong_options": "Đánh đồng công dụng với tác động môi trường hoặc đảo chiều lợi ích được dữ kiện hỗ trợ.", "difficulty_source": "Giữ kết luận trong phạm vi đặc tính được cung cấp.", "discrimination": "low", "typical_steps": 2, "evidence_scope": "Quan sát riêng một đề; không đủ căn cứ suy thành đánh giá vòng đời toàn diện.", "refs": ["02f028487a62|P2|2|d"]}, {"part_kind": "true_false", "topic": "Kiểm tra kết quả tính theo tỉ lượng", "grade": null, "construction": "Cho lượng chất, điều kiện phản ứng và kết quả đề xuất; yêu cầu kiểm tra. Quy về lượng chất, xác định đúng hệ số và cơ sở tính rồi tính đại lượng cần đối chiếu.", "wrong_options": "Bỏ hệ số phản ứng, dùng nhầm thể tích quy chiếu hoặc tính theo chất dư trước khi áp dụng hiệu suất.", "difficulty_source": "Chọn đúng lượng chất quyết định và đúng mẫu số trước khi tính.", "discrimination": "medium", "typical_steps": 4, "evidence_scope": "Quan sát trong cùng một đề; chưa xác lập lặp giữa các đề.", "refs": ["02f028487a62|P2|3|a", "02f028487a62|P2|4|d"]}, {"part_kind": "true_false", "topic": "Thành phần môi trường ngoài phản ứng chính", "grade": null, "construction": "Cho hệ chuẩn độ và nhận định về dung dịch hoặc thay môi trường; yêu cầu đánh giá. Bổ sung các ion đi kèm ngoài phương trình rút gọn rồi xét sự tồn tại hoặc khả năng phản ứng phụ của chúng.", "wrong_options": "Chỉ xét phản ứng chính, bỏ ion khán giả hoặc coi môi trường chỉ có vai trò cung cấp proton. Không phải mọi nhận định trong nhóm đều sai.", "difficulty_source": "Xét đầy đủ hệ phản ứng thay vì chỉ các tiểu phân viết trong phương trình rút gọn.", "discrimination": "medium", "typical_steps": 3, "evidence_scope": "Quan sát trong cùng một đề; chưa xác lập lặp giữa các đề.", "refs": ["02f028487a62|P2|3|b", "02f028487a62|P2|3|d"]}, {"part_kind": "true_false", "topic": "Vai trò oxi hóa–khử từ phương trình", "grade": null, "construction": "Cho phương trình biểu diễn biến đổi điện tích; yêu cầu đánh giá vai trò chất. Xác định chiều thay đổi số oxi hóa rồi suy quá trình nhường hoặc nhận electron.", "wrong_options": "Nhận định được đối sánh là đúng; không có phát biểu sai để quy lỗi.", "difficulty_source": "Ghép đúng biến đổi số oxi hóa với vai trò chất.", "discrimination": "low", "typical_steps": 2, "evidence_scope": "Quan sát riêng một đề.", "refs": ["02f028487a62|P2|3|c"]}, {"part_kind": "true_false", "topic": "Nhận diện nhóm chức bằng phổ hồng ngoại", "grade": null, "construction": "Cho tín hiệu phổ và bảng khoảng hấp thụ; yêu cầu đánh giá nhận diện chất. Tra tín hiệu có mặt, kết hợp tín hiệu vắng mặt khi cần rồi loại các nhóm chức không phù hợp.", "wrong_options": "Các nhận định được đối sánh là đúng; không có phát biểu sai để quy lỗi.", "difficulty_source": "Mức đơn giản chỉ tra tín hiệu; mức phức tạp phải phối hợp bằng chứng có mặt và vắng mặt.", "discrimination": "medium", "typical_steps": 3, "evidence_scope": "Quan sát trong cùng một đề; chưa xác lập lặp giữa các đề.", "refs": ["02f028487a62|P2|4|a", "02f028487a62|P2|4|b"]}, {"part_kind": "true_false", "topic": "Truy vết nguyên tử trong phản ứng hữu cơ", "grade": null, "construction": "Cho sơ đồ cấu tạo phản ứng và nguyên tử đánh dấu; yêu cầu đánh giá đường đi của nguyên tử. Xác định liên kết được giữ hoặc biến đổi rồi theo dõi nguyên tử vào sản phẩm.", "wrong_options": "Nhận định được đối sánh là đúng; không có phát biểu sai để quy lỗi.", "difficulty_source": "Hiểu nguồn gốc nguyên tử thay vì chỉ nhớ phương trình tổng quát.", "discrimination": "medium", "typical_steps": 3, "evidence_scope": "Quan sát riêng một đề.", "refs": ["02f028487a62|P2|4|c"]}, {"part_kind": "short_answer", "topic": "Lượng hóa chất cần cho xử lí hoặc thu hồi", "grade": null, "construction": "Cho lượng nguyên liệu, phần cần xử lí và thông tin chất lượng hoặc hiệu suất; yêu cầu lượng tác nhân cần dùng. Xác định phần thực sự tham gia, đổi về lượng chất rồi dùng tỉ lượng và hiệu chỉnh theo dữ kiện.", "wrong_options": null, "difficulty_source": "Không dùng toàn bộ lượng ban đầu khi chỉ một phần cần loại bỏ hoặc đi vào công đoạn.", "discrimination": "medium", "typical_steps": 4, "evidence_scope": "Có đối chiếu giữa các đề.", "refs": ["7090ca87e657|P3|1|None", "02f028487a62|P3|3|None"]}, {"part_kind": "short_answer", "topic": "Năng lượng, hiệu suất và chi phí nhiên liệu", "grade": null, "construction": "Cho nhu cầu năng lượng hữu ích, hiệu suất và cơ sở định giá; yêu cầu chi phí. Suy năng lượng đầu vào rồi chọn đường quy đổi phù hợp với đơn giá; chỉ phân tích thành phần nhiên liệu khi cần xác định năng lượng trên đơn vị nhiên liệu.", "wrong_options": null, "difficulty_source": "Nhận ra cơ sở định giá quyết định dữ kiện nào cần dùng; phân biệt thành phần theo các cơ sở biểu diễn.", "discrimination": "medium", "typical_steps": 5, "evidence_scope": "Có đối chiếu giữa các đề.", "refs": ["7090ca87e657|P3|2|None", "02f028487a62|P3|4|None"]}, {"part_kind": "short_answer", "topic": "Cân bằng vật chất và phân chia lượng chất", "grade": null, "construction": "Cho lượng đầu vào hoặc sản phẩm cùng điều kiện phân bố chất; yêu cầu lượng bị tiêu thụ hay còn tự do. Chọn đại lượng bảo toàn, xác định các phần chuyển hóa rồi suy phần mục tiêu.", "wrong_options": null, "difficulty_source": "Phân biệt tổng lượng đưa vào với lượng thuộc đúng dạng hóa học được hỏi.", "discrimination": "medium", "typical_steps": 4, "evidence_scope": "Có đối chiếu giữa các đề ở cấu trúc cân bằng vật chất; cách phân chia sản phẩm khác nhau.", "refs": ["7090ca87e657|P3|3|None", "02f028487a62|P3|6|None"]}, {"part_kind": "short_answer", "topic": "Quan hệ cộng nối giữa các hiệu thế", "grade": null, "construction": "Cho các hiệu thế qua những cặp trung gian và thứ tự thế; yêu cầu hiệu thế giữa các đầu mút. Thống nhất chiều lấy hiệu rồi cộng để triệt tiêu đại lượng trung gian.", "wrong_options": null, "difficulty_source": "Nhận ra cấu trúc hiệu liên tiếp thay vì tìm từng thế riêng lẻ.", "discrimination": "low", "typical_steps": 3, "evidence_scope": "Quan sát riêng một đề.", "refs": ["7090ca87e657|P3|4|None"]}, {"part_kind": "short_answer", "topic": "Liên kết các phép thử sau chuyển hóa chưa hoàn toàn", "grade": null, "construction": "Cho hỗn hợp sau phản ứng chưa hoàn toàn, cách chia mẫu và kết quả định lượng của một phép thử; yêu cầu suy lượng thuốc thử ở phép thử khác. Dựng thành phần hỗn hợp, suy ngược từ phép thử đầu rồi tính đúng tập chất tham gia phép thử sau.", "wrong_options": null, "difficulty_source": "Các phép thử tác động lên những tập chất khác nhau; phải giữ cả chất chưa chuyển hóa và quan hệ chia mẫu.", "discrimination": "high", "typical_steps": 5, "evidence_scope": "Quan sát riêng một đề; chưa có bằng chứng lặp liên đề cho cấu trúc phân hóa cao này.", "refs": ["7090ca87e657|P3|5|None"]}, {"part_kind": "short_answer", "topic": "Đánh giá tập nhận định và mã hóa đáp án", "grade": null, "construction": "Cho tập nhận định về chất hoặc vật liệu; yêu cầu trả nhãn theo thứ tự quy định. Xác định đối tượng khi cần, đánh giá từng mệnh đề rồi chọn đúng chiều đúng hoặc sai và mã hóa.", "wrong_options": null, "difficulty_source": "Kiểm tra phạm vi khái quát và giữ nhất quán đối tượng qua các tính chất khác nhau.", "discrimination": "medium", "typical_steps": 4, "evidence_scope": "Có đối chiếu giữa các đề; một hàng còn yêu cầu nhận diện cấu tạo trước khi đánh giá.", "refs": ["7090ca87e657|P3|6|None", "02f028487a62|P3|5|None"]}, {"part_kind": "short_answer", "topic": "Khối lượng phân tử từ cấu tạo tạo thành", "grade": null, "construction": "Cho các thành phần tạo hợp chất; yêu cầu khối lượng phân tử sản phẩm. Xác định quan hệ cấu tạo, cộng đóng góp của nguyên liệu rồi trừ phần tách ra.", "wrong_options": null, "difficulty_source": "Dùng đúng quan hệ cấu tạo và phần khối lượng không còn trong sản phẩm.", "discrimination": "low", "typical_steps": 3, "evidence_scope": "Quan sát riêng một đề.", "refs": ["02f028487a62|P3|1|None"]}, {"part_kind": "short_answer", "topic": "Đoạn peptide từ công thức cấu tạo", "grade": null, "construction": "Cho hình cấu tạo mạch có mắt xích lặp; yêu cầu đếm đoạn khác nhau thỏa điều kiện thành phần. Đọc chiều mạch, nhận diện mắt xích, xét các đoạn kề nhau rồi loại trùng.", "wrong_options": null, "difficulty_source": "Phân biệt vị trí xuất hiện với loại đoạn khác nhau và không ghép các mắt xích không kề.", "discrimination": "medium", "typical_steps": 4, "evidence_scope": "Quan sát riêng một đề.", "refs": ["02f028487a62|P3|2|None"]}], "discrimination_moves": [{"move": "Cho các phép thử quan sát những tập chất khác nhau", "how_to_apply": "Thiết kế các phép thử có phạm vi phản ứng khác nhau trên cùng hỗn hợp; người giải phải xác định tập chất của từng phép thử trước khi nối kết quả. Đây là thao tác rút từ hàng phân hóa cao, chưa xác lập tính lặp liên đề.", "refs": ["7090ca87e657|P3|5|None"]}, {"move": "Giữ chất chưa phản ứng trong mô hình", "how_to_apply": "Dùng chuyển hóa chưa hoàn toàn để chất đầu còn dư tiếp tục đóng góp vào phép đo sau; yêu cầu tính đúng toàn bộ thành phần thay vì chỉ sản phẩm. Bằng chứng phân hóa cao hiện là quan sát riêng một đề.", "refs": ["7090ca87e657|P3|5|None"]}, {"move": "Buộc suy ngược từ kết quả đo", "how_to_apply": "Cung cấp lượng sản phẩm của phép thử rồi yêu cầu khôi phục lượng chất trong mẫu trước khi tính đại lượng khác. Không coi đây là thao tác phân hóa cao đã lặp giữa các đề.", "refs": ["7090ca87e657|P3|5|None"]}, {"move": "Giữ quan hệ chia mẫu xuyên suốt suy luận", "how_to_apply": "Đặt kết quả đo và đại lượng cần tìm ở các phần mẫu tương ứng; lời giải phải bảo toàn cơ sở lượng chất khi chuyển giữa các phần. Bằng chứng hiện giới hạn ở hàng phân hóa cao đã cung cấp.", "refs": ["7090ca87e657|P3|5|None"]}, {"move": "Nối mức chuyển hóa với thành phần và khả năng phản ứng", "how_to_apply": "Để kết quả định lượng phụ thuộc đồng thời vào mức chuyển hóa và tính chất của các thành phần sau phản ứng; tăng yêu cầu dựng mô hình thay vì chỉ kéo dài phép tính. Chưa có bằng chứng liên đề cho mức phân hóa cao của thao tác này.", "refs": ["7090ca87e657|P3|5|None"]}], "easy_vs_hard": [{"topic": "Carbohydrate", "easy": "Nhận diện trực tiếp phản ứng có hoặc không có từ nhóm chức và loại carbohydrate.", "hard": "Dựng hỗn hợp sau chuyển hóa chưa hoàn toàn rồi nối các phép thử có phạm vi phản ứng khác nhau.", "difference": "Chuyển từ nhớ tính chất riêng lẻ sang mô hình hóa thành phần và suy ngược định lượng.", "easy_refs": ["02f028487a62|P1|6|None"], "hard_refs": ["7090ca87e657|P3|5|None"]}, {"topic": "Phổ hồng ngoại và nhận diện hữu cơ", "easy": "Tra tín hiệu trong bảng để gán nhóm chức.", "hard": "Phối hợp công thức, dữ kiện phổ và điều kiện cấu tạo trước khi đánh giá nhiều tính chất.", "difference": "Dạng khó hơn có bước khóa đối tượng trung gian; hàng tương ứng được đánh giá phân hóa trung bình.", "easy_refs": ["02f028487a62|P2|4|a"], "hard_refs": ["02f028487a62|P3|5|None"]}, {"topic": "Điện hóa", "easy": "Tính hiệu thế từ dữ kiện thế điện cực hoặc cộng các hiệu đã định hướng.", "hard": "Xác định quá trình điện cực rồi kiểm tra chiều electron và sản phẩm trong môi trường.", "difference": "Dạng khó hơn yêu cầu phối hợp cơ chế với điều kiện hóa học; chưa được phân loại là phân hóa cao.", "easy_refs": ["02f028487a62|P1|8|None", "7090ca87e657|P3|4|None"], "hard_refs": ["02f028487a62|P1|15|None", "0ccfacf4a5ac|P1|1|None"]}, {"topic": "Ester và phản ứng tạo ester", "easy": "Tính khối lượng phân tử từ quan hệ cấu tạo và phần tách ra.", "hard": "Xác định chất giới hạn trước khi áp dụng hiệu suất hoặc truy vết nguyên tử qua biến đổi liên kết.", "difference": "Dạng khó hơn bổ sung quyết định hóa học trước phép tính hoặc đòi hỏi hiểu nguồn gốc nguyên tử; mức phân hóa được ghi nhận là trung bình.", "easy_refs": ["02f028487a62|P3|1|None"], "hard_refs": ["02f028487a62|P2|4|c", "02f028487a62|P2|4|d"]}], "fact_use": {"common": [{"use": "Định nghĩa và thuật ngữ có thể là đích hỏi trực tiếp, hoặc được cung cấp để người giải áp dụng vào đối tượng.", "refs": ["02f028487a62|P1|5|None", "02f028487a62|P1|16|None", "0ccfacf4a5ac|P1|10|None", "0ccfacf4a5ac|P1|13|None"]}, {"use": "Dấu hiệu thực nghiệm, quy tắc tính tan và tính chất đặc trưng thường làm cầu nối giữa chất, thuốc thử và hiện tượng.", "refs": ["02f028487a62|P1|3|None", "02f028487a62|P1|12|None", "0ccfacf4a5ac|P1|4|None", "7090ca87e657|P2|3|a", "7090ca87e657|P2|3|d"]}, {"use": "Dữ kiện định lượng hoặc bảng tra được cho để sử dụng trong suy luận; trọng tâm có thể là chọn dấu, hệ số, cơ sở quy đổi hoặc loại thông tin dư.", "refs": ["02f028487a62|P1|8|None", "02f028487a62|P1|10|None", "02f028487a62|P2|4|a", "7090ca87e657|P3|2|None", "02f028487a62|P3|4|None"]}, {"use": "Tên loại chất và nhóm chức được dùng để suy tính chất; không phải mọi câu đều cung cấp sẵn toàn bộ kiến thức cần huy động.", "refs": ["02f028487a62|P1|6|None", "0ccfacf4a5ac|P1|12|None", "7090ca87e657|P3|5|None"]}], "not_observed": [{"use": "Không thấy yêu cầu nhớ niên đại hoặc kích thước của bối cảnh để quyết định đáp án; hàng có loại thông tin này dùng nó làm nền cho cơ chế hóa học.", "refs": ["02f028487a62|P1|15|None"]}, {"use": "Không thấy yêu cầu học thuộc các giá trị chuyên biệt đã được bảng hoặc dữ kiện cung cấp; người giải phải đọc và vận dụng chúng.", "refs": ["02f028487a62|P1|8|None", "02f028487a62|P1|10|None", "02f028487a62|P2|4|a", "02f028487a62|P2|4|b"]}], "boundary": "Các mục không quan sát được chỉ mô tả phạm vi hàng đã cho, không khẳng định những dạng đó không bao giờ xuất hiện ở nguồn đề khác."}, "anti_patterns": [{"anti_pattern": "Buộc dùng mọi dữ kiện có trong đề.", "basis": "Có bài cho phép bỏ thông tin thành phần và nhiệt hóa học khi cơ sở định giá đã đủ để tính trực tiếp.", "refs": ["7090ca87e657|P3|2|None"]}, {"anti_pattern": "Tạo độ khó chỉ bằng chuỗi tính toán dài.", "basis": "Chuỗi tính dài vẫn được đánh giá phân hóa trung bình; hàng phân hóa cao đòi hỏi phân biệt tập chất và nối phép thử.", "refs": ["02f028487a62|P3|4|None", "02f028487a62|P3|5|None", "7090ca87e657|P3|5|None"]}, {"anti_pattern": "Viết phương án nhiễu chỉ là kiến thức xa rời đối tượng đang hỏi.", "basis": "Các hàng có phân tích nhiễu dùng khái niệm lân cận, tính chất của chất gần nhau hoặc lỗi đọc cấu tạo và điều kiện.", "refs": ["02f028487a62|P1|7|None", "0ccfacf4a5ac|P1|2|None", "0ccfacf4a5ac|P1|9|None", "0ccfacf4a5ac|P1|12|None"]}, {"anti_pattern": "Coi mọi câu trả lời ngắn đều phải cho kết quả định lượng.", "basis": "Có câu yêu cầu đánh giá nhận định và trả chuỗi nhãn theo quy định.", "refs": ["7090ca87e657|P3|6|None", "02f028487a62|P3|5|None"]}, {"anti_pattern": "Coi tất cả nhận định trong nhóm đúng–sai phải có cùng giá trị chân lí.", "basis": "Các nhóm đã đối sánh chứa những nhận định được đánh giá độc lập về những khía cạnh khác nhau của cùng hệ.", "refs": ["02f028487a62|P2|1|a", "02f028487a62|P2|1|d", "02f028487a62|P2|2|a", "02f028487a62|P2|2|b", "02f028487a62|P2|3|a", "02f028487a62|P2|3|c"]}, {"anti_pattern": "Dùng bối cảnh thực tế như thông tin trang trí rồi hỏi một chi tiết ngoài cơ chế cần xét.", "basis": "Trong các hàng ứng dụng và công nghệ được cung cấp, yêu cầu quay về tính chất quyết định công dụng, dòng vật chất hoặc quan hệ năng lượng.", "refs": ["0ccfacf4a5ac|P1|2|None", "0ccfacf4a5ac|P1|5|None", "02f028487a62|P2|1|c", "7090ca87e657|P3|1|None", "02f028487a62|P3|4|None"]}]}, {"evidence_scope": "Chỉ coi cách dựng câu là lặp lại khi refs thuộc các paper_id khác nhau. Những mục có refs cùng paper_id là quan sát riêng, được giữ để mô tả phạm vi dữ liệu, chưa xác nhận tính lặp lại. Không suy rộng sang toàn bộ đề thi cùng định dạng. grade để null khi dữ liệu không đủ xác nhận lớp chung.", "patterns": [{"part_kind": "multiple_choice", "topic": "Từ tên gọi đến đặc điểm cấu tạo hữu cơ", "grade": null, "construction": "Cho tên hoặc tên viết tắt; giải mã các thành phần tên để chọn công thức, mắt xích hoặc loại cấu tạo tương ứng.", "wrong_options": "Giữ một phần cấu tạo đúng nhưng đổi gốc, nhóm thế hoặc dấu hiệu liên kết; dùng cấu tạo của chất quen thuộc gần tên.", "difficulty_source": "Đọc chính xác thông tin cấu tạo được mã hóa trong tên.", "discrimination": "low", "typical_steps": 2, "refs": ["0ccfacf4a5ac|P1|14|None", "cd005a72af60|P1|5|None", "126f1b46d648|P1|2|None"]}, {"part_kind": "multiple_choice", "topic": "Đối chiếu lớp chất với thuộc tính quen thuộc", "grade": null, "construction": "Cho tên, cấu tạo hoặc sơ đồ vai trò của chất; nhận diện lớp chất rồi đối chiếu tính chất vật lí, cấu tạo hoặc chức năng đã học.", "wrong_options": "Chuyển thuộc tính của lớp chất gần gũi sang chất đang xét; đồng nhất đơn phân với polymer hoặc chức năng dự trữ với chức năng cấu tạo.", "difficulty_source": "Phân biệt các chất gần nhau bằng thuộc tính thực sự quyết định.", "discrimination": "low", "typical_steps": 2, "refs": ["0ccfacf4a5ac|P1|18|None", "cd005a72af60|P1|4|None", "cd005a72af60|P1|8|None"]}, {"part_kind": "multiple_choice", "topic": "Quan hệ giữa tính khử, thế điện cực và chiều phản ứng", "grade": null, "construction": "Cho phản ứng hoặc thông tin về các cặp oxi hóa – khử; xác định chiều trao đổi electron rồi kiểm tra thứ tự hoạt tính, vai trò điện cực hoặc dấu đại lượng điện hóa.", "wrong_options": "Đảo chiều so sánh, đảo vai trò điện cực, đổi thứ tự phép trừ hoặc suy tính khử từ điện tích ion.", "difficulty_source": "Giữ nhất quán giữa dạng oxi hóa, dạng khử và chiều biến đổi.", "discrimination": "medium", "typical_steps": 3, "refs": ["0ccfacf4a5ac|P1|15|None", "cd005a72af60|P1|3|None", "cd005a72af60|P1|14|None"]}, {"part_kind": "multiple_choice", "topic": "Chiết lỏng – lỏng và phân bố chất tan", "grade": 11, "construction": "Cho quy trình phân bố chất giữa các pha; nhận diện phương pháp, suy pha chứa chất tan từ độ phân cực, xác định vị trí pha từ khối lượng riêng rồi chọn tập nhận định.", "wrong_options": "Đảo quy tắc hòa tan, nhầm vị trí lớp hoặc chuyển màu đặc trưng sang sai pha.", "difficulty_source": "Phối hợp các thuộc tính độc lập của chất tan và dung môi.", "discrimination": "medium", "typical_steps": 4, "refs": ["0ccfacf4a5ac|P1|16|None"]}, {"part_kind": "multiple_choice", "topic": "Phạm vi và tính chọn lọc của thủy luyện", "grade": null, "construction": "Cho phương pháp xử lí trong dung dịch hoặc hỗn hợp kim loại; dùng mức độ hoạt động và khả năng oxi hóa – khử để kiểm tra kim loại có thể thu hồi, hòa tan hoặc còn lại.", "wrong_options": "Cho rằng tác nhân dư hòa tan mọi kim loại; bỏ giới hạn của phương pháp trong nước hoặc nhầm tính kém hoạt động với không thể thu hồi.", "difficulty_source": "Kiểm tra điều kiện áp dụng thay vì chỉ nhận diện tên phương pháp.", "discrimination": "medium", "typical_steps": 3, "refs": ["0ccfacf4a5ac|P1|17|None", "cd005a72af60|P1|7|None"]}, {"part_kind": "multiple_choice", "topic": "Protein và tác nhân gây biến tính", "grade": null, "construction": "Cho hiện tượng sau thao tác; xác định yếu tố thực sự đã thay đổi rồi liên hệ với nguyên nhân gây biến tính.", "wrong_options": "Dùng tác nhân có thể gây hiện tượng nói chung nhưng không xuất hiện trong dữ kiện.", "difficulty_source": "Gắn kiến thức với điều kiện được mô tả.", "discrimination": "low", "typical_steps": 2, "refs": ["cd005a72af60|P1|2|None"]}, {"part_kind": "multiple_choice", "topic": "Cơ chế bảo vệ kim loại", "grade": null, "construction": "Cho các biện pháp bảo vệ và vật liệu hi sinh; phân biệt cách li bề mặt với bảo vệ điện hóa, xác định nơi oxi hóa rồi tìm nhận định trái cơ chế.", "wrong_options": "Các mô tả đúng gây nhiễu cho yêu cầu chọn phát biểu sai; nhầm vai trò điện cực hoặc thứ tự oxi hóa.", "difficulty_source": "Đọc đúng chiều yêu cầu và xác định vật liệu bị tiêu hao.", "discrimination": "low", "typical_steps": 3, "refs": ["cd005a72af60|P1|6|None"]}, {"part_kind": "multiple_choice", "topic": "Chọn hóa chất từ nhu cầu trung hòa", "grade": null, "construction": "Cho mục tiêu giảm độ acid; chuyển yêu cầu ứng dụng thành phản ứng acid – base rồi chọn chất có tính chất phù hợp.", "wrong_options": "Suy khả năng trung hòa từ cùng cation hoặc từ ứng dụng quen thuộc khác của hóa chất.", "difficulty_source": "Nhận diện tính chất hóa học quyết định công dụng.", "discrimination": "low", "typical_steps": 2, "refs": ["cd005a72af60|P1|9|None"]}, {"part_kind": "multiple_choice", "topic": "Lập công thức phức aqua", "grade": null, "construction": "Cho muối trong nước và hình học phức; xác định ion trung tâm, suy số phối tử rồi bảo toàn điện tích để chọn công thức.", "wrong_options": "Giữ anion ngoài cầu phối trí trong công thức phức, bỏ điện tích hoặc viết cả muối như tiểu phân phối trí.", "difficulty_source": "Phân biệt ion phức với hợp chất ban đầu.", "discrimination": "medium", "typical_steps": 3, "refs": ["cd005a72af60|P1|10|None"]}, {"part_kind": "multiple_choice", "topic": "Nguồn phát thải từ quá trình hóa học", "grade": null, "construction": "Cho các quá trình; xét thành phần nguyên liệu và khả năng sinh chất được hỏi rồi chọn quá trình không thuộc nhóm nguồn phát thải.", "wrong_options": "Bỏ tạp chất của nguyên liệu hoặc bỏ nguồn phát thải tự nhiên.", "difficulty_source": "Xét đúng bản chất quá trình thay vì chỉ dựa vào nhãn môi trường.", "discrimination": "low", "typical_steps": 2, "refs": ["cd005a72af60|P1|11|None"]}, {"part_kind": "multiple_choice", "topic": "Quy đổi trực tiếp từ hàm lượng", "grade": null, "construction": "Cho nhu cầu chất và hàm lượng trong sản phẩm; lập tỉ lệ, đổi sang lượng sản phẩm rồi chọn mức đáp ứng yêu cầu.", "wrong_options": "Dùng trực tiếp giá trị khác đơn vị hoặc xử lí sai tỉ lệ; không đủ căn cứ gán mọi giá trị nhiễu cho một lỗi duy nhất.", "difficulty_source": "Giữ đúng đơn vị và ý nghĩa mức tối thiểu.", "discrimination": "low", "typical_steps": 2, "refs": ["cd005a72af60|P1|13|None"]}, {"part_kind": "multiple_choice", "topic": "Áp dụng định nghĩa đồng vị", "grade": null, "construction": "Cho kí hiệu hạt nhân; đọc các chỉ số rồi chọn trường hợp thỏa điều kiện xác định đồng vị.", "wrong_options": "Dùng số khối hoặc quan hệ giữa các chỉ số thay cho tiêu chí cùng số proton.", "difficulty_source": "Chọn đúng đại lượng bất biến trong định nghĩa.", "discrimination": "low", "typical_steps": 2, "refs": ["cd005a72af60|P1|15|None"]}, {"part_kind": "multiple_choice", "topic": "Nhận biết phenol bằng phản ứng đặc trưng", "grade": null, "construction": "Cho thuốc thử và các chất chứa hydroxyl; liên hệ hiện tượng với phản ứng đặc trưng rồi kiểm tra vị trí gắn nhóm chức.", "wrong_options": "Đồng nhất alcohol với phenol hoặc suy phản ứng chỉ từ số nhóm hydroxyl.", "difficulty_source": "Phân biệt cùng nhóm nguyên tử nhưng khác môi trường liên kết.", "discrimination": "low", "typical_steps": 2, "refs": ["cd005a72af60|P1|16|None"]}, {"part_kind": "multiple_choice", "topic": "Đọc biểu diễn để định vị dấu hiệu nhóm chức", "grade": null, "construction": "Cho hình cấu tạo hoặc phổ có chỉ dẫn; xác định đầy đủ dấu hiệu nhóm chức rồi đếm hoặc ghép vị trí với nhãn.", "wrong_options": "Chọn dấu hiệu nổi bật nhưng không đúng tiêu chí, bỏ nhánh hoặc tính cả nhóm gần giống.", "difficulty_source": "Đọc biểu diễn theo tiêu chí thay vì theo hình thức dễ thấy.", "discrimination": "low", "typical_steps": 2, "refs": ["cd005a72af60|P1|1|None", "cd005a72af60|P1|17|None"]}, {"part_kind": "multiple_choice", "topic": "Nhận biết hữu cơ bằng ràng buộc toàn bảng", "grade": null, "construction": "Cho tập chất và bảng thử các mẫu mã hóa; cố định những mẫu có dấu hiệu riêng, phối hợp các phép thử rồi loại trừ mẫu còn lại.", "wrong_options": "Chọn theo hiện tượng riêng lẻ hoặc gán lại chất đã thuộc mẫu khác.", "difficulty_source": "Hiện tượng không duy nhất chỉ được giải quyết khi dùng toàn bộ ràng buộc.", "discrimination": "medium", "typical_steps": 4, "refs": ["cd005a72af60|P1|18|None"]}, {"part_kind": "multiple_choice", "topic": "Ảnh hưởng của điều kiện đến tốc độ phản ứng", "grade": null, "construction": "Cho phản ứng dị thể và các thay đổi điều kiện; phân biệt đại lượng động học với tổng lượng chất rồi chọn thay đổi không tác động trong mô hình đã dùng.", "wrong_options": "Đồng nhất lượng dung dịch với nồng độ hoặc cho rằng chất dư khiến nồng độ mất tác dụng.", "difficulty_source": "Tách các đại lượng có vẻ gần nhau và giữ điều kiện mô hình.", "discrimination": "medium", "typical_steps": 3, "refs": ["126f1b46d648|P1|4|None"]}, {"part_kind": "multiple_choice", "topic": "Phân loại theo bảng dữ liệu và ngưỡng", "grade": null, "construction": "Cho định nghĩa, khoảng dữ liệu và ngưỡng phân loại; so sánh giá trị với ngưỡng, xét từng nhận định rồi chọn tổ hợp.", "wrong_options": "Đảo chiều quan hệ nguy cơ, gom nhóm quá rộng hoặc bỏ nhận định đúng khi ghép tổ hợp.", "difficulty_source": "Phối hợp thứ tự giá trị với điều kiện biên của định nghĩa.", "discrimination": "medium", "typical_steps": 3, "refs": ["126f1b46d648|P1|5|None"]}, {"part_kind": "multiple_choice", "topic": "Xu hướng tính acid và mức độ điện li", "grade": null, "construction": "Cho các chất quen thuộc; xác định họ chất và tiêu chí so sánh rồi chọn chất theo độ mạnh acid hoặc khả năng phân li.", "wrong_options": "Suy độ mạnh acid chỉ từ độ âm điện, đồng nhất chất quen thuộc với cực trị hoặc nhầm thủy phân muối với điện li yếu.", "difficulty_source": "Dùng đúng quy tắc cho thuộc tính đang hỏi.", "discrimination": "low", "typical_steps": 2, "refs": ["126f1b46d648|P1|1|None", "126f1b46d648|P1|3|None"]}, {"part_kind": "multiple_choice", "topic": "Phục hồi monomer từ mắt xích polymer", "grade": null, "construction": "Cho mắt xích; xác định liên kết nối các đoạn, tách hình thức để phục hồi nhóm chức rồi kiểm tra khung và khả năng kéo dài mạch.", "wrong_options": "Chọn chất tạo đúng loại liên kết nhưng sai khung hoặc thiếu tính đa chức.", "difficulty_source": "Kiểm tra đồng thời cấu tạo sản phẩm và điều kiện phát triển chuỗi.", "discrimination": "medium", "typical_steps": 3, "refs": ["cd005a72af60|P1|12|None"]}, {"part_kind": "true_false", "topic": "Phân loại phản ứng từ biến đổi nhóm chức", "grade": null, "construction": "Cho chất đầu và cấu tạo sản phẩm; xác định cách hình thành liên kết, xét việc tách chất nhỏ nếu cần rồi kiểm tra tên loại phản ứng.", "wrong_options": "Gọi tên theo loại sản phẩm mà không xét cách hình thành liên kết.", "difficulty_source": "Phân loại bằng biến đổi hóa học thực tế.", "discrimination": "low", "typical_steps": 2, "refs": ["0ccfacf4a5ac|P2|1|b", "cd005a72af60|P2|1|a"]}, {"part_kind": "true_false", "topic": "Suy monomer và khả năng phân cắt từ liên kết polymer", "grade": 12, "construction": "Cho mắt xích polymer; nhận diện liên kết chức trong mạch rồi suy nhóm chức tiền chất hoặc khả năng cắt mạch trong môi trường phản ứng.", "wrong_options": null, "difficulty_source": "Chuyển kiến thức nhóm chức sang cấu trúc đại phân tử.", "discrimination": "low", "typical_steps": 2, "refs": ["0ccfacf4a5ac|P2|1|a", "0ccfacf4a5ac|P2|1|c"]}, {"part_kind": "true_false", "topic": "Từ công thức khung đến thành phần và khối lượng", "grade": null, "construction": "Cho hình cấu tạo; đếm nguyên tử, bổ sung hydrogen theo hóa trị rồi kiểm tra công thức phân tử hoặc dùng khối lượng đơn vị cấu tạo để kiểm tra độ dài mạch.", "wrong_options": null, "difficulty_source": "Đọc đúng thành phần cấu tạo trước khi tính.", "discrimination": "medium", "typical_steps": 3, "refs": ["0ccfacf4a5ac|P2|1|d", "cd005a72af60|P2|2|c"]}, {"part_kind": "true_false", "topic": "Thay phối tử và biến đổi hiện tượng", "grade": 12, "construction": "Cho quá trình tạo phức hoặc đề xuất đổi thuốc thử; xác định phối tử trước và sau rồi kiểm tra loại biến đổi hoặc màu sản phẩm.", "wrong_options": "Cho rằng cùng ion trung tâm và cùng kiểu tạo phức thì hiện tượng phải giống nhau.", "difficulty_source": "Phân biệt bản chất phản ứng với biểu hiện quan sát.", "discrimination": "medium", "typical_steps": 2, "refs": ["0ccfacf4a5ac|P2|2|a", "0ccfacf4a5ac|P2|2|b"]}, {"part_kind": "true_false", "topic": "Điện tích và dạng tồn tại của trung tâm phức", "grade": null, "construction": "Cho công thức hoặc quá trình tạo phức; xác định trạng thái của trung tâm, cộng điện tích phối tử rồi kiểm tra điện tích toàn phức và cách gọi tiểu phân.", "wrong_options": "Bỏ điện tích, lấy điện tích tâm làm điện tích toàn phức hoặc gọi ion trung tâm là nguyên tử trung hòa.", "difficulty_source": "Phân biệt thuộc tính của thành phần với thuộc tính của cả tiểu phân.", "discrimination": "medium", "typical_steps": 2, "refs": ["0ccfacf4a5ac|P2|2|c", "0ccfacf4a5ac|P2|2|d", "cd005a72af60|P2|4|d"]}, {"part_kind": "true_false", "topic": "Đọc xu hướng và mức biến thiên trong bảng thực nghiệm", "grade": null, "construction": "Cho bảng kết quả theo điều kiện; so sánh giá trị hoặc tính chênh lệch liên tiếp rồi kiểm tra phát biểu đúng với đại lượng đang được hỏi.", "wrong_options": "Đánh tráo giá trị kết quả lớn với mức tăng lớn.", "difficulty_source": "Phân biệt mức đại lượng với độ biến thiên của nó.", "discrimination": "medium", "typical_steps": 3, "refs": ["0ccfacf4a5ac|P2|3|c", "cd005a72af60|P2|1|d"]}, {"part_kind": "true_false", "topic": "Giới hạn ngoại suy từ dữ liệu enzyme", "grade": null, "construction": "Cho xu hướng trong miền khảo sát và dự đoán ngoài miền; xác định phạm vi bằng chứng, xét giới hạn hoạt động của xúc tác rồi đánh giá độ chắc chắn của kết luận.", "wrong_options": "Kéo dài xu hướng quan sát được thành quy luật không có giới hạn.", "difficulty_source": "Nhận ra dữ liệu chưa đủ bảo đảm kết luận ngoài điều kiện khảo sát.", "discrimination": "high", "typical_steps": 3, "refs": ["0ccfacf4a5ac|P2|3|a"]}, {"part_kind": "true_false", "topic": "Phân biệt vai trò tác nhân, điều kiện và thiết bị", "grade": null, "construction": "Cho quy trình hoặc phương trình và lời giải thích chức năng; theo dõi chất có bị biến đổi, mục đích bổ sung và chức năng trực tiếp của thiết bị rồi kiểm tra từng vế nhận định.", "wrong_options": "Nhầm môi trường với xúc tác chính, tác chất với xúc tác hoặc gán thêm chức năng không được thiết bị trực tiếp thực hiện.", "difficulty_source": "Không để chức năng đúng của một thành phần hợp thức hóa phần giải thích sai.", "discrimination": "medium", "typical_steps": 3, "refs": ["0ccfacf4a5ac|P2|3|d", "cd005a72af60|P2|1|c", "cd005a72af60|P2|3|b"]}, {"part_kind": "true_false", "topic": "Từ tính chất đến mục đích sử dụng và thao tác", "grade": null, "construction": "Cho ứng dụng hoặc thao tác xử lí; xác định tính chất liên quan rồi kiểm tra tính phù hợp và mức độ khẳng định của lời giải thích.", "wrong_options": "Suy vị trí cực đại của tính chất từ việc được sử dụng phổ biến.", "difficulty_source": "Phân biệt có tính chất phù hợp với khẳng định tuyệt đối về tính chất.", "discrimination": "medium", "typical_steps": 2, "refs": ["cd005a72af60|P2|1|b", "cd005a72af60|P2|2|b", "cd005a72af60|P2|3|a"]}, {"part_kind": "true_false", "topic": "Phân loại cấu tạo và giải mã thành phần phức", "grade": null, "construction": "Cho công thức cấu tạo; nhận diện đầy đủ các thành phần, áp dụng định nghĩa phân loại rồi kiểm tra thuật ngữ, số lượng, chiều cho – nhận hoặc hình học được đề xuất.", "wrong_options": "Chỉ xét thành phần nổi bật, bỏ loại nhóm chức hoặc phối tử còn lại, hoặc chọn hình học không khớp cấu tạo.", "difficulty_source": "Áp dụng chính xác định nghĩa cho toàn bộ công thức; cách dùng thuật ngữ hữu cơ phụ thuộc khóa đối sánh trong dữ liệu.", "discrimination": "medium", "typical_steps": 3, "refs": ["cd005a72af60|P2|2|a", "cd005a72af60|P2|4|a", "cd005a72af60|P2|4|b", "cd005a72af60|P2|4|c"]}, {"part_kind": "true_false", "topic": "Vai trò điện cực trong bảo vệ điện hóa", "grade": 12, "construction": "Cho cặp kim loại trong môi trường điện li hoặc đề xuất thay vật liệu; xác định nơi nhường và nhận electron rồi kiểm tra tác dụng bảo vệ, quá trình điện cực và dấu điện cực.", "wrong_options": "Coi mọi kim loại gắn thêm đều bảo vệ được hoặc đảo oxi hóa với khử tại bề mặt được bảo vệ.", "difficulty_source": "Suy lại chiều hoạt động khi điều kiện vật liệu thay đổi.", "discrimination": "medium", "typical_steps": 3, "refs": ["0ccfacf4a5ac|P2|4|a", "0ccfacf4a5ac|P2|4|c", "0ccfacf4a5ac|P2|4|d"]}, {"part_kind": "true_false", "topic": "Kiểm tra định lượng qua cơ sở thành phần và hệ số quy đổi", "grade": null, "construction": "Cho quy mô, thành phần và hệ số chuyển đổi; chọn đúng phần tham gia, quy đổi theo tỉ lượng hoặc dung lượng, hiệu chỉnh yếu tố hữu ích rồi đối chiếu kết quả.", "wrong_options": "Sai cơ sở phần trăm, bỏ phần hao hụt, nhầm chất khan với hóa chất ngậm nước hoặc sai chiều quy đổi; không suy được lỗi duy nhất từ mọi kết quả sai.", "difficulty_source": "Giữ đúng cơ sở lượng chất qua các bước chuyển đổi.", "discrimination": "medium", "typical_steps": 4, "refs": ["0ccfacf4a5ac|P2|3|b", "0ccfacf4a5ac|P2|4|b", "cd005a72af60|P2|2|d", "cd005a72af60|P2|3|d"]}, {"part_kind": "true_false", "topic": "Kết tinh muối ngậm nước", "grade": null, "construction": "Cho dung dịch bão hòa và độ tan khi đổi nhiệt độ; đặt lượng tinh thể, trừ đồng thời chất tan và nước bị lấy đi rồi lập điều kiện bão hòa cuối.", "wrong_options": null, "difficulty_source": "Dung môi còn lại phụ thuộc lượng tinh thể tách ra.", "discrimination": "medium", "typical_steps": 5, "refs": ["cd005a72af60|P2|3|c"]}, {"part_kind": "short_answer", "topic": "Ghép đối tượng với hiện tượng hoặc phương pháp", "grade": null, "construction": "Cho các thí nghiệm hoặc sơ đồ gắn nhãn và thứ tự thuộc tính cần ghép; nhận diện biến đổi từ điều kiện, ghép từng đối tượng rồi xuất chuỗi nhãn đúng thứ tự.", "wrong_options": null, "difficulty_source": "Phân biệt các biến đổi gần nhau và giữ đúng chiều mã hóa.", "discrimination": "medium", "typical_steps": 4, "refs": ["0ccfacf4a5ac|P3|1|None", "cd005a72af60|P3|3|None"]}, {"part_kind": "short_answer", "topic": "Biến thiên khối lượng khi kim loại phản ứng với dung dịch muối", "grade": 12, "construction": "Cho các mẫu trên cùng cơ sở lượng chất và giả thiết sản phẩm bám; xét khả năng phản ứng, tính phần hòa tan và bám rồi so sánh biến thiên để ghép thứ tự.", "wrong_options": null, "difficulty_source": "So sánh khối lượng ròng theo đúng hệ số phản ứng.", "discrimination": "medium", "typical_steps": 4, "refs": ["0ccfacf4a5ac|P3|2|None"]}, {"part_kind": "short_answer", "topic": "Xét từng phần tử rồi đếm theo tiêu chí", "grade": null, "construction": "Cho danh sách chất hoặc biện pháp; áp dụng cùng tiêu chí cho từng phần tử, phân biệt các trường hợp gần nhau rồi đếm phần tử thỏa yêu cầu.", "wrong_options": null, "difficulty_source": "Giữ nguyên tiêu chí đếm, phân biệt có tác động với tác động theo chiều mong muốn và không khái quát các chất gần nhau.", "discrimination": "medium", "typical_steps": 3, "refs": ["0ccfacf4a5ac|P3|3|None", "cd005a72af60|P3|1|None", "cd005a72af60|P3|2|None"]}, {"part_kind": "short_answer", "topic": "Tính lượng hóa chất từ mục tiêu xử lí", "grade": null, "construction": "Cho trạng thái đích hoặc lượng sản phẩm cần có; suy lượng chất thực sự cần chuyển hóa, dùng tỉ lượng hay phần khối lượng rồi hiệu chỉnh độ tinh khiết hoặc hiệu suất cấp liệu.", "wrong_options": null, "difficulty_source": "Chọn đúng lượng cần biến đổi và đúng chiều hiệu chỉnh; với polymer phải đọc việc có tách chất nhỏ hay không.", "discrimination": "medium", "typical_steps": 4, "refs": ["0ccfacf4a5ac|P3|4|None", "cd005a72af60|P3|4|None"]}, {"part_kind": "short_answer", "topic": "Cắt peptide theo quy tắc và đếm loại sản phẩm", "grade": 12, "construction": "Cho chuỗi và quy tắc cắt; đánh dấu đúng phía liên kết, chia các đoạn, lọc theo độ dài rồi loại các đoạn trùng loại.", "wrong_options": null, "difficulty_source": "Phân biệt chiều cắt, số mảnh và số loại mảnh.", "discrimination": "medium", "typical_steps": 4, "refs": ["0ccfacf4a5ac|P3|5|None"]}, {"part_kind": "short_answer", "topic": "Chuỗi quy đổi năng lượng, nguyên liệu và sản phẩm", "grade": null, "construction": "Cho thành phần nhiên liệu, dữ liệu nhiệt hóa học và các hiệu suất; tính nhiệt và sản phẩm khí trên cùng cơ sở, suy lượng nhiên liệu từ năng lượng hữu ích rồi nối sang lượng sản phẩm thương phẩm.", "wrong_options": null, "difficulty_source": "Duy trì cơ sở hỗn hợp, đơn vị và chiều hiệu suất qua chuỗi quy đổi.", "discrimination": "medium", "typical_steps": 6, "refs": ["0ccfacf4a5ac|P3|6|None"]}, {"part_kind": "short_answer", "topic": "Điện lượng và phối trộn dưới ràng buộc vận hành", "grade": null, "construction": "Cho phản ứng và điều kiện vận hành; chuyển điều kiện kết thúc hoặc điều kiện bảo toàn thành giới hạn lượng chất, xác định lượng thực sự tham gia rồi quy đổi sang thời gian hoặc khối lượng cấp.", "wrong_options": null, "difficulty_source": "Phải lập đúng ràng buộc trước khi tính; mô hình áp suất cần các điều kiện khí khác ổn định, chưa được phát biểu đầy đủ trong dữ liệu.", "discrimination": "high", "typical_steps": 5, "refs": ["cd005a72af60|P3|5|None", "cd005a72af60|P3|6|None"]}], "discrimination_moves": [{"move": "Buộc kiểm tra miền hiệu lực của kết luận", "how_to_apply": "Đưa xu hướng thực nghiệm kèm phát biểu vượt miền khảo sát; yêu cầu xét cơ chế có thể làm xu hướng mất hiệu lực. Đây là thao tác quan sát ở hàng phân hóa cao, chưa xác nhận lặp lại giữa các đề.", "refs": ["0ccfacf4a5ac|P2|3|a"]}, {"move": "Phân biệt quan sát với khẳng định chắc chắn", "how_to_apply": "Giữ dữ liệu đúng nhưng nâng mức khẳng định của nhận định; lời giải phải chỉ ra phần kết luận chưa được bằng chứng bảo đảm.", "refs": ["0ccfacf4a5ac|P2|3|a"]}, {"move": "Chuyển điều kiện vĩ mô thành phương trình lượng chất", "how_to_apply": "Dùng yêu cầu vận hành để buộc người giải lập quan hệ giữa lượng khí bị lấy đi và sinh ra. Cần phát biểu rõ các giả thiết vật lí làm cầu nối.", "refs": ["cd005a72af60|P3|6|None"]}, {"move": "Phối hợp các đóng góp trái chiều", "how_to_apply": "Cho các thành phần có tác động khác chiều lên đại lượng cần giữ; tỉ lệ phối trộn phải được suy từ ràng buộc chung thay vì cho sẵn.", "refs": ["cd005a72af60|P3|6|None"]}, {"move": "Đặt bước chọn mô hình trước chuỗi tính toán", "how_to_apply": "Chỉ sau khi cân bằng phản ứng và diễn giải điều kiện vận hành mới có thể suy thành phần, quy mô cấp và mức dư. Sự phân hóa nằm ở việc thiết lập quan hệ, không chỉ ở độ dài phép tính.", "refs": ["cd005a72af60|P3|6|None"]}], "easy_vs_hard": [{"topic": "Dữ liệu thực nghiệm theo nhiệt độ", "easy": "Đọc chiều biến đổi ngay trong miền dữ liệu.", "hard": "Kiểm tra kết luận ngoài miền khảo sát bằng giới hạn hoạt động của hệ.", "easy_refs": ["0ccfacf4a5ac|P2|3|c"], "hard_refs": ["0ccfacf4a5ac|P2|3|a"]}, {"topic": "Polymer và cấu tạo", "easy": "Ghép tên quen thuộc với mắt xích hoặc nhận ra nhóm chức tiền chất.", "hard": "Phục hồi monomer, kiểm tra khả năng kéo dài mạch và đọc quy tắc cộng khối lượng trước khi tính nguyên liệu.", "easy_refs": ["cd005a72af60|P1|5|None", "0ccfacf4a5ac|P2|1|a"], "hard_refs": ["cd005a72af60|P1|12|None", "cd005a72af60|P3|4|None"]}, {"topic": "Điện hóa", "easy": "Nhớ vị trí tương đối hoặc gán vai trò điện cực khi chiều phản ứng đã rõ.", "hard": "Suy lượng electron thực tế từ phần vật liệu hữu ích hoặc chất giới hạn rồi đổi sang thời gian.", "easy_refs": ["cd005a72af60|P1|14|None", "0ccfacf4a5ac|P2|4|d"], "hard_refs": ["0ccfacf4a5ac|P2|4|b", "cd005a72af60|P3|5|None"]}, {"topic": "Nhận biết hữu cơ", "easy": "Liên hệ thuốc thử với phản ứng đặc trưng của lớp chất.", "hard": "Phối hợp nhiều hiện tượng, điều kiện phản ứng và ràng buộc gán mẫu để loại trừ.", "easy_refs": ["cd005a72af60|P1|16|None"], "hard_refs": ["cd005a72af60|P1|18|None", "0ccfacf4a5ac|P3|1|None"]}, {"topic": "Lượng hóa chất dùng trong xử lí", "easy": "Chọn chất dựa trên tính acid – base hoặc quy đổi trực tiếp bằng hàm lượng.", "hard": "Suy lượng cần xử lí từ trạng thái đích hoặc lập ràng buộc phối trộn trước khi tính lượng cấp.", "easy_refs": ["cd005a72af60|P1|9|None", "cd005a72af60|P1|13|None"], "hard_refs": ["0ccfacf4a5ac|P3|4|None", "cd005a72af60|P3|6|None"]}], "fact_use": {"common": [{"use": "Tên gọi và tên viết tắt đóng vai trò đầu vào để truy hồi cấu tạo; kiến thức nhớ được thường phải chuyển thành dấu hiệu cấu trúc.", "refs": ["0ccfacf4a5ac|P1|14|None", "cd005a72af60|P1|5|None", "126f1b46d648|P1|2|None"]}, {"use": "Thuộc tính, phân loại và phản ứng đặc trưng được dùng trực tiếp trong câu nhận diện, đồng thời tạo nhiễu bằng các lớp chất gần nhau.", "refs": ["0ccfacf4a5ac|P1|18|None", "cd005a72af60|P1|8|None", "cd005a72af60|P1|16|None", "cd005a72af60|P3|1|None", "126f1b46d648|P1|3|None"]}, {"use": "Định nghĩa được vận dụng qua tiêu chí quyết định như thành phần, điện tích, số proton hoặc loại liên kết; nhận ra thuật ngữ thôi chưa đủ.", "refs": ["cd005a72af60|P1|15|None", "0ccfacf4a5ac|P2|1|b", "0ccfacf4a5ac|P2|2|c", "cd005a72af60|P2|4|a", "cd005a72af60|P2|4|d"]}, {"use": "Dữ liệu chuyên biệt như khoảng phổ, ngưỡng phân loại, nhiệt hóa học hoặc dung lượng được cung cấp để đọc và tính; trọng tâm là chọn dữ kiện và quan hệ thích hợp.", "refs": ["cd005a72af60|P1|1|None", "126f1b46d648|P1|5|None", "0ccfacf4a5ac|P3|6|None", "cd005a72af60|P2|2|d"]}, {"use": "Kiến thức nhớ phải phục tùng điều kiện thực tế của quy trình; tác nhân có thể gây hiện tượng nói chung chưa chắc là tác nhân đang có mặt.", "refs": ["cd005a72af60|P1|2|None", "0ccfacf4a5ac|P2|3|d", "cd005a72af60|P2|3|b"]}], "not_observed": [{"use": "Không thấy yêu cầu nhớ mốc lịch sử, người phát hiện hoặc xuất xứ tên gọi; tên trong các hàng được dùng để nhận diện chất và cấu tạo.", "refs": ["0ccfacf4a5ac|P1|14|None", "cd005a72af60|P1|5|None", "126f1b46d648|P1|2|None"]}, {"use": "Không thấy yêu cầu tự nhớ chính xác các bộ dữ liệu chuyên biệt đã được cấp trong đề; chúng làm đầu vào cho đối chiếu và suy luận.", "refs": ["cd005a72af60|P1|1|None", "126f1b46d648|P1|5|None", "0ccfacf4a5ac|P3|6|None", "cd005a72af60|P2|2|d"]}], "limit": "Các nhận xét không xuất hiện chỉ áp dụng cho tập hàng được cung cấp; không chứng minh sự vắng mặt trong các đề khác."}, "anti_patterns": [{"anti_pattern": "Tạo nhiễu khác biệt tùy tiện, không gắn với cấu tạo hoặc sai lầm hóa học gần đáp án.", "basis": "Các hàng có cơ chế nhiễu rõ dùng việc đổi gốc, bỏ điện tích, nhầm nhóm chức hoặc đảo chiều electron. Không nên ép gán lỗi cụ thể cho giá trị nhiễu chưa đủ bằng chứng.", "refs": ["0ccfacf4a5ac|P1|14|None", "cd005a72af60|P1|10|None", "cd005a72af60|P1|16|None", "cd005a72af60|P1|3|None", "cd005a72af60|P1|13|None"]}, {"anti_pattern": "Dùng tên chủ đề hoặc tính chất quen thuộc thay cho việc đọc điều kiện phản ứng.", "basis": "Các hàng phân biệt tác nhân có mặt, vai trò thực tế, điều kiện dư và môi trường phản ứng; không hỗ trợ cách giải chỉ dựa vào từ khóa.", "refs": ["cd005a72af60|P1|2|None", "126f1b46d648|P1|4|None", "0ccfacf4a5ac|P2|3|d", "cd005a72af60|P2|3|b"]}, {"anti_pattern": "Biến xu hướng cục bộ thành quy luật chắc chắn ngoài miền dữ liệu.", "basis": "Việc ngoại suy không xét giới hạn hoạt động được dùng làm nhận định sai.", "refs": ["0ccfacf4a5ac|P2|3|a"]}, {"anti_pattern": "Gắn mức phân hóa cao chỉ vì bài có chuỗi tính toán dài.", "basis": "Chuỗi quy đổi năng lượng và sản phẩm được đánh giá ở mức trung bình; hàng mức cao đòi hỏi diễn giải điều kiện vận hành thành ràng buộc phối trộn.", "refs": ["0ccfacf4a5ac|P3|6|None", "cd005a72af60|P3|6|None"]}, {"anti_pattern": "Cho phép suy luận nhận biết chỉ từ hiện tượng không duy nhất và bỏ các ràng buộc còn lại.", "basis": "Bảng nhận biết đòi hỏi phối hợp kết quả và giữ quan hệ gán chất với mẫu.", "refs": ["cd005a72af60|P1|18|None"]}, {"anti_pattern": "Đồng nhất số lượng xuất hiện với số loại hoặc bỏ thứ tự mã hóa đầu ra.", "basis": "Các hàng yêu cầu loại sản phẩm trùng và xuất nhãn theo thứ tự được chỉ định.", "refs": ["0ccfacf4a5ac|P3|5|None", "0ccfacf4a5ac|P3|1|None", "cd005a72af60|P3|3|None"]}]}, {"evidence_scope": "Các hàng đều thuộc cùng một đề nguồn bên thứ ba cấp tỉnh. Vì vậy, các mẫu dưới đây mô tả cách dựng câu quan sát được trong đề; chưa đủ bằng chứng xác nhận sự lặp lại giữa các đề. Không suy lớp học khi dữ liệu không xác nhận.", "patterns": [{"part_kind": "multiple_choice", "topic": "Carbohydrate và thủy phân", "grade": null, "construction": "Cho tên carbohydrate; yêu cầu tìm chất không thủy phân thành carbohydrate đơn giản hơn; phân loại theo mức độ cấu tạo rồi xét khả năng phân cắt liên kết giữa các đơn vị đường.", "wrong_options": "Đặt các chất có thể thủy phân cạnh chất không thể thủy phân; khai thác nhầm lẫn giữa khó tan, khó phản ứng và không có liên kết để thủy phân.", "difficulty_source": "Nhận diện nhóm cấu tạo từ tên chất.", "discrimination": "low", "typical_steps": 2, "refs": ["126f1b46d648|P1|6|None"]}, {"part_kind": "multiple_choice", "topic": "Hydrocarbon và phép thử oxi hóa", "grade": null, "construction": "Cho các hydrocarbon và điều kiện thử; nhận diện kiểu liên kết rồi chọn chất phản ứng được trong chính điều kiện đó.", "wrong_options": "Đánh đồng liên kết thơm với liên kết không no thông thường hoặc coi khả năng bị oxi hóa nói chung là khả năng phản ứng trong phép thử.", "difficulty_source": "Ghép cấu tạo với điều kiện phản ứng.", "discrimination": "low", "typical_steps": 2, "refs": ["126f1b46d648|P1|7|None"]}, {"part_kind": "multiple_choice", "topic": "Điện phân và mạ điện", "grade": null, "construction": "Cho hệ mạ gồm vật nền, điện cực và dung dịch; xác định nơi nhận lớp mạ, tiểu phân bị khử rồi chọn bán phản ứng.", "wrong_options": "Đảo vai trò điện cực, chọn phản ứng của dung môi hoặc lấy thành phần vật nền thay cho ion tạo lớp mạ.", "difficulty_source": "Nối chức năng của điện cực với nguồn vật chất tạo sản phẩm.", "discrimination": "medium", "typical_steps": 3, "refs": ["126f1b46d648|P1|8|None"]}, {"part_kind": "multiple_choice", "topic": "Protein và hiện tượng thí nghiệm", "grade": null, "construction": "Cho các cách xử lí protein; ghép điều kiện với đông tụ hoặc phản ứng màu rồi chọn mô tả không phù hợp.", "wrong_options": "Các hiện tượng đúng làm nhiễu cho yêu cầu chọn sai; điểm sai khai thác việc lẫn màu thuốc thử với màu sản phẩm.", "difficulty_source": "Phân biệt các phép thử và đọc đúng chiều yêu cầu.", "discrimination": "medium", "typical_steps": 3, "refs": ["126f1b46d648|P1|9|None"]}, {"part_kind": "multiple_choice", "topic": "Thành phần hợp kim", "grade": null, "construction": "Cho tên hợp kim; nhớ thành phần cơ bản và phân biệt kim loại nền với nguyên tố phụ gia để lựa chọn.", "wrong_options": "Dùng kim loại nền của họ vật liệu khác hoặc nguyên tố phụ gia làm đáp án thay thế.", "difficulty_source": "Nhớ đúng vai trò thành phần trong vật liệu.", "discrimination": "low", "typical_steps": 2, "refs": ["126f1b46d648|P1|10|None"]}, {"part_kind": "multiple_choice", "topic": "Kết tủa hydroxide kim loại", "grade": null, "construction": "Cho thao tác trộn dung dịch; xác định hydroxide tạo thành rồi suy trạng thái và màu để chọn hiện tượng.", "wrong_options": "Thay màu sản phẩm bằng màu hydroxide khác hoặc màu của hệ tạo phức.", "difficulty_source": "Gọi lại đặc điểm quan sát của sản phẩm sau khi xác định phản ứng.", "discrimination": "low", "typical_steps": 2, "refs": ["126f1b46d648|P1|11|None"]}, {"part_kind": "multiple_choice", "topic": "Polymer và phân loại tơ", "grade": null, "construction": "Cho các nhận định về phản ứng, điều chế, thành phần và nguồn gốc vật liệu; kiểm tra từng thuộc tính để chọn nhận định đúng.", "wrong_options": "Chuyển thuộc tính giữa các nhóm gần nhau: kiểu tạo polymer, thành phần nguyên tố và nguồn gốc của tơ.", "difficulty_source": "Phân biệt các tiêu chí phân loại thay vì dựa vào tên nhóm vật liệu.", "discrimination": "medium", "typical_steps": 3, "refs": ["126f1b46d648|P1|12|None"]}, {"part_kind": "multiple_choice", "topic": "Kim loại cùng nhóm và phương pháp điều chế", "grade": null, "construction": "Cho các nhận định về cấu tạo, xu hướng tính chất và điều chế; kiểm tra từng nhận định rồi chọn tổng số nhận định đúng.", "wrong_options": "Các tổng số sai phản ánh việc đánh giá nhầm các nhận định thành phần; không thể suy duy nhất lỗi từ phương án số đếm.", "difficulty_source": "Kết hợp xu hướng nhóm với sự cạnh tranh phản ứng trong môi trường điện phân.", "discrimination": "medium", "typical_steps": 4, "refs": ["126f1b46d648|P1|13|None"]}, {"part_kind": "multiple_choice", "topic": "Quan hệ đồng đẳng", "grade": null, "construction": "Cho các cặp công thức; kiểm tra nhóm chức, kiểu cấu tạo và quan hệ biến đổi mạch carbon để nhận diện cặp đồng đẳng.", "wrong_options": "Các cặp chỉ giống thành phần, có nhóm chức gần nhau hoặc cùng công thức phân tử nhưng không thỏa đầy đủ điều kiện.", "difficulty_source": "Dùng đồng thời các điều kiện của quan hệ đồng đẳng.", "discrimination": "low", "typical_steps": 2, "refs": ["126f1b46d648|P1|14|None"]}, {"part_kind": "multiple_choice", "topic": "Danh pháp oxide", "grade": null, "construction": "Cho công thức cùng đoạn dẫn ứng dụng hoặc tác động; đọc thành phần và chỉ số để chọn tên tương ứng.", "wrong_options": "Hoán đổi tiền tố, bỏ qua chỉ số hoặc dùng tên của oxide khác cùng nguyên tố.", "difficulty_source": "Ánh xạ đúng công thức sang quy tắc gọi tên; đoạn dẫn không tạo thêm bước suy luận.", "discrimination": "low", "typical_steps": 2, "refs": ["126f1b46d648|P1|15|None"]}, {"part_kind": "multiple_choice", "topic": "Bậc amine", "grade": null, "construction": "Cho tên amine; suy các gốc hydrocarbon gắn trực tiếp với nitrogen rồi xác định bậc.", "wrong_options": "Đánh tráo số gốc gắn trực tiếp với độ dài gốc hoặc số hydrogen còn lại.", "difficulty_source": "Đọc quan hệ liên kết từ tên gọi.", "discrimination": "low", "typical_steps": 2, "refs": ["126f1b46d648|P1|16|None"]}, {"part_kind": "multiple_choice", "topic": "Ester hóa và lượng nguyên liệu", "grade": null, "construction": "Cho nhu cầu sản phẩm, hàm lượng, phản ứng và hiệu suất; quy về lượng hoạt chất, dùng tỉ lượng rồi tính ngược đầu vào và đổi đơn vị.", "wrong_options": "Bỏ qua hiệu suất, áp dụng ngược chiều hoặc hiệu chỉnh tổn thất lặp lại.", "difficulty_source": "Xác định chiều áp dụng hiệu suất khi đi từ nhu cầu đầu ra về nguyên liệu.", "discrimination": "medium", "typical_steps": 4, "refs": ["126f1b46d648|P1|17|None"]}, {"part_kind": "multiple_choice", "topic": "Cấu tạo hữu cơ tạp chức", "grade": null, "construction": "Cho hình cấu tạo và các nhận định; xác định môi trường liên kết của nhóm chức, suy phản ứng và kiểm tra thành phần để chọn nhận định không phù hợp.", "wrong_options": "Dùng các hệ quả đúng của cấu tạo làm nhiễu; điểm sai nằm ở việc gán nhầm loại nhóm chức.", "difficulty_source": "Đọc nhóm chức theo môi trường liên kết và theo dõi nguyên tử ngầm trong công thức khung.", "discrimination": "medium", "typical_steps": 3, "refs": ["126f1b46d648|P1|18|None"]}, {"part_kind": "true_false", "topic": "Bố trí dụng cụ chuẩn độ", "grade": null, "construction": "Cho quy trình chuẩn độ; xác định hỗn hợp cần theo dõi điểm kết thúc rồi kiểm tra vị trí đặt chỉ thị.", "wrong_options": "Mệnh đề sai chuyển chỉ thị sang bộ phận chứa dung dịch chuẩn.", "difficulty_source": "Phân biệt chức năng của dụng cụ cấp dung dịch với bình phản ứng.", "discrimination": "low", "typical_steps": 2, "refs": ["126f1b46d648|P2|1|a"]}, {"part_kind": "true_false", "topic": "Kiểm chứng giả thuyết bằng bảng thực nghiệm", "grade": null, "construction": "Cho giả thuyết về xu hướng và bảng kết quả; xác định dự báo, so sánh các mẫu trên cùng cơ sở rồi tìm dữ liệu không phù hợp.", "wrong_options": null, "difficulty_source": "Ưu tiên bằng chứng trong bảng thay cho xu hướng trực giác; không suy hiệu suất định lượng khi cơ sở khối lượng chưa rõ.", "discrimination": "medium", "typical_steps": 3, "refs": ["126f1b46d648|P2|1|b"]}, {"part_kind": "true_false", "topic": "Hiệu suất và cân bằng khối lượng hệ mở", "grade": null, "construction": "Cho nồng độ đầu, nồng độ sản phẩm và giả thiết về thất thoát; đặt lượng chuyển hóa, tính phần vật chất từ ngoài đi vào rồi lập nồng độ theo khối lượng sau phản ứng để kiểm tra hiệu suất.", "wrong_options": "Đồng nhất việc không thất thoát do bay hơi với việc khối lượng dung dịch không đổi.", "difficulty_source": "Nhận ra mẫu số nồng độ thay đổi khi hệ nhận thêm chất khí.", "discrimination": "high", "typical_steps": 4, "refs": ["126f1b46d648|P2|1|c"]}, {"part_kind": "true_false", "topic": "Tốc độ phản ứng từ dữ liệu theo thời gian", "grade": null, "construction": "Cho bảng nồng độ theo thời gian và kết luận về tốc độ; chuyển giá trị tích lũy thành độ biến thiên trên khoảng thời gian rồi tìm trường hợp bác bỏ kết luận.", "wrong_options": "Coi nồng độ sản phẩm tăng là bằng chứng tốc độ luôn tăng.", "difficulty_source": "Phân biệt mức tích lũy với tốc độ biến đổi.", "discrimination": "medium", "typical_steps": 3, "refs": ["126f1b46d648|P2|1|d"]}, {"part_kind": "true_false", "topic": "Oxi hóa và khử trong luyện kim", "grade": null, "construction": "Cho phương trình phản ứng; theo dõi số oxi hóa của nguyên tố rồi kiểm tra tên quá trình được gán cho chất.", "wrong_options": "Đảo tên quá trình oxi hóa và quá trình khử.", "difficulty_source": "Đọc đúng chiều biến đổi số oxi hóa.", "discrimination": "low", "typical_steps": 3, "refs": ["126f1b46d648|P2|2|a"]}, {"part_kind": "true_false", "topic": "Điều kiện vận hành luyện kim", "grade": null, "construction": "Cho quy trình có sản phẩm dạng hơi và môi trường áp suất thấp; liên hệ điều kiện vật lí với tách sản phẩm và hạn chế phản ứng phụ để đánh giá lời giải thích.", "wrong_options": null, "difficulty_source": "Kết hợp vai trò vật lí và hóa học của cùng điều kiện vận hành.", "discrimination": "medium", "typical_steps": 3, "refs": ["126f1b46d648|P2|2|b"]}, {"part_kind": "true_false", "topic": "Trao đổi nhiệt khi chuyển trạng thái", "grade": null, "construction": "Cho chiều chuyển trạng thái; xác định chiều trao đổi nhiệt rồi kiểm tra mô tả thu nhiệt hoặc tỏa nhiệt.", "wrong_options": "Gán chiều trao đổi nhiệt của quá trình ngược lại.", "difficulty_source": "Nhớ và áp dụng chiều trao đổi nhiệt của chuyển pha.", "discrimination": "low", "typical_steps": 2, "refs": ["126f1b46d648|P2|2|c"]}, {"part_kind": "true_false", "topic": "Sản lượng kim loại từ nguyên liệu có tạp chất", "grade": null, "construction": "Cho lượng nguyên liệu, hàm lượng thành phần có ích, hiệu suất và quy cách sản phẩm; tách tạp chất, tính lượng kim loại lí thuyết, hiệu chỉnh hiệu suất rồi kiểm tra sản lượng.", "wrong_options": null, "difficulty_source": "Giữ đúng thứ tự các phép quy đổi thành phần và hiệu suất.", "discrimination": "medium", "typical_steps": 4, "refs": ["126f1b46d648|P2|2|d"]}, {"part_kind": "true_false", "topic": "Bán phản ứng ăn mòn tại anode", "grade": null, "construction": "Cho môi trường ăn mòn và bán phản ứng đề xuất; xác định nơi nhường electron, sản phẩm trực tiếp rồi kiểm tra toàn bộ mệnh đề.", "wrong_options": "Ghép vai trò điện cực đúng với sản phẩm có mức oxi hóa không phù hợp ở giai đoạn ban đầu.", "difficulty_source": "Phân biệt sản phẩm trực tiếp với sản phẩm biến đổi tiếp theo.", "discrimination": "medium", "typical_steps": 3, "refs": ["126f1b46d648|P2|3|a"]}, {"part_kind": "true_false", "topic": "Thành phần sản phẩm ăn mòn", "grade": null, "construction": "Cho mô tả lớp sản phẩm ăn mòn; nhớ dạng thành phần quen thuộc rồi đối chiếu công thức được đề xuất.", "wrong_options": null, "difficulty_source": "Nhận biết thành phần hóa học đã học.", "discrimination": "low", "typical_steps": 2, "refs": ["126f1b46d648|P2|3|b"]}, {"part_kind": "true_false", "topic": "Bảo vệ kim loại bằng anode hi sinh", "grade": null, "construction": "Cho đề xuất ghép kim loại; so sánh xu hướng nhường electron, xác định phần bị hòa tan rồi đánh giá khả năng bảo vệ.", "wrong_options": "Chọn kim loại bền hơn làm vật hi sinh vì nhầm độ bền với khả năng bảo vệ điện hóa.", "difficulty_source": "Suy vai trò điện cực từ tính khử thay vì từ trực giác về độ bền.", "discrimination": "medium", "typical_steps": 3, "refs": ["126f1b46d648|P2|3|c"]}, {"part_kind": "true_false", "topic": "Phân loại cơ chế ăn mòn", "grade": null, "construction": "Cho vật liệu và môi trường bề mặt; kiểm tra vùng điện cực cùng môi trường dẫn ion rồi phân loại cơ chế.", "wrong_options": "Phân loại theo tên tác nhân mà bỏ qua điều kiện tạo pin cục bộ.", "difficulty_source": "Nhận diện điều kiện điện hóa trong mô tả.", "discrimination": "low", "typical_steps": 2, "refs": ["126f1b46d648|P2|3|d"]}, {"part_kind": "true_false", "topic": "Cấu hình hình học của polymer", "grade": null, "construction": "Cho hình đoạn mạch; theo dõi các nhánh mạch chính quanh liên kết đôi rồi kiểm tra nhận định về cấu hình trên toàn hình.", "wrong_options": null, "difficulty_source": "Giữ đúng nhận diện nhánh mạch khi hướng vẽ thay đổi.", "discrimination": "medium", "typical_steps": 3, "refs": ["126f1b46d648|P2|4|a"]}, {"part_kind": "true_false", "topic": "Biến đổi cấu trúc mạng polymer", "grade": null, "construction": "Cho sơ đồ hình thành cầu nối giữa các mạch; phân biệt khung mạch ban đầu với cấu trúc mạng mới rồi đánh giá cách gọi loại phản ứng.", "wrong_options": null, "difficulty_source": "Ranh giới cách gọi trong khóa chưa thống nhất với sơ đồ; mức phân hóa dưới đây chỉ là ước lượng theo thao tác đọc cấu trúc, chưa được xác nhận theo khóa.", "discrimination": "medium", "typical_steps": 3, "refs": ["126f1b46d648|P2|4|b"]}, {"part_kind": "true_false", "topic": "Cấu trúc mạng và tính chất polymer", "grade": null, "construction": "Cho sơ đồ tạo cầu nối và nhận định tính chất; suy mức hạn chế trượt giữa các mạch rồi liên hệ với độ bền và khả năng phục hồi hình dạng.", "wrong_options": null, "difficulty_source": "Áp dụng quan hệ cấu trúc và tính chất trong phạm vi biến đổi vật liệu thông thường.", "discrimination": "low", "typical_steps": 2, "refs": ["126f1b46d648|P2|4|c"]}, {"part_kind": "true_false", "topic": "Mật độ cầu nối trong polymer", "grade": null, "construction": "Cho phần khối lượng nguyên tố và mô tả thay thế nguyên tử; chọn cơ sở theo cầu nối, lập khối lượng mạng sau biến đổi rồi giải quan hệ thành phần để kiểm tra mật độ.", "wrong_options": "Giá trị đề xuất không thỏa cân bằng thành phần; không đủ bằng chứng quy về duy nhất một phép tính sai.", "difficulty_source": "Chuyển mô tả liên kết và thay thế nguyên tử thành mẫu số khối lượng.", "discrimination": "medium", "typical_steps": 4, "refs": ["126f1b46d648|P2|4|d"]}, {"part_kind": "short_answer", "topic": "Hydrocarbon và phép thử cộng", "grade": null, "construction": "Cho tập hydrocarbon và điều kiện thử; xác định vị trí không no có khả năng phản ứng, loại trường hợp cần điều kiện khác rồi đếm chất phù hợp.", "wrong_options": null, "difficulty_source": "Phân biệt liên kết ở mạch nhánh với liên kết trong hệ thơm.", "discrimination": "medium", "typical_steps": 3, "refs": ["126f1b46d648|P3|1|None"]}, {"part_kind": "short_answer", "topic": "Dự đoán phản ứng từ thế điện cực", "grade": null, "construction": "Cho bảng thế điện cực và môi trường phản ứng; chọn cặp đối chiếu, so sánh chiều thuận lợi rồi đếm kim loại đáp ứng.", "wrong_options": null, "difficulty_source": "Dùng đúng chiều so sánh dữ liệu đã được cung cấp.", "discrimination": "low", "typical_steps": 3, "refs": ["126f1b46d648|P3|2|None"]}, {"part_kind": "short_answer", "topic": "Cấu tạo và tính chất kim loại chuyển tiếp", "grade": null, "construction": "Cho các nhận định về cấu hình electron, vị trí và tính chất; kiểm tra phạm vi từng khẳng định, xét ngoại lệ rồi xuất nhãn đúng theo thứ tự.", "wrong_options": null, "difficulty_source": "Không áp dụng xu hướng chung thành khẳng định tuyệt đối cho cả dãy.", "discrimination": "medium", "typical_steps": 4, "refs": ["126f1b46d648|P3|3|None"]}, {"part_kind": "short_answer", "topic": "Suy cấu tạo amine từ dữ kiện thành phần", "grade": null, "construction": "Cho thành phần nguyên tố và ràng buộc cấu trúc; suy công thức phân tử, phân bổ khung carbon, loại cấu tạo không thỏa rồi dự đoán tính chất để chọn nhãn đúng.", "wrong_options": null, "difficulty_source": "Kết hợp điều kiện định lượng với điều kiện loại trừ trước khi phân loại nhóm chức và suy phản ứng.", "discrimination": "high", "typical_steps": 5, "refs": ["126f1b46d648|P3|4|None"]}, {"part_kind": "short_answer", "topic": "Nhiệt phản ứng và cân bằng nhiệt", "grade": null, "construction": "Cho thành phần hỗn hợp, dữ liệu nhiệt hóa học và truyền nhiệt; kiểm tra chất giới hạn, tính nhiệt phản ứng, xác định nhiệt hữu ích rồi lập cân bằng nhiệt để suy trạng thái cuối.", "wrong_options": null, "difficulty_source": "Nối tỉ lượng hóa học với mô hình nhiệt lượng và hiệu suất truyền nhiệt.", "discrimination": "medium", "typical_steps": 5, "refs": ["126f1b46d648|P3|5|None"]}, {"part_kind": "short_answer", "topic": "Hiệu suất ester hóa từ dữ liệu thể tích", "grade": null, "construction": "Cho thể tích và khối lượng riêng của chất đầu cùng sản phẩm; đổi sang lượng chất, xác định chất giới hạn rồi so lượng thực tế với lượng lí thuyết.", "wrong_options": null, "difficulty_source": "Không so trực tiếp thể tích; phải quy về lượng chất và tỉ lượng phản ứng.", "discrimination": "medium", "typical_steps": 4, "refs": ["126f1b46d648|P3|6|None"]}], "discrimination_moves": [{"move": "Buộc xác định lại cơ sở khối lượng", "how_to_apply": "Cho hệ có trao đổi vật chất và dữ kiện nồng độ; lời giải phải xác định khối lượng sau biến đổi trước khi tính hiệu suất. Đây là thao tác nằm trực tiếp trong hàng được gắn mức phân hóa cao.", "refs": ["126f1b46d648|P2|1|c"]}, {"move": "Dùng giả thiết có phạm vi giới hạn", "how_to_apply": "Nêu giả thiết chỉ loại bỏ một cơ chế thất thoát; yêu cầu người giải không mở rộng giả thiết thành bảo toàn một đại lượng vẫn chịu tác động của cơ chế khác.", "refs": ["126f1b46d648|P2|1|c"]}, {"move": "Giấu cấu tạo sau dữ kiện thành phần", "how_to_apply": "Cung cấp thành phần nguyên tố và ràng buộc dị tố; buộc suy công thức phân tử trước khi có thể xét các nhận định tính chất.", "refs": ["126f1b46d648|P3|4|None"]}, {"move": "Dùng điều kiện loại trừ để khóa cấu tạo", "how_to_apply": "Kết hợp điều kiện khung phân tử với nhóm cấu trúc bị loại; người giải phải sử dụng cả điều kiện khẳng định và phủ định để chọn cấu tạo phù hợp.", "refs": ["126f1b46d648|P3|4|None"]}, {"move": "Phân loại theo vị trí liên kết rồi mới suy tính chất", "how_to_apply": "Đặt các cấu tạo có cùng loại nhóm chức và cùng đặc điểm khung gần nhau; yêu cầu xét vị trí gắn trực tiếp của nhóm chức thay vì phân loại theo sự hiện diện của một mảnh cấu trúc.", "refs": ["126f1b46d648|P3|4|None"]}, {"move": "Dùng kết quả suy cấu tạo làm đầu vào cho chùm nhận định", "how_to_apply": "Sau bước xác định cấu tạo, yêu cầu đánh giá phân loại và phản ứng; tính nhất quán giữa các kết luận phụ thuộc vào việc giải đúng cấu tạo ban đầu.", "refs": ["126f1b46d648|P3|4|None"]}], "easy_vs_hard": [{"topic": "Amine", "easy": {"construction": "Đọc tên để xác định các gốc gắn trực tiếp với nitrogen rồi phân loại bậc.", "refs": ["126f1b46d648|P1|16|None"]}, "hard": {"construction": "Suy công thức và cấu tạo từ thành phần cùng điều kiện loại trừ, sau đó mới phân loại và dự đoán phản ứng.", "refs": ["126f1b46d648|P3|4|None"]}, "difference": "Chuyển từ nhận diện cấu tạo đã cho sang tái dựng cấu tạo làm điều kiện tiên quyết cho suy tính chất."}, {"topic": "Polymer", "easy": {"construction": "Nhận ra cầu nối trong sơ đồ rồi liên hệ với tính chất vật liệu.", "refs": ["126f1b46d648|P2|4|c"]}, "hard": {"construction": "Biểu diễn việc thêm cầu nối và mất nguyên tử thành quan hệ khối lượng để suy mật độ liên kết.", "refs": ["126f1b46d648|P2|4|d"]}, "difference": "Chuyển từ quan hệ cấu trúc và tính chất định tính sang mô hình thành phần định lượng; dạng khó hơn ở đây được gắn mức trung bình."}, {"topic": "Ăn mòn kim loại", "easy": {"construction": "Nhớ thành phần lớp sản phẩm hoặc nhận diện môi trường đủ điều kiện ăn mòn điện hóa.", "refs": ["126f1b46d648|P2|3|b", "126f1b46d648|P2|3|d"]}, "hard": {"construction": "Kiểm tra sản phẩm trực tiếp tại điện cực hoặc suy kim loại phải hi sinh trong cặp tiếp xúc.", "refs": ["126f1b46d648|P2|3|a", "126f1b46d648|P2|3|c"]}, "difference": "Chuyển từ nhận diện kiến thức sang phân tích cơ chế và chiều chuyển electron; dạng khó hơn ở đây được gắn mức trung bình."}, {"topic": "Lên men", "easy": {"construction": "Đọc bảng để đối chiếu xu hướng dự báo với kết quả thực nghiệm.", "refs": ["126f1b46d648|P2|1|b"]}, "hard": {"construction": "Dựng cân bằng khối lượng có chất khí tham gia rồi dùng nồng độ cuối để suy hiệu suất.", "refs": ["126f1b46d648|P2|1|c"]}, "difference": "Chuyển từ so sánh dữ liệu sang xác định đại lượng nền bị thay đổi; dạng dễ hơn ở đây vẫn được gắn mức trung bình."}, {"topic": "Năng lượng hóa học", "easy": {"construction": "Xác định chiều trao đổi nhiệt từ chiều chuyển trạng thái.", "refs": ["126f1b46d648|P2|2|c"]}, "hard": {"construction": "Tính nhiệt phản ứng từ dữ liệu nhiệt hóa học rồi nối với nhiệt hữu ích và cân bằng nhiệt.", "refs": ["126f1b46d648|P3|5|None"]}, "difference": "Chuyển từ nhận biết chiều năng lượng sang kết nối các mô hình định lượng; dạng khó hơn ở đây được gắn mức trung bình."}], "fact_use": {"scope": "Các nhận xét chỉ áp dụng cho những hàng được cung cấp, chưa xác nhận là đặc điểm lặp lại giữa các đề.", "observed_uses": [{"use": "Hỏi trực tiếp kiến thức nhận diện", "description": "Tên vật liệu, công thức và mô tả sản phẩm được dùng để gọi lại thành phần, danh pháp hoặc đặc điểm hóa học đã học.", "refs": ["126f1b46d648|P1|10|None", "126f1b46d648|P1|15|None", "126f1b46d648|P2|3|b"]}, {"use": "Dùng kiến thức nhớ làm mắt xích suy luận", "description": "Màu sản phẩm, điều kiện phản ứng, quy tắc phân loại và cấu hình electron được đặt sau bước nhận diện chất hoặc trước bước kiểm tra nhận định.", "refs": ["126f1b46d648|P1|7|None", "126f1b46d648|P1|9|None", "126f1b46d648|P1|11|None", "126f1b46d648|P1|14|None", "126f1b46d648|P1|16|None", "126f1b46d648|P3|3|None"]}, {"use": "Cung cấp dữ liệu chuyên biệt để xử lí", "description": "Thế điện cực, dữ liệu nhiệt hóa học, thành phần và thông số vật lí xuất hiện trong đầu bài hoặc bảng; trọng tâm là chọn quan hệ và mô hình tính.", "refs": ["126f1b46d648|P3|2|None", "126f1b46d648|P3|4|None", "126f1b46d648|P3|5|None", "126f1b46d648|P3|6|None"]}, {"use": "Đoạn dẫn có thể chỉ tạo ngữ cảnh", "description": "Có hàng đưa tác động môi trường vào phần dẫn nhưng thao tác giải vẫn là đọc công thức và gọi tên.", "refs": ["126f1b46d648|P1|15|None"]}], "not_observed": [{"description": "Không thấy yêu cầu nhớ ngày tháng, tiểu sử hoặc tên người; các tên được mô tả có vai trò nhận diện chất, nhóm chất hoặc vật liệu. Không suy rộng nhận xét này ra ngoài phần dữ liệu đã cung cấp.", "refs": ["126f1b46d648|P1|10|None", "126f1b46d648|P1|15|None", "126f1b46d648|P1|16|None"]}, {"description": "Không thấy yêu cầu tự nhớ các giá trị chuyên biệt trong những bài đã cho bảng thế điện cực hoặc dữ liệu nhiệt hóa học.", "refs": ["126f1b46d648|P3|2|None", "126f1b46d648|P3|5|None"]}]}, "anti_patterns": [{"avoid": "Tạo nhiễu chỉ khác câu chữ mà không gắn với lỗi hóa học", "basis": "Các nhiễu được mô tả dựa vào nhầm nhóm chức, vai trò điện cực, điều kiện phản ứng hoặc chiều hiệu suất.", "refs": ["126f1b46d648|P1|7|None", "126f1b46d648|P1|8|None", "126f1b46d648|P1|14|None", "126f1b46d648|P1|17|None"], "scope": "Không quan sát thấy nhiễu thuần câu chữ trong các hàng dẫn chứng."}, {"avoid": "Bỏ điều kiện khi đánh giá khả năng phản ứng", "basis": "Khả năng phản ứng được xét cùng điều kiện thử và vị trí liên kết, không chỉ theo tên họ chất.", "refs": ["126f1b46d648|P1|7|None", "126f1b46d648|P3|1|None"], "scope": "Áp dụng cho các phép thử được mô tả."}, {"avoid": "Biến ngữ cảnh thực tế thành phần kiến thức ngoài dữ kiện phải tra cứu", "basis": "Các chuỗi tính dùng thông số và quan hệ hóa học được cung cấp; không thấy yêu cầu tìm thêm dữ liệu thị trường, vận hành hoặc xã hội.", "refs": ["126f1b46d648|P1|17|None", "126f1b46d648|P2|2|d", "126f1b46d648|P3|5|None"], "scope": "Giới hạn ở các bài định lượng có ngữ cảnh được mô tả."}, {"avoid": "Đồng nhất bài dài với phân hóa cao", "basis": "Chuỗi tính nhiều công đoạn vẫn có thể chủ yếu là quy đổi quen thuộc; phân hóa cao được gắn với thay đổi cơ sở khối lượng hoặc suy cấu tạo bằng ràng buộc.", "refs": ["126f1b46d648|P2|2|d", "126f1b46d648|P3|5|None", "126f1b46d648|P2|1|c", "126f1b46d648|P3|4|None"], "scope": "Theo nhãn phân hóa của dữ liệu, không phải kết quả thống kê làm bài."}, {"avoid": "Yêu cầu lời giải tự luận mở trong dạng trả lời ngắn", "basis": "Đầu ra được mô tả là kết quả tính, số đếm hoặc nhãn nhận định theo thứ tự.", "refs": ["126f1b46d648|P3|1|None", "126f1b46d648|P3|2|None", "126f1b46d648|P3|3|None", "126f1b46d648|P3|4|None", "126f1b46d648|P3|5|None", "126f1b46d648|P3|6|None"], "scope": "Không thấy yêu cầu trình bày tự luận trong phần trả lời ngắn được cung cấp."}, {"avoid": "Tạo câu chỉ đọc hình mà không sử dụng quan hệ cấu tạo", "basis": "Hình được dùng để xác định nhóm chức, cấu hình hoặc biến đổi mạng trước khi kết luận tính chất hay thành phần.", "refs": ["126f1b46d648|P1|18|None", "126f1b46d648|P2|4|a", "126f1b46d648|P2|4|c", "126f1b46d648|P2|4|d"], "scope": "Áp dụng cho các hàng có hình cấu tạo được mô tả."}]}]
