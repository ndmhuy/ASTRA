{"samples":[{"id":"969218af6fe5a4ae","stem":"Sau khi một người khỏe mạnh uống nhiều nước, áp suất thẩm thấu của máu giảm. Trong cơ chế điều hòa nước, sự giảm này làm giảm tiết hormone ADH; ADH có tác dụng tăng tính thấm đối với nước của ống góp ở thận. So với trước khi uống nước, đáp ứng nào sau đây phù hợp với cơ chế trên? Giả sử các yếu tố khác không đổi.","options":[{"label":"A","text":"Ống góp tái hấp thụ nước ít hơn, nước tiểu loãng hơn."},{"label":"B","text":"Ống góp tái hấp thụ nước nhiều hơn, nước tiểu đậm đặc hơn."},{"label":"C","text":"Ống góp tái hấp thụ nước ít hơn, nước tiểu đậm đặc hơn."},{"label":"D","text":"Ống góp tái hấp thụ nước nhiều hơn, nước tiểu loãng hơn."}],"statements":[],"answers":[{"sub":null,"answer":"A","level":"TH"}],"solution":"Áp suất thẩm thấu của máu giảm làm giảm tiết ADH. Khi lượng ADH giảm, tính thấm đối với nước của ống góp giảm, nên nước được tái hấp thụ ít hơn và nước tiểu loãng hơn. Đáp ứng này giúp cơ thể thải bớt nước.","distractors":[{"label":"B","sub":null,"mistake":"Đảo chiều tác dụng của việc giảm tiết ADH, cho rằng thận tăng giữ nước.","why_plausible":"Học sinh nhớ ADH liên quan đến giữ nước nhưng không theo dõi sự giảm nồng độ hormone trong tình huống."},{"label":"C","sub":null,"mistake":"Xác định đúng sự giảm tái hấp thụ nước nhưng suy ra sai độ đậm đặc của nước tiểu.","why_plausible":"Học sinh nhầm nước ít được đưa trở lại máu với nước ít còn lại trong dịch tạo nước tiểu."},{"label":"D","sub":null,"mistake":"Nhận ra nước tiểu loãng hơn sau khi uống nhiều nước nhưng gắn kết quả đó với tăng tái hấp thụ nước.","why_plausible":"Học sinh biết đáp ứng thường gặp sau khi uống nước nhưng nhầm hướng vận chuyển nước ở ống góp."}],"level_reason":"Học sinh diễn giải các quan hệ điều hòa đã cho và xác định chiều biến đổi của tái hấp thụ nước cùng độ đậm đặc nước tiểu. Đây là vận dụng trực tiếp cơ chế quen thuộc, thuộc mức TH.","prerequisites":["Vai trò của ADH trong điều hòa tái hấp thụ nước ở thận.","Ý nghĩa của tái hấp thụ nước.","Quan hệ giữa lượng nước còn trong dịch ống thận và độ đậm đặc nước tiểu."],"variation_guidance":"Có thể thay bằng tình huống mất nước sau vận động và đảo chiều biến đổi áp suất thẩm thấu, đồng thời giữ rõ giả thiết các yếu tố khác không đổi.","uncertainties":[],"missing_assets":[]},{"id":"641c0f065e3baf8e","stem":"Khi quan sát một tế bào ở mô phân sinh đầu rễ hành đang nguyên phân, người ta ghi nhận: màng nhân đã tiêu biến; các nhiễm sắc thể kép xếp thành một hàng ở mặt phẳng giữa tế bào; hai chromatid chị em của mỗi nhiễm sắc thể vẫn gắn với nhau tại tâm động. Tế bào đang ở kì nào?","options":[{"label":"A","text":"Kì đầu."},{"label":"B","text":"Kì giữa."},{"label":"C","text":"Kì sau."},{"label":"D","text":"Kì cuối."}],"statements":[],"answers":[{"sub":null,"answer":"B","level":"TH"}],"solution":"Các nhiễm sắc thể kép xếp thành một hàng trên mặt phẳng xích đạo và chưa tách hai chromatid chị em là đặc điểm của kì giữa nguyên phân. Vì vậy chọn B.","distractors":[{"label":"A","sub":null,"mistake":"Dựa riêng vào dấu hiệu màng nhân tiêu biến để kết luận tế bào ở kì đầu.","why_plausible":"Học sinh nhớ biến đổi của màng nhân ở đầu quá trình phân bào nhưng bỏ qua vị trí sắp xếp của nhiễm sắc thể."},{"label":"C","sub":null,"mistake":"Nhầm sự tập trung của nhiễm sắc thể ở giữa tế bào với giai đoạn các chromatid chị em đã phân li.","why_plausible":"Học sinh chưa phân biệt trạng thái nhiễm sắc thể kép ở kì giữa với các nhiễm sắc thể đơn đang đi về hai cực ở kì sau."},{"label":"D","sub":null,"mistake":"Cho rằng nhiễm sắc thể đã sắp xếp ổn định đồng nghĩa với quá trình phân chia nhân sắp hoàn tất.","why_plausible":"Học sinh nhầm vị trí ở mặt phẳng giữa tế bào với vị trí tại hai cực và bỏ qua việc màng nhân chưa tái lập."}],"level_reason":"Học sinh đọc một mô tả quan sát, phân biệt vị trí và trạng thái của nhiễm sắc thể rồi ghép với giai đoạn nguyên phân tương ứng. Đây là diễn giải biểu hiện của kiến thức đã học ở mức TH.","prerequisites":["Các kì của nguyên phân.","Phân biệt nhiễm sắc thể kép và nhiễm sắc thể đơn.","Đặc điểm sắp xếp và phân li nhiễm sắc thể trong nguyên phân."],"variation_guidance":"Có thể mô tả một giai đoạn khác bằng tổ hợp dấu hiệu về vị trí nhiễm sắc thể, trạng thái chromatid và màng nhân; phải cung cấp đầy đủ dấu hiệu trong văn bản.","uncertainties":["Căn cứ tham khảo về dạng nhiệm vụ chỉ là mô tả quan sát cấp tỉnh qua nguồn thứ ba; mẫu tự tạo này không xác lập sự tương ứng với đề thi chính thức."],"missing_assets":[]},{"id":"bb1a619fb6ee1287","stem":"Một tế bào lưỡng bội có lượng DNA trong nhân ở pha G1 là 4 pg. Tế bào trải qua một chu kì bình thường, DNA nhân đôi hoàn tất và nguyên phân không có sai sót. Ba bản ghi dưới đây mô tả lượng DNA trong một nhân theo thứ tự: pha G1 → cuối pha S → pha G2 → nhân của mỗi tế bào con ngay sau khi phân chia.\nBản ghi 1: 4 → 4 → 8 → 4 (pg).\nBản ghi 2: 4 → 8 → 4 → 4 (pg).\nBản ghi 3: 4 → 8 → 8 → 4 (pg).\nHãy ghi số của bản ghi phù hợp.","options":[],"statements":[],"answers":[{"sub":null,"answer":"3","level":"TH"}],"solution":"DNA nhân đôi trong pha S nên lượng DNA tăng từ 4 pg lên 8 pg vào cuối pha S. Ở pha G2, lượng DNA vẫn là 8 pg. Sau nguyên phân và phân chia tế bào chất bình thường, mỗi tế bào con có một nhân chứa 4 pg DNA. Vì vậy bản ghi 3 phù hợp. Bản ghi 1 sai vì không thể hiện sự tăng lượng DNA trong pha S. Bản ghi 2 sai vì đặt sự giảm lượng DNA vào pha G2, khi tế bào chưa phân chia.","distractors":[],"level_reason":"Học sinh đối chiếu các dãy số với quy luật nhân đôi DNA ở pha S, duy trì lượng DNA ở pha G2 và phân chia cho hai nhân con. Đây là đọc biểu diễn và áp dụng quy luật chu kì tế bào quen thuộc ở mức TH.","prerequisites":["Trình tự các pha G1, S, G2 và pha phân bào.","DNA nhân đôi trong pha S.","Sự phân chia đồng đều DNA cho hai nhân con trong nguyên phân bình thường."],"variation_guidance":"Thay lượng DNA ban đầu hoặc đổi thứ tự các bản ghi; luôn xác định rõ đại lượng tính cho một nhân và mốc đo sau phân chia.","uncertainties":["Căn cứ tham khảo về dạng nhiệm vụ chỉ là mô tả đồ thị cấp tỉnh qua nguồn thứ ba; các bản ghi trong mẫu này được tự tạo và không phải dữ liệu đề thi chính thức."],"missing_assets":[]},{"id":"f478d7325efffcb1","stem":"Ở tế bào nhân thực, chu trình Krebs của quá trình hô hấp tế bào diễn ra trong bào quan nào?","options":[{"label":"A","text":"Lục lạp."},{"label":"B","text":"Peroxisome."},{"label":"C","text":"Lysosome."},{"label":"D","text":"Ti thể."}],"statements":[],"answers":[{"sub":null,"answer":"D","level":"NB"}],"solution":"Ở tế bào nhân thực, chu trình Krebs diễn ra trong chất nền ti thể. Vì vậy bào quan cần chọn là ti thể.","distractors":[{"label":"A","sub":null,"mistake":"Nhầm chu trình Krebs với chu trình Calvin diễn ra trong lục lạp.","why_plausible":"Cả hai đều là các chu trình chuyển hóa thường được học trong phần chuyển hóa vật chất và năng lượng."},{"label":"B","sub":null,"mistake":"Đồng nhất các phản ứng oxi hóa trong peroxisome với chu trình Krebs.","why_plausible":"Peroxisome có enzyme tham gia một số phản ứng oxi hóa nên học sinh có thể nhầm với bào quan thực hiện hô hấp tế bào."},{"label":"C","sub":null,"mistake":"Nhầm sự phân giải chất trong lysosome với giai đoạn oxi hóa chất hữu cơ của hô hấp tế bào.","why_plausible":"Học sinh liên hệ chức năng tiêu hóa nội bào với mọi quá trình phân giải chất hữu cơ."}],"level_reason":"Học sinh chỉ cần nhớ vị trí của chu trình Krebs trong tế bào nhân thực; đáp án thuộc một đơn vị kiến thức, phù hợp mức NB.","prerequisites":["Vị trí diễn ra chu trình Krebs ở tế bào nhân thực."],"variation_guidance":"Có thể thay giai đoạn được hỏi bằng chuỗi truyền electron hô hấp, đồng thời điều chỉnh phương án để chỉ có một vị trí đúng.","uncertainties":[],"missing_assets":[]}]}
