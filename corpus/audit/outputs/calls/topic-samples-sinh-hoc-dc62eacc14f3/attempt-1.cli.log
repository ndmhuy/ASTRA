r": null}, "targets": [{"id": "969218af6fe5a4ae", "topic": "Bài tiết và cân bằng nội môi ở động vật", "part": "P1", "level": "TH", "qtype": "mcq", "option_labels": ["A", "B", "C", "D"], "slot_keys": [null], "canonical_answer_alphabet": ["A", "B", "C", "D"], "abstract_observations": [{"given": "Sơ đồ chỉ được mô tả bằng lời về đường thần kinh và hormone điều hòa nước trong cơ thể.", "task": "Chọn nhận định sai về các thành phần và tác dụng của cơ chế điều hòa.", "reasoning": "Theo dõi các nhánh điều hòa trong sơ đồ; xác định tác dụng giữ nước của hormone; kiểm tra chiều tác động lên áp suất thẩm thấu.", "combines": ["Cân bằng nội môi", "Điều hòa hormone", "Tái hấp thụ nước ở thận"], "difficulty_source": "Kiểm tra đúng chiều tác dụng của hormone trong vòng điều hòa", "evidence_uncertainty": "Chỉ có mô tả sơ đồ; quan hệ chức năng cần thiết vẫn được thể hiện bằng lời.", "evidence_class": "official"}], "support_refs": ["b68b84764a9b|P1|7|None"], "official_anchor_available": true}, {"id": "641c0f065e3baf8e", "topic": "Chu kì tế bào và nguyên phân", "part": "P1", "level": "TH", "qtype": "mcq", "option_labels": ["A", "B", "C", "D"], "slot_keys": [null], "canonical_answer_alphabet": ["A", "B", "C", "D"], "abstract_observations": [{"given": "Ảnh tế bào đang phân bào thể hiện sự di chuyển của nhiễm sắc thể về các phía đối diện.", "task": "Xác định giai đoạn nguyên phân được thể hiện.", "reasoning": ["Quan sát trạng thái tách và vị trí của nhiễm sắc thể.", "Ghép đặc điểm hình thái với giai đoạn phân bào."], "combines": ["Nguyên phân", "Đọc ảnh hiển vi"], "difficulty_source": "Hình thái phân li là dấu hiệu nhận diện rõ", "evidence_uncertainty": null, "evidence_class": "provincial_third_party"}], "support_refs": ["61a0198fbfda|P1|8|None"], "official_anchor_available": false}, {"id": "bb1a619fb6ee1287", "topic": "Chu kì tế bào và nguyên phân", "part": "P3", "level": "TH", "qtype": "short_answer", "option_labels": [], "slot_keys": [null], "canonical_answer_alphabet": [], "abstract_observations": [{"given": "Các đồ thị trực quan mô tả lượng DNA theo những pha của chu kì tế bào.", "task": "Chọn đồ thị phù hợp với quy luật nhân đôi và phân chia DNA.", "reasoning": "Xác định pha diễn ra nhân đôi; giữ nguyên mức DNA trong các pha không tổng hợp; đặt sự giảm lượng DNA vào giai đoạn phân chia; đối chiếu hình dạng đồ thị.", "combines": ["Các pha chu kì tế bào", "Nhân đôi DNA", "Đọc đồ thị"], "difficulty_source": "Ghép đúng các đoạn đồ thị với chức năng từng pha", "evidence_uncertainty": null, "evidence_class": "provincial_third_party"}], "support_refs": ["8bbf9eea6d33|P3|3|None"], "official_anchor_available": false}, {"id": "f478d7325efffcb1", "topic": "Chuyển hóa năng lượng và hô hấp tế bào", "part": "P1", "level": "NB", "qtype": "mcq", "option_labels": ["A", "B", "C", "D"], "slot_keys": [null], "canonical_answer_alphabet": ["A", "B", "C", "D"], "abstract_observations": [{"given": "Một giai đoạn của quá trình hô hấp ở tế bào nhân thực.", "task": "Xác định bào quan diễn ra giai đoạn đó.", "reasoning": "Nhớ sự phân bố các giai đoạn hô hấp trong tế bào; chọn bào quan tương ứng.", "combines": ["Hô hấp tế bào", "Chức năng bào quan"], "difficulty_source": "Ghi nhớ trực tiếp vị trí của một giai đoạn chuyển hóa", "evidence_uncertainty": null, "evidence_class": "official"}], "support_refs": ["b68b84764a9b|P1|16|None"], "official_anchor_available": true}]}
