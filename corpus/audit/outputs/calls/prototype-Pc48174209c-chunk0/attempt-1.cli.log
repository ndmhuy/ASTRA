ền ràng buộc qua phả hệ và giữ trọng số các kiểu gene chưa xác định", "evidence_uncertainty": null}, {"ref": "4b4716b94db4|P1|3|None", "evidence_class": "provincial_third_party", "topic": "Đột biến gene: tác động lên phiên mã và dịch mã", "grade": 12, "task": "Xác định số nhận định đúng về sản phẩm ban đầu và sản phẩm sau đột biến.", "reasoning": "Lập trình tự phiên mã theo chiều bổ sung; chuyển các bộ ba thành chuỗi sản phẩm; kiểm tra tác động của thay thế lên bộ ba và điểm dừng; lập lại khung đọc sau thêm nucleotide; tổng hợp các kết luận.", "steps": 5, "combines": ["Nguyên tắc bổ sung", "Phiên mã và dịch mã", "Đột biến thay thế", "Đột biến dịch khung"], "difficulty_source": "Phải giữ đúng chiều bổ sung và khung đọc qua nhiều kiểu đột biến", "evidence_uncertainty": null}]}, "structure_summary": {"part_order_observations": [{"class": "official", "order": ["P1", "P2", "P3"], "distinct_papers": 1}, {"class": "provincial_third_party", "order": ["P1", "P2", "P3"], "distinct_papers": 5}], "shared_group_presence": [{"class": "official", "part": "P2", "kind": "mô tả di truyền và bảng", "scope": "statements_within_question", "questions_in_part": 1, "distinct_papers": 1}, {"class": "official", "part": "P2", "kind": "mô tả nghiên cứu và đồ thị", "scope": "statements_within_question", "questions_in_part": 1, "distinct_papers": 1}, {"class": "official", "part": "P2", "kind": "mô tả thí nghiệm, lưới thức ăn và bảng", "scope": "statements_within_question", "questions_in_part": 1, "distinct_papers": 1}, {"class": "official", "part": "P2", "kind": "mô tả và sơ đồ", "scope": "statements_within_question", "questions_in_part": 1, "distinct_papers": 1}, {"class": "provincial_third_party", "part": "P1", "kind": "Dữ kiện văn bản và bảng", "scope": "statements_within_question", "questions_in_part": 1, "distinct_papers": 1}, {"class": "provincial_third_party", "part": "P2", "kind": "Bảng dữ liệu", "scope": "statements_within_question", "questions_in_part": 1, "distinct_papers": 1}, {"clas