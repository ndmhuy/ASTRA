, "2cbdc74db082|P1|1|None", "8bbf9eea6d33|P1|7|None", "8bbf9eea6d33|P1|8|None", "55c12f561006|P1|5|None", "55c12f561006|P1|12|None", "4b4716b94db4|P1|17|None", "4b4716b94db4|P1|18|None", "61a0198fbfda|P1|9|None"], "paper_count": 5, "row_count": 9}, {"part_kind": "multiple_choice", "topic": "Nhận diện cơ chế từ diễn biến và hệ quả", "grade": 12, "construction": "Cho hiện tượng, chuỗi sự kiện hoặc đặc điểm tác động; yêu cầu xác định cơ chế hay kết quả trực tiếp. Chọn dấu hiệu quyết định, xác định cấp tác động rồi đối chiếu điều kiện của từng cơ chế.", "wrong_options": "Nhầm tạo biến dị với sàng lọc, tác động ngẫu nhiên với định hướng, điều kiện cách li với nguyên nhân biến đổi hoặc gán cùng cơ chế cho các nhánh khác nhau.", "difficulty_source": "Để dữ kiện quyết định cơ chế và giữ đúng lịch sử, đơn vị cùng chiều tác động.", "discrimination": "low", "typical_steps": 3, "evidence_status": "lap_lai_giua_cac_de", "refs": ["8bbf9eea6d33|P1|1|None", "8bbf9eea6d33|P1|17|None", "2cbdc74db082|P1|4|None", "55c12f561006|P1|6|None", "4b4716b94db4|P1|7|None", "55c12f561006|P1|13|None", "55c12f561006|P1|15|None", "4b4716b94db4|P1|1|None", "61a0198fbfda|P1|3|None", "61a0198fbfda|P1|5|None", "61a0198fbfda|P1|13|None"], "paper_count": 5, "row_count": 11}, {"part_kind": "multiple_choice", "topic": "Điều kiện và giới hạn của kết luận", "grade": 12, "construction": "Cho nhận định hoặc dữ liệu so sánh có phạm vi xác định; yêu cầu chọn kết luận phù hợp hay không được hỗ trợ. Tách điều kiện, kết quả có thể xảy ra và hệ quả bắt buộc; kiểm tra quan hệ nào thực sự được dữ liệu xác định.", "wrong_options": "Biến khả năng thành tất yếu, bảo toàn toàn thể thành bảo toàn từng thành phần hoặc suy quan hệ trực tiếp từ các quan hệ cùng đối chiếu với một mốc.", "difficulty_source": "Kiểm tra đồng thời nội dung sinh học và mức độ khẳng định.", "discrimination": "medium", "typical_steps": 4, "evidence_status": "lap_lai_giua_cac_de", "refs": ["8bbf9eea6d33|P1|12|None", "2cbdc74db082|P1|14|None", "2cbdc74db082|P1|15|None", "4b4716b94db4|P1|8|None"], "paper_count": 3, "row_count": 4}, {"part_kind": "multiple_choice", "topic": "Cấp cấu trúc và trạng thái phân bào", "grade": [10, 12], "construction": "Cho kí hiệu, đặc trưng định lượng, sự kiện hoặc hình; yêu cầu gọi tên cấp cấu trúc hay giai đoạn. Xác định đối tượng, ranh giới và trạng thái rồi ghép với quy ước đã học.", "wrong_options": "Chọn cấp hoặc giai đoạn lân cận, đổi đối tượng phân li, lấy kết quả hoàn tất thay diễn biến hoặc đánh tráo thành phần với toàn thể.", "difficulty_source": "Nhớ đúng ánh xạ giữa dấu hiệu, thời điểm và cấp tổ chức.", "discrimination": "low", "typical_steps": 2, "evidence_status": "lap_lai_giua_cac_de", "refs": ["8bbf9eea6d33|P1|2|None", "2cbdc74db082|P1|3|None", "55c12f561006|P1|4|None", "4b4716b94db4|P1|6|None", "61a0198fbfda|P1|8|None", "61a0198fbfda|P1|10|None"], "paper_count": 5, "row_count": 6}, {"part_kind": "multiple_choice", "topic": "Suy mô hình và bố mẹ từ phân li", "grade": 12, "construction": "Cho phân bố kiểu hình và quy tắc biểu hiện; yêu cầu suy bố mẹ hoặc mô hình tác động gene. Tách điều kiện theo locus, suy trạng thái allele, ghép lại và kiểm tra phân li chung.", "wrong_options": "Đổi trạng thái đồng hợp và dị hợp, dùng phép lai quen thuộc không khớp dữ kiện hoặc nhầm tương tác với cơ chế khác.", "difficulty_source": "Phân rã dữ liệu trước khi suy ngược; tên phân loại tương tác có thể phụ thuộc quy ước tài liệu.", "discrimination": "medium", "typical_steps": 3, "evidence_status": "lap_lai_giua_cac_de", "refs": ["55c12f561006|P1|1|None", "4b4716b94db4|P1|10|None"], "paper_count": 2, "row_count": 2}, {"part_kind": "multiple_choice", "topic": "Suy trạng thái di truyền ẩn từ quan hệ gia đình", "grade": 12, "construction": "Cho quan hệ truyền tính trạng, kiểu hình và có thể kèm chỉ thị phân tử; yêu cầu chọn kết luận, đối tượng hoặc xác suất. Suy mô hình, giữ các khả năng kiểu gene, theo nguồn truyền allele và kiểm tra điều kiện cuối.", "wrong_options": "Bỏ trạng thái mang allele, mặc định mô hình theo giới, dùng xác suất chưa điều kiện hóa hoặc dừng ở kết quả trung gian.", "difficulty_source": "Phối hợp dữ liệu để xử lí bất định và phân biệt sự kiện đồng thời với điều kiện đã biết.", "discrimination": "high", "typical_steps": 4, "evidence_status": "lap_lai_giua_cac_de", "refs": ["8bbf9eea6d33|P1|13|None", "2cbdc74db082|P1|7|None", "2cbdc74db082|P1|18|None", "55c12f561006|P1|16|None", "61a0198fbfda|P1|14|None"], "paper_count": 4, "row_count": 5}, {"part_kind": "multiple_choice", "topic": "Chuyển đổi tần số allele và kiểu gene", "grade": 12, "construction": "Cho cấu trúc kiểu gene hoặc tần số allele kèm điều kiện cân bằng; yêu cầu tần số allele hay tổng tần số nhóm kiểu gene. Xác định đóng góp và cộng đủ thành phần thuộc tập đích.", "wrong_options": "Bỏ đóng góp của dị hợp, dùng nguyên tần số kiểu gene, lấy riêng một thành phần hoặc tính nhóm đối lập.", "difficulty_source": "Phân biệt đại lượng đầu vào với đại lượng cần tìm và kiểm tra điều kiện mô hình.", "discrimination": "low", "typical_steps": 2, "evidence_status": "lap_lai_giua_cac_de", "refs": ["2cbdc74db082|P1|2|None", "61a0198fbfda|P1|7|None"], "paper_count": 2, "row_count": 2}, {"part_kind": "multiple_choice", "topic": "Theo dõi cấu trúc di truyền qua chế độ sinh sản", "grade": 12, "construction": "Cho cấu trúc xuất phát và lịch sử sinh sản; yêu cầu cấu trúc cuối. Theo dõi tần số allele, cập nhật cấu trúc sau mỗi chế độ rồi tổng hợp phần chuyển đổi giữa các nhóm kiểu gene.", "wrong_options": "Trả kết quả trung gian, bỏ giai đoạn, dùng trạng thái giới hạn hoặc nhầm bảo toàn allele với bảo toàn kiểu gene.", "difficulty_source": "Giữ đúng thứ tự và phân biệt đại lượng được bảo toàn với đại lượng thay đổi.", "discrimination": "medium", "typical_steps": 4, "evidence_status": "quan_sat_rieng_chua_xac_lap_lap_lai", "refs": ["55c12f561006|P1|2|None", "55c12f561006|P1|11|None"], "paper_count": 1, "row_count": 2}, {"part_kind": "multiple_choice", "topic": "Quy đổi pha liên kết, giao tử và đời con", "grade": 12, "construction": "Cho pha liên kết cùng dữ liệu giao tử hoặc bản đồ; yêu cầu suy đại lượng liên quan. Phân loại nhóm bố mẹ và tái tổ hợp, phân biệt tần số từng lớp với tổng nhóm rồi quy đổi theo phép lai.", "wrong_options": "Lấy tần số một lớp làm tổng hoán vị, nhầm nhóm liên kết với tái tổ hợp hoặc cộng thiếu và cộng lặp.", "difficulty_source": "Giữ đúng đối tượng của mỗi tần số.", "discrimination": "medium", "typical_steps": 3, "evidence_status": "lap_lai_giua_cac_de", "refs": ["55c12f561006|P1|7|None", "4b4716b94db4|P1|12|None"], "paper_count": 2, "row_count": 2}, {"part_kind": "multiple_choice", "topic": "Biến đổi trật tự cấu trúc trên biểu diễn kí hiệu", "grade": 12, "construction": "Cho trật tự thành phần và ranh giới đoạn chịu tác động; yêu cầu chọn cấu trúc sau biến đổi. Khoanh phần chịu tác động, thực hiện phép biến đổi và giữ nguyên phần ngoài.", "wrong_options": "Thay bằng dạng biến đổi khác hoặc thực hiện vượt ranh giới.", "difficulty_source": "Áp dụng đúng thao tác trên đúng miền biểu diễn.", "discrimination": "low", "typical_steps": 3, "evidence_status": "quan_sat_rieng_chua_xac_lap_lap_lai", "refs": ["55c12f561006|P1|8|None"], "paper_count": 1, "row_count": 1}, {"part_kind": "multiple_choice", "topic": "Tổ chức gene và phạm vi xử lí RNA", "grade": 12, "construction": "Cho hình các vùng gene; yêu cầu chọn nhận định về tổ chức hoặc chức năng. Nhận diện ranh giới, nối phiên mã với xử lí RNA rồi phân biệt phần được phiên mã và phần quy định sản phẩm.", "wrong_options": "Đồng nhất vùng phiên mã với vùng mã hóa hoặc bỏ phần bị loại khi xử lí.", "difficulty_source": "Phân biệt các phạm vi chức năng từ dấu hiệu cấu trúc.", "discrimination": "low", "typical_steps": 3, "evidence_status": "quan_sat_rieng_chua_xac_lap_lap_lai", "refs": ["55c12f561006|P1|9|None"], "paper_count": 1, "row_count": 1}, {"part_kind": "multiple_choice", "topic": "Vị trí gene, đường truyền và điều kiện đạt mục tiêu", "grade": 12, "construction": "Cho vị trí gene hoặc cấu trúc DNA cùng mục tiêu; yêu cầu chọn phương án đáp ứng. Xác định nguồn truyền, sự hiện diện và khả năng biểu hiện rồi kiểm tra các điều kiện đồng thời.", "wrong_options": "Mặc định di truyền trong nhân, chọn sai nguồn đóng góp hoặc xem có gene là đủ đạt mục tiêu.", "difficulty_source": "Chọn mô hình từ vị trí gene và kiểm tra đủ điều kiện; phạm vi mô hình di truyền bào quan phải rõ.", "discrimination": "medium", "typical_steps": 3, "evidence_status": "lap_lai_giua_cac_de", "refs": ["4b4716b94db4|P1|2|None", "61a0198fbfda|P1|4|None", "61a0198fbfda|P1|18|None"], "paper_count": 2, "row_count": 3}, {"part_kind": "multiple_choice", "topic": "Đáp ứng sinh học theo miền điều kiện", "grade": [11, 12], "construction": "Cho đường đáp ứng, khoảng môi trường hoặc nhóm sinh lí; yêu cầu chọn đối tượng hay kết luận phù hợp. Đọc mốc và chỉ tiêu, chia miền điều kiện rồi kiểm tra từng so sánh hoặc sự bao chứa toàn khoảng.", "wrong_options": "Nhầm điểm đặc trưng, chỉ xét một điểm thuận lợi, kéo ưu thế cục bộ ra toàn miền hoặc xem cải thiện một phần là bù đắp hoàn toàn.", "difficulty_source": "Chọn đúng đại lượng, cơ chế và giới hạn áp dụng; không mở rộng chỉ tiêu đã đo sang thuộc tính khác.", "discrimination": "medium", "typical_steps": 4, "evidence_status": "lap_lai_giua_cac_de", "refs": ["8bbf9eea6d33|P1|4|None", "4b4716b94db4|P1|16|None", "4b4716b94db4|P1|4|None", "61a0198fbfda|P1|15|None"], "paper_count": 3, "row_count": 4}, {"part_kind": "multiple_choice", "topic": "Chiều và mạng tác động sinh thái", "grade": 12, "construction": "Cho các quá trình hoặc mạng có chú giải; yêu cầu chọn tổ hợp tác động hay diễn giải phù hợp. Gán dấu tác động, theo đường trực tiếp và qua trung gian rồi kiểm tra hệ quả.", "wrong_options": "Ghép tác động tăng với giảm, bỏ cường độ, chỉ đếm liên hệ hoặc đảo dấu khi loại tác nhân.", "difficulty_source": "Theo dõi nhất quán dấu, chiều và phạm vi thông tin; mạng nhiều đường cần nhiều bước hơn việc xét từng quá trình.", "discrimination": "medium", "typical_steps": 4, "evidence_status": "lap_lai_giua_cac_de", "refs": ["55c12f561006|P1|3|None", "8bbf9eea6d33|P1|14|None"], "paper_count": 2, "row_count": 2}, {"part_kind": "multiple_choice", "topic": "Đại lượng quần thể từ biểu diễn không gian", "grade": 12, "construction": "Cho sơ đồ cá thể trên phạm vi khảo sát; yêu cầu chọn mô tả đặc trưng quần thể. Tách nhóm kí hiệu, đếm, đối chiếu diện tích và quan sát khoảng cách trước khi liên hệ kiểu phân bố.", "wrong_options": "Suy số lượng hoặc mật độ từ độ trải rộng, gán sai quan hệ sinh học cho kiểu phân bố.", "difficulty_source": "Tách số lượng, mật độ và phân bố trên cùng biểu diễn.", "discrimination": "medium", "typical_steps": 3, "evidence_status": "quan_sat_rieng_chua_xac_lap_lap_lai", "refs": ["61a0198fbfda|P1|16|None"], "paper_count": 1, "row_count": 1}, {"part_kind": "multiple_choice", "topic": "Biến đổi trình tự qua phiên mã và dịch mã", "grade": 12, "construction": "Cho trình tự có định hướng, bảng tra và các biến đổi; yêu cầu tổng hợp nhận định đúng. Dựng sản phẩm ban đầu, cập nhật trình tự sau từng biến đổi rồi kiểm tra chiều đọc, khung đọc và điểm dừng.", "wrong_options": "Giữ khung đọc cũ, tính tín hiệu kết thúc như phần mã hóa hoặc kiểm tra thiếu nhận định; kết quả đếm không xác định duy nhất lỗi thành phần.", "difficulty_source": "Duy trì biểu diễn chính xác qua chuỗi biến đổi.", "discrimination": "high", "typical_steps": 5, "evidence_status": "quan_sat_rieng_chua_xac_lap_lap_lai", "refs": ["4b4716b94db4|P1|3|None"], "paper_count": 1, "row_count": 1}, {"part_kind": "multiple_choice", "topic": "Suy vai trò chuyển hóa từ tín hiệu đánh dấu", "grade": 11, "construction": "Cho tín hiệu biến thiên của các chất chưa gọi tên; yêu cầu ghép đường với vai trò. Dựng thứ tự chuyển vật chất, phân biệt chất nhận và sản phẩm rồi kiểm tra toàn bộ phép ghép.", "wrong_options": "Hoán đổi vị trí gần nhau trong con đường hoặc nhầm chất được tái sinh với sản phẩm tích lũy.", "difficulty_source": "Chuyển dữ liệu động thành cơ chế; điểm thời gian chưa rõ không được xem là quy luật chuẩn.", "discrimination": "high", "typical_steps": 4, "evidence_status": "quan_sat_rieng_chua_xac_lap_lap_lai", "refs": ["61a0198fbfda|P1|17|None"], "paper_count": 1, "row_count": 1}, {"part_kind": "true_false", "topic": "Định vị cơ quan và lần theo đường vận chuyển", "grade": 11, "construction": "Cho sơ đồ có mã vị trí và đường liên thông; yêu cầu đánh giá tên gọi, trình tự hoặc chức năng tại vị trí. Định hướng hình, theo đường vận chuyển rồi đối chiếu cấu tạo với chức năng.", "wrong_options": "Nhầm theo phía nhìn, dùng nhãn quen thuộc thay đường đi thực tế hoặc gán sai chức năng; một số dòng dẫn chứng chỉ xác nhận phát biểu đúng.", "difficulty_source": "Nhận diện vị trí thường trực tiếp hơn việc nối vị trí với hoạt động.", "discrimination": "medium", "typical_steps": 3, "evidence_status": "lap_lai_giua_cac_de", "refs": ["8bbf9eea6d33|P2|3|b", "2cbdc74db082|P2|1|a", "8bbf9eea6d33|P2|3|d", "2cbdc74db082|P2|1|b", "55c12f561006|P2|4|a", "55c12f561006|P2|4|b", "55c12f561006|P2|4|d"], "paper_count": 3, "row_count": 7}, {"part_kind": "true_false", "topic": "Cấu tạo, trạng thái và hệ quả sinh lí", "grade": 11, "construction": "Cho cấu tạo, trạng thái hoạt động hoặc can thiệp; yêu cầu đánh giá hệ quả chức năng. Xác định bộ phận, nối điều kiện cơ học hay sinh hóa với dòng vận chuyển hoặc trao đổi rồi kiểm tra kết luận.", "wrong_options": "Kéo trạng thái giữa các pha, đảo chiều trao đổi, dùng một dấu hiệu làm chẩn đoán duy nhất hoặc xếp hạng mức phụ thuộc khi thiếu cơ sở.", "difficulty_source": "Giữ đúng thời điểm, biến trung gian và điều kiện duy trì hoạt động.", "discrimination": "medium", "typical_steps": 3, "evidence_status": "lap_lai_giua_cac_de", "refs": ["8bbf9eea6d33|P2|3|a", "8bbf9eea6d33|P2|3|c", "2cbdc74db082|P2|1|c", "2cbdc74db082|P2|1|d", "4b4716b94db4|P2|1|c", "61a0198fbfda|P2|3|b", "61a0198fbfda|P2|3|c", "61a0198fbfda|P2|3|d"], "paper_count": 4, "row_count": 8}, {"part_kind": "true_false", "topic": "Cấp tổ chức và trạng thái trung gian của biểu hiện gene", "grade": 12, "construction": "Cho tổ chức gene, trạng thái phát triển hoặc sản phẩm đang tổng hợp; yêu cầu đánh giá sự giống khác, vị trí và bản chất sản phẩm. Tách nơi lưu giữ, đơn vị phiên mã, quá trình đang diễn ra và sản phẩm hoàn tất.", "wrong_options": "Xem phiên mã chung là sản phẩm chung, khác biệt hình thái là khác biệt di truyền hoặc độ dài đang tổng hợp là độ dài sản phẩm cuối.", "difficulty_source": "Không đồng nhất các cấp tổ chức và thời điểm; suy luận từ điện di còn phụ thuộc điều kiện xử lí và đo.", "discrimination": "medium", "typical_steps": 3, "evidence_status": "lap_lai_giua_cac_de", "refs": ["8bbf9eea6d33|P2|1|c", "2cbdc74db082|P2|2|a", "2cbdc74db082|P2|3|a", "2cbdc74db082|P2|3|b", "55c12f561006|P2|2|d"], "paper_count": 3, "row_count": 5}, {"part_kind": "true_false", "topic": "Vai trò thành phần trong quy trình và chức năng sản phẩm", "grade": 12, "construction": "Cho sơ đồ công nghệ hoặc tổng hợp; yêu cầu đánh giá tên gọi, vai trò thành phần và tác dụng sản phẩm. Theo nhãn cùng quan hệ giữa các thành phần, nối dấu hiệu với chức năng rồi giới hạn kết luận theo quy trình.", "wrong_options": "Xem bằng chứng mang vector là bằng chứng tuyệt đối về đoạn chèn hoặc suy chức năng vượt điều kiện; các dòng không cung cấp nhiễu riêng thì không gán thêm ngộ nhận.", "difficulty_source": "Phân biệt điều quy trình trực tiếp chứng minh với mục tiêu rộng hơn.", "discrimination": "medium", "typical_steps": 3, "evidence_status": "lap_lai_giua_cac_de", "refs": ["8bbf9eea6d33|P2|1|a", "8bbf9eea6d33|P2|1|b", "2cbdc74db082|P2|3|c", "55c12f561006|P2|1|a", "55c12f561006|P2|2|a", "2cbdc74db082|P2|3|d"], "paper_count": 3, "row_count": 6}, {"part_kind": "true_false", "topic": "Từ thành phần phân tử đến chức năng và kiểu hình", "grade": [10, 12], "construction": "Cho thành phần, trạng thái allele hoặc bằng chứng ở các cấp; yêu cầu đánh giá bản chất phân tử, vị trí, chức năng hay biểu hiện. Nhận diện đối tượng trước rồi kiểm tra cơ chế nối các cấp bằng chứng.", "wrong_options": "Suy tuyến tính từ thay đổi DNA sang độ dài sản phẩm, đồng nhất mang allele với biểu hiện hoặc gán chức năng không phù hợp bản chất phân tử.", "difficulty_source": "Chuyển cấp bằng chứng mà không bỏ qua cơ chế trung gian.", "discrimination": "medium", "typical_steps": 4, "evidence_status": "lap_lai_giua_cac_de", "refs": ["8bbf9eea6d33|P2|4|a", "8bbf9eea6d33|P2|4|c", "4b4716b94db4|P2|4|b", "4b4716b94db4|P2|4|c", "61a0198fbfda|P2|1|a", "61a0198fbfda|P2|1|c"], "paper_count": 3, "row_count": 6}, {"part_kind": "true_false", "topic": "Điều kiện biểu hiện và xác suất từ con đường chuyển hóa", "grade": 12, "construction": "Cho con đường chuyển hóa cùng quy tắc gene và môi trường; yêu cầu đánh giá kiểu hình hoặc tỉ lệ. Kiểm tra điều kiện chặn, chuyển từng đường đi thành điều kiện kiểu gene rồi tính và gộp trường hợp.", "wrong_options": "Áp phân li quen thuộc khi biểu hiện bị che lấp, đảo điều kiện ức chế, đồng nhất vai trò allele trội hoặc đếm trùng nguyên nhân cùng kiểu hình.", "difficulty_source": "Ưu tiên điều kiện biểu hiện trước phép tính và giữ đúng dấu của các điều kiện.", "discrimination": "medium", "typical_steps": 4, "evidence_status": "lap_lai_giua_cac_de", "refs": ["2cbdc74db082|P2|4|a", "55c12f561006|P2|1|b", "55c12f561006|P2|1|c", "55c12f561006|P2|1|d", "61a0198fbfda|P2|2|a"], "paper_count": 3, "row_count": 5}, {"part_kind": "true_false", "topic": "Liệt kê cấu hình di truyền và kiểm tra ràng buộc", "grade": 12, "construction": "Cho điều kiện về lớp kiểu gene, kiểu hình hoặc phép lai; yêu cầu kiểm tra khả năng, số lượng hay tính tất yếu. Liệt kê cấu hình hợp lệ, xét giao tử và pha liên kết, gộp theo biểu hiện rồi kiểm tra mọi ràng buộc hoặc tìm phản ví dụ.", "wrong_options": "Đồng nhất kiểu hình với kiểu gene, suy tỉ lệ từ số lớp, tự thêm giả thiết dị hợp, bỏ pha liên kết hoặc đếm lặp cặp lai.", "difficulty_source": "Phải xét không gian khả năng thay vì khớp một tỉ lệ quen thuộc; quy ước đếm và chiều lai cần rõ.", "discrimination": "high", "typical_steps": 4, "evidence_status": "lap_lai_giua_cac_de", "refs": ["2cbdc74db082|P2|4|b", "2cbdc74db082|P2|4|c", "2cbdc74db082|P2|4|d", "4b4716b94db4|P2|2|a", "4b4716b94db4|P2|2|b", "4b4716b94db4|P2|2|c", "4b4716b94db4|P2|2|d", "61a0198fbfda|P2|2|b", "61a0198fbfda|P2|2|c"], "paper_count": 3, "row_count": 9}, {"part_kind": "true_false", "topic": "Xác suất có điều kiện với kiểu gene chưa xác định", "grade": 12, "construction": "Cho kiểu hình và thông tin người thân; yêu cầu đánh giá nguy cơ đời con. Suy phân bố kiểu gene có điều kiện, kết hợp khả năng truyền và điều kiện chức năng rồi chuyển sang biến cố đích.", "wrong_options": "Dùng xác suất của biến cố đối hoặc bỏ cập nhật phân bố sau khi biết kiểu hình.", "difficulty_source": "Kết hợp bất định kiểu gene, điều kiện độc lập và biến cố đối.", "discrimination": "high", "typical_steps": 5, "evidence_status": "quan_sat_rieng_chua_xac_lap_lap_lai", "refs": ["61a0198fbfda|P2|2|d"], "paper_count": 1, "row_count": 1}, {"part_kind": "true_false", "topic": "Đọc trực tiếp và định hướng trên hình", "grade": [11, 12], "construction": "Cho đường biểu diễn, mũi tên hoặc vị trí trong quá trình; yêu cầu kiểm tra mô tả, cực tính hay thứ tự. Đọc chú giải, tọa độ và chiều chuyển động; khi cần, chuyển vị trí thành mức tiến triển theo thời gian.", "wrong_options": "Đảo chiều, nhầm vị trí với thời điểm bắt đầu hoặc đọc sai đối tượng; không tự gán nhiễu cho dòng không mô tả.", "difficulty_source": "Đọc mô tả trực tiếp ít bước hơn suy định hướng và trình tự thời gian.", "discrimination": "low", "typical_steps": 3, "evidence_status": "lap_lai_giua_cac_de", "refs": ["55c12f561006|P2|2|b", "55c12f561006|P2|2|c", "55c12f561006|P2|3|a", "55c12f561006|P2|3|b", "55c12f561006|P2|3|c", "4b4716b94db4|P2|1|a", "4b4716b94db4|P2|3|b", "61a0198fbfda|P2|3|a", "61a0198fbfda|P2|4|a"], "paper_count": 3, "row_count": 9}, {"part_kind": "true_false", "topic": "Giới hạn phép đo và phạm vi khái quát", "grade": [11, 12], "construction": "Cho phép đo, đồ thị hoặc quy tắc có điều kiện; yêu cầu đánh giá kết luận về trạng thái, vai trò hay tính phổ quát. Xác định chỉ tiêu thực đo, đối tượng và thời đoạn rồi kiểm tra thông tin còn thiếu.", "wrong_options": "Đổi chỉ tiêu, chuyển tham số sang đối tượng khác, suy nhân quả từ mức xuất hiện, coi kết thúc quan sát là ổn định hoặc biến đặc điểm thường gặp thành quy tắc toàn hệ.", "difficulty_source": "Tách mô tả khỏi diễn giải và giữ rõ điều kiện vật lí, sinh học cùng giới hạn ngoại suy.", "discrimination": "medium", "typical_steps": 3, "evidence_status": "lap_lai_giua_cac_de", "refs": ["55c12f561006|P2|3|d", "55c12f561006|P2|4|c", "4b4716b94db4|P2|1|b", "4b4716b94db4|P2|1|d", "61a0198fbfda|P2|4|c", "4b4716b94db4|P2|3|a", "61a0198fbfda|P2|4|b", "61a0198fbfda|P2|4|d"], "paper_count": 3, "row_count": 8}, {"part_kind": "true_false", "topic": "Nguồn sống, tăng trưởng và cơ chế giới hạn", "grade": 12, "construction": "Cho can thiệp nguồn sống hoặc đường tăng trưởng; yêu cầu đánh giá hệ quả và cơ chế. Xác định biến trung gian, phân biệt kích thước với tốc độ tổng và tốc độ trên cá thể rồi kiểm tra từng vế của nhận định.", "wrong_options": "Coi điểm uốn là lúc giới hạn mới tác động, đồng nhất xu hướng giảm với tỉ lệ nghịch hoặc xem dự đoán theo mô hình là hiệu quả thực địa đã đo.", "difficulty_source": "Đọc độ dốc và tách đại lượng khỏi cơ chế điều hòa; thao tác phân tích tốc độ chỉ được quan sát cục bộ.", "discrimination": "high", "typical_steps": 4, "evidence_status": "quan_sat_rieng_chua_xac_lap_lap_lai", "refs": ["4b4716b94db4|P2|3|c", "4b4716b94db4|P2|3|d"], "paper_count": 1, "row_count": 2}, {"part_kind": "true_false", "topic": "Bảo toàn tổng thành phần", "grade": 10, "construction": "Cho bảng có tổng và thành phần thiếu; yêu cầu kiểm tra giá trị. Chọn đúng hàng, xác định phần đã biết rồi tính phần còn lại.", "wrong_options": "Giá trị gần kết quả đúng; không đủ dữ liệu để quy về một lỗi số học cụ thể.", "difficulty_source": "Kiểm tra đủ thành phần trước khi đối chiếu.", "discrimination": "low", "typical_steps": 3, "evidence_status": "quan_sat_rieng_chua_xac_lap_lap_lai", "refs": ["4b4716b94db4|P2|4|a"], "paper_count": 1, "row_count": 1}, {"part_kind": "true_false", "topic": "Suy sản phẩm allele và kiểm tra phát biểu ghép", "grade": 12, "construction": "Cho biến đổi allele, thông tin bộ ba hoặc lượt phiên mã; yêu cầu kiểm tra vị trí biến đổi, biểu hiện hay tổng nguyên liệu. Dựng riêng sản phẩm từng allele, giữ chiều bổ sung và quy ước vị trí rồi kiểm tra từng vế hoặc cộng đóng góp.", "wrong_options": "Chấp nhận toàn phát biểu vì một vế đúng hoặc dùng sai vị trí biến đổi; không gán thêm lỗi cho dòng chỉ có phép tổng hợp.", "difficulty_source": "Tách các thành phần suy luận trước khi tổng hợp kết luận.", "discrimination": "medium", "typical_steps": 4, "evidence_status": "quan_sat_rieng_chua_xac_lap_lap_lai", "refs": ["61a0198fbfda|P2|1|b", "61a0198fbfda|P2|1|d"], "paper_count": 1, "row_count": 2}, {"part_kind": "true_false", "topic": "Điều kiện của chiều truyền thông tin", "grade": 12, "construction": "Cho các nucleic acid đã nhận diện; yêu cầu đánh giá khả năng tạo thành phân tử khác. Xác định chiều truyền thông tin và điều kiện cơ chế cần có.", "wrong_options": "Không đủ cơ sở gán một ngộ nhận xác định vì giới hạn loại trừ cơ chế đặc biệt chưa rõ.", "difficulty_source": "Phụ thuộc giả thiết chưa được phát biểu đủ; mức phân hóa chưa được xác lập.", "discrimination": "medium", "typical_steps": 3, "evidence_status": "quan_sat_rieng_chua_xac_lap_lap_lai", "refs": ["4b4716b94db4|P2|4|d"], "paper_count": 1, "row_count": 1}, {"part_kind": "short_answer", "topic": "Suy tần số di truyền từ dữ liệu gián tiếp", "grade": 12, "construction": "Cho kiểu hình trong điều kiện cân bằng, phân bố allele chưa hoàn chỉnh hoặc ảnh băng; yêu cầu đại lượng kiểu gene hay allele. Hoàn thiện dữ liệu, đổi biểu diễn sang số bản sao hoặc tần số rồi tổng hợp và so sánh.", "wrong_options": null, "difficulty_source": "Xác định đúng đơn vị đếm và quan hệ giữa đại lượng; đặc trưng cần so sánh có thể không biến thiên đơn điệu theo dữ liệu đầu vào.", "discrimination": "medium", "typical_steps": 4, "evidence_status": "lap_lai_giua_cac_de", "refs": ["8bbf9eea6d33|P3|1|None", "4b4716b94db4|P3|4|None", "61a0198fbfda|P3|1|None"], "paper_count": 3, "row_count": 3}, {"part_kind": "short_answer", "topic": "Kiểm tra và mã hóa tập trường hợp phù hợp", "grade": 12, "construction": "Cho danh sách phép lai, biểu diễn hoặc đặc điểm; yêu cầu đếm hay xuất mã các trường hợp thỏa tiêu chí. Xác lập tiêu chí, phân rã điều kiện khi cần, kiểm tra từng phần tử rồi tổng hợp.", "wrong_options": "Trường hợp lệch mẫu phân li, có thành phần không phân li hoặc chỉ thỏa một phần tiêu chí; không mặc định mọi nhiệm vụ có tập lựa chọn đều cung cấp nhiễu.", "difficulty_source": "Áp dụng nhất quán tiêu chí, kiểm tra điều kiện tổ hợp và tránh bỏ sót.", "discrimination": "medium", "typical_steps": 4, "evidence_status": "lap_lai_giua_cac_de", "refs": ["8bbf9eea6d33|P3|2|None", "2cbdc74db082|P3|3|None", "2cbdc74db082|P3|6|None"], "paper_count": 2, "row_count": 3}, {"part_kind": "short_answer", "topic": "Theo dõi trạng thái và đơn vị tổng hợp DNA", "grade": [10, 12], "construction": "Cho đồ thị ứng viên, lịch sử đánh dấu hoặc cấu trúc đơn vị tái bản; yêu cầu chọn biểu diễn hay tính lượng đích. Ánh xạ cơ chế theo pha và lần tổng hợp, theo nguồn mạch hoặc điểm khởi đầu rồi tổng hợp.", "wrong_options": "Bỏ nhân đôi, đặt biến đổi sai thời điểm, chỉ theo tổng phân tử mà bỏ lịch sử mạch hoặc bỏ nhu cầu khởi đầu của mạch liên tục.", "difficulty_source": "Giữ đúng đơn vị được theo dõi và thời điểm cơ chế xảy ra; các nhánh cụ thể là quan sát riêng.", "discrimination": "medium", "typical_steps": 4, "evidence_status": "lap_lai_giua_cac_de", "refs": ["8bbf9eea6d33|P3|3|None", "55c12f561006|P3|3|None", "4b4716b94db4|P3|5|None"], "paper_count": 3, "row_count": 3}, {"part_kind": "short_answer", "topic": "Quan hệ và đặc điểm thừa hưởng trên cây phát sinh", "grade": 12, "construction": "Cho cây có gốc, mã nhóm hoặc đặc điểm trên nhánh; yêu cầu thứ tự quan hệ hay tập mã đặc điểm. Lần theo đường tổ tiên, xác định tổ tiên chung hoặc đặc điểm thừa hưởng rồi mã hóa kết quả.", "wrong_options": null, "difficulty_source": "Đọc cấu trúc phân nhánh thay vì vị trí trình bày hoặc tên nhóm.", "discrimination": "medium", "typical_steps": 4, "evidence_status": "lap_lai_giua_cac_de", "refs": ["8bbf9eea6d33|P3|4|None", "4b4716b94db4|P3|1|None"], "paper_count": 2, "row_count": 2}, {"part_kind": "short_answer", "topic": "Liên kết và đời con từ nhóm bố mẹ có điều kiện", "grade": 12, "construction": "Cho dữ liệu đời con, nhóm được chọn hoặc quy tắc biểu hiện theo môi trường; yêu cầu pha liên kết, tần số hay kết quả đời sau. Suy mô hình và giao tử, chuẩn hóa nhóm thông tin hoặc nhóm sinh sản, tổng hợp theo trọng số; nếu còn cấu hình hợp lệ thì so sánh để tìm cực trị.", "wrong_options": "Sai pha, sai nhóm thông tin, sai mẫu số hoặc dùng lại thành phần xuất phát sau khi đã chọn nhóm.", "difficulty_source": "Giữ đồng thời mô hình, điều kiện chọn và trọng số qua nhiều bước; một nhánh bảng có khóa chưa khớp dữ kiện.", "discrimination": "high", "typical_steps": 6, "evidence_status": "lap_lai_giua_cac_de", "refs": ["8bbf9eea6d33|P3|6|None", "2cbdc74db082|P3|5|None", "55c12f561006|P3|2|None", "61a0198fbfda|P3|4|None"], "paper_count": 4, "row_count": 4}, {"part_kind": "short_answer", "topic": "Xác suất phả hệ phối hợp dữ liệu quần thể", "grade": 12, "construction": "Cho quan hệ gia đình và có thể kèm phân bố quần thể hoặc quy tắc biểu hiện theo giới; yêu cầu xác suất đời con. Truyền ràng buộc, xác định kiểu gene bắt buộc, giữ trọng số cho khả năng còn lại rồi kết hợp truyền allele và giới tính.", "wrong_options": null, "difficulty_source": "Phối hợp nguồn bất định và điều kiện hóa đúng; giả định về cơ cấu giới cùng phân bố allele phải rõ.", "discrimination": "high", "typical_steps": 5, "evidence_status": "lap_lai_giua_cac_de", "refs": ["55c12f561006|P3|1|None", "4b4716b94db4|P3|6|None"], "paper_count": 2, "row_count": 2}, {"part_kind": "short_answer", "topic": "Đại lượng và nhóm chịu tác động từ bảng", "grade": 12, "construction": "Cho bảng quan hệ định lượng hoặc sử dụng nguồn sống; yêu cầu đại lượng quần thể, giá trị so sánh hay nhóm chịu tác động trực tiếp. Chọn đúng hàng cột, xác định quan hệ và chiều tác động rồi tính hoặc ghép nhóm.", "wrong_options": null, "difficulty_source": "Chọn đúng dữ kiện, đơn vị, dấu tác động và quan hệ tài nguyên trực tiếp.", "discrimination": "low", "typical_steps": 3, "evidence_status": "lap_lai_giua_cac_de", "refs": ["55c12f561006|P3|4|None", "55c12f561006|P3|5|None", "61a0198fbfda|P3|3|None"], "paper_count": 2, "row_count": 3}, {"part_kind": "short_answer", "topic": "Suy quan hệ sinh thái từ can thiệp", "grade": 12, "construction": "Cho quan hệ dinh dưỡng và dữ liệu giữa các điều kiện can thiệp; yêu cầu chọn nhận định được hỗ trợ. Ghép chú giải, so cùng đối tượng, dựng đường tác động trực tiếp và gián tiếp rồi tổng hợp mã.", "wrong_options": "Đảo đối tượng chịu tác động, suy thích nghi từ biến động mô tả hoặc đồng nhất ổn định với tổng số cá thể cực đại.", "difficulty_source": "Tách đường nhân quả và kiểm tra thang đo trước khi kết luận.", "discrimination": "high", "typical_steps": 5, "evidence_status": "lap_lai_giua_cac_de", "refs": ["4b4716b94db4|P3|3|None", "61a0198fbfda|P3|2|None"], "paper_count": 2, "row_count": 2}, {"part_kind": "short_answer", "topic": "Chuẩn hóa sau loại bỏ cá thể", "grade": 12, "construction": "Cho cấu trúc di truyền hoặc dữ liệu để suy cấu trúc, kèm nhóm bị loại; yêu cầu tỉ lệ hay lượng trong tập còn lại hoặc thế hệ sau. Xác định nhóm đủ điều kiện, đổi mẫu số rồi áp quy luật sinh sản.", "wrong_options": null, "difficulty_source": "Phân biệt tập xuất phát, tập sinh sản và tập thống kê; nhánh liên quan gene gây chết còn thiếu giả thiết quan hệ giữa các locus.", "discrimination": "medium", "typical_steps": 5, "evidence_status": "lap_lai_giua_cac_de", "refs": ["2cbdc74db082|P3|1|None", "55c12f561006|P3|6|None"], "paper_count": 2, "row_count": 2}, {"part_kind": "short_answer", "topic": "Suy bộ nhiễm sắc thể từ nhãn trên hình", "grade": 12, "construction": "Cho hình phân li có nhãn gene; yêu cầu suy bộ ban đầu. Nhận diện giai đoạn, dùng quan hệ allele để xác lập nhóm tương đồng rồi suy bộ gốc.", "wrong_options": null, "difficulty_source": "Quan hệ nhãn quan trọng hơn số cấu trúc nhìn thấy; bất thường phân li chưa được nêu tường minh nên mức phân hóa còn bất định.", "discrimination": "high", "typical_steps": 4, "evidence_status": "quan_sat_rieng_chua_xac_lap_lap_lai", "refs": ["2cbdc74db082|P3|2|None"], "paper_count": 1, "row_count": 1}, {"part_kind": "short_answer", "topic": "Diễn giải thuộc tính từ hình tháp sinh khối", "grade": 12, "construction": "Cho các hình tháp; yêu cầu sắp thứ tự theo thuộc tính hệ sinh thái. Đọc tương quan giữa các bậc rồi kiểm tra cơ sở nối biểu diễn với thuộc tính cần xếp.", "wrong_options": null, "difficulty_source": "Quy ước suy luận chưa được nêu đủ; sinh khối tức thời chưa tự xác lập ổn định thực tế nên mức phân hóa chưa chắc chắn.", "discrimination": "medium", "typical_steps": 4, "evidence_status": "quan_sat_rieng_chua_xac_lap_lap_lai", "refs": ["4b4716b94db4|P3|2|None"], "paper_count": 1, "row_count": 1}, {"part_kind": "short_answer", "topic": "Trình tự nhân quả và quy nguyên nhân tiến hóa", "grade": 12, "construction": "Cho sự kiện chưa sắp thứ tự hoặc chuỗi biến đổi tần số allele; yêu cầu sắp cơ chế hay chọn nhân tố trực tiếp. Phân biệt nguồn biến dị, truyền lại, sàng lọc và biến cố quần thể rồi kiểm tra quan hệ nhân quả.", "wrong_options": "Để nhu cầu môi trường thay nguồn biến dị, nhầm thay đổi tần số với phát sinh allele hoặc quy tác động cho giao phối khi không phù hợp.", "difficulty_source": "Phân biệt cơ chế cạnh tranh bằng dữ kiện; nhánh quy nguyên nhân chưa đủ thông tin để xác lập duy nhất cơ chế nên không coi thiếu giả thiết là phân hóa.", "discrimination": "medium", "typical_steps": 4, "evidence_status": "lap_lai_giua_cac_de", "refs": ["2cbdc74db082|P3|4|None", "61a0198fbfda|P3|5|None"], "paper_count": 2, "row_count": 2}, {"part_kind": "short_answer", "topic": "Vị trí và thời điểm truyền thông tin di truyền", "grade": 12, "construction": "Cho hình phối hợp các quá trình cùng vị trí can thiệp; yêu cầu chọn nhận định đúng. Xác định chiều tổng hợp, mạch khuôn và tổ chức tế bào rồi theo dõi phần thông tin đã truyền để phân biệt sản phẩm hiện tại với lượt biểu hiện sau.", "wrong_options": "Áp tổ chức tế bào không phù hợp hoặc cho rằng biến đổi DNA lập tức sửa RNA đã hình thành.", "difficulty_source": "Theo dõi đồng thời vị trí, chiều và thời điểm.", "discrimination": "high", "typical_steps": 6, "evidence_status": "quan_sat_rieng_chua_xac_lap_lap_lai", "refs": ["61a0198fbfda|P3|6|None"], "paper_count": 1, "row_count": 1}], "discrimination_moves": [{"move": "Suy mô hình và trạng thái ẩn trước khi tính", "how_to_apply": "Cho dữ liệu quan sát thay mô hình hoàn chỉnh; yêu cầu suy trạng thái trung gian, kiểm tra mô hình cạnh tranh rồi mới dùng cho bước tiếp theo. Không mặc định quy luật quen thuộc khi trái dữ kiện.", "refs": ["8bbf9eea6d33|P1|13|None", "8bbf9eea6d33|P3|6|None", "2cbdc74db082|P1|18|None", "2cbdc74db082|P3|5|None", "55c12f561006|P1|16|None"], "paper_count": 3, "row_count": 5}, {"move": "Điều kiện hóa và giữ trọng số bất định", "how_to_apply": "Cập nhật tập đủ điều kiện và mẫu số trước khi tính; giữ phân bố cho các kiểu gene còn khả dĩ rồi tổng hợp theo trọng số. Phân biệt xác suất có điều kiện với sự kiện đồng thời.", "refs": ["8bbf9eea6d33|P1|13|None", "8bbf9eea6d33|P3|6|None", "55c12f561006|P1|16|None", "55c12f561006|P3|1|None", "2cbdc74db082|P3|5|None", "4b4716b94db4|P3|6|None", "61a0198fbfda|P2|2|d", "61a0198fbfda|P3|4|None"], "paper_count": 5, "row_count": 8}, {"move": "Kiểm tra đồng thời mọi tầng ràng buộc", "how_to_apply": "Nối điều kiện về cấu trúc, phép lai, nhóm được chọn và đầu ra; phương án trung gian đúng vẫn phải qua điều kiện cuối. Với đáp án ghép, kiểm tra riêng từng thành phần.", "refs": ["8bbf9eea6d33|P1|13|None", "2cbdc74db082|P1|18|None", "8bbf9eea6d33|P3|6|None", "55c12f561006|P1|16|None", "55c12f561006|P3|1|None", "2cbdc74db082|P3|5|None", "4b4716b94db4|P2|2|a", "4b4716b94db4|P2|2|d", "61a0198fbfda|P3|4|None"], "paper_count": 5, "row_count": 9}, {"move": "Phối hợp nhãn và các nguồn bằng chứng", "how_to_apply": "Dùng quan hệ allele, gia đình, phân tử hoặc quần thể để kiểm tra cách đọc biểu diễn và xử lí bất định trước khi đếm hay tính. Phát biểu rõ bất thường phân li cùng giả định cần thiết.", "refs": ["2cbdc74db082|P3|2|None", "55c12f561006|P3|1|None", "61a0198fbfda|P1|14|None", "4b4716b94db4|P3|6|None", "61a0198fbfda|P2|2|d"], "paper_count": 4, "row_count": 5}, {"move": "Dựng lại biểu diễn sau biến đổi", "how_to_apply": "Để kết quả trung gian làm đầu vào bước sau; cập nhật trình tự, khung đọc hoặc thành phần nhóm thay vì tiếp tục dùng trạng thái xuất phát.", "refs": ["4b4716b94db4|P1|3|None", "2cbdc74db082|P3|5|None"], "paper_count": 2, "row_count": 2}, {"move": "Kiểm tra tính tất yếu bằng cấu hình hợp lệ", "how_to_apply": "Khi dữ kiện còn cho phép các cấu hình khác nhau, yêu cầu tìm phản ví dụ hoặc chứng minh kết luận đúng với mọi cấu hình. Bằng chứng trực tiếp cho thao tác phản ví dụ trong các mục này là quan sát riêng.", "evidence_status": "quan_sat_rieng_chua_xac_lap_lap_lai", "refs": ["4b4716b94db4|P2|2|c"], "paper_count": 1, "row_count": 1}, {"move": "Tách tác động trực tiếp và gián tiếp", "how_to_apply": "Dùng can thiệp cùng quan hệ giữa các thành phần để theo dõi biến trung gian; không gán mọi biến đổi quan sát được cho tác động trực tiếp. Bằng chứng trực tiếp trong mục này là quan sát riêng.", "evidence_status": "quan_sat_rieng_chua_xac_lap_lap_lai", "refs": ["4b4716b94db4|P3|3|None"], "paper_count": 1, "row_count": 1}, {"move": "Chuyển tín hiệu và vị trí thành cơ chế theo thời gian", "how_to_apply": "Từ đường cong, tín hiệu động hoặc quá trình đang diễn ra, suy t