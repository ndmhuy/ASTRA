 4, "sub": "b", "topic": "Mở rộng học thuyết Mendel: đếm phép lai trong mô hình tương tác gene", "grade": 12, "given": "Quan hệ giữa kiểu gene, sản phẩm sinh hóa và màu sắc trong điều kiện môi trường cho phép biểu hiện.", "task": "Kiểm tra tổng số phép lai giữa các cây cùng kiểu hình khi không phân biệt chiều lai.", "reasoning": "Lập ánh xạ từ các tổ hợp allele sang kiểu hình; nhóm các kiểu gene cùng màu; đếm các cặp kiểu gene có lặp trong mỗi nhóm; cộng và tránh đếm hai chiều.", "combines": ["Tương tác gene", "Phân li độc lập", "Đếm tổ hợp", "Ảnh hưởng môi trường"], "cue_use": "needed in reasoning", "evidence_uncertainty": null}, {"ref": "2cbdc74db082|P2|4|c", "part": "P2", "idx": 4, "sub": "c", "topic": "Mở rộng học thuyết Mendel: tìm phép lai thỏa mãn quan hệ kiểu hình", "grade": 12, "given": "Mô hình tương tác gene và một quan hệ định lượng giữa các màu ở đời con.", "task": "Kiểm tra sự tồn tại của phép lai giữa bố mẹ cùng màu tạo được quan hệ yêu cầu.", "reasoning": "Suy các kiểu gene có thể có của bố mẹ; chọn trạng thái phân li tạo được màu đối chiếu; tính tỉ lệ các nhóm kiểu gene tương ứng; kiểm tra quan hệ giữa các màu.", "combines": ["Tương tác gene", "Phép lai phân li độc lập", "Điều kiện tồn tại của phép lai"], "cue_use": "needed in reasoning", "evidence_uncertainty": null}, {"ref": "2cbdc74db082|P2|4|d", "part": "P2", "idx": 4, "sub": "d", "topic": "Tương tác giữa kiểu gene với môi trường: số kiểu gene và kiểu hình", "grade": 12, "given": "Mô hình các locus phân li độc lập và bảng biểu hiện màu theo môi trường.", "task": "Kiểm tra số loại kiểu gene và kiểu hình tối đa.", "reasoning": "Đếm trạng thái kiểu gene ở từng locus; kết hợp giữa các locus; dùng sơ đồ và bảng môi trường để gộp các trạng thái có cùng kiểu hình.", "combines": ["Số loại kiểu gene", "Tương tác gene", "Quan hệ kiểu gene và môi trường"], "cue_use": "needed in reasoning", "evidence_uncertainty": null}, {"ref": "2cbdc74db082|P3|1|None", "part": "P3", "idx": 1, "sub": null, "topic": "Di truyền học quần thể: cân bằng di truyền sau loại bỏ kiểu hình lặn", "grade": 12, "given": "Một quần thể cân bằng, số cá thể theo kiểu hình và việc loại bỏ một nhóm trước khi ngẫu phối tiếp.", "task": "Tính tỉ lệ cá thể dị hợp trong toàn bộ thế hệ sau và làm tròn.", "reasoning": "Suy tần số allele từ tần số kiểu hình lặn; lập cấu trúc kiểu gene ban đầu; chuẩn hóa thành phần nhóm còn sinh sản; tính lại tần số allele; áp dụng ngẫu phối và làm tròn tỉ lệ dị hợp.", "combines": ["Cân bằng di truyền", "Chọn lọc theo kiểu hình", "Tần số allele", "Tỉ lệ dị hợp"], "cue_use": "needed in reasoning", "evidence_uncertainty": null}, {"ref": "2cbdc74db082|P3|2|None", "part": "P3", "idx": 2, "sub": null, "topic": "Đột biến nhiễm sắc thể: suy bộ nhiễm sắc thể từ hình giảm phân", "grade": 12, "given": "Hình phân bào có các nhiễm sắc thể đang tách về cực và kí hiệu gene giúp nhận diện quan hệ tương đồng.", "task": "Suy số nhiễm sắc thể của tế bào lưỡng bội ban đầu.", "reasoning": "Nhận diện giai đoạn phân li từ trạng thái nhiễm sắc thể; dùng các tổ hợp allele để phân biệt nhóm tương đồng; phát hiện số nhiễm sắc thể trong tế bào quan sát không thể được suy máy móc thành bộ đơn bội; suy bộ lưỡng bội từ số nhóm tương đồng.", "combines": ["Giảm phân", "Nhận diện nhiễm sắc thể tương đồng", "Rối loạn phân li", "Bộ nhiễm sắc thể lưỡng bội"], "cue_use": "needed in reasoning", "evidence_uncertainty": "Đề không nêu rõ có rối loạn phân li; cấu hình allele trong hình và đáp án đòi hỏi cách đọc này. Lời giải tham khảo chỉ nêu số nhóm tương đồng, chưa giải thích bất thường."}, {"ref": "2cbdc74db082|P3|3|None", "part": "P3", "idx": 3, "sub": null, "topic": "Đột biến nhiễm sắc thể: nhận diện thể một nhiễm", "grade": 12, "given": "Các bộ nhiễm sắc thể được biểu diễn bằng chuỗi kí hiệu tương đồng.", "task": "Đếm các trường hợp thiếu một nhiễm sắc thể so với bộ lưỡng bội.", "reasoning": "Xác định số bản sao bình thường của mỗi nhóm; đếm bản sao trong từng chuỗi; phân biệt trường hợp thiếu với trường hợp thừa; cộng số trường hợp thỏa mãn.", "combines": ["Đột biến lệch bội", "Đọc kí hiệu bộ nhiễm sắc thể"], "cue_use": "needed in reasoning", "evidence_uncertainty": null}, {"ref": "2cbdc74db082|P3|4|None", "part": "P3", "idx": 4, "sub": null, "topic": "Học thuyết tiến hóa tổng hợp hiện đại: hình thành quần thể thích nghi", "grade": 12, "given": "Bối cảnh thay đổi khả năng kháng một tác nhân và các sự kiện tiến hóa chưa sắp xếp.", "task": "Sắp xếp các sự kiện theo quan hệ nhân quả.", "reasoning": "Xác định biến dị phải xuất hiện trước khi được chọn lọc; đặt sự di truyền và phát tán biến dị sau phát sinh; xác định vai trò sàng lọc của môi trường; đặt sự phổ biến của đặc điểm thích nghi ở kết quả cuối.", "combines": ["Đột biến", "Sinh sản và di truyền", "Chọn lọc tự nhiên", "Thích nghi quần thể"], "cue_use": "given as a cue", "evidence_uncertainty": null}, {"ref": "2cbdc74db082|P3|5|None", "part": "P3", "idx": 5, "sub": null, "topic": "Liên kết gene và hoán vị gene: tự thụ phấn nhóm kiểu hình được chọn", "grade": 12, "given": "Quan hệ trội lặn, kiểu hình bố mẹ, phân bố kiểu hình đời con và việc chọn một nhóm cho tự thụ phấn.", "task": "Tính tỉ lệ kiểu hình lặn đồng thời trong thế hệ tạo từ nhóm được chọn.", "reasoning": "Phân tích tỉ lệ riêng để suy trạng thái dị hợp của bố mẹ; đối chiếu tỉ lệ chung để nhận diện liên kết; suy pha liên kết và tần số hoán vị; xác định thành phần kiểu gene có điều kiện trong nhóm được chọn; tính xác suất tạo kiểu hình đích từ từng kiểu gene; lấy trung bình có trọng số và làm tròn.", "combines": ["Phân li Mendel", "Liên kết và hoán vị gene", "Xác suất có điều kiện", "Tự thụ phấn", "Trung bình có trọng số"], "cue_use": "needed in reasoning", "evidence_uncertainty": "Lời giải tham khảo bỏ qua phép tính thành phần kiểu gene trong nhóm được chọn; mức suy luận được đánh giá từ dữ kiện đề. Cách tính theo khóa ngầm dùng cùng cơ chế tạo giao tử cho các cây tham gia."}, {"ref": "2cbdc74db082|P3|6|None", "part": "P3", "idx": 6, "sub": null, "topic": "Môi trường và các nhân tố sinh thái: thích nghi của thực vật với ánh sáng", "grade": 12, "given": "Danh sách đặc điểm hình thái liên quan đến điều kiện chiếu sáng.", "task": "Đếm đặc điểm phù hợp với nhóm thực vật thích nghi ánh sáng yếu.", "reasoning": "Nhớ các đặc điểm thu nhận ánh sáng của nhóm cây; đối chiếu từng đặc điểm; đếm các đặc điểm phù hợp.", "combines": ["Nhân tố ánh sáng", "Thích nghi hình thái của thực vật"], "cue_use": "none", "evidence_uncertainty": null}]}
