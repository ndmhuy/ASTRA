ons": "Thay cơ chế phù hợp bằng một cơ chế cũng có thể tạo biến đổi sinh học nhưng thiếu dấu hiệu bắt buộc trong dữ kiện.", "difficulty_source": "Dùng diễn biến được cung cấp thay vì suy ngược chỉ từ kết quả cuối.", "discrimination": "low", "typical_steps": 3, "evidence_status": "Lặp lại giữa các đề.", "refs": ["8bbf9eea6d33|P1|1|None", "8bbf9eea6d33|P1|17|None", "2cbdc74db082|P1|4|None"]}, {"part_kind": "multiple_choice", "topic": "Đặc trưng định lượng và mức tổ chức nhiễm sắc thể", "grade": 12, "construction": "Cho một đặc trưng định lượng hoặc tên mức tổ chức; yêu cầu ghép với kí hiệu hay cấp cấu trúc tương ứng. Xác định đại lượng đang mô tả rồi đối chiếu hệ phân loại đã học.", "wrong_options": "Dùng các mức lân cận trong cùng hệ phân loại, hoặc chuyển sang cấp tổ chức không phù hợp.", "difficulty_source": "Gắn đúng thuật ngữ với đặc trưng định lượng của nó.", "discrimination": "low", "typical_steps": 2, "evidence_status": "Lặp lại giữa các đề.", "refs": ["8bbf9eea6d33|P1|2|None", "2cbdc74db082|P1|3|None"]}, {"part_kind": "multiple_choice", "topic": "Vai trò chất và thành phần trong chuyển hóa", "grade": 11, "construction": "Cho quá trình sinh lí hoặc con đường chuyển hóa; yêu cầu xác định chất tham gia ở vai trò được hỏi. Trước hết nhận diện con đường, sau đó phân biệt nguyên liệu, chất nhận và sản phẩm.", "wrong_options": "Đảo nguyên liệu với sản phẩm, lấy chất trung gian đúng nhưng sai vai trò, hoặc đưa chất thuộc con đường khác.", "difficulty_source": "Nhớ quan hệ chức năng giữa các chất thay vì nhớ danh sách tên chất.", "discrimination": "low", "typical_steps": 2, "evidence_status": "Lặp lại giữa các đề.", "refs": ["8bbf9eea6d33|P1|16|None", "2cbdc74db082|P1|1|None"]}, {"part_kind": "multiple_choice", "topic": "Tính đại lượng quần thể từ các thành phần", "grade": 12, "construction": "Cho dữ liệu thành phần của quần thể; yêu cầu suy đại lượng tổng hợp hoặc dùng đại lượng đó để lựa chọn. Xác định đóng góp của từng thành phần, thực hiện phép tổng hợp rồi trả lời đúng đối tượng được hỏi.", "wrong_options": "Dùng trực tiếp một dữ kiện thành phần thay cho kết quả tổng hợp, bỏ một phần đóng góp hoặc tính đại lượng đối lập. Với hàng có khóa mâu thuẫn dữ kiện, không gán chắc lỗi cho từng lựa chọn.", "difficulty_source": "Chọn đúng quan hệ giữa dữ kiện và đại lượng đích.", "discrimination": "low", "typical_steps": 3, "evidence_status": "Lặp lại giữa các đề; một hàng có bất nhất giữa bảng và khóa.", "refs": ["8bbf9eea6d33|P1|5|None", "2cbdc74db082|P1|2|None"]}, {"part_kind": "multiple_choice", "topic": "Phạm vi bảo toàn và điều kiện đủ trong di truyền, tiến hóa", "grade": 12, "construction": "Cho một thuộc tính hoặc kết luận cần thỏa mãn; yêu cầu chọn biến đổi hay điều kiện đáp ứng. Phân biệt điều kiện góp phần với điều kiện đủ, đồng thời giữ đúng phạm vi đối tượng đang xét.", "wrong_options": "Lấy bảo toàn ở cấp toàn hệ thay cho từng thành phần, hoặc lấy điều kiện thúc đẩy quá trình thay cho tiêu chí hoàn tất.", "difficulty_source": "Kiểm tra kết luận ở đúng cấp độ và đúng mức độ khẳng định.", "discrimination": "medium", "typical_steps": 2, "evidence_status": "Lặp lại giữa các đề.", "refs": ["8bbf9eea6d33|P1|12|None", "2cbdc74db082|P1|14|None"]}, {"part_kind": "multiple_choice", "topic": "Di truyền liên kết giới tính và trạng thái mang allele", "grade": 12, "construction": "Cho kết quả lai hoặc quan hệ truyền tính trạng trong gia đình; yêu cầu kiểm tra kết luận di truyền. Theo dõi nguồn nhận nhiễm sắc thể giới tính, suy kiểu gene và tách trạng thái mang allele khỏi biểu hiện kiểu hình.", "wrong_options": "Áp đặt hệ giới tính quen thuộc, gán sai nguồn nhận allele, đồng nhất không biểu hiện với không mang allele hoặc tuyệt đối hóa khác biệt giữa các giới.", "difficulty_source": "Duy trì nhất quán mô hình truyền allele qua các giới và các thế hệ.", "discrimination": "medium", "typical_steps": 4, "evidence_status": "Lặp lại giữa các đề; mức khó tăng khi phải tự suy cơ chế rồi kiểm tra tỉ lệ.", "refs": ["8bbf9eea6d33|P1|13|None", "2cbdc74db082|P1|7|None"]}, {"part_kind": "multiple_choice", "topic": "Phân loại sinh thái theo tiêu chí và phạm vi trực tiếp", "grade": 12, "construction": "Cho quan hệ, nơi sống hoặc thành phần môi trường; yêu cầu phân loại. Xác định đối tượng trực tiếp và tiêu chí phân loại trước khi đối chiếu thuật ngữ.", "wrong_options": "Phân loại theo biểu hiện bề ngoài, lấy môi trường của đối tượng liên quan thay cho đối tượng được hỏi, hoặc nhầm một miền thành phần với toàn phạm vi.", "difficulty_source": "Ưu tiên tiêu chí định nghĩa hơn chi tiết dễ gây liên tưởng.", "discrimination": "low", "typical_steps": 2, "evidence_status": "Lặp lại giữa các đề.", "refs": ["8bbf9eea6d33|P1|3|None", "8bbf9eea6d33|P1|10|None", "8bbf9eea6d33|P1|11|None", "2cbdc74db082|P1|11|None"]}, {"part_kind": "true_false", "topic": "Đọc hình giải phẫu và theo đường vận chuyển", "grade": 11, "construction": "Cho hình cơ quan có vị trí mã hóa; yêu cầu kiểm tra tên gọi hoặc đường vận chuyển qua các vị trí. Định hướng hình, nhận diện cấu trúc rồi lần theo đường đi sinh lí.", "wrong_options": "Nhầm vị trí do phía nhìn, ghép sai nhãn hoặc suy thành phần dịch vận chuyển chỉ từ tên loại mạch.", "difficulty_source": "Chuyển từ hình mã hóa sang cấu trúc và đường đi đã học.", "discrimination": "low", "typical_steps": 3, "evidence_status": "Lặp lại giữa các đề; các phát biểu được cung cấp trong nhóm này được khóa xác nhận đúng.", "refs": ["8bbf9eea6d33|P2|3|b", "8bbf9eea6d33|P2|3|d", "2cbdc74db082|P2|1|a"]}, {"part_kind": "true_false", "topic": "Từ cấu tạo cơ quan đến cơ chế hoạt động", "grade": 11, "construction": "Cho hình cơ quan kèm trạng thái hoạt động hoặc dữ liệu chức năng; yêu cầu đánh giá cơ chế tại vị trí được chỉ. Nhận diện cấu trúc, xác định chức năng và kiểm tra quan hệ giữa trạng thái với quá trình xảy ra.", "wrong_options": "Ghép đúng cơ quan nhưng sai cơ chế, hoặc kéo dài trạng thái của một pha sang pha khác.", "difficulty_source": "Kết nối cấu tạo với hoạt động thay vì dừng ở gọi tên.", "discrimination": "medium", "typical_steps": 3, "evidence_status": "Lặp lại giữa các đề.", "refs": ["8bbf9eea6d33|P2|3|a", "8bbf9eea6d33|P2|3|c", "2cbdc74db082|P2|1|b"]}, {"part_kind": "true_false", "topic": "Theo dõi chức năng và sản phẩm trong quy trình công nghệ gene", "grade": 12, "construction": "Cho sơ đồ chuyển gene, chọn lọc hoặc thu sản phẩm; yêu cầu kiểm tra chức năng thành phần hay bản chất kết quả. Theo dõi gene hoặc dấu chuẩn qua từng công đoạn rồi xác định điều mà kết quả thực sự chứng tỏ.", "wrong_options": "Nhầm chức năng gene đích với dấu chuẩn, nhầm sản phẩm biểu hiện gene với tác nhân nguyên vẹn, hoặc mở rộng giá trị chứng minh của phép chọn lọc.", "difficulty_source": "Đọc quy trình như chuỗi quan hệ chức năng thay vì nhận diện hình riêng lẻ.", "discrimination": "medium", "typical_steps": 3, "evidence_status": "Lặp lại giữa các đề; kết luận chọn lọc phải giới hạn trong mô hình sơ đồ.", "refs": ["8bbf9eea6d33|P2|1|a", "8bbf9eea6d33|P2|1|b", "2cbdc74db082|P2|3|a"]}, {"part_kind": "true_false", "topic": "Phân biệt tổ chức DNA, biểu hiện gene và sản phẩm", "grade": 12, "construction": "Cho cách tổ chức vật chất di truyền hoặc các giai đoạn của quy trình; yêu cầu kiểm tra hệ quả về biểu hiện hay tính ổn định di truyền. Tách vị trí lưu giữ gene, đơn vị phiên mã, sản phẩm dịch mã và trạng thái phát triển.", "wrong_options": "Biến một vị trí chứa gene thành điều kiện bắt buộc để biểu hiện, đồng nhất bản phiên mã chung với sản phẩm chung, hoặc đồng nhất thay đổi hình thái với thay đổi bộ gene.", "difficulty_source": "Không suy đồng nhất giữa những cấp tổ chức có liên hệ nhưng không tương đương.", "discrimination": "medium", "typical_steps": 3, "evidence_status": "Lặp lại giữa các đề.", "refs": ["8bbf9eea6d33|P2|1|c", "2cbdc74db082|P2|2|a", "2cbdc74db082|P2|3|b"]}, {"part_kind": "true_false", "topic": "Giới hạn kết luận từ dữ liệu sinh thái và sinh lí", "grade": [11, 12], "construction": "Cho hình cấu tạo hoặc biến động đồng thời của các đại lượng; yêu cầu đánh giá kết luận về quan hệ, tác động hoặc thứ hạng ảnh hưởng. Phân biệt điều quan sát được với cơ chế giả định và kiểm tra mức độ mạnh của kết luận.", "wrong_options": "Biến tương quan thành quan hệ dinh dưỡng hoặc nhân quả; từ dấu hiệu phụ thuộc suy ngay mức ảnh hưởng lớn nhất.", "difficulty_source": "Nhận ra khi dữ kiện chưa đủ để xác lập cơ chế hay thứ hạng duy nhất.", "discrimination": "medium", "typical_steps": 3, "evidence_status": "Lặp lại về kiểu yêu cầu; các hàng sinh thái có thiếu căn cứ nên không dùng để xác nhận độ phân hóa hoặc tính đúng của khóa.", "refs": ["8bbf9eea6d33|P2|2|a", "8bbf9eea6d33|P2|2|b", "8bbf9eea6d33|P2|2|c", "2cbdc74db082|P2|1|c"]}, {"part_kind": "multiple_choice", "topic": "Đọc đồ thị đáp ứng và mạng tác động sinh thái", "grade": [11, 12], "construction": "Cho biểu diễn trực quan chứa các quan hệ cần giải mã; yêu cầu chọn nhận định phù hợp hoặc không phù hợp. Đọc chú giải, tách từng quan hệ, theo dõi miền điều kiện hoặc đường tác động rồi kiểm tra kết luận tổng hợp.", "wrong_options": "Đảo chiều so sánh, khái quát ưu thế ra ngoài miền dữ liệu, bỏ qua độ mạnh hoặc đường tác động gián tiếp.", "difficulty_source": "Phối hợp các thành phần của biểu diễn và giới hạn phạm vi kết luận.", "discrimination": "medium", "typical_steps": 4, "evidence_status": "Quan sát riêng trong một đề; nhận định về mạng có phần vượt thông tin trực tiếp của hình.", "refs": ["8bbf9eea6d33|P1|4|None", "8bbf9eea6d33|P1|14|None"]}, {"part_kind": "multiple_choice", "topic": "Vị trí trong chuỗi dinh dưỡng và chiều chuyển hóa", "grade": 12, "construction": "Cho chuỗi truyền vật chất hoặc dạng đầu vào và đầu ra; yêu cầu xác định thành phần hay nhóm thực hiện. Xác định điểm xuất phát, theo đúng chiều biến đổi rồi ghép với vai trò tương ứng.", "wrong_options": "Đếm sai điểm bắt đầu, đảo chiều quá trình hoặc hoán đổi các vai trò gần nhau trong cùng hệ.", "difficulty_source": "Giữ đúng chiều quan hệ và vị trí tương đối.", "discrimination": "low", "typical_steps": 2, "evidence_status": "Quan sát riêng trong một đề.", "refs": ["8bbf9eea6d33|P1|7|None", "8bbf9eea6d33|P1|8|None"]}, {"part_kind": "multiple_choice", "topic": "Nguồn bằng chứng và phạm vi kết luận tiến hóa", "grade": 12, "construction": "Cho vật chứng hoặc dẫn chiếu thí nghiệm; yêu cầu phân loại nguồn bằng chứng hay chọn kết luận phù hợp. Xác định bằng chứng được tạo ra theo cách nào, nội dung trực tiếp của nó và giới hạn suy rộng.", "wrong_options": "Nhầm nguồn bằng chứng với nội dung phân tích, thay cơ chế tạo bằng chứng hoặc mở rộng kết luận vượt điều kiện được nêu.", "difficulty_source": "Phân biệt bằng chứng trực tiếp với diễn giải đi kèm.", "discrimination": "low", "typical_steps": 3, "evidence_status": "Lặp lại giữa các đề ở cấu trúc nhận diện và giới hạn bằng chứng.", "refs": ["8bbf9eea6d33|P1|18|None", "2cbdc74db082|P1|13|None"]}, {"part_kind": "multiple_choice", "topic": "Cơ chế vận chuyển và chức năng cơ quan thực vật", "grade": 11, "construction": "Cho hoạt động trao đổi nước hoặc khoáng; yêu cầu xác định cơ chế tham gia hay cơ quan đảm nhiệm chủ yếu. Liên hệ chiều vận chuyển, đặc điểm cấu tạo và chức năng sinh lí.", "wrong_options": "Thu hẹp quá trình vào một cơ chế, nhầm nơi dẫn truyền với nơi thực hiện chủ yếu hoặc đảo hấp thụ với thoát ra.", "difficulty_source": "Nhớ đầy đủ cơ chế và phân biệt vai trò của các cơ quan.", "discrimination": "low", "typical_steps": 2, "evidence_status": "Quan sát riêng trong một đề.", "refs": ["2cbdc74db082|P1|9|None", "2cbdc74db082|P1|12|None"]}, {"part_kind": "multiple_choice", "topic": "Nhận diện tế bào, giai đoạn và phạm vi công nghệ sinh học", "grade": 10, "construction": "Cho đặc tính chức năng, trạng thái tế bào hoặc định nghĩa ứng dụng; yêu cầu nhận diện khái niệm tương ứng. Chọn dấu hiệu quyết định và phân biệt đối tượng với dạng chuyên biệt, giai đoạn khác hoặc lĩnh vực hẹp hơn.", "wrong_options": "Nhầm khả năng biệt hóa với chuyên hóa, nhầm hoạt động đặc trưng giữa các kì hoặc lấy công nghệ thành phần thay cho lĩnh vực bao quát.", "difficulty_source": "Dùng dấu hiệu bản chất để phân loại.", "discrimination": "low", "typical_steps": 2, "evidence_status": "Quan sát riêng trong một đề.", "refs": ["2cbdc74db082|P1|6|None", "2cbdc74db082|P1|10|None", "2cbdc74db082|P1|17|None"]}, {"part_kind": "multiple_choice", "topic": "Phạm vi phát biểu và hệ quy chiếu trong tiến hóa", "grade": 12, "construction": "Cho các phát biểu về cơ chế hoặc một hệ quan điểm; yêu cầu chọn phát biểu đúng trong phạm vi đó. Kiểm tra đối tượng, tính định hướng, mức độ tất yếu và sự phù hợp của thuật ngữ với hệ quy chiếu.", "wrong_options": "Biến khả năng thành tất yếu, gán định hướng cho biến đổi ngẫu nhiên hoặc dùng cách giải thích hiện đại thay cho quan điểm lịch sử được hỏi.", "difficulty_source": "Đúng nội dung chưa đủ; còn phải đúng mức khẳng định và đúng hệ quy chiếu.", "discrimination": "medium", "typical_steps": 3, "evidence_status": "Quan sát riêng trong một đề.", "refs": ["2cbdc74db082|P1|15|None", "2cbdc74db082|P1|16|None"]}, {"part_kind": "multiple_choice", "topic": "Phả hệ, nhóm máu và điều kiện lựa chọn", "grade": 12, "construction": "Cho phả hệ có thông tin kiểu hình chưa đầy đủ và điều kiện tham gia được mã hóa; yêu cầu chọn đối tượng phù hợp. Suy trạng thái di truyền ẩn, kiểm tra tương hợp rồi áp dụng ràng buộc thực tế.", "wrong_options": "Chọn đối tượng tương hợp nhưng không thỏa điều kiện tham gia, hoặc suy sai trạng thái của đối tượng cần xét.", "difficulty_source": "Phải hoàn tất suy luận sinh học rồi tiếp tục lọc theo chú giải hình.", "discrimination": "high", "typical_steps": 4, "evidence_status": "Quan sát riêng trong một đề; chỉ áp dụng mô hình tương hợp giản lược của bài học.", "refs": ["2cbdc74db082|P1|18|None"]}, {"part_kind": "true_false", "topic": "Đọc dữ liệu phân tử kết hợp phả hệ", "grade": 12, "construction": "Cho dữ liệu DNA, protein và gia đình; yêu cầu kiểm tra hệ quả đột biến, tính trội lặn, kiểu gene hoặc xác suất. Gắn dấu chuẩn với allele, đối chiếu kiểu hình rồi kiểm tra mô hình di truyền trước khi suy hệ quả.", "wrong_options": "Suy độ dài protein trực tiếp từ độ dài DNA, đồng nhất mang allele với biểu hiện, hoặc bác bỏ kí hiệu kiểu gene khi chưa xác định chắc vị trí gene.", "difficulty_source": "Chuyển giữa các tầng bằng chứng và nhận biết mô hình chưa được xác lập duy nhất.", "discrimination": "medium", "typical_steps": 4, "evidence_status": "Quan sát riêng trong một đề; các kết luận về xác suất, vị trí gene và độ dài protein có giới hạn bằng chứng riêng.", "refs": ["8bbf9eea6d33|P2|4|a", "8bbf9eea6d33|P2|4|b", "8bbf9eea6d33|P2|4|c", "8bbf9eea6d33|P2|4|d"]}, {"part_kind": "true_false", "topic": "Đọc trực tiếp và kiểm tra cơ chế trong bộ hình dùng chung", "grade": [11, 12], "construction": "Cho hình hoặc quy trình làm nền cho các phát biểu độc lập; có phát biểu chỉ cần đọc nhãn hay nhớ thuật ngữ, có phát biểu phải suy chức năng hoặc hệ quả can thiệp. Xác định yêu cầu thực sự của từng phát biểu trước khi huy động dữ kiện.", "wrong_options": "Đọc nhầm chú giải, đánh đồng chất trực tiếp với cách gọi giản lược, bỏ qua tác động chức năng của đột biến hoặc ghép sai thích nghi cấu tạo.", "difficulty_source": "Không mặc định mọi phát biểu dùng chung hình đều cần cùng mức suy luận.", "discrimination": "medium", "typical_steps": 3, "evidence_status": "Lặp lại giữa các đề; thuật ngữ cảm ứng và giả thiết đột biến cần được giữ đúng giới hạn đã ghi trong hàng.", "refs": ["8bbf9eea6d33|P2|1|b", "8bbf9eea6d33|P2|1|c", "8bbf9eea6d33|P2|1|d", "8bbf9eea6d33|P2|2|d", "8bbf9eea6d33|P2|3|a", "8bbf9eea6d33|P2|3|b", "8bbf9eea6d33|P2|3|c", "8bbf9eea6d33|P2|3|d", "2cbdc74db082|P2|1|a", "2cbdc74db082|P2|1|b", "2cbdc74db082|P2|1|c", "2cbdc74db082|P2|1|d", "2cbdc74db082|P2|2|a", "2cbdc74db082|P2|2|b", "2cbdc74db082|P2|2|c", "2cbdc74db082|P2|2|d", "2cbdc74db082|P2|3|a", "2cbdc74db082|P2|3|b"]}, {"part_kind": "short_answer", "topic": "Suy kết quả di truyền và chuẩn hóa theo nhóm cung cấp thông tin", "grade": 12, "construction": "Cho tần số, kết quả phép lai hoặc các lựa chọn di truyền; yêu cầu tính, chọn và mã hóa kết quả. Xác định mô hình, chuyển dữ liệu về allele hoặc giao tử, tổ hợp xác suất rồi so với điều kiện đích.", "wrong_options": "Ở hàng có lựa chọn, nhiễu đổi pha liên kết, dùng sai mẫu số, bỏ locus không phân li hoặc không tổ hợp tỉ lệ thành phần; hàng trả kết quả trực tiếp không có phương án nhiễu.", "difficulty_source": "Phân biệt dữ liệu toàn quần thể với dữ liệu của nhóm có điều kiện và không suy quan hệ đơn điệu khi chưa kiểm tra mô hình.", "discrimination": "medium", "typical_steps": 4, "evidence_status": "Quan sát riêng trong một đề; hàng về hoán vị có phân hóa cao, hàng tổ hợp phép lai dựa trên giả định phân li chưa được phát biểu riêng.", "refs": ["8bbf9eea6d33|P3|1|None", "8bbf9eea6d33|P3|2|None", "8bbf9eea6d33|P3|6|None"]}, {"part_kind": "short_answer", "topic": "Đối chiếu biểu diễn với mô hình sinh học", "grade": [10, 12], "construction": "Cho đồ thị, cây quan hệ hoặc kết quả thí nghiệm được dẫn chiếu; yêu cầu chọn hay sắp xếp mã. Xác định quy luật sinh học, chuyển quy luật thành dấu hiệu trên biểu diễn rồi đối chiếu để mã hóa đáp án.", "wrong_options": "Nếu có đồ thị lựa chọn, nhiễu đặt sai thời điểm tăng giảm hoặc bỏ một quá trình bắt buộc; các hàng còn lại không cung cấp phương án sai riêng.", "difficulty_source": "Đọc cấu trúc quan hệ và trình tự thay vì dựa vào vị trí bề ngoài; dữ liệu bị thiếu không được thay bằng suy đoán từ khóa.", "discrimination": "medium", "typical_steps": 3, "evidence_status": "Quan sát riêng trong một đề; hàng điều hòa gene thiếu bảng nên chưa thể đánh giá thao tác chọn đáp án thực tế.", "refs": ["8bbf9eea6d33|P3|3|None", "8bbf9eea6d33|P3|4|None", "8bbf9eea6d33|P3|5|None"]}], "discrimination_moves": [{"move": "Buộc suy mô hình trước khi tính.", "how_to_apply": "Đưa dữ liệu phân li có khả năng phân biệt cơ chế; chỉ sau khi xác lập mô hình mới yêu cầu suy kiểu gene hoặc kết quả đời sau. Không cho phép thay suy luận bằng mặc định từ bối cảnh quen thuộc.", "refs": ["8bbf9eea6d33|P1|13|None", "8bbf9eea6d33|P3|6|None", "2cbdc74db082|P1|18|None"]}, {"move": "Đổi tập quy chiếu khi tính xác suất.", "how_to_apply": "Phân biệt tỉ lệ trên toàn bộ đời con với tỉ lệ trong nhóm giới cung cấp thông tin; yêu cầu người làm xác định lại mẫu số trước khi suy tần số giao tử hoặc kiểu hình.", "refs": ["8bbf9eea6d33|P1|13|None", "8bbf9eea6d33|P3|6|None"]}, {"move": "Tách nhận diện trạng thái di truyền khỏi suy hệ quả.", "how_to_apply": "Yêu cầu xác định kiểu gene hoặc pha liên kết rồi mới đánh giá truyền allele, tương hợp hay tái tổ hợp. Thiết kế lựa chọn sai ở từng mắt xích để phân biệt người hiểu mô hình với người chỉ tính được một phần.", "refs": ["8bbf9eea6d33|P1|13|None", "8bbf9eea6d33|P3|6|None", "2cbdc74db082|P1|18|None"]}, {"move": "Để dữ kiện ở thế hệ sau ràng buộc trạng thái chưa biết.", "how_to_apply": "Không cung cấp sẵn mọi kiểu gene; dùng kết quả đời con hoặc quan hệ gia đình để loại các khả năng của thế hệ trước rồi mới giải yêu cầu cuối.", "refs": ["8bbf9eea6d33|P1|13|None", "8bbf9eea6d33|P3|6|None", "2cbdc74db082|P1|18|None"]}, {"move": "Đặt ràng buộc ở các kênh thông tin khác nhau.", "how_to_apply": "Kết hợp dữ kiện sinh học với chú giải hoặc điều kiện lựa chọn; đáp án phải thỏa đồng thời các ràng buộc. Chỉ dùng điều kiện được thể hiện rõ, không thêm giả định ngoài dữ kiện.", "refs": ["8bbf9eea6d33|P1|13|None", "8bbf9eea6d33|P3|6|None", "2cbdc74db082|P1|18|None"]}], "easy_vs_hard": [{"topic": "Di truyền liên kết giới tính", "easy": "Cho sẵn quy luật di truyền; chỉ cần theo nguồn truyền allele và phân biệt mang allele với biểu hiện.", "hard": "Để người làm tự suy hệ di truyền từ kết quả lai rồi tiếp tục xác định kiểu gene và tỉ lệ có điều kiện.", "easy_refs": ["2cbdc74db082|P1|7|None"], "hard_refs": ["8bbf9eea6d33|P1|13|None", "8bbf9eea6d33|P3|6|None"]}, {"topic": "Di truyền học quần thể", "easy": "Cho tần số kiểu gene và tính trực tiếp phần đóng góp allele.", "hard": "Cho tỉ lệ kiểu hình dưới điều kiện cân bằng; phải suy tần số allele rồi so mức dị hợp, tránh suy tăng giảm đơn điệu.", "easy_refs": ["2cbdc74db082|P1|2|None"], "hard_refs": ["8bbf9eea6d33|P3|1|None"]}, {"topic": "Quang hợp", "easy": "Nhận diện sản phẩm hoặc vai trò chất từ kiến thức con đường chuyển hóa.", "hard": "Đọc đồ thị đáp ứng, phân biệt các điểm đặc trưng và giới hạn nhận định theo miền điều kiện.", "easy_refs": ["8bbf9eea6d33|P1|16|None", "2cbdc74db082|P1|1|None"], "hard_refs": ["8bbf9eea6d33|P1|4|None"]}, {"topic": "Cấu tạo và hoạt động cơ quan", "easy": "Gọi tên cấu trúc hoặc theo đường vận chuyển trên hình quen thuộc.", "hard": "Dùng cấu tạo để giải thích dữ liệu chức năng, trạng thái hoạt động hoặc cơ chế tiêu hóa.", "easy_refs": ["8bbf9eea6d33|P2|3|b", "8bbf9eea6d33|P2|3|d", "2cbdc74db082|P2|1|a"], "hard_refs": ["8bbf9eea6d33|P2|3|a", "8bbf9eea6d33|P2|3|c", "2cbdc74db082|P2|1|b"]}, {"topic": "Nhân tố tiến hóa", "easy": "Cho diễn biến nổi bật để nhận diện trực tiếp cơ chế.", "hard": "So các cơ chế bằng tác động lên allele, kiểu gene và mức độ tất yếu của phát biểu.", "easy_refs": ["8bbf9eea6d33|P1|1|None"], "hard_refs": ["2cbdc74db082|P1|15|None"]}], "fact_use": {"common": [{"use": "Định nghĩa và thuật ngữ là đích hỏi trực tiếp; lựa chọn phân biệt các khái niệm gần nhau về phạm vi hoặc chức năng.", "refs": ["8bbf9eea6d33|P1|9|None", "8bbf9eea6d33|P1|15|None", "8bbf9eea6d33|P2|1|d", "2cbdc74db082|P1|8|None", "2cbdc74db082|P1|10|None", "2cbdc74db082|P1|11|None"]}, {"use": "Kiến thức cấu tạo và vai trò được dùng để định vị liên kết, chất chuyển hóa hoặc cơ quan trên biểu diễn.", "refs": ["8bbf9eea6d33|P1|6|None", "8bbf9eea6d33|P1|16|None", "8bbf9eea6d33|P2|3|b", "2cbdc74db082|P1|5|None", "2cbdc74db082|P1|12|None", "2cbdc74db082|P2|1|a"]}, {"use": "Dữ liệu định lượng được cung cấp để tính toán hoặc so sánh; cần phân biệt chúng với hằng kiến thức phải nhớ.", "refs": ["8bbf9eea6d33|P1|5|None", "8bbf9eea6d33|P3|1|None", "8bbf9eea6d33|P3|6|None", "2cbdc74db082|P1|2|None"]}, {"use": "Tên gọi hoặc dấu mốc lịch sử làm tín hiệu xác định thí nghiệm và hệ quan điểm; thao tác trả lời vẫn tập trung vào nội dung hay phạm vi kết luận.", "refs": ["2cbdc74db082|P1|13|None", "2cbdc74db082|P1|16|None"]}], "observed_only": [{"use": "Có yêu cầu nhớ trực tiếp kích thước đặc trưng của cấp cấu trúc; chưa đủ căn cứ coi đây là cấu trúc tái diễn giữa các đề.", "refs": ["2cbdc74db082|P1|3|None"]}], "not_observed": [{"use": "Không thấy yêu cầu trả lại riêng niên đại hay tên nhân vật làm đích đáp án; các dẫn chiếu lịch sử được dùng để hỏi kiến thức sinh học.", "refs": ["2cbdc74db082|P1|13|None", "2cbdc74db082|P1|16|None"]}, {"use": "Không thấy yêu cầu nhớ mã đối tượng như một sự kiện độc lập; mã trên hình và bảng dùng để chỉ vị trí hoặc mã hóa kết quả suy luận.", "refs": ["8bbf9eea6d33|P3|4|None", "8bbf9eea6d33|P3|6|None", "2cbdc74db082|P1|18|None", "2cbdc74db082|P2|1|a"]}]}, "anti_patterns": [{"avoid": "Biến dẫn chiếu lịch sử thành bài kiểm tra nhớ riêng tên hoặc niên đại.", "basis": "Trong các hàng có dẫn chiếu lịch sử, yêu cầu thực tế hướng đến nội dung học thuyết hoặc phạm vi chứng minh.", "refs": ["2cbdc74db082|P1|13|None", "2cbdc74db082|P1|16|None"]}, {"avoid": "Yêu cầu học sinh tự thiết kế toàn bộ quy trình thực nghiệm mở.", "basis": "Các hàng thực nghiệm cung cấp mô hình hoặc quy trình để nhận diện chức năng, giải thích kết quả hay kiểm tra nhận định; không yêu cầu xây dựng một thiết kế mở.", "refs": ["8bbf9eea6d33|P2|1|a", "8bbf9eea6d33|P3|5|None", "2cbdc74db082|P2|3|a", "2cbdc74db082|P2|3|b"]}, {"avoid": "Đòi câu trả lời nghị luận dài thay cho đầu ra đóng hoặc mã hóa.", "basis": "Các nhiệm vụ được mô tả là lựa chọn, đánh giá phát biểu, tính kết quả hoặc sắp xếp mã; không có nhiệm vụ viết lập luận tự luận dài.", "refs": ["8bbf9eea6d33|P1|13|None", "8bbf9eea6d33|P2|3|a", "8bbf9eea6d33|P3|1|None", "8bbf9eea6d33|P3|2|None", "8bbf9eea6d33|P3|4|None", "2cbdc74db082|P1|18|None", "2cbdc74db082|P2|1|b"]}, {"avoid": "Biến bài tính di truyền thành bài dẫn xuất toán học hình thức.", "basis": "Các hàng định lượng yêu cầu áp dụng mô hình sinh học, tổ hợp tỉ lệ và chuẩn hóa xác suất; không yêu cầu chứng minh công thức tổng quát.", "refs": ["8bbf9eea6d33|P3|1|None", "8bbf9eea6d33|P3|2|None", "8bbf9eea6d33|P3|6|None", "2cbdc74db082|P1|2|None"]}]}, {"evidence_scope": "Chỉ mô tả các hàng đã cung cấp từ nguồn cấp tỉnh, bên thứ ba. Mỗi mẫu được ghi rõ đã xuất hiện ở các đề khác nhau hay mới là quan sát riêng trong một đề. Các quan sát riêng được giữ để mô tả cấu trúc câu hỏi, không được xem là bằng chứng tái diễn. Không suy rộng các nhận xét vắng mặt ra ngoài tập hàng này.", "patterns": [{"part_kind": "multiple_choice", "topic": "Nhận diện khái niệm từ dấu hiệu định nghĩa", "grade": 12, "construction": "Cho mô tả ngắn về một hiện tượng, tập hợp hoặc đại lượng; yêu cầu chọn thuật ngữ tương ứng. Tách dấu hiệu quyết định khỏi các chi tiết phụ rồi kiểm tra phạm vi áp dụng của định nghĩa.", "wrong_options": "Dùng thuật ngữ gần nghĩa, khái niệm cùng lĩnh vực hoặc mô tả chỉ thỏa một phần định nghĩa.", "difficulty_source": "Phân biệt các khái niệm gần nhau bằng tiêu chí bản chất.", "discrimination": "low", "typical_steps": 2, "recurrence_status": "Đã quan sát ở các đề khác nhau.", "refs": ["55c12f561006|P1|10|None", "55c12f561006|P1|14|None", "55c12f561006|P1|18|None", "4b4716b94db4|P1|9|None", "4b4716b94db4|P1|11|None"]}, {"part_kind": "multiple_choice", "topic": "Quan hệ giữa cấu trúc, chức năng và cấp tổ chức", "grade": [10, 11, 12], "construction": "Cho chức năng, sản phẩm hoặc dấu hiệu cấu tạo; yêu cầu nhận diện đối tượng sinh học tương ứng. Ghép dấu hiệu với kiến thức nền rồi loại các đối tượng thuộc quan hệ cấu trúc hoặc chức năng khác.", "wrong_options": "Thay bằng thành phần chưa hoàn chỉnh, nhóm phân tử khác, mức tổ chức lân cận hoặc sản phẩm của giai đoạn khác.", "difficulty_source": "Nhớ đúng quan hệ giữa đối tượng và thuộc tính, không chọn chỉ vì cùng xuất hiện trong một chương.", "discrimination": "low", "typical_steps": 2, "recurrence_status": "Đã quan sát ở các đề khác nhau.", "refs": ["55c12f561006|P1|4|None", "55c12f561006|P1|5|None", "55c12f561006|P1|17|None", "4b4716b94db4|P1|13|None", "4b4716b94db4|P1|14|None"]}, {"part_kind": "multiple_choice", "topic": "Nguồn nguyên liệu và khuôn của quá trình sinh học", "grade": [11, 12], "construction": "Nêu một quá trình hoặc sản phẩm; yêu cầu xác định chất nguồn hay phân tử làm khuôn. Truy về phản ứng thành phần thay vì suy từ phương trình tổng quát hoặc thành phần nguyên tố.", "wrong_options": "Đảo khuôn với sản phẩm, lấy chất tham gia một quá trình liên quan hoặc chọn chất có thành phần hóa học tương tự.", "difficulty_source": "Phân biệt vai trò cơ chế với sự hiện diện của chất trong toàn bộ quá trình.", "discrimination": "low", "typical_steps": 2, "recurrence_status": "Đã quan sát ở các đề khác nhau.", "refs": ["55c12f561006|P1|12|None", "4b4716b94db4|P1|17|None", "4b4716b94db4|P1|18|None"]}, {"part_kind": "multiple_choice", "topic": "Nhận diện cơ chế từ dấu hiệu đặc trưng", "grade": 12, "construction": "Cho vị trí vật chất di truyền, chuỗi biến đổi hoặc loại dữ liệu sinh học; yêu cầu chọn quy luật, cơ chế hay loại bằng chứng phù hợp. Nhận diện dấu hiệu đặc hiệu rồi đối chiếu với phạm vi của từng phương án.", "wrong_options": "Dùng cơ chế có thật nhưng thiếu điều kiện tương ứng, áp dụng quy luật di truyền khác hoặc đổi cấp độ của bằng chứng.", "difficulty_source": "Chọn đúng cơ chế từ dữ kiện thay vì từ tên chủ đề quen thuộc.", "discrimination": "low", "typical_steps": 3, "recurrence_status": "Đã quan sát ở các đề khác nhau.", "refs": ["55c12f561006|P1|13|None", "4b4716b94db4|P1|1|None", "4b4716b94db4|P1|2|None", "4b4716b94db4|P1|15|None"]}, {"part_kind": "multiple_choice", "topic": "Ý nghĩa sinh thái của phân bố và sử dụng tài nguyên", "grade": 12, "construction": "Cho cách bố trí hoặc phân bố sinh vật trong không gian; yêu cầu xác định nhân tố chi phối hay ý nghĩa sinh thái. Liên hệ cấu trúc không gian với cách sử dụng tài nguyên và mức chồng lấn nhu cầu.", "wrong_options": "Chọn yếu tố có liên quan nhưng không giải thích trực tiếp cách phân bố, đảo chiều không gian hoặc nhầm phân hóa với mở rộng phạm vi sử dụng nguồn sống.", "difficulty_source": "Tìm quan hệ giải thích trực tiếp thay vì liệt kê mọi yếu tố có ảnh hưởng.", "discrimination": "low", "typical_steps": 2, "recurrence_status": "Đã quan sát ở các đề khác nhau.", "refs": ["55c12f561006|P1|6|None", "4b4716b94db4|P1|7|None"]}, {"part_kind": "multiple_choice", "topic": "Tần số giao tử và hoán vị gene", "grade": 12, "construction": "Cho pha liên kết cùng thông tin về giao tử hoặc bản đồ di truyền; yêu cầu suy tần số hoán vị hay tổng lớp đời con tương ứng. Phân loại giao tử trước, chuyển giữa tần số một lớp và cả nhóm, rồi liên hệ với kết quả phép lai.", "wrong_options": "Đồng nhất tần số một giao tử với tổng tần số hoán vị, nhầm nhóm liên kết với nhóm tái tổ hợp hoặc cộng lặp các lớp.", "difficulty_source": "Giữ đúng đơn vị xác suất đang xét và nhận diện đúng pha liên kết.", "discrimination": "medium", "typical_steps": 3, "recurrence_status": "Đã quan sát ở các đề khác nhau.", "refs": ["55c12f561006|P1|7|None", "4b4716b94db4|P1|12|None"]}, {"part_kind": "multiple_choice", "topic": "Suy cơ chế và bố mẹ từ phân li kiểu hình", "grade": 12, "construction": "Cho quy luật biểu hiện hoặc phân bố kiểu hình đời con; yêu cầu suy kiểu gene bố mẹ hay mô hình di truyền. Phân tích phân li riêng, đối chiếu phân li chung và kiểm tra cách gộp kiểu gene thành kiểu hình.", "wrong_options": "Áp dụng phép lai quen thuộc, ghép sai trạng thái tại locus, đảo tính trạng hoặc nhầm tương tác với liên kết và đa hiệu.", "difficulty_source": "Phải giải thích dữ kiện đời con thay vì nhận dạng bằng một dấu hiệu rời rạc. Tên gọi dạng tương tác có thể phụ thuộc quy ước tài liệu.", "discrimination": "medium", "typical_steps": 3, "recurrence_status": "Đã quan sát ở các đề khác nhau.", "refs": ["55c12f561006|P1|1|None", "4b4716b94db4|P1|10|None"]}, {"part_kind": "multiple_choice", "topic": "Kiểm tra phạm vi của nhận định", "grade": 12, "construction": "Cho các kết luận và yêu cầu tìm kết luận sai hoặc không được hỗ trợ. Xác định chức năng của cơ chế hay phạm vi so sánh, sau đó tìm bước suy luận vượt quá cơ sở đã có.", "wrong_options": "Các phương án còn lại là nhận định phù hợp; người học dễ loại nhầm khi không phân biệt nguồn biến đổi với tác động sàng lọc hoặc quan hệ với mốc chung với quan hệ trực tiếp.", "difficulty_source": "Kiểm soát phạm vi kết luận và chiều yêu cầu của câu hỏi.", "discrimination": "medium", "typical_steps": 3, "recurrence_status": "Đã quan sát ở các đề khác nhau.", "refs": ["55c12f561006|P1|15|None", "4b4716b94db4|P1|8|None"]}, {"part_kind": "multiple_choice", "topic": "Biến đổi cấu trúc di truyền theo thao tác", "grade": 12, "construction": "Cho trạng thái ban đầu cùng thao tác biến đổi; yêu cầu xác định trạng thái sau tác động. Khoanh đúng phạm vi biến đổi, thực hiện thao tác và giữ nguyên phần không chịu tác động; với trình tự mã hóa phải lập lại cách đọc trước khi suy sản phẩm.", "wrong_options": "Biến thao tác thành cơ chế khác, thay đổi sai ranh giới, bỏ điểm dừng hoặc giữ khung đọc cũ sau biến đổi.", "difficulty_source": "Theo dõi chính xác phần được bảo toàn và phần phải tính lại. Khi phải qua phiên mã và dịch mã, chuỗi suy luận dài hơn.", "discrimination": "high", "typical_steps": 4, "recurrence_status": "Đã quan sát ở các đề khác nhau; mức phân hóa thay đổi theo độ dài chuỗi chuyển đổi.", "refs": ["55c12f561006|P1|8|None", "4b4716b94db4|P1|3|None"]}, {"part_kind": "multiple_choice", "topic": "Cấu trúc kiểu gene qua lịch sử sinh sản", "grade": 12, "construction": "Cho cấu trúc ban đầu và lịch sử sinh sản; yêu cầu tính thành phần kiểu gene ở cuối quá trình. Xác định mô hình của từng giai đoạn, cập nhật dị hợp và đồng hợp rồi chuyển trạng thái sang giai đoạn tiếp theo.", "wrong_options": "Trả về tần số của đại lượng khác, dùng trạng thái giới hạn, dừng ở giai đoạn trung gian hoặc cho rằng bảo toàn allele đồng nghĩa bảo toàn kiểu gene.", "difficulty_source": "Mức khó tăng khi hình thức sinh sản thay đổi và không thể dùng một công thức xuyên suốt.", "discrimination": "medium", "typical_steps": 3, "recurrence_status": "Quan sát riêng trong một đề; chưa có bằng chứng tái diễn giữa các đề.", "refs": ["55c12f561006|P1|2|None", "55c12f561006|P1|11|None"]}, {"part_kind": "multiple_choice", "topic": "Đối chiếu đầy đủ điều kiện sinh học", "grade": [10, 11, 12], "construction": "Cho kí hiệu, sự kiện, khoảng điều kiện hoặc danh sách đối tượng; yêu cầu chọn phương án đáp ứng toàn bộ tiêu chí. Xác định điều kiện bắt buộc rồi kiểm tra từng thành phần, không dừng khi mới thấy một dấu hiệu phù hợp.", "wrong_options": "Chỉ thỏa một phần yêu cầu, bỏ sót locus, nhầm đối tượng phân li, chỉ chịu được một phần khoảng môi trường hoặc phân loại sai nhóm chức năng.", "difficulty_source": "Duy trì điều kiện cho toàn bộ đối tượng và nhớ đúng đặc điểm phân loại.", "discrimination": "medium", "typical_steps": 3, "recurrence_status": "Quan sát riêng trong một đề; chưa có bằng chứng tái diễn giữa các đề.", "refs": ["4b4716b94db4|P1|4|None", "4b4716b94db4|P1|5|None", "4b4716b94db4|P1|6|None", "4b4716b94db4|P1|16|None"]}, {"part_kind": "multiple_choice", "topic": "Nhận diện cấu trúc gene trên hình", "grade": 12, "construction": "Cho hình các vùng của gene; yêu cầu chọn nhận định về kiểu tổ chức hoặc chức năng. Đọc dấu hiệu phân mảnh, liên hệ với xử lí RNA rồi phân biệt vùng được phiên mã với phần tham gia tạo sản phẩm.", "wrong_options": "Nhầm kiểu tổ chức gene hoặc cho rằng mọi đoạn phiên mã đều được giữ lại để dịch mã.", "difficulty_source": "Phân biệt các cấp xử lí thông tin thay vì đồng nhất toàn bộ vùng trên hình.", "discrimination": "low", "typical_steps": 3, "recurrence_status": "Quan sát riêng trong một đề; chưa có bằng chứng tái diễn giữa các đề.", "refs": ["55c12f561006|P1|9|None"]}, {"part_kind": "multiple_choice", "topic": "Chiều tác động lên kích thước quần thể", "grade": 12, "construction": "Cho các quá trình làm thay đổi số cá thể; yêu cầu chọn nhóm cùng làm tăng kích thước. Gán chiều bổ sung hoặc mất cá thể cho từng quá trình rồi kiểm tra toàn bộ nhóm.", "wrong_options": "Ghép quá trình bổ sung với quá trình làm mất cá thể hoặc đồng nhất biến động với tăng trưởng.", "difficulty_source": "Phân biệt chiều tác động của các quá trình quen thuộc.", "discrimination": "low", "typical_steps": 2, "recurrence_status": "Quan sát riêng trong một đề; chưa có bằng chứng tái diễn giữa các đề.", "refs": ["55c12f561006|P1|3|None"]}, {"part_kind": "multiple_choice", "topic": "Xác suất di truyền có điều kiện từ thông tin gia đình", "grade": 12, "construction": "Cho kiểu hình và quan hệ gia đình; yêu cầu xác suất con thỏa tổ hợp đặc điểm. Suy cơ chế di truyền, điều kiện hóa kiểu gene của người đã biết kiểu hình rồi kết hợp khả năng truyền allele với sự kiện bổ sung.", "wrong_options": "Dùng xác suất chưa điều kiện hóa, mặc định kiểu gene chưa xác định hoặc bỏ một thành phần của sự kiện đồng thời.", "difficulty_source": "Giữ bất định kiểu gene và phân biệt điều kiện đã biết với sự kiện cần tính. Cách diễn đạt sự kiện bổ sung trong hàng có điểm chưa rõ.", "discrimination": "high", "typical_steps": 4, "recurrence_status": "Quan sát riêng trong một đề; cấu trúc suy luận tương tự có ở phần trả lời ngắn nhưng chưa tái diễn trong cùng dạng lựa chọn.", "refs": ["55c12f561006|P1|16|None"]}, {"part_kind": "true_false", "topic": "Nhận diện thành phần và cơ chế từ sơ đồ", "grade": 12, "construction": "Cho sơ đồ cấu trúc hoặc quy trình có dấu hiệu trực tiếp; yêu cầu kiểm tra tên gọi hay bản chất cơ chế. Nhận diện thành phần, theo mối nối giữa chúng và đối chiếu với định nghĩa.", "wrong_options": null, "difficulty_source": "Hình hỗ trợ trực tiếp việc nhận diện; chưa cần biến đổi định lượng.", "discrimination": "low", "typical_steps": 3, "recurrence_status": "Đã quan sát ở các đề khác nhau.", "refs": ["2cbdc74db082|P2|3|c", "55c12f561006|P2|1|a", "55c12f561006|P2|2|a"]}, {"part_kind": "true_false", "topic": "Từ cơ chế biểu hiện đến đặc tính sản phẩm", "grade": 12, "construction": "Cho hệ biểu hiện hoặc quá trình tổng hợp đang diễn ra; yêu cầu kiểm tra đặc tính hay tác dụng của sản phẩm cuối. Xác định khuôn thông tin, suy sản phẩm hoàn chỉnh rồi liên hệ với chức năng hoặc phép đo.", "wrong_options": null, "difficulty_source": "Nối cơ chế phân tử với hệ quả chức năng; phải phân biệt trạng thái đang tổng hợp với sản phẩm cuối. Một số hệ quả đo lường dựa trên giả định ngầm của hàng.", "discrimination": "medium", "typical_steps": 3, "recurrence_status": "Đã quan sát ở các đề khác nhau.", "refs": ["2cbdc74db082|P2|3|d", "55c12f561006|P2|2|d"]}, {"part_kind": "true_false", "topic": "Điều kiện biểu hiện trong tương tác gene", "grade": 12, "construction": "Cho con đường chuyển hóa, chức năng allele và điều kiện biểu hiện; yêu cầu kiểm tra kiểu hình hoặc tỉ lệ dự đoán. Lập điều kiện để sản phẩm xuất hiện, xét tác động che lấp hoặc ức chế rồi mới suy kết quả phép lai.", "wrong_options": "Bỏ điều kiện môi trường, bỏ tác động ức chế hoặc coi mọi allele trội đều thúc đẩy sản phẩm cuối.", "difficulty_source": "Thứ tự suy luận phải đi từ điều kiện biểu hiện đến phân li, không áp tỉ lệ quen thuộc trước.", "discrimination": "medium", "typical_steps": 4, "recurrence_status": "Đã quan sát ở các đề khác nhau.", "refs": ["2cbdc74db082|P2|4|a", "55c12f561006|P2|1|b", "55c12f561006|P2|1|c"]}, {"part_kind": "true_false", "topic": "Gộp kiểu gene và kiểm tra khả năng tạo kiểu hình", "grade": 12, "construction": "Cho mô hình gene quy định sản phẩm; yêu cầu kiểm tra số lớp biểu hiện, tập phép lai hoặc quan hệ kiểu hình. Chuyển sơ đồ thành điều kiện kiểu gene, gộp các trạng thái cùng biểu hiện rồi đếm hoặc tính xác suất, tránh trùng trường hợp.", "wrong_options": null, "difficulty_source": "Phải xây ánh xạ kiểu gene sang kiểu hình trước khi đếm hay kiểm tra sự tồn tại của phép lai.", "discrimination": "medium", "typical_steps": 4, "recurrence_status": "Đã quan sát ở các đề khác nhau ở thao tác gộp kiểu gene; từng yêu cầu đếm hoặc tìm phép lai chưa được xác nhận tái diễn riêng.", "refs": ["2cbdc74db082|P2|4|b", "2cbdc74db082|P2|4|c", "2cbdc74db082|P2|4|d", "55c12f561006|P2|1|d"]}, {"part_kind": "true_false", "topic": "Đọc và so sánh giá trị trên đồ thị sinh học", "grade": [11, 12], "construction": "Cho các đường biểu diễn và điều kiện hoặc mốc cần xét; yêu cầu kiểm tra quan hệ so sánh. Chọn đúng trục và loại mốc, đọc giá trị tương ứng rồi so sánh độ rộng, độ chênh hoặc tung độ tại cùng điều kiện.", "wrong_options": "Đọc nhầm loại mốc, bỏ dấu tọa độ hoặc thay giá trị tại điều kiện cụ thể bằng đặc điểm tổng thể của đường cong.", "difficulty_source": "Xác định đúng đại lượng phải so sánh trước khi đọc hình.", "discrimination": "low", "typical_steps": 3, "recurrence_status": "Đã quan sát ở các đề khác nhau.", "refs": ["55c12f561006|P2|3|a", "55c12f561006|P2|3|b", "55c12f561006|P2|3|c", "4b4716b94db4|P2|1|a"]}, {"part_kind": "true_false", "topic": "Suy hướng và trình tự từ sơ đồ quá trình", "grade": [11, 12], "construction": "Cho sơ đồ có vị trí, chiều chuyển động hoặc các điểm đầu cuối; yêu cầu kiểm tra định hướng hay trình tự. Chọn mốc đúng, theo chiều vận hành rồi suy vị trí, đường đi hoặc thứ tự thời gian.", "wrong_options": "Đảo cực tính hoặc đồng nhất vị trí gần điểm khởi đầu với thời điểm tham gia sớm.", "difficulty_source": "Chuyển thông tin không gian trên ảnh tĩnh thành chiều hoạt động và tiến trình.", "discrimination": "medium", "typical_steps": 3, "recurrence_status": "Quan sát riêng trong một đề; chưa có bằng chứng tái diễn giữa các đề.", "refs": ["55c12f561006|P2|2|b", "55c12f561006|P2|2|c", "55c12f561006|P2|4|a", "55c12f561006|P2|4|b", "55c12f561006|P2|4|d"]}, {"part_kind": "true_false", "topic": "Giới hạn khái quát hóa từ đặc điểm thường gặp", "grade": [11, 12], "construction": "Cho kiến thức hoặc đồ thị trong một phạm vi xác định; yêu cầu kiểm tra kết luận khái quát. Tách tiêu chí định nghĩa khỏi đặc điểm đi kèm, xét giới hạn hoặc trường hợp làm kết luận không còn được bảo đảm.", "wrong_options": "Biến quan hệ thường gặp thành quy tắc tuyệt đối hoặc ngoại suy sang điều kiện chưa được xác định.", "difficulty_source": "Nhận ra kết luận mạnh hơn dữ kiện, thay vì chỉ nhận diện một liên hệ quen thuộc.", "discrimination": "medium", "typical_steps": 3, "recurrence_status": "Quan sát riêng trong một đề; chưa có bằng chứng tái diễn giữa các đề.", "refs": ["55c12f561006|P2|3|d", "55c12f561006|P2|4|c"]}, {"part_kind": "short_answer", "topic": "Tái lập quần thể sau chọn lọc hoặc loại kiểu gene", "grade": 12, "construction": "Cho cấu trúc di truyền hoặc dữ kiện suy được cấu trúc, kèm cơ chế loại cá thể; yêu cầu tính kết quả ở nhóm còn lại hoặc thế hệ sau. Loại đúng nhóm, chuẩn hóa mẫu số rồi áp dụng cơ chế sinh sản và quy đổi kết quả.", "wrong_options": null, "difficulty_source": "Mẫu số phải phản ánh nhóm thực sự được thống kê hoặc tham gia sinh sản. Với hàng thiếu giả thiết về quan hệ giữa các locus, không coi kết quả theo khóa là hệ quả duy nhất.", "discrimination": "medium", "typical_steps": 5, "recurrence_status": "Đã quan sát ở các đề khác nhau.", "refs": ["2cbdc74db082|P3|1|None", "55c12f561006|P3|6|None"]}, {"part_kind": "short_answer", "topic": "Đời con từ hỗn hợp nhóm bố mẹ tự phối", "grade": 12, "construction": "Cho hoặc yêu cầu suy thành phần các nhóm bố mẹ; yêu cầu tính kiểu hình đích trong đời con chung. Xác định trọng số từng kiểu gene, tính kết quả tự phối riêng rồi cộng các đóng góp; nếu bố mẹ được tuyển chọn phải điều kiện hóa trước.", "wrong_options": null, "difficulty_source": "Không thể gộp hỗn hợp thành một phép lai đại diện. Mức khó tăng khi phải suy liên kết và thành phần nhóm được chọn; hàng có khóa không khớp dữ kiện chỉ hỗ trợ mô tả thao tác.", "discrimination": "high", "typical_steps": 5, "recurrence_status": "Đã quan sát ở các đề khác nhau.", "refs": ["2cbdc74db082|P3|5|None", "55c12f561006|P3|2|None"]}, {"part_kind": "short_answer", "topic": "Đọc biểu diễn nhiễm sắc thể và đếm bản sao", "grade": 12, "construction": "Cho hình hoặc chuỗi kí hiệu nhiễm sắc thể; yêu cầu suy bộ nhiễm sắc thể hoặc đếm trường hợp thuộc dạng biến đổi. Xác định nhóm tương đồng bằng kí hiệu, đối chiếu số bản sao với trạng thái chuẩn rồi tổng hợp kết quả.", "wrong_options": null, "difficulty_source": "Dạng trực tiếp chỉ cần đếm bản sao; dạng khó phải dùng nhãn gene để nhận ra quan hệ tương đồng và không suy máy móc từ số hình đang thấy. Cách đọc bất thường ở hàng khó còn có bất định.", "discrimination": "high", "typical_steps": 4, "recurrence_status": "Quan sát riêng trong một đề; chưa có bằng chứng tái diễn giữa các đề.", "refs": ["2cbdc74db082|P3|2|None", "2cbdc74db082|P3|3|None"]}, {"part_kind": "short_answer", "topic": "Tổng hợp kết quả từ danh sách, bảng và lịch sử quá trình", "grade": 12, "construction": "Cho danh sách đặc điểm, sự kiện, bảng số liệu hoặc lịch sử biến đổi; yêu cầu trả kết quả đếm, thứ tự hay giá trị cuối. Xác định quy tắc sinh học, xử lí từng mục hoặc từng giai đoạn rồi tổng hợp đúng đại lượng đích.", "wrong_options": null, "difficulty_source": "Độ khó nằm ở chọn đúng quan hệ nhân quả, đại lượng và trạng thái cần theo dõi; có thể từ đối chiếu trực tiếp đến bảo toàn thành phần qua thay đổi điều kiện.", "discrimination": "medium", "typical_steps": 3, "recurrence_status": "Đã quan sát ở các đề khác nhau ở cấu trúc xử lí và tổng hợp; từng phép tính hoặc nội dung chuyên biệt chưa được xác nhận tái diễn riêng.", "refs": ["2cbdc74db082|P3|4|None", "2cbdc74db082|P3|6|None", "55c12f561006|P3|3|None", "55c12f561006|P3|4|None", "55c12f561006|P3|5|None"]}, {"part_kind": "short_answer", "topic": "Truyền ràng buộc kiểu gene qua phả hệ", "grade": 12, "construction": "Cho phả hệ cùng kiểu hình và quan hệ huyết thống; yêu cầu xác suất tổ hợp đặc điểm ở con. Suy kiểu gene bắt buộc, giữ phân bố có điều kiện cho các kiểu gene còn bất định, tính khả năng truyền allele rồi kết hợp sự kiện bổ sung.", "wrong_options": null, "difficulty_source": "Phải truyền ràng buộc qua các thế hệ và giữ đúng trọng số các khả năng kiểu gene.", "discrimination": "high", "typical_steps": 5, "recurrence_status": "Quan sát riêng trong một đề; cấu trúc điều kiện hóa tương tự có ở phần lựa chọn nhưng chưa tái diễn trong cùng dạng trả lời ngắn.", "refs": ["55c12f561006|P3|1|None"]}], "discrimination_moves": [{"move": "Đổi mẫu số sau khi biết điều kiện tuyển chọn", "how_to_apply": "Cho một nhóm được chọn theo kiểu hình rồi yêu cầu kết quả ở đời sau; buộc người giải tái lập thành phần kiểu gene trong nhóm ấy trước khi tính xác suất.", "refs": ["2cbdc74db082|P3|5|None", "55c12f561006|P1|16|None", "55c12f561006|P3|1|None"]}, {"move": "Giữ bất định kiểu gene đến bước tổng hợp", "how_to_apply": "Để dữ kiện chỉ xác định phân bố khả năng của bố mẹ; yêu cầu lấy kết quả có trọng số thay vì tự chọn một kiểu gene đại diện.", "refs": ["2cbdc74db082|P3|5|None", "55c12f561006|P1|16|None", "55c12f561006|P3|1|None"]}, {"move": "Ghép các tầng ràng buộc di truyền", "how_to_apply": "Yêu cầu giải quyết quan hệ tại từng locus trước, sau đó kiểm tra liên kết hoặc quan hệ huyết thống, cuối cùng mới tính sự kiện đích.", "refs": ["2cbdc74db082|P3|5|None", "55c12f561006|P3|1|None"]}, {"move": "Lập lại biểu diễn sau biến đổi", "how_to_apply": "Cho dữ kiện phải chuyển qua các dạng biểu diễn liên tiếp; sau mỗi thay đổi phải dựng lại trạng thái hợp lệ trước khi suy sản phẩm, đặc biệt khi chiều đọc hoặc khung đọc thay đổi.", "refs": ["4b4716b94db4|P1|3|None"]}, {"move": "Dùng nhãn sinh học để kiểm tra cách đếm trực quan", "how_to_apply": "Cho hình có kí hiệu nhận diện quan hệ tương đồng; yêu cầu xác định đối tượng cần đếm bằng nhãn thay vì áp phép nhân từ số hình quan sát. Cần nêu rõ giả thiết về bất thường khi viết mới.", "refs": ["2cbdc74db082|P3|2|None"]}, {"move": "Tách sự kiện đồng thời khỏi điều kiện đã biết", "how_to_apply": "Kết hợp đặc điểm di truyền với một đặc điểm bổ sung và diễn đạt rõ cả hai đều thuộc sự kiện cần tính; kiểm tra người giải có tính đủ các thành phần hay không.", "refs": ["55c12f561006|P1|16|None", "55c12f561006|P3|1|None"]}], "easy_vs_hard": [{"topic": "Biểu hiện kiểu hình", "easy": "Nhận diện tên hiện tượng từ mô tả quan hệ giữa kiểu gene và môi trường.", "hard": "Dùng điều kiện môi trường hoặc cơ chế ức chế để xác định kiểu hình trước khi tính phân li.", "easy_refs": ["55c12f561006|P1|10|None"], "hard_refs": ["2cbdc74db082|P2|4|a", "55c12f561006|P2|1|b", "55c12f561006|P2|1|c"]}, {"topic": "Hoán vị gene", "easy": "Chuyển từ thông tin giao tử hoặc bản đồ sang tần số nhóm tái tổ hợp.", "hard": "Suy pha liên kết và tần số hoán vị từ đời con, rồi tính kết quả tự phối của nhóm đã tuyển chọn.", "easy_refs": ["55c12f561006|P1|7|None", "4b4716b94db4|P1|12|None"], "hard_refs": ["2cbdc74db082|P3|5|None"]}, {"topic": "Biến đổi nhiễm sắc thể", "easy": "Đếm bản sao hoặc thực hiện thao tác thay đổi trật tự đã chỉ rõ.", "hard": "Kết hợp trạng thái phân bào và kí hiệu gene để suy quan hệ tương đồng cùng bộ nhiễm sắc thể ban đầu; cách đọc bất thường trong hàng còn cần làm rõ.", "easy_refs": ["2cbdc74db082|P3|3|None", "55c12f561006|P1|8|None"], "hard_refs": ["2cbdc74db082|P3|2|None"]}, {"topic": "Giới hạn sinh thái", "easy": "Gọi tên khái niệm hoặc đọc độ rộng và giá trị trên đường cong.", "hard": "Kiểm tra toàn bộ khoảng điều kiện hoặc nhận ra dữ liệu hiện tại không bảo đảm kết luận về môi trường tương lai.", "easy_refs": ["4b4716b94db4|P1|11|None", "55c12f561006|P2|3|a", "55c12f561006|P2|3|b", "55c12f561006|P2|3|c"], "hard_refs": ["4b4716b94db4|P1|4|None", "55c12f561006|P2|3|d"]}, {"topic": "Truyền đạt thông tin di truyền", "easy": "Nhận diện khuôn hoặc mô hình dịch mã từ dấu hiệu trực tiếp.", "hard": "Theo đúng chiều bổ sung, điểm dừng và khung đọc qua biến đổi trình tự trước khi tổng hợp các kết luận.", "easy_refs": ["4b4716b94db4|P1|17|None", "55c12f561006|P2|2|a"], "hard_refs": ["4b4716b94db4|P1|3|None"]}, {"topic": "Cấu trúc di truyền quần thể", "easy": "Áp dụng trực tiếp quy luật thay đổi dị hợp trong một chế độ sinh sản.", "hard": "Chuyển mô hình theo lịch sử sinh sản hoặc chuẩn hóa nhóm còn sinh sản sau loại cá thể.", "easy_refs": ["55c12f561006|P1|2|None"], "hard_refs": ["55c12f561006|P1|11|None", "2cbdc74db082|P3|1|None"]}], "fact_use": {"common": [{"use": "Định nghĩa là công cụ nhận diện trực tiếp và phân biệt khái niệm gần nhau.", "refs": ["55c12f561006|P1|10|None", "55c12f561006|P1|14|None", "55c12f561006|P1|18|None", "4b4716b94db4|P1|9|None", "4b4716b94db4|P1|11|None"]}, {"use": "Kiến thức ghi nhớ về nguồn, khuôn, sản phẩm và chức năng được hỏi trực tiếp hoặc làm mắt xích giải thích cơ chế.", "refs": ["55c12f561006|P1|5|None", "55c12f561006|P1|12|None", "4b4716b94db4|P1|14|None", "4b4716b94db4|P1|17|None", "4b4716b94db4|P1|18|None", "2cbdc74db082|P2|3|d"]}, {"use": "Đặc điểm phân loại cần được nhớ để xử lí danh sách đối tượng hoặc nhận diện thích nghi.", "refs": ["2cbdc74db082|P3|6|None", "4b4716b94db4|P1|16|None"]}, {"use": "Thông số cấu trúc có thể là dữ kiện để gọi tên mức tổ chức; đây mới là quan sát riêng, chưa phải cách hỏi tái diễn được xác nhận.", "refs": ["55c12f561006|P1|4|None"]}, {"use": "Giá trị định lượng trong bảng, đồ thị và phân bố di truyền chủ yếu là dữ kiện phải xử lí, không phải đáp án cần học thuộc.", "refs": ["55c12f561006|P1|1|None", "55c12f561006|P2|3|b", "55c12f561006|P3|4|None", "55c12f561006|P3|5|None", "4b4716b94db4|P1|8|None", "4b4716b94db4|P2|1|a"]}], "not_observed": [{"claim": "Không thấy yêu cầu nhớ niên đại, tiểu sử hay giai thoại về người phát hiện để xác định đáp án.", "scope": "Nhận xét vắng mặt áp dụng cho toàn bộ tập hàng; các refs kèm theo minh họa cách các nội dung tương ứng được hỏi bằng cơ chế hoặc khái niệm.", "refs": ["55c12f561006|P1|15|None", "55c12f561006|P1|18|None", "4b4716b94db4|P1|13|None"]}, {"claim": "Không thấy yêu cầu thuộc trước toàn bộ giá trị trong bảng hoặc đồ thị; các hàng dùng chúng làm dữ liệu đọc và suy luận.", "refs": ["55c12f561006|P2|3|a", "55c12f561006|P2|3|b", "55c12f561006|P2|3|c", "55c12f561006|P3|4|None", "55c12f561006|P3|5|None", "4b4716b94db4|P1|8|None", "4b4716b94db4|P2|1|a"]}]}, "anti_patterns": [{"avoid": "Biến phần trả lời ngắn thành bài luận mở hoặc yêu cầu tranh luận không có đầu ra xác định.", "basis": "Các hàng trả lời ngắn đều hướng đến kết quả đếm, thứ tự hoặc giá trị định lượng.", "refs": ["2cbdc74db082|P3|1|None", "2cbdc74db082|P3|2|None", "2cbdc74db082|P3|3|None", "2cbdc74db082|P3|4|None", "2cbdc74db082|P3|5|None", "2cbdc74db082|P3|6|None", "55c12f561006|P3|1|None", "55c12f561006|P3|2|None", "55c12f561006|P3|3|None", "55c12f561006|P3|4|None", "55c12f561006|P3|5|None", "55c12f561006|P3|6|None"]}, {"avoid": "Thay suy luận sinh học bằng câu đố về niên đại hoặc giai thoại.", "basis": "Trong tập hàng, nội dung lý thuyết được khai thác qua định nghĩa, vai trò, cơ chế và quan hệ nhân quả; không thấy nhiệm vụ tra nhớ lịch sử.", "refs": ["2cbdc74db082|P3|4|None", "55c12f561006|P1|15|None", "55c12f561006|P1|18|None", "4b4716b94db4|P1|1|None", "4b4716b94db4|P1|13|None"]}, {"avoid": "Mặc định mọi câu có hình hoặc đồ thị đều phải là câu khó.", "basis": "Các hàng có cả thao tác nhận diện trực tiếp, đọc giá trị và suy luận nhiều tầng; hình thức trình bày không tự quyết định mức phân hóa.", "refs": ["2cbdc74db082|P2|3|c", "2cbdc74db082|P3|2|None", "55c12f561006|P2|2|a", "55c12f561006|P2|3|a", "55c12f561006|P3|1|None", "4b4716b94db4|P2|1|a"]}, {"avoid": "Tạo phương án nhiễu chỉ bằng thay đổi từ ngữ ngẫu nhiên.", "basis": "Các nhiễu được giải thích trong hàng thường gắn với nhầm đối tượng, nhầm cấp độ, sai điều kiện, sai mẫu số hoặc thiếu giai đoạn. Không thấy chơi chữ thuần túy được dùng làm căn cứ đáp án.", "refs": ["55c12f561006|P1|1|None", "55c12f561006|P1|7|None", "55c12f561006|P1|11|None", "55c12f561006|P1|16|None", "4b4716b94db4|P1|5|None", "4b4716b94db4|P1|12|None"]}, {"avoid": "Đồng nhất trả lời ngắn với tính toán dài và phân hóa cao.", "basis": "Có hàng chỉ yêu cầu đối chiếu đặc điểm, đếm bản sao hoặc áp quan hệ định lượng trực tiếp; chuỗi suy luận khó chỉ xuất hiện ở những cấu trúc có thêm ràng buộc.", "refs": ["2cbdc74db082|P3|3|None", "2cbdc74db082|P3|5|None", "2cbdc74db082|P3|6|None", "55c12f561006|P3|1|None", "55c12f561006|P3|4|None", "55c12f561006|P3|5|None"]}]}, {"evidence_scope": "Hồ sơ chỉ mô tả các hàng được cung cấp, thuộc nguồn đề bên thứ ba cấp tỉnh. Trường recurrence phân biệt cấu trúc có đối chiếu liên đề với cấu trúc mới quan sát trong phạm vi một đề; quan sát đơn đề chưa xác lập tính lặp lại liên đề. Các nhận xét về điều không xuất hiện chỉ áp dụng cho tập hàng này. Mức discrimination là đánh giá theo cấu trúc suy luận, không phải kết quả đo thực nghiệm; trường hợp chứng cứ chưa chắc được ghi riêng.", "patterns": [{"part_kind": "multiple_choice", "topic": "Khái niệm và phân loại trong sinh thái học, tiến hóa", "grade": 12, "construction": "Cho dấu hiệu nhận diện hoặc tập mô tả; chọn khái niệm phù hợp hay trường hợp nằm ngoài phạm vi định nghĩa bằng cách đối chiếu tiêu chí phân loại.", "wrong_options": "Dùng các khái niệm gần nhau; đánh tráo dấu hiệu nổi bật với tiêu chí định nghĩa hoặc thu hẹp phạm vi ứng dụng.", "difficulty_source": "Giữ đúng tiêu chí phân loại thay vì dựa vào liên tưởng.", "discrimination": "low", "typical_steps": 2, "recurrence": "observed_within_one_paper", "refs": ["61a0198fbfda|P1|1|None", "61a0198fbfda|P1|6|None", "61a0198fbfda|P1|11|None", "61a0198fbfda|P1|12|None"]}, {"part_kind": "multiple_choice", "topic": "Cấu tạo và chức năng phân tử sinh học", "grade": 10, "construction": "Cho nhóm chất cùng các mô tả; tìm thuộc tính không phù hợp bằng cách kiểm tra cấu tạo, tính chất và chức năng.", "wrong_options": "Các lựa chọn còn lại là thuộc tính đúng nhưng dễ bị loại nếu nhầm tính tan, tương tác với nước hoặc phạm vi chức năng.", "difficulty_source": "Phân biệt đặc điểm của các nhóm phân tử.", "discrimination": "low", "typical_steps": 2, "recurrence": "single_paper_observation", "refs": ["61a0198fbfda|P1|2|None"]}, {"part_kind": "multiple_choice", "topic": "Cơ chế tiến hóa và biến đổi vật chất di truyền", "grade": 12, "construction": "Cho quá trình hoặc các dạng biến đổi; chọn hệ quả đúng bằng cách xác định cơ chế tác động và cấp độ đang được hỏi.", "wrong_options": "Gán chức năng tạo mới cho quá trình sàng lọc; đánh tráo biến đổi toàn tế bào với biến đổi trong cấu trúc thành phần; nhầm đổi vị trí với tăng vật chất.", "difficulty_source": "Phân biệt cơ chế và đơn vị chịu tác động.", "discrimination": "low", "typical_steps": 2, "recurrence": "observed_within_one_paper", "refs": ["61a0198fbfda|P1|3|None", "61a0198fbfda|P1|5|None"]}, {"part_kind": "multiple_choice", "topic": "Công nghệ gene và điều kiện hoạt động của cấu trúc di truyền", "grade": 12, "construction": "Cho mục tiêu can thiệp hoặc các cấu trúc tái tổ hợp; kiểm tra vị trí gene, đường truyền và điều kiện biểu hiện để chọn cấu trúc đáp ứng yêu cầu.", "wrong_options": "Chỉ xét sự hiện diện của gene, bỏ qua hướng biểu hiện hoặc đường di truyền; đưa biện pháp không liên quan hay không khả thi.", "difficulty_source": "Phải thỏa đồng thời mục tiêu và điều kiện cơ chế.", "discrimination": "medium", "typical_steps": 3, "recurrence": "observed_within_one_paper", "evidence_note": "Kết luận về hạn chế truyền gene phụ thuộc mô hình di truyền bào quan được giả định, không nên mở rộng thành bảo đảm tuyệt đối.", "refs": ["61a0198fbfda|P1|4|None", "61a0198fbfda|P1|18|None"]}, {"part_kind": "multiple_choice", "topic": "Cân bằng di truyền quần thể", "grade": 12, "construction": "Cho tần số allele và điều kiện cân bằng; chuyển sang tần số kiểu gene rồi cộng các thành phần thuộc nhóm cần tìm.", "wrong_options": "Lấy riêng thành phần đồng hợp hoặc dị hợp, hoặc chọn nhóm kiểu gene đối lập.", "difficulty_source": "Xác định đầy đủ tập kiểu gene cần cộng.", "discrimination": "low", "typical_steps": 2, "recurrence": "single_paper_observation", "refs": ["61a0198fbfda|P1|7|None"]}, {"part_kind": "multiple_choice", "topic": "Nhận diện giai đoạn phân bào", "grade": 10, "construction": "Cho ảnh tế bào; đọc trạng thái và vị trí nhiễm sắc thể rồi ghép với giai đoạn phân bào.", "wrong_options": "Dùng các giai đoạn gần nhau, khác ở trạng thái sắp xếp, phân li hoặc tái lập nhân.", "difficulty_source": "Quan sát dấu hiệu hình thái quyết định.", "discrimination": "low", "typical_steps": 2, "recurrence": "single_paper_observation", "refs": ["61a0198fbfda|P1|8|None"]}, {"part_kind": "multiple_choice", "topic": "Dạng dinh dưỡng khoáng được hấp thụ", "grade": 11, "construction": "Cho các dạng hóa học của nguyên tố dinh dưỡng; chọn dạng hấp thụ chủ yếu bằng kiến thức về dinh dưỡng khoáng.", "wrong_options": "Thay dạng hấp thụ bằng dạng tồn tại khác hoặc ghép thành phần đúng với thành phần không phù hợp.", "difficulty_source": "Nhớ đúng dạng hóa học có vai trò sinh lí được hỏi.", "discrimination": "low", "typical_steps": 2, "recurrence": "single_paper_observation", "refs": ["61a0198fbfda|P1|9|None"]}, {"part_kind": "multiple_choice", "topic": "Các cấp đóng gói vật chất di truyền", "grade": 12, "construction": "Cho sơ đồ có nhãn; xác định ranh giới đơn vị được đánh dấu rồi gọi tên toàn thể và thành phần cấu tạo.", "wrong_options": "Đổi cấp tổ chức, tráo toàn thể với thành phần hoặc gán sai bản chất phân tử.", "difficulty_source": "Đọc đúng phạm vi của nhãn trên hình.", "discrimination": "low", "typical_steps": 2, "recurrence": "single_paper_observation", "refs": ["61a0198fbfda|P1|10|None"]}, {"part_kind": "multiple_choice", "topic": "Hình thành loài và quan hệ nguồn gốc", "grade": 12, "construction": "Cho sơ đồ biến đổi phân bố qua các trạng thái; theo dõi nhánh tổ tiên và sự kiện cách li để kiểm tra nhận định về nguồn gốc, cơ chế.", "wrong_options": "Suy họ hàng từ vị trí gần nhau, gán cơ chế cho nhánh thiếu sự kiện hỗ trợ hoặc coi điều kiện cách li là tác nhân trực tiếp tạo biến đổi.", "difficulty_source": "Theo dõi lịch sử từng nhánh thay vì đọc bố cục tĩnh.", "discrimination": "medium", "typical_steps": 4, "recurrence": "single_paper_observation", "refs": ["61a0198fbfda|P1|13|None"]}, {"part_kind": "multiple_choice", "topic": "Phả hệ kết hợp chỉ thị phân tử", "grade": 12, "construction": "Cho phả hệ, kiểu hình và ảnh điện di có mẫu tham chiếu; suy kiểu gene từ vị trí, độ đậm băng rồi kiểm tra cơ chế di truyền và nguy cơ đời con.", "wrong_options": "Các kết luận được hỗ trợ trở thành nhiễu trong yêu cầu chọn sai; lỗi phân biệt nằm ở đọc băng, nối chỉ thị với kiểu hình hoặc suy mô hình chỉ từ giới.", "difficulty_source": "Phối hợp chứng cứ phân tử với quan hệ huyết thống để giảm bất định kiểu gene.", "discrimination": "high", "typical_steps": 4, "recurrence": "single_paper_observation", "refs": ["61a0198fbfda|P1|14|None"]}, {"part_kind": "multiple_choice", "topic": "Giới hạn sinh thái và tác động phối hợp", "grade": 12, "construction": "Cho các biểu đồ phản ứng ở những tổ hợp điều kiện; đọc từng chỉ tiêu rồi kiểm tra liệu cải thiện nhân tố này có bù hoàn toàn tác động của nhân tố khác.", "wrong_options": "Nhầm ngưỡng trung gian với giới hạn, đọc ngược vùng thuận lợi hoặc xét các nhân tố tách rời.", "difficulty_source": "Phân biệt cải thiện một phần với khôi phục hoàn toàn.", "discrimination": "medium", "typical_steps": 3, "recurrence": "single_paper_observation", "evidence_note": "Không chuyển trực tiếp chỉ tiêu của loài được khảo sát thành kết luận chắc chắn ở cấp hệ sinh thái.", "refs": ["61a0198fbfda|P1|15|None"]}, {"part_kind": "multiple_choice", "topic": "Kích thước, mật độ và phân bố quần thể", "grade": 12, "construction": "Cho sơ đồ vị trí cá thể trên diện tích khảo sát chung; phân biệt nhóm kí hiệu, đếm và đọc khoảng cách để xác định đặc trưng quần thể.", "wrong_options": "Suy số lượng hoặc mật độ từ độ trải rộng, diện tích cụm; gán sai quan hệ trong loài cho kiểu phân bố.", "difficulty_source": "Tách các đại lượng cùng được biểu diễn trên sơ đồ.", "discrimination": "medium", "typical_steps": 3, "recurrence": "single_paper_observation", "refs": ["61a0198fbfda|P1|16|None"]}, {"part_kind": "multiple_choice", "topic": "Theo dõi chất đánh dấu trong chuyển hóa", "grade": 11, "construction": "Cho mô tả đánh dấu và các đường tín hiệu chưa gọi tên; dùng thứ tự chuyển hóa cùng dạng tích lũy để ghép đường với vai trò hợp chất.", "wrong_options": "Hoán đổi chất nhận, sản phẩm sớm và sản phẩm tích lũy; tráo các giai đoạn liên tiếp.", "difficulty_source": "Ánh xạ dữ liệu động vào vị trí chức năng trong mạng chuyển hóa.", "discrimination": "high", "typical_steps": 4, "recurrence": "single_paper_observation", "evidence_note": "Cách giải thích tín hiệu ban đầu chưa hoàn toàn rõ; không biến đặc điểm này thành quy tắc thiết kế.", "refs": ["61a0198fbfda|P1|17|None"]}, {"part_kind": "true_false", "topic": "Các trạng thái tồn tại và vận chuyển khí", "grade": 11, "construction": "Cho tác động lên protein vận chuyển hoặc dữ liệu bão hòa; phân biệt trạng thái được đo với các trạng thái phân tử khác rồi đánh giá hệ quả.", "wrong_options": "Đồng nhất phần không gắn khí được đo với phần hoàn toàn tự do, bỏ qua trạng thái liên kết khác.", "difficulty_source": "Không lấy phần bù của đại lượng đo làm đại lượng khác khi chưa đủ điều kiện.", "discrimination": "medium", "typical_steps": 3, "recurrence": "observed_within_one_paper", "evidence_note": "Suy luận về phần khí hòa tan cần giữ nguyên các điều kiện vật lí quyết định độ hòa tan.", "refs": ["4b4716b94db4|P2|1|b", "4b4716b94db4|P2|1|d"]}, {"part_kind": "true_false", "topic": "Cơ chế trao đổi và vận chuyển khí", "grade": 11, "construction": "Cho mô tả hoặc sơ đồ cơ quan trao đổi khí; xác định chiều dòng, ái lực hay chênh lệch khí rồi kiểm tra hệ quả sinh lí và cách giải thích ứng dụng.", "wrong_options": "Đảo chiều biến đổi khí, nhầm vị trí trao đổi hoặc gán mục tiêu đạt cân bằng cho cơ chế cần duy trì chênh lệch.", "difficulty_source": "Chuyển từ dấu hiệu cấu trúc sang chiều tác động; mức khó tăng khi phải bác bỏ lời giải thích có thuật ngữ quen thuộc.", "discrimination": "medium", "typical_steps": 3, "recurrence": "cross_paper", "refs": ["4b4716b94db4|P2|1|c", "61a0198fbfda|P2|3|a", "61a0198fbfda|P2|3|b", "61a0198fbfda|P2|3|c", "61a0198fbfda|P2|3|d"]}, {"part_kind": "true_false", "topic": "Suy ngược phép lai từ cấu trúc đời con", "grade": 12, "construction": "Cho điều kiện về lớp kiểu gene hoặc tỉ lệ kiểu hình; suy yêu cầu tại từng locus rồi kiểm tra khả năng bố mẹ thỏa đồng thời các ràng buộc.", "wrong_options": "Nhận tỉ lệ quen thuộc hoặc số lớp phù hợp nhưng bỏ qua việc gộp kiểu gene thành kiểu hình và tính nhất quán giữa các locus.", "difficulty_source": "Kiểm tra đồng thời điều kiện thành phần và cấu trúc chung.", "discrimination": "high", "typical_steps": 3, "recurrence": "observed_within_one_paper", "refs": ["4b4716b94db4|P2|2|a", "4b4716b94db4|P2|2|b"]}, {"part_kind": "true_false", "topic": "Liên kết gene và giới hạn cấu trúc đời con", "grade": 12, "construction": "Cho giới hạn lớp đời con; dựng các phép lai và tổ hợp haplotype khả thi, phân biệt pha liên kết rồi kiểm tra khẳng định bắt buộc hoặc khả năng đạt cực trị.", "wrong_options": "Suy cận tỉ lệ chỉ từ số nhóm kiểu hình; bỏ qua cách phân bố giao tử hoặc pha liên kết.", "difficulty_source": "Phải xét không gian trường hợp phù hợp thay vì dùng phép lai đại diện duy nhất.", "discrimination": "high", "typical_steps": 4, "recurrence": "observed_within_one_paper", "evidence_note": "Cách đếm kiểu gene phụ thuộc quy ước có phân biệt pha liên kết.", "refs": ["4b4716b94db4|P2|2|c", "4b4716b94db4|P2|2|d"]}, {"part_kind": "true_false", "topic": "Phạm vi suy luận từ đồ thị sinh thái", "grade": 12, "construction": "Cho dữ liệu mô tả hoặc đường tham chiếu; xác định đối tượng và đại lượng thực sự được biểu diễn rồi kiểm tra kết luận có vượt phạm vi chứng cứ hay không.", "wrong_options": "Chuyển giá trị tham chiếu giữa các đối tượng hoặc suy vai trò chi phối từ mức xuất hiện.", "difficulty_source": "Phân biệt điều nhìn thấy với thuộc tính cần chứng cứ bổ sung.", "discrimination": "medium", "typical_steps": 3, "recurrence": "cross_paper", "refs": ["4b4716b94db4|P2|3|a", "61a0198fbfda|P2|4|b"]}, {"part_kind": "true_false", "topic": "Tốc độ, cực trị và trạng thái ổn định sinh thái", "grade": 12, "construction": "Cho đường biến thiên có mốc hoặc giai đoạn cuối; đọc độ dốc, cực trị và xu hướng từng đường rồi kiểm tra cách diễn giải trạng thái của hệ.", "wrong_options": "Nhầm giá trị với tốc độ, điểm uốn với lúc giới hạn bắt đầu tác động, xu hướng giảm với tỉ lệ nghịch hoặc hết quan sát với hết biến động.", "difficulty_source": "Phân biệt hình dạng đường, đại lượng dẫn xuất và ý nghĩa cơ chế.", "discrimination": "high", "typical_steps": 4, "recurrence": "cross_paper", "refs": ["4b4716b94db4|P2|3|d", "61a0198fbfda|P2|4|d"]}, {"part_kind": "true_false", "topic": "Nhận dạng diễn biến sinh thái trên đồ thị", "grade": 12, "construction": "Cho đường biến thiên theo thời gian; dùng dạng đường hoặc trình tự xuất hiện để nhận diện mô hình và vai trò tương ứng.", "wrong_options": null, "difficulty_source": "Dấu hiệu trực tiếp nằm ở hình dạng hoặc thứ tự trên đồ thị.", "discrimination": "low", "typical_steps": 2, "recurrence": "cross_paper", "refs": ["4b4716b94db4|P2|3|b", "61a0198fbfda|P2|4|a"]}, {"part_kind": "true_false", "topic": "Điều chỉnh quần thể qua nguồn sống", "grade": 12, "construction": "Cho biện pháp làm thay đổi nơi sống; xác định nguồn lực giới hạn, suy thay đổi sức chứa rồi đánh giá chiều tác động lên quần thể.", "wrong_options": null, "difficulty_source": "Nối can thiệp thực tiễn với cơ chế điều hòa quần thể.", "discrimination": "medium", "typical_steps": 3, "recurrence": "single_paper_observation", "evidence_note": "Chỉ suy chiều tác động dự kiến; dữ liệu không trực tiếp xác định hiệu quả thực địa.", "refs": ["4b4716b94db4|P2|3|c"]}, {"part_kind": "true_false", "topic": "Bảo toàn thành phần phân tử", "grade": 10, "construction": "Cho bảng tổng và các thành phần đã biết; chọn đúng hàng, tính phần thiếu rồi đối chiếu giá trị được đề xuất.", "wrong_options": "Đưa giá trị gần kết quả đúng nhưng không bảo toàn tổng.", "difficulty_source": "Đọc đúng dữ liệu và kiểm tra phép cộng trừ thành phần.", "discrimination": "low", "typical_steps": 3, "recurrence": "single_paper_observation", "refs": ["4b4716b94db4|P2|4|a"]}, {"part_kind": "true_false", "topic": "Nhận diện phân tử từ thành phần và suy chức năng, vị trí", "grade": 10, "construction": "Cho loại đơn phân hoặc thành phần base; nhận diện nhóm phân tử rồi đối chiếu chức năng hay vị trí có thể tồn tại trong tế bào.", "wrong_options": "Gán chức năng di truyền cho đại phân tử không phù hợp với bản chất đơn phân.", "difficulty_source": "Nối dấu hiệu hóa học với thuộc tính ở cấp tế bào.", "discrimination": "medium", "typical_steps": 3, "recurrence": "observed_within_one_paper", "refs": ["4b4716b94db4|P2|4|b", "4b4716b94db4|P2|4|c"]}, {"part_kind": "true_false", "topic": "Điều kiện của chiều truyền thông tin di truyền", "grade": 12, "construction": "Cho các loại nucleic acid trong bối cảnh tế bào; xác định chiều tổng hợp được đề xuất rồi kiểm tra cơ chế và điều kiện enzyme cần có.", "wrong_options": "Chuyển khả năng của cơ chế đặc biệt sang bối cảnh chưa cung cấp điều kiện tương ứng.", "difficulty_source": "Phân biệt cơ chế thông thường với khả năng cần giả định bổ sung.", "discrimination": "medium", "typical_steps": 3, "recurrence": "single_paper_observation", "evidence_note": "Mức phân hóa chỉ là ước lượng cấu trúc; câu chữ chưa loại trừ rõ cơ chế đặc biệt nên không quy chắc lựa chọn sai cho ngộ nhận.", "refs": ["4b4716b94db4|P2|4|d"]}, {"part_kind": "true_false", "topic": "Vị trí gene và quy luật di truyền", "grade": 12, "construction": "Cho vị trí gene; đối chiếu trực tiếp với định nghĩa quy luật di truyền được nêu.", "wrong_options": "Suy quy luật từ giới của người biểu hiện thay vì vị trí gene.", "difficulty_source": "Ưu tiên thông tin quyết định đã được cung cấp.", "discrimination": "low", "typical_steps": 2, "recurrence": "single_paper_observation", "refs": ["61a0198fbfda|P2|1|a"]}, {"part_kind": "true_false", "topic": "Sàng lọc và tư vấn di truyền", "grade": 12, "construction": "Cho quan hệ giữa kiểu gene và biểu hiện; nhận ra trạng thái mang allele không biểu hiện rồi đánh giá ý nghĩa dự phòng sinh sản.", "wrong_options": null, "difficulty_source": "Phân biệt kiểu hình bình thường với không mang allele liên quan.", "discrimination": "low", "typical_steps": 2, "recurrence": "single_paper_observation", "evidence_note": "Ý nghĩa dự phòng được hỗ trợ; thứ hạng hiệu quả giữa các biện pháp chưa có dữ liệu so sánh.", "refs": ["61a0198fbfda|P2|1|c"]}, {"part_kind": "true_false", "topic": "Suy ngược biến đổi nucleotide và sản phẩm phiên mã", "grade": 12, "construction": "Cho hướng thay thế và sản phẩm sau biến đổi; dùng bổ sung để khôi phục trình tự liên quan rồi kiểm tra vị trí biến đổi hoặc cộng nguyên liệu theo sản phẩm từng allele.", "wrong_options": "Ghép kết luận đúng với vị trí sai; nhầm chỉ số bộ ba với vị trí nucleotide.", "difficulty_source": "Tách trình tự, vị trí và đóng góp của từng allele trước khi kết luận.", "discrimination": "medium", "typical_steps": 4, "recurrence": "observed_within_one_paper", "refs": ["61a0198fbfda|P2|1|b", "61a0198fbfda|P2|1|d"]}, {"part_kind": "true_false", "topic": "Tương tác gene qua con đường chuyển hóa", "grade": 12, "construction": "Cho sơ đồ enzyme và điều kiện kiểu hình; theo dõi khả năng tạo sản phẩm cuối rồi kiểm tra hệ quả của gián đoạn chuyển hóa.", "wrong_options": null, "difficulty_source": "Đọc quan hệ gene, enzyme và sản phẩm đã được mô hình hóa.", "discrimination": "low", "typical_steps": 2, "recurrence": "single_paper_observation", "refs": ["61a0198fbfda|P2|2|a"]}, {"part_kind": "true_false", "topic": "Chỉ tiêu mô tả quần xã", "grade": 12, "construction": "Cho biến đo trong khảo sát; đối chiếu ý nghĩa phép đo với định nghĩa đặc trưng quần xã được gọi tên.", "wrong_options": "Thay số loại loài bằng mức chiếm không gian của từng loài.", "difficulty_source": "Phân biệt tên chỉ tiêu với đại lượng thực sự được đo.", "discrimination": "low", "typical_steps": 2, "recurrence": "single_paper_observation", "refs": ["61a0198fbfda|P2|4|c"]}, {"part_kind": "short_answer", "topic": "Đặc điểm thừa hưởng trên cây phát sinh", "grade": 12, "construction": "Cho cây có đặc điểm gắn trên nhánh; lần đường tổ tiên của đối tượng đích, thu các đặc điểm nằm trên đường rồi sắp mã theo quy cách.", "wrong_options": null, "difficulty_source": "Theo quan hệ tổ tiên thay vì lấy đặc điểm ở nhánh gần về vị trí.", "discrimination": "medium", "typical_steps": 4, "recurrence": "single_paper_observation", "refs": ["4b4716b94db4|P3|1|None"]}, {"part_kind": "short_answer", "topic": "Diễn giải tương quan bậc dinh dưỡng từ tháp sinh khối", "grade": 12, "construction": "Cho các dạng tháp; so sánh tương quan giữa các bậc rồi sắp thứ tự theo tiêu chí mà đề quy ước.", "wrong_options": null, "difficulty_source": "Đọc tương quan thành phần thay vì kích thước toàn hình.", "discrimination": "medium", "typical_steps": 4, "recurrence": "single_paper_observation", "evidence_note": "Mức phân hóa là ước lượng thao tác đọc hình. Sinh khối tức thời chưa đủ xác định ổn định thực tế; không khái quát thứ tự trong khóa thành quy luật sinh thái.", "refs": ["4b4716b94db4|P3|2|None"]}, {"part_kind": "short_answer", "topic": "Suy luận quan hệ quần xã từ thí nghiệm loại bỏ", "grade": 12, "construction": "Cho quan hệ dinh dưỡng và biến động giữa các điều kiện can thiệp; ghép đúng đối tượng, so sánh phản ứng rồi chọn các nhận định được hỗ trợ về tác động trực tiếp, gián tiếp và vai trò loài.", "wrong_options": "Quy biến động cho nguyên nhân chưa cô lập, đảo đối tượng chịu tác động hoặc đồng nhất ổn định với tổng quy mô cực đại.", "difficulty_source": "Tách tác động qua mạng quan hệ khỏi xu hướng riêng lẻ; đọc riêng chú giải và thang biểu diễn.", "discrimination": "high", "typical_steps": 5, "recurrence": "cross_paper", "refs": ["4b4716b94db4|P3|3|None", "61a0198fbfda|P3|2|None"]}, {"part_kind": "short_answer", "topic": "Tần số kiểu gene đồng hợp trong quần thể cân bằng", "grade": 12, "construction": "Cho tần số allele và quan hệ giữa các allele còn lại; hoàn thiện phân bố allele, tính đóng góp đồng hợp rồi cộng và đổi đơn vị.", "wrong_options": null, "difficulty_source": "Hoàn thiện dữ kiện trước khi áp dụng mô hình cân bằng.", "discrimination": "medium", "typical_steps": 4, "recurrence": "single_paper_observation", "refs": ["4b4716b94db4|P3|4|None"]}, {"part_kind": "short_answer", "topic": "Đếm thành phần khởi đầu trong tái bản", "grade": 12, "construction": "Cho cấu trúc các đơn vị tái bản và đoạn tổng hợp gián đoạn; gắn mỗi phần cần khởi đầu với mồi rồi cộng trên toàn phân tử.", "wrong_options": null, "difficulty_source": "Không bỏ sót phần khởi đầu của mạch tổng hợp liên tục.", "discrimination": "medium", "typical_steps": 3, "recurrence": "single_paper_observation", "refs": ["4b4716b94db4|P3|5|None"]}, {"part_kind": "short_answer", "topic": "Xác suất phả hệ kết hợp quần thể xuất thân", "grade": 12, "construction": "Cho phả hệ, quy tắc biểu hiện phụ thuộc giới và dữ liệu quần thể của người phối ngẫu; suy phân bố kiểu gene có điều kiện rồi kết hợp xác suất đời con.", "wrong_options": null, "difficulty_source": "Giữ trọng số các kiểu gene chưa xác định và điều kiện hóa theo thông tin đã biết.", "discrimination": "high", "typical_steps": 5, "recurrence": "single_paper_observation", "evidence_note": "Kết quả phụ thuộc giả định về cơ cấu giới và phân bố allele giữa các giới.", "refs": ["4b4716b94db4|P3|6|None"]}, {"part_kind": "short_answer", "topic": "Tần số allele từ ảnh điện di", "grade": 12, "construction": "Cho các băng của từng cá thể; chuyển mẫu băng thành kiểu gene, đếm bản sao allele rồi chuẩn hóa theo tổng bản sao locus.", "wrong_options": null, "difficulty_source": "Phân biệt số loại băng quan sát được với số bản sao allele ở cá thể đồng hợp.", "discrimination": "medium", "typical_steps": 4, "recurrence": "single_paper_observation", "refs": ["61a0198fbfda|P3|1|None"]}, {"part_kind": "short_answer", "topic": "Ổ sinh thái và biến động nguồn sống", "grade": 12, "construction": "Cho bảng quan hệ giữa đặc điểm khai thác và tài nguyên; xác định tài nguyên bị giảm rồi ghép với nhóm phụ thuộc trực tiếp.", "wrong_options": null, "difficulty_source": "Dùng đúng quan hệ đã cho trong bảng.", "discrimination": "low", "typical_steps": 2, "recurrence": "single_paper_observation", "refs": ["61a0198fbfda|P3|3|None"]}, {"part_kind": "short_answer", "topic": "Liên kết gene kết hợp môi trường và chọn nhóm bố mẹ", "grade": 12, "construction": "Cho bảng biểu hiện theo môi trường và kết quả sinh sản; suy ràng buộc di truyền, xét pha liên kết, điều kiện hóa nhóm bố mẹ rồi tối ưu tỉ lệ đời sau trong môi trường mới.", "wrong_options": null, "difficulty_source": "Duy trì đồng thời điều kiện chọn bố mẹ, phân bố giao tử và ánh xạ kiểu gene sang kiểu hình.", "discrimination": "high", "typical_steps": 6, "recurrence": "single_paper_observation", "refs": ["61a0198fbfda|P3|4|None"]}, {"part_kind": "short_answer", "topic": "Phân biệt nguyên nhân làm thay đổi tần số allele", "grade": 12, "construction": "Cho diễn biến tần số và biến cố quần thể; kiểm tra từng cơ chế có giải thích được thay đổi hay không, đồng thời nhận diện thông tin còn thiếu.", "wrong_options": "Nhầm thay đổi tần số với phát sinh allele hoặc coi giao phối ngẫu nhiên tự làm đổi tần số allele; việc loại các cơ chế khác chưa được chứng minh đầy đủ.", "difficulty_source": "Phân biệt cơ chế trong bối cảnh chưa rõ tính ngẫu nhiên của sống sót và nguồn tái lập quần thể.", "discrimination": "medium", "typical_steps": 4, "recurrence": "single_paper_observation", "evidence_note": "Mức phân hóa là ước lượng thao tác phân tích; dữ kiện chưa đủ xác lập duy nhất nguyên nhân theo khóa.", "refs": ["61a0198fbfda|P3|5|None"]}, {"part_kind": "short_answer", "topic": "Vị trí và thời điểm truyền thông tin di truyền", "grade": 12, "construction": "Cho sơ đồ các quá trình biểu hiện đang diễn ra và vị trí can thiệp; xác định mạch, tổ chức tế bào và phần thông tin đã truyền để phân biệt tác động hiện tại với tác động về sau.", "wrong_options": "Áp dụng mô hình tổ chức tế bào không phù hợp hoặc cho rằng thay đổi khuôn lập tức sửa sản phẩm đã hình thành.", "difficulty_source": "Theo dõi đồng thời vị trí, chiều và thời điểm truyền thông tin.", "discrimination": "high", "typical_steps": 6, "recurrence": "single_paper_observation", "refs": ["61a0198fbfda|P3|6|None"]}], "discrimination_moves": [{"move": "Buộc phối hợp các nguồn chứng cứ khác bản chất", "how_to_apply": "Phân bố thông tin quyết định giữa dữ liệu phân tử, quan hệ huyết thống hoặc điều kiện quần thể; kết luận chỉ xác định được sau khi nối chúng.", "refs": ["61a0198fbfda|P1|14|None", "4b4716b94db4|P3|6|None"]}, {"move": "Kiểm tra tính khả thi đồng thời của các ràng buộc", "how_to_apply": "Cho điều kiện về cấu trúc đời con và biểu hiện; yêu cầu kiểm tra cùng phép lai có thỏa mọi điều kiện sau khi gộp kiểu hình hay không.", "refs": ["4b4716b94db4|P2|2|a", "4b4716b94db4|P2|2|d", "61a0198fbfda|P3|4|None"]}, {"move": "Dùng phản ví dụ hoặc xét trường hợp để kiểm tra khẳng định mạnh", "how_to_apply": "Đặt nhận định bắt buộc hoặc yêu cầu cực trị; buộc người làm xét các cấu hình còn phù hợp thay vì suy từ trường hợp quen thuộc.", "refs": ["4b4716b94db4|P2|2|c", "4b4716b94db4|P2|2|d", "61a0198fbfda|P3|4|None"]}, {"move": "Giữ phân bố có điều kiện qua các giai đoạn", "how_to_apply": "Cho thông tin chọn lọc đối tượng hoặc kiểu hình đã biết; yêu cầu cập nhật trọng số kiểu gene trước khi tính bước sinh sản tiếp theo.", "refs": ["4b4716b94db4|P3|6|None", "61a0198fbfda|P3|4|None"]}, {"move": "Tách tác động trực tiếp khỏi tác động qua quan hệ trung gian", "how_to_apply": "Cho đối chứng hoặc can thiệp trong mạng tương tác; yêu cầu so sánh đúng đối tượng giữa các điều kiện rồi truy đường ảnh hưởng.", "refs": ["4b4716b94db4|P3|3|None"]}, {"move": "Phân biệt giá trị trạng thái với tốc độ và cơ chế", "how_to_apply": "Đánh dấu vị trí trên đường cong; yêu cầu giải thích độ dốc và giới hạn cơ chế, tránh để việc nhận tên dạng đường đủ giải quyết.", "refs": ["4b4716b94db4|P2|3|d"]}, {"move": "Ánh xạ diễn biến tín hiệu sang vai trò trong quá trình", "how_to_apply": "Ẩn tên thành phần nhưng cung cấp diễn biến tương đối; yêu cầu dùng thứ tự chuyển hóa và chức năng để ghép toàn bộ hệ.", "refs": ["61a0198fbfda|P1|17|None"]}, {"move": "Buộc theo dõi thông tin đã truyền trước thời điểm can thiệp", "how_to_apply": "Đặt can thiệp lên khuôn trong khi sản phẩm trung gian đang được sử dụng; yêu cầu phân biệt sản phẩm hiện tại với các lượt hình thành sau.", "refs": ["61a0198fbfda|P3|6|None"]}], "easy_vs_hard": [{"topic": "Di truyền học quần thể", "easy": "Cho sẵn tần số allele và trạng thái cân bằng; tính các thành phần kiểu gene cần cộng.", "hard": "Phải suy tần số từ biểu hiện, kết hợp phả hệ và điều kiện hóa kiểu gene của đối tượng trước khi tính nguy cơ đời con.", "easy_refs": ["61a0198fbfda|P1|7|None"], "hard_refs": ["4b4716b94db4|P3|6|None"]}, {"topic": "Tăng trưởng quần thể", "easy": "Nhận dạng mô hình từ hình dáng đường cong.", "hard": "Phân biệt kích thước, tốc độ tăng và tác động giới hạn khi diễn giải mốc trên đường cong.", "easy_refs": ["4b4716b94db4|P2|3|b"], "hard_refs": ["4b4716b94db4|P2|3|d"]}, {"topic": "Vai trò loài trong quần xã", "easy": "Ghép dấu hiệu mô tả với định nghĩa vai trò hoặc vị trí sinh thái.", "hard": "Dùng phản ứng sau can thiệp để phân biệt ảnh hưởng trực tiếp, gián tiếp và giới hạn của kết luận nhân quả.", "easy_refs": ["61a0198fbfda|P1|1|None", "61a0198fbfda|P3|3|None"], "hard_refs": ["4b4716b94db4|P3|3|None", "61a0198fbfda|P3|2|None"]}, {"topic": "Di truyền học người", "easy": "Dựa vào vị trí gene được cung cấp để nhận diện quy luật di truyền.", "hard": "Phối hợp kiểu hình, đường truyền trong gia đình và chỉ thị phân tử để xác định kiểu gene rồi kiểm tra nguy cơ.", "easy_refs": ["61a0198fbfda|P2|1|a"], "hard_refs": ["61a0198fbfda|P1|14|None"]}, {"topic": "Thông tin di truyền và sản phẩm biểu hiện", "easy": "Nhận diện phân tử hoặc đọc quan hệ enzyme với sản phẩm được nêu trực tiếp.", "hard": "Theo dõi chiều và thời điểm truyền thông tin để quyết định can thiệp còn tác động được lên sản phẩm nào.", "easy_refs": ["4b4716b94db4|P2|4|b", "61a0198fbfda|P2|2|a"], "hard_refs": ["61a0198fbfda|P3|6|None"]}], "fact_use": {"common": [{"use": "Định nghĩa làm tiêu chí phân loại; nhiễu được tạo từ khái niệm gần nhau thay vì thông tin ngoài nội dung sinh học.", "refs": ["61a0198fbfda|P1|1|None", "61a0198fbfda|P1|6|None", "61a0198fbfda|P1|12|None", "61a0198fbfda|P2|4|c"]}, {"use": "Kiến thức về cấu tạo, dạng hóa học và cơ chế là mắt xích để giải thích dữ liệu hoặc chọn hệ quả.", "refs": ["61a0198fbfda|P1|2|None", "61a0198fbfda|P1|9|None", "4b4716b94db4|P2|1|c", "61a0198fbfda|P2|3|b"]}, {"use": "Dữ liệu định lượng được cung cấp để bảo toàn tổng, suy tần số, đếm thành phần hoặc tính xác suất; kiến thức nhớ được quyết định cách xử lí dữ liệu.", "refs": ["4b4716b94db4|P2|4|a", "4b4716b94db4|P3|4|None", "4b4716b94db4|P3|5|None", "61a0198fbfda|P3|1|None", "4b4716b94db4|P3|6|None"]}, {"use": "Tên thành phần có thể là đích nhận diện trên sơ đồ, nhưng phải đọc ranh giới cấu trúc hoặc diễn biến tín hiệu để xác định.", "refs": ["61a0198fbfda|P1|10|None", "61a0198fbfda|P1|17|None"]}], "not_observed": [{"observation": "Không thấy yêu cầu nhớ mốc lịch sử, người phát hiện hoặc xuất xứ thuật ngữ làm đích trả lời; các hàng tiến hóa dùng định nghĩa, cơ chế và quan hệ nguồn gốc.", "refs": ["61a0198fbfda|P1|3|None", "61a0198fbfda|P1|6|None", "61a0198fbfda|P1|13|None", "4b4716b94db4|P3|1|None", "61a0198fbfda|P3|5|None"]}, {"observation": "Không thấy bài định lượng lấy việc nhớ giá trị thực nghiệm ngoài dữ kiện làm nút thắt; giá trị cần xử lí xuất phát từ bảng, hình, mô tả hoặc được suy theo mô hình đã học.", "refs": ["4b4716b94db4|P2|4|a", "4b4716b94db4|P3|4|None", "4b4716b94db4|P3|5|None", "61a0198fbfda|P3|1|None", "61a0198fbfda|P3|4|None"]}]}, "anti_patterns": [{"avoid": "Gọi quan sát đơn đề là cấu trúc lặp lại liên đề.", "basis": "Các cấu trúc chuyên biệt chưa có đối chứng ở đề khác phải giữ trạng thái quan sát cục bộ.", "refs": ["61a0198fbfda|P1|17|None", "61a0198fbfda|P3|4|None", "61a0198fbfda|P3|6|None"]}, {"avoid": "Viết phần dẫn dài nhưng hình, bảng hoặc điều kiện không tham gia lời giải cho dạng suy luận dữ liệu.", "basis": "Các hàng suy luận dùng thông tin biểu diễn để xác định đường tổ tiên, phản ứng giữa nghiệm thức hoặc cấu trúc di truyền.", "refs": ["4b4716b94db4|P3|1|None", "4b4716b94db4|P3|3|None", "61a0198fbfda|P3|4|None"]}, {"avoid": "Tạo nhiễu ngẫu nhiên, khác hẳn cơ chế hoặc không gắn với thao tác sai có thể nhận diện.", "basis": "Những nhiễu phân tích được thường đánh tráo khái niệm, cấp độ, chiều tác động, thành phần cần cộng hoặc điều kiện biểu hiện.", "refs": ["61a0198fbfda|P1|5|None", "61a0198fbfda|P1|7|None", "61a0198fbfda|P1|10|None", "61a0198fbfda|P1|18|None", "61a0198fbfda|P2|3|d"]}, {"avoid": "Biến câu phân hóa thành tính toán dài thuần túy với mô hình đã xác định sẵn.", "basis": "Độ khó của các hàng phân hóa nằm ở chọn mô hình, phối hợp chứng cứ, xét trường hợp và giữ điều kiện qua các bước.", "refs": ["4b4716b94db4|P2|2|c", "61a0198fbfda|P1|14|None", "4b4716b94db4|P3|6|None", "61a0198fbfda|P3|4|None"]}, {"avoid": "Mặc định vị trí gần trên hình, độ cao đường hoặc số loại băng chính là đại lượng sinh học cần hỏi.", "basis": "Các hàng yêu cầu chuyển biểu diễn sang quan hệ tổ tiên, số bản sao hoặc đặc trưng quần thể trước khi kết luận.", "refs": ["4b4716b94db4|P3|1|None", "61a0198fbfda|P1|13|None", "61a0198fbfda|P1|16|None", "61a0198fbfda|P3|1|None"]}, {"avoid": "Chấp nhận nhận định ghép chỉ vì vế có thuật ngữ quen thuộc là đúng.", "basis": "Các hàng buộc kiểm tra riêng vị trí biến đổi, mục tiêu sinh lí hoặc điều kiện biểu hiện bên cạnh phần kiến thức đúng.", "refs": ["61a0198fbfda|P2|1|b", "61a0198fbfda|P2|3|d", "61a0198fbfda|P1|18|None"]}]}]
