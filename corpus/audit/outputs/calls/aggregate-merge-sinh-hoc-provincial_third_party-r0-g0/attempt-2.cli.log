đếm liên hệ hoặc đảo dấu hệ quả khi loại tác nhân. Không quy chắc lỗi cho nhận định vượt thông tin của sơ đồ.", "difficulty_source": "Theo dõi nhiều đường tác động có dấu và cường độ khác nhau.", "discrimination": "medium", "typical_steps": 4, "evidence_status": "quan_sat_rieng_chua_xac_lap_lap_lai", "refs": ["8bbf9eea6d33|P1|14|None"]}, {"part_kind": "true_false", "topic": "Dấu chuẩn và chọn lọc tế bào nhận vector", "grade": 12, "construction": "Cho quy trình chuyển gene và điều kiện chọn lọc; yêu cầu đánh giá vai trò dấu chuẩn hoặc ý nghĩa sống sót. Người làm nối gene với tính trạng chọn lọc rồi giới hạn kết luận theo mô hình được cung cấp.", "wrong_options": "Các nhận định được khóa xác nhận đúng; nguy cơ suy luận là xem bằng chứng mang vector thành bằng chứng tuyệt đối về đoạn chèn.", "difficulty_source": "Phân biệt mục tiêu chọn lọc với mức đặc hiệu mà quy trình thực sự chứng minh.", "discrimination": "medium", "typical_steps": 3, "evidence_status": "quan_sat_rieng_chua_xac_lap_lap_lai", "refs": ["8bbf9eea6d33|P2|1|a", "8bbf9eea6d33|P2|1|b"]}, {"part_kind": "true_false", "topic": "Áp lực, dòng vận chuyển và hoạt động van", "grade": 11, "construction": "Cho hình cấu trúc kèm trạng thái áp lực; yêu cầu đánh giá trạng thái hoạt động hoặc khả năng giải thích bất thường. Người làm xác định bộ phận, liên hệ áp lực với dòng vận chuyển rồi suy hệ quả chức năng.", "wrong_options": "Kéo trạng thái của pha trước sang pha sau hoặc xem một dấu hiệu chức năng như chẩn đoán duy nhất.", "difficulty_source": "Gắn đúng trạng thái cơ học với thời điểm và cấu trúc.", "discrimination": "medium", "typical_steps": 3, "evidence_status": "quan_sat_rieng_chua_xac_lap_lap_lai", "refs": ["8bbf9eea6d33|P2|3|a", "8bbf9eea6d33|P2|3|c"]}, {"part_kind": "true_false", "topic": "Dữ liệu phân tử và biểu hiện kiểu hình", "grade": 12, "construction": "Cho các lớp bằng chứng phân tử và kiểu hình; yêu cầu đánh giá quan hệ giữa allele với sản phẩm hoặc biểu hiện. Người làm nhận diện trạng thái allele rồi đối chiếu bằng chứng ở cấp sản phẩm hay cơ thể.", "wrong_options": "Suy tuyến tính từ thay đổi DNA sang độ dài sản phẩm hoặc đồng nhất mang allele với biểu hiện tính trạng.", "difficulty_source": "Chuyển giữa các cấp bằng chứng mà không bỏ qua cơ chế trung gian.", "discrimination": "medium", "typical_steps": 4, "evidence_status": "quan_sat_rieng_chua_xac_lap_lap_lai", "refs": ["8bbf9eea6d33|P2|4|a", "8bbf9eea6d33|P2|4|c"]}, {"part_kind": "short_answer", "topic": "Cân bằng di truyền và tần số dị hợp", "grade": 12, "construction": "Cho tỉ lệ kiểu hình và điều kiện cân bằng; yêu cầu chọn quần thể theo đặc trưng kiểu gene. Người làm chuyển kiểu hình thành tần số allele rồi suy đại lượng cần so sánh.", "wrong_options": null, "difficulty_source": "Đại lượng cần tìm không biến thiên đơn điệu theo dữ liệu ban đầu.", "discrimination": "medium", "typical_steps": 4, "evidence_status": "quan_sat_rieng_chua_xac_lap_lap_lai", "refs": ["8bbf9eea6d33|P3|1|None"]}, {"part_kind": "short_answer", "topic": "Tổ hợp phân li kiểu hình", "grade": 12, "construction": "Cho danh sách phép lai và mẫu phân li đích; yêu cầu mã hóa các lựa chọn phù hợp. Người làm tách theo locus, suy phân li thành phần rồi tổ hợp và đối chiếu mẫu đích.", "wrong_options": "Các lựa chọn lệch mẫu tổ hợp hoặc có locus không phân li kiểu hình.", "difficulty_source": "Phân rã mẫu tổng thể và kiểm tra điều kiện áp dụng mô hình tổ hợp.", "discrimination": "medium", "typical_steps": 4, "evidence_status": "quan_sat_rieng_chua_xac_lap_lap_lai", "refs": ["8bbf9eea6d33|P3|2|None"]}, {"part_kind": "short_answer", "topic": "Biến đổi hàm lượng DNA trong chu kì tế bào", "grade": 10, "construction": "Cho các đồ thị ứng viên; yêu cầu chọn đồ thị đúng. Người làm ánh xạ chức năng từng pha sang đoạn tăng, giữ nguyên hoặc giảm của đại lượng.", "wrong_options": "Bỏ nhân đôi, kéo sự tăng sang pha không tổng hợp hoặc đặt sự giảm trước phân chia.", "difficulty_source": "Ghép đúng biến đổi định lượng với thời điểm cơ chế xảy ra.", "discrimination": "medium", "typical_steps": 4, "evidence_status": "quan_sat_rieng_chua_xac_lap_lap_lai", "refs": ["8bbf9eea6d33|P3|3|None"]}, {"part_kind": "short_answer", "topic": "Quan hệ họ hàng trên cây phát sinh", "grade": 12, "construction": "Cho cây có gốc và mã nhóm; yêu cầu sắp xếp quan hệ với nhóm tham chiếu. Người làm xác định tổ tiên chung gần nhất rồi chuyển thứ tự phân nhánh thành chuỗi mã.", "wrong_options": null, "difficulty_source": "Đọc cấu trúc phân nhánh thay vì vị trí trình bày hoặc tên nhóm.", "discrimination": "low", "typical_steps": 3, "evidence_status": "quan_sat_rieng_chua_xac_lap_lap_lai", "refs": ["8bbf9eea6d33|P3|4|None"]}, {"part_kind": "short_answer", "topic": "Liên kết giới tính và hoán vị gene", "grade": 12, "construction": "Cho kết quả lai qua các thế hệ và phân bố kiểu hình theo giới; yêu cầu ghép pha liên kết với tần số hoán vị. Người làm suy mô hình di truyền, chọn nhóm bộc lộ giao tử, xác định lớp bố mẹ rồi chuẩn hóa lớp tái tổ hợp.", "wrong_options": "Ghép sai pha liên kết, dùng sai nhóm thông tin hoặc lấy sai mẫu số.", "difficulty_source": "Phải xác định cấu trúc liên kết và tần số bằng các thao tác riêng nhưng nhất quán.", "discrimination": "high", "typical_steps": 5, "evidence_status": "quan_sat_rieng_chua_xac_lap_lap_lai", "refs": ["8bbf9eea6d33|P3|6|None"]}, {"part_kind": "multiple_choice", "topic": "Tần số allele từ cấu trúc kiểu gene", "grade": 12, "construction": "Cho tần số kiểu gene; yêu cầu tính tần số allele chỉ định. Người làm xác định đóng góp allele của từng kiểu gene rồi cộng đúng đối tượng.", "wrong_options": "Bỏ phần đóng góp của dị hợp, dùng nguyên tần số kiểu gene hoặc tính allele đối lập.", "difficulty_source": "Phân biệt đại lượng được cho với đại lượng được hỏi.", "discrimination": "low", "typical_steps": 2, "evidence_status": "quan_sat_rieng_chua_xac_lap_lap_lai", "refs": ["2cbdc74db082|P1|2|None"]}, {"part_kind": "true_false", "topic": "Thích nghi tiêu hóa và tác động của can thiệp", "grade": 11, "construction": "Cho các kiểu cấu tạo và giả thiết thay đổi hoạt động cộng sinh; yêu cầu đánh giá cách ghép nhóm hoặc mức ảnh hưởng. Người làm suy chức năng từ cấu tạo rồi kiểm tra cơ sở so sánh.", "wrong_options": "Hoán đổi nhóm thích nghi hoặc lấy một dấu hiệu nổi bật làm căn cứ xếp hạng toàn bộ.", "difficulty_source": "Phân biệt nhận diện sự phụ thuộc chức năng với kết luận về mức độ phụ thuộc.", "discrimination": "medium", "typical_steps": 3, "evidence_status": "quan_sat_rieng_chua_xac_lap_lap_lai", "refs": ["2cbdc74db082|P2|1|c", "2cbdc74db082|P2|1|d"]}], "discrimination_moves": [{"move": "Buộc suy trạng thái di truyền ẩn trước khi trả lời", "how_to_apply": "Cung cấp kết quả quan sát thay cho kiểu gene hoàn chỉnh; yêu cầu người làm dựng trạng thái trung gian rồi mới xét kết luận cuối. Chỉ dùng khi dữ kiện loại trừ được các mô hình cạnh tranh.", "refs": ["8bbf9eea6d33|P1|13|None", "8bbf9eea6d33|P3|6|None", "2cbdc74db082|P1|18|None"]}, {"move": "Chặn việc áp mô hình quen thuộc theo trí nhớ", "how_to_apply": "Để dữ liệu quyết định hệ di truyền hoặc cấu trúc liên kết; thiết kế nhiễu từ việc mặc định mô hình quen thuộc dù trái kết quả quan sát.", "refs": ["8bbf9eea6d33|P1|13|None", "8bbf9eea6d33|P3|6|None"]}, {"move": "Thay đổi tập đối tượng dùng làm mẫu số", "how_to_apply": "Cho dữ liệu trên toàn bộ đời con nhưng yêu cầu suy đặc trưng của nhóm cung cấp thông tin. Nhiễu giữ nguyên tỉ lệ toàn thể khi cần chuyển sang tỉ lệ có điều kiện.", "refs": ["8bbf9eea6d33|P1|13|None", "8bbf9eea6d33|P3|6|None"]}, {"move": "Yêu cầu kết luận đồng thời thỏa các ràng buộc", "how_to_apply": "Sau khi suy ra kết quả sinh học, buộc kiểm tra thêm điều kiện của yêu cầu hoặc chú giải. Phương án nhiễu có thể đúng ở bước trung gian nhưng không thỏa điều kiện cuối.", "refs": ["8bbf9eea6d33|P1|13|None", "2cbdc74db082|P1|18|None"]}, {"move": "Thiết kế đáp án ghép để tách lỗi thành phần", "how_to_apply": "Yêu cầu kết luận gồm các thành phần phải cùng đúng; tạo nhiễu giữ đúng thành phần này nhưng sai thành phần khác, tránh để một dấu hiệu đơn lẻ quyết định toàn bộ.", "refs": ["8bbf9eea6d33|P3|6|None"], "evidence_status": "quan_sat_rieng_chua_xac_lap_lap_lai"}], "easy_vs_hard": [{"topic": "Di truyền", "easy": "Cho trực tiếp cấu trúc kiểu gene và yêu cầu chuyển sang tần số allele.", "hard": "Cho kết quả lai theo giới; phải suy mô hình, pha liên kết và tập đối tượng dùng tính xác suất.", "difference": "Dạng khó thêm bước dựng mô hình và kiểm soát điều kiện trước khi tính.", "easy_refs": ["2cbdc74db082|P1|2|None"], "hard_refs": ["8bbf9eea6d33|P1|13|None", "8bbf9eea6d33|P3|6|None"]}, {"topic": "Quang hợp", "easy": "Nhận diện chất theo vai trò trong quá trình.", "hard": "Đọc đường đáp ứng, phân biệt các điểm đặc trưng và kiểm tra kết luận theo từng miền điều kiện.", "difference": "Chuyển từ nhớ quan hệ cố định sang diễn giải dữ liệu có giới hạn áp dụng.", "easy_refs": ["2cbdc74db082|P1|1|None", "8bbf9eea6d33|P1|16|None"], "hard_refs": ["8bbf9eea6d33|P1|4|None"]}, {"topic": "Cấu tạo và chức năng cơ quan", "easy": "Gọi tên bộ phận hoặc theo đường vận chuyển trên hình quen thuộc.", "hard": "Dùng trạng thái hoạt động hay can thiệp để suy hệ quả chức năng và đánh giá cơ sở so sánh.", "difference": "Dạng khó yêu cầu chuỗi nhân quả thay cho nhận diện vị trí.", "easy_refs": ["8bbf9eea6d33|P2|3|b", "2cbdc74db082|P2|1|a"], "hard_refs": ["8bbf9eea6d33|P2|3|a", "8bbf9eea6d33|P2|3|c", "2cbdc74db082|P2|1|c"]}, {"topic": "Tiến hóa", "easy": "Nhận diện cơ chế từ dấu hiệu nổi bật hoặc chọn định nghĩa.", "hard": "So sánh các tác động và kiểm tra sự khác nhau giữa hệ quả có thể xảy ra với hệ quả bắt buộc.", "difference": "Dạng khó tăng yêu cầu kiểm soát phạm vi và mức độ khẳng định.", "easy_refs": ["8bbf9eea6d33|P1|1|None", "2cbdc74db082|P1|8|None"], "hard_refs": ["2cbdc74db082|P1|15|None"]}], "fact_use": {"common": [{"use": "Dùng định nghĩa và thuật ngữ làm nền để nhận diện hoặc phân loại; nhiễu thường là khái niệm gần hoặc khác phạm vi.", "refs": ["8bbf9eea6d33|P1|9|None", "8bbf9eea6d33|P1|10|None", "2cbdc74db082|P1|8|None", "2cbdc74db082|P1|10|None", "2cbdc74db082|P1|11|None"]}, {"use": "Yêu cầu nhớ quan hệ cấu trúc, vai trò chất và chức năng cơ quan; kiến thức phải được đặt đúng vị trí hoặc đúng quá trình.", "refs": ["8bbf9eea6d33|P1|6|None", "8bbf9eea6d33|P1|16|None", "2cbdc74db082|P1|1|None", "2cbdc74db082|P1|5|None", "2cbdc74db082|P1|12|None"]}, {"use": "Các đại lượng trong bảng và phân bố di truyền được dùng làm đầu vào suy luận; không mặc định đều là dữ kiện cần học thuộc.", "refs": ["8bbf9eea6d33|P1|5|None", "8bbf9eea6d33|P3|1|None", "8bbf9eea6d33|P3|6|None", "2cbdc74db082|P1|2|None"]}], "observed_but_not_established_as_recurrent": [{"use": "Tên và thời điểm thí nghiệm làm dấu gợi để nhớ kết quả và giới hạn kết luận; không phải đối tượng được hỏi trực tiếp.", "refs": ["2cbdc74db082|P1|13|None"]}, {"use": "Kích thước đặc trưng được dùng để gọi tên cấp cấu trúc, nên có yêu cầu nhớ dữ kiện định lượng quy ước.", "refs": ["2cbdc74db082|P1|3|None"]}, {"use": "Có yêu cầu nhận biết trực tiếp các tên gọi tương đương của thuật ngữ chuyên môn.", "refs": ["8bbf9eea6d33|P2|1|d"]}], "not_observed": [{"observation": "Không thấy yêu cầu tái hiện trực tiếp ngày tháng hoặc tiểu sử nhân vật. Dẫn chứng lịch sử được dùng để xác định kết quả thí nghiệm hay hệ quan điểm.", "refs": ["2cbdc74db082|P1|13|None", "2cbdc74db082|P1|16|None"]}, {"observation": "Không thấy dùng tên nhóm trên cây làm căn cứ thay thế cho việc đọc quan hệ phân nhánh.", "refs": ["8bbf9eea6d33|P3|4|None"]}]}, "anti_patterns": [{"avoid": "Đổi câu hỏi suy luận thành yêu cầu kể lại ngày tháng hoặc tiểu sử.", "basis": "Các dẫn chiếu lịch sử trong dữ liệu phục vụ nhận diện phạm vi kiến thức và kết luận.", "refs": ["2cbdc74db082|P1|13|None", "2cbdc74db082|P1|16|None"]}, {"avoid": "Sinh phần tự luận dài hoặc yêu cầu lập luận mở như thể đã có bằng chứng về cấu trúc đó.", "basis": "Các dòng mô tả lựa chọn, đánh giá phát biểu và trả lời ngắn; không có bằng chứng cho yêu cầu trình bày bài luận.", "refs": ["8bbf9eea6d33|P1|13|None", "8bbf9eea6d33|P2|3|c", "8bbf9eea6d33|P3|6|None", "2cbdc74db082|P1|18|None", "2cbdc74db082|P2|2|a"]}, {"avoid": "Cho rằng câu trả lời ngắn luôn là kết quả tính toán.", "basis": "Có yêu cầu chọn đồ thị, sắp xếp mã và mã hóa các lựa chọn.", "refs": ["8bbf9eea6d33|P3|2|None", "8bbf9eea6d33|P3|3|None", "8bbf9eea6d33|P3|4|None"]}, {"avoid": "Thiết kế độ khó chỉ bằng phép tính, bỏ khâu xác định mô hình và điều kiện.", "basis": "Các dòng phân hóa cao dựa vào trạng thái di truyền ẩn, tập đối tượng có điều kiện và ràng buộc trên hình.", "refs": ["8bbf9eea6d33|P1|13|None", "8bbf9eea6d33|P3|6|None", "2cbdc74db082|P1|18|None"]}], "evidence_cautions": [{"issue": "Khóa và bảng gốc không nhất quán; chỉ dùng cấu trúc tổng hợp đại lượng, không học đáp án hoặc lỗi nhiễu từ khóa.", "refs": ["8bbf9eea6d33|P1|5|None"]}, {"issue": "Biến động đồng thời chưa xác định được khẩu phần, ổ dinh dưỡng hoặc đường nhân quả. Không dùng các kết luận này như mẫu suy luận chắc chắn.", "refs": ["8bbf9eea6d33|P2|2|a", "8bbf9eea6d33|P2|2|b", "8bbf9eea6d33|P2|2|c"]}, {"issue": "Thiếu quy định biểu hiện hoặc bằng chứng phân biệt mô hình di truyền; chưa xác lập được đáp án duy nhất hay độ phân hóa.", "refs": ["8bbf9eea6d33|P2|4|b", "8bbf9eea6d33|P2|4|d"]}, {"issue": "Thiếu bảng thực nghiệm nên không thể đánh giá thao tác chọn đáp án.", "refs": ["8bbf9eea6d33|P3|5|None"]}, {"issue": "Mức chính xác thuật ngữ hoặc hậu quả chức năng của biến đổi chưa được quy định rõ; không biến cách chấm phụ thuộc giả định thành quy tắc tổng quát.", "refs": ["2cbdc74db082|P2|2|b", "2cbdc74db082|P2|2|c"]}]}, {"evidence_scope": "Hồ sơ chỉ mô tả các hàng được cung cấp từ nguồn đề cấp tỉnh bên thứ ba. Chỉ xem một cấu trúc là tái diễn giữa các đề khi refs thuộc các paper khác nhau; các mục chỉ có bằng chứng trong cùng paper là quan sát cục bộ. Không suy rộng thành quy cách chính thức. Những chỗ dữ kiện, cách diễn đạt hoặc khóa chưa thống nhất được giữ lại như giới hạn bằng chứng.", "patterns": [{"part_kind": "multiple_choice", "topic": "Suy ngược kiểu gene bố mẹ từ phân li kiểu hình", "grade": 12, "construction": "Cho quan hệ trội lặn và phân bố kiểu hình đời con; yêu cầu chọn bố mẹ. Tách phân li theo từng tính trạng, suy trạng thái allele tại từng locus rồi ghép lại và kiểm tra phân li chung.", "wrong_options": "Thay trạng thái đồng hợp, dị hợp; đảo locus; đưa phép lai quen thuộc nhưng không khớp dữ kiện.", "difficulty_source": "Phải phân rã dữ liệu chung trước khi suy ngược.", "discrimination": "medium", "typical_steps": 3, "refs": ["55c12f561006|P1|1|None"]}, {"part_kind": "multiple_choice", "topic": "Biến đổi cấu trúc di truyền qua các chế độ sinh sản", "grade": 12, "construction": "Cho cấu trúc xuất phát và lịch sử sinh sản; yêu cầu tần số kiểu gene cuối. Theo dõi tần số allele, xác lập cấu trúc sau ngẫu phối nếu có, rồi chuyển phần dị hợp bị giảm thành đồng hợp khi tự phối.", "wrong_options": "Trả kết quả trung gian, dùng trạng thái giới hạn, bỏ giai đoạn hoặc nhầm bảo toàn allele với bảo toàn kiểu gene.", "difficulty_source": "Theo đúng lịch sử sinh sản và phân biệt đại lượng được bảo toàn với đại lượng thay đổi.", "discrimination": "medium", "typical_steps": 4, "refs": ["55c12f561006|P1|2|None", "55c12f561006|P1|11|None"]}, {"part_kind": "multiple_choice", "topic": "Chiều tác động của các quá trình lên kích thước quần thể", "grade": 12, "construction": "Cho các tổ hợp quá trình bổ sung hoặc làm mất cá thể; yêu cầu chọn tổ hợp cùng làm tăng quần thể. Gán chiều tác động cho từng quá trình rồi kiểm tra toàn bộ tổ hợp.", "wrong_options": "Ghép quá trình tăng với quá trình giảm; đánh đồng có biến động với có tăng trưởng.", "difficulty_source": "Phân biệt dấu tác động thay vì chỉ nhận ra quá trình có liên quan.", "discrimination": "low", "typical_steps": 2, "refs": ["55c12f561006|P1|3|None"]}, {"part_kind": "multiple_choice", "topic": "Các mức tổ chức nhiễm sắc thể", "grade": 12, "construction": "Cho kích thước đặc trưng; yêu cầu gọi tên mức đóng xoắn. Ghép dữ kiện định lượng với bậc cấu trúc đã học.", "wrong_options": "Dùng tên các mức tổ chức có thật nhưng ghép sai kích thước.", "difficulty_source": "Trí nhớ chính xác về quan hệ giữa kích thước và bậc cấu trúc.", "discrimination": "low", "typical_steps": 2, "refs": ["55c12f561006|P1|4|None"]}, {"part_kind": "multiple_choice", "topic": "Sản phẩm tiêu hóa", "grade": 11, "construction": "Cho nhóm chất được tiêu hóa; yêu cầu xác định sản phẩm cuối. Nhận diện đại phân tử rồi liên hệ với đơn phân thu được khi phân giải hoàn toàn.", "wrong_options": "Lấy sản phẩm phân giải của nhóm chất khác.", "difficulty_source": "Nhớ quan hệ giữa cơ chất và sản phẩm.", "discrimination": "low", "typical_steps": 2, "refs": ["55c12f561006|P1|5|None"]}, {"part_kind": "multiple_choice", "topic": "Phân tầng không gian và sử dụng tài nguyên", "grade": 12, "construction": "Cho cách bố trí hoặc phân bố sinh vật theo tầng; yêu cầu xác định cơ sở hay ý nghĩa sinh thái. Liên hệ vị trí không gian với phân bố tài nguyên, chồng lấn nhu cầu và cạnh tranh.", "wrong_options": "Chọn nhân tố có liên quan nhưng không giải thích phân tầng; nhầm chiều phân bố hoặc nhầm phân hóa với mở rộng ổ sinh thái.", "difficulty_source": "Chọn cơ chế giải thích trực tiếp cách sử dụng không gian.", "discrimination": "low", "typical_steps": 2, "refs": ["55c12f561006|P1|6|None", "4b4716b94db4|P1|7|None"]}, {"part_kind": "multiple_choice", "topic": "Quy đổi giữa hoán vị gene, giao tử và đời con lai phân tích", "grade": 12, "construction": "Cho pha liên kết cùng tần số giao tử hoặc khoảng cách bản đồ; yêu cầu suy đại lượng còn lại. Phân loại giao tử bố mẹ và tái tổ hợp, phân biệt tần số từng lớp với tổng nhóm, rồi quy đổi sang đời con khi cần.", "wrong_options": "Lấy tần số giao tử riêng làm tổng hoán vị; nhầm nhóm liên kết với tái tổ hợp; thiếu lớp hoặc cộng lặp.", "difficulty_source": "Giữ đúng đối tượng của mỗi tần số.", "discrimination": "medium", "typical_steps": 3, "refs": ["55c12f561006|P1|7|None", "4b4716b94db4|P1|12|None"]}, {"part_kind": "multiple_choice", "topic": "Biến đổi trật tự locus do đảo đoạn", "grade": 12, "construction": "Cho trật tự locus và ranh giới đoạn chịu tác động; yêu cầu chọn cấu trúc sau biến đổi. Khoanh đoạn, đảo thứ tự bên trong và giữ nguyên phần ngoài.", "wrong_options": "Biến thao tác thành mất đoạn, chuyển vị hoặc đảo vượt ranh giới.", "difficulty_source": "Thực hiện đúng phép biến đổi trên biểu diễn kí hiệu.", "discrimination": "low", "typical_steps": 3, "refs": ["55c12f561006|P1|8|None"]}, {"part_kind": "multiple_choice", "topic": "Cấu trúc gene và xử lí RNA", "grade": 12, "construction": "Cho hình các vùng của gene; yêu cầu chọn nhận định về tổ chức hoặc chức năng. Nhận diện phân mảnh, liên hệ phiên mã với xử lí RNA rồi phân biệt phần được phiên mã và phần tham gia quy định sản phẩm.", "wrong_options": "Đồng nhất toàn bộ vùng phiên mã với vùng mã hóa; bỏ qua phần bị loại khi xử lí RNA.", "difficulty_source": "Dùng đặc điểm trên hình để phân biệt các phạm vi chức năng.", "discrimination": "low", "typical_steps": 3, "refs": ["55c12f561006|P1|9|None"]}, {"part_kind": "multiple_choice", "topic": "Sự mềm dẻo kiểu hình", "grade": 12, "construction": "Cho mô tả biểu hiện thay đổi theo môi trường; yêu cầu gọi tên hiện tượng. Xác định yếu tố di truyền giữ nguyên và biểu hiện thay đổi rồi đối chiếu định nghĩa.", "wrong_options": "Gán tính biến đổi cho kiểu gene hoặc dùng thuật ngữ thích nghi gần nghĩa.", "difficulty_source": "Phân biệt thay đổi biểu hiện với thay đổi vật chất di truyền.", "discrimination": "low", "typical_steps": 2, "refs": ["55c12f561006|P1|10|None"]}, {"part_kind": "multiple_choice", "topic": "Nguồn gốc sản phẩm khí của quang hợp", "grade": 11, "construction": "Cho sản phẩm quang hợp và các nguồn nguyên tử có thể có; yêu cầu xác định chất cung cấp nguyên tử. Gọi lại phản ứng thành phần thay vì suy trực tiếp từ phương trình tổng quát.", "wrong_options": "Dùng nguyên liệu tạo chất hữu cơ, sản phẩm hữu cơ hoặc chất chứa nguyên tố tương ứng nhưng ngoài cơ chế.", "difficulty_source": "Nhớ đúng nguồn nguyên tử theo cơ chế.", "discrimination": "low", "typical_steps": 2, "refs": ["55c12f561006|P1|12|None"]}, {"part_kind": "multiple_choice", "topic": "Cơ chế hình thành loài qua biến đổi bộ nhiễm sắc thể", "grade": 12, "construction": "Cho chuỗi lai, bất thụ và phục hồi hữu thụ sau biến đổi bộ nhiễm sắc thể; yêu cầu gọi tên cơ chế. Nhận diện nguồn bộ gene và sự nhân bộ rồi nối các sự kiện.", "wrong_options": "Đưa những cơ chế cách li có thật nhưng không được chuỗi dữ kiện thể hiện.", "difficulty_source": "Đọc cơ chế từ chuỗi sự kiện thay vì chọn con đường quen thuộc.", "discrimination": "low", "typical_steps": 3, "refs": ["55c12f561006|P1|13|None"]}, {"part_kind": "multiple_choice", "topic": "Nhận diện khái niệm sinh thái từ tiêu chí hoặc đơn vị", "grade": 12, "construction": "Cho mô tả tập hợp sinh vật, dạng đại lượng hoặc phạm vi điều kiện sống; yêu cầu chọn khái niệm tương ứng. Tách dấu hiệu định nghĩa, kiểm tra điều kiện bắt buộc và loại thuật ngữ gần.", "wrong_options": "Đánh đồng cùng nơi sống với cùng loài; nhầm đại lượng với cách phân bố; nhầm khoảng chịu đựng với nơi sống hay ổ sinh thái.", "difficulty_source": "Giữ đúng tiêu chí phân biệt các khái niệm gần nhau.", "discrimination": "low", "typical_steps": 2, "refs": ["55c12f561006|P1|14|None", "4b4716b94db4|P1|9|None", "4b4716b94db4|P1|11|None"]}, {"part_kind": "multiple_choice", "topic": "Phân biệt cơ chế của các nhân tố tiến hóa", "grade": 12, "construction": "Cho nhận định hoặc đặc điểm biến đổi allele; yêu cầu chọn cơ chế phù hợp hay nhận định sai. Phân biệt tạo biến dị, sàng lọc theo giá trị thích nghi, trao đổi allele và biến đổi ngẫu nhiên.", "wrong_options": "Gán khả năng tạo biến dị cho chọn lọc; phủ nhận tính định hướng; dùng cơ chế ngẫu nhiên và thích nghi thay thế nhau.", "difficulty_source": "Xác định đúng chức năng và chiều tác động của cơ chế.", "discrimination": "low", "typical_steps": 3, "refs": ["55c12f561006|P1|15|None", "4b4716b94db4|P1|1|None"]}, {"part_kind": "multiple_choice", "topic": "Xác suất di truyền bệnh từ quan hệ gia đình", "grade": 12, "construction": "Cho quan hệ bệnh và không bệnh trong gia đình; yêu cầu xác suất tổ hợp đặc điểm ở con. Suy cơ chế di truyền, điều kiện hóa khả năng mang allele của người không bệnh rồi kết hợp xác suất truyền allele với sự kiện giới tính. Cần làm rõ giới tính là điều kiện đã biết hay sự kiện đồng thời.", "wrong_options": "Dùng xác suất chưa điều kiện hóa; mặc định người không bệnh đều dị hợp; bỏ sự kiện giới tính.", "difficulty_source": "Giữ bất định kiểu gene và đúng không gian điều kiện.", "discrimination": "high", "typical_steps": 4, "refs": ["55c12f561006|P1|16|None"]}, {"part_kind": "multiple_choice", "topic": "Nhận diện phân tử mang thông tin di truyền", "grade": 10, "construction": "Cho công thức cấu tạo hoặc chức năng cần nhận diện; yêu cầu chọn phân tử tương ứng. Đối chiếu các bộ phận cấu tạo hoặc chức năng đặc trưng với nhóm phân tử.", "wrong_options": "Dùng phân tử thuộc nhóm khác; lấy thành phần riêng thay đơn phân hoàn chỉnh; nhầm thực hiện chức năng với lưu giữ thông tin.", "difficulty_source": "Nhận đúng dấu hiệu phân biệt nhóm phân tử.", "discrimination": "low", "typical_steps": 3, "refs": ["55c12f561006|P1|17|None", "4b4716b94db4|P1|14|None"]}, {"part_kind": "multiple_choice", "topic": "Phạm vi khái niệm và giai đoạn tiến hóa", "grade": 12, "construction": "Cho tên khái niệm hoặc giai đoạn; yêu cầu chọn mô tả hay sản phẩm tương ứng. Xác định cấp tổ chức, đại lượng biến đổi hoặc ranh giới giai đoạn rồi đối chiếu phương án.", "wrong_options": "Đổi cấp tổ chức, đưa sản phẩm xuất hiện muộn vào giai đoạn sớm hoặc lấy cơ chế thành phần thay định nghĩa chung.", "difficulty_source": "Nhớ đúng phạm vi của khái niệm.", "discrimination": "low", "typical_steps": 2, "refs": ["55c12f561006|P1|18|None", "4b4716b94db4|P1|13|None"]}, {"part_kind": "multiple_choice", "topic": "Nhận diện tương tác gene từ phân li", "grade": 12, "construction": "Cho phân li kiểu hình của phép lai; yêu cầu nhận diện mô hình tương tác. Liên hệ cách gộp nhóm kiểu gene với quan hệ nhiều gene chi phối tính trạng. Tên phân loại trong khóa có phụ thuộc quy ước tài liệu.", "wrong_options": "Nhầm tương tác với liên kết hoặc đa hiệu; dùng tên tương tác gần nhau mà chưa phân biệt cơ chế.", "difficulty_source": "Chuyển phân li kiểu hình thành mô hình tác động gene.", "discrimination": "medium", "typical_steps": 3, "refs": ["4b4716b94db4|P1|10|None"]}, {"part_kind": "multiple_choice", "topic": "Sự kiện đặc trưng của giảm phân", "grade": 10, "construction": "Cho sự kiện phân li; yêu cầu xác định giai đoạn. Phân biệt đối tượng đang tách, lần phân bào và thời điểm đang diễn ra với thời điểm đã hoàn tất.", "wrong_options": "Đổi nhiễm sắc thể tương đồng thành chromatid; đổi lần phân bào hoặc chọn kết quả thay diễn biến.", "difficulty_source": "Nhớ đúng đối tượng và thời điểm phân li.", "discrimination": "low", "typical_steps": 2, "refs": ["4b4716b94db4|P1|6|None"]}, {"part_kind": "multiple_choice", "topic": "Phân loại bằng chứng tiến hóa", "grade": 12, "construction": "Cho loại dữ liệu so sánh; yêu cầu gọi tên nguồn bằng chứng. Xác định cấp độ của dữ liệu rồi đối chiếu hệ phân loại bằng chứng.", "wrong_options": "Đưa loại bằng chứng thuộc cơ quan, phân bố hoặc phát triển cá thể thay dữ liệu phân tử.", "difficulty_source": "Nhận diện trực tiếp cấp độ dữ liệu.", "discrimination": "low", "typical_steps": 2, "refs": ["4b4716b94db4|P1|15|None"]}, {"part_kind": "multiple_choice", "topic": "Giới hạn suy luận từ bảng tương đồng hệ gene", "grade": 12, "construction": "Cho các mức tương đồng đều so với chung đối tượng mốc; yêu cầu tìm kết luận không được hỗ trợ. Đọc thứ tự tương đồng, xác định phạm vi so sánh rồi kiểm tra quan hệ nào chưa được đo trực tiếp.", "wrong_options": "Các lựa chọn không phải đáp án là kết luận được bảng hỗ trợ; chúng kiểm tra việc đảo tương đồng và khác biệt hoặc đọc sai thứ tự.", "difficulty_source": "Không suy quan hệ trực tiếp giữa các đối tượng chỉ từ quan hệ của chúng với mốc.", "discrimination": "medium", "typical_steps": 4, "refs": ["4b4716b94db4|P1|8|None"]}, {"part_kind": "multiple_choice", "topic": "Điều kiện môi trường và con đường quang hợp", "grade": 11, "construction": "Cho điều kiện môi trường và các đối tượng thuộc nhóm quang hợp khác nhau; yêu cầu chọn đối tượng có đáp ứng phù hợp. Nhớ nhóm của từng đối tượng, liên hệ cơ chế cố định carbon với điều kiện rồi chọn.", "wrong_options": "Dựa vào môi trường sống bề ngoài; bỏ cơ chế tập trung carbon hoặc phân tách hoạt động theo thời gian.", "difficulty_source": "Kết hợp trí nhớ phân loại với cơ chế sinh lí.", "discrimination": "medium", "typical_steps": 3, "refs": ["4b4716b94db4|P1|16|None"]}, {"part_kind": "multiple_choice", "topic": "Vai trò khuôn trong truyền đạt thông tin di truyền", "grade": 12, "construction": "Cho tên quá trình và các loại phân tử; yêu cầu chọn khuôn. Xác định chiều truyền thông tin rồi phân biệt khuôn, sản phẩm và phân tử hỗ trợ.", "wrong_options": "Đảo khuôn với sản phẩm hoặc đưa thành phần của quá trình khác vào.", "difficulty_source": "Nhớ đúng vai trò phân tử.", "discrimination": "low", "typical_steps": 2, "refs": ["4b4716b94db4|P1|17|None"]}, {"part_kind": "multiple_choice", "topic": "Đột biến gene qua phiên mã và dịch mã", "grade": 12, "construction": "Cho mạch khuôn có định hướng, bảng tra bộ ba và các nhận định về biến đổi trình tự; yêu cầu xác định số nhận định đúng. Lập sản phẩm ban đầu rồi dựng lại trình tự, khung đọc và điểm dừng sau từng biến đổi.", "wrong_options": "Tính tín hiệu kết thúc như phần mã hóa; giữ nguyên khung đọc sau thêm nucleotide; kiểm tra thiếu nhận định. Đáp án dạng đếm không xác định duy nhất lỗi đã mắc.", "difficulty_source": "Duy trì đúng chiều bổ sung và khung đọc qua các phép biến đổi.", "discrimination": "high", "typical_steps": 5, "refs": ["4b4716b94db4|P1|3|None"]}, {"part_kind": "true_false", "topic": "Nhận diện khái niệm từ sơ đồ di truyền", "grade": 12, "construction": "Cho hình ghép vật chất di truyền, con đường chuyển hóa hoặc tổ chức dịch mã; yêu cầu kiểm tra tên gọi hay cơ chế. Theo nhãn, mũi tên và quan hệ giữa các thành phần rồi đối chiếu dấu hiệu định nghĩa.", "wrong_options": null, "difficulty_source": "Nhận ra dấu hiệu trực tiếp trên sơ đồ.", "discrimination": "low", "typical_steps": 3, "refs": ["2cbdc74db082|P2|3|c", "55c12f561006|P2|1|a", "55c12f561006|P2|2|a"]}, {"part_kind": "true_false", "topic": "Phân biệt trạng thái trung gian với bản chất và sản phẩm cuối", "grade": 12, "construction": "Cho các trạng thái phát triển hoặc tổng hợp khác nhau; yêu cầu kiểm tra sự giống hay khác của vật chất di truyền hoặc sản phẩm hoàn tất. Xác định nguồn gốc chung, tìm can thiệp có thể tạo khác biệt rồi tách biểu hiện tạm thời khỏi kết quả cuối. Suy luận về điện di cần điều kiện xử lí và đo tương ứng.", "wrong_options": "Lấy khác biệt hình thái hay độ dài đang tổng hợp làm bằng chứng chắc chắn của khác biệt di truyền hoặc sản phẩm cuối.", "difficulty_source": "Đọc quan hệ quá trình thay vì so hình dạng tại thời điểm chụp.", "discrimination": "medium", "typical_steps": 3, "refs": ["2cbdc74db082|P2|3|b", "55c12f561006|P2|2|d"]}, {"part_kind": "true_false", "topic": "Từ biểu hiện gene đến chức năng miễn dịch", "grade": 12, "construction": "Cho quy trình thu protein từ hệ biểu hiện gene ngoại lai và tác dụng sau sử dụng; yêu cầu kiểm tra quan hệ chức năng. Theo nguồn mã hóa, nhận diện vai trò sản phẩm rồi liên hệ đáp ứng miễn dịch.", "wrong_options": null, "difficulty_source": "Nối cơ chế công nghệ gene với chức năng sinh học của sản phẩm.", "discrimination": "medium", "typical_steps": 3, "refs": ["2cbdc74db082|P2|3|d"]}, {"part_kind": "true_false", "topic": "Điều kiện chặn biểu hiện kiểu hình", "grade": 12, "construction": "Cho con đường sinh hóa kèm điều kiện môi trường hoặc gene ức chế; yêu cầu kiểm tra dự đoán kiểu hình. Xác định điều kiện cho phép biểu hiện trước, sau đó mới suy sản phẩm từ kiểu gene hoặc phép lai.", "wrong_options": "Áp dụng phân li quen thuộc khi biểu hiện đã bị che lấp; coi đủ allele tạo enzyme là đủ tạo sản phẩm cuối.", "difficulty_source": "Ưu tiên điều kiện chặn trước phép tính di truyền.", "discrimination": "medium", "typical_steps": 4, "refs": ["2cbdc74db082|P2|4|a", "55c12f561006|P2|1|b"]}, {"part_kind": "true_false", "topic": "Đếm phép lai theo các lớp kiểu hình", "grade": 12, "construction": "Cho ánh xạ kiểu gene sang sản phẩm và kiểu hình; yêu cầu kiểm tra tập phép lai giữa các cá thể cùng biểu hiện. Liệt kê kiểu gene, chia lớp kiểu hình rồi đếm cặp theo quy ước có xét hay không xét chiều lai.", "wrong_options": null, "difficulty_source": "Chuyển sơ đồ sinh hóa thành phân hoạch kiểu gene và tránh đếm lặp.", "discrimination": "medium", "typical_steps": 4, "refs": ["2cbdc74db082|P2|4|b"]}, {"part_kind": "true_false", "topic": "Tìm phép lai thỏa điều kiện kiểu hình", "grade": 12, "construction": "Cho mô hình tương tác và quan hệ cần đạt ở đời con; yêu cầu kiểm tra sự tồn tại của phép lai. Suy tập kiểu gene bố mẹ phù hợp, tìm cấu hình phân li rồi kiểm tra quan hệ giữa các nhóm kiểu hình.", "wrong_options": null, "difficulty_source": "Tìm cấu hình thỏa ràng buộc thay vì dùng phép lai mặc định.", "discrimination": "medium", "typical_steps": 4, "refs": ["2cbdc74db082|P2|4|c"]}, {"part_kind": "true_false", "topic": "Phân biệt không gian kiểu gene và không gian kiểu hình", "grade": 12, "construction": "Cho các locus và quy tắc biểu hiện theo môi trường; yêu cầu kiểm tra khả năng đa dạng kiểu gene, kiểu hình. Kết hợp trạng thái di truyền rồi gộp những trạng thái có cùng biểu hiện.", "wrong_options": null, "difficulty_source": "Không đồng nhất tổ hợp di truyền với biểu hiện quan sát được.", "discrimination": "medium", "typical_steps": 3, "refs": ["2cbdc74db082|P2|4|d"]}, {"part_kind": "true_false", "topic": "Xác suất kiểu hình từ con đường chuyển hóa", "grade": 12, "construction": "Cho sơ đồ chuyển hóa và phép tự phối; yêu cầu kiểm tra tỉ lệ sản phẩm. Viết điều kiện kiểu gene cho từng đường đi hoặc điểm tắc, tính xác suất rồi gộp trường hợp hoặc dùng biến cố đối.", "wrong_options": "Đồng nhất vai trò mọi allele trội; đảo điều kiện ở locus ức chế; gộp nguyên nhân cùng kiểu hình nhưng đếm trùng.", "difficulty_source": "Chuyển quan hệ sinh hóa thành điều kiện xác suất đúng dấu.", "discrimination": "medium", "typical_steps": 4, "refs": ["55c12f561006|P2|1|c", "55c12f561006|P2|1|d"]}, {"part_kind": "true_false", "topic": "Suy định hướng và thời gian từ hình dịch mã", "grade": 12, "construction": "Cho vị trí khởi đầu, kết thúc, ribosome và chuỗi đang kéo dài; yêu cầu kiểm tra cực tính hoặc thứ tự tham gia. Xác định chiều dịch chuyển rồi suy đầu mạch và mức tiến triển của từng ribosome.", "wrong_options": "Đảo chiều đọc khuôn; coi vị trí gần điểm khởi đầu là bằng chứng bắt đầu sớm.", "difficulty_source": "Chuyển quan hệ không gian trên ảnh tĩnh thành định hướng và trình tự thời gian.", "discrimination": "medium", "typical_steps": 3, "refs": ["55c12f561006|P2|2|b", "55c12f561006|P2|2|c"]}, {"part_kind": "true_false", "topic": "Đọc và so sánh đường cong sinh thái", "grade": 12, "construction": "Cho đường cong đáp ứng theo nhân tố môi trường; yêu cầu so khoảng chịu đựng, chênh mốc hoặc đáp ứng tại cùng điều kiện. Chọn đúng loại mốc hay lát cắt, đọc giá trị rồi so sánh. Không mặc nhiên coi mức thích nghi là phép đo trực tiếp tỉ lệ sống.", "wrong_options": "Đổi mốc tối ưu với giới hạn; bỏ dấu tọa độ; dùng bề rộng khoảng thay giá trị đáp ứng tại điều kiện cần xét.", "difficulty_source": "Chọn đúng đại lượng trên đồ thị trước khi tính.", "discrimination": "low", "typical_steps": 3, "refs": ["55c12f561006|P2|3|a", "55c12f561006|P2|3|b", "55c12f561006|P2|3|c"]}, {"part_kind": "true_false", "topic": "Bác bỏ khái quát hóa vượt điều kiện", "grade": 12, "construction": "Cho dữ liệu sinh thái hiện tại hoặc quy tắc về hệ tuần hoàn; yêu cầu kiểm tra kết luận tổng quát. Tách tiêu chí định nghĩa khỏi đặc điểm thường gặp, xét giới hạn áp dụng và tìm trường hợp không được kết luận bao phủ.", "wrong_options": "Biến ưu thế tại điều kiện hiện tại thành ưu thế tất yếu; lấy đặc điểm của bộ phận hệ thống làm quy tắc toàn hệ.", "difficulty_source": "Kiểm tra phạm vi mệnh đề và điều kiện còn thiếu.", "discrimination": "medium", "typical_steps": 3, "refs": ["55c12f561006|P2|3|d", "55c12f561006|P2|4|c"]}, {"part_kind": "true_false", "topic": "Định vị và lần theo đường tuần hoàn", "grade": 11, "construction": "Cho sơ đồ có ngăn tim, tên mạch, chiều dòng và mạng mao mạch; yêu cầu kiểm tra vị trí hoặc trình tự. Theo mạch từ nơi xuất phát qua vùng trao đổi rồi xác định nơi trở về.", "wrong_options": null, "difficulty_source": "Định hướng giải phẫu và giữ liên tục đường đi trên sơ đồ.", "discrimination": "low", "typical_steps": 3, "refs": ["55c12f561006|P2|4|a", "55c12f561006|P2|4|b", "55c12f561006|P2|4|d"]}, {"part_kind": "short_answer", "topic": "Chuẩn hóa sau loại bỏ cá thể", "grade": 12, "construction": "Cho cấu trúc di truyền hoặc dữ kiện để suy cấu trúc, kèm nhóm bị loại; yêu cầu tỉ lệ hay lượng cá thể trong tập còn lại hoặc thế hệ sau. Xác định nhóm đủ điều kiện, đổi mẫu số rồi áp dụng quy luật sinh sản và quy đổi kết quả. Trường hợp liên quan gene gây chết còn thiếu giả thiết về quan hệ giữa các locus.", "wrong_options": null, "difficulty_source": "Phân biệt tập xuất phát, tập sinh sản và tập được thống kê.", "discrimination": "medium", "typical_steps": 5, "refs": ["2cbdc74db082|P3|1|None", "55c12f561006|P3|6|None"]}, {"part_kind": "short_answer", "topic": "Suy bộ nhiễm sắc thể từ hình phân bào", "grade": 12, "construction": "Cho hình phân li có nhãn gene; yêu cầu suy bộ nhiễm sắc thể ban đầu. Nhận diện giai đoạn, dùng tổ hợp allele để xác lập nhóm tương đồng rồi suy bộ gốc. Cách đọc bất thường phân li chưa được đề nêu tường minh.", "wrong_options": null, "difficulty_source": "Ưu tiên quan hệ tương đồng do nhãn gene xác định thay vì nhân số cấu trúc nhìn thấy.", "discrimination": "high", "typical_steps": 4, "refs": ["2cbdc74db082|P3|2|None"]}, {"part_kind": "short_answer", "topic": "Đếm phần tử thỏa tiêu chí sinh học", "grade": 12, "construction": "Cho danh sách biểu diễn bộ nhiễm sắc thể hoặc đặc điểm thích nghi; yêu cầu đếm trường hợp phù hợp. Xác lập tiêu chí, kiểm tra từng phần tử độc lập rồi tổng hợp.", "wrong_options": null, "difficulty_source": "Áp dụng nhất quán tiêu chí và không bỏ sót phần tử.", "discrimination": "low", "typical_steps": 3, "refs": ["2cbdc74db082|P3|3|None", "2cbdc74db082|P3|6|None"]}, {"part_kind": "short_answer", "topic": "Sắp xếp cơ chế hình thành thích nghi", "grade": 12, "construction": "Cho các sự kiện chưa theo thứ tự; yêu cầu sắp xếp. Xác định nguồn biến dị, sự truyền lại, tác động sàng lọc và kết quả ở quần thể rồi nối theo quan hệ nhân quả.", "wrong_options": null, "difficulty_source": "Không để nhu cầu môi trường thay thế nguồn phát sinh biến dị.", "discrimination": "medium", "typical_steps": 4, "refs": ["2cbdc74db082|P3|4|None"]}, {"part_kind": "short_answer", "topic": "Tổng hợp đời con tự phối từ các nhóm bố mẹ", "grade": 12, "construction": "Cho phân bố bố mẹ trực tiếp hoặc dữ kiện để suy ra, có thể kèm chọn nhóm theo kiểu hình; yêu cầu tỉ lệ đời con đích. Xác định kiểu gene và cơ chế tạo giao tử, chuẩn hóa nhóm được chọn nếu có, tính kết quả từng nhóm rồi lấy tổng có trọng số. Nhánh có liên kết đòi hỏi suy pha và hoán vị; nhánh bảng có khóa chưa khớp dữ kiện.", "wrong_options": null, "difficulty_source": "Giữ thành phần kiểu gene có điều kiện và trọng số qua toàn chuỗi.", "discrimination": "high", "typical_steps": 6, "refs": ["2cbdc74db082|P3|5|None", "55c12f561006|P3|2|None"]}, {"part_kind": "short_answer", "topic": "Xác suất phả hệ với kiểu gene chưa xác định", "grade": 12, "construction": "Cho phả hệ có kiểu hình và quan hệ huyết thống; yêu cầu xác suất đặc điểm ở con. Truyền ràng buộc giữa các thế hệ, xác định kiểu gene bắt buộc, giữ phân bố có điều kiện cho các khả năng còn lại rồi tổng hợp xác suất truyền allele và giới tính.", "wrong_options": null, "difficulty_source": "Kết hợp ràng buộc phả hệ với bất định kiểu gene.", "discrimination": "high", "typical_steps": 5, "refs": ["55c12f561006|P3|1|None"]}, {"part_kind": "short_answer", "topic": "Theo dõi mạch DNA qua thay đổi môi trường đánh dấu", "grade": 12, "construction": "Cho lịch sử tái bản trong các môi trường đánh dấu và lượng phân tử thuộc lớp trung gian; yêu cầu lượng phân tử đích cuối quá trình. Phân loại theo nguồn mạch, suy lượng ban đầu rồi theo dõi mạch cũ và mạch mới qua từng lần đổi môi trường.", "wrong_options": null, "difficulty_source": "Bảo toàn lịch sử mạch thay vì chỉ theo tổng lượng phân tử.", "discrimination": "medium", "typical_steps": 4, "refs": ["55c12f561006|P3|3|None"]}, {"part_kind": "short_answer", "topic": "Tính đại lượng quần thể từ bảng", "grade": 12, "construction": "Cho bảng các đại lượng sinh thái; yêu cầu kích thước, giá trị lớn nhất hoặc tăng trưởng ròng. Chọn đúng hàng cột, xác định quan hệ giữa các đại lượng, tính theo đơn vị rồi so sánh hoặc trình bày kết quả.", "wrong_options": null, "difficulty_source": "Chọn đúng dữ kiện, phép toán và dấu tác động.", "discrimination": "low", "typical_steps": 3, "refs": ["55c12f561006|P3|4|None", "55c12f561006|P3|5|None"]}, {"part_kind": "multiple_choice", "topic": "Kiểm tra đồng hợp trên toàn bộ kiểu gene", "grade": 12, "construction": "Cho các kí hiệu kiểu gene; yêu cầu chọn kiểu gene thỏa điều kiện ở mọi locus. Tách từng cặp allele rồi kiểm tra tính đồng nhất trên toàn biểu diễn.", "wrong_options": "Cài locus dị hợp giữa các locus đồng hợp để khai thác việc kiểm tra thiếu hoặc đánh giá theo đa số.", "difficulty_source": "Đọc đầy đủ điều kiện áp dụng cho mọi locus.", "discrimination": "low", "typical_steps": 2, "refs": ["4b4716b94db4|P1|5|None"]}, {"part_kind": "multiple_choice", "topic": "Suy nguồn truyền tính trạng từ vị trí gene", "grade": 12, "construction": "Cho vị trí gene trong bào quan và các tổ hợp bố mẹ; yêu cầu chọn tập tổ hợp có khả năng truyền tính trạng. Suy quy luật truyền bào quan, xác định nguồn đóng góp rồi kiểm tra từng tổ hợp.", "wrong_options": "Chấp nhận truyền qua bố, áp dụng đóng góp từ cả bố và mẹ hoặc bỏ sót tổ hợp có nguồn truyền phù hợp.", "difficulty_source": "Dùng vị trí gene để chọn quy luật thay vì mặc định di truyền trong nhân.", "discrimination": "low", "typical_steps": 3, "refs": ["4b4716b94db4|P1|2|None"]}, {"part_kind": "multiple_choice", "topic": "Chọn đối tượng chịu được toàn khoảng môi trường", "grade": 12, "construction": "Cho khoảng biến thiên môi trường và đồ thị chịu đựng; yêu cầu chọn đối tượng phù hợp. Đọc các cận rồi kiểm tra khoảng chịu đựng của từng đối tượng có bao chứa toàn khoảng yêu cầu hay không.", "wrong_options": "Chấp nhận giao nhau cục bộ; chỉ xét điểm thuận lợi; ghép khả năng chịu đựng của các đối tượng khác nhau.", "difficulty_source": "Kiểm tra điều kiện trên toàn miền thay vì tại điểm đại diện.", "discrimination": "medium", "typical_steps": 3, "refs": ["4b4716b94db4|P1|4|None"]}], "discrimination_moves": [{"move": "Điều kiện hóa trước khi tính xác suất", "how_to_apply": "Cho thông tin loại trừ kiểu hình hoặc chọn nhóm; buộc người giải xây lại phân bố kiểu gene trong tập đủ điều kiện trước khi tính sự kiện đích.", "refs": ["55c12f561006|P1|16|None", "55c12f561006|P3|1|None", "2cbdc74db082|P3|5|None"]}, {"move": "Giữ trọng số của các khả năng chưa xác định", "how_to_apply": "Để dữ kiện chỉ xác định tập kiểu gene khả dĩ; yêu cầu tổng hợp kết quả theo xác suất của từng khả năng, tránh mặc định tất cả cá thể cùng kiểu gene.", "refs": ["55c12f561006|P1|16|None", "55c12f561006|P3|1|None", "2cbdc74db082|P3|5|None"]}, {"move": "Suy cơ chế ẩn rồi mới tính kết quả", "how_to_apply": "Không cho trực tiếp pha liên kết hoặc trạng thái bố mẹ; cung cấp phân li để người giải suy mô hình, kiểm tra mô hình rồi dùng cho giai đoạn tiếp theo.", "refs": ["2cbdc74db082|P3|5|None", "55c12f561006|P1|16|None"]}, {"move": "Dùng nhãn để kiểm tra lại hình thức bề ngoài", "how_to_apply": "Đặt thông tin quyết định trong quan hệ allele hoặc quan hệ huyết thống; yêu cầu đối chiếu nhãn và cấu trúc quan hệ trước khi dùng quy tắc đếm. Không tái tạo sự thiếu tường minh về bất thường phân li của hàng nguồn.", "refs": ["2cbdc74db082|P3|2|None", "55c12f561006|P3|1|None"]}, {"move": "Dựng lại biểu diễn sau mỗi biến đổi", "how_to_apply": "Cho chuỗi biến đổi mà kết quả trung gian làm đầu vào cho bước sau; yêu cầu viết lại trình tự hoặc thành phần nhóm thay vì tiếp tục dùng biểu diễn ban đầu.", "refs": ["4b4716b94db4|P1|3|None", "2cbdc74db082|P3|5|None"]}, {"move": "Kết hợp các tầng ràng buộc độc lập", "how_to_apply": "Nối ràng buộc về quan hệ di truyền, trạng thái kiểu gene, chọn nhóm và sự kiện đầu ra; yêu cầu kiểm tra đủ từng tầng. Diễn đạt rõ sự kiện đồng thời và xác suất có điều kiện.", "refs": ["55c12f561006|P1|16|None", "55c12f561006|P3|1|None", "2cbdc74db082|P3|5|None"]}], "easy_vs_hard": [{"topic": "Di truyền học quần thể và tự phối", "easy": "Cho cấu trúc xuất phát rõ, áp dụng trực tiếp quy luật giảm dị hợp.", "hard": "Phải suy cơ chế di truyền và thành phần nhóm được chọn rồi tổng hợp đời con theo trọng số.", "easy_refs": ["55c12f561006|P1|2|None"], "hard_refs": ["2cbdc74db082|P3|5|None"]}, {"topic": "Truyền đạt thông tin di truyền", "easy": "Gọi tên khuôn hoặc nhận diện tổ chức dịch mã từ dấu hiệu trực tiếp.", "hard": "Dựng lại sản phẩm qua biến đổi trình tự, giữ đúng chiều đọc, khung đọc và tín hiệu kết thúc.", "easy_refs": ["4b4716b94db4|P1|17|None", "55c12f561006|P2|2|a"], "hard_refs": ["4b4716b94db4|P1|3|None"]}, {"topic": "Nhiễm sắc thể và phân bào", "easy": "Nhớ sự kiện đặc trưng hoặc đếm bản sao theo kí hiệu.", "hard": "Dùng nhãn gene để suy quan hệ tương đồng và kiểm tra cách đọc hình trước khi suy bộ ban đầu; bằng chứng khó có điểm chưa tường minh về phân li.", "easy_refs": ["4b4716b94db4|P1|6|None", "2cbdc74db082|P3|3|None"], "hard_refs": ["2cbdc74db082|P3|2|None"]}, {"topic": "Giới hạn sinh thái", "easy": "Đối chiếu định nghĩa hoặc đọc trực tiếp cận và giá trị trên đồ thị.", "hard": "Kiểm tra sự bao chứa của toàn khoảng điều kiện và bác bỏ ngoại suy thiếu căn cứ.", "easy_refs": ["4b4716b94db4|P1|11|None", "55c12f561006|P2|3|a", "55c12f561006|P2|3|b", "55c12f561006|P2|3|c"], "hard_refs": ["4b4716b94db4|P1|4|None", "55c12f561006|P2|3|d"]}, {"topic": "Tương tác gene", "easy": "Nhận ra các locus cùng tham gia con đường chuyển hóa.", "hard": "Chuyển sơ đồ thành điều kiện kiểu gene, xét ức chế hoặc môi trường rồi tính xác suất hay tìm phép lai phù hợp.", "easy_refs": ["55c12f561006|P2|1|a"], "hard_refs": ["55c12f561006|P2|1|b", "55c12f561006|P2|1|c", "55c12f561006|P2|1|d", "2cbdc74db082|P2|4|a", "2cbdc74db082|P2|4|c"]}, {"topic": "Bằng chứng tiến hóa phân tử", "easy": "Nhận diện loại bằng chứng từ cấp độ dữ liệu.", "hard": "Xác định kết luận được phép rút ra khi các giá trị chỉ so với chung đối tượng mốc.", "easy_refs": ["4b4716b94db4|P1|15|None"], "hard_refs": ["4b4716b94db4|P1|8|None"]}], "fact_use": {"common": [{"use": "Định nghĩa là điểm tựa trực tiếp để gọi tên, phân loại và phân biệt thuật ngữ gần; nhiễu thường giữ cùng trường kiến thức nhưng đổi tiêu chí.", "refs": ["55c12f561006|P1|10|None", "55c12f561006|P1|14|None", "55c12f561006|P1|18|None", "4b4716b94db4|P1|5|None", "4b4716b94db4|P1|9|None", "4b4716b94db4|P1|11|None"]}, {"use": "Kiến thức về cấu trúc, chức năng và sự kiện đặc trưng được nhớ để ghép với dữ kiện; có hàng yêu cầu nhớ kích thước quy ước.", "refs": ["55c12f561006|P1|4|None", "55c12f561006|P1|5|None", "55c12f561006|P1|12|None", "4b4716b94db4|P1|6|None", "4b4716b94db4|P1|14|None", "4b4716b94db4|P1|17|None"]}, {"use": "Tên đối tượng có thể đòi hỏi nhớ nhóm sinh lí hoặc đặc điểm thích nghi rồi mới áp dụng cơ chế; không chỉ đóng vai trò trang trí.", "refs": ["4b4716b94db4|P1|16|None", "2cbdc74db082|P3|6|None"]}, {"use": "Số liệu chủ yếu là đầu vào cho suy luận: tần số, trọng số, kích thước, tọa độ hoặc điều kiện chọn nhóm. Một số bảng tra và nhãn được cung cấp để hỗ trợ thao tác.", "refs": ["55c12f561006|P1|1|None", "55c12f561006|P1|7|None", "55c12f561006|P2|3|b", "55c12f561006|P3|4|None", "55c12f561006|P3|5|None", "4b4716b94db4|P1|3|None", "4b4716b94db4|P1|12|None"]}], "not_observed": [{"use": "Trong các hàng được cung cấp, không thấy yêu cầu nhớ niên đại, tiểu sử hay tên người làm mục tiêu trả lời; nội dung tiến hóa được hỏi bằng cơ chế, khái niệm và quan hệ nhân quả.", "refs": ["55c12f561006|P1|13|None", "55c12f561006|P1|15|None", "55c12f561006|P1|18|None", "4b4716b94db4|P1|1|None", "4b4716b94db4|P1|13|None", "2cbdc74db082|P3|4|None"]}, {"use": "Không thấy việc nhớ nguyên văn lời giải dài là yêu cầu đầu ra; các hàng thể hiện lựa chọn, đánh giá mệnh đề, sắp xếp hoặc trả kết quả ngắn.", "refs": ["55c12f561006|P1|16|None", "55c12f561006|P2|1|c", "55c12f561006|P3|1|None", "2cbdc74db082|P3|4|None", "4b4716b94db4|P1|3|None"]}], "limit": "Các điều không xuất hiện chỉ áp dụng cho tập hàng này; refs minh họa cách sử dụng tri thức thực tế, không chứng minh sự vắng mặt trong các đề ngoài tập."}, "anti_patterns": [{"anti_pattern": "Dựng nhiễu chỉ bằng cách thay từ tùy tiện", "supported_alternative": "Các nhiễu được mô tả có quan hệ với sai lầm nội dung: nhầm vai trò, đảo chiều, bỏ điều kiện, lấy bộ phận thay toàn thể hoặc dùng sai nhóm đại lượng. Có cả nhiễu ngoài cơ chế, nên không mặc định mọi lựa chọn sai đều chẩn đoán được lỗi riêng.", "refs": ["55c12f561006|P1|1|None", "55c12f561006|P1|5|None", "55c12f561006|P1|7|None", "55c12f561006|P1|12|None", "4b4716b94db4|P1|12|None"]}, {"anti_pattern": "Cho câu trả lời mở thiên về ý kiến cá nhân hoặc văn phong", "supported_alternative": "Các nhiệm vụ trong tập hướng tới kết luận kiểm tra được bằng khái niệm, cơ chế, dữ liệu hoặc phép tính; không thấy chấm lập trường cá nhân.", "refs": ["55c12f561006|P1|18|None", "55c12f561006|P2|1|c", "55c12f561006|P3|1|None", "2cbdc74db082|P3|4|None"]}, {"anti_pattern": "Mặc định trả lời ngắn phải là phép tính khó", "supported_alternative": "Dạng trả lời ngắn có cả đếm theo tiêu chí và tính trực tiếp từ bảng; độ khó đến từ chuỗi suy luận chứ không do hình thức trả lời.", "refs": ["2cbdc74db082|P3|3|None", "2cbdc74db082|P3|6|None", "55c12f561006|P3|4|None", "55c12f561006|P3|5|None"]}, {"anti_pattern": "Mặc định hình vẽ hoặc bối cảnh dài đồng nghĩa với phân hóa cao", "supported_alternative": "Hình có thể chỉ cung cấp dấu hiệu định nghĩa; phân hóa cao xuất hiện khi phải khai thác quan hệ ẩn, điều kiện hóa hoặc dựng lại biểu diễn.", "refs": ["55c12f561006|P1|9|None", "55c12f561006|P1|17|None", "55c12f561006|P2|2|a", "2cbdc74db082|P3|2|None", "55c12f561006|P3|1|None"]}, {"anti_pattern": "Biến dữ liệu có phạm vi hẹp thành kết luận phổ quát", "supported_alternative": "Trong các nhiệm vụ đánh giá kết luận, chính việc vượt phạm vi so sánh, bỏ giới hạn chịu đựng hoặc bỏ ngoại lệ là lỗi bị kiểm tra.", "refs": ["4b4716b94db4|P1|8|None", "4b4716b94db4|P1|4|None", "55c12f561006|P2|3|d", "55c12f561006|P2|4|c"]}]}, {"evidence_limit": "Các hàng cho phép nhận diện mô thức chung giữa các đề và những cấu trúc chỉ được quan sát trong một đề. Trường evidence_scope phân biệt hai mức bằng chứng này; các mục single_paper_observation không được xem là mô thức tái diễn giữa các đề. Những điểm thiếu giả thiết hoặc phụ thuộc khóa được giữ lại trong mô tả, không dùng làm dấu hiệu phân hóa chắc chắn.", "patterns": [{"part_kind": "multiple_choice", "topic": "Phân loại khái niệm sinh thái và bằng chứng tiến hóa", "grade": 12, "construction": "Cho dấu hiệu nhận diện, dạng bằng chứng hoặc mục tiêu hoạt động; yêu cầu chọn khái niệm phù hợp hoặc loại hoạt động ngoài phạm vi. Đối chiếu dấu hiệu quyết định với định nghĩa, thay vì dựa vào sự nổi bật của phần dẫn.", "wrong_options": "Dùng khái niệm gần nghĩa, đánh tráo tiêu chí phân loại hoặc thu hẹp phạm vi định nghĩa.", "difficulty_source": "Giữ đúng tiêu chí phân loại giữa các khái niệm liên quan.", "discrimination": "low", "typical_steps": 2, "evidence_scope": "single_paper_observation", "refs": ["61a0198fbfda|P1|1|None", "61a0198fbfda|P1|6|None", "61a0198fbfda|P1|11|None", "61a0198fbfda|P1|12|None"]}, {"part_kind": "multiple_choice", "topic": "Cấu tạo và chức năng của phân tử sinh học", "grade": 10, "construction": "Cho nhóm phân tử và các mô tả thuộc tính; yêu cầu tìm đặc điểm không phù hợp. Nhớ cấu tạo, tính chất và chức năng rồi kiểm tra chiều phủ định của yêu cầu.", "wrong_options": "Các thuộc tính đúng trở thành phương án nhiễu; thuộc tính cần chọn được chuyển từ nhóm đại phân tử khác.", "difficulty_source": "Phân biệt đặc điểm cấu tạo và tránh chọn theo một thuộc tính đúng quen thuộc.", "discrimination": "low", "typical_steps": 2, "evidence_scope": "single_paper_observation", "refs": ["61a0198fbfda|P1|2|None"]}, {"part_kind": "multiple_choice", "topic": "Cơ chế tiến hóa và biến đổi vật chất di truyền", "grade": 12, "construction": "Cho cơ chế hoặc dạng biến đổi; yêu cầu xác định kết quả trực tiếp ở đúng cấp độ. Tách tác động thực sự của cơ chế khỏi kết quả thuộc cơ chế khác hoặc cấp tổ chức khác.", "wrong_options": "Đánh tráo tạo biến dị với sàng lọc biến dị, tăng số bản sao với đổi vị trí, hoặc tổng lượng trong tế bào với lượng trên từng cấu trúc.", "difficulty_source": "Xác định đúng phạm vi tác động và đơn vị được hỏi.", "discrimination": "low", "typical_steps": 2, "evidence_scope": "single_paper_observation", "refs": ["61a0198fbfda|P1|3|None", "61a0198fbfda|P1|5|None"]}, {"part_kind": "multiple_choice", "topic": "Công nghệ gene và điều kiện thực hiện mục tiêu", "grade": 12, "construction": "Cho mục tiêu can thiệp cùng vị trí gene hoặc cấu trúc DNA; yêu cầu chọn phương án đáp ứng các điều kiện đồng thời. Kiểm tra gene hiện diện, khả năng biểu hiện hoặc đường truyền di truyền liên quan. Với di truyền bào quan, giữ rõ phạm vi mô hình được giả định.", "wrong_options": "Chỉ đáp ứng một điều kiện, bỏ qua hướng biểu hiện hoặc đường truyền; có phương án không bảo đảm khả năng sống.", "difficulty_source": "Phân biệt có gene với thực hiện được mục tiêu sinh học.", "discrimination": "medium", "typical_steps": 3, "evidence_scope": "single_paper_observation", "refs": ["61a0198fbfda|P1|4|None", "61a0198fbfda|P1|18|None"]}, {"part_kind": "multiple_choice", "topic": "Cân bằng di truyền quần thể", "grade": 12, "construction": "Cho tần số allele và điều kiện cân bằng; yêu cầu tổng tần số một nhóm kiểu gene. Chuyển tần số allele thành các thành phần kiểu gene rồi cộng đủ các thành phần thuộc nhóm.", "wrong_options": "Lấy riêng một thành phần hoặc chọn thành phần thuộc nhóm đối lập.", "difficulty_source": "Bao quát đúng tập kiểu gene cần tính.", "discrimination": "low", "typical_steps": 2, "evidence_scope": "single_paper_observation", "refs": ["61a0198fbfda|P1|7|None"]}, {"part_kind": "multiple_choice", "topic": "Nhận diện cấu trúc và trạng thái từ hình sinh học", "grade": [10, 12], "construction": "Cho ảnh hoặc sơ đồ có dấu hiệu hình thái hay nhãn giới hạn cấu trúc; yêu cầu gọi tên giai đoạn hoặc thành phần. Quan sát trạng thái, vị trí và ranh giới trước khi đối chiếu kiến thức.", "wrong_options": "Dùng giai đoạn lân cận, cấp đóng gói khác hoặc đánh tráo toàn thể với thành phần.", "difficulty_source": "Đọc đúng dấu hiệu phân biệt trên hình.", "discrimination": "low", "typical_steps": 2, "evidence_scope": "single_paper_observation", "refs": ["61a0198fbfda|P1|8|None", "61a0198fbfda|P1|10|None"]}, {"part_kind": "multiple_choice", "topic": "Nguồn nguyên tử và dạng chất được thực vật sử dụng", "grade": 11, "construction": "Cho sản phẩm hoặc nhu cầu dinh dưỡng cùng các chất chứa nguyên tố liên quan; yêu cầu xác định nguồn hoặc dạng tham gia đúng quá trình. Dùng cơ chế sinh học để phân biệt vai trò của các chất có chung nguyên tố.", "wrong_options": "Chọn theo thành phần nguyên tố, nhầm dạng tồn tại với dạng hấp thụ hoặc nhầm cơ chất của các quá trình khác nhau.", "difficulty_source": "Không suy chức năng chỉ từ việc các chất cùng chứa nguyên tố được xét.", "discrimination": "low", "typical_steps": 2, "evidence_scope": "cross_paper", "refs": ["4b4716b94db4|P1|18|None", "61a0198fbfda|P1|9|None"]}, {"part_kind": "multiple_choice", "topic": "Hình thành loài và lịch sử phân nhánh", "grade": 12, "construction": "Cho sơ đồ biến đổi phân bố và các sự kiện cách li; yêu cầu chọn nhận định về nguồn gốc hoặc cơ chế. Theo dõi từng nhánh, xác định sự kiện hỗ trợ rồi phân biệt điều kiện ngăn dòng gene với tác nhân gây biến đổi.", "wrong_options": "Suy họ hàng từ vị trí gần nhau, gán cùng cơ chế cho mọi nhánh hoặc coi rào cản trực tiếp tạo biến đổi di truyền.", "difficulty_source": "Giữ đúng lịch sử và bằng chứng của từng nhánh.", "discrimination": "medium", "typical_steps": 4, "evidence_scope": "single_paper_observation", "refs": ["61a0198fbfda|P1|13|None"]}, {"part_kind": "multiple_choice", "topic": "Phả hệ kết hợp chỉ thị phân tử", "grade": 12, "construction": "Cho phả hệ, kiểu hình và ảnh điện di tham chiếu; yêu cầu tìm kết luận không phù hợp. Đọc vị trí và độ đậm băng, suy kiểu gene, kiểm tra sự truyền trong gia đình rồi đánh giá nguy cơ sinh sản.", "wrong_options": "Các kết luận được dữ liệu hỗ trợ làm nhiễu; việc loại chúng đòi hỏi đọc đúng băng và nối thông tin phân tử với phả hệ.", "difficulty_source": "Phối hợp nguồn dữ liệu để loại bất định kiểu gene.", "discrimination": "high", "typical_steps": 4, "evidence_scope": "single_paper_observation", "refs": ["61a0198fbfda|P1|14|None"]}, {"part_kind": "multiple_choice", "topic": "Tác động phối hợp của các nhân tố sinh thái", "grade": 12, "construction": "Cho đồ thị sống sót và tăng trưởng dưới các tổ hợp điều kiện; yêu cầu tìm kết luận không được hỗ trợ. Đọc riêng từng chỉ tiêu, so sánh tổ hợp rồi kiểm tra mức cải thiện có thực sự bù đắp hoàn toàn hay không.", "wrong_options": "Các kết luận đúng về loại nhân tố, ngưỡng hoặc xu hướng làm nhiễu trong yêu cầu chọn sai.", "difficulty_source": "Phân biệt cải thiện một phần với phục hồi hoàn toàn; tránh mở rộng chỉ tiêu của loài thành kết luận rộng hơn khi thiếu bằng chứng.", "discrimination": "medium", "typical_steps": 3, "evidence_scope": "single_paper_observation", "refs": ["61a0198fbfda|P1|15|None"]}, {"part_kind": "multiple_choice", "topic": "Kích thước, mật độ và phân bố cá thể", "grade": 12, "construction": "Cho sơ đồ cá thể trên diện tích khảo sát chung; yêu cầu chọn mô tả đặc trưng quần thể. Tách nhóm kí hiệu, đếm cá thể, quan sát khoảng cách rồi liên hệ với tập tính.", "wrong_options": "Suy số lượng hoặc mật độ từ độ trải rộng; gán sai quan hệ sinh học cho kiểu phân bố.", "difficulty_source": "Chuyển biểu diễn không gian thành đúng đại lượng sinh thái.", "discrimination": "medium", "typical_steps": 3, "evidence_scope": "single_paper_observation", "refs": ["61a0198fbfda|P1|16|None"]}, {"part_kind": "multiple_choice", "topic": "Theo dõi chất đánh dấu trong quang hợp", "grade": 11, "construction": "Cho thí nghiệm đánh dấu và đồ thị tín hiệu của các chất chưa gọi tên; yêu cầu ghép đường với vai trò chuyển hóa. Dựng thứ tự chuyển vật chất, phân biệt chất nhận với sản phẩm rồi kiểm tra toàn bộ phép ghép. Không coi điểm thời gian chưa rõ là quy luật chuẩn.", "wrong_options": "Hoán đổi chất ở các vị trí gần nhau hoặc nhầm chất nhận được tái sinh với sản phẩm tích lũy.", "difficulty_source": "Ánh xạ tín hiệu động sang vai trò trong con đường chuyển hóa.", "discrimination": "high", "typical_steps": 4, "evidence_scope": "single_paper_observation", "refs": ["61a0198fbfda|P1|17|None"]}, {"part_kind": "true_false", "topic": "Đọc trực tiếp dấu hiệu trên đồ thị và sơ đồ sinh học", "grade": [11, 12], "construction": "Cho hình có đường biểu diễn, thứ tự xuất hiện hoặc mũi tên; yêu cầu kiểm tra nhận định mô tả trực tiếp. Đọc đúng tọa độ, hình dạng, trình tự hoặc chiều chuyển động rồi đối chiếu phát biểu.", "wrong_options": null, "difficulty_source": "Giữ đúng đối tượng, chú giải và vị trí đang xét.", "discrimination": "low", "typical_steps": 2, "evidence_scope": "cross_paper", "refs": ["4b4716b94db4|P2|1|a", "4b4716b94db4|P2|3|b", "61a0198fbfda|P2|3|a", "61a0198fbfda|P2|4|a"]}, {"part_kind": "true_false", "topic": "Phân biệt chỉ tiêu quan sát với trạng thái sinh học", "grade": [11, 12], "construction": "Cho đại lượng đo hoặc tác động lên một thành phần; yêu cầu kiểm tra trạng thái được suy ra. Xác định chính xác phép đo phản ánh gì, tách các dạng tồn tại hoặc chỉ tiêu khác nhau rồi kiểm tra phép suy. Kết luận về phần hòa tan cần giữ rõ điều kiện vật lí không đổi.", "wrong_options": "Đồng nhất phần không mang chất được đo với phần hoàn toàn tự do, hoặc dùng mức chiếm không gian thay cho số loại loài.", "difficulty_source": "Nhận ra thông tin không được phép đo trực tiếp xác định.", "discrimination": "medium", "typical_steps": 3, "evidence_scope": "cross_paper", "refs": ["4b4716b94db4|P2|1|b", "4b4716b94db4|P2|1|d", "61a0198fbfda|P2|4|c"]}, {"part_kind": "true_false", "topic": "Cơ chế và chiều trao đổi khí", "grade": 11, "construction": "Cho cơ chế liên kết hoặc bố trí dòng trao đổi; yêu cầu đánh giá hệ quả sinh lí. Xác định tác động trực tiếp, chiều trao đổi và điều kiện duy trì khuếch tán; kiểm tra mục tiêu nêu trong phát biểu có phù hợp cơ chế hay không.", "wrong_options": "Đảo chiều trao đổi hoặc ghép bố trí có ích với mục tiêu làm mất chênh lệch thúc đẩy trao đổi.", "difficulty_source": "Phân biệt mô tả cấu trúc với giải thích chức năng và điều kiện hoạt động.", "discrimination": "medium", "typical_steps": 3, "evidence_scope": "cross_paper", "refs": ["4b4716b94db4|P2|1|c", "61a0198fbfda|P2|3|b", "61a0198fbfda|P2|3|c", "61a0198fbfda|P2|3|d"]}, {"part_kind": "true_false", "topic": "Suy ngược phép lai từ cấu trúc đời con", "grade": 12, "construction": "Cho số lớp hoặc quan hệ tỉ lệ kiểu gene và kiểu hình; yêu cầu kiểm tra khả năng kiểu gene bố mẹ. Tách điều kiện tại từng locus, xét giao tử, kiểm tra việc gộp kiểu gene thành kiểu hình rồi đối chiếu toàn bộ ràng buộc.", "wrong_options": "Nhận dạng tỉ lệ quen thuộc nhưng bỏ qua phép lai thành phần hoặc điều kiện gộp kiểu hình.", "difficulty_source": "Thỏa đồng thời các điều kiện thay vì khớp riêng một dấu hiệu.", "discrimination": "high", "typical_steps": 3, "evidence_scope": "single_paper_observation", "refs": ["4b4716b94db4|P2|2|a", "4b4716b94db4|P2|2|b"]}, {"part_kind": "true_false", "topic": "Kiểm tra khẳng định tất yếu khi kiểu gene chưa xác định", "grade": 12, "construction": "Cho kiểu hình hoặc cấu trúc phân li chưa xác định duy nhất phép lai; yêu cầu đánh giá kết luận bắt buộc hay xác suất cố định. Liệt kê khả năng còn phù hợp, dựng trường hợp kiểm tra và tìm phản ví dụ hoặc chứng minh dữ kiện chưa đủ.", "wrong_options": "Đồng nhất kiểu hình với kiểu gene, suy tỉ lệ từ số lớp hoặc tự bổ sung giả thiết dị hợp.", "difficulty_source": "Chuyển từ giải phép lai quen thuộc sang kiểm tra tính tất yếu của kết luận.", "discrimination": "high", "typical_steps": 4, "evidence_scope": "cross_paper", "refs": ["4b4716b94db4|P2|2|c", "61a0198fbfda|P2|2|b", "61a0198fbfda|P2|2|c"]}, {"part_kind": "true_false", "topic": "Đếm kiểu gene có xét pha liên kết", "grade": 12, "construction": "Cho giới hạn số lớp đời con; yêu cầu kiểm tra khả năng đạt cực đại của nhóm kiểu gene có biểu hiện yêu cầu. Liệt kê tổ hợp haplotype, phân biệt pha liên kết, kiểm tra tổng số lớp rồi đếm nhóm đích.", "wrong_options": null, "difficulty_source": "Không được gộp các cấu hình khác pha khi quy ước đếm của bài phân biệt chúng.", "discrimination": "high", "typical_steps": 4, "evidence_scope": "single_paper_observation", "refs": ["4b4716b94db4|P2|2|d"]}, {"part_kind": "true_false", "topic": "Giới hạn kết luận từ đồ thị sinh thái", "grade": 12, "construction": "Cho đồ thị nhiều đối tượng hoặc chuỗi quan sát hữu hạn; yêu cầu kiểm tra kết luận khái quát. Xác định đối tượng của đường tham chiếu, loại bằng chứng đang có và xu hướng từng đường trước khi chấp nhận kết luận về vai trò hoặc trạng thái.", "wrong_options": "Chuyển tham số sang đối tượng khác, suy vai trò nhân quả từ mức xuất hiện hoặc coi kết thúc quan sát là ổn định.", "difficulty_source": "Giữ kết luận trong phạm vi dữ liệu thực sự hỗ trợ.", "discrimination": "medium", "typical_steps": 3, "evidence_scope": "cross_paper", "refs": ["4b4716b94db4|P2|3|a", "61a0198fbfda|P2|4|b", "61a0198fbfda|P2|4|d"]}, {"part_kind": "true_false", "topic": "Quản lí quần thể thông qua nguồn sống", "grade": 12, "construction": "Cho biện pháp tác động nơi cư trú; yêu cầu dự đoán chiều thay đổi quần thể. Nối nguồn lực bị giảm với sức chứa môi trường rồi suy hệ quả dự kiến. Không biến dự đoán theo mô hình thành hiệu quả thực địa đã đo.", "wrong_options": null, "difficulty_source": "Nối can thiệp với biến trung gian sinh thái.", "discrimination": "medium", "typical_steps": 3, "evidence_scope": "single_paper_observation", "refs": ["4b4716b94db4|P2|3|c"]}, {"part_kind": "true_false", "topic": "Tốc độ tăng trưởng và điểm uốn", "grade": 12, "construction": "Cho đường tăng trưởng có vị trí đánh dấu; yêu cầu đánh giá phát biểu ghép về tốc độ và cơ chế giới hạn. Đọc độ dốc, phân biệt tốc độ tổng với tốc độ trên cá thể rồi kiểm tra ý nghĩa toán học của quan hệ được gọi tên.", "wrong_options": "Coi điểm uốn là lúc giới hạn mới tác động hoặc đồng nhất xu hướng giảm với tỉ lệ nghịch.", "difficulty_source": "Tách đại lượng, tốc độ biến đổi và cơ chế điều hòa.", "discrimination": "high", "typical_steps": 4, "evidence_scope": "single_paper_observation", "refs": ["4b4716b94db4|P2|3|d"]}, {"part_kind": "true_false", "topic": "Bảo toàn tổng thành phần phân tử", "grade": 10, "construction": "Cho bảng có tổng và thành phần thiếu; yêu cầu kiểm tra giá trị đề xuất. Chọn đúng hàng, trừ các thành phần đã biết rồi đối chiếu.", "wrong_options": "Giá trị sai gần kết quả đúng; dữ liệu không đủ quy lỗi cho thao tác số học cụ thể hơn.", "difficulty_source": "Kiểm tra đầy đủ tổng thành phần.", "discrimination": "low", "typical_steps": 3, "evidence_scope": "single_paper_observation", "refs": ["4b4716b94db4|P2|4|a"]}, {"part_kind": "true_false", "topic": "Suy nhóm phân tử và vị trí từ thành phần", "grade": 10, "construction": "Cho loại đơn phân hoặc thành phần base; yêu cầu đánh giá chức năng hay vị trí có thể có. Nhận diện nhóm phân tử, kiểm tra dấu hiệu cấu trúc rồi nối với kiến thức chức năng và tế bào.", "wrong_options": "Gán chức năng di truyền cho đại phân tử không phù hợp với bản chất đơn phân.", "difficulty_source": "Dùng thành phần để suy bản chất trước khi suy chức năng hoặc vị trí.", "discrimination": "medium", "typical_steps": 3, "evidence_scope": "single_paper_observation", "refs": ["4b4716b94db4|P2|4|b", "4b4716b94db4|P2|4|c"]}, {"part_kind": "true_false", "topic": "Điều kiện của chiều truyền thông tin di truyền", "grade": 12, "construction": "Cho các nucleic acid được nhận diện từ thành phần; yêu cầu đánh giá khả năng tạo thành phân tử. Xác định chiều truyền thông tin và điều kiện cơ chế cần có. Hàng này chưa nêu đủ giới hạn để loại trừ chắc cơ chế đặc biệt.", "wrong_options": "Khóa bác bỏ việc chuyển khả năng của cơ chế đặc biệt sang bối cảnh chưa nêu điều kiện; chưa đủ cơ sở gán một ngộ nhận xác định.", "difficulty_source": "Phụ thuộc giới hạn cơ chế chưa được phát biểu rõ; không xem đây là bằng chứng phân hóa đã xác lập.", "discrimination": "medium", "typical_steps": 3, "evidence_scope": "single_paper_observation", "refs": ["4b4716b94db4|P2|4|d"]}, {"part_kind": "true_false", "topic": "Suy hệ quả trực tiếp trong di truyền y học", "grade": 12, "construction": "Cho vị trí gene hoặc quy tắc biểu hiện bệnh; yêu cầu đánh giá phân loại di truyền hay vai trò sàng lọc. Đối chiếu định nghĩa và nhận ra kiểu hình bình thường có thể không loại trừ allele bệnh. Không suy mức hiệu quả vượt trội khi thiếu so sánh.", "wrong_options": "Suy quy luật di truyền từ giới của người bệnh thay cho vị trí gene đã cho.", "difficulty_source": "Dùng thông tin quyết định thay cho dấu hiệu bề ngoài.", "discrimination": "low", "typical_steps": 2, "evidence_scope": "single_paper_observation", "refs": ["61a0198fbfda|P2|1|a", "61a0198fbfda|P2|1|c"]}, {"part_kind": "true_false", "topic": "Định vị biến đổi nucleotide trong phát biểu ghép", "grade": 12, "construction": "Cho hướng thay thế, sản phẩm bộ ba và thông tin kiểu hình; yêu cầu kiểm tra nhận định ghép. Suy ngược bằng bổ sung, xác định nucleotide thay đổi, đối chiếu cách đánh vị trí rồi kiểm tra riêng vế về tính trội lặn.", "wrong_options": "Ghép kết luận đúng về biểu hiện bệnh với vị trí biến đổi sai.", "difficulty_source": "Không chấp nhận toàn phát biểu chỉ vì một vế đúng.", "discrimination": "medium", "typical_steps": 4, "evidence_scope": "single_paper_observation", "refs": ["61a0198fbfda|P2|1|b"]}, {"part_kind": "true_false", "topic": "Nguyên liệu phiên mã của các allele", "grade": 12, "construction": "Cho biến đổi allele và số lượt phiên mã; yêu cầu kiểm tra tổng nguyên liệu. Suy sản phẩm từng allele, đếm thành phần cần xét, nhân theo lượt rồi cộng đóng góp.", "wrong_options": null, "difficulty_source": "Tách đúng sản phẩm của từng allele trước khi tổng hợp.", "discrimination": "medium", "typical_steps": 3, "evidence_scope": "single_paper_observation", "refs": ["61a0198fbfda|P2|1|d"]}, {"part_kind": "true_false", "topic": "Gene, enzyme và điều kiện tạo kiểu hình", "grade": 12, "construction": "Cho sơ đồ chuyển hóa và quy tắc kiểu hình; yêu cầu kiểm tra hệ quả của gián đoạn. Theo dõi điều kiện tạo sản phẩm cuối rồi đối chiếu quy ước biểu hiện.", "wrong_options": null, "difficulty_source": "Đọc đầy đủ điều kiện hoạt động của con đường.", "discrimination": "low", "typical_steps": 2, "evidence_scope": "single_paper_observation", "refs": ["61a0198fbfda|P2|2|a"]}, {"part_kind": "true_false", "topic": "Xác suất có điều kiện trong bệnh do tương tác gene", "grade": 12, "construction": "Cho kiểu hình của người cần xét và người thân; yêu cầu kiểm tra nguy cơ ở đời con. Suy phân bố kiểu gene có điều kiện tại từng locus, tính khả năng đủ chức năng đồng thời rồi chuyển sang biến cố cần tìm.", "wrong_options": "Dùng xác suất bình thường làm xác suất bệnh.", "difficulty_source": "Kết hợp bất định kiểu gene, tính độc lập và biến cố đối.", "discrimination": "high", "typical_steps": 5, "evidence_scope": "single_paper_observation", "refs": ["61a0198fbfda|P2|2|d"]}, {"part_kind": "short_answer", "topic": "Đặc điểm thừa hưởng trên cây phát sinh", "grade": 12, "construction": "Cho cây có đặc điểm gắn trên nhánh; yêu cầu xuất mã đặc điểm của đối tượng đích. Lần theo đường tổ tiên, thu đặc điểm đúng nhánh rồi sắp mã theo quy cách.", "wrong_options": null, "difficulty_source": "Theo quan hệ tổ tiên thay vì vị trí gần nhau trên hình.", "discrimination": "medium", "typical_steps": 4, "evidence_scope": "single_paper_observation", "refs": ["4b4716b94db4|P3|1|None"]}, {"part_kind": "short_answer", "topic": "Diễn giải hình dạng tháp sinh khối", "grade": 12, "construction": "Cho các tháp và yêu cầu sắp thứ tự theo một thuộc tính hệ sinh thái. Đọc tương quan giữa các bậc rồi áp dụng quy ước suy luận của khóa. Hình dạng và sinh khối tức thời chưa đủ tự xác lập ổn định thực tế.", "wrong_options": null, "difficulty_source": "Quy ước nối hình dạng tháp với thuộc tính cần xếp chưa được nêu đủ; không xem mức phân hóa là chắc chắn.", "discrimination": "medium", "typical_steps": 4, "evidence_scope": "single_paper_observation", "refs": ["4b4716b94db4|P3|2|None"]}, {"part_kind": "short_answer", "topic": "Suy quan hệ sinh thái từ thí nghiệm loại bỏ", "grade": 12, "construction": "Cho quan hệ dinh dưỡng và đồ thị giữa các điều kiện can thiệp; yêu cầu chọn nhận định được hỗ trợ. Ghép đúng chú giải, so sánh cùng đối tượng giữa điều kiện, dựng chuỗi tác động trực tiếp và gián tiếp rồi tổng hợp mã trả lời.", "wrong_options": "Suy thích nghi từ biến động mô tả, đảo đối tượng chịu tác động hoặc đồng nhất ổn định với tổng số cá thể cực đại.", "difficulty_source": "Tách tác động trực tiếp khỏi tác động qua cạnh tranh và kiểm tra thang đo trước khi tổng hợp.", "discrimination": "high", "typical_steps": 5, "evidence_scope": "cross_paper", "refs": ["4b4716b94db4|P3|3|None", "61a0198fbfda|P3|2|None"]}, {"part_kind": "short_answer", "topic": "Tần số đồng hợp trong quần thể cân bằng", "grade": 12, "construction": "Cho tần số một phần các allele và quan hệ giữa phần còn lại; yêu cầu tổng tần số đồng hợp. Hoàn thiện phân bố allele, tính thành phần đồng hợp rồi cộng và đổi đơn vị.", "wrong_options": null, "difficulty_source": "Hoàn thiện dữ kiện allele trước khi áp dụng mô hình cân bằng.", "discrimination": "medium", "typical_steps": 4, "evidence_scope": "single_paper_observation", "refs": ["4b4716b94db4|P3|4|None"]}, {"part_kind": "short_answer", "topic": "Đếm nguyên liệu khởi đầu tái bản", "grade": 12, "construction": "Cho cấu trúc các đơn vị tái bản và đoạn tổng hợp gián đoạn; yêu cầu tổng số mồi. Gắn mồi với từng đoạn cần khởi đầu, bổ sung phần của mạch liên tục rồi cộng toàn phân tử.", "wrong_options": null, "difficulty_source": "Không bỏ sót nhu cầu khởi đầu trên mạch liên tục.", "discrimination": "medium", "typical_steps": 3, "evidence_scope": "single_paper_observation", "refs": ["4b4716b94db4|P3|5|None"]}, {"part_kind": "short_answer", "topic": "Phả hệ kết hợp phân bố kiểu gene quần thể", "grade": 12, "construction": "Cho phả hệ, quy tắc biểu hiện phụ thuộc giới và dữ liệu quần thể của người phối ngẫu; yêu cầu xác suất đời con. Suy trọng số kiểu gene từ gia đình, điều kiện hóa phân bố người phối ngẫu rồi kết hợp xác suất truyền và giới. Giữ rõ giả định cơ cấu giới và phân bố allele.", "wrong_options": null, "difficulty_source": "Phối hợp các nguồn bất định kiểu gene với quy tắc biểu hiện theo giới.", "discrimination": "high", "typical_steps": 5, "evidence_scope": "single_paper_observation", "refs": ["4b4716b94db4|P3|6|None"]}, {"part_kind": "short_answer", "topic": "Tần số allele từ điện di", "grade": 12, "construction": "Cho ảnh băng của các cá thể; yêu cầu tần số allele trong mẫu. Đổi tổ hợp băng thành kiểu gene, đếm bản sao allele rồi chia cho tổng bản sao locus và làm tròn.", "wrong_options": null, "difficulty_source": "Phân biệt số loại băng với số bản sao allele ở cá thể đồng hợp.", "discrimination": "medium", "typical_steps": 4, "evidence_scope": "single_paper_observation", "refs": ["61a0198fbfda|P3|1|None"]}, {"part_kind": "short_answer", "topic": "Ổ sinh thái dinh dưỡng và biến đổi nguồn sống", "grade": 12, "construction": "Cho bảng đặc điểm kiếm ăn và nguồn thức ăn cùng biến đổi môi trường; yêu cầu xác định nhóm chịu tác động trực tiếp. Xác định tài nguyên bị giảm rồi ghép với nhóm sử dụng.", "wrong_options": null, "difficulty_source": "Chọn quan hệ tài nguyên trực tiếp từ bảng.", "discrimination": "low", "typical_steps": 2, "evidence_scope": "single_paper_observation", "refs": ["61a0198fbfda|P3|3|None"]}, {"part_kind": "short_answer", "topic": "Liên kết gene kết hợp môi trường và chọn nhóm bố mẹ", "grade": 12, "construction": "Cho bảng biểu hiện theo môi trường, dữ liệu đời con và nhóm được chọn sinh sản; yêu cầu giá trị tối thiểu ở đời sau. Đổi kiểu hình thành điều kiện kiểu gene, suy ràng buộc liên kết, xét pha còn phù hợp, tính giao tử trong nhóm đã chọn rồi so sánh kết quả khi đổi môi trường.", "wrong_options": null, "difficulty_source": "Giữ điều kiện chọn mẫu sinh sản qua các thế hệ và tối ưu trên các cấu hình còn hợp lệ.", "discrimination": "high", "typical_steps": 6, "evidence_scope": "single_paper_observation", "refs": ["61a0198fbfda|P3|4|None"]}, {"part_kind": "short_answer", "topic": "Quy nguyên nhân biến đổi tần số allele", "grade": 12, "construction": "Cho chuỗi tần số allele và biến cố quần thể; yêu cầu chọn nhân tố trực tiếp. Đối chiếu dấu hiệu của các cơ chế và kiểm tra thông tin sống sót, di chuyển, tái lập quần thể. Hàng này thiếu dữ kiện để xác lập duy nhất cơ chế mà khóa chọn.", "wrong_options": "Có lựa chọn nhầm biến đổi tần số với phát sinh allele hoặc nhầm giao phối với thay đổi tần số allele; việc loại các cơ chế khác chưa được giải thích chắc bằng dữ kiện.", "difficulty_source": "Thiếu thông tin phân biệt các nguyên nhân; không xem độ khó do thiếu giả thiết là phân hóa đã xác lập.", "discrimination": "medium", "typical_steps": 4, "evidence_scope": "single_paper_observation", "refs": ["61a0198fbfda|P3|5|None"]}, {"part_kind": "short_answer", "topic": "Vị trí và thời điểm truyền thông tin di truyền", "grade": 12, "construction": "Cho hình phối hợp phiên mã và dịch mã cùng vị trí can thiệp trên DNA; yêu cầu chọn các nhận định đúng. Xác định chiều tổng hợp, mạch khuôn và tổ chức tế bào; theo dõi phần thông tin đã truyền để phân biệt sản phẩm hiện tại với lượt biểu hiện về sau.", "wrong_options": "Áp dụng tổ chức tế bào không phù hợp hoặc cho rằng biến đổi DNA lập tức sửa RNA đã hình thành.", "difficulty_source": "Theo dõi đồng thời vị trí, chiều và thời điểm của các quá trình.", "discrimination": "high", "typical_steps": 6, "evidence_scope": "single_paper_observation", "refs": ["61a0198fbfda|P3|6|None"]}], "discrimination_moves": [{"move": "Buộc thỏa đồng thời các ràng buộc", "how_to_apply": "Cho các điều kiện cùng giới hạn lời giải; yêu cầu kiểm tra cả cấu trúc, phép gộp và nhóm kết quả thay vì khớp riêng dấu hiệu quen thuộc.", "refs": ["4b4716b94db4|P2|2|a", "4b4716b94db4|P2|2|d", "61a0198fbfda|P3|4|None"]}, {"move": "Kiểm tra khẳng định bằng phản ví dụ", "how_to_apply": "Đặt kết luận có tính bắt buộc trên dữ kiện còn cho phép các cấu hình khác nhau; người làm phải dựng trường hợp hợp lệ để kiểm tra tính phổ quát. Bằng chứng trực tiếp cho thao tác này chỉ nằm trong một đề.", "refs": ["4b4716b94db4|P2|2|c"]}, {"move": "Phối hợp các nguồn bằng chứng để xử lí bất định kiểu gene", "how_to_apply": "Kết hợp thông tin gia đình với dữ liệu phân tử hoặc quần thể; yêu cầu suy kiểu gene hay trọng số kiểu gene trước khi tính hệ quả.", "refs": ["61a0198fbfda|P1|14|None", "4b4716b94db4|P3|6|None", "61a0198fbfda|P2|2|d"]}, {"move": "Tách tác động trực tiếp và gián tiếp", "how_to_apply": "Dùng can thiệp và quan hệ giữa các thành phần để buộc người làm theo dõi chuỗi tác động, thay vì gán mọi biến đổi cho tác động trực tiếp.", "refs": ["4b4716b94db4|P3|3|None"]}, {"move": "Chuyển biểu diễn thành cơ chế", "how_to_apply": "Cho đường cong hoặc tín hiệu động; yêu cầu suy tốc độ, vai trò chuyển hóa hoặc cơ chế thay vì chỉ đọc giá trị.", "refs": ["4b4716b94db4|P2|3|d", "61a0198fbfda|P1|17|None"]}, {"move": "Điều kiện hóa trước khi tổ hợp xác suất", "how_to_apply": "Dùng thông tin kiểu hình, gia đình hoặc nhóm được chọn để thay đổi phân bố khả năng; chỉ cho phép tính xác suất đời sau sau khi cập nhật đúng phân bố này.", "refs": ["4b4716b94db4|P3|6|None", "61a0198fbfda|P2|2|d", "61a0198fbfda|P3|4|None"]}, {"move": "Theo dõi trạng thái thông tin qua thời gian", "how_to_apply": "Đặt can thiệp trong quá trình đang diễn ra; yêu cầu phân biệt phần thông tin đã truyền với phần còn có thể chịu tác động. Đây là quan sát riêng của một đề.", "refs": ["61a0198fbfda|P3|6|None"]}], "easy_vs_hard": [{"topic": "Quang hợp", "easy": "Nhận biết nguồn nguyên tử bằng cơ chế đã học.", "hard": "Dùng tín hiệu biến thiên để suy vị trí và vai trò của chất trong con đường chuyển hóa.", "easy_refs": ["4b4716b94db4|P1|18|None"], "hard_refs": ["61a0198fbfda|P1|17|None"]}, {"topic": "Tăng trưởng quần thể", "easy": "Ghép hình dạng đường cong với mô hình tăng trưởng.", "hard": "Phân biệt kích thước, độ dốc, tốc độ tăng và thời điểm tác động của giới hạn.", "easy_refs": ["4b4716b94db4|P2|3|b"], "hard_refs": ["4b4716b94db4|P2|3|d"]}, {"topic": "Di truyền quần thể", "easy": "Tính nhóm kiểu gene trực tiếp từ tần số allele đã cho.", "hard": "Suy phân bố có điều kiện từ quần thể rồi phối hợp bất định kiểu gene trong gia đình.", "easy_refs": ["61a0198fbfda|P1|7|None"], "hard_refs": ["4b4716b94db4|P3|6|None"]}, {"topic": "Tương tác gene qua chuyển hóa", "easy": "Đối chiếu gián đoạn con đường với quy tắc kiểu hình được cung cấp.", "hard": "Suy kiểu gene từ người thân, điều kiện hóa và kết hợp khả năng đủ chức năng trước khi lấy biến cố đối.", "easy_refs": ["61a0198fbfda|P2|2|a"], "hard_refs": ["61a0198fbfda|P2|2|d"]}, {"topic": "Vai trò của loài trong quần xã", "easy": "Dùng dấu hiệu nhận diện để chọn khái niệm.", "hard": "Dùng thí nghiệm can thiệp để phân biệt tác động trực tiếp và hệ quả qua quan hệ giữa các loài.", "easy_refs": ["61a0198fbfda|P1|1|None"], "hard_refs": ["4b4716b94db4|P3|3|None"]}, {"topic": "Truyền thông tin di truyền", "easy": "Từ sản phẩm của từng allele tính lượng nguyên liệu cần dùng.", "hard": "Theo dõi chiều và thời điểm tổng hợp để đánh giá tác động lên sản phẩm hiện tại và tương lai.", "easy_refs": ["61a0198fbfda|P2|1|d"], "hard_refs": ["61a0198fbfda|P3|6|None"]}], "fact_use": {"common": [{"use": "Định nghĩa và đặc điểm chuẩn làm tiêu chí phân loại; nhiễu thường thay tiêu chí bằng dấu hiệu gần nghĩa.", "refs": ["61a0198fbfda|P1|1|None", "61a0198fbfda|P1|6|None", "61a0198fbfda|P2|4|c", "4b4716b94db4|P2|4|b"]}, {"use": "Kiến thức cơ chế làm cầu nối từ dữ kiện đến kết luận, như nguồn vật chất, chiều trao đổi và điều kiện biểu hiện.", "refs": ["4b4716b94db4|P1|18|None", "61a0198fbfda|P1|9|None", "61a0198fbfda|P1|18|None", "61a0198fbfda|P2|3|d"]}, {"use": "Quan hệ định lượng đã học được áp dụng sau khi xác định đúng nhóm, đơn vị đếm hoặc điều kiện của mô hình.", "refs": ["61a0198fbfda|P1|7|None", "4b4716b94db4|P3|4|None", "4b4716b94db4|P3|5|None", "61a0198fbfda|P3|1|None"]}, {"use": "Tên cấu trúc, phân tử và quá trình gắn với dấu hiệu hình hoặc chức năng; không chỉ kiểm tra khả năng nhận mặt thuật ngữ.", "refs": ["61a0198fbfda|P1|8|None", "61a0198fbfda|P1|10|None", "4b4716b94db4|P2|4|c", "61a0198fbfda|P3|6|None"]}], "not_observed": [{"observation": "Không thấy yêu cầu nhớ mốc lịch sử, tiểu sử hoặc tên riêng ngoài vai trò khái niệm sinh học. Đây là giới hạn quan sát của tập hàng, không phải khẳng định cho toàn bộ đề cùng loại.", "refs": ["61a0198fbfda|P1|3|None", "61a0198fbfda|P1|6|None", "4b4716b94db4|P3|1|None"]}, {"observation": "Trong các hàng định lượng được cung cấp, dữ kiện khảo sát hoặc tham số phép tính được cho để xử lí; không thấy yêu cầu nhớ nguyên giá trị của một khảo sát bên ngoài.", "refs": ["4b4716b94db4|P2|4|a", "4b4716b94db4|P3|4|None", "61a0198fbfda|P3|1|None", "61a0198fbfda|P3|4|None"]}, {"observation": "Ở các hàng phân hóa cao, thuộc tên thuật ngữ chưa đủ; người làm còn phải phối hợp dữ kiện, kiểm tra ràng buộc hoặc theo dõi cơ chế.", "refs": ["4b4716b94db4|P2|2|a", "61a0198fbfda|P1|14|None", "61a0198fbfda|P3|6|None"]}]}, "anti_patterns": [{"avoid": "Thay bài nhận diện khái niệm bằng câu đố về tên riêng hoặc mốc lịch sử.", "basis": "Các hàng nhận diện dùng dấu hiệu định nghĩa, cấu trúc hoặc cơ chế; không cung cấp bằng chứng cho kiểu hỏi đố này.", "refs": ["61a0198fbfda|P1|1|None", "61a0198fbfda|P1|6|None", "61a0198fbfda|P1|10|None"]}, {"avoid": "Gọi một bài là khó chỉ vì cần thuộc thuật ngữ hiếm.", "basis": "Độ phân hóa cao được mô tả bằng chuỗi suy luận, phối hợp nguồn dữ liệu và ràng buộc.", "refs": ["4b4716b94db4|P3|6|None", "61a0198fbfda|P1|14|None", "61a0198fbfda|P3|4|None"]}, {"avoid": "Viết nhiễu tùy tiện không liên hệ với lỗi nhận thức.", "basis": "Những nhiễu giải thích được thường đánh vào nhầm cấp độ, vai trò, chiều tác động hoặc bỏ sót điều kiện. Không đủ bằng chứng khẳng định mọi nhiễu trong tập đều đạt tiêu chí này.", "refs": ["61a0198fbfda|P1|5|None", "61a0198fbfda|P1|18|None", "4b4716b94db4|P2|1|b", "61a0198fbfda|P2|2|d"]}, {"avoid": "Dùng hình làm trang trí cho bài vốn chỉ cần thuộc lòng.", "basis": "Các cấu trúc khai thác hình yêu cầu đọc vị trí, chú giải, quan hệ nhánh, chiều hoặc biến thiên để ra kết luận.", "refs": ["4b4716b94db4|P3|1|None", "4b4716b94db4|P3|3|None", "61a0198fbfda|P1|17|None", "61a0198fbfda|P3|6|None"]}, {"avoid": "Tự đổi câu trả lời ngắn thành bài luận mở hoặc yêu cầu trình bày quan điểm.", "basis": "Các hàng trả lời ngắn yêu cầu kết quả định lượng, mã lựa chọn hoặc thứ tự xác định.", "refs": ["4b4716b94db4|P3|1|None", "4b4716b94db4|P3|4|None", "61a0198fbfda|P3|2|None", "61a0198fbfda|P3|4|None"]}]}]
