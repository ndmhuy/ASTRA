arit thập phân của tích giữa một hằng số dạng lũy thừa của cơ số và một biến dương.", "task": "Chọn biểu thức tương đương.", "reasoning": ["Tách lôgarit của tích thành tổng các lôgarit.", "Tính lôgarit của thừa số cố định rồi đối chiếu."], "combines": ["Quy tắc lôgarit", "Lũy thừa"], "cue_use": "needed in reasoning", "evidence_uncertainty": "Thiếu khóa đáp án được xác nhận; không xác định lựa chọn nào là nhiễu."}, {"ref": "85efdd1a7e54|P1|3|None", "part": "P1", "idx": 3, "sub": null, "topic": "Mẫu số liệu ghép nhóm: xác định nhóm chứa tứ phân vị", "grade": 11, "given": "Bảng các khoảng giá trị và tần số tương ứng.", "task": "Xác định nhóm chứa tứ phân vị dưới rồi cộng hai đầu mút của nhóm.", "reasoning": ["Cộng tần số để xác định cỡ mẫu.", "Xác định vị trí của tứ phân vị dưới.", "Dùng tần số tích lũy để tìm nhóm chứa vị trí đó.", "Cộng hai đầu mút của nhóm."], "combines": ["Tứ phân vị của mẫu ghép nhóm", "Tần số tích lũy"], "cue_use": "needed in reasoning", "evidence_uncertainty": "Thiếu khóa đáp án được xác nhận; không phân loại từng phương án."}, {"ref": "85efdd1a7e54|P1|4|None", "part": "P1", "idx": 4, "sub": null, "topic": "Tính đơn điệu và cực trị của hàm số: đọc bảng biến thiên", "grade": 12, "given": "Bảng biến thiên hiển thị dấu đạo hàm, các điểm dừng và giá trị hàm tại đó.", "task": "Đọc giá trị cực đại của hàm số.", "reasoning": ["Tìm vị trí đạo hàm chuyển từ dương sang âm.", "Đọc giá trị hàm tương ứng, phân biệt với hoành độ."], "combines": ["Dấu đạo hàm", "Cực trị hàm số"], "cue_use": "needed in reasoning", "evidence_uncertainty": "Bảng biến thiên đọc được trên ảnh; thiếu khóa hợp lệ để phân loại phương án."}, {"ref": "85efdd1a7e54|P1|5|None", "part": "P1", "idx": 5, "sub": null, "topic": "Đường thẳng và mặt phẳng song song", "grade": 11, "given": "Một tứ diện và đoạn nối trung điểm của hai cạnh cùng thuộc một mặt.", "task": "Chọn mặt phẳng song song với đường thẳng chứa đoạn trung điểm.", "reasoning": ["Dùng định lý đường trung bình để tìm một cạnh song song với đoạn đã cho.", "Xác định mặt phẳng chứa cạnh đó và không chứa đường thẳng cần xét.", "Áp dụng điều kiện đường thẳng song song với mặt phẳng."], "combines": ["Đường trung bình của tam giác", "Quan hệ song song trong không gian"], "cue_use": "given as a cue", "evidence_uncertainty": "Thiếu khóa đáp án được xác nhận; các cơ chế nhiễu chỉ được mô tả ở mức cấu trúc."}, {"ref": "85efdd1a7e54|P1|6|None", "part": "P1", "idx": 6, "sub": null, "topic": "Cấp số cộng: công sai từ số hạng tổng quát", "grade": 11, "given": "Số hạng tổng quát của một cấp số cộng là biểu thức bậc nhất theo chỉ số.", "task": "Xác định công sai.", "reasoning": ["Lấy hiệu hai số hạng liên tiếp hoặc nhận hệ số của chỉ số.", "Đối chiếu giá trị với các lựa chọn."], "combines": ["Cấp số cộng"], "cue_use": "needed in reasoning", "evidence_uncertainty": "Thiếu khóa đáp án được xác nhận."}, {"ref": "85efdd1a7e54|P1|7|None", "part": "P1", "idx": 7, "sub": null, "topic": "Phương trình mặt phẳng qua một điểm và có vectơ pháp tuyến", "grade": 12, "given": "Tọa độ hai điểm xác định một đường thẳng và một điểm mà mặt phẳng phải đi qua.", "task": "Chọn phương trình mặt phẳng vuông góc với đường thẳng đã xác định.", "reasoning": ["Tính vectơ nối hai điểm để làm vectơ pháp tuyến.", "Viết phương trình mặt phẳng qua điểm được chỉ định.", "Khai triển và đối chiếu."], "combines": ["Tọa độ vectơ", "Phương trình mặt phẳng"], "cue_use": "needed in reasoning", "evidence_uncertainty": "Thiếu khóa đáp án được xác nhận."}, {"ref": "85efdd1a7e54|P1|8|None", "part": "P1", "idx": 8, "sub": null, "topic": "Phương trình lượng giác cơ bản", "grade": 11, "given": "Một phương trình lượng giác cơ bản và các họ nghiệm đề xuất.", "task": "Chọn họ nghiệm đầy đủ.", "reasoning": ["Xác định các vị trí góc thỏa mãn phương trình trên đường tròn lượng giác.", "Biểu diễn toàn bộ nghiệm bằng một họ tuần hoàn và đối chiếu."], "combines": ["Đường tròn lượng giác", "Phương trình lượng giác"], "cue_use": "needed in reasoning", "evidence_uncertainty": "Thiếu khóa đáp án được xác nhận."}, {"ref": "85efdd1a7e54|P1|9|None", "part": "P1", "idx": 9, "sub": null, "topic": "Bất phương trình mũ: cơ số nhỏ hơn đơn vị", "grade": 11, "given": "Một bất phương trình mũ và một đoạn giới hạn các giá trị nguyên cần xét.", "task": "Đếm nghiệm nguyên trong đoạn.", "reasoning": ["Đưa hai vế về cùng cơ số.", "Dùng tính nghịch biến để chuyển thành bất phương trình theo số mũ.", "Giao miền nghiệm với đoạn đã cho.", "Đếm các số nguyên, kiểm tra đầu mút."], "combines": ["Bất phương trình mũ", "Đếm số nguyên trong đoạn"], "cue_use": "needed in reasoning", "evidence_uncertainty": "Thiếu khóa đáp án được xác nhận."}, {"ref": "85efdd1a7e54|P1|10|None", "part": "P1", "idx": 10, "sub": null, "topic": "Thể tích khối chóp có đáy là tam giác vuông", "grade": 11, "given": "Hình chóp có đáy tam giác vuông, một cạnh bên vuông góc đáy và các độ dài theo tham số; có hình minh họa.", "task": "Tính thể tích khối chóp.", "reasoning": ["Tính diện tích đáy bằng hai cạnh góc vuông.", "Nhận cạnh bên vuông góc đáy là chiều cao.", "Áp dụng công thức thể tích và thu gọn."], "combines": ["Diện tích tam giác vuông", "Chiều cao khối chóp", "Thể tích"], "cue_use": "needed in reasoning", "evidence_uncertainty": "Hình minh họa đọc được; thiếu khóa đáp án được xác nhận."}, {"ref": "85efdd1a7e54|P1|11|None", "part": "P1", "idx": 11, "sub": null, "topic": "Khảo sát hàm số bậc ba: liên hệ đồ thị với dấu hệ số", "grade": 12, "given": "Đồ thị hàm bậc ba hiển thị hướng hai nhánh và giao điểm với trục tung; các lựa chọn liên hệ hệ số đầu và hệ số tự do.", "task": "Chọn quan hệ dấu phù hợp với đồ thị.", "reasoning": ["Suy ra dấu hệ số bậc cao nhất từ hướng các nhánh.", "Đọc hệ số tự do qua giao điểm với trục tung.", "Kết hợp để xét dấu các biểu thức được đề xuất."], "combines": ["Đọc đồ thị", "Hệ số đa thức", "Dấu biểu thức"], "cue_use": "given as a cue", "evidence_uncertainty": "Đồ thị được cung cấp trên ảnh; không có khóa hợp lệ để phân loại các lựa chọn."}, {"ref": "85efdd1a7e54|P1|12|None", "part": "P1", "idx": 12, "sub": null, "topic": "Ứng dụng hình học của tích phân: thể tích khối tròn xoay", "grade": 12, "given": "Một miền phẳng dưới đồ thị hàm mũ, trục hoành và hai đường giới hạn đứng, cùng trục quay.", "task": "Chọn tích phân biểu diễn thể tích khối tròn xoay.", "reasoning": ["Nhận bán kính thiết diện tròn từ giá trị hàm số.", "Lập tích phân diện tích thiết diện trên khoảng giới hạn."], "combines": ["Thiết diện hình tròn", "Tích phân xác định"], "cue_use": "needed in reasoning", "evidence_uncertainty": "Thiếu khóa đáp án được xác nhận."}, {"ref": "85efdd1a7e54|P2|1|a", "part": "P2", "idx": 1, "sub": "a", "topic": "Phương trình mặt cầu: xác định tâm", "grade": 12, "given": "Phương trình mặt cầu ở dạng khai triển và một tọa độ tâm được đề xuất.", "task": "Kiểm tra tọa độ tâm.", "reasoning": ["Hoàn thành bình phương hoặc đối chiếu hệ số tuyến tính.", "Đọc tọa độ tâm rồi so sánh với nhận định."], "combines": ["Phương trình mặt cầu", "Hoàn thành bình phương"], "cue_use": "needed in reasoning", "evidence_uncertainty": "Thiếu khóa được xác nhận; không sử dụng bảng đúng sai trong bản OCR."}, {"ref": "85efdd1a7e54|P2|1|b", "part": "P2", "idx": 1, "sub": "b", "topic": "Phương trình mặt phẳng: khoảng cách từ một điểm đến mặt phẳng", "grade": 12, "given": "Phương trình mặt cầu, phương trình mặt phẳng và một khoảng cách từ tâm được đề xuất.", "task": "Kiểm tra khoảng cách từ tâm mặt cầu đến mặt phẳng.", "reasoning": ["Xác định tâm từ phương trình mặt cầu gốc.", "Thay tọa độ tâm vào công thức khoảng cách đến mặt phẳng.", "So sánh kết quả với nhận định."], "combines": ["Tâm mặt cầu", "Khoảng cách điểm đến mặt phẳng"], "cue_use": "needed in reasoning", "evidence_uncertainty": "Thiếu khóa đúng sai được xác nhận."}, {"ref": "85efdd1a7e54|P2|1|c", "part": "P2", "idx": 1, "sub": "c", "topic": "Công thức tính góc giữa đường thẳng và mặt phẳng", "grade": 12, "given": "Một vectơ chỉ phương, phương trình mặt phẳng và một giá trị lượng giác của góc được đề xuất.", "task": "Kiểm tra giá trị lượng giác của góc giữa đường thẳng và mặt phẳng.", "reasoning": ["Lấy vectơ pháp tuyến từ phương trình mặt phẳng.", "Tính tỉ số tích vô hướng và tích độ dài để xác định sin của góc cần xét.", "Chuyển sang hàm lượng giác được hỏi rồi đối chiếu."], "combines": ["Tích vô hướng", "Góc đường thẳng và mặt phẳng", "Hệ thức lượng giác"], "cue_use": "needed in reasoning", "evidence_uncertainty": "Thiếu khóa đúng sai được xác nhận."}, {"ref": "85efdd1a7e54|P2|1|d", "part": "P2", "idx": 1, "sub": "d", "topic": "Cực trị độ dài đoạn nối mặt cầu với mặt phẳng theo phương cố định", "grade": 12, "given": "Một mặt cầu, một mặt phẳng, phương cố định của đoạn nối chúng và một quan hệ tọa độ tại vị trí dài nhất.", "task": "Kiểm tra quan hệ tọa độ của đầu mút trên mặt cầu khi đoạn nối đạt độ dài lớn nhất.", "reasoning": ["Tham số hóa đường qua điểm trên mặt cầu theo phương cố định.", "Dùng điều kiện giao mặt phẳng để biểu diễn độ dài đoạn nối qua giá trị một biểu thức tuyến tính.", "Nhận ra cần cực đại hóa khoảng cách đến mặt phẳng trên mặt cầu.", "Xác định điểm xa mặt phẳng nhất theo hướng pháp tuyến và kiểm tra nhánh cực đại.", "Thế tọa độ điểm đó vào quan hệ được đề xuất."], "combines": ["Đường thẳng tham số", "Mặt cầu và mặt phẳng", "Tối ưu biểu thức tuyến tính", "Khoảng cách"], "cue_use": "needed in reasoning", "evidence_uncertainty": "Thiếu khóa đúng sai được xác nhận; mức phân hóa dựa vào cấu trúc suy luận và đối chiếu các mẫu hiệu chuẩn được cung cấp."}, {"ref": "85efdd1a7e54|P2|2|a", "part": "P2", "idx": 2, "sub": "a", "topic": "Ý nghĩa của hàm vận tốc và đổi đơn vị", "grade": 12, "given": "Vận tốc phụ thuộc tuyến tính vào thời gian và một vận tốc ban đầu được đề xuất bằng đơn vị khác.", "task": "Kiểm tra vận tốc tại thời điểm bắt đầu.", "reasoning": ["Thay thời điểm bắt đầu vào hàm vận tốc.", "Đổi đơn vị vận tốc rồi đối chiếu."], "combines": ["Hàm vận tốc", "Đổi đơn vị"], "cue_use": "needed in reasoning", "evidence_uncertainty": "Thiếu khóa đúng sai được xác nhận; xếp lớp theo mạch ứng dụng tích phân của cả câu, riêng thao tác này dùng kiến thức nền."}, {"ref": "85efdd1a7e54|P2|2|b", "part": "P2", "idx": 2, "sub": "b", "topic": "Xác định tham số trong hàm vận tốc tuyến tính", "grade": 12, "given": "Hàm vận tốc có hệ số chưa biết và vận tốc tại một thời điểm bằng đơn vị khác.", "task": "Kiểm tra giá trị hệ số biến thiên vận tốc.", "reasoning": ["Đổi vận tốc quan sát về đơn vị của hàm.", "Thay thời điểm và vận tốc vào biểu thức để giải hệ số.", "Đối chiếu với giá trị được đề xuất."], "combines": ["Hàm vận tốc", "Phương trình bậc nhất", "Đổi đơn vị"], "cue_use": "needed in reasoning", "evidence_uncertainty": "Thiếu khóa đúng sai được xác nhận; xếp lớp theo mạch ứng dụng tích phân của cả câu."}]}
