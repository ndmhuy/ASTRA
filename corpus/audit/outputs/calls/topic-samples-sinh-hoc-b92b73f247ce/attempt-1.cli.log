{"canonical_levels": {"revision": "de8c614ada6e3ae9f9072cedb7521fb96c1d13e5", "scheme_id": "default", "scheme_version": 2, "preamble": "A level is the performance a student must show to answer correctly. It is NOT the length of the text, NOT the amount of numbers to read, and NOT the verb used in the outcome sentence.", "levels": [{"code": "NB", "label": {"vi": "Nhận biết", "en": "Recall"}, "ordinal": 1, "status": "APPROVED", "definition_en": "recognise or retrieve. The student recognises, names or restates a fact, concept, definition, symbol, property, formula or step as taught. The answer sits in ONE knowledge unit. A scenario, if any, is decoration.", "samples": [], "bands": []}, {"code": "TH", "label": {"vi": "Thông hiểu", "en": "Comprehension"}, "ordinal": 2, "status": "APPROVED", "definition_en": "Explain, distinguish, interpret, or execute a familiar routine procedure. The student reads a given representation or uses taught knowledge in a standard exercise. A single substitution of given values into a taught formula or equation is TH; several routine algebraic or numerical operations can also remain TH. Choosing the obvious familiar formula without its name being supplied does not by itself make a question VD.", "samples": [], "bands": []}, {"code": "VD", "label": {"vi": "Vận dụng", "en": "Application"}, "ordinal": 3, "status": "APPROVED", "definition_en": "Model a situation or construct a substantive chain of reasoning. The task requires the student to formulate a model, connect and apply multiple knowledge units, or plan and justify several dependent thinking steps rather than merely execute a familiar calculation. Judge the minimum cognitive work needed for a correct answer. A longer text, more numbers, more written calculation steps, or an unstated but obvious formula is not sufficient for VD. A standard multi-step calculation can remain TH; no single surface cue is a compulsory condition for all VD questions.", "samples": [], "bands": []}], "subject_layer": null}, "targets": [{"id": "642cefb532f91ee2", "topic": "Di truyền phân tử", "part": "P3", "level": "TH", "qtype": "short_answer", "option_labels": [], "slot_keys": [null], "canonical_answer_alphabet": [], "abstract_observations": [{"given": "Số đơn vị tái bản và số đoạn tổng hợp gián đoạn trong từng đơn vị của DNA nhân thực.", "task": "Tính tổng số đoạn mồi cần sử dụng.", "reasoning": "Gắn mỗi đoạn tổng hợp gián đoạn với một mồi; xác định phần mồi khởi đầu cho các mạch tổng hợp liên tục tại mỗi đơn vị hai chạc; cộng số mồi trên toàn phân tử.", "combines": ["Tái bản hai chiều", "Mạch liên tục và gián đoạn", "Vai trò RNA mồi"], "difficulty_source": "Nhớ tính thêm mồi cho mạch liên tục ngoài các đoạn gián đoạn", "evidence_uncertainty": null, "evidence_class": "provincial_third_party"}], "support_refs": ["4b4716b94db4|P3|5|None"], "official_anchor_available": false}, {"id": "8134ea0fc651f52a", "topic": "Di truyền phân tử", "part": "P3", "level": "VD", "qtype": "short_answer", "option_labels": [], "slot_keys": [null], "canonical_answer_alphabet": [], "abstract_observations": [{"given": "DNA được đánh dấu đồng vị, lịch sử nhân đôi qua các môi trường khác nhau và số phân tử thuộc một lớp đồng vị ở giai đoạn trung gian.", "task": "Tính số phân tử chỉ chứa loại đồng vị được yêu cầu sau giai đoạn cuối.", "reasoning": "Áp dụng tái bản bán bảo tồn để phân loại DNA sau giai đoạn đầu; suy ra lượng DNA ban đầu từ lớp phân tử đã biết; theo dõi các mạch cũ khi đổi môi trường; đếm hoặc lấy bù để xác định lớp DNA đích.", "combines": ["Tái bản bán bảo tồn", "Bảo toàn mạch DNA", "Tăng số lượng phân tử"], "difficulty_source": "Phải theo dõi lịch sử từng loại mạch khi môi trường cung cấp nguyên liệu thay đổi", "evidence_uncertainty": null, "evidence_class": "provincial_third_party"}, {"given": "Sơ đồ DNA đang được phiên mã, RNA đang được dịch mã, ký hiệu các mạch và một vị trí biến đổi trên DNA.", "task": "Chọn các nhận định đúng về cơ chế đang diễn ra và tác động tức thời của can thiệp.", "reasoning": ["Nhận diện sự phối hợp giữa tổng hợp RNA và tổng hợp protein trong cùng hình.", "Dùng chiều hoạt động và quan hệ bổ sung để xác định mạch khuôn.", "Suy loại tổ chức tế bào từ khả năng phối hợp trực tiếp các quá trình.", "Xác định vị trí biến đổi nằm trước hay sau phần đã được phiên mã.", "Phân biệt tác động lên sản phẩm đang tổng hợp với tác động lên các lượt biểu hiện về sau.", "Tổng hợp các nhận định đúng theo yêu cầu."], "combines": ["Phiên mã", "Dịch mã", "Tổ chức tế bào nhân sơ", "Đột biến dịch khung", "Quan hệ thời điểm giữa DNA và sản phẩm"], "difficulty_source": "Theo dõi vị trí và thời điểm truyền thông tin để phân biệt sản phẩm hiện tại với sản phẩm tương lai", "evidence_uncertainty": null, "evidence_class": "provincial_third_party"}], "support_refs": ["55c12f561006|P3|3|None", "61a0198fbfda|P3|6|None"], "official_anchor_available": false}, {"id": "75756cc46eeaaa60", "topic": "Di truyền quần thể và ứng dụng", "part": "P1", "level": "NB", "qtype": "mcq", "option_labels": ["A", "B", "C", "D"], "slot_keys": [null], "canonical_answer_alphabet": ["A", "B", "C", "D"], "abstract_observations": [{"given": "Một thành tựu chọn giống kết hợp nguồn giống khác nhau và các đặc tính có lợi.", "task": "Nhận diện phương pháp tạo giống.", "reasoning": "Nhận diện việc kết hợp nguồn di truyền qua sinh sản; đối chiếu với bản chất các phương pháp chọn giống.", "combines": ["Lai giống", "Phương pháp tạo giống"], "difficulty_source": "Bối cảnh thành tựu gợi phương pháp lai quen thuộc", "evidence_uncertainty": null, "evidence_class": "provincial_third_party"}, {"given": "Mô tả con lai biểu hiện tốt hơn các dạng bố mẹ ở những đặc tính có lợi.", "task": "Gọi tên hiện tượng chọn giống.", "reasoning": "Nhận diện đặc trưng vượt trội của con lai; phân biệt tên hiện tượng với hậu quả bất lợi và cơ chế giải thích.", "combines": ["Ưu thế lai", "Thuật ngữ chọn giống"], "difficulty_source": "Phân biệt thuật ngữ hiện tượng với cơ chế giải thích", "evidence_uncertainty": null, "evidence_class": "provincial_third_party"}], "support_refs": ["2cbdc74db082|P1|4|None", "8bbf9eea6d33|P1|15|None"], "official_anchor_available": false}, {"id": "6ec925e591041ae7", "topic": "Di truyền quần thể và ứng dụng", "part": "P1", "level": "TH", "qtype": "mcq", "option_labels": ["A", "B", "C", "D"], "slot_keys": [null], "canonical_answer_alphabet": ["A", "B", "C", "D"], "abstract_observations": [{"given": "Tần số các kiểu gene tại một locus trong quần thể.", "task": "Tính tần số allele được chỉ định.", "reasoning": "Xác định đóng góp allele của từng kiểu gene; cộng phần đóng góp từ đồng hợp và dị hợp.", "combines": ["Tần số kiểu gene", "Tần số allele"], "difficulty_source": "Áp dụng trực tiếp quy tắc đếm allele", "evidence_uncertainty": null, "evidence_class": "provincial_third_party"}, {"given": "Cấu trúc kiểu gene ban đầu và lịch sử thay đổi hình thức sinh sản qua các thế hệ.", "task": "Xác định cấu trúc kiểu gene cuối quá trình.", "reasoning": "Tính tần số allele ban đầu; lập cấu trúc cân bằng sau ngẫu phối; tính phần dị hợp còn lại khi tự phối; cộng phần chuyển thành đồng hợp vào cấu trúc trước tự phối.", "combines": ["Tần số allele", "Cân bằng Hardy–Weinberg", "Tự thụ phấn"], "difficulty_source": "Phải đổi mô hình đúng thời điểm giữa các giai đoạn sinh sản", "evidence_uncertainty": null, "evidence_class": "provincial_third_party"}, {"given": "Quần thể ban đầu đồng nhất về kiểu gene dị hợp và số thế hệ tự phối.", "task": "Tính tần số một kiểu gene đồng hợp ở thế hệ được yêu cầu.", "reasoning": "Tính phần dị hợp còn lại qua tự phối; lấy phần giảm dị hợp phân bổ đều cho các kiểu gene đồng hợp.", "combines": ["Tự thụ phấn", "Tần số kiểu gene"], "difficulty_source": "Áp dụng trực tiếp quy luật giảm dị hợp qua tự phối", "evidence_uncertainty": null, "evidence_class": "provincial_third_party"}, {"given": "Sơ đồ vector, vùng điều hòa, chiều phiên mã và các sản phẩm nối DNA có cấu trúc khác nhau.", "task": "Xác định nhóm vector không tạo được sản phẩm protein mong muốn.", "reasoning": ["Xác định sự hiện diện của gene đích trong từng cấu trúc.", "Đối chiếu hướng gene với vùng khởi động phiên mã.", "Phân loại khả năng biểu hiện rồi chọn tổ hợp phù hợp."], "combines": ["DNA tái tổ hợp", "Điều hòa biểu hiện gene", "Đọc sơ đồ vector"], "difficulty_source": "Phân biệt có gene với có khả năng biểu hiện gene", "evidence_uncertainty": null, "evidence_class": "provincial_third_party"}], "support_refs": ["2cbdc74db082|P1|2|None", "55c12f561006|P1|11|None", "55c12f561006|P1|2|None", "61a0198fbfda|P1|18|None", "61a0198fbfda|P1|4|None", "61a0198fbfda|P1|7|None"], "official_anchor_available": false}]}
