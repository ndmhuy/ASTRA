pical_steps": 2, "refs": ["5a0f3809e37d|P1|11|None", "5a0f3809e37d|P1|15|None", "2fb11a4595ca|P1|11|None", "2fb11a4595ca|P1|17|None"]}, {"part_kind": "multiple_choice", "topic": "Đối chiếu thuộc tính kinh tế và xã hội", "grade": null, "construction": "Cho các nhận định về năng lực, chức năng, hiệu quả hoặc phân bố của một đối tượng; yêu cầu chọn đặc điểm đúng bằng kiến thức nền.", "wrong_options": "Phóng đại trình độ phổ biến, phủ nhận thuộc tính quen thuộc, gán sai chức năng hoặc giả định phân bố đồng đều.", "difficulty_source": "Giữ đúng mức độ khái quát của kiến thức.", "discrimination": "low", "typical_steps": 2, "refs": ["5a0f3809e37d|P1|9|None", "5a0f3809e37d|P1|13|None", "5a0f3809e37d|P1|15|None", "2fb11a4595ca|P1|5|None"]}, {"part_kind": "multiple_choice", "topic": "Phân loại theo thuộc tính quyết định", "grade": null, "construction": "Cho các đối tượng, mô tả hoặc phương pháp gần nhau; xác định thuộc tính quyết định của nhóm cần hỏi rồi chọn đối tượng phù hợp hoặc ngoại lệ theo yêu cầu.", "wrong_options": "Dựa vào sự gần gũi bề ngoài, nhầm chức năng giữa các nhóm hoặc bỏ qua yêu cầu phủ định.", "difficulty_source": "Xác định đúng tiêu chí phân loại trước khi đối chiếu phương án.", "discrimination": "low", "typical_steps": 2, "refs": ["5a0f3809e37d|P1|16|None", "2fb11a4595ca|P1|1|None", "2fb11a4595ca|P1|10|None"]}, {"part_kind": "multiple_choice", "topic": "Quan hệ nhân quả trực tiếp trong tự nhiên", "grade": null, "construction": "Cho một điều kiện tự nhiên hoặc môi trường; yêu cầu chọn hệ quả phù hợp. Xác định cơ chế tác động rồi loại các đặc điểm do nhân tố khác chi phối.", "wrong_options": "Đưa đặc điểm tự nhiên có thật nhưng sai nguồn gốc hoặc đảo chiều tác động của cơ chế.", "difficulty_source": "Phân biệt quan hệ nhân quả với sự cùng xuất hiện.", "discrimination": "low", "typical_steps": 2, "refs": ["5a0f3809e37d|P1|4|None", "5a0f3809e37d|P1|10|None", "2fb11a4595ca|P1|7|None", "2fb11a4595ca|P1|8|None"]}, {"part_kind": "multiple_choice", "topic": "Sự phù hợp giữa yêu cầu sản xuất và nguồn lực vùng", "grade": null, "construction": "Cho một hoạt động sản xuất ở một vùng; xác định yêu cầu đầu vào, môi trường hoặc đầu ra của hoạt động rồi đối chiếu với nguồn lực thực tế để chọn lợi thế trực tiếp.", "wrong_options": "Dùng thuận lợi chung thay cho điều kiện đặc hiệu, nhầm nguồn lực sẵn có hoặc cường điệu mức đáp ứng của vùng.", "difficulty_source": "Ghép đúng yêu cầu của hoạt động với lợi thế có sức giải thích.", "discrimination": "medium", "typical_steps": 3, "refs": ["5a0f3809e37d|P1|1|None", "5a0f3809e37d|P1|7|None", "2fb11a4595ca|P1|13|None"]}, {"part_kind": "multiple_choice", "topic": "Lựa chọn tổ hợp nguyên nhân kinh tế chủ yếu", "grade": null, "construction": "Cho một hiện tượng phát triển kinh tế và các tổ hợp nguyên nhân; xác định cơ chế tạo ra hiện tượng rồi chọn tổ hợp trực tiếp, đúng phạm vi và đủ sức bao quát.", "wrong_options": "Trộn tiền đề chung, nguồn lực tiềm năng, biểu hiện hoặc kết quả vào nhóm nguyên nhân chủ yếu.", "difficulty_source": "Xếp thứ bậc giữa những điều kiện đều có liên quan.", "discrimination": "medium", "typical_steps": 3, "refs": ["5a0f3809e37d|P1|12|None", "2fb11a4595ca|P1|16|None"]}, {"part_kind": "multiple_choice", "topic": "Phân biệt cơ cấu ngành và cơ cấu lãnh thổ", "grade": null, "construction": "Cho các mô tả về chuyển dịch hoặc tổ chức sản xuất; xác định cấp độ cơ cấu được hỏi rồi kiểm tra biểu hiện hay nguyên nhân ở đúng cấp độ đó.", "wrong_options": "Đưa tổ chức không gian vào cơ cấu ngành, lấy hiện đại hóa ngành thay cho động lực phân bố hoặc dùng kết quả làm nguyên nhân.", "difficulty_source": "Giữ nhất quán cấp độ phân tích trong toàn bộ lập luận.", "discrimination": "medium", "typical_steps": 3, "refs": ["5a0f3809e37d|P1|17|None", "2fb11a4595ca|P1|16|None"]}, {"part_kind": "multiple_choice", "topic": "Kiểm tra toàn bộ phương án ghép", "grade": null, "construction": "Cho phương án chứa các đối tượng hoặc các vế nhận định; xác định tiêu chí chung rồi kiểm tra từng thành phần trước khi chấp nhận cả phương án.", "wrong_options": "Ghép thành phần đúng với thành phần sai để khai thác việc dừng kiểm tra sau dấu hiệu quen thuộc.", "difficulty_source": "Không để một thành phần đúng thay thế việc đánh giá toàn bộ phương án.", "discrimination": "low", "typical_steps": 2, "refs": ["5a0f3809e37d|P1|14|None", "2fb11a4595ca|P1|12|None"]}, {"part_kind": "multiple_choice", "topic": "Hiện trạng và xu hướng biến đổi", "grade": null, "construction": "Cho các nhận định về quy mô, phân bố và chuyển dịch; yêu cầu phân biệt trạng thái đang có với hướng thay đổi hoặc đặc điểm của cả nhóm.", "wrong_options": "Suy từ xu hướng tăng sang vị thế đã chiếm ưu thế, đảo chiều chuyển dịch hoặc khái quát biến động cục bộ cho toàn nhóm.", "difficulty_source": "Tách quy mô hiện tại, chiều biến động và phạm vi khái quát.", "discrimination": "low", "typical_steps": 2, "refs": ["5a0f3809e37d|P1|8|None", "5a0f3809e37d|P1|18|None", "2fb11a4595ca|P1|5|None"]}, {"part_kind": "multiple_choice", "topic": "Đọc biểu đồ và kiểm tra biến động cơ cấu", "grade": null, "construction": "Cho biểu đồ có chú giải qua các thời điểm; ghép đúng chuỗi dữ liệu, đọc giá trị và so sánh thứ hạng hoặc chuyển dịch. Khi biểu đồ cho tổng lượng, cần quy về tỉ trọng để kiểm tra nhận xét cơ cấu.", "wrong_options": "Ghép nhầm chuỗi, đảo thứ hạng, đảo chiều biến động hoặc dùng tổng lượng thay cho cơ cấu.", "difficulty_source": "Chọn đúng chuỗi và đúng đại lượng trước khi so sánh.", "discrimination": "medium", "typical_steps": 3, "refs": ["5a0f3809e37d|P1|3|None", "2fb11a4595ca|P1|4|None"]}, {"part_kind": "true_false", "topic": "Đối chiếu nhận định với đoạn thông tin", "grade": null, "construction": "Cho đoạn thông tin và nhận định khái quát; tìm nội dung hỗ trợ, xác định phạm vi rồi đối chiếu nhận định với điều được nêu.", "wrong_options": "Các dòng phù hợp mẫu này không có phát biểu sai theo khóa; chưa có căn cứ suy ra cách dựng phát biểu sai riêng.", "difficulty_source": "Nhận ra sự tương ứng giữa thông tin cụ thể và cách diễn đạt khái quát.", "discrimination": "low", "typical_steps": 2, "refs": ["5a0f3809e37d|P2|1|a", "2fb11a4595ca|P2|3|a"]}, {"part_kind": "true_false", "topic": "Bổ sung kiến thức nền để xác nhận đặc trưng lãnh thổ", "grade": null, "construction": "Cho thông tin định hướng về một vùng; dùng kiến thức nền để kiểm tra thứ hạng, vị trí hoặc ý nghĩa lãnh thổ mà đoạn dẫn chưa trình bày đầy đủ.", "wrong_options": "Các dòng phù hợp mẫu này không có phát biểu sai theo khóa; không suy diễn nhiễu chưa được quan sát.", "difficulty_source": "Nhận biết giới hạn của đoạn dẫn và huy động đúng kiến thức vùng.", "discrimination": "low", "typical_steps": 2, "refs": ["5a0f3809e37d|P2|4|c", "2fb11a4595ca|P2|2|b", "2fb11a4595ca|P2|3|b"]}, {"part_kind": "true_false", "topic": "Kiểm tra nguyên nhân chủ yếu của hiện tượng kinh tế", "grade": null, "construction": "Cho bối cảnh hoặc dữ liệu mô tả và một lời giải thích; xác định cơ chế kinh tế trực tiếp rồi đánh giá nhóm nguyên nhân có giải thích đúng hiện tượng và mức độ chủ yếu hay không.", "wrong_options": "Dùng điều kiện có liên quan, yếu tố nổi bật hoặc thuộc tính của lĩnh vực gần thay cho nhân tố trực tiếp.", "difficulty_source": "Không đồng nhất tính hợp lí riêng của từng yếu tố với sức giải thích của cả tổ hợp.", "discrimination": "medium", "typical_steps": 3, "refs": ["5a0f3809e37d|P2|4|b", "2fb11a4595ca|P2|1|c", "2fb11a4595ca|P2|2|c", "2fb11a4595ca|P2|3|c"]}, {"part_kind": "true_false", "topic": "Cơ chế tự nhiên và nhân tố tác động trực tiếp", "grade": null, "construction": "Cho hiện tượng tự nhiên hoặc trở ngại sản xuất và một lời giải thích; nối điều kiện nền với quá trình trung gian và hệ quả rồi kiểm tra chiều tác động hoặc vai trò chi phối.", "wrong_options": "Đảo cơ chế, bỏ mắt xích trung gian hoặc nâng biểu hiện chung thành tác nhân trực tiếp chủ yếu.", "difficulty_source": "Theo dõi quan hệ giữa điều kiện, quá trình và kết quả.", "discrimination": "medium", "typical_steps": 3, "refs": ["5a0f3809e37d|P2|2|a", "5a0f3809e37d|P2|2|d", "2fb11a4595ca|P2|2|a"]}, {"part_kind": "true_false", "topic": "Tăng cường khai thác và sử dụng tài nguyên bền vững", "grade": null, "construction": "Cho vấn đề tài nguyên và một tổ hợp giải pháp; xác định mục tiêu bảo vệ hoặc thích ứng rồi đánh giá tác động thực tế của từng biện pháp.", "wrong_options": "Coi khai thác mạnh hơn là sử dụng hiệu quả hơn, hoặc ghép giải pháp làm tăng sức ép vào mục tiêu bảo vệ tài nguyên.", "difficulty_source": "Phân biệt tăng đầu ra trước mắt với sự phù hợp của cách sử dụng tài nguyên.", "discrimination": "medium", "typical_steps": 3, "refs": ["5a0f3809e37d|P2|2|b", "2fb11a4595ca|P2|2|d"]}, {"part_kind": "true_false", "topic": "Tách hiện tượng đúng khỏi lời giải thích sai", "grade": null, "construction": "Cho một đặc điểm dễ nhận ra kèm mệnh đề giải thích; kiểm tra riêng tính đúng của hiện tượng và tính đúng của quan hệ nhân quả.", "wrong_options": "Giữ hiện tượng đúng nhưng thay nguyên nhân bằng điều kiện không phù hợp, không đủ hoặc sai cấp độ.", "difficulty_source": "Không chấp nhận cả nhận định chỉ vì nhận ra phần mô tả quen thuộc.", "discrimination": "medium", "typical_steps": 3, "refs": ["5a0f3809e37d|P2|4|b", "2fb11a4595ca|P2|1|c", "2fb11a4595ca|P2|2|c", "2fb11a4595ca|P2|3|c"]}, {"part_kind": "true_false", "topic": "So sánh trực tiếp trên biểu đồ", "grade": null, "construction": "Cho biểu đồ và nhận định về khác biệt, thứ hạng hoặc chiều biến động; xác định đúng chú giải, trục và phạm vi rồi so sánh các giá trị cùng đại lượng.", "wrong_options": "Gán sai thứ hạng hoặc ghép nhầm đối tượng; nhận định bao quát đòi hỏi kiểm tra hết các đối tượng liên quan.", "difficulty_source": "Đọc đúng chuỗi và kiểm tra đúng phạm vi khẳng định.", "discrimination": "low", "typical_steps": 2, "refs": ["5a0f3809e37d|P2|3|a", "5a0f3809e37d|P2|3|c", "2fb11a4595ca|P2|1|a"]}, {"part_kind": "true_false", "topic": "So sánh chỉ tiêu tương đối được suy ra từ biểu đồ", "grade": null, "construction": "Cho các tổng lượng trên biểu đồ; nhận diện chỉ tiêu tương đối cần xét, ghép đúng tử số và mẫu số, tính thương rồi so sánh kết quả.", "wrong_options": "Suy từ độ cao cột hoặc mức tăng tuyệt đối sang ưu thế của chỉ tiêu tương đối; dùng hệ số không khớp với kết quả chuẩn hóa.", "difficulty_source": "Chuyển từ dữ liệu nhìn thấy sang đại lượng thực sự được hỏi.", "discrimination": "medium", "typical_steps": 3, "refs": ["5a0f3809e37d|P2|3|b", "2fb11a4595ca|P2|1|b", "2fb11a4595ca|P2|1|d"]}], "discrimination_moves": [{"move": "Đặt các nguyên nhân có liên quan cạnh nguyên nhân chủ yếu", "how_to_apply": "Cho các tổ hợp đều có cơ sở liên hệ, nhưng chỉ một tổ hợp giải thích trực tiếp và đúng phạm vi; yêu cầu người làm xếp thứ bậc nhân tố.", "refs": ["5a0f3809e37d|P1|12|None", "2fb11a4595ca|P1|16|None", "2fb11a4595ca|P2|3|c"]}, {"move": "Giữ đúng hiện tượng nhưng thay sai nguyên nhân", "how_to_apply": "Dùng phần mô tả quen thuộc làm điểm tựa, sau đó đặt sai điều kiện hoặc cơ chế giải thích để buộc kiểm tra toàn bộ quan hệ.", "refs": ["5a0f3809e37d|P2|4|b", "2fb11a4595ca|P2|2|c", "2fb11a4595ca|P2|3|c"]}, {"move": "Ẩn đại lượng cần so sánh sau tổng lượng", "how_to_apply": "Cung cấp dữ liệu gốc nhưng hỏi chỉ tiêu tương đối hoặc bình quân; để hình thức trực quan dễ dẫn tới kết luận sai nếu chưa chuẩn hóa.", "refs": ["5a0f3809e37d|P2|3|b", "2fb11a4595ca|P1|4|None", "2fb11a4595ca|P2|1|b", "2fb11a4595ca|P2|1|d"]}, {"move": "Buộc giữ đúng cấp độ phân tích", "how_to_apply": "Đặt các mô tả gần nhau về ngành, lãnh thổ, nguồn lực và kết quả; yêu cầu chọn hoặc đánh giá ở đúng cấp độ được hỏi.", "refs": ["5a0f3809e37d|P1|17|None", "2fb11a4595ca|P1|16|None", "2fb11a4595ca|P2|1|c"]}, {"move": "Đối chiếu giải pháp với cơ chế thay vì với khẩu hiệu", "how_to_apply": "Đưa biện pháp nghe tích cực nhưng không xử lí đúng quá trình hoặc làm tăng sức ép; buộc người làm kiểm tra tác động thực tế theo mục tiêu.", "refs": ["5a0f3809e37d|P2|2|b", "2fb11a4595ca|P1|14|None", "2fb11a4595ca|P2|2|d"]}, {"move": "Nối các mắt xích thay vì nhận