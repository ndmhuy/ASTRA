65825f390|P2|3|a", "dff65825f390|P2|3|c", "08c8696055dd|P2|3|c"]}], "not_observed": [{"use": "Trong các dòng cung cấp, không thấy yêu cầu tính toán định lượng từ số liệu; bảng được dùng để phân loại và khái quát chuyển biến.", "refs": ["dff65825f390|P2|3|a", "dff65825f390|P2|3|b", "dff65825f390|P2|3|c", "dff65825f390|P2|3|d"]}, {"use": "Không thấy yêu cầu tự viết lại nguyên văn tư liệu, định nghĩa hoặc danh mục; kiến thức được huy động để lựa chọn và đánh giá nhận định.", "refs": ["dff65825f390|P1|10|None", "dff65825f390|P1|18|None", "08c8696055dd|P1|3|None", "08c8696055dd|P2|3|a"]}, {"use": "Không thấy yêu cầu tự cung cấp tên hoặc mốc thời gian dưới dạng câu trả lời mở; các dữ kiện này phục vụ nhận diện và kiểm tra quan hệ trong phương án hay nhận định.", "refs": ["dff65825f390|P1|15|None", "dff65825f390|P2|4|b", "08c8696055dd|P1|16|None", "08c8696055dd|P1|20|None"]}]}, "anti_patterns": [{"avoid": "Biến câu đọc tư liệu thành yêu cầu chép lại nguyên văn hoặc viết bài trả lời mở.", "basis": "Các dòng đọc tư liệu yêu cầu nhận diện, lựa chọn và đánh giá kết luận.", "refs": ["dff65825f390|P1|22|None", "08c8696055dd|P1|22|None", "dff65825f390|P2|1|a", "08c8696055dd|P2|3|a"]}, {"avoid": "Biến bảng tổng kết lịch sử thành bài tính toán chỉ vì có hình thức bảng.", "basis": "Thao tác được mô tả là phân loại nội dung, đối chiếu chính sách và khái quát chiều chuyển biến.", "refs": ["dff65825f390|P2|3|a", "dff65825f390|P2|3|b", "dff65825f390|P2|3|c", "dff65825f390|P2|3|d"]}, {"avoid": "Tạo yêu cầu dự đoán lịch sử giả định hoặc kết cục của tình huống hư cấu.", "basis": "Các thao tác vận dụng được quan sát vẫn dựa trên sự kiện đã học, nguyên tắc và bài học lịch sử.", "refs": ["dff65825f390|P1|12|None", "dff65825f390|P2|2|a", "08c8696055dd|P1|6|None", "08c8696055dd|P2|1|c"]}, {"avoid": "Yêu cầu người làm tự tìm nguồn bên ngoài để xác minh tư liệu trong lúc trả lời.", "basis": "Căn cứ giải được mô tả nằm trong dữ kiện đề bài và kiến thức chương trình; các khoảng thiếu của đoạn trích