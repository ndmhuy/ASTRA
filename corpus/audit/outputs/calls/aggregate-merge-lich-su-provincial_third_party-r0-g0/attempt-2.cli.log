truction": "Cho quá trình cải cách cùng các nhận định về kết quả; yêu cầu chọn thành tựu thực tế. Phân biệt kết quả đạt được với đường lối, nhân tố hỗ trợ và mục tiêu còn hướng tới.", "wrong_options": "Trộn thành tựu với bài học hoặc điều kiện; phóng đại kết quả thành giải quyết triệt để vấn đề hay đạt trình độ vượt thực tế.", "difficulty_source": "Giữ đúng loại kết luận và mức độ thành tựu. Có dẫn chứng mà ranh giới sai của một lựa chọn chưa được giải thích rõ.", "discrimination": "medium", "typical_steps": 3, "refs": ["acc23c4ca4f8|P1|5|None", "686833f78102|P1|15|None"]}, {"part_kind": "multiple_choice", "topic": "Đổi mới phương thức và bảo toàn định hướng", "grade": 12, "construction": "Cho quá trình cải cách cùng các lựa chọn về mô hình và đường lối; yêu cầu chọn nhận định phù hợp. Nhận diện nội dung được điều chỉnh và phân biệt nó với mục tiêu hay nền tảng chính trị.", "wrong_options": "Đồng nhất thay đổi phương thức với thay đổi nền tảng; lấy cơ chế cũ hoặc chủ trương của giai đoạn trước làm đặc điểm của đường lối mới.", "difficulty_source": "Phân biệt tính liên tục về định hướng với sự thay đổi về cơ chế thực hiện.", "discrimination": "medium", "typical_steps": 3, "refs": ["acc23c4ca4f8|P1|5|None", "686833f78102|P1|4|None", "686833f78102|P1|5|None"]}, {"part_kind": "multiple_choice", "topic": "Vai trò của nhân tố và quan hệ điều kiện", "grade": 12, "construction": "Cho các nhận định về phát triển và hội nhập; yêu cầu kiểm tra vai trò của nhân tố được nêu. Phân biệt yếu tố hỗ trợ với điều kiện bắt buộc hoặc nhân tố quyết định.", "wrong_options": "Nâng ngoại lực hay hội nhập thành yếu tố quyết định toàn bộ kết quả hoặc điều kiện không thể thiếu.", "difficulty_source": "Nhận định nghe hợp lí vì nhân tố có tác dụng thật, nhưng bị nâng sai vị trí trong quan hệ giải thích.", "discrimination": "medium", "typical_steps": 3, "refs": ["acc23c4ca4f8|P1|5|None", "686833f78102|P1|4|None"]}, {"part_kind": "multiple_choice", "topic": "Phân loại theo phạm vi và lĩnh vực", "grade": [11, 12], "construction": "Cho yêu cầu giới hạn loại ý nghĩa, nguyên nhân hoặc lĩnh vực; yêu cầu chọn nội dung đúng loại. Phân loại từng lựa chọn trước khi kiểm tra kiến thức sự kiện và điều kiện thời gian.", "wrong_options": "Dùng ý nghĩa đối nội để trả lời phạm vi quốc tế, nguyên nhân bên ngoài thay nội lực hoặc sự kiện đúng thời gian nhưng khác lĩnh vực.", "difficulty_source": "Bỏ sót từ khóa giới hạn khiến người học chọn một thông tin có liên quan nhưng không đáp ứng yêu cầu.", "discrimination": "medium", "typical_steps": 3, "refs": ["acc23c4ca4f8|P1|11|None", "acc23c4ca4f8|P1|21|None", "686833f78102|P1|8|None", "686833f78102|P1|10|None"]}, {"part_kind": "multiple_choice", "topic": "Tác động chính trị của hoạt động thuộc lĩnh vực khác", "grade": 12, "construction": "Cho hoạt động ngoại giao, quân sự hoặc kinh tế; yêu cầu xác định tác động chính trị phù hợp. Nhận diện cơ chế tác động rồi giới hạn kết luận theo kết quả thực tế.", "wrong_options": "Gán kết quả cho sai mặt hoạt động, mở rộng ảnh hưởng sang toàn bộ chiến lược hoặc nâng bước chuyển thành kết thúc quá trình.", "difficulty_source": "Phải nối đúng hoạt động với tác động, đồng thời tránh suy rộng về quy mô.", "discrimination": "medium", "typical_steps": 3, "refs": ["acc23c4ca4f8|P1|2|None", "acc23c4ca4f8|P1|22|None", "acc23c4ca4f8|P1|23|None", "686833f78102|P1|19|None"]}, {"part_kind": "multiple_choice", "topic": "Lựa chọn nhận định giải thích trực tiếp dữ kiện", "grade": 12, "construction": "Cho dấu hiệu về tổ chức, bối cảnh hoặc hoạt động; yêu cầu chọn nhận định giải thích sát nhất. Xác định thuộc tính cần giải thích rồi loại những kết luận chỉ đúng ở mức liên quan chung.", "wrong_options": "Dùng tư tưởng, xu hướng hoặc hệ quả đúng nhưng quá rộng, thiếu đặc trưng hoặc khác trọng tâm.", "difficulty_source": "Phải phân biệt tính đúng nói chung với mức độ phù hợp trực tiếp đối với câu hỏi.", "discrimination": "medium", "typical_steps": 3, "refs": ["acc23c4ca4f8|P1|6|None", "acc23c4ca4f8|P1|14|None", "686833f78102|P1|8|None", "686833f78102|P1|19|None"]}, {"part_kind": "multiple_choice", "topic": "Phân biệt đặc điểm giữa các chặng phát triển", "grade": 12, "construction": "Cho một phong trào, hoạt động hoặc giai đoạn cải cách; yêu cầu chọn mô tả đúng tại chặng đang xét. Khôi phục mức phát triển của phương thức đấu tranh, nhiệm vụ hoặc cơ chế rồi đối chiếu lựa chọn.", "wrong_options": "Đưa vai trò phát triển về sau về trước, kéo dài nhiệm vụ đã kết thúc hoặc coi dấu vết chuyển tiếp là đặc trưng ổn định.", "difficulty_source": "Các mô tả đều có liên hệ với cùng tiến trình nhưng không đúng ở mọi chặng. Một dẫn chứng có lựa chọn gần nghĩa chưa được giải trình đầy đủ.", "discrimination": "medium", "typical_steps": 3, "refs": ["acc23c4ca4f8|P1|2|None", "acc23c4ca4f8|P1|7|None", "acc23c4ca4f8|P1|14|None", "acc23c4ca4f8|P1|20|None", "686833f78102|P1|4|None", "686833f78102|P1|5|None"]}], "discrimination_moves": [{"move": "Buộc kiểm tra chiều nhân quả bằng trình tự thời gian", "how_to_apply": "Dùng các sự kiện đều có liên hệ thực, nhưng đổi vị trí điều kiện và kết quả. Người học phải khôi phục trình tự rồi kiểm tra cơ chế tác động.", "refs": ["acc23c4ca4f8|P1|3|None", "acc23c4ca4f8|P2|1|b", "acc23c4ca4f8|P2|4|c", "686833f78102|P1|6|None"]}, {"move": "Đặt ranh giới ở mức độ kết luận", "how_to_apply": "Giữ đúng hướng tác động nhưng thay tiền đề bằng hoàn thành, đóng góp bằng quyết định hoặc kết quả từng phần bằng kết quả toàn diện. Đáp án phải giữ đúng mức mà kiến thức và dữ kiện cho phép.", "refs": ["acc23c4ca4f8|P1|11|None", "acc23c4ca4f8|P1|12|None", "acc23c4ca4f8|P2|3|d", "686833f78102|P1|19|None"]}, {"move": "Đòi hỏi lời giải thích có tính đặc trưng", "how_to_apply": "Đặt các nhận định cùng có vẻ đúng bên cạnh nhau, nhưng chỉ giữ nhận định giải thích trực tiếp thuộc tính được hỏi. Mỗi nhiễu cần có lí do loại rõ về phạm vi hoặc quan hệ giải thích.", "refs": ["acc23c4ca4f8|P1|6|None", "acc23c4ca4f8|P1|14|None", "686833f78102|P1|8|None", "686833f78102|P1|19|None"]}, {"move": "Chuyển từ biểu hiện cụ thể sang nguyên tắc chung", "how_to_apply": "Cho chuỗi hành động có thuộc tính chung; yêu cầu khái quát nguyên tắc đủ bao quát. Nhiễu thêm phương thức ngoài dữ kiện hoặc nhầm mục tiêu với cách thực hiện.", "refs": ["acc23c4ca4f8|P1|6|None", "acc23c4ca4f8|P2|4|b", "686833f78102|P1|17|None"]}, {"move": "Tách vai trò của nhân tố khỏi sự tuyệt đối hóa", "how_to_apply": "Thừa nhận tác dụng thực của một nhân tố rồi kiểm tra xem nó chỉ hỗ trợ, tạo điều kiện hay thực sự quyết định kết quả. Không dùng sự hiện diện của nhân tố làm bằng chứng cho vai trò tối cao.", "refs": ["acc23c4ca4f8|P1|5|None", "acc23c4ca4f8|P1|23|None", "acc23c4ca4f8|P2|1|c", "686833f78102|P1|4|None"]}, {"move": "Ghép phần đúng với quan hệ giải thích hoặc phạm vi sai", "how_to_apply": "Trong nhận định đúng sai, giữ phần mô tả ban đầu đúng rồi đặt sai lệch ở lí do hoặc phạm vi nhiệm vụ phía sau. Thủ pháp này mới có bằng chứng trong một đề, chưa xác lập tính lặp giữa các đề.", "refs": ["acc23c4ca4f8|P2|2|b", "acc23c4ca4f8|P2|3|a"]}], "easy_vs_hard": [{"topic": "Liên kết khu vực", "easy": "Ghép mốc với thành viên hoặc văn kiện bằng kiến thức niên biểu.", "hard": "Xác định đúng bước phát triển thể chế và bối cảnh riêng; kiểm tra một dấu mốc có thực sự mở đầu tiến trình hay tạo điều kiện cho sự kiện khác.", "easy_refs": ["acc23c4ca4f8|P1|13|None", "686833f78102|P1|7|None", "686833f78102|P1|12|None"], "hard_refs": ["acc23c4ca4f8|P1|14|None", "acc23c4ca4f8|P2|1|a", "acc23c4ca4f8|P2|1|b"]}, {"topic": "Cải cách kinh tế và định hướng phát triển", "easy": "Nhận diện chủ trương kinh tế cốt lõi hoặc loại thành tựu bị phóng đại rõ.", "hard": "Kiểm tra quan hệ giữa trọng tâm cải cách, mục tiêu xã hội và vai trò của nhân tố hỗ trợ; tách chủ trương đúng khỏi lời giải thích không phù hợp.", "easy_refs": ["686833f78102|P1|5|None", "686833f78102|P1|15|None", "acc23c4ca4f8|P2|2|a"], "hard_refs": ["686833f78102|P1|4|None", "acc23c4ca4f8|P2|2|b"]}, {"topic": "Tổ chức và chuẩn bị lực lượng cách mạng", "easy": "Ghép mốc thành lập hoặc chức năng tập hợp quần chúng với tổ chức tương ứng.", "hard": "Suy ra nguyên tắc tổ chức hoặc kiểm tra phạm vi nhiệm vụ ưu tiên trong hoàn cảnh lịch sử.", "easy_refs": ["acc23c4ca4f8|P1|4|None", "686833f78102|P1|14|None"], "hard_refs": ["acc23c4ca4f8|P1|6|None", "acc23c4ca4f8|P2|3|a", "acc23c4ca4f8|P2|3|c"]}, {"topic": "Vai trò tổ chức quốc tế", "easy": "Nhận diện mục tiêu chính thức từ kiến thức đã học.", "hard": "Phân loại những hoạt động đều tích cực để chọn biểu hiện trực tiếp của chức năng được giới hạn.", "easy_refs": ["acc23c4ca4f8|P1|19|None"], "hard_refs": ["686833f78102|P1|8|None"]}, {"topic": "Quan hệ quân sự và ngoại giao", "easy": "Trích xuất tác động đã được tư liệu nêu hoặc nhận diện thỏa thuận qua mục đích và thời điểm.", "hard": "Chuyển tác động trực tiếp thành ý nghĩa đối với nhiệm vụ khác; kiểm tra lĩnh vực tạo ra kết quả và chiều tác động giữa chiến trường với đàm phán.", "easy_refs": ["acc23c4ca4f8|P1|22|None", "acc23c4ca4f8|P2|4|d", "686833f78102|P1|13|None"], "hard_refs": ["acc23c4ca4f8|P1|2|None", "acc23c4ca4f8|P1|23|None", "acc23c4ca4f8|P2|4|c"]}], "fact_use": {"common": [{"use": "Mốc thời gian chủ yếu làm khóa nhận diện sự kiện, hoạt động, thành viên hoặc văn kiện; nhiễu giữ thông tin có thật nhưng đổi vị trí trong niên biểu.", "refs": ["acc23c4ca4f8|P1|4|None", "acc23c4ca4f8|P1|9|None", "acc23c4ca4f8|P1|13|None", "686833f78102|P1|7|None", "686833f78102|P1|11|None", "686833f78102|P1|12|None", "686833f78102|P1|16|None"]}, {"use": "Niên biểu còn là công cụ suy luận để bác bỏ nguyên nhân xuất hiện sau kết quả hoặc phân biệt dấu mốc với điểm khởi đầu.", "refs": ["acc23c4ca4f8|P1|3|None", "acc23c4ca4f8|P1|16|None", "acc23c4ca4f8|P2|1|a", "acc23c4ca4f8|P2|1|b", "acc23c4ca4f8|P2|4|c"]}, {"use": "Tên tổ chức, phong trào và văn kiện được kiểm tra qua quan hệ với chức năng, chủ thể, chiến công hoặc bối cảnh; nhận ra tên quen thuộc chưa đủ.", "refs": ["acc23c4ca4f8|P1|10|None", "acc23c4ca4f8|P1|13|None", "686833f78102|P1|1|None", "686833f78102|P1|3|None", "686833f78102|P1|14|None", "686833f78102|P1|18|None"]}, {"use": "Kiến thức khái niệm được dùng để phân loại phạm vi ý nghĩa, loại nguyên nhân, mục tiêu, biện pháp và chức năng, thay vì chỉ nhắc lại định nghĩa.", "refs": ["acc23c4ca4f8|P1|11|None", "acc23c4ca4f8|P1|21|None", "acc23c4ca4f8|P2|2|c", "686833f78102|P1|8|None", "686833f78102|P1|10|None"]}, {"use": "Tư liệu có thể cung cấp trực tiếp thông tin, nhưng cũng có thể chỉ gợi bối cảnh để người học bổ sung kiến thức ngoài đoạn trích.", "refs": ["acc23c4ca4f8|P1|24|None", "acc23c4ca4f8|P2|4|d", "acc23c4ca4f8|P2|1|a", "acc23c4ca4f8|P2|3|c"]}], "not_observed": [{"observation": "Không thấy yêu cầu tính toán định lượng từ số liệu; thời gian được dùng để ghép, giới hạn và kiểm tra thứ tự lịch sử.", "refs": ["acc23c4ca4f8|P1|3|None", "acc23c4ca4f8|P1|21|None", "686833f78102|P1|7|None", "686833f78102|P1|12|None"]}, {"observation": "Không thấy yêu cầu tái hiện nguyên văn định nghĩa hoặc viết câu trả lời dài từ trí nhớ; kiến thức được huy động để chọn hoặc đánh giá nhận định.", "refs": ["acc23c4ca4f8|P1|19|None", "acc23c4ca4f8|P2|2|d", "686833f78102|P1|8|None", "686833f78102|P1|10|None"]}]}, "anti_patterns": [{"avoid": "Tạo độ khó bằng phép tính số liệu hoặc thao tác định lượng không xuất hiện trong dữ liệu.", "basis": "Các thao tác với thời gian phục vụ nhận diện và suy luận lịch sử.", "refs": ["acc23c4ca4f8|P1|3|None", "686833f78102|P1|12|None"]}, {"avoid": "Chuyển sang bài luận mở, nhập đáp án tự do hoặc tranh luận không có tiêu chí kết luận.", "basis": "Các dòng mô tả lựa chọn phương án hoặc đánh giá đúng sai theo kiến thức và tư liệu.", "refs": ["acc23c4ca4f8|P1|6|None", "acc23c4ca4f8|P2|4|b", "686833f78102|P1|17|None"]}, {"avoid": "Dùng tình huống giả định nhập vai để thay thế bối cảnh lịch sử.", "basis": "Các nhiệm vụ vận dụng trong dữ liệu vẫn bám vào hành động, quan hệ và tiến trình lịch sử được cho.", "refs": ["acc23c4ca4f8|P1|23|None", "686833f78102|P1|17|None", "686833f78102|P1|19|None"]}, {"avoid": "Biến việc nhận ra từ khóa thành toàn bộ yêu cầu của câu phân hóa.", "basis": "Các dòng phân hóa tương đối yêu cầu kiểm tra quan hệ, phạm vi hoặc mức độ; tên gọi và dữ kiện quen thuộc có thể cùng xuất hiện trong lựa chọn sai.", "refs": ["acc23c4ca4f8|P1|6|None", "acc23c4ca4f8|P1|11|None", "686833f78102|P1|4|None", "686833f78102|P1|8|None"]}]}, {"patterns": [{"part_kind": "multiple_choice", "topic": "Phân kì lịch sử và nhiệm vụ từng giai đoạn", "grade": 12, "construction": "Cho giới hạn giai đoạn; yêu cầu chọn nhiệm vụ, hoạt động hoặc chủ trương phù hợp. Xác định ranh giới thời gian rồi kiểm tra nội dung từng phương án.", "wrong_options": "Dùng sự kiện có thật thuộc giai đoạn khác; kéo dài nhiệm vụ đã hoàn thành hoặc gọi quá trình tiếp tục phát triển là mới bắt đầu.", "difficulty_source": "Gắn kiến thức đúng với đúng giai đoạn.", "discrimination": "low", "typical_steps": 2, "refs": ["686833f78102|P1|21|None", "5a9dffb03ca8|P1|4|None", "5a9dffb03ca8|P1|21|None"]}, {"part_kind": "multiple_choice", "topic": "Đọc thông tin trực tiếp trong tư liệu", "grade": 12, "construction": "Cho tư liệu chứa sẵn thông tin cần tìm; yêu cầu nhận diện địa điểm hoặc đối tượng. Định vị thông tin rồi ghép với phương án tương ứng.", "wrong_options": "Thay thông tin của nguồn bằng địa điểm liên quan đến hoạt động khác hoặc khái niệm có liên tưởng gần.", "difficulty_source": "Đọc đúng nguồn và tránh trả lời bằng liên tưởng ngoài nguồn.", "discrimination": "low", "typical_steps": 2, "refs": ["686833f78102|P1|22|None", "5a9dffb03ca8|P1|16|None"]}, {"part_kind": "multiple_choice", "topic": "Bài học lịch sử và vận dụng hiện tại", "grade": [11, 12], "construction": "Cho sự kiện, chuỗi đấu tranh hoặc hoàn cảnh lịch sử; yêu cầu rút bài học có thể vận dụng. Nhận diện vấn đề lịch sử, khái quát nguyên tắc rồi kiểm tra giới hạn vận dụng.", "wrong_options": "Đảo ngược bài học, tuyệt đối hóa một nguồn sức mạnh, đồng nhất đoàn kết với xóa bỏ khác biệt hoặc chiếu thiết chế xuất hiện muộn về quá khứ.", "difficulty_source": "Chọn nguyên tắc đủ khái quát nhưng vẫn có căn cứ lịch sử; một số ranh giới giữa các phương án trong dữ liệu chưa thật sắc.", "discrimination": "medium", "typical_steps": 3, "refs": ["686833f78102|P1|24|None", "5a9dffb03ca8|P1|8|None", "5a9dffb03ca8|P1|12|None"]}, {"part_kind": "multiple_choice", "topic": "Ý nghĩa lịch sử theo phạm vi đánh giá", "grade": [11, 12], "construction": "Cho một sự kiện và phạm vi đánh giá; yêu cầu chọn ý nghĩa phù hợp. Khôi phục kết quả rồi kiểm tra phạm vi lãnh thổ, đối tượng tác động và mức độ phát triển.", "wrong_options": "Đổi ý nghĩa trong nước thành quốc tế, phóng đại phạm vi thắng lợi hoặc gán thành quả của giai đoạn sau cho sự kiện khởi đầu.", "difficulty_source": "Phân biệt nhận định đúng nói chung với nhận định đúng trong phạm vi được hỏi.", "discrimination": "low", "typical_steps": 2, "refs": ["5a9dffb03ca8|P1|2|None", "5a9dffb03ca8|P1|9|None", "dff65825f390|P1|4|None"]}, {"part_kind": "multiple_choice", "topic": "Ghép hội nghị, nội dung và văn kiện", "grade": [11, 12], "construction": "Cho nội dung thỏa thuận hoặc thông tin nhận diện cuộc họp; yêu cầu tìm hội nghị hay văn kiện tương ứng. Khôi phục cặp liên hệ và kiểm tra chức năng, thời điểm của văn kiện.", "wrong_options": "Dùng hội nghị hoặc văn kiện có thật nhưng sai chặng phát triển, sai loại chủ thể ban hành hoặc chỉ gợi liên tưởng qua địa điểm.", "difficulty_source": "Nhớ đúng quan hệ giữa sự kiện và nội dung thay vì chỉ nhận ra tên quen thuộc.", "discrimination": "low", "typical_steps": 2, "refs": ["5a9dffb03ca8|P1|1|None", "dff65825f390|P1|5|None", "dff65825f390|P1|6|None"]}, {"part_kind": "multiple_choice", "topic": "Nhận diện tác nhân hoặc thắng lợi từ dấu hiệu lịch sử", "grade": [11, 12], "construction": "Cho mốc thời gian, phong trào, đối tượng hoặc dấu hiệu thời cơ; yêu cầu nhận diện thành tố lịch sử còn thiếu. Ghép các dấu hiệu với đúng cuộc đấu tranh.", "wrong_options": "Tráo lực lượng hoặc thắng lợi giữa các cuộc chiến; dùng tác nhân liên quan gián tiếp thay cho tác nhân trực tiếp.", "difficulty_source": "Giữ đúng liên hệ giữa thời điểm, đối tượng và sự kiện.", "discrimination": "low", "typical_steps": 2, "refs": ["5a9dffb03ca8|P1|7|None", "5a9dffb03ca8|P1|13|None", "dff65825f390|P1|3|None"]}, {"part_kind": "multiple_choice", "topic": "Tìm nhận định không phù hợp", "grade": 12, "construction": "Cho sự kiện, xu thế hoặc nhóm cuộc đấu tranh; yêu cầu tìm ngoại lệ. Theo dõi phủ định rồi kiểm tra từng nhận định theo bối cảnh và phạm vi áp dụng.", "wrong_options": "Các phương án gây nhiễu là nhận định phù hợp; chúng thu hút người bỏ sót phủ định hoặc hiểu quá hẹp tính chất, chủ thể và phạm vi tác động.", "difficulty_source": "Kết hợp kiểm soát yêu cầu phủ định với kiểm tra nội dung lịch sử.", "discrimination": "medium", "typical_steps": 3, "refs": ["5a9dffb03ca8|P1|14|None", "5a9dffb03ca8|P1|22|None", "dff65825f390|P1|1|None"]}, {"part_kind": "multiple_choice", "topic": "Đặc điểm chung qua các cuộc đấu tranh", "grade": [11, 12], "construction": "Cho nhóm cuộc đấu tranh; yêu cầu xác định đặc điểm hoặc nhân tố có thể áp dụng cho toàn nhóm. Kiểm tra nhận định ở từng trường hợp trước khi khái quát.", "wrong_options": "Lấy chiến thuật, địa bàn hoặc nhiệm vụ tiêu biểu của một trường hợp làm đặc điểm chung; nhầm hình thái chủ đạo với phương thức duy nhất.", "difficulty_source": "Kiểm tra tính phổ quát thay vì dựa vào trường hợp nổi bật nhất.", "discrimination": "medium", "typical_steps": 3, "refs": ["5a9dffb03ca8|P1|14|None", "dff65825f390|P1|2|None"]}, {"part_kind": "true_false", "topic": "Đối chiếu nhận định với thông tin trực tiếp", "grade": 12, "construction": "Cho tư liệu cùng nhận định tóm tắt cơ cấu, vai trò hoặc định hướng; yêu cầu đánh giá đúng sai. Tìm đoạn liên quan rồi so sánh nội dung và mức độ khẳng định.", "wrong_options": null, "difficulty_source": "Nhận ra cách diễn đạt lại thông tin mà không tự thêm nội dung.", "discrimination": "low", "typical_steps": 2, "refs": ["686833f78102|P2|2|b", "686833f78102|P2|2|c", "5a9dffb03ca8|P2|2|c"]}, {"part_kind": "true_false", "topic": "Đọc chủ trương và mục đích hành động", "grade": 12, "construction": "Cho tư liệu chỉ đạo có thông tin về thời điểm, chủ thể hoặc mục tiêu; yêu cầu kiểm tra nhận định tóm tắt. Đọc nội dung và xuất xứ rồi đối chiếu hướng hành động được nêu.", "wrong_options": "Nhận định sai có thể đảo chủ trương hành động thành trì hoãn hoặc thêm lí do không có trong nguồn.", "difficulty_source": "Giữ đúng mục đích và điều kiện của chỉ đạo; dữ liệu có trường hợp bản tóm tắt làm mờ điều kiện thực hiện.", "discrimination": "low", "typical_steps": 2, "refs": ["686833f78102|P2|4|b", "686833f78102|P2|4|d", "5a9dffb03ca8|P2|3|b", "5a9dffb03ca8|P2|4|b"]}, {"part_kind": "true_false", "topic": "Khái quát chủ đề bảng sự kiện", "grade": 12, "construction": "Cho bảng niên biểu gồm các sự kiện thuộc nhiều phạm vi; yêu cầu đánh giá cách đặt chúng vào bối cảnh và chủ đề chung. Xác định khung thời gian rồi khái quát lĩnh vực biến đổi.", "wrong_options": null, "difficulty_source": "Đọc bảng như một chỉnh thể thay vì chỉ nhận diện từng sự kiện.", "discrimination": "low", "typical_steps": 2, "refs": ["686833f78102|P2|3|b", "5a9dffb03ca8|P2|1|a"]}, {"part_kind": "true_false", "topic": "Quan hệ giữa thời gian và nhân quả", "grade": 12, "construction": "Cho tư liệu hoặc bảng sự kiện cùng nhận định giải thích biến đổi lịch sử; yêu cầu kiểm tra trình tự nguyên nhân và kết quả. Đặt các hiện tượng vào niên biểu rồi phân biệt điều kiện chuẩn bị với thành quả đã đạt.", "wrong_options": "Đưa chuyển biến xuất hiện sau thành nguyên nhân của biến cố trước hoặc đưa kết quả về thời điểm chuẩn bị.", "difficulty_source": "Phát hiện tiền giả định sai trong một quan hệ nhân quả có vẻ hợp lí.", "discrimination": "medium", "typical_steps": 3, "refs": ["686833f78102|P2|3|d", "5a9dffb03ca8|P2|3|c"]}, {"part_kind": "true_false", "topic": "Quan hệ kết hợp giữa tự chủ và nguồn lực bên ngoài", "grade": 12, "construction": "Cho tư liệu nêu các yêu cầu hoặc nguồn lực bổ sung nhau; yêu cầu đánh giá quan hệ giữa chúng. Nhận diện từng vế rồi kiểm tra nhận định có giữ đúng quan hệ kết hợp hay không.", "wrong_options": "Biến kết hợp thành loại trừ, thay thế hoặc khép kín; tuyệt đối hóa nguồn lực bên ngoài.", "difficulty_source": "Đọc quan hệ giữa các ý thay vì chỉ nhận ra các từ khóa đúng.", "discrimination": "medium", "typical_steps": 2, "refs": ["686833f78102|P2|2|d", "5a9dffb03ca8|P2|2|d", "5a9dffb03ca8|P2|3|d", "5a9dffb03ca8|P2|4|d"]}, {"part_kind": "true_false", "topic": "Liên kết khu vực trong bối cảnh quốc tế", "grade": 12, "construction": "Cho bảng biến đổi quốc tế và hoạt động hợp tác; yêu cầu đánh giá động lực hoặc điều kiện của liên kết. Phân biệt tác động môi trường với nhu cầu và vai trò chủ động của các thành viên.", "wrong_options": "Nâng điều kiện quốc tế thành nguyên nhân quyết định và làm mờ động lực bên trong.", "difficulty_source": "Phân biệt bối cảnh tạo thuận lợi với cơ chế thúc đẩy hành động tập thể.", "discrimination": "medium", "typical_steps": 3, "refs": ["686833f78102|P2|3|a", "5a9dffb03ca8|P2|1|b"]}, {"part_kind": "true_false", "topic": "Từ sự kiện đến hệ quả và xu hướng", "grade": 12, "construction": "Cho kết quả ngoại giao, biến đổi quan hệ hoặc chính sách tác động rộng; yêu cầu đánh giá hệ quả gần, tác động lan tỏa hay xu hướng thích nghi. Xác định cơ chế tác động rồi kiểm tra phạm vi và mức độ kết luận.", "wrong_options": null, "difficulty_source": "Nối thông tin với hệ quả có căn cứ; không biến khả năng hay xu hướng thành kết quả tuyệt đối. Một số hệ quả trong dữ liệu chỉ được xét theo cơ chế, không có dữ liệu đo tác động.", "discrimination": "medium", "typical_steps": 3, "refs": ["686833f78102|P2|1|a", "686833f78102|P2|1|c", "686833f78102|P2|3|c", "5a9dffb03ca8|P2|1|d"]}, {"part_kind": "true_false", "topic": "Thời điểm khởi đầu và quá trình phát triển", "grade": 12, "construction": "Cho bảng sự kiện hoặc tư liệu có xuất xứ muộn cùng nhận định về giai đoạn khởi đầu; yêu cầu kiểm tra sự quy chiếu thời gian. Kết hợp thông tin nguồn với kiến thức về tiền lệ và quá trình bổ sung đường lối.", "wrong_options": "Lấy biểu hiện phát triển muộn làm khởi nguồn hoặc chiếu chủ trương về ngay giai đoạn đầu.", "difficulty_source": "Dùng kiến thức ngoài nguồn để kiểm tra điều mà nguồn được trích chưa đủ chứng minh.", "discrimination": "medium", "typical_steps": 3, "refs": ["5a9dffb03ca8|P2|1|c", "5a9dffb03ca8|P2|2|a"]}, {"part_kind": "multiple_choice", "topic": "So sánh để tìm khác biệt", "grade": 12, "construction": "Cho các giai đoạn hoặc chiến dịch làm đối tượng so sánh; yêu cầu chọn tiêu chí tạo khác biệt. Khôi phục đặc điểm từng đối tượng rồi loại nội dung cùng đúng ở các đối tượng.", "wrong_options": "Đưa điểm chung vào vị trí điểm khác; nhầm tăng quy mô với đổi cấp độ hoặc nhầm vai trò khác nhau với kết cục khác nhau.", "difficulty_source": "Phân biệt kiến thức đúng với tiêu chí thực sự phân biệt được các đối tượng.", "discrimination": "medium", "typical_steps": 3, "evidence_scope": "Quan sát trong cùng một đề; chưa xác nhận tái diễn giữa các đề.", "refs": ["5a9dffb03ca8|P1|15|None", "5a9dffb03ca8|P1|20|None"]}, {"part_kind": "multiple_choice", "topic": "Chức năng và chiều hướng phát triển của tổ chức khu vực", "grade": 12, "construction": "Cho tổ chức hoặc cộng đồng khu vực; yêu cầu nhận diện mục đích hay triển vọng phù hợp. Phân biệt chức năng, đặc điểm hiện hữu, thách thức và định hướng phát triển.", "wrong_options": "Gán chức năng toàn cầu, biến liên kết thành đồng nhất hóa hoặc dùng bối cảnh và thách thức thay cho triển vọng.", "difficulty_source": "Giữ đúng loại thuộc tính và phạm vi của tổ chức.", "discrimination": "low", "typical_steps": 2, "evidence_scope": "Quan sát trong cùng một đề; chưa xác nhận tái diễn giữa các đề.", "refs": ["5a9dffb03ca8|P1|5|None", "5a9dffb03ca8|P1|19|None"]}, {"part_kind": "multiple_choice", "topic": "Quan hệ giữa tự giải phóng và phối hợp quốc tế", "grade": 12, "construction": "Cho tư liệu chính luận, có thể dùng ẩn dụ về các bộ phận liên hệ với nhau; yêu cầu khái quát quan hệ giữa các phong trào. Giải mã quan hệ trong nguồn rồi chuyển thành nguyên tắc phối hợp.", "wrong_options": "Biến phối hợp thành lệ thuộc, thứ bậc hoặc biệt lập; đặt mục tiêu dân tộc và liên kết quốc tế thành đối lập.", "difficulty_source": "Giữ đúng tính liên hệ mà không suy thành quan hệ chỉ huy một chiều.", "discrimination": "medium", "typical_steps": 3, "evidence_scope": "Quan sát trong cùng một đề; chưa xác nhận tái diễn giữa các đề.", "refs": ["5a9dffb03ca8|P1|17|None", "5a9dffb03ca8|P1|18|None"]}, {"part_kind": "multiple_choice", "topic": "Phân biệt bản chất với biểu hiện hoặc phương thức", "grade": 12, "construction": "Cho quá trình phát triển tổ chức, đấu tranh hoặc cải cách; yêu cầu chọn mô tả đúng bản chất chuyển biến. Xác định cấp độ khái niệm rồi phân biệt thay đổi nền tảng với biểu hiện bề ngoài.", "wrong_options": "Thay cơ chế bằng hoạt động, hình thái bằng mặt trận, mục tiêu bằng phương thức hoặc tính toàn diện bằng thay đổi đồng loạt.", "difficulty_source": "Khái quát đúng cấp độ và giữ quan hệ giữa kế thừa với đổi mới.", "discrimination": "medium", "typical_steps": 3, "evidence_scope": "Quan sát trong cùng một đề; chưa xác nhận tái diễn giữa các đề.", "refs": ["5a9dffb03ca8|P1|6|None", "5a9dffb03ca8|P1|10|None", "5a9dffb03ca8|P1|23|None"]}, {"part_kind": "true_false", "topic": "Giới hạn của suy luận từ tiền đề đúng", "grade": 12, "construction": "Cho tư liệu về mô hình kinh tế hoặc hợp tác có điều kiện; yêu cầu kiểm tra nhận định mở đầu hợp lí nhưng kéo theo kết luận vượt giới hạn. Tách các vế và xét riêng bước suy luận nối chúng.", "wrong_options": "Từ vai trò thị trường suy ra buông quản lí; từ linh hoạt biện pháp suy ra thay đổi nguyên tắc; từ lợi ích trước mắt suy ra tin cậy lâu dài.", "difficulty_source": "Không để phần đúng che khuất bước chuyển nghĩa ở kết luận.", "discrimination": "medium", "typical_steps": 3, "refs": ["686833f78102|P2|2|a", "5a9dffb03ca8|P2|4|a", "5a9dffb03ca8|P2|4|c"]}, {"part_kind": "true_false", "topic": "Phân biệt tính chất và nội dung của thắng lợi ngoại giao", "grade": 12, "construction": "Cho tư liệu đánh giá kết quả đàm phán; yêu cầu kiểm tra tính chất thắng lợi hoặc nội dung pháp lí. Tách quyền được cam kết, quy định quân sự và vai trò của kết quả trong tiến trình chiến tranh.", "wrong_options": "Đồng nhất thành quả ngoại giao với thắng lợi quân sự kết thúc chiến tranh; đánh tráo cam kết pháp lí và bố trí lực lượng.", "difficulty_source": "Phân biệt các phương diện cùng liên quan đến một kết quả lịch sử.", "discrimination": "medium", "typical_steps": 3, "evidence_scope": "Quan sát trong cùng một đề; chưa xác nhận tái diễn giữa các đề.", "refs": ["686833f78102|P2|1|b", "686833f78102|P2|1|d"]}, {"part_kind": "true_false", "topic": "Kế thừa và phát triển trong chỉ đạo chiến lược", "grade": 12, "construction": "Cho tư liệu chỉ đạo và nhận định liên hệ với kinh nghiệm trước; yêu cầu đánh giá điểm tương đồng hoặc sự phát triển. Khôi phục hoàn cảnh trước, nhận diện cơ chế chung rồi xét cách vận dụng trong yêu cầu mới.", "wrong_options": null, "difficulty_source": "So sánh cơ chế hình thành thời cơ hoặc nghệ thuật hành động thay vì chỉ ghép từ ngữ giống nhau.", "discrimination": "medium", "typical_steps": 3, "evidence_scope": "Quan sát trong cùng một đề; chưa xác nhận tái diễn giữa các đề.", "refs": ["686833f78102|P2|4|a", "686833f78102|P2|4|c"]}, {"part_kind": "multiple_choice", "topic": "Nhận diện thực thể bằng các điều kiện giới hạn", "grade": [11, 12], "construction": "Cho thông tin về giai đoạn, mục đích hoạt động hoặc phạm vi địa lí; yêu cầu nhận diện địa điểm hay quốc gia. Lọc phương án theo điều kiện rõ trước rồi đối chiếu kiến thức lịch sử còn lại.", "wrong_options": "Dùng địa bàn thuộc chặng hoạt động khác, đối tượng chỉ thỏa một điều kiện hoặc phương án xa có thể loại ngay.", "difficulty_source": "Nhớ liên hệ thực thể với bối cảnh; nhiễu xa có thể làm giảm yêu cầu suy luận.", "discrimination": "low", "typical_steps": 2, "evidence_scope": "Quan sát trong cùng một đề; chưa xác nhận tái diễn giữa các đề.", "refs": ["5a9dffb03ca8|P1|11|None", "5a9dffb03ca8|P1|24|None"]}, {"part_kind": "true_false", "topic": "Chuyển mô tả cụ thể thành khái niệm giải thích", "grade": 12, "construction": "Cho mô tả định hướng kinh tế hoặc lựa chọn địa bàn tác chiến; yêu cầu đánh giá cách diễn giải bằng khái niệm khái quát. Nhận diện dấu hiệu, bổ sung kiến thức nền rồi nối dấu hiệu với cơ chế tạo hiệu quả.", "wrong_options": null, "difficulty_source": "Đi từ thông tin được mô tả sang bản chất mô hình hoặc ý nghĩa chiến lược không được nói nguyên văn.", "discrimination": "medium", "typical_steps": 3, "evidence_scope": "Quan sát trong cùng một đề; chưa xác nhận tái diễn giữa các đề.", "refs": ["5a9dffb03ca8|P2|2|b", "5a9dffb03ca8|P2|3|a"]}], "discrimination_moves": [{"move": "Kiểm tra quan hệ thay vì nhận diện từ khóa", "how_to_apply": "Giữ các thành tố kiến thức quen thuộc nhưng thay quan hệ kết hợp bằng loại trừ, thay thế hoặc lệ thuộc; yêu cầu người làm xét cách các thành tố gắn với nhau.", "refs": ["686833f78102|P2|2|d", "5a9dffb03ca8|P1|17|None", "5a9dffb03ca8|P2|2|d"]}, {"move": "Cài sai ở kết luận sau tiền đề hợp lí", "how_to_apply": "Viết nhận định có phần mô tả phù hợp nhưng bước suy luận tiếp theo vượt điều kiện hoặc phạm vi của nguồn.", "refs": ["686833f78102|P2|2|a", "5a9dffb03ca8|P2|4|a", "5a9dffb03ca8|P2|4|c"]}, {"move": "Dùng niên biểu để kiểm tra nhân quả", "how_to_apply": "Đặt nhận định có vẻ hợp lí về nội dung nhưng sai trình tự; buộc người làm phân biệt điều kiện chuẩn bị, nguyên nhân và thành quả.", "refs": ["686833f78102|P2|3|d", "5a9dffb03ca8|P2|3|c"]}, {"move": "Kiểm tra tính phổ quát của nhận định", "how_to_apply": "Cho nhóm đối tượng và phương án đúng với một số trường hợp; yêu cầu kiểm tra từng trường hợp trước khi chấp nhận đặc điểm chung.", "refs": ["5a9dffb03ca8|P1|14|None", "dff65825f390|P1|2|None"]}, {"move": "Buộc dùng kiến thức ngoài tư liệu", "how_to_apply": "Cho nguồn đủ nhận diện vấn đề nhưng chưa đủ kết luận; yêu cầu huy động tiền lệ hoặc quá trình phát triển để kiểm tra nhận định.", "refs": ["686833f78102|P2|1|b", "5a9dffb03ca8|P2|1|c", "5a9dffb03ca8|P2|2|a"]}, {"move": "Chuyển dữ kiện sang cấp độ khái quát", "how_to_apply": "Yêu cầu giải thích cơ chế hoặc rút nguyên tắc từ mô tả; giữ các lựa chọn ở mức khái quát gần nhau để tránh chỉ cần nhận từ khóa.", "refs": ["686833f78102|P1|24|None", "5a9dffb03ca8|P2|2|b", "5a9dffb03ca8|P2|3|a"]}, {"move": "Kiểm soát mức độ khẳng định", "how_to_apply": "Phân biệt tác động với quyết định, xu hướng với kết quả tất yếu, hợp tác có điều kiện với quan hệ bền vững.", "refs": ["686833f78102|P2|3|c", "5a9dffb03ca8|P2|1|b", "5a9dffb03ca8|P2|1|d", "5a9dffb03ca8|P2|4|c"]}], "discrimination_note": "Dữ liệu không gắn mức high cho hàng nào và chưa có kết quả làm bài để kiểm chứng phân hóa. Các động tác trên được rút từ những hàng có yêu cầu suy luận tương đối cao hơn trong tập, không phải bằng chứng về phân hóa cao đã được đo.", "easy_vs_hard": [{"topic": "Đọc tư liệu về hoạt động cách mạng", "easy": "Tìm thông tin được nêu trực tiếp rồi ghép với phương án.", "hard": "Khái quát quan hệ giữa mục tiêu tự giải phóng và phối hợp bên ngoài, loại cách hiểu đối lập hoặc lệ thuộc.", "easy_refs": ["686833f78102|P1|22|None", "5a9dffb03ca8|P1|16|None"], "hard_refs": ["5a9dffb03ca8|P1|17|None"]}, {"topic": "Đường lối phát triển kinh tế", "easy": "Đối chiếu nhận định với cơ cấu hoặc vai trò đã ghi rõ trong nguồn.", "hard": "Chuyển mô tả sang khái niệm mô hình phát triển hoặc phát hiện kết luận sai nối sau tiền đề đúng.", "easy_refs": ["686833f78102|P2|2|b", "5a9dffb03ca8|P2|2|c"], "hard_refs": ["686833f78102|P2|2|a", "5a9dffb03ca8|P2|2|b"]}, {"topic": "Biến đổi quan hệ quốc tế", "easy": "Nhận diện khung thời gian và chủ đề chung của bảng.", "hard": "Kiểm tra chiều nhân quả hoặc mức độ quyết định mà nhận định gán cho bối cảnh.", "easy_refs": ["686833f78102|P2|3|b", "5a9dffb03ca8|P2|1|a"], "hard_refs": ["686833f78102|P2|3|d", "5a9dffb03ca8|P2|1|b"]}, {"topic": "Thời cơ và chỉ đạo hành động", "easy": "Đọc yêu cầu hành động hoặc nhận diện tác nhân trực tiếp tạo thời cơ.", "hard": "So sánh quá trình hình thành thời cơ và phân biệt chuẩn bị với thời điểm hành động.", "easy_refs": ["5a9dffb03ca8|P1|7|None", "686833f78102|P2|4|b", "686833f78102|P2|4|d"], "hard_refs": ["686833f78102|P2|4|a"]}, {"topic": "Chiến tranh bảo vệ đất nước", "easy": "Ghép mốc, đối tượng hoặc phong trào với thắng lợi tương ứng.", "hard": "Kiểm tra nhân tố chung qua các cuộc chiến, loại chiến thuật chỉ đúng ở một số trường hợp.", "easy_refs": ["5a9dffb03ca8|P1|13|None", "dff65825f390|P1|3|None"], "hard_refs": ["dff65825f390|P1|2|None"]}], "fact_use": {"common": [{"use": "Mốc thời gian dùng để đặt nhiệm vụ, chủ trương và sự kiện vào đúng giai đoạn, không chỉ để nhận mặt niên đại.", "refs": ["686833f78102|P1|21|None", "5a9dffb03ca8|P1|4|None", "5a9dffb03ca8|P1|21|None"]}, {"use": "Tên sự kiện, địa điểm và văn kiện được nhớ theo cặp liên hệ; nhiễu tráo thành tố giữa những sự kiện có thật.", "refs": ["5a9dffb03ca8|P1|1|None", "5a9dffb03ca8|P1|11|None", "dff65825f390|P1|3|None", "dff65825f390|P1|5|None", "dff65825f390|P1|6|None"]}, {"use": "Thông tin thực chứng có thể được cung cấp ngay trong tư liệu; yêu cầu là đọc và đối chiếu thay vì nhớ độc lập.", "refs": ["686833f78102|P1|22|None", "5a9dffb03ca8|P1|16|None", "686833f78102|P2|4|d"]}, {"use": "Khái niệm được kiểm tra qua ranh giới nghĩa: mục tiêu và phương thức, pháp lí và quân sự, tác động và quyết định, bổ sung và thay thế.", "refs": ["686833f78102|P2|1|b", "5a9dffb03ca8|P1|23|None", "5a9dffb03ca8|P2|1|b", "5a9dffb03ca8|P2|2|d"]}, {"use": "Xuất xứ nguồn và kiến thức niên biểu được phối hợp để kiểm tra sự quy chiếu về giai đoạn đầu; ngày của nguồn tự nó chưa chứng minh thời điểm xuất hiện đầu tiên của chủ trương.", "refs": ["5a9dffb03ca8|P2|2|a"]}], "not_observed": [{"use": "Không thấy yêu cầu tính toán định lượng từ các mốc hoặc số liệu; bảng và mốc được dùng cho phân kì, nhận diện và kiểm tra suy luận.", "refs": ["5a9dffb03ca8|P1|3|None", "686833f78102|P2|3|b", "686833f78102|P2|3|d", "5a9dffb03ca8|P2|1|a"]}, {"use": "Không thấy yêu cầu tự viết định nghĩa hoặc tái tạo nguyên văn tư liệu; kiến thức khái niệm được dùng để lựa chọn hay đánh giá nhận định.", "refs": ["5a9dffb03ca8|P1|10|None", "5a9dffb03ca8|P1|23|None", "5a9dffb03ca8|P2|2|b", "5a9dffb03ca8|P2|4|a"]}], "scope": "Các điều không quan sát được chỉ áp dụng cho tập hàng đã cung cấp; không suy rộng thành quy luật của mọi đề."}, "anti_patterns": [{"avoid": "Biến bảng niên biểu thành bài tính toán số học không có trong yêu cầu lịch sử.", "basis": "Các bảng được dùng để nhận diện bối cảnh, khái quát xu hướng và kiểm tra quan hệ nhân quả.", "refs": ["686833f78102|P2|3|b", "686833f78102|P2|3|d", "5a9dffb03ca8|P2|1|a", "5a9dffb03ca8|P2|1|d"]}, {"avoid": "Đòi hỏi bài trả lời mở hoặc chép nguyên văn khi mô phỏng các hàng lựa chọn và đúng sai này.", "basis": "Hoạt động trả lời được mô tả là nhận diện phương án hoặc đánh giá nhận định, kể cả khi phải khái quát và vận dụng.", "refs": ["686833f78102|P1|24|None", "5a9dffb03ca8|P1|17|None", "5a9dffb03ca8|P2|2|b", "5a9dffb03ca8|P2|4|a"]}, {"avoid": "Dùng thông tin ghi rõ trong nguồn như thể người làm bắt buộc phải nhớ độc lập.", "basis": "Các hàng đọc trực tiếp cho phép tìm câu trả lời hoặc căn cứ đánh giá ngay trong tư liệu.", "refs": ["686833f78102|P1|22|None", "5a9dffb03ca8|P1|16|None", "686833f78102|P2|2|b", "5a9dffb03ca8|P2|2|c"]}, {"avoid": "Đặt đáp án khái quát bằng cách xóa giới hạn thời gian, phạm vi hoặc điều kiện vốn quyết định tính đúng.", "basis": "Các hàng dùng chính những giới hạn này để phân biệt nhận định phù hợp với nhận định phóng đại, chiếu ngược hoặc tuyệt đối hóa.", "refs": ["5a9dffb03ca8|P1|2|None", "dff65825f390|P1|2|None", "5a9dffb03ca8|P2|1|c", "5a9dffb03ca8|P2|4|c"]}], "evidence_limits": "Chỉ các mẫu có refs thuộc các đề khác nhau mới được xem là dấu hiệu tái diễn giữa đề. Các nhóm còn lại được đánh dấu phạm vi quan sát. Chất lượng nhiễu không đồng đều; có phương án xa và có nhận định được ghi nhận là chưa chặt, nên không suy ra rằng mọi hàng đều có ranh giới đáp án sắc hoặc mọi nhiễu đều phản ánh một lỗi học sinh cụ thể."}, {"evidence_scope": "Hồ sơ mô tả các cách dựng câu có bằng chứng ở những đề khác nhau trong tập dữ liệu do bên thứ ba cấp tỉnh cung cấp. Sự lặp lại được xác định ở cấp cấu trúc hỏi và thao tác suy luận, không mặc nhiên ở từng nội dung kiến thức. Các hàng không có mức discrimination là high; vì vậy, discrimination_moves chỉ nêu những thao tác phân hóa quan sát được ở mức medium, chưa xác nhận khả năng phân hóa cao. Những kết luận phụ thuộc kiến thức ngoài tư liệu hoặc có bất định của khóa được giữ nguyên giới hạn đó.", "patterns": [{"part_kind": "multiple_choice", "topic": "Nhận diện sự kiện từ dấu hiệu định danh", "grade": 12, "construction": "Cho mốc thời gian, dấu hiệu tên gọi hoặc hệ quả tiêu biểu; yêu cầu nhận diện sự kiện. Khôi phục liên hệ đã học rồi đối chiếu phương án với giới hạn của đề.", "wrong_options": "Dùng sự kiện nổi tiếng ở giai đoạn khác, thuộc tiến trình khác hoặc có tên gọi gần gũi; mức độ nổi tiếng dễ lấn át quan hệ cần xác định.", "difficulty_source": "Độ trực tiếp của dấu hiệu và khoảng cách lịch sử giữa đáp án với nhiễu.", "discrimination": "low", "typical_steps": 2, "refs": ["dff65825f390|P1|7|None", "08c8696055dd|P1|4|None", "08c8696055dd|P1|14|None", "08c8696055dd|P1|20|None"]}, {"part_kind": "multiple_choice", "topic": "Loại nhận định vượt quá vai trò hoặc ý nghĩa", "grade": 12, "construction": "Cho các đánh giá về vai trò hoặc ý nghĩa; yêu cầu tìm đánh giá không phù hợp. Xác định đóng góp thực tế rồi kiểm tra phạm vi, mức độ và giai đoạn của từng đánh giá.", "wrong_options": "Các phương án không được chọn là đóng góp có cơ sở; phương án cần chọn tuyệt đối hóa khả năng hoặc chuyển ý nghĩa từ giai đoạn khác.", "difficulty_source": "Theo dõi yêu cầu phủ định đồng thời giữ đúng phạm vi đánh giá.", "discrimination": "low", "typical_steps": 3, "refs": ["dff65825f390|P1|8|None", "08c8696055dd|P1|12|None"]}, {"part_kind": "multiple_choice", "topic": "So sánh các tiến trình lịch sử theo cùng tiêu chí", "grade": 12, "construction": "Đặt các tiến trình cạnh nhau và hỏi đặc điểm chung hoặc khác biệt. Khôi phục từng trường hợp, đối chiếu trên cùng tiêu chí rồi kiểm tra nhận định có thực sự phân biệt hoặc bao quát các trường hợp hay không.", "wrong_options": "Dùng điều đúng riêng cho một trường hợp làm đặc điểm chung, hoặc dùng nhân tố chung để trả lời yêu cầu tìm khác biệt.", "difficulty_source": "Phân biệt tính đúng nói chung với khả năng đáp ứng tiêu chí so sánh.", "discrimination": "medium", "typical_steps": 3, "refs": ["dff65825f390|P1|9|None", "dff65825f390|P1|20|None", "08c8696055dd|P1|15|None"]}, {"part_kind": "multiple_choice", "topic": "Ghép thiết chế với cấu trúc, mục tiêu và chức năng", "grade": 12, "construction": "Cho tên thiết chế, bộ phận cấu thành hoặc mục tiêu; yêu cầu ghép với thành tố tương ứng. Nhớ hệ thống phân loại rồi kiểm tra lĩnh vực, phạm vi và tính chất liên kết.", "wrong_options": "Hoán đổi mục tiêu giữa các lĩnh vực, nâng hoạt động chuyên biệt thành bộ phận chính thức, hoặc biến hợp tác thành liên kết đối đầu.", "difficulty_source": "Phân biệt tên gọi chính thức với khái niệm gần gũi và phân biệt chức năng chung với chức năng chuyên biệt.", "discrimination": "low", "typical_steps": 2, "refs": ["dff65825f390|P1|10|None", "08c8696055dd|P1|3|None", "08c8696055dd|P1|13|None", "08c8696055dd|P1|21|None"]}, {"part_kind": "multiple_choice", "topic": "Nhận diện nguyên tắc chính trị từ cơ sở hành động", "grade": 11, "construction": "Cho hành động xác lập quyền hoặc cơ sở liên kết chính trị; yêu cầu nhận diện nguyên tắc được thể hiện. Xác định bản chất chính trị, pháp lí rồi chọn cách khái quát phù hợp.", "wrong_options": "Thay nguyên tắc chính trị bằng lợi ích giao thương, biện pháp cưỡng chế hoặc sự lệ thuộc; các phương án cùng nói về quan hệ giữa các chủ thể nhưng khác bản chất.", "difficulty_source": "Chuyển từ biểu hiện cụ thể sang nguyên tắc và loại khái niệm thuộc lĩnh vực lân cận.", "discrimination": "medium", "typical_steps": 3, "refs": ["dff65825f390|P1|11|None", "08c8696055dd|P1|8|None"]}, {"part_kind": "multiple_choice", "topic": "Chọn định hướng vận dụng phù hợp với hoàn cảnh", "grade": 12, "construction": "Cho kinh nghiệm lịch sử hoặc cơ hội trong hoàn cảnh mới; yêu cầu chọn nguyên tắc hay giải pháp có thể vận dụng. Xác định yêu cầu của hoàn cảnh rồi chọn định hướng tác động đúng vào yêu cầu ấy.", "wrong_options": "Dùng sách lược gắn với hoàn cảnh riêng thay cho nguyên tắc lâu dài, đề xuất giải pháp cực đoan hoặc hiểu sai điều kiện hợp tác.", "difficulty_source": "Chọn đúng mức khái quát và nối bài học hoặc cơ hội với điều kiện thực hiện.", "discrimination": "medium", "typical_steps": 3, "refs": ["dff65825f390|P1|12|None", "08c8696055dd|P1|6|None"]}, {"part_kind": "multiple_choice", "topic": "Phân loại nội dung phát triển theo lĩnh vực", "grade": 12, "construction": "Giới hạn lĩnh vực cần hỏi rồi đưa các chủ trương hoặc thành tựu thuộc những lĩnh vực khác nhau. Xác định dấu hiệu của lĩnh vực đích và phân loại từng phương án.", "wrong_options": "Dùng nhận định có thể đúng nhưng thuộc lĩnh vực khác; trộn chuyển biến trong nước với quan hệ bên ngoài hoặc cơ chế cũ với định hướng cải cách.", "difficulty_source": "Độ gần nhau giữa các lĩnh vực và mức độ chuyên biệt mà câu hỏi yêu cầu.", "discrimination": "low", "typical_steps": 2, "refs": ["dff65825f390|P1|13|None", "08c8696055dd|P1|2|None", "08c8696055dd|P1|17|None"]}, {"part_kind": "multiple_choice", "topic": "Ghép hoạt động với giai đoạn và nhiệm vụ", "grade": 12, "construction": "Cho giai đoạn cùng nhiệm vụ, địa bàn hoặc mục tiêu; yêu cầu chọn hoạt động thỏa mãn các giới hạn. Định vị hoạt động trong tiến trình rồi kiểm tra đồng thời thời gian và chức năng.", "wrong_options": "Lấy hoạt động có thật ở chặng trước hoặc sau, hoặc cùng chủ thể nhưng phục vụ nhiệm vụ khác.", "difficulty_source": "Không thể chọn chỉ vì nhận ra hoạt động quen thuộc; phải kiểm tra toàn bộ giới hạn.", "discrimination": "medium", "typical_steps": 3, "refs": ["dff65825f390|P1|14|None", "08c8696055dd|P1|5|None", "08c8696055dd|P1|10|None", "08c8696055dd|P1|16|None"]}, {"part_kind": "multiple_choice", "topic": "Loại trường hợp không thuộc nhóm lịch sử", "grade": [11, 12], "construction": "Cho nhóm trường hợp được giới hạn bằng thời gian, hoạt động, kết quả hoặc ý nghĩa; yêu cầu tìm trường hợp nằm ngoài nhóm. Nhận diện phủ định rồi kiểm tra từng trường hợp theo đúng tiêu chí.", "wrong_options": "Các trường hợp phù hợp trở thành nhiễu; người học dễ loại chúng vì nhớ sai kết quả, khác biệt đường lối hoặc hiểu hẹp loại hoạt động.", "difficulty_source": "Giữ ổn định tiêu chí phân nhóm và không bỏ sót yêu cầu loại trừ.", "discrimination": "low", "typical_steps": 3, "refs": ["dff65825f390|P1|15|None", "08c8696055dd|P1|1|None", "08c8696055dd|P1|12|None"]}, {"part_kind": "multiple_choice", "topic": "Chọn đóng góp hoặc nhân tố đúng với vai trò được hỏi", "grade": 12, "construction": "Cho chủ thể hoặc hệ thống nguyên nhân cùng vai trò cần xác định; yêu cầu chọn đóng góp trực tiếp hoặc nhân tố giữ vị trí ưu tiên. Phân biệt điều có giá trị với điều thực sự đáp ứng quan hệ được hỏi.", "wrong_options": "Dùng đóng góp ở nhiệm vụ khác, điều kiện hỗ trợ hoặc phương thức huy động sức mạnh thay cho vai trò trọng tâm.", "difficulty_source": "Phân biệt sự liên quan với tính trực tiếp và phân biệt tầm quan trọng với vị trí quyết định.", "discrimination": "low", "typical_steps": 2, "refs": ["dff65825f390|P1|16|None", "08c8696055dd|P1|5|None"]}, {"part_kind": "multiple_choice", "topic": "Nhận diện chiều hướng phát triển từ bối cảnh và thành tựu", "grade": 11, "construction": "Cho biến động của môi trường hoặc kết quả cải cách; yêu cầu chọn xu hướng hay triển vọng phù hợp. Xác định chiều chuyển biến rồi đối chiếu kết luận với định hướng phát triển đã học.", "wrong_options": "Đảo chiều cải cách, khôi phục cơ chế cũ hoặc dùng kết luận khủng hoảng bao trùm để phủ nhận dữ kiện tích cực.", "difficulty_source": "Nhận ra quan hệ giữa chiều hướng dữ kiện và mức khái quát của kết luận.", "discrimination": "low", "typical_steps": 2, "refs": ["dff65825f390|P1|17|None", "08c8696055dd|P1|18|None"]}, {"part_kind": "multiple_choice", "topic": "Phân biệt các cấp độ khái niệm chính sách", "grade": 12, "construction": "Đưa các diễn đạt đều có vẻ tích cực hoặc liên quan; yêu cầu chọn đúng nguyên tắc, nội dung chuyên biệt hay biểu hiện trực tiếp. Xác định cấp độ khái niệm trước khi đánh giá nội dung phương án.", "wrong_options": "Thay nguyên tắc bằng biện pháp, thay nội dung chuyên biệt bằng phương châm chung hoặc thay biểu hiện trực tiếp bằng thành tựu tổng thể.", "difficulty_source": "Các phương án gần nhau về ý nghĩa nhưng khác cấp độ khái quát.", "discrimination": "medium", "typical_steps": 2, "refs": ["dff65825f390|P1|18|None", "08c8696055dd|P1|2|None", "08c8696055dd|P1|17|None"]}, {"part_kind": "multiple_choice", "topic": "Kiểm tra tính phù hợp của định hướng phát triển và hợp tác", "grade": 12, "construction": "Cho bối cảnh quốc tế và các định hướng phát triển; yêu cầu chọn định hướng phù hợp. Kiểm tra cả trọng tâm phát triển lẫn cách quan hệ với bên ngoài, tránh chấp nhận phương án chỉ đúng ở phần đầu.", "wrong_options": "Ghép hợp tác với phụ thuộc hoặc liên kết quân sự; đảo chiều trọng tâm cạnh tranh hay suy từ tăng hợp tác đến xóa bỏ mọi mâu thuẫn.", "difficulty_source": "Kiểm tra toàn bộ quan hệ giữa các thành phần của phương án.", "discrimination": "medium", "typical_steps": 3, "refs": ["dff65825f390|P1|19|None", "08c8696055dd|P1|19|None"]}, {"part_kind": "multiple_choice", "topic": "Phân biệt vai trò của các hình thức và mặt trận đấu tranh", "grade": 12, "construction": "Cho các chặng hoặc tiến trình đấu tranh; yêu cầu xác định tư tưởng chung hay khác biệt trong phương thức tạo thắng lợi. Khôi phục vai trò của từng hình thức rồi xem chúng phối hợp như thế nào trong từng bối cảnh.", "wrong_options": "Hiểu tăng cường thành thay thế, tuyệt đối hóa riêng một lực lượng hoặc dùng công thức kết hợp chung thay cho quan hệ cụ thể.", "difficulty_source": "Phân biệt vai trò xuyên suốt với cách phối hợp thay đổi theo hoàn cảnh.", "discrimination": "medium", "typical_steps": 3, "refs": ["dff65825f390|P1|9|None", "dff65825f390|P1|20|None", "08c8696055dd|P1|15|None"]}, {"part_kind": "multiple_choice", "topic": "Định vị biến đổi lịch sử trong quan hệ trước sau", "grade": 12, "construction": "Cho thời cơ, sự ra đời hoặc sự kết thúc của một cấu trúc; yêu cầu chọn biến cố hay hệ quả phù hợp. Khôi phục trình tự rồi kiểm tra biến đổi nào trực tiếp tạo ra hoặc chấm dứt điều kiện đang xét.", "wrong_options": "Dùng hậu quả muộn thay cho biến đổi trực tiếp, đưa hiện tượng có trước thành hệ quả về sau hoặc nhầm lúc hình thành với giai đoạn tồn tại.", "difficulty_source": "Kết hợp niên biểu với chức năng của biến cố trong tiến trình.", "discrimination": "medium", "typical_steps": 3, "refs": ["dff65825f390|P1|21|None", "08c8696055dd|P1|9|None", "08c8696055dd|P1|11|None"]}, {"part_kind": "multiple_choice", "topic": "Giữ đúng phạm vi kết luận so với bằng chứng", "grade": [11, 12], "construction": "Cho tư liệu hoặc thành tựu lịch sử; yêu cầu chọn nhận định đúng phạm vi đối tượng, không gian hoặc mức độ hoàn thành. Xác định bằng chứng thực sự hỗ trợ điều gì rồi loại phần mở rộng không có căn cứ.", "wrong_options": "Mở rộng ảnh hưởng thành tính đại diện toàn diện, biến đóng góp từng bước thành hoàn tất hoặc lấy mục tiêu cuối cùng thay cho mục tiêu trực tiếp.", "difficulty_source": "Độ gần giữa phạm vi được chứng minh và phạm vi được phương án khẳng định.", "discrimination": "low", "typical_steps": 2, "refs": ["dff65825f390|P1|22|None", "08c8696055dd|P1|7|None", "08c8696055dd|P1|22|None"]}, {"part_kind": "multiple_choice", "topic": "Xác định cơ chế tác động từ đóng góp hoặc thắng lợi", "grade": 12, "construction": "Cho đóng góp hay thắng lợi cùng tư liệu định hướng; yêu cầu xác định tác động phù hợp. Định vị đóng góp trong bối cảnh rồi nối nó với đúng loại ảnh hưởng hoặc chuyển biến.", "wrong_options": "Chuyển ảnh hưởng sang lĩnh vực không liên quan, đảo khích lệ thành áp đặt hoặc gán tác động quân sự và ngoại giao của giai đoạn khác.", "difficulty_source": "Phải kiểm tra cơ chế tác động thay vì chỉ nhận ra sự kiện tích cực.", "discrimination": "medium", "typical_steps": 3, "refs": ["dff65825f390|P1|23|None", "08c8696055dd|P1|23|None"]}, {"part_kind": "multiple_choice", "topic": "Chọn căn cứ giải thích một đánh giá hoặc quyết định", "grade": 12, "construction": "Cho nhận định đánh giá hoặc quyết định hành động; yêu cầu chọn đóng góp hay tổ hợp điều kiện làm căn cứ. Xác định điều cần giải thích rồi tìm quan hệ trực tiếp từ bằng chứng đến kết luận.", "wrong_options": "Gán thành tựu không liên quan, dùng tính độc nhất thiếu căn cứ hoặc thay nguyên nhân được xác lập bằng lợi thế suy đoán.", "difficulty_source": "Phân biệt căn cứ giải thích thực sự với thông tin có vẻ thuận lợi nhưng thiếu cầu nối.", "discrimination": "low", "typical_steps": 2, "refs": ["dff65825f390|P1|24|None", "08c8696055dd|P1|24|None"]}, {"part_kind": "true_false", "topic": "Đối chiếu nhận định trực tiếp với tư liệu", "grade": 12, "construction": "Cho tư liệu chứa dấu hiệu hoặc quan hệ cần kiểm tra; yêu cầu đánh giá nhận định diễn giải lại hay trái với nội dung ấy. Tìm ý liên quan rồi đối chiếu đối tượng, phạm vi và quan hệ.", "wrong_options": "Nhận định sai thu hẹp khái niệm hoặc phủ nhận khả năng đã được tư liệu xác nhận; nhận định đúng giữ sát nội dung được cung cấp.", "difficulty_source": "Mức độ trực tiếp của bằng chứng và khả năng nhận ra diễn đạt tương đương.", "discrimination": "low", "typical_steps": 2, "refs": ["dff65825f390|P2|1|a", "dff65825f390|P2|1|d", "dff65825f390|P2|2|b", "dff65825f390|P2|2|d", "dff65825f390|P2|3|d", "dff65825f390|P2|4|c", "08c8696055dd|P2|2|a"]}, {"part_kind": "true_false", "topic": "Khái quát chiều hướng từ tập hợp dữ kiện", "grade": 12, "construction": "Cho bảng hoặc chuỗi hoạt động cùng chiều; yêu cầu đánh giá nhận xét tổng hợp. Phân loại dữ kiện, xác định chiều chuyển biến rồi kiểm tra phạm vi khái quát.", "wrong_options": null, "difficulty_source": "Phân biệt điều được dữ kiện trực tiếp hỗ trợ với đánh giá cần thêm kiến thức nền; có hàng được khóa chấp nhận nhưng bằng chứng trực tiếp chưa đầy đủ.", "discrimination": "medium", "typical_steps": 3, "refs": ["dff65825f390|P2|3|d", "08c8696055dd|P2|1|a", "08c8696055dd|P2|1|d"]}, {"part_kind": "true_false", "topic": "Liên hệ dữ kiện với nguyên tắc hoặc bài học", "grade": 12, "construction": "Cho tư liệu về hoạt động hoặc thay đổi phương thức; yêu cầu đánh giá nguyên tắc hay bài học được rút ra. Hiểu bản chất hoạt động rồi kiểm tra sự phù hợp ở cấp định hướng.", "wrong_options": "Nhận định sai đồng nhất thay đổi phương thức với thay đổi mục tiêu; nhận định đúng nối hành động với nguyên tắc phù hợp.", "difficulty_source": "Chuyển từ dữ kiện cụ thể sang định hướng và phân biệt mục tiêu với cách thực hiện.", "discrimination": "medium", "typical_steps": 3, "refs": ["dff65825f390|P2|2|a", "dff65825f390|P2|3|b", "08c8696055dd|P2|1|c"]}, {"part_kind": "true_false", "topic": "Bổ sung kiến thức nền để kiểm tra nhận định mở rộng", "grade": 12, "construction": "Cho tư liệu chỉ bao phủ một phần vấn đề; yêu cầu đánh giá nhận định về mục tiêu, chính sách, vị thế hoặc hệ quả rộng hơn. Xác định giới hạn tư liệu, huy động kiến thức chương trình rồi đối chiếu kết luận.", "wrong_options": "Có nhận định sai coi kết quả bộ phận là hoàn tất toàn bộ; với nhận định đúng, lỗi có thể là bác bỏ chỉ vì tư liệu không nêu trực tiếp.", "difficulty_source": "Nhận biết khi nào cần kiến thức ngoài tư liệu mà không coi phần bổ sung ấy là bằng chứng có sẵn trong đoạn trích.", "discrimination": "medium", "typical_steps": 3, "refs": ["dff65825f390|P2|1|b", "dff65825f390|P2|1|c", "dff65825f390|P2|3|a", "dff65825f390|P2|3|c", "dff65825f390|P2|4|d", "08c8696055dd|P2|1|a", "08c8696055dd|P2|1|d"]}, {"part_kind": "true_false", "topic": "Kiểm tra nhận định ghép có phần đúng che phần sai", "grade": 12, "construction": "Cho nhận định chứa các chi tiết hoặc quan hệ ghép lại. Tách từng thành phần, kiểm tra độc lập rồi đánh giá toàn bộ nhận định.", "wrong_options": "Ghép đóng góp có cơ sở với vai trò bị nâng quá mức, tên gọi phù hợp với thời lượng sai hoặc tác động hợp lí với nhân quả đảo ngược.", "difficulty_source": "Không để thành phần quen thuộc và đúng làm mất cảnh giác với phần còn lại.", "discrimination": "medium", "typical_steps": 3, "refs": ["dff65825f390|P2|2|c", "dff65825f390|P2|4|b", "08c8696055dd|P2|1|b"]}, {"part_kind": "true_false", "topic": "Kiểm tra niên biểu và ranh giới hoàn thành", "grade": 12, "construction": "Cho tư liệu có trình tự cùng nhận định về thời điểm, thời lượng hoặc kết quả. Tách sự kiện khỏi quá trình, xác định điều đã hoàn thành và điều còn tiếp diễn rồi đối chiếu niên biểu.", "wrong_options": "Nén quá trình thành kết quả tức thời, lấy thời lượng của quá trình gán cho sự kiện hoặc dùng sự kiện sau làm cơ sở cho sự kiện trước.", "difficulty_source": "Kết hợp trí nhớ niên biểu với phân biệt tiền đề, bước chuyển và kết quả hoàn chỉnh.", "discrimination": "medium", "typical_steps": 3, "refs": ["dff65825f390|P2|1|b", "dff65825f390|P2|1|c", "dff65825f390|P2|4|a", "dff65825f390|P2|4|b", "08c8696055dd|P2|1|b", "08c8696055dd|P2|2|a"]}, {"part_kind": "true_false", "topic": "Đánh giá quan hệ nhân quả và mức độ tác động", "grade": 12, "construction": "Cho hoạt động hoặc thỏa thuận cùng nhận định về hệ quả. Xác định cơ chế tác động, kiểm tra trình tự và mức độ vai trò rồi đánh giá kết luận.", "wrong_options": "Đảo trước sau thành nhân quả, nâng đóng góp thành vai trò quyết định hoặc chỉ xét một chiều của tác động.", "difficulty_source": "Phân biệt quan hệ có cơ sở với liên hệ có vẻ hợp lí; kết luận mở rộng có thể cần kiến thức ngoài tư liệu.", "discrimination": "medium", "typical_steps": 3, "refs": ["dff65825f390|P2|2|c", "dff65825f390|P2|4|c", "dff65825f390|P2|4|d", "08c8696055dd|P2|1|b", "08c8696055dd|P2|1|d"]}], "discrimination_moves": [{"move": "Đặt phương án đúng kiến thức nhưng sai yêu cầu cạnh đáp án", "how_to_apply": "Giữ các phương án liên quan và có cơ sở, nhưng chỉ đáp án đáp ứng đúng lĩnh vực, tiêu chí so sánh hoặc cấp độ khái niệm được hỏi.", "refs": ["dff65825f390|P1|18|None", "08c8696055dd|P1|2|None", "08c8696055dd|P1|15|None"]}, {"move": "Buộc kiểm tra toàn bộ phương án hoặc nhận định", "how_to_apply": "Ghép thành phần có cơ sở với thành phần sai về vai trò, nguyên tắc hoặc trình tự; bảo đảm lỗi nằm ở nội dung có thể kiểm tra.", "refs": ["dff65825f390|P1|19|None", "dff65825f390|P2|2|c", "08c8696055dd|P2|1|b"]}, {"move": "Phân biệt kết quả bộ phận với mức hoàn thành toàn bộ", "how_to_apply": "Đặt các mức độ đóng góp hoặc hoàn thành gần nhau; yêu cầu xác định nhiệm vụ còn lại thay vì chỉ nhận ra thắng lợi.", "refs": ["dff65825f390|P2|1|b", "dff65825f390|P2|1|c", "dff65825f390|P2|4|a", "08c8696055dd|P1|7|None"]}, {"move": "Dùng niên biểu để kiểm tra lời giải thích có vẻ hợp lí", "how_to_apply": "Cho dữ kiện đủ định vị trình tự; tạo nhận định nối các sự kiện có liên quan nhưng đảo điều kiện và hệ quả hoặc dịch tác động sang giai đoạn khác.", "refs": ["dff65825f390|P1|21|None", "08c8696055dd|P1|11|None", "08c8696055dd|P1|23|None", "08c8696055dd|P2|1|b"]}, {"move": "Tìm mức khái quát đứng vững qua các bối cảnh", "how_to_apply": "Đặt các giai đoạn hoặc tiến trình cạnh nhau; phân biệt nguyên tắc chung với sách lược, hình thức đấu tranh và quan hệ phối hợp riêng.", "refs": ["dff65825f390|P1|9|None", "dff65825f390|P1|12|None", "dff65825f390|P1|20|None", "08c8696055dd|P1|15|None"]}, {"move": "Phân biệt bằng chứng trực tiếp với kiến thức bổ sung", "how_to_apply": "Để nhận định đòi hỏi liên hệ ngoài đoạn trích, nhưng xác định rõ kiến thức nền cần dùng; không coi sự vắng mặt trong tư liệu là phản chứng và không coi khóa là bằng chứng thay thế.", "refs": ["dff65825f390|P2|3|a", "dff65825f390|P2|3|c", "dff65825f390|P2|4|d", "08c8696055dd|P2|1|a"]}], "easy_vs_hard": [{"topic": "Hoạt động quân sự và bước phát triển của đấu tranh", "easy": "Ghép dấu hiệu định danh hoặc hệ quả quen thuộc với sự kiện; nhiễu có thể loại bằng giới hạn thời gian.", "hard": "Xác định chính xác cấp độ chuyển biến và quan hệ với các bước phát triển quân sự, ngoại giao.", "easy_refs": ["dff65825f390|P1|7|None", "08c8696055dd|P1|4|None"], "hard_refs": ["08c8696055dd|P1|23|None"]}, {"topic": "Đường lối và thành tựu cải cách", "easy": "Chọn nội dung đúng lĩnh vực khi các phương án lệch lĩnh vực khá rõ.", "hard": "Phân biệt biểu hiện trực tiếp với thành tựu tổng thể hoặc nguyên tắc với biện pháp có cách diễn đạt gần nhau.", "easy_refs": ["dff65825f390|P1|13|None", "08c8696055dd|P1|17|None"], "hard_refs": ["dff65825f390|P1|18|None", "08c8696055dd|P1|2|None"]}, {"topic": "Quan hệ quốc tế và hoạt động đối ngoại", "easy": "Nhận diện chức năng quen thuộc hoặc đối chiếu nhận định với ý được tư liệu nêu trực tiếp.", "hard": "Kiểm tra vai trò trong nhận định ghép và quan hệ nhân quả giữa các bước mở rộng quan hệ.", "easy_refs": ["08c8696055dd|P1|13|None", "dff65825f390|P2|2|b", "dff65825f390|P2|2|d"], "hard_refs": ["dff65825f390|P2|2|c", "08c8696055dd|P2|1|b"]}, {"topic": "Tiến trình hình thành và biến đổi cục diện", "easy": "Nhớ sự kiện hoặc nhận ra quan hệ nguyên nhân đã được trình bày trực tiếp.", "hard": "Phân biệt đặt nền tảng với hoàn tất quá trình, hoặc kiểm tra đồng thời niên biểu và chiều tác động.", "easy_refs": ["dff65825f390|P2|4|b", "dff65825f390|P2|4|c", "08c8696055dd|P1|9|None"], "hard_refs": ["dff65825f390|P2|4|a", "dff65825f390|P2|4|d", "08c8696055dd|P1|11|None"]}, {"topic": "Đọc tư liệu về mục tiêu và kết quả đấu tranh", "easy": "Tìm mục tiêu hoặc căn cứ được nêu ngay trong tư liệu.", "hard": "Dùng kiến thức tiến trình để phân biệt thắng lợi từng phần với hoàn thành mục tiêu và so sánh phương thức kết thúc.", "easy_refs": ["08c8696055dd|P1|22|None", "08c8696055dd|P1|24|None"], "hard_refs": ["dff65825f390|P2|1|b", "dff65825f390|P2|1|c", "08c8696055dd|P1|15|None"]}], "fact_use": {"common": [{"use": "Mốc thời gian và tên gọi làm dấu hiệu nhận diện sự kiện; nhiều câu kiểm tra liên hệ giữa dữ kiện và sự kiện thay vì yêu cầu tự viết lại dữ kiện.", "refs": ["dff65825f390|P1|7|None", "08c8696055dd|P1|14|None", "08c8696055dd|P1|20|None", "08c8696055dd|P2|2|a"]}, {"use": "Niên biểu là công cụ kiểm tra sự phù hợp của hoạt động, phát hiện hồi chiếu và bác bỏ nhân quả đảo ngược.", "refs": ["dff65825f390|P1|14|None", "dff65825f390|P1|15|None", "08c8696055dd|P1|10|None", "08c8696055dd|P1|16|None", "08c8696055dd|P2|1|b"]}, {"use": "Tên nhân vật gắn với nhiệm vụ, giai đoạn và đóng góp; biết tên chưa đủ nếu không phân biệt loại hoạt động hoặc cơ sở của sự ghi nhận.", "refs": ["dff65825f390|P1|15|None", "dff65825f390|P1|24|None", "08c8696055dd|P1|5|None", "08c8696055dd|P1|16|None"]}, {"use": "Khái niệm và định nghĩa được dùng để phân loại mục tiêu, lĩnh vực, nguyên tắc và cấp độ vai trò; nhiễu thường thay bằng khái niệm gần nhưng sai phạm vi.", "refs": ["dff65825f390|P1|10|None", "dff65825f390|P1|18|None", "dff65825f390|P2|3|b", "08c8696055dd|P1|2|None", "08c8696055dd|P1|3|None"]}, {"use": "Kiến thức ghi nhớ có thể nằm ngoài tư liệu và cần để kiểm tra chính sách, mục tiêu hoặc hệ quả; có hàng không được đoạn trích chứng minh đầy đủ.", "refs": ["dff65825f390|P2|3|a", "dff65825f390|P2|3|c", "dff65825f390|P2|4|d", "08c8696055dd|P2|1|a", "08c8696055dd|P2|1|d"]}], "not_observed": [{"use": "Không thấy yêu cầu tái hiện tự do chuỗi mốc, tên gọi hoặc định nghĩa; các dữ kiện được xử lí trong lựa chọn đáp án và đánh giá nhận định.", "refs": ["dff65825f390|P1|7|None", "dff65825f390|P2|4|b", "08c8696055dd|P1|3|None", "08c8696055dd|P1|16|None"]}, {"use": "Không thấy dùng số liệu làm đầu vào cho phép tính; bảng được khai thác để đọc chiều hướng, phân loại chuyển biến và liên hệ kiến thức.", "refs": ["dff65825f390|P2|3|a", "dff65825f390|P2|3|b", "dff65825f390|P2|3|c", "dff65825f390|P2|3|d"]}, {"use": "Không thấy yêu cầu truy tìm dữ kiện ngoài chương trình bằng tra cứu độc lập hoặc xác minh xuất xứ tư liệu; thao tác ngoài đoạn trích được mô tả là huy động kiến thức nền.", "refs": ["dff65825f390|P2|3|a", "dff65825f390|P2|4|d", "08c8696055dd|P2|1|d"]}]}, "anti_patterns": [{"avoid": "Biến hồ sơ này thành câu tự luận mở hoặc yêu cầu tự tạo câu trả lời dài.", "basis": "Trong tập hàng được cung cấp, đầu ra của người làm bài là lựa chọn phương án hoặc đánh giá nhận định.", "refs": ["dff65825f390|P1|9|None", "dff65825f390|P2|2|c", "08c8696055dd|P1|15|None", "08c8696055dd|P2|1|b"]}, {"avoid": "Tạo bài tính toán từ bảng chỉ để làm câu khó hơn.", "basis": "Các hàng về bảng khai thác thay đổi cơ chế, chiều hướng phát triển và kiến thức nền; không mô tả phép tính.", "refs": ["dff65825f390|P2|3|a", "dff65825f390|P2|3|b", "dff65825f390|P2|3|c", "dff65825f390|P2|3|d"]}, {"avoid": "Yêu cầu người làm bài tự sáng tác phương án chính sách hoặc kế hoạch hành động.", "basis": "Các câu vận dụng yêu cầu chọn hoặc đánh giá định hướng đã được đưa ra.", "refs": ["dff65825f390|P1|12|None", "dff65825f390|P2|2|a", "08c8696055dd|P1|6|None"]}, {"avoid": "Đòi hỏi phê bình độ tin cậy, thiên kiến hoặc đối chiếu xuất xứ của các nguồn.", "basis": "Các hàng đọc tư liệu mô tả việc tìm ý, kiểm tra phạm vi và liên hệ kiến thức; không mô tả yêu cầu thẩm định nguồn.", "refs": ["dff65825f390|P1|22|None", "dff65825f390|P2|4|d", "08c8696055dd|P1|24|None", "08c8696055dd|P2|1|d"]}, {"avoid": "Đưa lời giải hoặc lập luận tự viết của người làm bài thành sản phẩm bắt buộc.", "basis": "Chuỗi suy luận nằm sau thao tác chọn đáp án hay đánh giá nhận định; các hàng không yêu cầu trình bày chứng minh.", "refs": ["dff65825f390|P1|20|None", "dff65825f390|P2|4|d", "08c8696055dd|P1|15|None", "08c8696055dd|P2|1|b"]}]}, {"patterns": [], "discrimination_moves": [], "easy_vs_hard": [{"topic": "Ý nghĩa và hệ quả của thắng lợi quân sự", "easy": "Bác bỏ nhận định nâng một bước chuyển của tiến trình lên thành sự hoàn tất toàn bộ mục tiêu.", "hard": "Đánh giá hệ quả chiến lược đồng thời giữ đúng giới hạn địa bàn mà hệ quả đó có hiệu lực.", "difficulty_note": "Dạng khó hơn ở đây được dữ liệu đánh giá ở mức phân hóa trung bình.", "easy_refs": ["08c8696055dd|P2|2|d"], "hard_refs": ["08c8696055dd|P2|2|c"]}, {"topic": "Nhận diện tính chất và ý nghĩa của hoạt động quân sự", "easy": "Phân biệt ý nghĩa tạo chuyển biến với ý nghĩa kết thúc tiến trình.", "hard": "Tách nhận định thành các vế, kiểm tra thuật ngữ về thế chủ động và kiểm tra kết quả độc lập trước khi kết luận.", "difficulty_note": "Độ khó tăng do một vế đúng có thể che khuất một vế sai.", "easy_refs": ["08c8696055dd|P2|2|d"], "hard_refs": ["08c8696055dd|P2|2|b"]}, {"topic": "Nhân tố định hình quan hệ quốc tế", "easy": "Đối chiếu nhận định với quan hệ giữa thực lực và cấu trúc quốc tế được trình bày trực tiếp trong tư liệu.", "hard": "Kết hợp tư liệu với kiến thức nền để suy từ sự gia tăng thực lực sang vai trò của các trung tâm trong quan hệ quốc tế.", "difficulty_note": "Dạng khó hơn đòi hỏi khái quát vượt ra ngoài diễn giải trực tiếp tư liệu.", "easy_refs": ["08c8696055dd|P2|4|b"], "hard_refs": ["08c8696055dd|P2|4|c"]}], "fact_use": {"observed": [{"use": "Mốc thời gian được dùng để định vị giai đoạn và phát hiện việc gán sai bối cảnh lịch sử.", "refs": ["08c8696055dd|P2|4|a"]}, {"use": "Khái niệm đã học được dùng để kiểm tra chính xác thuật ngữ trong nhận định, kể cả khi phần mô tả kết quả vẫn đúng.", "refs": ["08c8696055dd|P2|2|b"]}, {"use": "Kiến thức ghi nhớ về kết quả và ý nghĩa được dùng để kiểm tra phạm vi tác động và mức độ khái quát.", "refs": ["08c8696055dd|P2|2|c", "08c8696055dd|P2|2|d"]}, {"use": "Thành tựu và nguyên tắc đã học bổ sung cho tư liệu khi đoạn trích không trực tiếp cung cấp đủ căn cứ để đánh giá nhận định.", "refs": ["08c8696055dd|P2|3|b", "08c8696055dd|P2|3|c", "08c8696055dd|P2|4|c"]}, {"use": "Từ khóa và quan hệ được nêu trong tư liệu làm điểm tựa để nhận diện chủ đề, đối chiếu diễn giải hoặc rút ra khái quát.", "refs": ["08c8696055dd|P2|3|a", "08c8696055dd|P2|3|d", "08c8696055dd|P2|4|b", "08c8696055dd|P2|4|d"]}], "not_observed": [{"claim": "Không thấy yêu cầu trả lời độc lập bằng cách chép lại ngày tháng, số liệu hoặc tên riêng; những dữ kiện được mô tả phục vụ việc đánh giá nhận định.", "scope": "Chỉ áp dụng cho các dòng được cung cấp.", "refs": ["08c8696055dd|P2|2|b", "08c8696055dd|P2|2|c", "08c8696055dd|P2|2|d", "08c8696055dd|P2|3|a", "08c8696055dd|P2|3|b", "08c8696055dd|P2|3|c", "08c8696055dd|P2|3|d", "08c8696055dd|P2|4|a", "08c8696055dd|P2|4|b", "08c8696055dd|P2|4|c", "08c8696055dd|P2|4|d"]}], "limit": "Không đủ căn cứ để xác định cách dùng dữ kiện nào phổ biến giữa các đề hoặc khẳng định điều gì không bao giờ xuất hiện."}, "anti_patterns": [{"avoid": "Thiết kế lỗi sai chỉ bằng cách thay dữ kiện rời rạc.", "basis": "Các nhận định sai được mô tả còn khai thác sự nhầm lẫn khái niệm, phóng đại ý nghĩa, suy diễn quan hệ tất yếu và gán sai giai đoạn.", "scope": "Đây là cảnh báo dựa trên các cơ chế lỗi quan sát được, không phải kết luận rằng toàn bộ đề không có lỗi sai về dữ kiện.", "refs": ["08c8696055dd|P2|2|b", "08c8696055dd|P2|2|d", "08c8696055dd|P2|3|b", "08c8696055dd|P2|4|a"]}, {"avoid": "Mặc định mọi nhận định đều có thể giải chỉ bằng cách đọc lại tư liệu.", "basis": "Có nhận định cần kiến thức nền hoặc mở rộng từ tư liệu sang kiến thức bài học.", "scope": "Chỉ kết luận về yêu cầu suy luận trong các dòng được dẫn.", "refs": ["08c8696055dd|P2|3|b", "08c8696055dd|P2|3|c", "08c8696055dd|P2|4|c"]}, {"avoid": "Coi một vế đúng là đủ để xác nhận toàn bộ nhận định.", "basis": "Có cấu trúc giữ đúng kết quả nhưng thay sai thuật ngữ mô tả tính chất.", "scope": "Đây là cơ chế quan sát riêng lẻ, chưa đủ chứng minh tính lặp lại giữa các đề.", "refs": ["08c8696055dd|P2|2|b"]}], "evidence_limits": {"patterns": "Các dòng chỉ thuộc cùng một đề. Theo điều kiện bằng chứng, quan sát trong một đề chưa chứng minh tính lặp lại; vì vậy không thể lập danh sách mẫu lặp lại đạt yêu cầu mà không suy diễn.", "discrimination_moves": "Không có dòng nào được gắn mức phân hóa cao, nên chưa có căn cứ rút ra các thủ pháp riêng của nhóm đó.", "anti_patterns": "Dữ liệu trích đoạn không đủ chứng minh những điều các đề tuyệt đối không làm. Các mục nêu trên chỉ giới hạn ở cơ chế được quan sát và cách diễn giải sai cần tránh."}}]
