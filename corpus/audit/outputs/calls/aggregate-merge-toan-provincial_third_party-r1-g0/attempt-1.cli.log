0968e8bc9e2d|P3|2|None", "9ed45d16a975|P3|1|None", "9ed45d16a975|P3|3|None", "7ab78715480e|P2|1|a", "7ab78715480e|P2|4|b", "7ab78715480e|P3|3|None", "3f1b2aa3cb72|P2|1|a", "beee25b53250|P2|3|a", "beee25b53250|P3|3|None", "beee25b53250|P3|5|None", "3f1b2aa3cb72|P3|6|None", "acc00d945397|P3|4|None", "acc00d945397|P3|5|None"]}, {"use": "Không quan sát thấy yêu cầu chép nguyên văn định nghĩa, kể lịch sử khái niệm hoặc chứng minh lại công thức như sản phẩm trả lời; kiến thức được dùng để chọn, kiểm tra và tính.", "refs": ["54e9a2a276ca|P1|2|None", "0968e8bc9e2d|P1|5|None", "fc12a8146279|P2|1|d", "54e9a2a276ca|P3|5|None", "525d3542283a|P1|6|None", "9ed45d16a975|P1|7|None", "0968e8bc9e2d|P1|12|None", "beee25b53250|P1|2|None", "acc00d945397|P1|5|None", "acc00d945397|P1|6|None", "beee25b53250|P2|2|c"]}, {"use": "Không quan sát thấy yêu cầu tự tra các định mức hoặc thông số ngoài dữ kiện mô hình đã cho.", "refs": ["acc00d945397|P2|2|b", "acc00d945397|P3|3|None", "3b4cca11ea82|P3|3|None", "3b4cca11ea82|P3|4|None"]}], "limit": "Chỉ khái quát các hàng cấp tỉnh bên thứ ba được cung cấp, không trộn với bằng chứng chính thức. Đây là hợp nhất ngữ cảnh, không thêm bằng chứng hay suy tần suất. Tái diễn chỉ dựa trên refs thuộc các đề khác nhau; nhiều ý cùng đề không độc lập. Mức phân hóa là nhận định định tính, không phải đo thực nghiệm. Không quan sát thấy trong tập hàng không có nghĩa là không bao giờ xuất hiện."}, "anti_patterns": [{"avoid": "Đặt kiến thức thực tế ngoài đề làm điều kiện ngầm hoặc thay suy luận toán bằng kể lại kiến thức nền.", "basis": "Các hàng mô hình cung cấp dữ kiện định lượng để giải; không quan sát thấy bước tra cứu sự kiện hay thông tin chuyên ngành ngoài mô hình.", "refs": ["fc12a8146279|P3|2|None", "fc12a8146279|P3|4|None", "54e9a2a276ca|P3|6|None", "0968e8bc9e2d|P3|2|None", "9ed45d16a975|P2|3|b", "9ed45d16a975|P3|1|None", "525d3542283a|P2|2|a", "7ab78715480e|P2|4|c", "7ab78715480e|P3|3|None", "3f1b2aa3cb72|P2|1|a", "beee25b53250|P3|3|None", "beee25b53250|P3|5|None", "3f1b2aa3cb72|P3|6|None"]}, {"avoid": "Tạo độ khó chỉ bằng lời văn dài, phép tính dài hoặc kiến thức chuyên biệt không được bằng chứng hỗ trợ.", "basis": "Các nút thắt được mô tả là dựng mô hình, chọn biểu diễn, phân hoạch, cập nhật điều kiện, phép chiếu, trọng số, phản xạ hoặc xác định miền; chưa có bằng chứng độ dài tự nó tạo phân hóa.", "refs": ["fc12a8146279|P3|3|None", "fc12a8146279|P3|5|None", "54e9a2a276ca|P3|2|None", "54e9a2a276ca|P2|4|d", "0968e8bc9e2d|P3|3|None", "9ed45d16a975|P2|2|d", "9ed45d16a975|P2|4|d", "9ed45d16a975|P3|6|None", "525d3542283a|P3|1|None", "525d3542283a|P3|3|None", "7ab78715480e|P3|1|None", "7ab78715480e|P3|6|None", "3f1b2aa3cb72|P2|3|d", "3f1b2aa3cb72|P3|1|None", "3f1b2aa3cb72|P3|3|None", "beee25b53250|P3|2|None", "beee25b53250|P3|4|None", "beee25b53250|P3|6|None", "acc00d945397|P2|4|c", "3b4cca11ea82|P3|2|None", "3b4cca11ea82|P3|3|None", "3b4cca11ea82|P3|5|None"]}, {"avoid": "Cho hình phối cảnh hoặc một dấu hiệu cục bộ thay thế điều kiện và đối tượng cần xét.", "basis": "Vuông góc và phép chiếu cần suy từ giả thiết; các biểu diễn còn đòi phân biệt đường đứng với ngang, họ đồ thị, tọa độ điểm và vectơ.", "refs": ["54e9a2a276ca|P1|1|None", "0968e8bc9e2d|P1|1|None", "0968e8bc9e2d|P1|8|None", "3b4cca11ea82|P1|7|None", "de5833d227dd|P1|5|None", "de5833d227dd|P1|10|None"]}, {"avoid": "Mặc định hình minh họa luôn chứa dữ kiện bắt buộc hoặc luôn chỉ trang trí.", "basis": "Có hàng dùng hình để xác định miền và kích thước, có hàng văn bản đã đủ. Không tự bổ sung dữ kiện định lượng từ hình.", "refs": ["0968e8bc9e2d|P3|1|None", "0968e8bc9e2d|P3|6|None", "9ed45d16a975|P2|1|a", "9ed45d16a975|P2|3|a", "3f1b2aa3cb72|P2|2|a", "3f1b2aa3cb72|P2|2|b", "3f1b2aa3cb72|P2|2|c", "3f1b2aa3cb72|P2|2|d", "3f1b2aa3cb72|P3|4|None"]}, {"avoid": "Biến mọi yêu cầu ứng dụng thành thế trực tiếp vào công thức hoặc dùng dữ kiện mô hình chỉ làm phần dẫn.", "basis": "Các hàng khó có bước dựng hàm hay phương trình phụ; đơn vị, giới hạn và quan hệ kích thước tham gia trực tiếp vào suy luận.", "refs": ["0968e8bc9e2d|P3|6|None", "9ed45d16a975|P3|6|None", "acc00d945397|P2|2|d", "acc00d945397|P3|1|None", "3b4cca11ea82|P2|4|d", "3b4cca11ea82|P3|3|None"]}, {"avoid": "Kết thúc tối ưu ngay khi có nghiệm đại số.", "basis": "Còn phải xét tính khả thi, biên, tính nguyên, toàn bộ tập đạt cực trị hoặc phương án cạnh tranh.", "refs": ["acc00d945397|P2|4|c", "acc00d945397|P2|4|d", "3b4cca11ea82|P3|3|None", "3b4cca11ea82|P3|4|None"]}, {"avoid": "Gán chắc chắn một lỗi tư duy cho mọi nhiễu hoặc tạo nhiễu không liên hệ biểu diễn đã cho.", "basis": "Lựa chọn có thể biến đổi cục bộ dấu, hệ số, thành phần hoặc lấy mốc trên biểu diễn, nhưng thiếu khóa và giá trị sai không có nguồn duy nhất không xác nhận được cơ chế cụ thể.", "refs": ["beee25b53250|P1|10|None", "acc00d945397|P1|2|None", "acc00d945397|P1|3|None", "acc00d945397|P1|5|None", "acc00d945397|P1|6|None", "acc00d945397|P2|1|d", "3b4cca11ea82|P2|2|c", "3b4cca11ea82|P2|4|d", "de5833d227dd|P1|2|None"]}, {"avoid": "Thay kết quả toán học xác định bằng nghị luận mở hoặc buộc trả lời ngắn thành bài chứng minh dài.", "basis": "Các hàng yêu cầu chọn, kiểm tra hoặc trả kết quả định lượng; chuỗi suy luận dài thuộc quá trình giải, không mặc nhiên là sản phẩm tự luận phải nộp.", "refs": ["fc12a8146279|P3|6|None", "54e9a2a276ca|P3|4|None", "54e9a2a276ca|P3|5|None", "0968e8bc9e2d|P3|3|None", "0968e8bc9e2d|P3|5|None", "9ed45d16a975|P3|4|None", "9ed45d16a975|P3|5|None", "7ab78715480e|P1|11|None", "7ab78715480e|P2|4|d", "525d3542283a|P3|3|None", "7ab78715480e|P3|6|None", "3f1b2aa3cb72|P3|1|None", "3f1b2aa3cb72|P3|3|None", "3f1b2aa3cb72|P3|5|None", "3f1b2aa3cb72|P3|6|None", "beee25b53250|P3|3|None", "beee25b53250|P3|4|None"]}, {"avoid": "Dùng đại lượng chưa xác định duy nhất hoặc cơ chế chọn chưa rõ làm chuẩn thiết kế hay bằng chứng tái diễn.", "basis": "Giữ giới hạn về điều kiện duy nhất, miền biến và độc lập; không chữa thiếu dữ kiện bằng giả định ngầm hoặc suy từ mặc định phần mềm.", "refs": ["3f1b2aa3cb72|P2|4|d", "54e9a2a276ca|P2|3|d", "3b4cca11ea82|P2|3|d"]}]}]
