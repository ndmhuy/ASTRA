e0b94a82d|P3|5|None"]}], "scope": "Chỉ áp dụng cho các dòng thuộc lớp provincial_third_party được cung cấp; không suy rộng sang đề chính thức hoặc toàn bộ đề chưa có đủ dữ liệu. Các biến thể trong cùng một đề không tự tạo bằng chứng tái diễn giữa các đề."}, "anti_patterns": [{"avoid": "Để đáp án phụ thuộc kiến thức thực tế hoặc chuyên ngành ngoài dữ kiện được cấp.", "basis": "Các mô hình ứng dụng dùng quy luật và điều kiện đã cho; không có căn cứ biến tra cứu hoặc ghi nhớ dữ kiện ngoài toán thành chìa khóa ngầm.", "refs": ["adb051fd8253|P3|1|None", "adb051fd8253|P3|6|None", "85efdd1a7e54|P3|1|None", "85efdd1a7e54|P3|2|None", "85efdd1a7e54|P3|6|None", "ecd76ac672e5|P3|2|None", "ecd76ac672e5|P3|4|None", "6aa30214ba7e|P3|5|None", "c6340827ba59|P3|2|None", "c6340827ba59|P3|4|None", "ccae0b94a82d|P3|5|None"]}, {"avoid": "Thay nhiệm vụ toán học xác định bằng bình luận tự do, kể kiến thức nền hoặc yêu cầu tự luận dài chưa được quan sát.", "basis": "Các dòng kết thúc bằng lựa chọn, kiểm tra nhận định hoặc kết quả ngắn; không cung cấp căn cứ cho tiêu chí chấm ý kiến cá nhân hay chứng minh dài.", "refs": ["adb051fd8253|P1|12|None", "adb051fd8253|P2|1|d", "85efdd1a7e54|P2|3|d", "85efdd1a7e54|P3|6|None", "6aa30214ba7e|P2|2|d", "6aa30214ba7e|P2|4|c", "6aa30214ba7e|P3|1|None", "6aa30214ba7e|P3|4|None", "c6340827ba59|P1|7|None", "c6340827ba59|P2|1|c", "c6340827ba59|P3|1|None", "ccae0b94a82d|P3|3|None", "fc12a8146279|P1|7|None"]}, {"avoid": "Coi trường hợp thử, nghiệm biến đổi hoặc ứng viên tối ưu là kết luận cuối mà bỏ miền và điều kiện đạt.", "basis": "Các cấu trúc liên quan đòi hỏi kiểm tra toàn miền, biên, điều kiện nguyên, thời gian, phần quỹ đạo hoặc tính khả thi của đường đi.", "refs": ["adb051fd8253|P3|2|None", "85efdd1a7e54|P2|3|d", "85efdd1a7e54|P3|6|None", "6aa30214ba7e|P1|4|None", "ecd76ac672e5|P3|3|None", "6aa30214ba7e|P2|4|d", "6aa30214ba7e|P3|5|None", "6aa30214ba7e|P3|6|None", "c6340827ba59|P1|9|None", "c6340827ba59|P2|1|c", "c6340827ba59|P2|3|a", "c6340827ba59|P3|3|None", "ccae0b94a82d|P2|4|b", "ccae0b94a82d|P3|5|None"]}, {"avoid": "Bỏ hình chứa dữ kiện quyết định hoặc dùng vẻ ngoài phối cảnh thay điều kiện toán học.", "basis": "Hình có thể cung cấp dấu mốc, nhánh, biên và phía đặt đối tượng; song song, tiếp xúc và số đo vẫn phải được kiểm tra bằng quan hệ xác định.", "refs": ["adb051fd8253|P1|12|None", "adb051fd8253|P2|2|d", "adb051fd8253|P3|5|None", "85efdd1a7e54|P3|5|None", "ccae0b94a82d|P1|1|None", "ccae0b94a82d|P2|3|c", "ccae0b94a82d|P2|3|d"]}, {"avoid": "Gán cho mọi phương án nhiễu một sai lầm đặc trưng hoặc suy trạng thái đúng sai khi thiếu khóa.", "basis": "Ngay cả các dòng có khóa vẫn có lựa chọn chưa giải thích được bằng quy tắc nhầm lẫn rõ ràng; mô tả khả dĩ không tương đương cơ chế đã xác nhận.", "refs": ["adb051fd8253|P1|1|None", "adb051fd8253|P1|4|None", "adb051fd8253|P1|5|None", "adb051fd8253|P1|6|None", "adb051fd8253|P1|12|None"]}, {"avoid": "Tự thêm ràng buộc từ chi tiết gợi liên tưởng.", "basis": "Điều kiện bổ sung không được nêu có thể chính là cơ chế nhiễu, đặc biệt trong phép chọn có phân vai.", "refs": ["c6340827ba59|P1|1|None"]}, {"avoid": "Ấn định một công cụ giải duy nhất khi các biểu diễn tương đương đều đáp ứng yêu cầu.", "basis": "Các cấu trúc ghi nhận cách dùng hình học, vectơ, tọa độ, tích phân hoặc diện tích tương đương tùy đại lượng.", "refs": ["6aa30214ba7e|P2|4|c", "6aa30214ba7e|P3|1|None", "6aa30214ba7e|P3|3|None"]}, {"avoid": "Đổi bối cảnh rồi coi là cấu trúc xác suất mới hoặc thay lấy mẫu phụ thuộc bằng phép thử độc lập.", "basis": "Cấu trúc được phân biệt bởi cập nhật thành phần, hướng điều kiện và nguồn gốc; các yếu tố này quyết định chuỗi suy luận.", "refs": ["c6340827ba59|P3|1|None", "ccae0b94a82d|P2|1|b", "ccae0b94a82d|P2|1|c", "ccae0b94a82d|P2|1|d"]}]}, {"patterns": [{"part_kind": "multiple_choice", "topic": "Vuông góc giữa đường thẳng và mặt phẳng", "grade": 11, "construction": "Từ các quan hệ vuông góc đã cho, kiểm tra tiêu chuẩn qua các đường cắt nhau trong mặt phẳng rồi chọn khẳng định theo đúng chiều yêu cầu.", "wrong_options": "Kiểm tra thiếu phương, suy từ hình phối cảnh hoặc dùng tính chất chỉ đúng trong cấu hình đặc biệt; có thể chọn nhầm khẳng định đúng khi yêu cầu tìm khẳng định sai.", "difficulty_source": "Phân biệt giả thiết với quan hệ chỉ có vẻ đúng trên hình.", "discrimination": "medium", "typical_steps": 3, "refs": ["54e9a2a276ca|P1|1|None", "0968e8bc9e2d|P1|1|None"]}, {"part_kind": "multiple_choice", "topic": "Phương trình mũ và lôgarit cơ bản", "grade": 11, "construction": "Dùng quan hệ ngược giữa mũ và lôgarit hoặc quy về cùng cơ số để tách biểu thức bậc nhất chứa ẩn, giải rồi kiểm tra điều kiện.", "wrong_options": "Dừng ở giá trị trung gian, bỏ phần dịch chuyển, nhầm lũy thừa với phép nhân hoặc bỏ điều kiện đối số dương. Không phải mọi nhiễu đều xác định được lỗi nguồn.", "difficulty_source": "Phân biệt giá trị biểu thức trung gian với nghiệm cần tìm và giữ điều kiện xác định.", "discrimination": "low", "typical_steps": 3, "refs": ["54e9a2a276ca|P1|2|None", "0968e8bc9e2d|P1|9|None", "3b4cca11ea82|P1|9|None", "de5833d227dd|P1|2|None"]}, {"part_kind": "multiple_choice", "topic": "Bất phương trình lôgarit", "grade": 11, "construction": "Đặt điều kiện đối số dương, biến đổi theo tính đơn điệu của cơ số rồi giao nghiệm và kiểm tra đầu mút.", "wrong_options": "Bỏ phần dịch chuyển, xử lý sai chiều bất phương trình hoặc đồng nhất miền xác định với tập nghiệm; hàng thiếu khóa chưa xác nhận lỗi từng lựa chọn.", "difficulty_source": "Kiểm soát điều kiện, chiều biến đổi và việc lấy biên.", "discrimination": "low", "typical_steps": 3, "refs": ["7ab78715480e|P1|10|None", "3f1b2aa3cb72|P1|8|None"]}, {"part_kind": "multiple_choice", "topic": "Phương trình lượng giác cơ bản", "grade": 11, "construction": "Nhận diện các vị trí nghiệm tại giá trị đặc biệt, giải đối số nếu có dịch chuyển rồi viết đầy đủ các họ nghiệm với chu kỳ phù hợp.", "wrong_options": "Sai pha, sai dấu, đổi chu kỳ, bỏ họ nghiệm hoặc đưa điểm không xác định hay nghiệm trái dấu vào tập nghiệm.", "difficulty_source": "Phối hợp vị trí nghiệm, miền xác định và bước lặp.", "discrimination": "low", "typical_steps": 3, "refs": ["0968e8bc9e2d|P1|4|None", "9ed45d16a975|P1|7|None", "525d3542283a|P1|11|None", "3b4cca11ea82|P1|10|None", "de5833d227dd|P1|6|None"]}, {"part_kind": "multiple_choice", "topic": "Số hạng của cấp số nhân", "grade": 11, "construction": "Biểu diễn số hạng qua số hạng đầu và công bội; dùng dữ kiện để tìm công bội, chỉ số hoặc số hạng còn thiếu.", "wrong_options": "Dùng quy luật cộng, đảo tỉ số, bỏ số hạng đầu, lệch chỉ số hoặc chọn dấu công bội không phù hợp.", "difficulty_source": "Phân biệt vị trí số hạng với số lần nhân công bội.", "discrimination": "low", "typical_steps": 3, "refs": ["54e9a2a276ca|P1|12|None", "0968e8bc9e2d|P1|5|None", "3b4cca11ea82|P1|3|None", "de5833d227dd|P1|3|None"]}, {"part_kind": "multiple_choice", "topic": "Quan hệ giữa các số hạng cấp số cộng", "grade": 11, "construction": "Biểu diễn các số hạng theo số hạng đầu và công sai, chuyển quan hệ đã cho thành phương trình rồi suy đại lượng cần tìm.", "wrong_options": "Nhầm số hạng đầu với công sai, không chia hiệu số hạng cho chênh lệch chỉ số, đảo dấu hoặc lệch chỉ số.", "difficulty_source": "Giữ đúng khoảng cách chỉ số khi chuyển sang quan hệ tham số.", "discrimination": "low", "typical_steps": 3, "refs": ["9ed45d16a975|P1|11|None", "525d3542283a|P1|4|None"]}, {"part_kind": "multiple_choice", "topic": "Nguyên hàm cơ bản", "grade": 12, "construction": "Nhận dạng từng thành phần của hàm, áp dụng công thức nguyên hàm và tính tuyến tính rồi ghép kết quả với hằng số tùy ý.", "wrong_options": "Sai dấu hoặc hệ số, giữ nguyên thành phần lượng giác, bỏ nguyên hàm của hằng số hoặc dùng kết quả đạo hàm. Hàng thiếu khóa chỉ hỗ trợ nhận diện điểm cần kiểm tra.", "difficulty_source": "Chọn đúng công thức, hệ số và chiều thao tác.", "discrimination": "low", "typical_steps": 3, "refs": ["fc12a8146279|P1|8|None", "0968e8bc9e2d|P1|7|None", "beee25b53250|P1|6|None", "acc00d945397|P1|2|None", "3b4cca11ea82|P1|6|None", "de5833d227dd|P1|7|None"]}, {"part_kind": "multiple_choice", "topic": "Quan hệ định nghĩa giữa nguyên hàm và đạo hàm", "grade": 12, "construction": "Từ quan hệ nguyên hàm, xác định hàm cần lấy đạo hàm để chọn hệ thức định nghĩa hoặc khôi phục hàm dưới dấu nguyên hàm.", "wrong_options": "Đảo chiều quan hệ, đổi dấu, tiếp tục lấy nguyên hàm hoặc dùng sai quy tắc đạo hàm.", "difficulty_source": "Đọc đúng chiều suy luận giữa hai hàm.", "discrimination": "low", "typical_steps": 2, "refs": ["9ed45d16a975|P1|5|None", "525d3542283a|P1|6|None"]}, {"part_kind": "multiple_choice", "topic": "Suy tích phân bằng tính tuyến tính", "grade": 12, "construction": "Tách tổ hợp tuyến tính, tính phần phụ bằng độ dài khoảng hoặc đối xứng rồi suy tích phân của hàm chưa biết.", "wrong_options": "Giữ nguyên dữ kiện sau biến đổi, quên độ dài khoảng, bỏ cận hoặc chuyển dấu sai; một số nhiễu chưa xác định được lỗi nguồn.", "difficulty_source": "Nhận ra phần tính được mà không cần biết công thức hàm chính.", "discrimination": "low", "typical_steps": 3, "refs": ["54e9a2a276ca|P1|8|None", "0968e8bc9e2d|P1|3|None"]}, {"part_kind": "multiple_choice", "topic": "Quan hệ giữa tích phân có dấu và diện tích", "grade": 12, "construction": "Nhận diện các miền trên và dưới trục hoành, suy diện tích còn thiếu nếu cần rồi ghép đóng góp có dấu hoặc chuyển các tích phân thành diện tích không âm.", "wrong_options": "Đảo dấu, bỏ miền hoặc cộng mọi diện tích như đóng góp dương; hàng thiếu khóa chưa xác nhận lỗi từng lựa chọn.", "difficulty_source": "Phân biệt diện tích hình học với tích phân có dấu.", "discrimination": "low", "typical_steps": 3, "refs": ["54e9a2a276ca|P1|4|None", "525d3542283a|P1|2|None"]}, {"part_kind": "multiple_choice", "topic": "Định vị phân vị trong mẫu ghép nhóm", "grade": 11, "construction": "Tính vị trí trung vị hoặc tứ phân vị, cộng dồn tần số rồi chọn lớp chứa vị trí đó.", "wrong_options": "Chọn theo tần số riêng, lớp giữa hoặc vị trí phân vị khác; thiếu khóa không cho phép xác nhận mọi cơ chế nhiễu.", "difficulty_source": "Phân biệt vị trí quan sát với giá trị biến và nhận ra yêu cầu chỉ định vị lớp.", "discrimination": "low", "typical_steps": 3, "refs": ["fc12a8146279|P1|9|None", "0968e8bc9e2d|P1|6|None"]}, {"part_kind": "multiple_choice", "topic": "Nội suy tứ phân vị của mẫu ghép nhóm", "grade": [11, 12], "construction": "Tìm vị trí phân vị, xác định lớp bằng tần số tích lũy, nội suy từ cận và độ rộng lớp rồi tổng hợp các phân vị nếu yêu cầu.", "wrong_options": "Dùng mốc lớp hoặc trung điểm thay nội suy, chọn lệch lớp. Không suy lỗi cụ thể chỉ từ độ gần nhau của lựa chọn.", "difficulty_source": "Chọn đúng lớp và phân biệt định vị với tính giá trị; biến thể tổng hợp thêm một bước.", "discrimination": "medium", "typical_steps": 4, "refs": ["54e9a2a276ca|P1|9|None", "7ab78715480e|P1|7|None", "3f1b2aa3cb72|P1|1|None", "beee25b53250|P1|11|None", "acc00d945397|P1|4|None"]}, {"part_kind": "multiple_choice", "topic": "Đọc cực trị từ biểu diễn trực quan", "grade": 12, "construction": "Từ đồ thị hoặc bảng biến thiên, nhận diện loại cực trị rồi đọc đúng vị trí hoặc giá trị được hỏi.", "wrong_options": "Hoán đổi hoành độ với tung độ hoặc cực đại với cực tiểu; không phân loại chắc chắn từng lựa chọn khi thiếu khóa.", "difficulty_source": "Phân biệt nơi đạt cực trị với giá trị hàm tại đó.", "discrimination": "low", "typical_steps": 3, "refs": ["54e9a2a276ca|P1|3|None", "beee25b53250|P1|12|None", "acc00d945397|P1|5|None"]}, {"part_kind": "multiple_choice", "topic": "Đọc tính đơn điệu từ đồ thị", "grade": 12, "construction": "Đọc chiều đồ thị khi đối số tăng và kiểm tra toàn bộ khoảng ứng viên có giữ cùng chiều biến thiên.", "wrong_options": "Chọn chiều ngược yêu cầu hoặc khoảng đi qua điểm đổi chiều; nhầm dấu hàm với chiều biến thiên chỉ là khả năng cần kiểm tra ở hàng thiếu khóa.", "difficulty_source": "Đánh giá trên toàn khoảng thay vì một đoạn hoặc vị trí riêng.", "discrimination": "low", "typical_steps": 3, "refs": ["7ab78715480e|P1|5|None", "3f1b2aa3cb72|P1|11|None", "beee25b53250|P1|4|None"]}, {"part_kind": "multiple_choice", "topic": "Tiệm cận của hàm phân thức từ công thức", "grade": 12, "construction": "Chọn phép xét giới hạn phù hợp: so hệ số dẫn đầu để tìm tiệm cận ngang; tìm nghiệm mẫu và kiểm tra tử để tìm tiệm cận đứng.", "wrong_options": "Nhầm loại đường, đổi dấu hoặc tỉ số hệ số, lấy nghiệm tử thay nghiệm mẫu. Từng loại tiệm cận có thao tác riêng; thiếu khóa chưa xác nhận lỗi từng lựa chọn.", "difficulty_source": "Gắn đúng dữ kiện đại số với loại tiệm cận được hỏi.", "discrimination": "low", "typical_steps": 3, "refs": ["beee25b53250|P1|5|None", "acc00d945397|P1|7|None", "3b4cca11ea82|P1|7|None", "de5833d227dd|P1|1|None"]}, {"part_kind": "multiple_choice", "topic": "Tiệm cận từ đồ thị hoặc bảng biến thiên", "grade": 12, "construction": "Đọc xu hướng ở vô cực và tại điểm gián đoạn, phân loại giới hạn rồi viết phương trình hoặc đếm các đường tiệm cận phân biệt.", "wrong_options": "Đổi tiệm cận đứng với ngang, lấy nhầm tọa độ, coi giới hạn hữu hạn tại điểm hữu hạn là tiệm cận ngang hoặc đòi vô hạn ở mọi phía.", "difficulty_source": "Phân biệt nơi lấy giới hạn, hướng đường và tọa độ biểu diễn.", "discrimination": "low", "typical_steps": 3, "refs": ["54e9a2a276ca|P1|7|None", "7ab78715480e|P1|2|None", "3f1b2aa3cb72|P1|10|None"]}, {"part_kind": "multiple_choice", "topic": "Đọc hoặc lập vectơ từ biểu diễn tọa độ", "grade": 12, "construction": "Đọc thành phần theo vectơ đơn vị hoặc hệ số trong phương trình; khi cho các điểm thì lấy hiệu tọa độ. Với chỉ phương và pháp tuyến, kiểm tra vectơ khác không cùng phương.", "wrong_options": "Đổi thứ tự, mất dấu, đổi dấu không đồng bộ, dùng tổng tọa độ hoặc trộn tọa độ điểm và hằng số với thành phần vectơ.", "difficulty_source": "Đọc đúng vai trò của hệ số và giữ nhất quán hướng.", "discrimination": "low", "typical_steps": 2, "refs": ["54e9a2a276ca|P1|10|None", "0968e8bc9e2d|P1|2|None", "3b4cca11ea82|P1|2|None", "3b4cca11ea82|P1|8|None", "de5833d227dd|P1|10|None"]}, {"part_kind": "multiple_choice", "topic": "Biểu diễn vectơ bằng quan hệ hình học", "grade": 12, "construction": "Dùng quan hệ trung điểm, đường trung bình hoặc quy tắc hình hộp để biểu diễn vectơ qua các vectơ cạnh, rồi kiểm tra hướng, hệ số và điểm cuối.", "wrong_options": "Đảo hướng, thiếu thành phần, sai hệ số, chọn nhầm cạnh hoặc dùng đường chéo gây cộng lặp. Hàng thiếu khóa chỉ xác định cơ chế cần kiểm tra.", "difficulty_source": "Theo dõi độ dời có hướng và tỉ lệ trên hình không gian; các quan hệ hình học là những biến thể riêng.", "discrimination": "medium", "typical_steps": 3, "refs": ["0968e8bc9e2d|P1|11|None", "525d3542283a|P1|7|None", "3b4cca11ea82|P1|4|None", "de5833d227dd|P1|4|None"]}, {"part_kind": "multiple_choice", "topic": "Thể tích khối chóp từ đáy và chiều cao", "grade": 11, "construction": "Xác định đúng phần đáy và đường cao, suy các kích thước còn thiếu từ quan hệ hình học rồi áp dụng công thức thể tích.", "wrong_options": "Dùng toàn đáy thay phần cần xét, nhầm cạnh với đường chéo, suy sai chiều cao hoặc thiếu hệ số; thiếu khóa chưa xác nhận từng lỗi.", "difficulty_source": "Đáy và chiều cao có thể phải suy từ mặt cắt thay vì được cho trực tiếp.", "discrimination": "medium", "typical_steps": 4, "refs": ["9ed45d16a975|P1|3|None", "525d3542283a|P1|1|None"]}, {"part_kind": "multiple_choice", "topic": "Giá trị nhỏ nhất của đa thức trên đoạn", "grade": 12, "construction": "Tìm điểm dừng thuộc đoạn, tính giá trị tại các điểm đó và đầu mút rồi so sánh.", "wrong_options": "Bỏ điểm dừng, bỏ đầu mút hoặc tính thiếu thành phần của hàm; nhầm hoành độ với giá trị chỉ là khả năng ở hàng chưa có khóa.", "difficulty_source": "Lập đủ tập ứng viên và trả lời bằng giá trị hàm.", "discrimination": "low", "typical_steps": 3, "refs": ["7ab78715480e|P1|11|None", "3f1b2aa3cb72|P1|5|None"]}, {"part_kind": "true_false", "topic": "Kiểm tra giá trị hàm bằng phép thế", "grade": [10, 11], "construction": "Kiểm tra miền xác định, chọn đúng hàm và đối số hoặc mốc ban đầu, thế vào biểu thức rồi đối chiếu giá trị và đơn vị nếu có.", "wrong_options": "Cần kiểm tra điều kiện mẫu, dấu và mốc biến. Các hàng đúng hoặc thiếu khóa không xác lập cơ chế tạo nhận định sai.", "difficulty_source": "Đọc đúng đại lượng cần tính và tránh thao tác đạo hàm hay nguyên hàm không cần thiết.", "discrimination": "low", "typical_steps": 3, "refs": ["fc12a8146279|P2|1|a", "525d3542283a|P2|3|b", "7ab78715480e|P2|1|a", "beee25b53250|P2|3|c", "beee25b53250|P2|4|a"]}, {"part_kind": "true_false", "topic": "Kiểm tra công thức đạo hàm", "grade": 11, "construction": "Lấy đạo hàm theo cấu trúc từng thành phần, dùng quy tắc hàm hợp hoặc tích khi cần, rút gọn rồi đối chiếu.", "wrong_options": "Có bằng chứng giữ biến khi đạo hàm hạng tử bậc nhất; thiếu một hạng của quy tắc tích là nguy cơ chưa được khóa xác nhận. Không suy cơ chế sai lặp lại từ các nhận định đúng.", "difficulty_source": "Giữ đủ hạng, hệ số, dấu và quy tắc giảm bậc.", "discrimination": "low", "typical_steps": 3, "refs": ["54e9a2a276ca|P2|1|a", "525d3542283a|P2|3|a", "7ab78715480e|P2|1|b", "beee25b53250|P2|4|c"]}, {"part_kind": "true_false", "topic": "Tâm đối xứng của đồ thị", "grade": 12, "construction": "Chọn công cụ theo loại hàm, xác định tâm bằng giao tiệm cận hoặc điểm uốn, tính đủ tọa độ rồi đối chiếu.", "wrong_options": "Nhận định có khóa là đúng; hàng thiếu khóa chỉ hỗ trợ yêu cầu kiểm tra đủ tọa độ.", "difficulty_source": "Nhận ra đặc trưng quyết định tâm đối xứng.", "discrimination": "medium", "typical_steps": 3, "refs": ["fc12a8146279|P2|1|c", "54e9a2a276ca|P2|1|c"]}, {"part_kind": "true_false", "topic": "Khôi phục hàm bằng nguyên hàm và điều kiện giá trị", "grade": 12, "construction": "Từ đạo hàm, tốc độ thay đổi hoặc hàm dưới dấu nguyên hàm, biến đổi và lấy nguyên hàm từng thành phần; giữ hằng số tùy ý nếu chưa có điều kiện, dùng giá trị đã biết nếu có rồi đối chiếu.", "wrong_options": "Có bằng chứng tăng bậc mà không chỉnh hệ số, tự ấn định hằng số hoặc nhầm quan hệ đạo hàm với quan hệ giá trị. Những hàng thiếu khóa chỉ hỗ trợ kiểm tra dấu, hệ số, miền và điều kiện.", "difficulty_source": "Phân biệt tốc độ với mức đại lượng, họ nguyên hàm với hàm được xác định bởi điều kiện.", "discrimination": "medium", "typical_steps": 3, "refs": ["fc12a8146279|P2|2|a", "54e9a2a276ca|P2|2|a", "0968e8bc9e2d|P2|4|a", "0968e8bc9e2d|P2|4|b", "9ed45d16a975|P2|1|a", "525d3542283a|P2|2|c", "7ab78715480e|P2|1|d", "3f1b2aa3cb72|P2|1|a", "3f1b2aa3cb72|P2|1|b", "3f1b2aa3cb72|P2|4|a", "3f1b2aa3cb72|P2|4|b", "acc00d945397|P2|1|a", "acc00d945397|P2|1|b", "3b4cca11ea82|P2|3|a"]}, {"part_kind": "true_false", "topic": "Hiệu chỉnh mô hình tích lũy", "grade": 12, "construction": "Lấy nguyên hàm hoặc lập tích phân của tốc độ chứa tham số, dùng dữ kiện về lượng và các mốc để xác định hằng số hoặc hệ số rồi kiểm tra giá trị cần hỏi.", "wrong_options": "Nhầm tổng lượng với phần thay đổi hoặc tốc độ tức thời, làm tròn sớm. Có giá trị sai chưa truy được về một lỗi riêng biệt.", "difficulty_source": "Dùng đúng vai trò từng điều kiện trong phương trình hiệu chỉnh.", "discrimination": "medium", "typical_steps": 4, "refs": ["fc12a8146279|P2|2|b", "54e9a2a276ca|P2|2|b", "0968e8bc9e2d|P2|4|c", "9ed45d16a975|P2|1|b", "9ed45d16a975|P2|1|c"]}, {"part_kind": "true_false", "topic": "Lượng tích lũy trên khoảng con", "grade": 12, "construction": "Giữ tham số đã hiệu chỉnh đủ chính xác, tích phân trên đúng khoảng con rồi so sánh với ngưỡng.", "wrong_options": "Có phát biểu sai xác nhận việc chia đều tổng lượng theo thời gian dù tốc độ biến thiên; không gán cơ chế này cho mọi hàng thiếu khóa.", "difficulty_source": "Phân biệt tích lũy theo tốc độ biến thiên với phân bố đều.", "discrimination": "medium", "typical_steps": 3, "refs": ["fc12a8146279|P2|2|c", "54e9a2a276ca|P2|2|c"]}, {"part_kind": "true_false", "topic": "Giá trị trung bình trên khoảng", "grade": 12, "construction": "Tính lượng tích lũy trên khoảng cần xét, chia độ dài khoảng rồi làm tròn theo yêu cầu.", "wrong_options": "Cần phân biệt trung bình trên khoảng với giá trị tại thời điểm; nhận định có khóa là đúng, phần thiếu khóa chưa xác nhận lỗi.", "difficulty_source": "Giữ đúng khoảng lấy trung bình và độ chính xác trung gian.", "discrimination": "medium", "typical_steps": 4, "refs": ["fc12a8146279|P2|2|d", "54e9a2a276ca|P2|2|d"]}, {"part_kind": "true_false", "topic": "Xác suất biến cố đối", "grade": [10, 12], "construction": "Nhận diện biến cố bổ sung rồi lấy phần bù trong cùng quần thể; nếu có điều kiện thì giữ nguyên nhóm điều kiện.", "wrong_options": "Có bằng chứng lấy phần bù từ nhóm điều kiện khác; các hàng thiếu khóa chưa xác nhận nhận định sai.", "difficulty_source": "Không đổi không gian xác suất khi lấy phần bù.", "discrimination": "low", "typical_steps": 3, "refs": ["fc12a8146279|P2|3|a", "fc12a8146279|P2|3|b", "54e9a2a276ca|P2|3|c"]}, {"part_kind": "true_false", "topic": "Xác suất thuộc tính trong nhóm đã biết", "grade": 12, "construction": "Lấy nhóm đã biết làm không gian điều kiện, rút gọn quy trình chọn bằng đối xứng nếu hợp lệ rồi tính tỉ lệ thuộc tính.", "wrong_options": "Dùng cơ cấu của nhóm khác. Hàng có lời văn chưa tường minh chỉ hỗ trợ cách đọc có điều kiện phù hợp với khóa.", "difficulty_source": "Nhận ra quần thể điều kiện sau quy trình nhiều giai đoạn.", "discrimination": "medium", "typical_steps": 3, "refs": ["0968e8bc9e2d|P2|3|b", "9ed45d16a975|P2|2|a"]}, {"part_kind": "true_false", "topic": "Xác suất toàn phần", "grade": 12, "construction": "Lập phân hoạch các nhóm hoặc trạng thái trung gian, hoàn thiện dữ kiện và cập nhật thành phần nếu cần, tính xác suất từng nhánh rồi cộng với trọng số đúng.", "wrong_options": "Bỏ nhánh, dùng trung bình không trọng số hoặc giữ nguyên thành phần sau thay đổi là các nguy cơ có căn cứ; không phải mọi giá trị sai đều truy được về một lỗi duy nhất.", "difficulty_source": "Ghép đúng trọng số do quần thể hoặc quy trình chọn với xác suất có điều kiện.", "discrimination": "medium", "typical_steps": 4, "refs": ["fc12a8146279|P2|3|c", "54e9a2a276ca|P2|3|a", "0968e8bc9e2d|P2|3|c", "9ed45d16a975|P2|2|b", "3f1b2aa3cb72|P2|2|c", "7ab78715480e|P2|4|c"]}, {"part_kind": "true_false", "topic": "Đảo điều kiện bằng công thức Bayes", "grade": 12, "construction": "Xác định chiều điều kiện, tính xác suất giao và xác suất kết quả bằng toàn phần rồi chuẩn hóa để kiểm tra giá trị hoặc ngưỡng.", "wrong_options": "Hoán đổi trực tiếp chiều điều kiện hoặc dùng sai mẫu số là nguy cơ cần kiểm tra; hàng thiếu khóa chưa xác nhận lỗi. Một hàng có lời văn mơ hồ được diễn giải theo khóa, không coi sự mơ hồ là thủ pháp phân hóa.", "difficulty_source": "Giữ biến cố giao nhưng đổi đúng quần thể chuẩn hóa.", "discrimination": "medium", "typical_steps": 4, "refs": ["fc12a8146279|P2|3|d", "54e9a2a276ca|P2|3|b", "0968e8bc9e2d|P2|3|d", "9ed45d16a975|P2|2|c", "3f1b2aa3cb72|P2|2|d", "7ab78715480e|P2|4|d"]}, {"part_kind": "true_false", "topic": "Biểu diễn và định vị trên đường chuyển động", "grade": 12, "construction": "Từ các vị trí, lập vectơ hướng và biểu diễn tham số; nếu có thời gian thì suy vận tốc và ngoại suy vị trí, nếu có điều kiện tọa độ thì giải tham số rồi kiểm tra miền.", "wrong_options": "Nhầm mốc thời gian, trộn vectơ dịch chuyển với tọa độ vị trí hoặc không thống nhất đơn vị; thiếu khóa chưa xác nhận từng lỗi.", "difficulty_source": "Phối hợp điểm gốc, hướng, tỉ lệ tham số và miền chuyển động.", "discrimination": "low", "typical_steps": 4, "refs": ["fc12a8146279|P2|4|a", "fc12a8146279|P2|4|b", "3f1b2aa3cb72|P2|3|a"]}, {"part_kind": "true_false", "topic": "Khoảng cách gần nhất trên đoạn thẳng", "grade": 12, "construction": "Tham số hóa vị trí, cực tiểu hóa bình phương khoảng cách hoặc dùng hình chiếu, kiểm tra tham số thuộc đoạn rồi suy vị trí, thời điểm hoặc quan hệ với vùng cầu.", "wrong_options": "Có thời điểm sai chưa xác định được lỗi nguồn; cần kiểm tra việc tối ưu trên đường kéo dài thay cho đoạn hữu hạn.", "difficulty_source": "Phân biệt nghiệm hình chiếu với nghiệm khả thi trên đoạn.", "discrimination": "medium", "typical_steps": 4, "refs": ["0968e8bc9e2d|P2|2|d", "9ed45d16a975|P2|3|c"]}, {"part_kind": "true_false", "topic": "Phương trình và thông số mặt cầu", "grade": 12, "construction": "Liên hệ tâm và bán kính với phương trình chính tắc theo hai chiều, thống nhất đơn vị rồi kiểm tra dấu tọa độ và bình phương bán kính.", "wrong_options": "Đồng nhất bán kính với bình phương bán kính hoặc dùng độ dài theo đơn vị khác với hệ tọa độ.", "difficulty_source": "Hiểu ý nghĩa hình học và đơn vị của các thành phần phương trình.", "discrimination": "low", "typical_steps": 3, "refs": ["54e9a2a276ca|P2|4|a", "0968e8bc9e2d|P2|2|a", "9ed45d16a975|P2|3|a"]}, {"part_kind": "true_false", "topic": "Thể tích khối tròn xoay", "grade": 12, "construction": "Xác định bán kính thiết diện từ miền phẳng, dùng diện tích đĩa hoặc hiệu các đĩa, tích phân trên miền thích hợp rồi đối chiếu và làm tròn.", "wrong_options": "Cần kiểm tra bình phương bán kính, hệ số diện tích và phần bị loại; chưa đủ bằng chứng gán giá trị sai cụ thể cho từng cơ chế.", "difficulty_source": "Chuyển đúng miền phẳng thành thiết diện trước khi tính.", "discrimination": "medium", "typical_steps": 4, "refs": ["acc00d945397|P2|1|d", "de5833d227dd|P2|1|d"]}, {"part_kind": "true_false", "topic": "Tọa độ điểm từ quan hệ vectơ", "grade": 12, "construction": "Viết điểm cần xét thành điểm xuất phát cộng vectơ dịch chuyển hoặc phần thích hợp của vectơ nối các điểm, tính tọa độ hay thành phần cần hỏi rồi đối chiếu.", "wrong_options": "Nội dung kiểm tra gồm hướng, điểm xuất phát và hệ số chia đoạn; chưa có bằng chứng xác nhận lỗi riêng của nhận định sai.", "difficulty_source": "Chuyển đúng quan hệ hình học thành phép toán tọa độ.", "discrimination": "low", "typical_steps": 3, "refs": ["acc00d945397|P2|3|b", "3b4cca11ea82|P2|4|b"]}, {"part_kind": "short_answer", "topic": "Thể tích từ góc và hình phụ", "grade": 11, "construction": "Dựng hình phụ vuông góc, chuyển góc thành quan hệ độ dài, suy chiều cao phù hợp rồi tính thể tích trực tiếp hoặc qua khối phụ.", "wrong_options": null, "difficulty_source": "Chọn đúng chiều cao và quan hệ thể tích khi mặt phẳng đã cho chưa phải đáy thuận lợi.", "discrimination": "high", "typical_steps": 5, "refs": ["fc12a8146279|P3|1|None", "54e9a2a276ca|P3|2|None"]}, {"part_kind": "short_answer", "topic": "Đếm cấu hình dưới ràng buộc đồng thời", "grade": [10, 11], "construction": "Chuyển điều kiện vị trí, thứ tự, quan hệ đại số hoặc giới hạn biến thành cấu trúc trạng thái; phân loại theo yếu tố quyết định, đếm từng phần hợp lệ rồi xử lý thứ tự, phần tử lặp và giao nhau. Nếu tính xác suất, phải xác lập mô hình đồng khả năng.", "wrong_options": null, "difficulty_source": "Giữ đồng thời điều kiện cục bộ và toàn cấu hình, tránh đếm thiếu hoặc lặp. Các ràng buộc cụ thể là biến thể riêng; mô hình đồng khả năng ở một hàng chưa được phát biểu tường minh.", "discrimination": "high", "typical_steps": 6, "refs": ["fc12a8146279|P3|3|None", "fc12a8146279|P3|6|None", "54e9a2a276ca|P3|4|None", "525d3542283a|P3|3|None", "3f1b2aa3cb72|P3|3|None", "beee25b53250|P3|1|None"]}, {"part_kind": "short_answer", "topic": "Đếm theo lớp dư", "grade": 10, "construction": "Phân loại phần tử theo phần dư phù hợp với điều kiện chia hết, tìm các kiểu phối hợp hợp lệ, đếm theo kích thước nhóm rồi xử lý thứ tự và điều kiện lặp.", "wrong_options": null, "difficulty_source": "Chọn đúng đại lượng lấy phần dư, giữ trọng số nhóm và phân biệt chọn phần tử với gán vào vị trí.", "discrimination": "medium", "typical_steps": 5, "refs": ["acc00d945397|P3|6|None", "3b4cca11ea82|P3|6|None"]}, {"part_kind": "short_answer", "topic": "Tối ưu sau khi lập mục tiêu và miền khả thi", "grade": [10, 12], "construction": "Đặt biến, biểu diễn đại lượng đích từ mô hình và lập ràng buộc; tìm ứng viên bằng công cụ phù hợp rồi kiểm tra biên, toàn miền và tính nguyên khi cần.", "wrong_options": null, "difficulty_source": "Lập đúng mục tiêu, phân biệt đại lượng đơn vị với tổng và nghiệm liên tục với phương án nguyên. Công cụ tìm ứng viên khác nhau theo dạng hàm; hàng có văn bản và hình không thống nhất chưa hỗ trợ kết luận riêng về phân hóa.", "discrimination": "medium", "typical_steps": 5, "refs": ["fc12a8146279|P3|4|None", "54e9a2a276ca|P3|1|None", "54e9a2a276ca|P3|6|None", "0968e8bc9e2d|P3|2|None", "9ed45d16a975|P3|1|None", "525d3542283a|P3|2|None", "525d3542283a|P3|5|None", "7ab78715480e|P3|3|None"]}, {"part_kind": "short_answer", "topic": "Tích phân thể tích phần khối được chọn", "grade": 12, "construction": "Chọn tọa độ hoặc họ thiết diện, biểu diễn biên và khoảng tồn tại, xác định phần được giữ rồi tích phân diện tích thiết diện hoặc trừ phần khuyết.", "wrong_options": null, "difficulty_source": "Tự dựng hàm thiết diện và cận, tránh tính cả phần không thuộc vật thể.", "discrimination": "high", "typical_steps": 5, "refs": ["fc12a8146279|P3|5|None", "54e9a2a276ca|P3|5|None", "3b4cca11ea82|P3|5|None"]}, {"part_kind": "short_answer", "topic": "Dựng miền rồi tích phân diện tích", "grade": 12, "construction": "Khôi phục hàm biên từ dữ kiện đồ thị hoặc hình học, tìm giao điểm và điểm chuyển biên, chia miền rồi tích phân hiệu biên trên và dưới; có thể dùng diện tích ngược để tìm tham số.", "wrong_options": null, "difficulty_source": "Phần khó nằm ở dựng mô hình và miền. Biến thể có hàm sẵn nhẹ hơn biến thể phải suy biên; một số hình tô và cách chia miền chưa được kiểm chứng độc lập.", "discrimination": "high", "typical_steps": 5, "refs": ["0968e8bc9e2d|P3|6|None", "9ed45d16a975|P3|5|None", "525d3542283a|P3|1|None", "7ab78715480e|P3|1|None", "3f1b2aa3cb72|P3|1|None"]}, {"part_kind": "short_answer", "topic": "Khoảng cách không gian sau khi dựng biểu diễn", "grade": 11, "construction": "Suy kích thước còn thiếu từ hình chiếu, góc hoặc cấu trúc hình, chọn hệ tọa độ hay mặt phẳng phụ rồi dựng đoạn vuông góc và tính khoảng cách.", "wrong_options": null, "difficulty_source": "Chọn biểu diễn theo đúng đối tượng đo; khoảng cách điểm đến mặt phẳng và giữa các đường chéo nhau dùng công thức khác nhau. Biến thể đường chéo nhau có thể phân hóa cao hơn.", "discrimination": "medium", "typical_steps": 4, "refs": ["525d3542283a|P3|4|None", "7ab78715480e|P3|6|None", "9ed45d16a975|P3|4|None", "3b4cca11ea82|P3|2|None"]}, {"part_kind": "short_answer", "topic": "Góc nhị diện qua các phương vuông góc cạnh", "grade": 11, "construction": "Dựng thiết diện hoặc chiếu các phương lên mặt phẳng vuông góc cạnh nhị diện, xác định đúng góc phẳng và hai nửa mặt phẳng rồi tính bằng hệ thức lượng.", "wrong_options": null, "difficulty_source": "Chuyển góc giữa các mặt thành góc giữa các phương thích hợp thay vì dùng trực tiếp góc giữa cạnh.", "discrimination": "high", "typical_steps": 5, "refs": ["3f1b2aa3cb72|P3|5|None", "beee25b53250|P3|2|None"]}, {"part_kind": "short_answer", "topic": "Khôi phục mô hình có tốc độ phụ thuộc đại lượng", "grade": 12, "construction": "Chọn biến đổi làm lộ quan hệ có đạo hàm hằng, tích phân, xác định tham số từ các quan sát rồi trở lại đại lượng và kiểm tra miền mô hình.", "wrong_options": null, "difficulty_source": "Nhận ra phép tuyến tính hóa phù hợp thay vì giả định đại lượng gốc biến thiên tuyến tính; dạng phụ thuộc cụ thể khác nhau.", "discrimination": "medium", "typical_steps": 5, "refs": ["3f1b2aa3cb72|P3|6|None", "beee25b53250|P3|5|None"]}], "discrimination_moves": [{"move": "Tự dựng biểu diễn trung gian", "how_to_apply": "Chọn tọa độ, hình phụ, thiết diện hoặc cấu trúc đếm để nối dữ kiện với đại lượng đích trước khi tính.", "evidence_scope": "Có bằng chứng liên đề ở thao tác chung; từng mô hình cụ thể không mặc nhiên tái diễn.", "refs": ["fc12a8146279|P3|5|None", "54e9a2a276ca|P3|2|None", "54e9a2a276ca|P3|5|None", "9ed45d16a975|P2|4|d", "9ed45d16a975|P3|4|None", "525d3542283a|P3|1|None", "7ab78715480e|P3|1|None", "7ab78715480e|P3|6|None", "3f1b2aa3cb72|P2|3|d", "3f1b2aa3cb72|P3|1|None", "3f1b2aa3cb72|P3|3|None", "beee25b53250|P3|1|None", "beee25b53250|P3|6|None", "3b4cca11ea82|P3|2|None"]}, {"move": "Khôi phục mô hình từ đặc trưng gián tiếp", "how_to_apply": "Dùng nghiệm, tiệm cận, giao điểm, cực trị hoặc ràng buộc hình học để xác định hàm và hệ số trước khi tính.", "evidence_scope": "Có bằng chứng liên đề cho việc dựng mô hình; các tổ hợp đặc trưng và giới hạn kiểm chứng hình thuộc từng hàng.", "refs": ["0968e8bc9e2d|P3|3|None", "0968e8bc9e2d|P3|6|None", "525d3542283a|P3|1|None", "7ab78715480e|P3|1|None"]}, {"move": "Phân chia miền và loại phần không thuộc đối tượng", "how_to_apply": "Xác định nơi thay đổi biên, khoảng tồn tại của thiết diện và phần bị loại trước khi lập tích phân; dùng đối xứng hoặc phần bù khi hợp lệ.", "evidence_scope": "Có bằng chứng liên đề; chưa xác nhận độc lập mọi hình tô.", "refs": ["fc12a8146279|P3|5|None", "54e9a2a276ca|P3|5|None", "525d3542283a|P3|1|None", "7ab78715480e|P3|1|None", "3f1b2aa3cb72|P3|1|None", "3b4cca11ea82|P3|5|None"]}, {"move": "Giữ nhiều ràng buộc và tổ chức trường hợp", "how_to_apply": "Dùng thành phần chung hoặc nhóm biến quyết định để phân loại; phối hợp điều kiện vị trí, thứ tự, quan hệ đại số và không lặp, bảo đảm các trường hợp đầy đủ và không giao nhau.", "evidence_scope": "Có bằng chứng liên đề ở khung phân loại; từng tổ hợp điều kiện là biến thể riêng.", "refs": ["fc12a8146279|P3|3|None", "fc12a8146279|P3|6|None", "54e9a2a276ca|P3|4|None", "3f1b2aa3cb72|P3|3|None", "beee25b53250|P3|1|None", "beee25b53250|P3|4|None"]}, {"move": "Suy tiêu chuẩn khả thi từ cơ chế tuần tự", "how_to_apply": "Chuyển quy tắc vận hành thành điều kiện cho toàn cấu hình, sau đó đếm thứ tự và loại sự phân biệt giả giữa các phần tử cùng loại.", "evidence_scope": "Quan sát riêng, không phải bằng chứng tái diễn độc lập.", "refs": ["525d3542283a|P3|3|None"]}, {"move": "Kiểm tra tính hợp lệ sau khi tìm ứng viên", "how_to_apply": "Kiểm tra miền biến, biên, tính nguyên, vị trí giao điểm, miền tích phân và khả năng đạt dấu bằng trước khi kết luận.", "evidence_scope": "Có bằng chứng liên đề cho bước kiểm tra; từng điều kiện thuộc cấu trúc riêng.", "refs": ["0968e8bc9e2d|P3|6|None", "9ed45d16a975|P2|4|d", "9ed45d16a975|P3|6|None", "3b4cca11ea82|P3|3|None", "3b4cca11ea82|P3|4|None", "acc00d945397|P2|4|d"]}, {"move": "Suy quỹ tích và quan hệ phụ từ tiếp xúc", "how_to_apply": "Dùng vuông góc tại tiếp điểm để thiết lập mặt phẳng tiếp điểm hoặc quan hệ tích vô hướng; xác định tâm quỹ tích hay kết hợp ràng buộc vị trí sau đó.", "evidence_scope": "Có bằng chứng ở các đề khác nhau cho quan hệ trung gian từ tiếp xúc; mỗi yêu cầu cuối là biến thể riêng.", "refs": ["54e9a2a276ca|P2|4|d", "54e9a2a276ca|P3|3|None", "9ed45d16a975|P3|6|None"]}, {"move": "Tách phần bất biến khỏi mục tiêu", "how_to_apply": "Nhận ra độ dài không phụ thuộc lựa chọn, chỉ tối ưu phần còn biến thiên rồi dùng góc ở tâm để tính cung. Phân tích dựa vào điều kiện tiếp xúc tường minh khi diễn đạt chuyển động chưa hoàn toàn nhất quán.", "evidence_scope": "Quan sát riêng.", "refs": ["54e9a2a276ca|P3|3|None"]}, {"move": "Cập nhật trạng thái sau điều kiện", "how_to_apply": "Sau thông tin quan sát, cập nhật trọng số các nhánh và thành phần còn lại trong từng nhánh trước khi tính xác suất tiếp theo.", "evidence_scope": "Quan sát riêng về bước cập nhật hậu nghiệm kết hợp thay đổi thành phần.", "refs": ["9ed45d16a975|P2|2|d"]}, {"move": "Theo dõi phụ thuộc trong quy trình liên tiếp", "how_to_apply": "Tính xác suất giai đoạn đầu, cập nhật thành phần rồi nhân xác suất có điều kiện ở giai đoạn sau; không tự giả định độc lập.", "evidence_scope": "Quan sát riêng cho xác suất đồng thời; hàng chọn nhiều đối tượng sau điều kiện hóa chưa làm rõ cơ chế chọn nên chưa bảo đảm phép nhân độc lập.", "refs": ["3f1b2aa3cb72|P2|2|b", "54e9a2a276ca|P2|3|d"]}, {"move": "Lập trọng số cho đại lượng trung gian", "how_to_apply": "Từ kết quả sơ cấp, dựng phân bố của đại lượng tổng hợp rồi phân loại điều kiện hình học và cộng xác suất theo trọng số.", "evidence_scope": "Quan sát riêng; không coi các giá trị trung gian mặc nhiên đồng khả năng.", "refs": ["beee25b53250|P3|4|None"]}, {"move": "Chuyển góc giữa các mặt sang các phương chiếu", "how_to_apply": "Dựng hoặc chiếu lên mặt phẳng vuông góc cạnh nhị diện, giữ đúng hai nửa mặt phẳng rồi tính góc phẳng.", "evidence_scope": "Cấu trúc có bằng chứng liên đề; biến thể suy từ góc giữa cạnh chỉ được quan sát riêng.", "refs": ["3f1b2aa3cb72|P3|5|None", "beee25b53250|P3|2|None"]}, {"move": "Phân biệt độ dài với tốc độ thay đổi độ dài", "how_to_apply": "Dựng vị trí và vận tốc tương đối, chuẩn hóa hướng khi cần rồi đạo hàm hệ thức độ dài; giữ dấu thay vì thay bằng tổng tốc độ hoặc chuẩn vận tốc tương đối.", "evidence_scope": "Quan sát riêng có mức phân hóa cao.", "refs": ["3f1b2aa3cb72|P2|3|d"]}, {"move": "Dùng phản xạ để xác định vị trí tối ưu", "how_to_apply": "Biến tổng khoảng cách thành cấu trúc áp dụng bất đẳng thức tam giác, kiểm tra điều kiện đẳng thức rồi tính đại lượng phụ tại vị trí tối ưu.", "evidence_scope": "Quan sát riêng.", "refs": ["beee25b53250|P3|6|None"]}, {"move": "Tối ưu tiếp trên tập đạt cực trị", "how_to_apply": "Xác định toàn bộ tập phương án tối ưu của mục tiêu chính, thêm điều kiện rồi tối ưu đại lượng phụ trên tập đó.", "evidence_scope": "Quan sát riêng.", "refs": ["acc00d945397|P2|4|c"]}, {"move": "Chọn điểm chuyển giữa các miền", "how_to_apply": "Lập mục tiêu từ các phần có quy luật khác nhau, dùng vị trí chuyển tiếp làm biến, rút gọn rồi so nghiệm trong miền với phương án biên.", "evidence_scope": "Quan sát riêng.", "refs": ["3b4cca11ea82|P3|3|None"]}, {"move": "Kiểm soát thứ tự cập nhật và ngưỡng kỳ nguyên", "how_to_apply": "Lập truy hồi có tăng trưởng và khoản giảm theo kỳ, dùng tổng cấp số nhân rồi tìm kỳ nguyên đầu tiên thỏa ngưỡng, kiểm tra kỳ trước và phần kỳ cuối.", "evidence_scope": "Quan sát riêng.", "refs": ["fc12a8146279|P3|2|None"]}, {"move": "Nhận ra quy luật nhân của diện tích", "how_to_apply": "Tính phần đầu, suy tỉ số diện tích từ quy luật hình học, kiểm tra không chồng lấn rồi cộng bằng tổng cấp số nhân.", "evidence_scope": "Quan sát riêng.", "refs": ["3f1b2aa3cb72|P3|2|None"]}, {"move": "Phân biệt các tầng đại lượng trong tối ưu", "how_to_apply": "Phân biệt vị trí tối ưu với giá trị tối ưu, cực đại của tốc độ với cực đại của đại lượng; chỉ khôi phục hàm bằng nguyên hàm khi cần giá trị.", "evidence_scope": "Có bằng chứng liên đề cho việc phân biệt đại lượng và tốc độ; yêu cầu tính mức tại lúc tốc độ lớn nhất là quan sát riêng.", "refs": ["3f1b2aa3cb72|P2|1|c", "3f1b2aa3cb72|P2|1|d", "beee25b53250|P2|3|b", "beee25b53250|P2|3|a"]}, {"move": "Giữ hệ số khi thay đối số", "how_to_apply": "Phân biệt đạo hàm được lấy tại đối số mới với đạo hàm của hàm hợp; tính, thay đối số, lấy nguyên hàm theo biến đang xét và kiểm tra ngược.", "evidence_scope": "Quan sát riêng.", "refs": ["3f1b2aa3cb72|P2|4|c"]}, {"move": "Kiểm tra tính biến thiên và hình dạng bằng đặc trưng quyết định", "how_to_apply": "Dùng dấu đạo hàm, cực trị, tính liên tục và hướng nhánh để kiểm tra khoảng hoặc hình ứng viên, tránh khảo sát lại toàn bộ khi không cần.", "evidence_scope": "Có bằng chứng liên đề ở thao tác đối chiếu đặc trưng; dạng nhận diện công thức và từng nhận định cụ thể là quan sát riêng.", "refs": ["54e9a2a276ca|P2|1|b", "54e9a2a276ca|P2|1|d", "acc00d945397|P1|12|None", "beee25b53250|P1|7|None", "beee25b53250|P2|3|d", "beee25b53250|P2|4|b"]}, {"move": "Kiểm tra cực trị toàn miền", "how_to_apply": "Lập đủ điểm tới hạn thuộc đoạn và đầu mút, tính giá trị rồi so sánh; không dừng ở điều kiện đạo hàm bằng không.", "evidence_scope": "Hàng đúng sai là quan sát riêng; cấu trúc so ứng viên còn có bằng chứng ở dạng lựa chọn.", "refs": ["beee25b53250|P2|4|d", "7ab78715480e|P1|11|None", "3f1b2aa3cb72|P1|5|None"]}, {"move": "Lọc nghiệm lượng giác theo miền", "how_to_apply": "Viết đủ họ nghiệm, chuyển sang biến cần xét rồi lọc đầu mút để tìm lần đầu hoặc đếm số lần.", "evidence_scope": "Quan sát riêng; chưa xác nhận nhận định sai hay cơ chế nhiễu.", "refs": ["beee25b53250|P2|2|b", "beee25b53250|P2|2|d"]}, {"move": "Chọn đồng nhất thức dùng trực tiếp dữ kiện", "how_to_apply": "Biến đổi biểu thức lượng giác về dạng chứa giá trị đã cho, thay và giữ dấu khi tính.", "evidence_scope": "Quan sát riêng; chỉ một phần nhiễu có cơ chế dấu được nhận diện chắc chắn.", "refs": ["54e9a2a276ca|P1|5|None"]}, {"move": "Dùng phân phối tích vô hướng sau khi phân tích vectơ", "how_to_apply": "Biểu diễn vectơ qua các cạnh và quan hệ trung điểm, phân phối tích vô hướng rồi dùng góc trong các mặt để tránh tìm trực tiếp góc không gian.", "evidence_scope": "Quan sát riêng.", "refs": ["54e9a2a276ca|P1|6|None"]}, {"move": "Chiếu riêng từng đầu mút", "how_to_apply": "Giữ điểm đã thuộc mặt phẳng chiếu, xác định ảnh vuông góc của điểm còn lại rồi nối các ảnh.", "evidence_scope": "Quan sát riêng; không suy phương chiếu từ phối cảnh.", "refs": ["0968e8bc9e2d|P1|8|None"]}, {"move": "Đọc cấu trúc phương trình trước khi tính", "how_to_apply": "Với mặt phẳng tọa độ, xác định tọa độ luôn triệt tiêu; với đoạn chắn, ghép đúng biến và đoạn chắn có dấu; với đường thẳng, kiểm tra mọi tọa độ dùng cùng tham số; với mặt cầu, phân biệt đường kính, bán kính và bình phương bán kính.", "evidence_scope": "Các cấu trúc riêng được giữ cùng nhóm thao tác đọc biểu diễn, không coi là một mẫu tái diễn duy nhất.", "refs": ["fc12a8146279|P1|10|None", "54e9a2a276ca|P1|11|None", "fc12a8146279|P1|11|None", "fc12a8146279|P1|12|None"]}, {"move": "Chia đa thức để kiểm tra tiệm cận xiên", "how_to_apply": "Tách phần tuyến tính và phần dư tiến về không ở vô cực rồi đối chiếu đường được đề nghị.", "evidence_scope": "Quan sát riêng, thiếu khóa xác nhận nhận định sai.", "refs": ["fc12a8146279|P2|1|b"]}, {"move": "Tách giá trị hàm, hệ số góc và hệ số tự do", "how_to_apply": "Tính giá trị hàm và đạo hàm tại điểm tiếp xúc, lập tiếp tuyến rồi mới tính tổ hợp hệ số.", "evidence_scope": "Quan sát riêng, chưa xác nhận cơ chế nhận định sai.", "refs": ["fc12a8146279|P2|1|d"]}, {"move": "Kết hợp giao điểm với miền tham số", "how_to_apply": "Lập mặt phẳng từ các đoạn chắn, thế đường thẳng tham số để tìm giao; khi có giới hạn phụ, xác định đoạn còn hợp lệ trước khi xét khoảng cách và ngưỡng.", "evidence_scope": "Các bước nối tiếp trong cùng đề, không phải bằng chứng tái diễn độc lập; thiếu khóa phù hợp.", "refs": ["fc12a8146279|P2|4|c", "fc12a8146279|P2|4|d"]}, {"move": "Chọn khoảng cách thích hợp khi xét mặt cầu", "how_to_apply": "Dùng khoảng cách điểm đến tâm cho tiếp tuyến từ điểm ngoài hoặc khoảng cách tâm đến đường thẳng cho giao cắt, rồi đối chiếu với bán kính.", "evidence_scope": "Quan sát trong cùng đề; chưa xác định cơ chế nhiễu.", "refs": ["54e9a2a276ca|P2|4|b", "54e9a2a276ca|P2|4|c"]}, {"move": "Chọn đúng vectơ trước khi lấy chuẩn hoặc tích vô hướng", "how_to_apply": "Lập hiệu tọa độ đúng hướng, tính chuẩn để tìm độ dài và chia thời gian nếu cần; khi hỏi góc, chuẩn hóa tích vô hướng bằng tích độ dài.", "evidence_scope": "Có bằng chứng liên đề về phép toán tọa độ; độ dài, tốc độ, tích vô hướng và côsin là các yêu cầu riêng.", "refs": ["acc00d945397|P1|3|None", "3f1b2aa3cb72|P2|3|b", "3f1b2aa3cb72|P2|3|c", "beee25b53250|P2|1|a", "beee25b53250|P2|1|d"]}, {"move": "Khôi phục điểm từ nhiều điều kiện hình học", "how_to_apply": "Dùng tọa độ, diện tích, song song và vuông góc để suy độ dài rồi dựng vectơ cạnh đúng hướng trước khi tính biểu thức theo điểm chưa biết.", "evidence_scope": "Quan sát riêng; chưa đủ căn cứ quy nhận định cho lỗi cụ thể.", "refs": ["beee25b53250|P2|1|b"]}, {"move": "Nhận diện trọng tâm trong tổng bình phương khoảng cách", "how_to_apply": "Quy biểu thức về khoảng cách đến trọng tâm có trọng số rồi chiếu lên miền ràng buộc.", "evidence_scope": "Quan sát riêng; chưa xác nhận lỗi bỏ trọng số hoặc bỏ ràng buộc.", "refs": ["beee25b53250|P2|1|c"]}, {"move": "Quy cực tiểu khoảng cách về hình chiếu", "how_to_apply": "Lập đường tham số, dùng điều kiện vuông góc để tìm vị trí gần nhất rồi tính tọa độ cần hỏi và kiểm tra miền đường.", "evidence_scope": "Quan sát riêng ở dạng trả lời ngắn.", "refs": ["3f1b2aa3cb72|P3|4|None"]}, {"move": "Đếm nhóm khi lấy mẫu không hoàn lại", "how_to_apply": "Đếm nhóm thuận lợi và nhóm có thể chọn bằng cùng mô hình, phân biệt xác suất cả nhóm với tỉ lệ một phần tử.", "evidence_scope": "Quan sát riêng ở cấu trúc nhận định được mô tả; chưa xác nhận nhận định sai.", "refs": ["3f1b2aa3cb72|P2|2|a"]}, {"move": "Giữ bất định ở ngưỡng và tính duy nhất", "how_to_apply": "Khi cận chưa biết, xét dấu nghiêm ngặt và miền liên tục hoặc rời rạc trước khi chọn kết quả. Không dùng hàng có đại lượng chưa được xác định duy nhất làm mẫu thiết kế hay bằng chứng phân hóa.", "evidence_scope": "Quan sát riêng; có hàng chưa rõ miền biến và hàng thiếu điều kiện bảo đảm tính duy nhất.", "refs": ["3b4cca11ea82|P2|3|d", "3f1b2aa3cb72|P2|4|d"]}], "easy_vs_hard": [{"topic": "Nguyên hàm, tích phân và miền hình học", "easy": "Công thức hàm, nguyên hàm hoặc các miền và tích phân đã có; chủ yếu chọn công thức, cận hay dấu.", "hard": "Phải khôi phục biên, tìm giao điểm và điểm chuyển biên, chia miền hoặc xác định thiết diện còn lại trước khi tích phân.", "qualification": "Độ khó tăng ở mô hình và miền; một số hình chưa được kiểm chứng độc lập, hàng dễ có thể thiếu khóa.", "easy_refs": ["54e9a2a276ca|P1|4|None", "525d3542283a|P1|2|None", "7ab78715480e|P1|8|None", "beee25b53250|P1|6|None", "acc00d945397|P1|2|None", "de5833d227dd|P1|8|None"], "hard_refs": ["fc12a8146279|P3|5|None", "54e9a2a276ca|P3|5|None", "0968e8bc9e2d|P3|6|None", "525d3542283a|P3|1|None", "7ab78715480e|P3|1|None", "3f1b2aa3cb72|P3|1|None", "3b4cca11ea82|P3|5|None"]}, {"topic": "Dãy số và cấu hình đếm", "easy": "Dùng số hạng tổng quát và chênh lệch chỉ số để tìm công bội, công sai hoặc vị trí.", "hard": "Dùng quan hệ dãy làm ràng buộc trong phép gán có vị trí chung, thứ tự và không lặp.", "qualification": "Các quan hệ cấp số cộng và cấp số nhân là biến thể riêng trong khung đếm.", "easy_refs": ["54e9a2a276ca|P1|12|None", "0968e8bc9e2d|P1|5|None", "beee25b53250|P1|9|None"], "hard_refs": ["fc12a8146279|P3|6|None", "3f1b2aa3cb72|P3|3|None"]}, {"topic": "Mặt cầu và tiếp xúc", "easy