,"combines":["Mô hình doanh thu và chi phí","Hàm số bậc hai","Tối ưu trên đoạn"],"wrong_options":null,"wrong_option_details":[],"cue_use":"needed in reasoning","difficulty_source":"Phân biệt đơn giá với doanh thu và chuyển thuế theo sản phẩm thành tổng thuế.","discrimination":"medium","evidence_uncertainty":"Sản lượng mang ý nghĩa số nguyên; điểm tối ưu của mô hình liên tục phù hợp điều kiện này nên không phát sinh bước chọn số nguyên lân cận.","optional_path":null},{"part":"P3","idx":4,"sub":null,"topic":"Hệ bất phương trình bậc nhất hai ẩn: tối ưu biểu thức tuyến tính","grade":10,"given":"Hai loại đối tượng sử dụng tài nguyên khác nhau, đơn giá tương ứng, giới hạn tổng tài nguyên và giới hạn tổng số lượng.","task":"Tính doanh thu lớn nhất của phương án bố trí hợp lệ.","reasoning":["Đặt biến đếm cho từng loại và lập các ràng buộc không âm, sức chứa, tài nguyên.","Viết hàm doanh thu tuyến tính.","Xác định các đỉnh miền nghiệm và so sánh doanh thu.","Kiểm tra điều kiện số nguyên của phương án tối ưu và tính kết quả."],"steps":4,"combines":["Mô hình hóa bằng hệ bất phương trình","Miền nghiệm trong mặt phẳng","Tối ưu tuyến tính","Điều kiện số nguyên"],"wrong_options":null,"wrong_option_details":[],"cue_use":"needed in reasoning","difficulty_source":"Lập đủ hai ràng buộc sức chứa khác nhau rồi xác định đỉnh tối ưu.","discrimination":"medium","evidence_uncertainty":null,"optional_path":null},{"part":"P3","idx":5,"sub":null,"topic":"Xác suất cổ điển kết hợp đếm đường đi trên lưới","grade":10,"given":"Một hình lưới với điểm đầu, điểm cuối và điểm trung gian; các bước chỉ được đi theo hai hướng tăng tọa độ.","task":"Tính xác suất đường đi qua điểm trung gian rồi thực hiện phép chuẩn hóa được yêu cầu.","reasoning":["Theo mô hình các đường đi hoàn chỉnh đồng khả năng, mã hóa mỗi đường bằng thứ tự các bước thuộc hai hướng.","Đếm tổng số đường đi bằng cách chọn vị trí cho một loại bước.","Tách đường đi qua điểm trung gian thành hai đoạn và nhân số cách đi của hai đoạn.","Lập tỉ