[{"part": "P2", "topic": "Khoảng cách từ điểm chuyển động đến đường tròn trong không gian", "task": "Kiểm tra khoảng cách nhỏ nhất từ điểm chuyển động tới đường tròn.", "reasoning": ["Chiếu chuyển động xuống mặt phẳng chứa đường tròn.", "Biểu diễn khoảng cách đến đường tròn qua khoảng cách từ hình chiếu tới tâm và độ cao.", "Tìm khoảng cách tới tâm nhỏ nhất trên đoạn chiếu, kiểm tra vị trí tương đối với đường tròn.", "Tính khoảng cách không gian nhỏ nhất.", "Đổi đơn vị và đối chiếu nhận định."], "steps": 5, "discrimination": "high", "difficulty_source": "Chuyển khoảng cách tới một đường cong trong không gian thành bài toán tối ưu trong mặt phẳng.", "evidence_uncertainty": null}, {"part": "P2", "topic": "Tối ưu khoảng cách bằng hình chiếu vuông góc", "task": "Kiểm tra vị trí đạt khoảng cách nhỏ nhất tới đường tròn.", "reasoning": ["Biểu diễn hình chiếu của đoạn chuyển động trong mặt phẳng chứa đường tròn.", "Tìm chân đường vuông góc từ tâm tới đường thẳng chứa đoạn chiếu.", "Kiểm tra chân chiếu nằm trong đoạn và toàn đoạn chiếu ở ngoài đường tròn.", "Suy ra vị trí cực tiểu của khoảng cách không gian rồi đối chiếu tọa độ được nêu."], "steps": 4, "discrimination": "high", "difficulty_source": "Chứng minh phép tối ưu khoảng cách tới tâm cũng tối ưu khoảng cách tới đường tròn trong miền đang xét.", "evidence_uncertainty": null}, {"part": "P3", "topic": "Quy tắc đếm: điền số có ràng buộc đồng dư theo hàng và cột", "task": "Đếm các phép gán hợp lệ vào vị trí có nhãn rồi thực hiện phép chuẩn hóa được yêu cầu.", "reasoning": ["Chuyển điều kiện về hiệu chia hết thành điều kiện các lớp dư khác nhau trong từng hàng và cột.", "Phân loại các số theo lớp dư và xác định số phần tử của mỗi lớp.", "Khai thác các hàng, cột dài và hình dạng bậc thang để suy ra ràng buộc lên vị trí của từng lớp dư.", "Đếm các cấu hình lớp dư hợp lệ, phân biệt các nhánh và tránh đếm lặp.", "Đếm các hoán vị của những số phân biệt trong mỗi lớp dư.", "Nhân các hệ số đếm rồi thực hiện phép chuẩn hóa."], "steps": 6, "discrimination": "high", "difficulty_source": "Biến ràng buộc cục bộ theo hàng và cột thành cấu hình lớp dư toàn cục có số lượng cố định.", "evidence_uncertainty": "Các công cụ đếm được xếp theo chương tổ hợp; điều kiện đồng dư huy động kiến thức số học từ cấp học trước."}, {"part": "P3", "topic": "Xác suất cổ điển: đếm vị trí màu thỏa mãn điều kiện hình học", "task": "Tính xác suất thỏa mãn điều kiện rồi nhân với hệ số được yêu cầu.", "reasoning": ["Nhận diện tất cả hình vuông nội tiếp có đỉnh thuộc đa giác và quan hệ giữa các tập đỉnh của chúng.", "Rút không gian mẫu từ phép gán vật phân biệt về phép chọn vị trí của màu chỉ định, giải thích tính đồng khả năng.", "Chuyển điều kiện hình học thành yêu cầu mỗi nhóm đỉnh của một hình vuông đều nhận màu chỉ định.", "Phân loại các cách phân bố số vị trí mang màu chỉ định giữa các nhóm.", "Đếm các lựa chọn vị trí thuận lợi trong từng kiểu phân bố.", "Lập xác suất và thực hiện phép nhân cuối."], "steps": 6, "discrimination": "high", "difficulty_source": "Nhận ra cấu trúc các hình vuông và loại bỏ sự phân biệt không cần thiết giữa các vật cùng màu khi đếm xác suất.", "evidence_uncertainty": null}, {"part": "P3", "topic": "Xác suất cổ điển kết hợp điều kiện cấp số cộng", "task": "Tính nghịch đảo xác suất để các bộ vị trí đều thỏa mãn điều kiện cấp số cộng.", "reasoning": ["Mô hình hóa không gian mẫu bằng các phép gán không lặp vào vị trí có nhãn.", "Dùng tính chất trung bình cộng để biểu diễn giá trị tại mỗi vị trí trên cạnh theo hai đỉnh.", "Suy ra điều kiện chẵn lẻ và điều kiện thuộc tập cho các giá trị đỉnh.", "Loại các cấu hình làm trùng giá trị giữa những vị trí khác nhau.", "Đếm các cấu hình hợp lệ có xét thứ tự vị trí.", "Lập xác suất rồi lấy nghịch đảo."], "steps": 6, "discrimination": "high", "difficulty_source": "Biến điều kiện cục bộ trên các cạnh thành ràng buộc toàn cục về chẵn lẻ và không trùng số.", "evidence_uncertainty": "Chủ đề chính đặt ở lớp học cấp số cộng; công cụ đếm và xác suất cổ điển thuộc