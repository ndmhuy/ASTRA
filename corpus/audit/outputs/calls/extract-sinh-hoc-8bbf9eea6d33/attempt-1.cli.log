{"rows":[{"part":"P1","idx":1,"sub":null,"topic":"Học thuyết tiến hóa tổng hợp hiện đại: phiêu bạt di truyền và hiệu ứng thắt cổ chai","grade":12,"given":"Một quần thể suy giảm mạnh rồi phục hồi số lượng nhưng vẫn nghèo biến dị di truyền.","task":"Xác định nhân tố tiến hóa giải thích hiện tượng.","reasoning":"Nhận diện sự mất allele khi quần thể thu nhỏ; phân biệt phục hồi số cá thể với phục hồi vốn gene; quy hiện tượng về biến động di truyền ngẫu nhiên.","steps":3,"combines":["Phiêu bạt di truyền","Đa dạng di truyền của quần thể"],"wrong_options":"Các phương án nhiễu thay cơ chế mất allele ngẫu nhiên bằng chọn lọc, phát sinh biến dị hoặc trao đổi allele.","wrong_option_details":[{"label":"A","identifiable_error":true,"mistake_kind":"Đồng nhất suy giảm quần thể với chọn lọc","reason":"Thấy tác động gây chết rồi mặc định có sự phân hóa khả năng sống theo kiểu gene."},{"label":"B","identifiable_error":true,"mistake_kind":"Nhầm nguồn phát sinh biến dị với sự mất biến dị","reason":"Không phân biệt việc tạo allele với biến động tần số và mất allele sẵn có."},{"label":"D","identifiable_error":true,"mistake_kind":"Nhầm biến động nội bộ với trao đổi di truyền","reason":"Gán thay đổi vốn gene cho sự di chuyển cá thể dù không có dữ kiện trao đổi giữa các quần thể."}],"cue_use":"given as a cue","difficulty_source":"Dấu hiệu suy giảm đột ngột và mất allele gợi trực tiếp cơ chế","discrimination":"low","evidence_uncertainty":null,"optional_path":null},{"part":"P1","idx":2,"sub":null,"topic":"Đột biến nhiễm sắc thể: đa bội thể","grade":12,"given":"Bộ nhiễm sắc thể của dạng xuất phát và tên mức đa bội cần xét.","task":"Chọn kí hiệu bộ nhiễm sắc thể tương ứng.","reasoning":"Nhớ ý nghĩa của mức bội thể; đối chiếu số bộ nhiễm sắc thể với kí hiệu phương án.","steps":2,"combines":["Bộ nhiễm sắc thể","Đột biến đa bội"],"wrong_options":"Các phương án dùng những mức bội thể khác để kiểm tra việc hiểu thuật ngữ.","wrong_option_details":[{"label":"A","identifiable_error":true,"mistake_kind":"Giữ nguyên mức bội thể","reason":"Không chuyển từ dạng xuất phát sang dạng đa bội được yêu cầu."},{"label":"B","identifiable_error":true,"mistake_kind":"Nhầm đa bội với đơn bội","reason":"Dùng bộ nhiễm sắc thể của giao tử thay cho bộ của cơ thể đa bội."},{"label":"D","identifiable_error":true,"mistake_kind":"Nhầm các mức đa bội","reason":"Không gắn đúng tiền tố chỉ mức bội với số bộ nhiễm sắc thể."}],"cue_use":"given as a cue","difficulty_source":"Áp dụng trực tiếp định nghĩa mức bội thể","discrimination":"low","evidence_uncertainty":null,"optional_path":null},{"part":"P1","idx":3,"sub":null,"topic":"Sinh thái học quần thể: cạnh tranh cùng loài","grade":12,"given":"Một hành vi đối kháng giữa những cá thể thuộc cùng loài.","task":"Phân loại quan hệ sinh thái.","reasoning":"Xác định các cá thể cùng loài; dùng phạm vi quần thể để phân loại hành vi đối kháng.","steps":2,"combines":["Quan hệ trong quần thể","Quan hệ giữa các loài"],"wrong_options":"Nhiễu chủ yếu đánh vào việc chỉ nhìn hình thức hành vi mà bỏ qua quan hệ cùng loài.","wrong_option_details":[{"label":"A","identifiable_error":true,"mistake_kind":"Nhầm các dạng quan hệ đối kháng","reason":"Gộp mọi tác động gây hại vào quan hệ ức chế mà không xét cơ chế và phạm vi loài."},{"label":"B","identifiable_error":false,"mistake_kind":null,"reason":"Quan hệ hỗ trợ có lợi cho các bên trái rõ với hành vi gây hại được mô tả."},{"label":"D","identifiable_error":true,"mistake_kind":"Bỏ qua điều kiện khác loài","reason":"Phân loại theo hành vi sử dụng sinh vật làm thức ăn mà không kiểm tra hai bên có cùng loài hay không."}],"cue_use":"none","difficulty_source":"Phải ưu tiên dấu hiệu cùng loài hơn hình thức hành vi","discrimination":"medium","evidence_uncertainty":null,"optional_path":null},{"part":"P1","idx":4,"sub":null,"topic":"Quang hợp ở thực vật: điểm bù và điểm bão hòa khí carbon dioxide","grade":11,"given":"Đồ thị trực quan so sánh đáp ứng quang hợp của các nhóm thực vật theo nồng độ khí nguyên liệu.","task":"Chọn nhận định phù hợp với các đường biểu diễn.","reasoning":"Xác định giao điểm với trục nồng độ; xác định vùng đường cong tiến tới bão hòa; so sánh các nhóm ở từng vùng nồng độ; kiểm tra nhận định tổng hợp.","steps":4,"combines":["Sinh lí quang hợp","Đọc đồ thị","So sánh giới hạn đáp ứng"],"wrong_options":"Nhiễu đảo thứ tự điểm bù, đồng nhất các điểm đặc trưng hoặc khái quát ưu thế cho toàn miền nồng độ.","wrong_option_details":[{"label":"A","identifiable_error":true,"mistake_kind":"Khái quát hóa ngoài miền phù hợp","reason":"Kéo dài ưu thế ở một vùng điều kiện sang vùng mà các đường biểu diễn đổi thứ tự."},{"label":"B","identifiable_error":true,"mistake_kind":"Nhầm điểm bù với đặc trưng khác của đường cong","reason":"Không đọc riêng vị trí bắt đầu đồng hóa ròng của từng nhóm."},{"label":"C","identifiable_error":true,"mistake_kind":"Đảo chiều so sánh điểm bù","reason":"Gán khả năng hoạt động ở nồng độ thấp cho sai nhóm thực vật."}],"cue_use":"needed in reasoning","difficulty_source":"Phân biệt các đặc trưng của đường cong và giới hạn của nhận định khái quát","discrimination":"medium","evidence_uncertainty":null,"optional_path":null},{"part":"P1","idx":5,"sub":null,"topic":"Sinh thái học quần thể: kích thước và mật độ quần thể","grade":12,"given":"Bảng diện tích sinh cảnh và mật độ của các quần thể; có hình sinh vật minh họa không cần cho tính toán.","task":"Xác định quần thể có tổng số cá thể lớn nhất.","reasoning":"Chọn quan hệ giữa kích thước, diện tích và mật độ; tính tích cho từng hàng; so sánh các kết quả.","steps":3,"combines":["Đặc trưng quần thể","Xử lí bảng số liệu"],"wrong_options":"Cấu trúc nhiễu có thể khai thác việc chỉ so diện tích hoặc mật độ; không thể xác định nhất quán các phương án sai vì khóa mâu thuẫn với bảng gốc.","wrong_option_details":[{"label":"A","identifiable_error":null,"mistake_kind":null,"reason":"Phương án này phù hợp với phép tính từ bảng ảnh gốc nhưng bị khóa cung cấp loại."},{"label":"C","identifiable_error":null,"mistake_kind":null,"reason":"Khóa và dữ kiện không nhất quán nên không gán một lỗi học sinh cụ thể cho phương án."},{"label":"D","identifiable_error":null,"mistake_kind":null,"reason":"Khóa và dữ kiện không nhất quán nên không gán một lỗi học sinh cụ thể cho phương án."}],"cue_use":"needed in reasoning","difficulty_source":"Chọn đúng đại lượng tổng hợp thay vì so một cột riêng","discrimination":"low","evidence_uncertainty":"Khóa khớp mã đề nhưng đáp án câu này trái với bảng trong ảnh; phần lời giải đã thay một giá trị mật độ so với đề gốc.","optional_path":null},{"part":"P1","idx":6,"sub":null,"topic":"Các phân tử sinh học: liên kết trong cấu trúc DNA","grade":10,"given":"Vị trí liên kết cần nhận diện trong cấu trúc phân tử di truyền.","task":"Chọn loại liên kết nối các đơn phân trên cùng mạch.","reasoning":"Xác định đang xét liên kết dọc mạch; phân biệt với liên kết giữa các mạch và liên kết trong đơn phân; chọn tên liên kết phù hợp.","steps":3,"combines":["Cấu trúc DNA","Các loại liên kết sinh học"],"wrong_options":"Các phương án lấy tên liên kết có thật ở những vị trí hoặc đại phân tử khác.","wrong_option_details":[{"label":"A","identifiable_error":true,"mistake_kind":"Nhầm liên kết dọc mạch với liên kết giữa mạch","reason":"Nhớ một liên kết đặc trưng của phân tử nhưng đặt sai cấp cấu trúc."},{"label":"C","identifiable_error":true,"mistake_kind":"Nhầm liên kết trong đơn phân với liên kết giữa đơn phân","reason":"Không phân biệt cấu tạo nucleotide với cấu tạo chuỗi nucleotide."},{"label":"D","identifiable_error":true,"mistake_kind":"Nhầm loại đại phân tử","reason":"Chuyển loại liên kết của chuỗi amino acid sang chuỗi nucleotide."}],"cue_use":"none","difficulty_source":"Nhớ đúng vị trí của từng loại liên kết","discrimination":"low","evidence_uncertainty":null,"optional_path":null},{"part":"P1","idx":7,"sub":null,"topic":"Trao đổi vật chất trong hệ sinh thái: chuỗi thức ăn và bậc dinh dưỡng","grade":12,"given":"Một chuỗi thức ăn tuyến tính có sinh vật sản xuất và các sinh vật tiêu thụ.","task":"Xác định thành phần thuộc bậc tiêu thụ được hỏi.","reasoning":"Xác định sinh vật sản xuất; theo chiều truyền thức ăn để xác định sinh vật tiêu thụ trực tiếp nguồn sản xuất.","steps":2,"combines":["Chuỗi thức ăn","Bậc dinh dưỡng"],"wrong_options":"Nhiễu dùng các thành phần còn lại của cùng chuỗi để khai thác lỗi đếm bậc.","wrong_option_details":[{"label":"A","identifiable_error":true,"mistake_kind":"Lệch bậc tiêu thụ","reason":"Chọn sinh vật tiêu thụ ở tầng kế tiếp do đếm sai điểm bắt đầu."},{"label":"C","identifiable_error":true,"mistake_kind":"Đồng nhất bậc dinh dưỡng với bậc tiêu thụ","reason":"Tính sinh vật sản xuất như một sinh vật tiêu thụ."},{"label":"D","identifiable_error":true,"mistake_kind":"Đảo chiều hoặc chọn đỉnh chuỗi","reason":"Không bám vào chiều truyền vật chất và vị trí tương đối trong chuỗi."}],"cue_use":"given as a cue","difficulty_source":"Nhận diện vị trí trực tiếp trên chuỗi tuyến tính","discrimination":"low","evidence_uncertainty":null,"optional_path":null},{"part":"P1","idx":8,"sub":null,"topic":"Chu trình sinh địa hóa: chuyển hóa nitrogen","grade":12,"given":"Dạng hợp chất đầu vào và dạng sản phẩm của một quá trình chuyển hóa trong tự nhiên.","task":"Xác định nhóm vi khuẩn thực hiện quá trình.","reasoning":"Nhận diện chiều biến đổi giữa dạng nitrogen liên kết và dạng khí; ghép với tên quá trình và nhóm vi khuẩn tương ứng.","steps":2,"combines":["Chu trình nitrogen","Vai trò vi khuẩn"],"wrong_options":"Nhiễu hoán đổi các quá trình chuyển hóa nitrogen khác nhau.","wrong_option_details":[{"label":"A","identifiable_error":true,"mistake_kind":"Đảo chiều chuyển hóa","reason":"Nhầm quá trình đưa nitrogen khí vào hợp chất với quá trình giải phóng trở lại dạng khí."},{"label":"B","identifiable_error":true,"mistake_kind":"Nhầm sản phẩm của quá trình phân giải","reason":"Không phân biệt chuyển nitrogen hữu cơ sang dạng khử với quá trình tạo khí."},{"label":"C","identifiable_error":true,"mistake_kind":"Nhầm các quá trình có tên gần nhau","reaso