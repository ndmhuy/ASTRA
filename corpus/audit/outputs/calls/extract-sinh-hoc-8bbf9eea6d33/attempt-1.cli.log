ận định phù hợp với các đường biểu diễn.","reasoning":"Xác định giao điểm với trục nồng độ; xác định vùng đường cong tiến tới bão hòa; so sánh các nhóm ở từng vùng nồng độ; kiểm tra nhận định tổng hợp.","steps":4,"combines":["Sinh lí quang hợp","Đọc đồ thị","So sánh giới hạn đáp ứng"],"wrong_options":"Nhiễu đảo thứ tự điểm bù, đồng nhất các điểm đặc trưng hoặc khái quát ưu thế cho toàn miền nồng độ.","wrong_option_details":[{"label":"A","identifiable_error":true,"mistake_kind":"Khái quát hóa ngoài miền phù hợp","reason":"Kéo dài ưu thế ở một vùng điều kiện sang vùng mà các đường biểu diễn đổi thứ tự."},{"label":"B","identifiable_error":true,"mistake_kind":"Nhầm điểm bù với đặc trưng khác của đường cong","reason":"Không đọc riêng vị trí bắt đầu đồng hóa ròng của từng nhóm."},{"label":"C","identifiable_error":true,"mistake_kind":"Đảo chiều so sánh điểm bù","reason":"Gán khả năng hoạt động ở nồng độ thấp cho sai nhóm thực vật."}],"cue_use":"needed in reasoning","difficulty_source":"Phân biệt các đặc trưng của đường cong và giới hạn của nhận định khái quát","discrimination":"medium","evidence_uncertainty":null,"optional_path":null},{"part":"P1","idx":5,"sub":null,"topic":"Sinh thái học quần thể: kích thước và mật độ quần thể","grade":12,"given":"Bảng diện tích sinh cảnh và mật độ của các quần thể; có hình sinh vật minh họa không cần cho tính toán.","task":"Xác định quần thể có tổng số cá thể lớn nhất.","reasoning":"Chọn quan hệ giữa kích thước, diện tích và mật độ; tính tích cho từng hàng; so sánh các kết quả.","steps":3,"combines":["Đặc trưng quần thể","Xử lí bảng số liệu"],"wrong_options":"Cấu trúc nhiễu có thể khai thác việc chỉ so diện tích hoặc mật độ; không thể xác định nhất quán các phương án sai vì khóa mâu thuẫn với bảng gốc.","wrong_option_details":[{"label":"A","identifiable_error":null,"mistake_kind":null,"reason":"Phương án này phù hợp với phép tính từ bảng ảnh gốc nhưng bị khóa cung cấp loại."},{"label":"C","identifiable_error":null,"mistake_kind":null,"re