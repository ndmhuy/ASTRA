y cho tần số allele."}],"cue_use":"needed in reasoning","difficulty_source":"Áp dụng trực tiếp quy tắc đếm allele","discrimination":"low","evidence_uncertainty":null,"optional_path":null},{"part":"P1","idx":3,"sub":null,"topic":"Cấu trúc và chức năng của nhiễm sắc thể: các mức đóng xoắn","grade":12,"given":"Một kích thước đặc trưng và các tên mức tổ chức nhiễm sắc thể.","task":"Ghép kích thước với mức cấu trúc tương ứng.","reasoning":"Nhớ kích thước đặc trưng của các mức đóng xoắn; chọn mức phù hợp.","steps":2,"combines":["Cấu trúc siêu hiển vi nhiễm sắc thể"],"wrong_options":"Đưa các mức đóng xoắn khác nhau vào cùng một danh sách để khai thác sự nhầm lẫn kích thước.","wrong_option_details":[{"label":"A","identifiable_error":true,"mistake_kind":"Nhầm mức đóng xoắn","reason":"Gán kích thước cho mức tổ chức thấp hơn."},{"label":"B","identifiable_error":true,"mistake_kind":"Nhầm cấp cấu trúc","reason":"Đồng nhất một đơn vị nhiễm sắc thể đã cô đặc với sợi cấu tạo bên trong."},{"label":"C","identifiable_error":true,"mistake_kind":"Nhầm mức đóng xoắn","reason":"Gán kích thước cho mức tổ chức cao hơn."}],"cue_use":"needed in reasoning","difficulty_source":"Phụ thuộc trí nhớ về kích thước đặc trưng","discrimination":"low","evidence_uncertainty":null,"optional_path":null},{"part":"P1","idx":4,"sub":null,"topic":"Tương tác giữa kiểu gene với môi trường và thành tựu chọn giống: lai giống","grade":12,"given":"Một thành tựu chọn giống kết hợp nguồn giống khác nhau và các đặc tính có lợi.","task":"Nhận diện phương pháp tạo giống.","reasoning":"Nhận diện việc kết hợp nguồn di truyền qua sinh sản; đối chiếu với bản chất các phương pháp chọn giống.","steps":2,"combines":["Lai giống","Phương pháp tạo giống"],"wrong_options":"Thay lai giống bằng những công nghệ cũng có thể tạo biến đổi di truyền nhưng thiếu dấu hiệu phù hợp trong dữ kiện.","wrong_option_details":[{"label":"A","identifiable_error":true,"mistake_kind":"Nhầm lai giống với biến đổi bộ nhiễm sắc thể","reason":"Cho rằng kết hợp nhiều nguồn giống đồng nghĩa với tăng số bộ nhiễm sắc thể."},{"label":"C","identifiable_error":true,"mistake_kind":"Đồng nhất thành tựu chọn giống với công nghệ gene","reason":"Suy từ đặc tính tốt sang thao tác chuyển gene dù không có dữ kiện phân tử."},{"label":"D","identifiable_error":true,"mistake_kind":"Nhầm phương pháp tạo giống","reason":"Gán việc phối hợp nguồn giống cho thao tác ở cấp tế bào."}],"cue_use":"given as a cue","difficulty_source":"Bối cảnh thành tựu gợi phương pháp lai quen thuộc","discrimination":"low","evidence_uncertainty":null,"optional_path":null},{"part":"P1","idx":5,"sub":null,"topic":"Các phân tử sinh học: cấu trúc DNA","grade":10,"given":"Quan hệ liên kết giữa các đơn phân thuộc hai mạch của phân tử di truyền.","task":"Gọi tên loại liên kết giữ hai mạch với nhau.","reasoning":"Xác định vị trí liên kết được hỏi; phân biệt liên kết giữa hai mạch với liên kết trong mạch và trong phân tử khác.","steps":2,"combines":["Cấu trúc DNA","Liên kết hóa học trong phân tử sinh học"],"wrong_options":"Trộn liên kết của protein, liên kết trong nucleotide và liên kết của khung mạch.","wrong_option_details":[{"label":"A","identifiable_error":true,"mistake_kind":"Nhầm loại đại phân tử","reason":"Dùng liên kết đặc trưng của chuỗi protein cho phân tử di truyền."},{"label":"B","identifiable_error":true,"mistake_kind":"Nhầm vị trí liên kết","reason":"Lấy liên kết giữa các thành phần của nucleotide thay cho liên kết giữa hai mạch."},{"label":"C","identifiable_error":true,"mistake_kind":"Nhầm liên kết trong mạch và giữa hai mạch","reason":"Áp dụng tính chất liên kết của khung mạch cho sự bắt cặp giữa các mạch."}],"cue_use":"none","difficulty_source":"Phân biệt vị trí của các liên kết cơ bản","discrimination":"low","evidence_uncertainty":null,"optional_path":null},{"part":"P1","idx":6,"sub":null,"topic":"Công nghệ tế bào: tế bào gốc và khả năng biệt hóa","grade":10,"given":"Hình thể hiện một tế bào trung gian từ phôi có thể tạo nhiều loại tế bào chuyên hóa.","task":"Xác định bản chất của tế bào trung gian.","reasoning":"Đọc chiều các mũi tên biệt hóa; dùng khả năng tạo nhiều dòng tế bào để nhận diện loại tế bào.","steps":2,"combines":["Tế bào gốc","Biệt hóa tế bào"],"wrong_options":"Đặt các tế bào chuyên hóa và một nguồn tế bào gốc giới hạn cạnh khái niệm tổng quát cần chọn.","wrong_option_details":[{"label":"A","identifiable_error":true,"mistake_kind":"Nhầm tế bào chuyên hóa với tế bào nguồn","reason":"Không phân biệt tế bào thực hiện chức năng riêng với tế bào có khả năng biệt hóa rộng."},{"label":"B","identifiable_error":true,"mistake_kind":"Nhầm tăng sinh với tiềm năng biệt hóa","reason":"Gán khả năng tạo nhiều mô cho một tế bào đã chuyên hóa."},{"label":"C","identifiable_error":true,"mistake_kind":"Khái quát quá mức tiềm năng tế bào","reason":"Đồng nhất nguồn tế bào tạo máu với khả năng tạo nhiều dòng mô khác nhau trong hình."}],"cue_use":"given as a cue","difficulty_source":"Chiều biệt hóa trong hình chỉ rõ đặc tính nhận diện","discrimination":"low","evidence_uncertainty":null,"optional_path":null},{"part":"P1","idx":7,"sub":null,"topic":"Di truyền liên kết với giới tính: tính trạng lặn trên nhiễm sắc thể giới tính","grade":12,"given":"Quy luật di truyền của bệnh và biểu hiện bệnh qua các thế hệ trong gia đình.","task":"Chọn kết luận di truyền chắc chắn phù hợp.","reasoning":"Xác định nguồn nhiễm sắc thể giới tính của người con mắc bệnh; suy ra trạng thái mang allele của mẹ; kiểm tra khả năng truyền allele cho hậu duệ.","steps":3,"combines":["Di truyền liên kết với giới tính","Quan hệ kiểu gene và kiểu hình"],"wrong_options":"Đồng nhất không biểu hiện bệnh với không mang allele, hoặc biến xu hướng gặp bệnh thành quy luật tuyệt đối.","wrong_option_details":[{"label":"A","identifiable_error":true,"mistake_kind":"Nhầm không biểu hiện với không di truyền","reason":"Cho rằng allele gây bệnh ngừng truyền khi thế hệ sau có kiểu hình khỏe mạnh."},{"label":"B","identifiable_error":true,"mistake_kind":"Bỏ qua trạng thái mang allele lặn","reason":"Không xét allele mà người bố mắc bệnh bắt buộc truyền cho con thuộc giới tương ứng."},{"label":"D","identifiable_error":true,"mistake_kind":"Tuyệt đối hóa khác biệt giới","reason":"Biến tần suất biểu hiện khác nhau giữa các giới thành sự bất khả biểu hiện ở một giới."}],"cue_use":"given as a cue","difficulty_source":"Phải tách trạng thái mang allele khỏi biểu hiện bệnh","discrimination":"medium","evidence_uncertainty":null,"optional_path":null},{"part":"P1","idx":8,"sub":null,"topic":"Học thuyết tiến hóa tổng hợp hiện đại: tiến hóa nhỏ","grade":12,"given":"Các mô tả về bản chất, quy mô và khả năng nghiên cứu một cấp độ tiến hóa.","task":"Chọn mô tả đúng về cấp độ tiến hóa được hỏi.","reasoning":"Nhớ định nghĩa tiến hóa nhỏ; đối chiếu phạm vi và khả năng quan sát với các mô tả.","steps":2,"combines":["Tiến hóa nhỏ","Phân biệt tiến hóa nhỏ và tiến hóa lớn"],"wrong_options":"Chuyển những đặc trưng thường dùng khi mô tả tiến hóa lớn sang tiến hóa nhỏ.","wrong_option_details":[{"label":"B","identifiable_error":true,"mistake_kind":"Nhầm quy mô thời gian","reason":"Lấy đặc trưng thời gian của tiến hóa lớn làm tiêu chí cho tiến hóa nhỏ."},{"label":"C","identifiable_error":true,"mistake_kind":"Nhầm cấp độ tổ chức","reason":"Mở rộng phạm vi vượt khỏi quần thể khi nhận diện tiến hóa nhỏ."},{"label":"D","identifiable_error":true,"mistake_kind":"Nhầm khả năng kiểm chứng","reason":"Không phân biệt quá trình có thể theo dõi thực nghiệm với biến đổi trên quy mô lịch sử lớn."}],"cue_use":"none","difficulty_source":"Nhận biết định nghĩa và các đặc trưng cơ bản","discrimination":"low","evidence_uncertainty":null,"optional_path":null},{"part":"P1","idx":9,"sub":null,"topic":"Trao đổi nước và khoáng ở thực vật: hấp thụ ion khoáng","grade":11,"given":"Sự di chuyển chất khoáng từ môi trường vào tế bào hấp thụ của rễ.","task":"Xác định các cơ chế vận chuyển có thể tham gia.","reasoning":"Nhớ khả năng vận chuyển ion theo và ngược gradient; nhận ra quá trình hấp thụ c