ade": 12, "given": "Đồ thị mức chiếm bề mặt của các loài theo thời gian trên một giá thể mới.", "task": "Đánh giá việc xác định loài tiên phong.", "reasoning": ["Xác định loài xuất hiện sớm trong chuỗi quan sát.", "Đối chiếu với vai trò tiên phong trong diễn thế."], "combines": ["Diễn thế sinh thái", "Đọc đồ thị chuỗi thời gian"], "cue_use": "needed in reasoning", "evidence_uncertainty": null}, {"ref": "61a0198fbfda|P2|4|b", "part": "P2", "idx": 4, "sub": "b", "topic": "Quần xã sinh vật: bằng chứng xác định loài chủ chốt", "grade": 12, "given": "Đồ thị biến động mức chiếm bề mặt của các loài trong một giai đoạn diễn thế.", "task": "Đánh giá liệu dữ liệu mô tả có đủ xác lập vai trò chủ chốt của một loài.", "reasoning": ["Phân biệt mức phổ biến quan sát được với ảnh hưởng chi phối quần xã.", "Kiểm tra dữ liệu có thể hiện tác động của loài lên các thành phần khác hay không.", "Đánh giá mức độ được hỗ trợ của kết luận về vai trò sinh thái."], "combines": ["Loài chủ chốt", "Diễn thế sinh thái", "Giới hạn suy luận từ dữ liệu"], "cue_use": "needed in reasoning", "evidence_uncertainty": null}, {"ref": "61a0198fbfda|P2|4|c", "part": "P2", "idx": 4, "sub": "c", "topic": "Quần xã sinh vật: độ giàu loài và mức độ phong phú", "grade": 12, "given": "Một phép khảo sát sử dụng mức chiếm bề mặt của các loài làm biến đo.", "task": "Kiểm tra sự phù hợp giữa chỉ tiêu đo và đặc trưng đa dạng được gọi tên.", "reasoning": ["Nhớ độ giàu loài phản ánh số loại loài có mặt.", "Phân biệt chỉ tiêu đó với mức chiếm không gian của từng loài."], "combines": ["Đặc trưng đa dạng quần xã", "Phương pháp khảo sát sinh thái"], "cue_use": "none", "evidence_uncertainty": null}, {"ref": "61a0198fbfda|P2|4|d", "part": "P2", "idx": 4, "sub": "d", "topic": "Diễn thế sinh thái: đánh giá tính ổn định từ đồ thị biến động", "grade": 12, "given": "Các đường biến thiên mức chiếm bề mặt của nhiều loài đến cuối thời gian quan sát.", "task": "Kiểm tra kết luận rằng toàn bộ quần xã đã đồng loạt đạt cực đại và ổn định.", "reasoning": ["So sánh giá trị cuối với cực đại riêng của từng đường.", "Quan sát xu hướng còn tăng hoặc giảm ở cuối chuỗi.", "Phân biệt kết thúc theo dõi với kết thúc biến động sinh thái."], "combines": ["Diễn thế sinh thái", "Phân tích xu hướng đồ thị"], "cue_use": "needed in reasoning", "evidence_uncertainty": null}, {"ref": "61a0198fbfda|P3|1|None", "part": "P3", "idx": 1, "sub": null, "topic": "Di truyền học quần thể: xác định tần số allele từ dữ liệu điện di", "grade": 12, "given": "Ảnh điện di từng cá thể lưỡng bội với các vị trí băng tương ứng những allele khác nhau.", "task": "Ước lượng tần số một allele trong quần thể từ mẫu khảo sát.", "reasoning": ["Chuyển tổ hợp băng của từng cá thể thành kiểu gene.", "Phân biệt cá thể có một loại băng do đồng hợp với cá thể có các băng khác nhau do dị hợp.", "Đếm tổng số bản sao allele cần xét.", "Chia cho tổng số bản sao locus trong mẫu và làm tròn theo yêu cầu."], "combines": ["Điện di DNA", "Kiểu gene lưỡng bội", "Tần số allele"], "cue_use": "needed in reasoning", "evidence_uncertainty": null}, {"ref": "61a0198fbfda|P3|2|None", "part": "P3", "idx": 2, "sub": null, "topic": "Quần xã sinh vật: quan hệ dinh dưỡng và thí nghiệm xác định loài chủ chốt", "grade": 12, "given": "Quan hệ ăn và bị ăn, đồ thị biến động quần thể trước và sau khi loại bỏ một loài, cùng các nhận định cần đánh giá.", "task": "Chọn tập hợp nhận định đúng và trình bày ký hiệu theo thứ tự yêu cầu.", "reasoning": ["Dựng quan hệ tác động từ mạng dinh dưỡng đã cho.", "So sánh trạng thái quần xã trước và sau can thiệp.", "Dùng biến đổi sau loại bỏ để đánh giá vai trò của loài bị tác động.", "Đối chiếu tổng quy mô ban đầu với trạng thái sau đó.", "Tổng hợp các nhận định được dữ liệu hỗ trợ."], "combines": ["Quan hệ dinh dưỡng", "Loài chủ chốt", "Biến động quần thể", "Suy luận từ thí nghiệm loại bỏ"], "cue_use": "needed in reasoning", "evidence_uncertainty": "Các đồ thị có thang biểu diễn và phạm vi khác nhau; đánh giá tổng số cần kết hợp dữ kiện ban đầu, không cộng trực tiếp độ cao các đường."}, {"ref": "61a0198fbfda|P3|3|None", "part": "P3", "idx": 3, "sub": null, "topic": "Quần xã sinh vật: ổ sinh thái dinh dưỡng và ảnh hưởng của nguồn thức ăn", "grade": 12, "given": "Bảng liên hệ dạng cơ quan kiếm ăn với loại thức ăn và một thay đổi làm giảm nguồn tài nguyên.", "task": "Xác định nhóm sinh vật chịu tác động bất lợi trực tiếp nhất.", "reasoning": ["Xác định nguồn thức ăn bị giảm bởi thay đổi môi trường.", "Ghép nguồn đó với nhóm sử dụng chuyên biệt trong bảng."], "combines": ["Ổ sinh thái dinh dưỡng", "Quan hệ sinh vật với nguồn sống"], "cue_use": "given as a cue", "evidence_uncertainty": null}, {"ref": "61a0198fbfda|P3|4|None", "part": "P3", "idx": 4, "sub": null, "topic": "Liên kết gene và hoán vị gene: kết hợp tương tác kiểu gene với môi trường", "grade": 12, "given": "Bảng biểu hiện kiểu gene ở các điều kiện môi trường, kết quả tự thụ phấn và tỉ lệ của một nhóm kiểu hình được chọn làm bố mẹ đời sau.", "task": "Tìm tỉ lệ tối thiểu của tổ hợp kiểu hình ở đời sau sau khi thay đổi môi trường biểu hiện.", "reasoning": ["Chuyển kiểu hình ở từng môi trường thành các điều kiện kiểu gene tương ứng.", "Từ tỉ lệ đời tự thụ suy ra ràng buộc về liên kết và hoán vị gene.", "Xét các cách sắp xếp allele còn phù hợp với dữ kiện.", "Xác định thành phần kiểu gene và tần số giao tử trong nhóm bố mẹ được chọn.", "Tính tỉ lệ kiểu gene đích sau giao phối ngẫu nhiên.", "So sánh các trường hợp để chọn giá trị nhỏ nhất rồi đổi sang kiểu hình trong môi trường mới."], "combines": ["Tương tác kiểu gene với môi trường", "Trội không hoàn toàn", "Liên kết và hoán vị gene", "Chọn lọc nhóm bố mẹ", "Xác suất giao phối"], "cue_use": "needed in reasoning", "evidence_uncertainty": null}, {"ref": "61a0198fbfda|P3|5|None", "part": "P3", "idx": 5, "sub": null, "topic": "Học thuyết tiến hóa tổng hợp hiện đại: phân biệt các nhân tố làm biến đổi tần số allele", "grade": 12, "given": "Đồ thị tần số allele qua các đợt khảo sát và mô tả biến cố gây chết hàng loạt, có khoảng thời gian thiếu dữ liệu.", "task": "Chọn nhân tố được quy là nguyên nhân trực tiếp của biến đổi tần số allele.", "reasoning": ["Phân biệt biến động ngẫu nhiên với khác biệt sống sót gắn với kiểu gene.", "Xem xét việc giảm mạnh quy mô có tạo cơ sở cho suy luận về phiêu bạt di truyền hay không.", "Đối chiếu với khả năng di nhập và các nhân tố khác trong bối cảnh thiếu dữ liệu.", "Chọn phương án theo giả định nguyên nhân mà đáp án sử dụng."], "combines": ["Phiêu bạt di truyền", "Chọn lọc tự nhiên", "Dòng gene", "Đọc dữ liệu quần thể theo thời gian"], "cue_use": "needed in reasoning", "evidence_uncertainty": "Khóa chọn phiêu bạt di truyền, nhưng mô tả loại bỏ toàn bộ cá thể tại nơi khảo sát rồi có dữ liệu về sau không nêu nguồn tái lập quần thể hoặc tính ngẫu nhiên theo kiểu gene. Vì vậy không đủ cơ sở đánh giá chắc chắn sức phân hóa và mọi ngộ nhận của câu."}, {"ref": "61a0198fbfda|P3|6|None", "part": "P3", "idx": 6, "sub": null, "topic": "Gene và quá trình truyền đạt thông tin di truyền: phiên mã, dịch mã và thời điểm tác động của đột biến", "grade": 12, "given": "Sơ đồ DNA đang được phiên mã, RNA đang được dịch mã, ký hiệu các mạch và một vị trí biến đổi trên DNA.", "task": "Chọn các nhận định đúng về cơ chế đang diễn ra và tác động tức thời của can thiệp.", "reasoning": ["Nhận diện sự phối hợp giữa tổng hợp RNA và tổng hợp protein trong cùng hình.", "Dùng chiều hoạt động và quan hệ bổ sung để xác định mạch khuôn.", "Suy loại tổ chức tế bào từ khả năng phối hợp trực tiếp các quá trình.", "Xác định vị trí biến đổi nằm trước hay sau phần đã được phiên mã.", "Phân biệt tác động lên sản phẩm đang tổng hợp với tác động lên các lượt biểu hiện về sau.", "Tổng hợp các nhận định đúng theo yêu cầu."], "combines": ["Phiên mã", "Dịch mã", "Tổ chức tế bào nhân sơ", "Đột biến dịch khung", "Quan hệ thời điểm giữa DNA và sản phẩm"], "cue_use": "needed in reasoning", "evidence_uncertainty": null}, {"ref": "61a0198fbfda|P2|2|b", "part": "P2", "idx": 2, "sub": "b", "topic": "Mở rộng học thuyết Mendel: tương tác bổ sung giữa các gene trong con đường chuyển hóa", "grade": 12, "given": "Quy tắc xác định kiểu hình theo các locus phân li độc lập, sơ đồ chuyển hóa có enzyme do gene chi phối và trường hợp bố mẹ cùng biểu hiện bệnh.", "task": "Đánh giá liệu kiểu hình của bố mẹ có loại trừ hoàn toàn khả năng sinh con bình thường hay không.", "reasoning": "Xác định rằng bệnh có thể xuất phát từ các locus khác nhau; xây dựng trường hợp bố mẹ mang khiếm khuyết ở những locus khác nhau; kiểm tra khả năng con nhận đủ allele trội để phục hồi toàn bộ con đường chuyển hóa.", "combines": ["Tương tác bổ sung giữa các gene", "Quan hệ giữa gene, enzyme và kiểu hình", "Phân li độc lập"], "cue_use": "none", "evidence_uncertainty": null}, {"ref": "61a0198fbfda|P2|2|c", "part": "P2", "idx": 2, "sub": "c", "topic": "Mở rộng học thuyết Mendel: xác suất kiểu hình trong tương tác bổ sung", "grade": 12, "given": "Điều kiện kiểu gene để con đường chuyển hóa hoạt động bình thường, các locus phân li độc lập và kiểu hình bình thường của bố mẹ.", "task": "Đánh giá một xác suất sinh con mắc bệnh được khẳng định từ kiểu hình bố mẹ.", "reasoning": "Nhận diện rằng kiểu hình bình thường cho phép nhiều kiểu gene; kiểm tra liệu dữ kiện có xác định được khả năng truyền allele lặn ở từng locus hay không; xét các phép lai phù hợp để nhận ra xác suất bệnh không được xác định duy nhất.", "combines": ["Quan hệ kiểu gene và kiểu hình", "Tương tác bổ sung giữa các gene", "Xác suất trong phân li độc lập"], "cue_use": "needed in reasoning", "evidence_uncertainty": null}, {"ref": "61a0198fbfda|P2|2|d", "part": "P2", "idx": 2, "sub": "d", "topic": "Di truyền học người: xác suất có điều kiện trong bệnh do tương tác bổ sung", "grade": 12, "given": "Mô hình bệnh do các locus phân li độc lập cùng chi phối một con đường chuyển hóa, cùng thông tin kiểu hình của cặp vợ chồng và người thân thuộc các nhánh gia đình khác nhau.", "task": "Kiểm tra xác suất sinh con mắc bệnh từ thông tin gia đình.", "reasoning": "Suy ra kiểu gene của người chồng từ kiểu hình bản thân và tình trạng thiếu enzyme của bố; suy ra kiểu gene bố mẹ người vợ từ kiểu hình của họ và người con mắc bệnh; xác định phân bố kiểu gene có điều kiện của người vợ ở từng locus; tính xác suất con có đủ chức năng ở từng locus rồi kết hợp theo tính độc lập; lấy biến cố đối để tính nguy cơ mắc bệnh và đối chiếu nhận định.", "combines": ["Suy luận kiểu gene từ thông tin gia đình", "Xác suất có điều kiện", "Phân li độc lập", "Tương tác bổ sung giữa các gene"], "cue_use": "needed in reasoning", "evidence_uncertainty": null}]}
