[{"part": "P2", "topic": "Khoảng cách từ điểm chuyển động đến đường tròn trong không gian", "task": "Kiểm tra khoảng cách nhỏ nhất từ điểm chuyển động tới đường tròn.", "reasoning": ["Chiếu chuyển động xuống mặt phẳng chứa đường tròn.", "Biểu diễn khoảng cách đến đường tròn qua khoảng cách từ hình chiếu tới tâm và độ cao.", "Tìm khoảng cách tới tâm nhỏ nhất trên đoạn chiếu, kiểm tra vị trí tương đối với đường tròn.", "Tính khoảng cách không gian nhỏ nhất.", "Đổi đơn vị và đối chiếu nhận định."], "steps": 5, "discrimination": "high", "difficulty_source": "Chuyển khoảng cách tới một đường cong trong không gian thành bài toán tối ưu trong mặt phẳng.", "evidence_uncertainty": null}, {"part": "P2", "topic": "Tối ưu khoảng cách bằng hình chiếu vuông góc", "task": "Kiểm tra vị trí đạt khoảng cách nhỏ nhất tới đường tròn.", "reasoning": ["Biểu diễn hình chiếu của đoạn chuyển động trong mặt phẳng chứa đường tròn.", "Tìm chân đường vuông góc từ tâm tới đường thẳng chứa đoạn chiếu.", "Kiểm tra chân chiếu nằm trong đoạn và toàn đoạn chiếu ở ngoài đường tròn.", "Suy ra vị trí cực tiểu của khoảng cách không gian rồi đối chiếu tọa độ được nêu."], "steps": 4, "discrimination": "high", "difficulty_source": "Chứng minh phép tối ưu khoảng cách tới tâm cũng tối ưu khoảng cách tới đường tròn trong miền đang xét.", "evidence_uncertainty": null}, {"part": "P3", "topic": "Quy tắc đếm: điền số có ràng buộc đồng dư theo hàng và cột", "task": "Đếm các phép gán hợp lệ vào vị trí có nhãn rồi thực hiện phép chuẩn hóa được yêu cầu.", "reasoning": ["Chuyển điều kiện về hiệu chia hết thành điều kiện các lớp dư khác nhau trong từng hàng và cột.", "Phân loại các số theo lớp dư và xác định số phần tử của mỗi lớp.", "Khai thác các hàng, cột dài và hình dạng bậc thang để suy ra ràng buộc lên vị trí của từng lớp dư.", "Đếm các cấu hình lớp dư hợp lệ, phân biệt các nhánh và tránh đếm lặp.", "Đếm các hoán vị của những số phân biệt trong mỗi lớp dư.", "Nhân các hệ số đếm rồi thực hiện phép chuẩn hóa."], "st