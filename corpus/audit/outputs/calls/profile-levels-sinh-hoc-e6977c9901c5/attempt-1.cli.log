rade": 11, "given": "Hình hệ tuần hoàn có tên mạch, ngăn tim, chiều dòng máu và các mạng mao mạch được đánh dấu.", "task": "Kiểm tra việc xác định các mạng mao mạch theo bên cơ thể.", "reasoning": "Theo các mạch phổi dẫn tới từng mạng mao mạch; đối chiếu bên giải phẫu với nhãn trong hình.", "combines": ["Giải phẫu tuần hoàn", "Định hướng trên sơ đồ"], "cue_use": "given as a cue", "evidence_uncertainty": null}, {"ref": "55c12f561006|P2|4|b", "part": "P2", "idx": 4, "sub": "b", "topic": "Tuần hoàn ở động vật: đường đi của máu trong tuần hoàn phổi", "grade": 11, "given": "Sơ đồ dòng máu qua tim, phổi và các mạch nối.", "task": "Kiểm tra trình tự đường đi của máu trong vòng tuần hoàn trao đổi khí.", "reasoning": "Xác định ngăn tim khởi phát vòng tuần hoàn; theo dòng qua hệ mạch và mao mạch; kiểm tra ngăn tim tiếp nhận máu trở về.", "combines": ["Các ngăn tim", "Hệ mạch phổi"], "cue_use": "given as a cue", "evidence_uncertainty": null}, {"ref": "55c12f561006|P2|4|c", "part": "P2", "idx": 4, "sub": "c", "topic": "Tuần hoàn ở động vật: phân biệt loại mạch với thành phần khí trong máu", "grade": 11, "given": "Sơ đồ có cả vòng tuần hoàn trao đổi khí và vòng tuần hoàn cơ thể.", "task": "Đánh giá quy tắc khái quát về thành phần khí của máu trong các loại mạch.", "reasoning": "Nhớ loại mạch được gọi theo chiều đi so với tim; xét sự trao đổi khí trong các vòng tuần hoàn; tìm trường hợp làm quy tắc khái quát không đúng.", "combines": ["Chiều dòng máu", "Trao đổi khí", "Phân loại mạch máu"], "cue_use": "none", "evidence_uncertainty": null}, {"ref": "55c12f561006|P2|4|d", "part": "P2", "idx": 4, "sub": "d", "topic": "Tuần hoàn ở động vật: đường đi của máu trong tuần hoàn cơ thể", "grade": 11, "given": "Sơ đồ tim và hệ mạch đưa máu tới các mô rồi trở về tim.", "task": "Kiểm tra trình tự của vòng tuần hoàn cơ thể.", "reasoning": "Xác định ngăn tim bơm máu đi nuôi cơ thể; theo trình tự các loại mạch qua mô; xác định ngăn tim nhận máu trở về.", "combines": ["Các ngăn tim", "Hệ mạch cơ thể"], "cue_use": "given as a cue", "evidence_uncertainty": null}, {"ref": "55c12f561006|P3|1|None", "part": "P3", "idx": 1, "sub": null, "topic": "Di truyền học người: suy luận phả hệ với hệ nhóm máu đa allele", "grade": 12, "given": "Phả hệ có chú giải kiểu hình nhóm máu, giới tính và quan hệ huyết thống qua nhiều thế hệ.", "task": "Tính xác suất con có tổ hợp giới và nhóm máu được yêu cầu rồi làm tròn.", "reasoning": "Đọc kiểu hình và quan hệ trong phả hệ; suy ra kiểu gene bắt buộc từ các quan hệ bố mẹ và con; tính phân bố kiểu gene còn bất định của cặp cần xét có điều kiện theo kiểu hình; tính xác suất truyền allele tạo nhóm máu đích; kết hợp với giới tính và làm tròn.", "combines": ["Đa allele và đồng trội", "Phân tích phả hệ", "Xác suất có điều kiện", "Di truyền giới tính"], "cue_use": "needed in reasoning", "evidence_uncertainty": null}, {"ref": "55c12f561006|P3|2|None", "part": "P3", "idx": 2, "sub": null, "topic": "Di truyền học quần thể: tổng hợp kiểu hình sau tự thụ phấn nhiều dòng", "grade": 12, "given": "Bảng tần số các kiểu gene tại nhiều locus, quy luật trội và điều kiện tự phối độc lập.", "task": "Tính tần số kiểu hình kết hợp ở đời con của toàn quần thể.", "reasoning": "Lọc các nhóm bố mẹ có thể tạo kiểu hình đích; tính xác suất kiểu hình ấy trong đời con từng nhóm; nhân với trọng số nhóm ban đầu; cộng các đóng góp và làm tròn.", "combines": ["Phân li độc lập", "Tự thụ phấn", "Xác suất toàn phần"], "cue_use": "needed in reasoning", "evidence_uncertainty": "Khóa cung cấp không khớp phép cộng đóng góp từ các dòng theo bảng và giả thiết đã in; tên cơ quan mang tính trạng cũng không nhất quán giữa phần quy ước và yêu cầu."}, {"ref": "55c12f561006|P3|3|None", "part": "P3", "idx": 3, "sub": null, "topic": "DNA và cơ chế tái bản DNA: theo dõi dấu đồng vị qua thay đổi môi trường", "grade": 12, "given": "DNA được đánh dấu đồng vị, lịch sử nhân đôi qua các môi trường khác nhau và số phân tử thuộc một lớp đồng vị ở giai đoạn trung gian.", "task": "Tính số phân tử chỉ chứa loại đồng vị được yêu cầu sau giai đoạn cuối.", "reasoning": "Áp dụng tái bản bán bảo tồn để phân loại DNA sau giai đoạn đầu; suy ra lượng DNA ban đầu từ lớp phân tử đã biết; theo dõi các mạch cũ khi đổi môi trường; đếm hoặc lấy bù để xác định lớp DNA đích.", "combines": ["Tái bản bán bảo tồn", "Bảo toàn mạch DNA", "Tăng số lượng phân tử"], "cue_use": "needed in reasoning", "evidence_uncertainty": null}, {"ref": "55c12f561006|P3|4|None", "part": "P3", "idx": 4, "sub": null, "topic": "Sinh thái học quần thể: liên hệ mật độ, diện tích và kích thước", "grade": 12, "given": "Bảng diện tích phân bố và mật độ của các quần thể cùng loài.", "task": "Tính kích thước các quần thể và báo giá trị lớn nhất.", "reasoning": "Đổi mật độ thành số cá thể bằng diện tích tương ứng; so sánh các tích và chọn giá trị lớn nhất.", "combines": ["Mật độ quần thể", "Kích thước quần thể", "Đọc bảng"], "cue_use": "needed in reasoning", "evidence_uncertainty": null}, {"ref": "55c12f561006|P3|5|None", "part": "P3", "idx": 5, "sub": null, "topic": "Sinh thái học quần thể: tỉ lệ tăng trưởng có di cư", "grade": 12, "given": "Bảng tỉ lệ các quá trình bổ sung và mất cá thể tại các thời điểm.", "task": "Tính tỉ lệ tăng trưởng ròng ở thời điểm được yêu cầu.", "reasoning": "Chọn đúng cột thời điểm; cộng các nguồn bổ sung cá thể; trừ các nguồn mất cá thể và biểu diễn theo đơn vị yêu cầu.", "combines": ["Sinh sản và tử vong", "Nhập cư và xuất cư", "Đọc bảng"], "cue_use": "needed in reasoning", "evidence_uncertainty": null}, {"ref": "55c12f561006|P3|6|None", "part": "P3", "idx": 6, "sub": null, "topic": "Mở rộng học thuyết Mendel: allele gây chết và tỉ lệ kiểu hình ở nhóm sống sót", "grade": 12, "given": "Phép lai xét các tính trạng có trội hoàn toàn, một kiểu gene gây chết sớm và tổng số cá thể sống.", "task": "Tính số cá thể sống mang kiểu hình đích.", "reasoning": "Xác định kiểu gene bị loại trước khi thống kê; thiết lập phân li chung theo quan hệ giữa các locus; tính tỉ lệ kiểu hình đích có điều kiện sống sót; nhân với tổng số cá thể sống.", "combines": ["Di truyền Mendel", "Allele gây chết", "Xác suất có điều kiện"], "cue_use": "needed in reasoning", "evidence_uncertainty": "Đề chỉ nêu các gene nằm trên nhiễm sắc thể thường, chưa xác định quan hệ liên kết hoặc phân li độc lập; khóa tương ứng với cách giải giả định phân li độc lập, nên kết quả số chưa được xác định duy nhất bằng các giả thiết đã in."}]}
