rt":"P1","idx":17}],"description":"Các nhận định cùng xét phản ứng hòa tan chọn lọc và thành phần sau lọc.","scope":"statements_within_question","support":"layout_observation"},{"id":"S5","kind":"Mô tả polymer kèm hình cấu tạo mắt xích.","members":[{"part":"P2","idx":1}],"description":"Các ý dùng chung thông tin về cấu trúc, tổng hợp và xử lý một polyester.","scope":"statements_within_question","support":"layout_observation"},{"id":"S6","kind":"Chuỗi thao tác và hiện tượng tạo phức.","members":[{"part":"P2","idx":2}],"description":"Các ý cùng phân tích sự hòa tan và thay đổi môi trường phối trí của một ion kim loại.","scope":"statements_within_question","support":"layout_observation"},{"id":"S7","kind":"Quy trình thủy phân sinh học và bảng kết quả.","members":[{"part":"P2","idx":3}],"description":"Các ý cùng sử dụng điều kiện phản ứng, thành phần nguyên liệu và xu hướng hiệu suất theo nhiệt độ.","scope":"statements_within_question","support":"layout_observation"},{"id":"S8","kind":"Mô tả bảo vệ vật kim loại trong dung dịch điện li.","members":[{"part":"P2","idx":4}],"description":"Các ý cùng xét lựa chọn vật liệu hi sinh, vai trò điện cực và thời gian bảo vệ.","scope":"statements_within_question","support":"layout_observation"}],"optional_paths":[],"limits":["Không quan sát thấy nhóm câu tự chọn hoặc dữ kiện dùng chung giữa các câu khác nhau hay giữa các phần.","Các tập phát biểu ở phần chọn phương án vẫn là một câu chấm điểm; các ý ở phần đúng sai được biểu diễn thành từng hàng.","Không có danh mục chương trình phù hợp được cung cấp; lớp được gán theo vị trí kiến thức phổ thông có thể nhận diện, nội dung khó quy về một lớp được để trống.","Đã có ví dụ hiệu chuẩn chính thức dạng trừu tượng để đối chiếu; mức phân hóa ở đây là nhận định từ thao tác tư duy, không phải kết quả thống kê thí sinh.","Sử dụng khóa đáp án được cung cấp là khóa đã ghép với đề; các phương án chỉ khác số lượng phát biểu đúng không luôn xác định được duy nhất phát biểu mà người chọn đã hiểu sai."]},"rows":[{"part":"P1","idx":1,"sub":null,"topic":"Pin điện hóa: quá trình tại điện cực và chiều chuyển electron","grade":12,"given":"Mô tả một pin kim loại tiếp xúc với chất oxi hóa từ môi trường, các môi trường điện li và một tập nhận định.","task":"Đếm các nhận định đúng về hoạt động của pin.","reasoning":["Xác định điện cực bị oxi hóa và điện cực xảy ra sự khử.","Suy ra vai trò chất oxi hóa và chiều electron ở mạch ngoài.","Xét khả năng tồn tại của sản phẩm điện cực trong các môi trường điện li.","Tổng hợp các đánh giá và chọn phương án đếm."],"steps":4,"combines":["Pin điện hóa","Oxi hóa – khử","Ảnh hưởng của môi trường đến sản phẩm phản ứng"],"wrong_options":"Các phương án đếm thưởng cho việc đảo vai trò chất oxi hóa hoặc loại nhầm nhận định về electron và sản phẩm điện cực.","wrong_option_details":[{"label":"B","identifiable_error":true,"mistake_kind":"Đảo vai trò oxi hóa – khử","reason":"Chấp nhận cả nhận định mô tả chất nhận electron thành chất nhường electron."},{"label":"C","identifiable_error":true,"mistake_kind":"Đánh giá thiếu nhận định đúng","reason":"Có thể bác bỏ nhầm một nhận định về chiều electron hoặc khả năng tồn tại của sản phẩm; số đếm không xác định duy nhất lỗi."},{"label":"D","identifiable_error":true,"mistake_kind":"Nhầm nhiều thuộc tính của pin","reason":"Có thể chỉ nhận ra quá trình oxi hóa kim loại và bỏ qua các hệ quả đúng khác; không thể truy ngược duy nhất lỗi từ số đếm."}],"cue_use":"needed in reasoning","difficulty_source":"Kết hợp cơ chế pin với sự phụ thuộc sản phẩm vào môi trường","discrimination":"medium","evidence_uncertainty":null,"optional_path":null},{"part":"P1","idx":2,"sub":null,"topic":"Ứng dụng hợp chất chlorine trong khử trùng nước","grade":null,"given":"Một công đoạn xử lý nước và các vật liệu hoặc hóa chất có công dụng khác nhau.","task":"Chọn chất phù hợp với cơ chế khử trùng bằng oxi hóa.","reasoning":["Nhận diện cơ chế hóa học cần có của chất khử trùng.","Phân biệt chất oxi hóa với chất hấp phụ và chất keo tụ."],"steps":2,"combines":["Tính oxi hóa","Ứng dụng hóa chất trong xử lý nước"],"wrong_options":"Đưa các vật liệu cùng xuất hiện trong xử lý nước nhưng đảm nhiệm công đoạn khác.","wrong_option_details":[{"label":"A","identifiable_error":true,"mistake_kind":"Lẫn hấp phụ với khử trùng","reason":"Đồng nhất khả năng loại chất bẩn bằng hấp phụ với khả năng tiêu diệt vi sinh vật bằng oxi hóa."},{"label":"C","identifiable_error":true,"mistake_kind":"Lẫn keo tụ với khử trùng","reason":"Chọn hóa chất làm trong nước thay cho hóa chất oxi hóa."},{"label":"D","identifiable_error":true,"mistake_kind":"Lẫn công dụng hóa chất xử lý nước","reason":"Dùng công dụng keo tụ để giải thích tác dụng khử trùng."}],"cue_use":"needed in reasoning","difficulty_source":"Phân biệt công dụng của các chất cùng lĩnh vực ứng dụng","discrimination":"low","evidence_uncertainty":"Nội dung ứng dụng có thể xuất hiện trong bài về halogen hoặc chuyên đề xử lý nước; thiếu tham chiếu để gán chắc một lớp.","optional_path":null},{"part":"P1","idx":3,"sub":null,"topic":"Dẫn xuất halogen: phản ứng thế nhóm chức","grade":11,"given":"Phương trình chuyển một dẫn xuất hữu cơ thành hợp chất có nhóm chức khác.","task":"Phân loại phản ứng hữu cơ.","reasoning":["So sánh nhóm nguyên tử trong chất đầu và sản phẩm.","Nhận ra một nhóm bị thay thế và chọn loại phản ứng."],"steps":2,"combines":["Dẫn xuất halogen","Phân loại phản ứng hữu cơ"],"wrong_options":"Các nhãn nhiễu dựa trên nhầm sự thay nhóm với cộng, tách hoặc trao đổi electron.","wrong_option_details":[{"label":"B","identifiable_error":true,"mistake_kind":"Lẫn phản ứng thế và cộng","reason":"Chỉ thấy xuất hiện nhóm mới mà không kiểm tra nhóm cũ đã rời phân tử."},{"label":"C","identifiable_error":true,"mistake_kind":"Lẫn biến đổi nhóm chức với oxi hóa – khử","reason":"Coi mọi chuyển hóa chất hữu cơ thành lớp chất khác là phản ứng trao đổi electron."},{"label":"D","identifiable_error":true,"mistake_kind":"Lẫn điều kiện phản ứng với bản chất phản ứng","reason":"Liên hệ việc đun nóng dẫn xuất với phản ứng tách mà bỏ qua sản phẩm đã cho."}],"cue_use":"given as a cue","difficulty_source":"Sự thay nhóm hiện trực tiếp trong phương trình","discrimination":"low","evidence_uncertainty":null,"optional_path":null},{"part":"P1","idx":4,"sub":null,"topic":"Kim loại nhóm IA: màu ngọn lửa","grade":12,"given":"Màu ngọn lửa quan sát được khi thử một hợp chất kim loại và các lựa chọn nguyên tố.","task":"Nhận diện nguyên tố từ dấu hiệu thực nghiệm.","reasoning":["Nhớ mối liên hệ giữa màu ngọn lửa và nguyên tố.","Đối chiếu lựa chọn với nhóm nguyên tố được nêu."],"steps":2,"combines":["Kim loại nhóm IA","Nhận biết bằng màu ngọn lửa"],"wrong_options":"Trộn các nguyên tố có màu thử khác nhau và một nguyên tố ngoài nhóm được hỏi.","wrong_option_details":[{"label":"B","identifiable_error":false,"mistake_kind":null,"reason":"Có thể loại bằng điều kiện về nhóm nguyên tố ngay trong lời dẫn."},{"label":"C","identifiable_error":true,"mistake_kind":"Nhớ lẫn màu ngọn lửa","reason":"Ghép dấu hiệu màu với một nguyên tố cùng nhóm nhưng cho màu khác."},{"label":"D","identifiable_error":true,"mistake_kind":"Nhớ lẫn dấu hiệu nhận biết","reason":"Thay dấu hiệu đặc trưng đang xét bằng màu thường gặp của một nguyên tố cùng nhóm."}],"cue_use":"needed in reasoning","difficulty_source":"Gợi nhớ trực tiếp dấu hiệu định tính","discrimination":"low","evidence_uncertainty":null,"optional_path":null},{"part":"P1","idx":5,"sub":null,"topic":"Kim loại: liên hệ tính chất vật lí với ứng dụng","grade":12,"given":"Một vật kim loại nhỏ được dùng để làm tăng khả năng chìm của một bộ phận.","task":"Chọn tính chất vật lí giải thích trực tiếp công dụng.","reasoning":["Xác định yêu cầu vật lí của ứng dụng.","Chọn tính chất tạo khối lượng lớn trong thể tích nhỏ."],"steps":2,"combines":["Tính chất vật lí kim loại","Quan hệ khối lượng và thể tích"],"wrong_options":"Dùng những tính chất kim loại quen thuộc nhưng không quyết định công dụng được mô tả.","wrong_option_details":[{"label":"A","ident