ại: lựa chọn anode hi sinh","grade":12,"given":"Một hệ bảo vệ điện hóa trong dung dịch điện li và đề xuất thay vật liệu hi sinh.","task":"Đánh giá vật liệu thay thế có tiếp tục bảo vệ kim loại nền.","reasoning":["So sánh tính khử của kim loại thay thế với kim loại cần bảo vệ.","Xác định kim loại nào sẽ là anode khi tiếp xúc.","Kết luận chiều tác động lên sự ăn mòn."],"steps":3,"combines":["Dãy điện hóa","Ăn mòn điện hóa","Bảo vệ cathode"],"wrong_options":"Cho rằng gắn bất kỳ kim loại khác nào cũng tạo được tác dụng hi sinh.","wrong_option_details":[{"label":"a","identifiable_error":true,"mistake_kind":"Bỏ điều kiện hoạt tính của anode hi sinh","reason":"Không kiểm tra kim loại gắn thêm có dễ bị oxi hóa hơn kim loại nền hay không."}],"cue_use":"needed in reasoning","difficulty_source":"Kiểm tra chiều ăn mòn khi đổi cặp kim loại","discrimination":"medium","evidence_uncertainty":null,"optional_path":null},{"part":"P2","idx":4,"sub":"b","topic":"Bảo vệ điện hóa: thời gian tiêu hao anode theo định luật Faraday","grade":12,"given":"Khối lượng vật liệu hi sinh, phần sử dụng hữu ích, cường độ dòng điện, hằng số điện hóa và thời gian được đề xuất.","task":"Kiểm tra thời gian bảo vệ tối đa.","reasoning":["Tính khối lượng thực sự tham gia tạo dòng điện.","Đổi lượng kim loại thành lượng electron theo quá trình oxi hóa.","Tính điện lượng rồi suy ra thời gian từ cường độ dòng điện.","Đổi đơn vị thời gian, làm tròn và đối chiếu."],"steps":4,"combines":["Định luật Faraday","Oxi hóa kim loại","Hiệu suất sử dụng vật liệu","Đổi đơn vị"],"wrong_options":"Đặt phép tính có hiệu suất hao hụt và hệ số electron để kiểm tra cách quy đổi tuổi thọ vật liệu.","wrong_option_details":[{"label":"b","identifiable_error":true,"mistake_kind":"Xử lý sai phần vật liệu hữu ích hoặc điện lượng","reason":"Thời gian sai có thể do bỏ hao hụt, đặt sai chiều hiệu suất hoặc quy đổi electron và đơn vị sai; giá trị đề xuất không xác định duy nhất một lỗi."}],"cue_use":"needed in reasoning","difficulty_source":"Đặt đúng hiệu suất sử dụng trước khi áp dụng công thức điện lượng","discrimination":"medium","evidence_uncertainty":null,"optional_path":null},{"part":"P2","idx":4,"sub":"c","topic":"Ăn mòn điện hóa: phản ứng cathode trong môi trường có oxygen","grade":12,"given":"Bề mặt kim loại được bảo vệ trong dung dịch có khí hòa tan và nhận định về chiều biến đổi của khí.","task":"Đánh giá bản chất quá trình xảy ra ở bề mặt được bảo vệ.","reasoning":["Xác định bề mặt được bảo vệ là nơi nhận electron.","Suy ra khí hòa tan bị khử thay vì bị oxi hóa."],"steps":2,"combines":["Bảo vệ cathode","Oxi hóa – khử"],"wrong_options":"Đảo chiều trao đổi electron của chất oxi hóa ở cathode.","wrong_option_details":[{"label":"c","identifiable_error":true,"mistake_kind":"Đảo oxi hóa và khử","reason":"Gọi quá trình nhận electron của khí hòa tan là quá trình oxi hóa."}],"cue_use":"given as a cue","difficulty_source":"Hiểu bản chất nhận electron tại cathode","discrimination":"low","evidence_uncertainty":null,"optional_path":null},{"part":"P2","idx":4,"sub":"d","topic":"Bảo vệ điện hóa: vai trò và dấu điện cực","grade":12,"given":"Một cặp kim loại tiếp xúc trong dung dịch điện li với vật liệu hi sinh đã xác định.","task":"Đánh giá cách gán anode, cathode và dấu điện cực.","reasoning":["Xác định vật liệu hi sinh là nơi nhường electron.","Gán vai trò và dấu điện cực cho hệ điện hóa tự diễn biến."],"steps":2,"combines":["Anode và cathode","Pin điện hóa tự diễn biến"],"wrong_options":"Không có nhận định sai theo khóa ở ý này.","wrong_option_details":[],"cue_use":"given as a cue","difficulty_source":"Áp dụng quy tắc điện cực của hệ tự phát","discrimination":"low","evidence_uncertainty":null,"optional_path":null},{"part":"P3","idx":1,"sub":null,"topic":"Nhận biết hữu cơ: phản ứng màu, tạo phức và kết tủa","grade":null,"given":"Một tập thí nghiệm hữu cơ có điều kiện phản ứng và danh sách hiện tượng cần ghép.","task":"Mã hóa thứ tự thí nghiệm theo thứ tự hiện tượng.","reasoning":["Phân loại nhóm chức và kiểu tương tác trong từng thí nghiệm.","Dự đoán hiện tượng khử, tạo phức hoặc tạo kết tủa đặc trưng theo điều kiện.","Ghép từng hiện tượng với thí nghiệm rồi ghi chuỗi nhãn."],"steps":3,"combines":["Tính khử của đường","Tạo phức của amine","Phản ứng màu protein","Phản ứng iodoform"],"wrong_options":null,"wrong_option_details":[],"cue_use":"needed in reasoning","difficulty_source":"Phân biệt các hiện tượng dùng thuốc thử gần nhau và chú ý điều kiện đun nóng","discrimination":"medium","evidence_uncertainty":"Tập thí nghiệm kết hợp kiến thức hữu cơ thuộc nhiều lớp; không gán một lớp duy nhất.","optional_path":null},{"part":"P3","idx":2,"sub":null,"topic":"Kim loại tác dụng với dung dịch muối: biến thiên khối lượng","grade":12,"given":"Các mẫu kim loại ban đầu như nhau, những dung dịch muối có cùng lượng chất và điều kiện sản phẩm bám hoàn toàn vào mẫu.","task":"Ghép từng dung dịch với kiểu thay đổi khối lượng mẫu.","reasoning":["Dùng dãy hoạt động để xác định phản ứng có xảy ra hay không.","Viết quan hệ tỉ lượng giữa kim loại hòa tan và kim loại bám.","Chọn cùng cơ sở lượng muối để tính biến thiên khối lượng.","So sánh dấu và độ lớn của biến thiên rồi mã hóa thứ tự."],"steps":4,"combines":["Dãy hoạt động kim loại","Tỉ lượng oxi hóa – khử","Bảo toàn khối lượng trên mẫu rắn"],"wrong_options":null,"wrong_option_details":[],"cue_use":"needed in reasoning","difficulty_source":"So sánh trên cùng lượng muối và tính đúng hệ số hòa tan, bám kim loại","discrimination":"medium","evidence_uncertainty":null,"optional_path":null},{"part":"P3","idx":3,"sub":null,"topic":"Phenol: tính acid yếu và phản ứng thế ở vòng thơm","grade":11,"given":"Một hợp chất phenol và danh sách dung dịch thuộc các loại acid – base, muối và tác nhân thế.","task":"Đếm các dung dịch có thể phản ứng.","reasoning":["Xét khả năng phản ứng thế với tác nhân phù hợp.","So sánh tính acid của phenol với các hệ acid – base liên quan trong dung dịch.","Loại các chất không có động lực phản ứng và đếm."],"steps":3,"combines":["Phản ứng thế của phenol","Tính acid yếu","Cân bằng acid – base"],"wrong_options":null,"wrong_option_details":[],"cue_use":"needed in reasoning","difficulty_source":"Phân biệt các base có mức độ mạnh khác nhau thay vì coi mọi muối đều tương tự","discrimination":"medium","evidence_uncertainty":null,"optional_path":null},{"part":"P3","idx":4,"sub":null,"topic":"pH và phản ứng trung hòa: lượng hóa chất xử lý dung dịch","grade":11,"given":"Lưu lượng dung dịch acid, pH đầu và đích, độ tinh khiết của chất trung hòa cùng giả thiết bỏ qua các cân bằng phụ.","task":"Tính khối lượng hóa chất thương phẩm cần dùng.","reasoning":["Đổi pH đầu và đích thành nồng độ ion liên quan.","Tính lượng acid cần loại theo thể tích dung dịch.","Dùng tỉ lượng trung hòa để tìm lượng chất tinh khiết.","Hiệu chỉnh độ tinh khiết, đổi đơn vị và làm tròn."],"steps":4,"combines":["pH","Trung hòa acid – base","Tỉ lượng phản ứng","Độ tinh khiết"],"wrong_options":null,"wrong_option_details":[],"cue_use":"needed in reasoning","difficulty_source":"Chọn đúng lượng acid cần trung hòa đến ngưỡng đích và chiều hiệu chỉnh độ tinh khiết","discrimination":"medium","evidence_uncertainty":null,"optional_path":null},{"part":"P3","idx":5,"sub":null,"topic":"Peptide: thủy phân chọn lọc bằng enzyme","grade":12,"given":"Quy tắc nhận diện vị trí cắt của enzyme và một chuỗi peptide viết bằng ký hiệu amino acid.","task":"Đếm các loại sản phẩm có độ dài được yêu cầu.","reasoning":["Đánh dấu liên kết có thể cắt theo chiều nhóm carboxyl của gốc được nhận diện.","Chia chuỗi thành các đoạn sau khi cắt hết các vị trí phù hợp.","Lọc các đoạn có độ dài cần tìm.","Loại đoạn trùng nhau rồi đếm số loại."],"steps":4,"combines":["Cấu trúc peptide","Tính đặc hiệu enzyme","Phân biệt số lượng và số loại"],"wrong_options":null,"wrong_option_details":[],"cue_use":"given as a cue","difficulty_source":"Cắt đúng chiều và phân biệt các mảnh trùng loại","discrimination":"medium","evidence_uncertainty":null,"optional_path":null},{"part":"P3","idx":6,"sub":null,"topic":"Nhiệt hóa học và tỉ lượng: liên kết nhiên liệu, điện năng và sản phẩm hóa học","grade":null,"given":"Sản lượng năng lượng hữu ích, thành phần hỗn hợp nhiên liệu, dữ liệu nhiệt tạo thành, các hiệu suất và độ tinh khiết sản phẩm cuối.","task":"Tính khối lượng sản phẩm thương phẩm từ khí tạo ra khi đốt nhiên liệu.","reasoning":["Cân bằng các phương trình đốt cháy và tính nhiệt phản ứng từ nhiệt tạo thành.","Chọn cơ sở hỗn hợp để tính nhiệt tỏa ra và lượng khí sản phẩm trên cùng cơ sở.","Quy đổi năng lượng hữu ích thành nhiệt đốt cần cung cấp bằng hiệu suất chuyển hóa.","Suy ra lượng nhiên liệu và lượng khí nguyên liệu cho công đoạn tổng hợp.","Dùng tỉ lượng tổng hợp, hiệu suất phản ứng và độ tinh khiết để tính khối lượng thương phẩm.","Đổi đơn vị và làm tròn kết quả."],"steps":6,"combines":["Nhiệt tạo thành và nhiệt phản ứng","Thành phần hỗn hợp khí","Hiệu suất chuyển hóa năng lượng","Bảo toàn nguyên tố và tỉ lượng","Hiệu suất tổng hợp","Độ tinh khiết"],"wrong_options":null,"wrong_option_details":[],"cue_use":"needed in reasoning","difficulty_source":"Duy trì cùng cơ sở hỗn hợp và đúng chiều của các hiệu suất qua chuỗi quy đổi đã xác định","discrimination":"medium","evidence_uncertainty":"Bài nối nhiệt hóa học, hydrocarbon và tính toán hiệu suất xuyên lớp; không đủ cơ sở gán duy nhất một lớp. Chuỗi quy đổi chủ yếu theo công thức quen thuộc, chưa đòi hỏi mô hình dòng có ẩn và ràng buộc như ví dụ hiệu chuẩn mức cao.","optional_path":null}]}
