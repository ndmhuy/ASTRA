ích lăng trụ.","Nhân diện tích đáy với chiều cao."],"steps":2,"combines":["Thể tích khối lăng trụ"],"wrong_options":"Một lựa chọn dùng hệ số thể tích khối chóp, một lựa chọn chia đôi tích; lựa chọn còn lại không cho thấy lỗi chuẩn rõ ràng.","wrong_option_details":[{"label":"A","identifiable_error":true,"mistake_kind":"Nhầm công thức thể tích","reason":"Dùng hệ số dành cho khối chóp khi tính thể tích lăng trụ."},{"label":"B","identifiable_error":true,"mistake_kind":"Thêm hệ số chia không cần thiết","reason":"Chia đôi tích diện tích đáy và chiều cao dù diện tích đáy đã được cho."},{"label":"C","identifiable_error":null,"mistake_kind":null,"reason":"Không nhận diện được phép tính sai thông dụng tạo ra lựa chọn này."}],"cue_use":"given as a cue","difficulty_source":"Thay trực tiếp dữ kiện vào công thức.","discrimination":"low","evidence_uncertainty":"Nguồn gốc của một phương án nhiễu không rõ từ dữ kiện.","optional_path":null},{"part":"P1","idx":8,"sub":null,"topic":"Ứng dụng tích phân: diện tích hình phẳng","grade":12,"given":"Một hàm bậc hai và khoảng giới hạn theo phương ngang của miền nằm giữa đồ thị với trục hoành.","task":"Chọn công thức biểu diễn diện tích miền.","reasoning":["Nhận diện đây là bài toán diện tích giữa đồ thị và trục hoành.","Phân biệt tích phân giá trị tuyệt đối với giá trị tuyệt đối của tích phân khi hàm đổi dấu.","Chọn công thức phù hợp."],"steps":3,"combines":["Diện tích hình phẳng","Dấu của hàm số","Tích phân xác định"],"wrong_options":"Các phương án nhiễu nhầm diện tích với tích phân có dấu hoặc đưa công thức thể tích khối tròn xoay vào bài toán phẳng.","wrong_option_details":[{"label":"A","identifiable_error":true,"mistake_kind":"Nhầm diện tích với độ lớn tích phân","reason":"Cho phép các phần nằm khác phía trục hoành triệt tiêu trước khi lấy giá trị tuyệt đối."},{"label":"B","identifiable_error":true,"mistake_kind":"Trộn công thức diện tích và thể tích","reason":"Thêm hệ số của bài toán quay vào tích phân diện tích phẳng."},{"label":"C","id