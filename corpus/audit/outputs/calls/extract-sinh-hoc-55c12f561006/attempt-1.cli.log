ke_kind":"Dùng giới hạn thay cho trạng thái hữu hạn","reason":"Cho rằng phần đồng hợp đã đạt mức cân bằng giữa các allele ngay sau quá trình tự phối hữu hạn."},{"label":"B","identifiable_error":true,"mistake_kind":"Trả lời nhầm đại lượng","reason":"Tính phần dị hợp còn lại nhưng dùng làm tần số kiểu gene đồng hợp."},{"label":"D","identifiable_error":true,"mistake_kind":"Chia sai phần cần phân bổ","reason":"Chia phần dị hợp còn lại cho các kiểu gene đồng hợp thay vì chia phần dị hợp đã mất."}],"cue_use":"needed in reasoning","difficulty_source":"Áp dụng trực tiếp quy luật giảm dị hợp qua tự phối","discrimination":"low","evidence_uncertainty":null,"optional_path":null},{"part":"P1","idx":3,"sub":null,"topic":"Sinh thái học quần thể: các nhân tố làm biến động kích thước","grade":12,"given":"Các cặp quá trình làm thay đổi số lượng cá thể.","task":"Chọn cặp quá trình cùng làm tăng kích thước quần thể.","reasoning":"Xác định chiều tác động của từng quá trình; chọn cặp đều bổ sung cá thể.","steps":2,"combines":["Sinh sản và tử vong","Nhập cư và xuất cư"],"wrong_options":"Mỗi nhiễu ghép một quá trình bổ sung cá thể với một quá trình làm mất cá thể.","wrong_option_details":[{"label":"A","identifiable_error":true,"mistake_kind":"Không phân biệt chiều di chuyển","reason":"Coi mọi sự di chuyển cá thể đều có tác dụng tăng kích thước."},{"label":"B","identifiable_error":true,"mistake_kind":"Nhầm chiều tác động của xuất cư","reason":"Nhận đúng tác dụng của sinh sản nhưng coi cá thể rời đi là nguồn bổ sung."},{"label":"D","identifiable_error":true,"mistake_kind":"Nhầm biến động với tăng trưởng","reason":"Chọn các quá trình làm thay đổi số lượng mà không kiểm tra chúng làm tăng hay giảm."}],"cue_use":"none","difficulty_source":"Nhận biết trực tiếp dấu tác động của các quá trình","discrimination":"low","evidence_uncertainty":null,"optional_path":null},{"part":"P1","idx":4,"sub":null,"topic":"Cấu trúc và chức năng của nhiễm sắc thể: các mức đóng xoắn","grade":12,"given":"Kích thước đặc trưng của một mức tổ chức nhiễm sắc thể.","task":"Gọi tên mức cấu trúc tương ứng.","reasoning":"Nhớ quan hệ giữa kích thước và mức đóng xoắn; ghép dữ kiện với tên cấu trúc.","steps":2,"combines":["Cấu trúc nhiễm sắc thể"],"wrong_options":"Các nhiễu đều là mức tổ chức có thật nhưng thuộc bậc đóng xoắn khác.","wrong_option_details":[{"label":"A","identifiable_error":true,"mistake_kind":"Nhầm bậc đóng xoắn","reason":"Gán kích thước của cấu trúc cô đặc hơn cho một mức sợi thấp hơn."},{"label":"B","identifiable_error":true,"mistake_kind":"Nhầm mức tổ chức cơ sở","reason":"Không phân biệt cấu trúc sợi cơ sở với cấu trúc nhiễm sắc thể đã cô đặc."},{"label":"C","identifiable_error":true,"mistake_kind":"Nhầm các mức liền kề","reason":"Đồng nhất mức cuộn trung gian với mức tổ chức cao hơn."}],"cue_use":"needed in reasoning","difficulty_source":"Phụ thuộc trí nhớ về kích thước các bậc cấu trúc","discrimination":"low","evidence_uncertainty":null,"optional_path":null},{"part":"P1","idx":5,"sub":null,"topic":"Dinh dưỡng và tiêu hóa ở động vật: sản phẩm tiêu hóa protein","grade":11,"given":"Một nhóm chất dinh dưỡng trải qua tiêu hóa tại cơ quan hấp thu chủ yếu.","task":"Xác định sản phẩm phân giải cuối cùng phù hợp.","reasoning":"Nhận diện đại phân tử được tiêu hóa; nhớ loại đơn phân tạo thành khi thủy phân hoàn toàn.","steps":2,"combines":["Tiêu hóa hóa học","Cấu tạo phân tử sinh học"],"wrong_options":"Các nhiễu lấy sản phẩm tiêu hóa của những nhóm chất dinh dưỡng khác.","wrong_option_details":[{"label":"A","identifiable_error":true,"mistake_kind":"Nhầm sản phẩm tiêu hóa giữa các nhóm chất","reason":"Gán một sản phẩm phân giải lipid cho protein."},{"label":"B","identifiable_error":true,"mistake_kind":"Nhầm sản phẩm tiêu hóa giữa các nhóm chất","reason":"Gán sản phẩm tiêu hóa carbohydrate cho protein."},{"label":"D","identifiable_error":true,"mistake_kind":"Nhầm sản phẩm tiêu hóa giữa các nhóm chất","reason":"Gán thành phần thu được từ lipid cho protein."}],"cue_use":"none","difficulty_source":"Nhớ trực tiếp quan hệ giữa đại phân tử và đơn phân","discrimination":"low","evidence_uncertainty":null,"optional_path":null},{"part":"P1","idx":6,"sub":null,"topic":"Môi trường và các nhân tố sinh thái: ánh sáng và bố trí cây trồng","grade":12,"given":"Yêu cầu bố trí nhiều loài cây cùng sử dụng một không gian canh tác.","task":"Chọn nhân tố sinh thái cần ưu tiên khi bố trí.","reasoning":"Liên hệ sự cùng tồn tại của cây với cạnh tranh tài nguyên; xác định nhân tố có thể được khai thác theo tầng tán.","steps":2,"combines":["Nhân tố ánh sáng","Cạnh tranh tài nguyên","Ứng dụng trong trồng trọt"],"wrong_options":"Các nhiễu đều là nhân tố có ảnh hưởng tới cây nhưng không thể hiện trực tiếp cơ sở bố trí tầng tán.","wrong_option_details":[{"label":"A","identifiable_error":true,"mistake_kind":"Chọn nhân tố liên quan nhưng thiếu ưu tiên","reason":"Dựa vào nhu cầu nước của cây mà bỏ qua cơ chế sử dụng không gian theo tầng."},{"label":"B","identifiable_error":true,"mistake_kind":"Nhầm điều kiện sinh trưởng với cơ sở bố trí","reason":"Chọn điều kiện khí hậu chung thay cho tài nguyên bị các tầng tán che chắn."},{"label":"C","identifiable_error":true,"mistake_kind":"Đồng nhất mọi yếu tố quang hợp","reason":"Chọn nguyên liệu quang hợp mà không xét sự phân bố tài nguyên theo chiều cao tán."}],"cue_use":"none","difficulty_source":"Nhận ra cơ sở sinh thái quen thuộc của cách bố trí cây","discrimination":"low","evidence_uncertainty":"Câu hỏi dùng tiêu chí ưu tiên chung, không cung cấp điều kiện canh tác để so sánh định lượng các nhân tố.","optional_path":null},{"part":"P1","idx":7,"sub":null,"topic":"Liên kết gene và hoán vị gene: tần số giao tử liên kết","grade":12,"given":"Pha liên kết của cơ thể dị hợp và tần số một loại giao tử.","task":"Suy ra tần số hoán vị gene.","reasoning":"Phân loại giao tử đã cho là liên kết hay tái tổ hợp; suy ra tổng tần số nhóm giao tử tương ứng; tính phần còn lại thuộc nhóm hoán vị.","steps":3,"combines":["Pha liên kết","Tần số giao tử","Hoán vị gene"],"wrong_options":"Nhiễu khai thác việc đồng nhất tần số một giao tử với tần số hoán vị hoặc dùng sai phép bù.","wrong_option_details":[{"label":"A","identifiable_error":true,"mistake_kind":"Đồng nhất giao tử đơn lẻ với tần số hoán vị","reason":"Lấy ngay tần số giao tử đã cho mà không xác định nhóm giao tử."},{"label":"B","identifiable_error":true,"mistake_kind":"Nhầm độ thiếu hụt với tần số hoán vị","reason":"Lấy độ lệch so với mức phân bố đều thay cho tổng phần giao tử tái tổ hợp."},{"label":"C","identifiable_error":true,"mistake_kind":"Bỏ hệ số ghép cặp giao tử","reason":"Tính phần thiếu của một giao tử liên kết nhưng không quy đổi cho cả nhóm đối ứng."}],"cue_use":"needed in reasoning","difficulty_source":"Phải nhận đúng giao tử bố mẹ từ pha liên kết","discrimination":"medium","evidence_uncertainty":null,"optional_path":null},{"part":"P1","idx":8,"sub":null,"topic":"Đột biến nhiễm sắc thể: đảo đoạn","grade":12,"given":"Trật tự các locus trên nhiễm sắc thể, vị trí tâm động và đoạn bị biến đổi.","task":"Chọn trật tự locus sau đảo đoạn.","reasoning":"Khoanh đúng đoạn chịu tác động; đảo chiều trật tự bên trong đoạn; giữ nguyên các vùng ngoài đoạn rồi đối chiếu.","steps":3,"combines":["Trật tự gene trên nhiễm sắc thể","Đột biến cấu trúc nhiễm sắc thể"],"wrong_options":"Nhiễu biến đảo đoạn thành mất đoạn, chuyển vị đoạn hoặc đảo sai ranh giới.","wrong_option_details":[{"label":"B","identifiable_error":true,"mistake_kind":"Nhầm đảo đoạn với mất đoạn","reason":"Loại bỏ vật chất di truyền tại vùng chịu tác động."},{"label":"C","identifiable_error":true,"mistake_kind":"Nhầm đảo đoạn với chuyển đoạn","reason":"Di chuyển đoạn sang vị trí khác thay vì đổi hướng tại vị trí cũ."},{"label":"D","identifiable_error":true,"mistake_kind":"Xác định sai ranh giới đảo đoạn","reason":"Đảo cả phần nằm ngoài đoạn được chỉ định."}],"cue_use":"needed in reasoning","difficulty_source":"Thao tác đảo trật tự với ranh giới đã cho rõ","discrimination":"low","evidence_uncertainty":