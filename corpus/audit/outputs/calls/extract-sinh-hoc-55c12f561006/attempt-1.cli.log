{"rows":[{"part":"P1","idx":1,"sub":null,"topic":"Học thuyết di truyền Mendel: suy ngược phép lai từ phân li kiểu hình","grade":12,"given":"Quy ước trội hoàn toàn và cơ cấu kiểu hình đời con của phép lai xét các locus.","task":"Chọn tổ hợp kiểu gene bố mẹ phù hợp.","reasoning":"Gộp các nhóm kiểu hình để tìm phân li riêng từng tính trạng; suy ra kiểu gene bố mẹ tại từng locus; ghép các kết quả và đối chiếu phương án.","steps":3,"combines":["Phân li allele","Phân li độc lập","Suy luận ngược từ kiểu hình"],"wrong_options":"Các phương án thay đổi trạng thái dị hợp hoặc đồng hợp của bố mẹ, làm sai phân li ở một locus hoặc đảo phân li giữa các locus.","wrong_option_details":[{"label":"B","identifiable_error":true,"mistake_kind":"Áp dụng máy móc phép lai dị hợp","reason":"Chọn dạng phép lai quen thuộc mà không kiểm tra phân li riêng của từng tính trạng."},{"label":"C","identifiable_error":true,"mistake_kind":"Nhầm phân li tại một locus","reason":"Gán bố mẹ đồng hợp lặn cho locus vẫn cần phép lai giữa các cá thể dị hợp."},{"label":"D","identifiable_error":true,"mistake_kind":"Đảo vai trò các locus","reason":"Ghép đúng các dạng phân li nhưng gán chúng cho sai tính trạng."}],"cue_use":"needed in reasoning","difficulty_source":"Phải phân rã phân li chung trước khi suy ngược bố mẹ","discrimination":"medium","evidence_uncertainty":null,"optional_path":null},{"part":"P1","idx":2,"sub":null,"topic":"Di truyền học quần thể: biến đổi cấu trúc di truyền khi tự thụ phấn","grade":12,"given":"Quần thể ban đầu đồng nhất về kiểu gene dị hợp và số thế hệ tự phối.","task":"Tính tần số một kiểu gene đồng hợp ở thế hệ được yêu cầu.","reasoning":"Tính phần dị hợp còn lại qua tự phối; lấy phần giảm dị hợp phân bổ đều cho các kiểu gene đồng hợp.","steps":2,"combines":["Tự thụ phấn","Tần số kiểu gene"],"wrong_options":"Nhiễu đánh tráo tần số dị hợp với đồng hợp hoặc dùng giá trị giới hạn thay cho kết quả sau số thế hệ hữu hạn.","wrong_option_details":[{"label":"A","identifiable_error":true,"mistake_kind":"Dùng giới hạn thay cho trạng thái hữu hạn","reason":"Cho rằng phần đồng hợp đã đạt mức cân bằng giữa các allele ngay sau quá trình tự phối hữu hạn."},{"label":"B","identifiable_error":true,"mistake_kind":"Trả lời nhầm đại lượng","reason":"Tính phần dị hợp còn lại nhưng dùng làm tần số kiểu gene đồng hợp."},{"label":"D","identifiable_error":true,"mistake_kind":"Chia sai phần cần phân bổ","reason":"Chia phần dị hợp còn lại cho các kiểu gene đồng hợp thay vì chia phần dị hợp đã mất."}],"cue_use":"needed in reasoning","difficulty_source":"Áp dụng trực tiếp quy luật giảm dị hợp qua tự phối","discrimination":"low","evidence_uncertainty":null,"optional_path":null},{"part":"P1","idx":3,"sub":null,"topic":"Sinh thái học quần thể: các nhân tố làm biến động kích thước","grade":12,"given":"Các cặp quá trình làm thay đổi số lượng cá thể.","task":"Chọn cặp quá trình cùng làm tăng kích thước quần thể.","reasoning":"Xác định chiều tác động của từng quá trình; chọn cặp đều bổ sung cá thể.","steps":2,"combines":["Sinh sản và tử vong","Nhập cư và xuất cư"],"wrong_options":"Mỗi nhiễu ghép một quá trình bổ sung cá thể với một quá trình làm mất cá thể.","wrong_option_details":[{"label":"A","identifiable_error":true,"mistake_kind":"Không phân biệt chiều di chuyển","reason":"Coi mọi sự di chuyển cá thể đều có tác dụng tăng kích thước."},{"label":"B","identifiable_error":true,"mistake_kind":"Nhầm chiều tác động của xuất cư","reason":"Nhận đúng tác dụng của sinh sản nhưng coi cá thể rời đi là nguồn bổ sung."},{"label":"D","identifiable_error":true,"mistake_kind":"Nhầm biến động với tăng trưởng","reason":"Chọn các quá trình làm thay đổi số lượng mà không kiểm tra chúng làm tăng hay giảm."}],"cue_use":"none","difficulty_source":"Nhận biết trực tiếp dấu tác động của các quá trình","discrimination":"low","evidence_uncertainty":null,"optional_path":null},{"part":"P1","idx":4,"sub":null,"topic":"Cấu trúc và chức năng của nhiễm sắc thể: các mức đóng xoắn","grade":12,"given":"Kích thước đặ