r": null}, "questions": [{"id": "969218af6fe5a4ae", "qtype": "mcq", "stem": "Sau khi một người khỏe mạnh uống nhiều nước, áp suất thẩm thấu của máu giảm. Trong cơ chế điều hòa nước, sự giảm này làm giảm tiết hormone ADH; ADH có tác dụng tăng tính thấm đối với nước của ống góp ở thận. So với trước khi uống nước, đáp ứng nào sau đây phù hợp với cơ chế trên? Giả sử các yếu tố khác không đổi.", "options": [{"label": "A", "text": "Ống góp tái hấp thụ nước ít hơn, nước tiểu loãng hơn."}, {"label": "B", "text": "Ống góp tái hấp thụ nước nhiều hơn, nước tiểu đậm đặc hơn."}, {"label": "C", "text": "Ống góp tái hấp thụ nước ít hơn, nước tiểu đậm đặc hơn."}, {"label": "D", "text": "Ống góp tái hấp thụ nước nhiều hơn, nước tiểu loãng hơn."}], "statements": []}, {"id": "641c0f065e3baf8e", "qtype": "mcq", "stem": "Khi quan sát một tế bào ở mô phân sinh đầu rễ hành đang nguyên phân, người ta ghi nhận: màng nhân đã tiêu biến; các nhiễm sắc thể kép xếp thành một hàng ở mặt phẳng giữa tế bào; hai chromatid chị em của mỗi nhiễm sắc thể vẫn gắn với nhau tại tâm động. Tế bào đang ở kì nào?", "options": [{"label": "A", "text": "Kì đầu."}, {"label": "B", "text": "Kì giữa."}, {"label": "C", "text": "Kì sau."}, {"label": "D", "text": "Kì cuối."}], "statements": []}, {"id": "bb1a619fb6ee1287", "qtype": "short_answer", "stem": "Một tế bào lưỡng bội có lượng DNA trong nhân ở pha G1 là 4 pg. Tế bào trải qua một chu kì bình thường, DNA nhân đôi hoàn tất và nguyên phân không có sai sót. Ba bản ghi dưới đây mô tả lượng DNA trong một nhân theo thứ tự: pha G1 → cuối pha S → pha G2 → nhân của mỗi tế bào con ngay sau khi phân chia.\nBản ghi 1: 4 → 4 → 8 → 4 (pg).\nBản ghi 2: 4 → 8 → 4 → 4 (pg).\nBản ghi 3: 4 → 8 → 8 → 4 (pg).\nHãy ghi số của bản ghi phù hợp.", "options": [], "statements": []}, {"id": "f478d7325efffcb1", "qtype": "mcq", "stem": "Ở tế bào nhân thực, chu trình Krebs của quá trình hô hấp tế bào diễn ra trong bào quan nào?", "options": [{"label": "A", "text": "Lục lạp."}, {"label": "B", "text": "Peroxisome."}, {"label": "C", "text": "Lysosome."}, {"label": "D", "text": "Ti thể."}], "statements": []}]}
