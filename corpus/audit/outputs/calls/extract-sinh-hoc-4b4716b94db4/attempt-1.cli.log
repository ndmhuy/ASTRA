uy lỗi số học cho một thao tác cụ thể hơn.","optional_path":null},{"part":"P2","idx":4,"sub":"b","topic":"Các phân tử sinh học: phân biệt polysaccharide và nucleic acid","grade":10,"given":"Một phân tử được nhận diện qua loại đường đơn cấu tạo nên nó.","task":"Đánh giá khả năng phân tử đảm nhiệm chức năng di truyền trong nhân.","reasoning":"Suy ra nhóm phân tử từ đơn phân; đối chiếu với nhóm chất lưu giữ thông tin di truyền của tế bào.","steps":2,"combines":["Đơn phân và đại phân tử","Chức năng vật chất di truyền"],"wrong_options":"Phát biểu sai gán chức năng của nucleic acid cho polymer đường.","wrong_option_details":[{"label":"b","identifiable_error":true,"mistake_kind":"Đồng nhất mọi đại phân tử với vật chất di truyền","reason":"Không dùng bản chất đơn phân để phân biệt chất dự trữ hoặc cấu trúc với phân tử mang thông tin."}],"cue_use":"given as a cue","difficulty_source":"Loại đơn phân xác định ngay nhóm chất","discrimination":"low","evidence_uncertainty":null,"optional_path":null},{"part":"P2","idx":4,"sub":"c","topic":"Cấu trúc tế bào nhân thực: vị trí của DNA trong tế bào","grade":10,"given":"Thành phần base của một phân tử và điều kiện bổ sung về sự bằng nhau giữa các loại base.","task":"Đánh giá các vị trí tế bào có thể chứa phân tử đó.","reasoning":"Nhận diện DNA từ thành phần base; kiểm tra dấu hiệu phù hợp với cấu trúc bổ sung; nhớ các cấu trúc tế bào có hệ gene riêng.","steps":3,"combines":["Thành phần DNA","Nguyên tắc bổ sung","Cấu trúc tế bào nhân thực"],"wrong_options":null,"wrong_option_details":[],"cue_use":"needed in reasoning","difficulty_source":"Nối dữ liệu thành phần phân tử với vị trí trong tế bào","discrimination":"medium","evidence_uncertainty":null,"optional_path":null},{"part":"P2","idx":4,"sub":"d","topic":"Gene và quá trình truyền đạt thông tin di truyền: chiều tổng hợp nucleic acid","grade":12,"given":"Các phân tử nucleic acid được nhận diện từ bảng thành phần của một tế bào thực vật.","task":"Đánh giá khả năng tạo phân tử này dựa trên