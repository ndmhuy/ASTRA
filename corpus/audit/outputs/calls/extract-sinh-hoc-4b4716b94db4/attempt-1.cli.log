{"rows":[{"part":"P1","idx":1,"sub":null,"topic":"Học thuyết tiến hóa tổng hợp hiện đại: phiêu bạt di truyền","grade":12,"given":"Một yêu cầu về sự mất allele có tác dụng thích nghi trong quần thể.","task":"Chọn nhân tố tiến hóa phù hợp với đặc điểm biến đổi được nêu.","reasoning":"Xác định biến đổi không phụ thuộc giá trị thích nghi; nhận diện cơ chế ngẫu nhiên có thể làm mất allele.","steps":2,"combines":["Các nhân tố tiến hóa","Giá trị thích nghi của allele"],"wrong_options":"Các phương án nhiễu đánh đồng cơ chế tạo biến dị, sàng lọc thích nghi hoặc trao đổi allele với sự mất allele ngẫu nhiên.","wrong_option_details":[{"label":"A","identifiable_error":true,"mistake_kind":"Nhầm phát sinh biến dị với biến đổi tần số allele","reason":"Cho rằng biến đổi allele ở cấp phân tử đủ giải thích sự mất nhanh allele trên toàn quần thể."},{"label":"B","identifiable_error":true,"mistake_kind":"Đảo chiều tác động của chọn lọc","reason":"Bỏ qua việc allele được mô tả có tác dụng thích nghi."},{"label":"C","identifiable_error":true,"mistake_kind":"Nhầm trao đổi gene với phiêu bạt","reason":"Gán cho sự di chuyển allele cơ chế loại bỏ ngẫu nhiên mà không xét điều kiện di cư."}],"cue_use":"none","difficulty_source":"Dấu hiệu về tính ngẫu nhiên đối lập trực tiếp với giá trị thích nghi","discrimination":"low","evidence_uncertainty":null,"optional_path":null},{"part":"P1","idx":2,"sub":null,"topic":"Di truyền gene ngoài nhân: di truyền qua ti thể","grade":12,"given":"Vị trí của gene trong bào quan và các tổ hợp kiểu hình bố mẹ.","task":"Chọn nhóm tổ hợp bố mẹ có khả năng truyền tính trạng cho con.","reasoning":"Nhận diện quy luật truyền bào quan theo mẹ; xét nguồn bào quan ở từng tổ hợp; chọn tập trường hợp phù hợp.","steps":3,"combines":["Di truyền ngoài nhân","Truyền tính trạng qua các thế hệ"],"wrong_options":"Các tập lựa chọn đều đưa thêm trường hợp truyền qua bố hoặc loại nhầm trường hợp truyền qua mẹ.","wrong_option_details":[{"label":"A","identifiable_error":true,"mistake_kind":"Áp dụng di truyền từ cả bố và mẹ","reason":"Cho rằng bố hoặc mẹ biểu hiện tính trạng đều có thể truyền gene bào quan cho con."},{"label":"B","identifiable_error":true,"mistake_kind":"Không xác định đúng nguồn bào quan","reason":"Chấp nhận truyền qua bố nhưng bỏ sót một tổ hợp có mẹ biểu hiện tính trạng."},{"label":"C","identifiable_error":true,"mistake_kind":"Nhầm di truyền theo bố","reason":"Lấy kiểu hình của bố làm tiêu chí quyết định khả năng truyền tính trạng."}],"cue_use":"given as a cue","difficulty_source":"Vị trí gene gợi ngay quy luật di truyền cần dùng","discrimination":"low","evidence_uncertainty":null,"optional_path":null},{"part":"P1","idx":3,"sub":null,"topic":"Đột biến gene: tác động lên phiên mã và dịch mã","grade":12,"given":"Một đoạn mạch khuôn có chiều đọc, bảng đối chiếu bộ ba với sản phẩm và các nhận định về biến đổi trình tự.","task":"Xác định số nhận định đúng về sản phẩm ban đầu và sản phẩm sau đột biến.","reasoning":"Lập trình tự phiên mã theo chiều bổ sung; chuyển các bộ ba thành chuỗi sản phẩm; kiểm tra tác động của thay thế lên bộ ba và điểm dừng; lập lại khung đọc sau thêm nucleotide; tổng hợp các kết luận.","steps":5,"combines":["Nguyên tắc bổ sung","Phiên mã và dịch mã","Đột biến thay thế","Đột biến dịch khung"],"wrong_options":"Các đáp án đếm phản ánh việc chấp nhận nhầm bộ ba kết thúc hoặc bỏ sót tác động của thay thế và dịch khung.","wrong_option_details":[{"label":"A","identifiable_error":true,"mistake_kind":"Bỏ sót nhận định đúng sau đột biến","reason":"Có thể chỉ kiểm tra được sản phẩm ban đầu rồi bác bỏ các kết quả biến đổi mà chưa lập lại trình tự; không xác định duy nhất được lỗi từ đáp án đếm."},{"label":"B","identifiable_error":true,"mistake_kind":"Tính bộ ba kết thúc như bộ ba mã hóa","reason":"Chấp nhận cả nhận định sai về độ dài sản phẩm vì không dừng dịch mã trước bộ ba kết thúc."},{"label":"D","identifiable_error":true,"mistake_kind":"Kiểm tra thiếu tác động của đột biến","reason":"Bỏ sót một kết luận đúng khi thay thế hoặc thêm nucleotide; đáp án đếm không chỉ rõ duy nhất bước sai."}],"cue_use":"needed in reasoning","difficulty_source":"Phải giữ đúng chiều bổ sung và khung đọc qua nhiều kiểu đột biến","discrimination":"high","evidence_uncertainty":null,"optional_path":null},{"part":"P1","idx":4,"sub":null,"topic":"Môi trường và các nhân tố sinh thái: giới hạn sinh thái","grade":12,"given":"Khoảng biến thiên của một nhân tố môi trường và đồ thị giới hạn chịu đựng của các loài dự kiến nuôi.","task":"Chọn loài có thể tồn tại trong toàn bộ khoảng điều kiện được xét.","reasoning":"Đọc các khoảng chịu đựng trên đồ thị; đối chiếu toàn bộ khoảng môi trường với từng khoảng chịu đựng; giữ lại loài thỏa điều kiện bao chứa.","steps":3,"combines":["Giới hạn sinh thái","Đọc đồ thị","Lựa chọn đối tượng nuôi"],"wrong_options":"Nhiễu dựa vào việc chỉ xét một phần khoảng nhiệt hoặc ghép các loài chịu những miền nhiệt khác nhau.","wrong_option_details":[{"label":"A","identifiable_error":true,"mistake_kind":"Ghép khoảng chịu đựng của các loài","reason":"Cho rằng các loài có giới hạn ở hai phía có thể cùng đáp ứng điều kiện nuôi dù từng loài không chịu được toàn khoảng."},{"label":"B","identifiable_error":true,"mistake_kind":"Chấp nhận giao nhau một phần","reason":"Đưa thêm loài có miền chịu đựng lệch khỏi khoảng môi trường cần đáp ứng."},{"label":"D","identifiable_error":true,"mistake_kind":"Không kiểm tra cận chịu đựng","reason":"Chọn loài thích nghi với miền nhiệt không bao phủ điều kiện tại nơi nuôi."}],"cue_use":"needed in reasoning","difficulty_source":"Phải xét toàn khoảng môi trường thay vì một điểm thuận lợi","discrimination":"medium","evidence_uncertainty":null,"optional_path":null},{"part":"P1","idx":5,"sub":null,"topic":"Học thuyết di truyền Mendel: kiểu gene đồng hợp và dị hợp","grade":12,"given":"Các cách viết kiểu gene tại nhiều locus.","task":"Nhận diện kiểu gene đồng hợp tại mọi locus.","reasoning":"Tách các cặp allele theo locus; kiểm tra sự giống nhau của allele trong mọi cặp.","s