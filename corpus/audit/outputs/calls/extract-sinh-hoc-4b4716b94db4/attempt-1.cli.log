"Áp dụng di truyền từ cả bố và mẹ","reason":"Cho rằng bố hoặc mẹ biểu hiện tính trạng đều có thể truyền gene bào quan cho con."},{"label":"B","identifiable_error":true,"mistake_kind":"Không xác định đúng nguồn bào quan","reason":"Chấp nhận truyền qua bố nhưng bỏ sót một tổ hợp có mẹ biểu hiện tính trạng."},{"label":"C","identifiable_error":true,"mistake_kind":"Nhầm di truyền theo bố","reason":"Lấy kiểu hình của bố làm tiêu chí quyết định khả năng truyền tính trạng."}],"cue_use":"given as a cue","difficulty_source":"Vị trí gene gợi ngay quy luật di truyền cần dùng","discrimination":"low","evidence_uncertainty":null,"optional_path":null},{"part":"P1","idx":3,"sub":null,"topic":"Đột biến gene: tác động lên phiên mã và dịch mã","grade":12,"given":"Một đoạn mạch khuôn có chiều đọc, bảng đối chiếu bộ ba với sản phẩm và các nhận định về biến đổi trình tự.","task":"Xác định số nhận định đúng về sản phẩm ban đầu và sản phẩm sau đột biến.","reasoning":"Lập trình tự phiên mã theo chiều bổ sung; chuyển các bộ ba thành chuỗi sản phẩm; kiểm tra tác động của thay thế lên bộ ba và điểm dừng; lập lại khung đọc sau thêm nucleotide; tổng hợp các kết luận.","steps":5,"combines":["Nguyên tắc bổ sung","Phiên mã và dịch mã","Đột biến thay thế","Đột biến dịch khung"],"wrong_options":"Các đáp án đếm phản ánh việc chấp nhận nhầm bộ ba kết thúc hoặc bỏ sót tác động của thay thế và dịch khung.","wrong_option_details":[{"label":"A","identifiable_error":true,"mistake_kind":"Bỏ sót nhận định đúng sau đột biến","reason":"Có thể chỉ kiểm tra được sản phẩm ban đầu rồi bác bỏ các kết quả biến đổi mà chưa lập lại trình tự; không xác định duy nhất được lỗi từ đáp án đếm."},{"label":"B","identifiable_error":true,"mistake_kind":"Tính bộ ba kết thúc như bộ ba mã hóa","reason":"Chấp nhận cả nhận định sai về độ dài sản phẩm vì không dừng dịch mã trước bộ ba kết thúc."},{"label":"D","identifiable_error":true,"mistake_kind":"Kiểm tra thiếu tác động của đột biến","reason":"Bỏ sót một kết luận đúng khi thay thế hoặc thêm nucleotide; đáp án đếm không chỉ rõ duy nhất bước sai."}],"cue_use":"needed in reasoning","difficulty_source":"Phải giữ đúng chiều bổ sung và khung đọc qua nhiều kiểu đột biến","discrimination":"high","evidence_uncertainty":null,"optional_path":null},{"part":"P1","idx":4,"sub":null,"topic":"Môi trường và các nhân tố sinh thái: giới hạn sinh thái","grade":12,"given":"Khoảng biến thiên của một nhân tố môi trường và đồ thị giới hạn chịu đựng của các loài dự kiến nuôi.","task":"Chọn loài có thể tồn tại trong toàn bộ khoảng điều kiện được xét.","reasoning":"Đọc các khoảng chịu đựng trên đồ thị; đối chiếu toàn bộ khoảng môi trường với từng khoảng chịu đựng; giữ lại loài thỏa điều kiện bao chứa.","steps":3,"combines":["Giới hạn sinh thái","Đọc đồ thị","Lựa chọn đối tượng nuôi"],"wrong_options":"Nhiễu dựa vào việc chỉ xét một phần khoảng nhiệt hoặc ghép các loài chịu những miền nhiệt khác nhau.","wrong_option_details":[{"label":"A","identifiable_error":true,"mistake_kind":"Ghép khoảng chịu đựng của các loài","reason":"Cho rằng các loài có giới hạn ở hai phía có thể cùng đáp ứng điều kiện nuôi dù từng loài không chịu được toàn khoảng."},{"label":"B","identifiable_error":true,"mistake_kind":"Chấp nhận giao nhau một phần","reason":"Đưa thêm loài có miền chịu đựng lệch khỏi khoảng môi trường cần đáp ứng."},{"label":"D","identifiable_error":true,"mistake_kind":"Không kiểm tra cận chịu đựng","reason":"Chọn loài thích nghi với miền nhiệt không bao phủ điều kiện tại nơi nuôi."}],"cue_use":"needed in reasoning","difficulty_source":"Phải xét toàn khoảng môi trường thay vì một điểm thuận lợi","discrimination":"medium","evidence_uncertainty":null,"optional_path":null},{"part":"P1","idx":5,"sub":null,"topic":"Học thuyết di truyền Mendel: kiểu gene đồng hợp và dị hợp","grade":12,"given":"Các cách viết kiểu gene tại nhiều locus.","task":"Nhận diện kiểu gene đồng hợp tại mọi locus.","reasoning":"Tách các cặp allele theo locus; kiểm tra sự giống nhau của allele trong mọi cặp.","steps":2,"combines":["Kí hiệu kiểu gene","Khái niệm đồng hợp"],"wrong_options":"Mỗi phương án nhiễu giữ lại ít nhất một locus dị hợp giữa các locus đồng hợp.","wrong_option_details":[{"label":"A","identifiable_error":true,"mistake_kind":"Kiểm tra thiếu locus","reason":"Bỏ qua các cặp allele khác nhau khi thấy một locus đồng hợp."},{"label":"B","identifiable_error":true,"mistake_kind":"Đánh giá theo đa số locus","reason":"Xem nhiều locus đồng hợp là đủ mà không kiểm tra điều kiện áp dụng cho toàn bộ kiểu gene."},{"label":"D","identifiable_error":true,"mistake_kind":"Bỏ sót dị hợp ở cuối kí hiệu","reason":"Không phát hiện một locus dị hợp trong phần còn lại của kiểu gene."}],"cue_use":"none","difficulty_source":"Đối chiếu trực tiếp kí hiệu với định nghĩa","discrimination":"low","evidence_uncertainty":null,"optional_path":null},{"part":"P1","idx":6,"sub":null,"topic":"Giảm phân: sự phân li của nhiễm sắc thể tương đồng","grade":10,"given":"Một sự kiện phân li nhiễm sắc thể trong giảm phân.","task":"Xác định giai đoạn diễn ra sự kiện.","reasoning":"Phân biệt phân li nhiễm sắc thể tương đồng với phân li chromatid; ghép sự kiện với kì phân bào tương ứng.","steps":2,"combines":["Giảm phân","Nhiễm sắc thể tương đồng"],"wrong_options":"Nhiễu đổi lần phân bào hoặc đổi thời điểm đang phân li thành thời điểm đã hoàn tất.","wrong_option_details":[{"label":"A","identifiable_error":true,"mistake_kind":"Nhầm đối tượng phân li","reason":"Đồng nhất phân li chromatid chị em với phân li các nhiễm sắc thể tương đồng."},{"label":"C","identifiable_error":true,"mistake_kind":"Nhầm lần phân bào và thời điểm","reason":"Chọn giai đoạn kết thúc của lần phân bào không thực hiện sự kiện được hỏi."},{"label":"D","identifiable_error":true,"mistake_kind":"Nhầm diễn biến với kết quả","reason":"Chọn thời điểm các nhiễm sắc thể đã tới cực thay vì lúc chúng đang phân li."}],"cue_use":"none","difficulty_source":"Nhớ đúng sự kiện đặc trưng của từng lần giảm phân","discrimination":"low","evidence_uncertainty":null,"optional_path":null},{"part":"P1","idx":7,"sub":null,"topic":"Quần xã sinh vật: phân bố trong không gian và phân hóa ổ sinh thái","grade":12,"given":"Mô tả các nhóm sinh vật sử dụng những tầng không gian khác nhau trong một quần xã.","task":"Chọn ý nghĩa sinh thái phù hợp của sự phân tầng.","reasoning":"Nhận diện phân bố theo chiều thẳng đứng; liên hệ việc chia sẻ không gian và tài nguyên với giảm chồng lấn nhu cầu.","steps":2,"combines":["Cấu trúc không gian quần xã","Cạnh tranh khác loài","Ổ sinh thái"],"wrong_options":"Nhiễu đảo chiều phân bố, đảo tính không đồng nhất của môi trường hoặc nhầm phân hóa với mở rộng ổ sinh thái.","wrong_option_details":[{"label":"B","identifiable_error":true,"mistake_kind":"Nhầm chiều phân bố","reason":"Gọi sự phân tầng là phân bố theo chiều không phù hợp với mô tả."},{"label":"C","identifiable_error":true,"mistake_kind":"Đảo quan hệ giữa môi trường và phân bố","reason":"Cho rằng các tầng hình thành do điều kiện đồng nhất thay vì khác biệt theo vị trí."},{"label":"D","identifiable_error":true,"mistake_kind":"Nhầm phân hóa với mở rộng ổ sinh thái","reason":"Đồng nhất giảm chồng lấn sử dụng nguồn sống với tăng phạm vi sử dụng nguồn sống của từng loài."}],"cue_use":"given as a cue","difficulty_source":"Nhận ra hệ quả quen thuộc của sự phân tầng","discrimination":"low","evidence_uncertainty":null,"optional_path":null},{"part":"P1","idx":8,"sub":null,"topic":"Các bằng chứng tiến hóa: so sánh hệ gene và quan hệ họ hàng","grade":12,"given":"Bảng mức tương đồng hệ gene giữa một loài mốc và các loài đối chiếu.","task":"Chọn kết luận không được dữ liệu so sánh hỗ trợ.","reasoning":"Xác định mọi giá trị đều so với cùng loài mốc; đọc thứ tự tương đồng; phân biệt quan hệ với loài mốc và quan hệ trực tiếp giữa các loài đối chiếu; chọn suy luận vượt dữ liệu.","steps":4,"combines":["Bằng chứng phân tử","Đọc bảng","Giới hạn của suy luận so sánh"],"wrong_options":"Trong câu tìm nhận định sai, các phương án nhiễu là những kết luận phù hợp về 