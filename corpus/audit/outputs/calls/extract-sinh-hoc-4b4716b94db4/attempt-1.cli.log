inh dưỡng khác nhau.","task":"Sắp xếp các hệ sinh thái theo mức ổn định được suy từ hình dạng tháp.","reasoning":"Đọc tương quan sinh khối giữa các bậc; so sánh mức hỗ trợ của bậc dưới đối với bậc trên; áp dụng quy ước suy ổn định từ dạng tháp; sắp thứ tự.","steps":4,"combines":["Tháp sinh khối","Bậc dinh dưỡng","Ổn định hệ sinh thái"],"wrong_options":null,"wrong_option_details":[],"cue_use":"needed in reasoning","difficulty_source":"So sánh tương quan giữa các bậc thay vì chỉ kích thước toàn tháp","discrimination":null,"evidence_uncertainty":"Khóa cung cấp thứ tự nhưng sinh khối tức thời và hình dạng tháp không đủ xác định ổn định thực tế nếu thiếu tốc độ tái tạo, dòng năng lượng và biến động thời gian; mức phân hóa phụ thuộc quy ước giải bài chưa được nêu.","optional_path":null},{"part":"P3","idx":3,"sub":null,"topic":"Quần xã sinh vật: cạnh tranh và tác động của sinh vật ăn thịt","grade":12,"given":"Các đồ thị biến thiên độ che phủ của các loài cùng sử dụng nguồn sống, ở điều kiện có và loại trừ sinh vật ăn thịt, kèm thông tin mùa vụ.","task":"Chọn các nhận định được bằng chứng về biến động và quan hệ sinh thái hỗ trợ.","reasoning":"Ghép đúng chú giải loài và điều kiện thí nghiệm; đọc cực trị trong từng điều kiện; so sánh phản ứng giữa các nghiệm thức; phân biệt ảnh hưởng của ăn thịt với thay đổi cạnh tranh; kiểm tra các suy luận về thích nghi mùa vụ.","steps":5,"combines":["Đọc đồ thị","Thí nghiệm loại trừ","Cạnh tranh khác loài","Quan hệ ăn thịt","Giới hạn suy luận nhân quả"],"wrong_options":"Các nhận định sai suy thích nghi nhiệt từ độ che phủ hoặc đảo đối tượng chịu tác động mạnh của sinh vật ăn thịt.","wrong_option_details":[{"label":"2","identifiable_error":true,"mistake_kind":"Quy biến động quan sát cho một nguyên nhân duy nhất","reason":"Dùng độ che phủ ở giai đoạn mùa vụ để kết luận ưu thế chịu nhiệt, bỏ qua cạnh tranh và ăn thịt."},{"label":"3","identifiable_error":true,"mistake_kind":"Đảo đối tượng chịu tác động của ăn thịt","reason":"Không đối chiếu cùng một loài giữa các nghiệm thức, dẫn đến gán tác động trực tiếp cho loài được hưởng lợi gián tiếp khi đối thủ giảm."}],"cue_use":"needed in reasoning","difficulty_source":"Tách tác động trực tiếp của ăn thịt khỏi tác động gián tiếp qua cạnh tranh","discrimination":"high","evidence_uncertainty":"Chú giải loài đổi kiểu nét và kí hiệu giữa các đồ thị nên phải đọc riêng từng hình. Dữ liệu hỗ trợ suy luận theo mô hình đề bài, chưa cô lập hoàn toàn mọi tác động trực tiếp và gián tiếp.","optional_path":null},{"part":"P3","idx":4,"sub":null,"topic":"Di truyền học quần thể: cân bằng di truyền của gene nhiều allele","grade":12,"given":"Một quần thể ngẫu phối cân bằng với tần số một allele đã biết và các allele còn lại có tần số bằng nhau.","task":"Tính tổng tần số các kiểu gene đồng hợp.","reasoning":"Tính phần tần số còn lại; chia đều cho các allele chưa biết; bình phương tần số từng allele để tính đồng hợp; cộng và đổi sang đơn vị trả lời.","steps":4,"combines":["Tần số allele","Cân bằng Hardy–Weinberg","Tổng tần số đồng hợp"],"wrong_options":null,"wrong_option_details":[],"cue_use":"needed in reasoning","difficulty_source":"Áp dụng công thức tổng bình phương tần số allele","discrimination":"medium","evidence_uncertainty":null,"optional_path":null},{"part":"P3","idx":5,"sub":null,"topic":"DNA và cơ chế tái bản DNA: RNA mồi tại các đơn vị tái bản","grade":12,"given":"Số đơn vị tái bản và số đoạn tổng hợp gián đoạn trong từng đơn vị của DNA nhân thực.","task":"Tính tổng số đoạn mồi cần sử dụng.","reasoning":"Gắn mỗi đoạn tổng hợp gián đoạn với một mồi; xác định phần mồi khởi đầu cho các mạch tổng hợp liên tục tại mỗi đơn vị hai chạc; cộng số mồi trên toàn phân tử.","steps":3,"combines":["Tái bản hai chiều","Mạch liên tục và gián đoạn","Vai trò RNA mồi"],"wrong_options":null,"wrong_option_details":[],"cue_use":"needed in reasoning","difficulty_source":"Nhớ tính thêm mồi cho mạch liên tục ngoài các đoạn gián đoạn","discrimination":"medium","evidence_uncertainty":null,"optional_path":null},{"part":"P3","idx":6,"sub":null,"topic":"Di truyền học người: tính trạng chịu ảnh hưởng của giới tính và xác suất phả hệ","grade":12,"given":"Phả hệ có biểu hiện phụ thuộc giới tính, quy tắc biểu hiện của các kiểu gene và thông tin cân bằng di truyền của quần thể xuất thân người phối ngẫu.","task":"Tính xác suất sinh con thuộc giới và kiểu hình được yêu cầu.","reasoning":"Đổi kiểu hình từng giới thành các khả năng kiểu gene; dùng quan hệ huyết thống để xác định trọng số kiểu gene của người trong phả hệ; suy tần số allele từ tỉ lệ kiểu hình quần thể dưới giả định cơ cấu giới; điều kiện hóa kiểu gene người phối ngẫu theo giới và kiểu hình; kết hợp các khả năng bố mẹ với xác suất giới tính và làm tròn.","steps":5,"combines":["Đọc phả hệ","Tính trạng chịu ảnh hưởng giới tính","Cân bằng Hardy–Weinberg","Xác suất có điều kiện","Xác suất tổ hợp"],"wrong_options":null,"wrong_option_details":[],"cue_use":"needed in reasoning","difficulty_source":"Phải kết hợp bất định kiểu gene từ phả hệ với phân bố có điều kiện của người phối ngẫu","discrimination":"high","evidence_uncertainty":"Kết quả khóa phù hợp khi coi tần số allele giữa các giới như nhau và cơ cấu giới cân bằng; đề không nêu riêng cơ cấu giới khi cho tỉ lệ kiểu hình chung của quần thể.","optional_path":null}]}
