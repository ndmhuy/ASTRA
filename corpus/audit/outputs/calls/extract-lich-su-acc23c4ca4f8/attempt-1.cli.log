 cấu khỏi chính trị quốc tế","reason":"Không nhận ra tiến bộ công nghệ và xu hướng liên kết có thể làm thay đổi nền tảng của trật tự."},{"label":"D","identifiable_error":true,"mistake_kind":"Đồng nhất tăng vũ trang với tăng sức mạnh bền vững","reason":"Bỏ qua tác động tiêu hao nguồn lực của cạnh tranh quân sự kéo dài."}],"cue_use":"needed in reasoning","difficulty_source":"Phải kiểm tra thứ tự thời gian để phân biệt nguyên nhân với hiện tượng xuất hiện muộn","discrimination":"medium","evidence_uncertainty":null,"optional_path":null},{"part":"P1","idx":4,"sub":null,"topic":"Cách mạng tháng Tám: tổ chức chỉ đạo tổng khởi nghĩa","grade":12,"given":"Một mốc thời gian và chủ trương thành lập tổ chức trong quá trình giành chính quyền.","task":"Nhận diện tổ chức được quyết định thành lập tại mốc đã cho.","reasoning":["Nhớ chuỗi quyết định tổ chức trước khi giành chính quyền.","Ghép mốc thời gian với tổ chức tương ứng."],"steps":2,"combines":["Niên biểu cách mạng","Chức năng các tổ chức lãnh đạo"],"wrong_options":"Nhiễu dùng những tổ chức cùng tiến trình cách mạng nhưng ra đời ở thời điểm khác hoặc có chức năng khác.","wrong_option_details":[{"label":"B","identifiable_error":true,"mistake_kind":"Nhầm cơ quan chỉ đạo với bộ máy chính quyền","reason":"Đưa tổ chức chính quyền của bước phát triển sau vào quyết định chuẩn bị khởi nghĩa."},{"label":"C","identifiable_error":true,"mistake_kind":"Nhầm mốc thành lập tổ chức","reason":"Gắn sự ra đời của tổ chức tập hợp lực lượng với thời điểm phát động giành chính quyền."},{"label":"D","identifiable_error":true,"mistake_kind":"Lẫn các quyết định gần nhau","reason":"Không phân biệt cơ quan chỉ đạo khởi nghĩa với tổ chức đại diện được hình thành trong chuỗi sự kiện kế tiếp."}],"cue_use":"given as a cue","difficulty_source":"Nhớ chính xác mốc của các tổ chức có tên và chức năng gần nhau","discrimination":"low","evidence_uncertainty":null,"optional_path":null},{"part":"P1","idx":5,"sub":null,"topic":"Thành tựu và bài học của công cuộc Đổi mới","grade":12,"given":"Một quá trình cải cách và các nhận định khái quát về thành tựu, đường lối và nhân tố phát triển.","task":"Chọn nhận định phù hợp với kết quả của quá trình cải cách.","reasoning":["Nhớ những chuyển biến kinh tế, xã hội và chính trị cơ bản của công cuộc cải cách.","Phân biệt mô tả thành tựu với nhận định về đường lối hoặc nhân tố phát triển.","Kiểm tra các kết luận làm thay đổi mục tiêu chính trị hay tuyệt đối hóa tác động bên ngoài."],"steps":3,"combines":["Thành tựu Đổi mới","Đường lối chính trị","Quan hệ nội lực và ngoại lực"],"wrong_options":"Nhiễu trộn bài học với thành tựu, đồng nhất cải cách với thay đổi chế độ chính trị và nâng một nhân tố bên ngoài thành yếu tố quyết định.","wrong_option_details":[{"label":"A","identifiable_error":null,"mistake_kind":null,"reason":"Khóa không chọn phương án này, nhưng cách diễn đạt về vai trò của nguồn lực bên ngoài chưa tự nó tạo thành một sai lầm rõ ràng; có thể chỉ khác trọng tâm hỏi."},{"label":"B","identifiable_error":true,"mistake_kind":"Đồng nhất đổi mới với thay đổi nền tảng chính trị","reason":"Cho rằng cải cách phương thức phát triển tất yếu kéo theo thay đổi mô hình tổ chức chính trị."},{"label":"D","identifiable_error":true,"mistake_kind":"Tuyệt đối hóa ngoại lực","reason":"Đưa hội nhập từ điều kiện hỗ trợ thành nhân tố quyết định toàn bộ thành công kinh tế."}],"cue_use":"given as a cue","difficulty_source":"Phải chọn đúng loại kết luận, trong khi một nhiễu chưa có ranh giới sai rõ ràng","discrimination":"medium","evidence_uncertainty":"Một phương án không được khóa chọn vẫn có thể được hiểu là nhận định hợp lí; chưa đủ căn cứ gán cho nó một ngộ nhận cụ thể.","optional_path":null},{"part":"P1","idx":6,"sub":null,"topic":"Hồ Chí Minh – Anh hùng giải phóng dân tộc: quyền dân tộc tự quyết trong tổ chức lực lượng cách mạng","grade":12,"given":"Một chuỗi quyết định tổ chức lực lượng cách mạng ở những phạm vi dân tộc khác nhau.","task":"Rút ra nguyên tắc tư tưởng chung thể hiện qua chuỗi quyết định.","reasoning":["Xác định điểm chung về phạm vi tổ chức trong các quyết định.","Liên hệ điểm chung với quyền lựa chọn con đường và tổ chức cách mạng của từng dân tộc.","Phân biệt nguyên tắc này với mục tiêu cách mạng và chủ trương đoàn kết rộng hơn."],"steps":3,"combines":["Tổ chức lực lượng cách mạng","Quyền dân tộc tự quyết","Tư tưởng về vấn đề dân tộc"],"wrong_options":"Nhiễu đưa các tư tưởng có liên quan nhưng chưa giải thích trực tiếp đặc điểm tổ chức, hoặc đánh tráo quyền dân tộc với chủ nghĩa biệt lập.","wrong_option_details":[{"label":"A","identifiable_error":true,"mistake_kind":"Chọn nguyên tắc liên quan nhưng thiếu tính đặc trưng","reason":"Dừng ở chủ trương đoàn kết chung mà chưa giải thích việc tổ chức theo phạm vi từng dân tộc."},{"label":"B","identifiable_error":true,"mistake_kind":"Đồng nhất tự quyết với biệt lập","reason":"Hiểu việc tôn trọng tính độc lập của mỗi dân tộc thành phủ nhận liên hệ và hợp tác quốc tế."},{"label":"C","identifiable_error":true,"mistake_kind":"Nhầm mục tiêu ưu tiên với nguyên tắc tổ chức","reason":"Chọn nhiệm vụ chiến lược quen thuộc thay vì nguyên tắc thể hiện rõ trong cách xây dựng tổ chức."}],"cue_use":"needed in reasoning","difficulty_source":"Phải tìm nguyên tắc giải thích đồng thời các quyết định thay vì chọn một tư tưởng đúng nói chung","discrimination":"medium","evidence_uncertainty":null,"optional_path":null},{"part":"P1","idx":7,"sub":null,"topic":"Bảo vệ Tổ quốc sau thống nhất: đấu tranh bảo vệ biên giới","grade":12,"given":"Một khoảng thời gian sau khi đất nước thống nhất và các nhiệm vụ thuộc nhiều giai đoạn.","task":"Chọn nhiệm vụ thực tế thuộc khoảng thời gian được giới hạn.","reasoning":["Nhớ các nhiệm vụ lớn sau thống nhất.","Đối chiếu từng nhiệm vụ với giới hạn thời gian."],"steps":2,"combines":["Niên biểu sau thống nhất","Nhiệm vụ xây dựng và bảo vệ Tổ quốc"],"wrong_options":"Nhiễu lấy nhiệm vụ tiêu biểu ở giai đoạn trước hoặc những bước phát triển về sau.","wrong_option_details":[{"label":"A","identif