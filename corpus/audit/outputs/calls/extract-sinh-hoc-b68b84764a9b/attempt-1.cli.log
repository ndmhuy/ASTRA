ật theo sự thích nghi nhiệt độ.","reasoning":"Nhận diện mức nhiệt đặc trưng của môi trường; đối chiếu với cách phân nhóm theo nhiệt độ.","steps":2,"combines":["Sinh trưởng vi sinh vật","Ảnh hưởng của nhiệt độ"],"wrong_options":"Các phương án nhiễu đều chuyển sang những nhóm có nhiệt độ sinh trưởng thuận lợi cao hơn điều kiện được nêu.","wrong_option_details":[{"label":"A","identifiable_error":true,"mistake_kind":"Nhầm khoảng nhiệt độ thuận lợi","reason":"Áp dụng đặc trưng của nhóm thích nghi với mức nhiệt trung bình cho môi trường lạnh."},{"label":"B","identifiable_error":true,"mistake_kind":"Đảo cực thích nghi nhiệt","reason":"Đồng nhất khả năng sống trong điều kiện cực đoan với khả năng chịu nhiệt rất cao."},{"label":"C","identifiable_error":true,"mistake_kind":"Nhầm hướng thích nghi","reason":"Chọn nhóm thích nghi với nhiệt cao thay cho nhóm thích nghi với nhiệt thấp."}],"cue_use":"given as a cue","difficulty_source":"Điều kiện môi trường gợi trực tiếp tên nhóm","discrimination":"low","optional_path":null,"evidence_uncertainty":null},{"part":"P1","idx":5,"sub":null,"topic":"Môi trường và các nhân tố sinh thái: các loại môi trường sống","grade":12,"given":"Một sinh vật quen thuộc có môi trường sống điển hình.","task":"Xác định loại môi trường sống của sinh vật.","reasoning":"Nhớ nơi sống điển hình; ghép với nhóm môi trường tương ứng.","steps":2,"combines":["Môi trường sống"],"wrong_options":"Các phương án nhiễu đưa ra những loại môi trường không phù hợp với nơi sống điển hình của sinh vật.","wrong_option_details":[{"label":"B","identifiable_error":true,"mistake_kind":"Nhầm nơi sống với quan hệ dinh dưỡng","reason":"Có thể đồng nhất việc sử dụng sinh vật khác làm thức ăn với sống trên hoặc trong cơ thể sinh vật."},{"label":"C","identifiable_error":false,"mistake_kind":null,"reason":"Môi trường được đề xuất trái rõ với đặc điểm sống quen thuộc, không gợi một sai lầm chuyên môn cụ thể."},{"label":"D","identifiable_error":false,"mistake_kind":null,"reason":"Có thể loại bằng hiểu biết phổ thông về nơi sống, không cần phân biệt khái niệm sâu."}],"cue_use":"given as a cue","difficulty_source":"Nhận biết nơi sống từ kiến thức phổ thông","discrimination":"low","optional_path":null,"evidence_uncertainty":null},{"part":"P1","idx":6,"sub":null,"topic":"Dinh dưỡng và tiêu hóa ở động vật: các giai đoạn dinh dưỡng","grade":11,"given":"Mô tả một quá trình biến đổi thức ăn thành các thành phần đơn giản hơn.","task":"Gọi tên giai đoạn dinh dưỡng tương ứng.","reasoning":"Nhận diện bản chất biến đổi vật chất; phân biệt với tiếp nhận, vận chuyển vào cơ thể và tổng hợp chất.","steps":2,"combines":["Các giai đoạn dinh dưỡng"],"wrong_options":"Các phương án nhiễu thay quá trình phân giải thức ăn bằng các giai đoạn đứng trước hoặc sau nó.","wrong_option_details":[{"label":"B","identifiable_error":true,"mistake_kind":"Nhầm tiếp nhận với xử lí thức ăn","reason":"Đồng nhất đưa thức ăn vào cơ thể với biến đổi thành phần của thức ăn."},{"label":"C","identifiable_error":true,"mistake_kind":"Nhầm tiêu hóa với hấp thụ","reason":"Đồng nhất tạo chất đơn giản với đưa các chất đó qua bề mặt hấp thụ."},{"label":"D","identifiable_error":true,"mistake_kind":"Nhầm phân giải với tổng hợp","reason":"Đồng nhất phân cắt thức ăn với sử dụng nguyên liệu để xây dựng chất của cơ thể."}],"cue_use":"none","difficulty_source":"Phân biệt các thuật ngữ cơ bản bằng định nghĩa","discrimination":"low","optional_path":null,"evidence_uncertainty":null},{"part":"P1","idx":7,"sub":null,"topic":"Bài tiết và cân bằng nội môi: điều hòa áp suất thẩm thấu","grade":11,"given":"Sơ đồ chỉ được mô tả bằng lời về đường thần kinh và hormone điều hòa nước trong cơ thể.","task":"Chọn nhận định sai về các thành phần và tác dụng của cơ chế điều hòa.","reasoning":"Theo dõi các nhánh điều hòa trong sơ đồ; xác định tác dụng giữ nước của hormone; kiểm tra chiều tác động lên áp suất thẩm thấu.","steps":3,"combines":["Cân bằng nội môi","Điều hòa hormone","Tái hấp thụ nước ở thận"],"wrong_options":"Đây là câu chọn phát biểu sai; các lựa chọn không được chọn đều phù hợp với cơ chế, nên nhiễu chủ yếu khai thác việc đọc nhầm yêu cầu hoặc nhầm vị trí tổng hợp và tiết hormone.","wrong_option_details":[{"label":"A","identifiable_error":true,"mistake_kind":"Đảo chiều phản hồi sinh lí","reason":"Chọn phương án này đòi hỏi hiểu sai quan hệ giữa tình trạng thiếu nước tương đối và cảm giác khát."},{"label":"C","identifiable_error":true,"mistake_kind":"Nhầm nơi tổng hợp với nơi dự trữ hormone","reason":"Người chọn có thể cho rằng hormone phải được tổng hợp tại chính nơi dự trữ và giải phóng."},{"label":"D","identifiable_error":true,"mistake_kind":"Bỏ qua cơ quan thực hiện đáp ứng","reason":"Chỉ chú ý trung tâm điều hòa mà không nhận vai trò điều chỉnh lượng nước của cơ quan bài tiết."}],"cue_use":"none","difficulty_source":"Kiểm tra đúng chiều tác dụng của hormone trong vòng điều hòa","discrimination":"medium","optional_path":null,"evidence_uncertainty":"Chỉ có mô tả sơ đồ; quan hệ chức năng cần thiết vẫn được thể hiện bằng lời."},{"part":"P1","idx":8,"sub":null,"topic":"Học thuyết di truyền Mendel: phép lai một tính trạng trội hoàn toàn","grade":12,"given":"Quan hệ trội lặn của một tính trạng và các cặp kiểu gene bố mẹ.","task":"Chọn phép lai bảo đảm toàn bộ đời con biểu hiện tính trạng lặn.","reasoning":"Suy ra kiểu gene bắt buộc của kiểu hình lặn; xác định bố mẹ chỉ tạo loại giao tử phù hợp.","steps":2,"combines":["Quan hệ trội lặn","Phân li allele"],"wrong_options":"Các phương án nhiễu nhầm đồng nhất đời con với đồng nhất kiểu hình lặn hoặc bỏ qua giao tử mang allele trội.","wrong_option_details":[{"label":"A","identifiable_error":true,"mistake_kind":"Đảo quan hệ trội lặn","reason":"Chọn cặp đồng hợp mang allele trội cho mục tiêu tạo toàn bộ kiểu hình lặn."},{"label":"C","identifiable_error":true,"mistake_kind":"Nhầm dị hợp với biểu hiện lặn","reason":"Cho rằng có allele lặn trong kiểu gene đã đủ để biểu hiện tính trạng lặn."},{"label":"D","identifiable_error":true,"mistake_