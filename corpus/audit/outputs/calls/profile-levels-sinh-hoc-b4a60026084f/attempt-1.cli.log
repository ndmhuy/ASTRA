ôi trường.", "task": "Kiểm tra cách diễn giải điểm uốn và quan hệ giữa tốc độ tăng trưởng với kích thước quần thể.", "reasoning": "Xác định ý nghĩa của độ dốc đường cong; nhận ra điểm uốn gắn với tốc độ tăng tổng lớn nhất; phân biệt thời điểm đổi xu hướng tốc độ với thời điểm bắt đầu có tác động giới hạn; kiểm tra phát biểu về dạng quan hệ giữa các đại lượng.", "combines": ["Tăng trưởng logistic", "Tốc độ tăng trưởng", "Đọc độ dốc đồ thị"], "cue_use": "none", "evidence_uncertainty": null}, {"ref": "4b4716b94db4|P2|4|a", "part": "P2", "idx": 4, "sub": "a", "topic": "Các phân tử sinh học: thành phần nucleotide của RNA", "grade": 10, "given": "Bảng số lượng các loại đơn phân, có tổng và một ô thành phần còn thiếu.", "task": "Kiểm tra giá trị được đề xuất cho ô chưa biết.", "reasoning": "Chọn hàng dữ liệu liên quan; lấy tổng trừ các thành phần đã biết; so sánh phần còn lại với giá trị đề xuất.", "combines": ["Thành phần nucleic acid", "Bảo toàn tổng số đơn phân"], "cue_use": "needed in reasoning", "evidence_uncertainty": "Khóa xác định phát biểu sai; không có lời giải tương ứng để quy lỗi số học cho một thao tác cụ thể hơn."}, {"ref": "4b4716b94db4|P2|4|b", "part": "P2", "idx": 4, "sub": "b", "topic": "Các phân tử sinh học: phân biệt polysaccharide và nucleic acid", "grade": 10, "given": "Một phân tử được nhận diện qua loại đường đơn cấu tạo nên nó.", "task": "Đánh giá khả năng phân tử đảm nhiệm chức năng di truyền trong nhân.", "reasoning": "Suy ra nhóm phân tử từ đơn phân; đối chiếu với nhóm chất lưu giữ thông tin di truyền của tế bào.", "combines": ["Đơn phân và đại phân tử", "Chức năng vật chất di truyền"], "cue_use": "given as a cue", "evidence_uncertainty": null}, {"ref": "4b4716b94db4|P2|4|c", "part": "P2", "idx": 4, "sub": "c", "topic": "Cấu trúc tế bào nhân thực: vị trí của DNA trong tế bào", "grade": 10, "given": "Thành phần base của một phân tử và điều kiện bổ sung về sự bằng nhau giữa các loại base.", "task": "Đánh giá các vị trí tế bào có thể chứa phân tử đó.", "reasoning": "Nhận diện DNA từ thành phần base; kiểm tra dấu hiệu phù hợp với cấu trúc bổ sung; nhớ các cấu trúc tế bào có hệ gene riêng.", "combines": ["Thành phần DNA", "Nguyên tắc bổ sung", "Cấu trúc tế bào nhân thực"], "cue_use": "needed in reasoning", "evidence_uncertainty": null}, {"ref": "4b4716b94db4|P2|4|d", "part": "P2", "idx": 4, "sub": "d", "topic": "Gene và quá trình truyền đạt thông tin di truyền: chiều tổng hợp nucleic acid", "grade": 12, "given": "Các phân tử nucleic acid được nhận diện từ bảng thành phần của một tế bào thực vật.", "task": "Đánh giá khả năng tạo phân tử này dựa trên phân tử kia trong bối cảnh đã cho.", "reasoning": "Nhận diện từng loại nucleic acid; xác định chiều truyền thông tin được đề xuất; kiểm tra cơ chế và điều kiện enzyme cần thiết so với bối cảnh tế bào.", "combines": ["Nhận diện DNA và RNA", "Phiên mã", "Phiên mã ngược"], "cue_use": "given as a cue", "evidence_uncertainty": "Khóa xác định sai nhưng câu chữ không nêu rõ giới hạn đối với phiên mã ngược; thiếu điều kiện để đánh giá chắc mức phân hóa và lỗi nhận thức."}, {"ref": "4b4716b94db4|P3|1|None", "part": "P3", "idx": 1, "sub": null, "topic": "Tiến hóa lớn và quá trình phát sinh chủng loại: đọc cây phát sinh", "grade": 12, "given": "Cây phân nhánh có các đặc điểm phát sinh gắn tại những vị trí trên nhánh và một loài đích.", "task": "Liệt kê các mã đặc điểm được loài đích thừa hưởng theo thứ tự yêu cầu.", "reasoning": "Xác định nhánh tận cùng của loài đích; lần ngược đường nối về gốc; thu các đặc điểm xuất hiện trên đường tổ tiên; sắp mã theo quy cách trả lời.", "combines": ["Cây phát sinh chủng loại", "Đặc điểm chung có nguồn gốc", "Đọc sơ đồ"], "cue_use": "needed in reasoning", "evidence_uncertainty": null}, {"ref": "4b4716b94db4|P3|2|None", "part": "P3", "idx": 2, "sub": null, "topic": "Trao đổi vật chất và chuyển hóa năng lượng trong hệ sinh thái: tháp sinh khối", "grade": 12, "given": "Các tháp sinh khối có tương quan bề rộng giữa các bậc dinh dưỡng khác nhau.", "task": "Sắp xếp các hệ sinh thái theo mức ổn định được suy từ hình dạng tháp.", "reasoning": "Đọc tương quan sinh khối giữa các bậc; so sánh mức hỗ trợ của bậc dưới đối với bậc trên; áp dụng quy ước suy ổn định từ dạng tháp; sắp thứ tự.", "combines": ["Tháp sinh khối", "Bậc dinh dưỡng", "Ổn định hệ sinh thái"], "cue_use": "needed in reasoning", "evidence_uncertainty": "Khóa cung cấp thứ tự nhưng sinh khối tức thời và hình dạng tháp không đủ xác định ổn định thực tế nếu thiếu tốc độ tái tạo, dòng năng lượng và biến động thời gian; mức phân hóa phụ thuộc quy ước giải bài chưa được nêu."}, {"ref": "4b4716b94db4|P3|3|None", "part": "P3", "idx": 3, "sub": null, "topic": "Quần xã sinh vật: cạnh tranh và tác động của sinh vật ăn thịt", "grade": 12, "given": "Các đồ thị biến thiên độ che phủ của các loài cùng sử dụng nguồn sống, ở điều kiện có và loại trừ sinh vật ăn thịt, kèm thông tin mùa vụ.", "task": "Chọn các nhận định được bằng chứng về biến động và quan hệ sinh thái hỗ trợ.", "reasoning": "Ghép đúng chú giải loài và điều kiện thí nghiệm; đọc cực trị trong từng điều kiện; so sánh phản ứng giữa các nghiệm thức; phân biệt ảnh hưởng của ăn thịt với thay đổi cạnh tranh; kiểm tra các suy luận về thích nghi mùa vụ.", "combines": ["Đọc đồ thị", "Thí nghiệm loại trừ", "Cạnh tranh khác loài", "Quan hệ ăn thịt", "Giới hạn suy luận nhân quả"], "cue_use": "needed in reasoning", "evidence_uncertainty": "Chú giải loài đổi kiểu nét và kí hiệu giữa các đồ thị nên phải đọc riêng từng hình. Dữ liệu hỗ trợ suy luận theo mô hình đề bài, chưa cô lập hoàn toàn mọi tác động trực tiếp và gián tiếp."}, {"ref": "4b4716b94db4|P3|4|None", "part": "P3", "idx": 4, "sub": null, "topic": "Di truyền học quần thể: cân bằng di truyền của gene nhiều allele", "grade": 12, "given": "Một quần thể ngẫu phối cân bằng với tần số một allele đã biết và các allele còn lại có tần số bằng nhau.", "task": "Tính tổng tần số các kiểu gene đồng hợp.", "reasoning": "Tính phần tần số còn lại; chia đều cho các allele chưa biết; bình phương tần số từng allele để tính đồng hợp; cộng và đổi sang đơn vị trả lời.", "combines": ["Tần số allele", "Cân bằng Hardy–Weinberg", "Tổng tần số đồng hợp"], "cue_use": "needed in reasoning", "evidence_uncertainty": null}, {"ref": "4b4716b94db4|P3|5|None", "part": "P3", "idx": 5, "sub": null, "topic": "DNA và cơ chế tái bản DNA: RNA mồi tại các đơn vị tái bản", "grade": 12, "given": "Số đơn vị tái bản và số đoạn tổng hợp gián đoạn trong từng đơn vị của DNA nhân thực.", "task": "Tính tổng số đoạn mồi cần sử dụng.", "reasoning": "Gắn mỗi đoạn tổng hợp gián đoạn với một mồi; xác định phần mồi khởi đầu cho các mạch tổng hợp liên tục tại mỗi đơn vị hai chạc; cộng số mồi trên toàn phân tử.", "combines": ["Tái bản hai chiều", "Mạch liên tục và gián đoạn", "Vai trò RNA mồi"], "cue_use": "needed in reasoning", "evidence_uncertainty": null}, {"ref": "4b4716b94db4|P3|6|None", "part": "P3", "idx": 6, "sub": null, "topic": "Di truyền học người: tính trạng chịu ảnh hưởng của giới tính và xác suất phả hệ", "grade": 12, "given": "Phả hệ có biểu hiện phụ thuộc giới tính, quy tắc biểu hiện của các kiểu gene và thông tin cân bằng di truyền của quần thể xuất thân người phối ngẫu.", "task": "Tính xác suất sinh con thuộc giới và kiểu hình được yêu cầu.", "reasoning": "Đổi kiểu hình từng giới thành các khả năng kiểu gene; dùng quan hệ huyết thống để xác định trọng số kiểu gene của người trong phả hệ; suy tần số allele từ tỉ lệ kiểu hình quần thể dưới giả định cơ cấu giới; điều kiện hóa kiểu gene người phối ngẫu theo giới và kiểu hình; kết hợp các khả năng bố mẹ với xác suất giới tính và làm tròn.", "combines": ["Đọc phả hệ", "Tính trạng chịu ảnh hưởng giới tính", "Cân bằng Hardy–Weinberg", "Xác suất có điều kiện", "Xác suất tổ hợp"], "cue_use": "needed in reasoning", "evidence_uncertainty": "Kết quả khóa phù hợp khi coi tần số allele giữa các giới như nhau và cơ cấu giới cân bằng; đề không nêu riêng cơ cấu giới khi cho tỉ lệ kiểu hình chung của quần thể."}]}
