", "topic": "Nguyên hàm: tính tuyến tính", "task": "Chọn họ nguyên hàm của biểu thức mới.", "reasoning": ["Tách nguyên hàm của tổng thành tổng các nguyên hàm.", "Tính nguyên hàm của hằng số và sử dụng họ nguyên hàm đã cho."], "steps": 2, "discrimination": "low", "difficulty_source": "Dùng trực tiếp dữ kiện nguyên hàm mà không biến đổi thừa.", "evidence_uncertainty": null}, {"part": "P1", "topic": "Cấp số nhân: số hạng tổng quát", "task": "Biểu diễn một số hạng được chỉ định theo dữ kiện ban đầu.", "reasoning": ["Xác định số lần nhân công bội từ số hạng đầu tới số hạng cần tìm.", "Áp dụng công thức số hạng tổng quát."], "steps": 2, "discrimination": "low", "difficulty_source": "Phân biệt công bội với công sai và kiểm soát chỉ số.", "evidence_uncertainty": null}, {"part": "P1", "topic": "Phương trình lôgarit cơ bản", "task": "Chọn nghiệm của phương trình.", "reasoning": ["Xác định điều kiện dương của đối số.", "Đổi phương trình lôgarit sang dạng lũy thừa.", "Giải phương trình bậc nhất và kiểm tra điều kiện."], "steps": 3, "discrimination": "low", "difficulty_source": "Chuyển đúng giữa dạng lôgarit và dạng lũy thừa.", "evidence_uncertainty": null}, {"part": "P1", "topic": "Cấp số cộng: truy hồi giữa các số hạng liên tiếp", "task": "Tính số hạng liền sau số hạng đầu.", "reasoning": ["Dùng quan hệ cộng công sai để chuyển sang số hạng kế tiếp.", "Thực hiện phép cộng có dấu."], "steps": 2, "discrimination": "low", "difficulty_source": "Thực hiện đúng phép cộng có dấu trong truy hồi trực tiếp.", "evidence_uncertainty": null}, {"part": "P1", "topic": "Nguyên hàm: quan hệ giữa nguyên hàm và đạo hàm", "task": "Chọn hàm số có nguyên hàm đã cho.", "reasoning": ["Chuyển yêu cầu về tính đạo hàm của nguyên hàm đã biết.", "Áp dụng quy tắc đạo hàm lũy thừa."], "steps": 2, "discrimination": "low", "difficulty_source": "Hiểu chiều suy ngược từ nguyên hàm về hàm dưới dấu tích phân.", "evidence_uncertainty": null}]
