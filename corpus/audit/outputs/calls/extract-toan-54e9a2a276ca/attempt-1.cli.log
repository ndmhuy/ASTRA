","Phương trình bậc nhất"],"wrong_options":"Một phương án xuất phát từ việc cho đối số bằng giá trị không thuộc miền xác định; các phương án còn lại không thể gắn chắc với một lỗi biến đổi phổ biến.","wrong_option_details":[{"label":"A","identifiable_error":true,"mistake_kind":"Nhầm giá trị lôgarit với đối số","reason":"Cho đối số bằng vế phải thay vì chuyển sang dạng lũy thừa, đồng thời bỏ kiểm tra miền xác định."},{"label":"C","identifiable_error":false,"mistake_kind":null,"reason":"Không thấy một lỗi biến đổi đơn lẻ, phổ biến đủ giải thích riêng phương án này."},{"label":"D","identifiable_error":false,"mistake_kind":null,"reason":"Không đủ căn cứ quy phương án này cho một ngộ nhận cụ thể về lôgarit."}],"cue_use":"needed in reasoning","difficulty_source":"Áp dụng trực tiếp định nghĩa lôgarit và kiểm tra điều kiện.","discrimination":"low","evidence_uncertainty":null,"optional_path":null},{"part":"P1","idx":3,"sub":null,"topic":"Tính đơn điệu và cực trị của hàm số: đọc cực trị từ đồ thị","grade":12,"given":"Đồ thị có các điểm cực trị và các đường dóng thể hiện tọa độ.","task":"Chọn giá trị cực đại của hàm số.","reasoning":["Xác định điểm cực đại trên đồ thị.","Đọc tung độ của điểm đó và đối chiếu lựa chọn."],"steps":2,"combines":["Đọc đồ thị","Khái niệm cực trị"],"wrong_options":"Các phương án nhiễu lần lượt dùng hoành độ cực đại, hoành độ cực tiểu hoặc giá trị cực tiểu.","wrong_option_details":[{"label":"A","identifiable_error":true,"mistake_kind":"Nhầm điểm đạt cực trị với giá trị cực trị","reason":"Đọc hoành độ thay cho tung độ tại điểm cực đại."},{"label":"B","identifiable_error":true,"mistake_kind":"Nhầm loại cực trị và loại tọa độ","reason":"Lấy hoành độ của điểm cực tiểu thay cho giá trị cực đại."},{"label":"D","identifiable_error":true,"mistake_kind":"Nhầm cực đại với cực tiểu","reason":"Đọc đúng tung độ một điểm cực trị nhưng chọn sai loại cực trị."}],"cue_use":"given as a cue","difficulty_source":"Phân biệt giá trị cực trị với hoành độ đạt cực trị.","discr