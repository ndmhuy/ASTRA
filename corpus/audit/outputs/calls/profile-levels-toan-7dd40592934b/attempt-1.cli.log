hối tròn xoay", "Tích phân xác định", "Làm tròn số"], "cue_use": "needed in reasoning", "evidence_uncertainty": null}, {"ref": "023e74626dd8|P3|2|None", "part": "P3", "idx": 2, "sub": null, "topic": "Khoảng cách từ điểm đến mặt phẳng trong hình lập phương", "grade": 11, "given": "Một hình lập phương được mô tả bằng các đỉnh, độ dài cạnh, trung điểm của một cạnh và mặt phẳng qua các điểm được chỉ định; câu này không kèm hình vẽ riêng.", "task": "Tính khoảng cách từ một đỉnh tới mặt phẳng rồi làm tròn.", "reasoning": ["Chọn hệ tọa độ theo các cạnh vuông góc của hình lập phương.", "Xác định tọa độ trung điểm, điểm cần tính khoảng cách và các điểm thuộc mặt phẳng.", "Lập phương trình mặt phẳng từ các điểm đã biết.", "Áp dụng công thức khoảng cách từ điểm tới mặt phẳng.", "Làm tròn kết quả cuối theo yêu cầu."], "combines": ["Hình lập phương", "Trung điểm", "Phương trình mặt phẳng", "Khoảng cách từ điểm tới mặt phẳng"], "cue_use": "needed in reasoning", "evidence_uncertainty": "Xếp lớp theo bài khoảng cách trong hình học không gian; chuỗi giải bằng tọa độ huy động thêm phương trình mặt phẳng thuộc lớp sau."}, {"ref": "023e74626dd8|P3|3|None", "part": "P3", "idx": 3, "sub": null, "topic": "Quy tắc đếm: điền số có ràng buộc đồng dư theo hàng và cột", "grade": 10, "given": "Một tập số nguyên phân biệt và hình lưới bậc thang có các ô được xác định theo hàng, cột; các số phải dùng hết và không được trùng lớp dư trong cùng hàng hoặc cột.", "task": "Đếm các phép gán hợp lệ vào vị trí có nhãn rồi thực hiện phép chuẩn hóa được yêu cầu.", "reasoning": ["Chuyển điều kiện về hiệu chia hết thành điều kiện các lớp dư khác nhau trong từng hàng và cột.", "Phân loại các số theo lớp dư và xác định số phần tử của mỗi lớp.", "Khai thác các hàng, cột dài và hình dạng bậc thang để suy ra ràng buộc lên vị trí của từng lớp dư.", "Đếm các cấu hình lớp dư hợp lệ, phân biệt các nhánh và tránh đếm lặp.", "Đếm các hoán vị của những số phân biệt trong mỗi lớp dư.", "Nhân các hệ số đếm rồi thực hiện phép chuẩn hóa."], "combines": ["Chia hết và đồng dư", "Quy tắc đếm", "Hoán vị", "Ràng buộc hàng và cột"], "cue_use": "needed in reasoning", "evidence_uncertainty": "Các công cụ đếm được xếp theo chương tổ hợp; điều kiện đồng dư huy động kiến thức số học từ cấp học trước."}, {"ref": "023e74626dd8|P3|4|None", "part": "P3", "idx": 4, "sub": null, "topic": "Ứng dụng đạo hàm: tối đa hóa lợi nhuận trên miền công suất", "grade": 12, "given": "Các hàm chi phí, doanh thu theo sản lượng và một khoảng sản lượng khả thi.", "task": "Tính lợi nhuận lớn nhất trên miền cho phép.", "reasoning": ["Lập hàm lợi nhuận bằng doanh thu trừ chi phí.", "Tính đạo hàm và tìm các điểm dừng thuộc miền khả thi.", "Dùng chiều biến thiên hoặc so sánh với các đầu mút để xác định điểm đạt lớn nhất.", "Tính lợi nhuận tại điểm đó."], "combines": ["Mô hình lợi nhuận", "Đạo hàm", "Giá trị lớn nhất trên đoạn"], "cue_use": "needed in reasoning", "evidence_uncertainty": null}, {"ref": "023e74626dd8|P3|5|None", "part": "P3", "idx": 5, "sub": null, "topic": "Mô hình tuyến tính: xác định tổng tiền từ đơn giá không đổi", "grade": null, "given": "Một bảng lượng hàng theo từng loại qua các lần giao dịch, tổng tiền đã biết ở một số lần và giả thiết đơn giá không đổi.", "task": "Tính tổng tiền của lần giao dịch còn thiếu.", "reasoning": ["Biểu diễn tổng tiền bằng tổ hợp tuyến tính của lượng từng loại hàng với đơn giá.", "Nhận ra vectơ lượng hàng cần hỏi tỉ lệ với một vectơ lượng hàng đã có tổng tiền.", "Dùng cùng hệ số tỉ lệ để suy ra tổng tiền cần tìm."], "combines": ["Mô hình tuyến tính", "Tỉ lệ thuận", "Đọc bảng dữ liệu"], "cue_use": "needed in reasoning", "evidence_uncertainty": "Không xác định một lớp duy nhất: lời giải ngắn dùng tỉ lệ thuận từ cấp học trước, còn cách giải hệ tuyến tính không có mục bài tương ứng rõ ràng trong danh mục tham chiếu."}, {"ref": "023e74626dd8|P3|6|None", "part": "P3", "idx": 6, "sub": null, "topic": "Xác suất cổ điển: đếm vị trí màu thỏa mãn điều kiện hình học", "grade": 10, "given": "Một đa giác đều có hình vẽ, các vật phân biệt thuộc những nhóm màu với số lượng cố định và phép gán ngẫu nhiên vào các đỉnh; yêu cầu mọi hình vuông tạo bởi các đỉnh đều gặp một màu chỉ định.", "task": "Tính xác suất thỏa mãn điều kiện rồi nhân với hệ số được yêu cầu.", "reasoning": ["Nhận diện tất cả hình vuông nội tiếp có đỉnh thuộc đa giác và quan hệ giữa các tập đỉnh của chúng.", "Rút không gian mẫu từ phép gán vật phân biệt về phép chọn vị trí của màu chỉ định, giải thích tính đồng khả năng.", "Chuyển điều kiện hình học thành yêu cầu mỗi nhóm đỉnh của một hình vuông đều nhận màu chỉ định.", "Phân loại các cách phân bố số vị trí mang màu chỉ định giữa các nhóm.", "Đếm các lựa chọn vị trí thuận lợi trong từng kiểu phân bố.", "Lập xác suất và thực hiện phép nhân cuối."], "combines": ["Hình học đa giác đều", "Hình vuông nội tiếp", "Tổ hợp", "Quy tắc đếm", "Xác suất cổ điển"], "cue_use": "needed in reasoning", "evidence_uncertainty": null}, {"ref": "adb051fd8253|P1|1|None", "part": "P1", "idx": 1, "sub": null, "topic": "Các số đặc trưng đo xu thế trung tâm của mẫu số liệu ghép nhóm: nhóm chứa mốt", "grade": 11, "given": "Bảng các khoảng giá trị và tần số tương ứng của một mẫu ghép nhóm.", "task": "Chọn khoảng chứa mốt của mẫu.", "reasoning": ["So sánh các tần số trong bảng.", "Chọn nhóm có tần số lớn nhất."], "combines": ["Thống kê số liệu ghép nhóm"], "cue_use": "needed in reasoning", "evidence_uncertainty": null}, {"ref": "adb051fd8253|P1|2|None", "part": "P1", "idx": 2, "sub": null, "topic": "Ứng dụng hình học của tích phân: thể tích khối tròn xoay", "grade": 12, "given": "Một hàm liên tục không âm trên đoạn và miền phẳng quay quanh trục hoành.", "task": "Chọn biểu thức tính thể tích khối được tạo thành.", "reasoning": ["Nhận diện bán kính tiết diện vuông góc với trục quay.", "Áp dụng công thức tích phân diện tích tiết diện tròn."], "combines": ["Tích phân", "Thể tích khối tròn xoay"], "cue_use": "given as a cue", "evidence_uncertainty": null}, {"ref": "adb051fd8253|P1|3|None", "part": "P1", "idx": 3, "sub": null, "topic": "Phương trình, bất phương trình mũ và lôgarit: bất phương trình lôgarit cơ bản", "grade": 11, "given": "Bất phương trình lôgarit có cơ số lớn hơn đơn vị và đối số là biểu thức bậc nhất.", "task": "Chọn tập nghiệm dưới dạng khoảng.", "reasoning": ["Đặt điều kiện dương của đối số.", "Dùng tính đồng biến để chuyển sang bất phương trình đại số.", "Giao nghiệm đại số với điều kiện và xác định các đầu mút."], "combines": ["Bất phương trình lôgarit", "Tập hợp và khoảng"], "cue_use": "needed in reasoning", "evidence_uncertainty": null}, {"ref": "adb051fd8253|P1|4|None", "part": "P1", "idx": 4, "sub": null, "topic": "Tính đơn điệu và cực trị của hàm số: dấu đạo hàm", "grade": 12, "given": "Bảng dấu đạo hàm có các điểm triệt tiêu, trong đó có điểm không đổi dấu.", "task": "Xác định số điểm cực trị.", "reasoning": ["Kiểm tra dấu đạo hàm ở hai phía từng điểm triệt tiêu.", "Đếm các điểm thực sự có sự đổi dấu."], "combines": ["Dấu đạo hàm", "Cực trị hàm số"], "cue_use": "given as a cue", "evidence_uncertainty": null}, {"ref": "adb051fd8253|P1|5|None", "part": "P1", "idx": 5, "sub": null, "topic": "Phương trình mặt phẳng: vectơ pháp tuyến", "grade": 12, "given": "Phương trình tổng quát của một mặt phẳng trong hệ tọa độ không gian.", "task": "Chọn một vectơ pháp tuyến của mặt phẳng.", "reasoning": ["Lấy các hệ số của những biến tọa độ theo đúng thứ tự.", "Đối chiếu với các vectơ được cho."], "combines": ["Phương trình mặt phẳng"], "cue_use": "needed in reasoning", "evidence_uncertainty": null}, {"ref": "adb051fd8253|P1|6|None", "part": "P1", "idx": 6, "sub": null, "topic": "Cấp số nhân: số hạng tổng quát", "grade": 11, "given": "Số hạng đầu, công bội âm và vị trí số hạng cần tìm.", "task": "Tính số hạng được chỉ định.", "reasoning": ["Xác định số lần nhân công bội từ số hạng đầu.", "Thay vào công thức và tính lũy thừa có dấu."], "combines": ["Cấp số nhân", "Lũy thừa"], "cue_use": "needed in reasoning", "evidence_uncertainty": null}, {"ref": "adb051fd8253|P1|7|None", "part": "P1", "idx": 7, "sub": null, "topic": "Vectơ trong không gian: quy tắc hình hộp", "grade": 12, "given": "Hình hộp có hình phối cảnh và tổng các vectơ theo những phương cạnh.", "task": "Chọn vectơ biểu diễn tổng đã cho.", "reasoning": ["Dời vectơ cạnh bên về cùng gốc với các vectơ còn lại.", "Dùng quy tắc hình hộp xác định đường chéo có hướng tương ứng."], "combines": ["Phép cộng vectơ", "Hình hộp"], "cue_use": "none", "evidence_uncertainty": null}, {"ref": "adb051fd8253|P1|8|None", "part": "P1", "idx": 8, "sub": null, "topic": "Nguyên hàm: nguyên hàm của hàm lũy thừa", "grade": 12, "given": "Một hàm đơn thức với số mũ nguyên dương.", "task": "Chọn họ nguyên hàm.", "reasoning": ["Tăng số mũ theo quy tắc nguyên hàm lũy thừa.", "Chia cho số mũ mới và bổ sung hằng số tùy ý."], "combines": ["Nguyên hàm"], "cue_use": "needed in reasoning", "evidence_uncertainty": null}, {"ref": "adb051fd8253|P1|9|None", "part": "P1", "idx": 9, "sub": null, "topic": "Thể tích: khối chóp có các cạnh tại một đỉnh đôi một vuông góc", "grade": 11, "given": "Một khối chóp tam giác có các cạnh xuất phát từ cùng đỉnh đôi một vuông góc và biết độ dài.", "task": "Chọn biểu thức thể tích theo các độ dài.", "reasoning": ["Chọn tam giác vuông làm đáy và cạnh vuông góc còn lại làm chiều cao.", "Tính diện tích đáy rồi áp dụng công thức thể tích khối chóp."], "combines": ["Quan hệ vuông góc trong không gian", "Diện tích tam giác", "Thể tích khối chóp"], "cue_use": "none", "evidence_uncertainty": null}, {"ref": "adb051fd8253|P1|10|None", "part": "P1", "idx": 10, "sub": null, "topic": "Hàm số lượng giác: tập xác định của hàm tang", "grade": 11, "given": "Một hàm lượng giác cơ bản và các tập loại trừ được viết bằng họ góc.", "task": "Chọn tập xác định của hàm.", "reasoning": ["Biểu diễn điều kiện mẫu của tỉ số lượng giác khác không.", "Xác định đầy đủ họ góc bị loại và chọn tập tương ứng."], "combines": ["Hàm số lượng giác", "Tập xác định"], "cue_use": "none", "evidence_uncertainty": null}, {"ref": "adb051fd8253|P1|11|None", "part": "P1", "idx": 11, "sub": null, "topic": "Hệ trục tọa độ trong không gian: tọa độ vectơ theo cơ sở đơn vị", "grade": 12, "given": "Một vectơ được phân tích theo các vectơ đơn vị có thứ tự xác định.", "task": "Chọn bộ tọa độ của vectơ.", "reasoning": ["Đọc hệ số của từng vectơ đơn vị theo thứ tự trục.", "Ghép các hệ số thành bộ tọa độ."], "combines": ["Hệ trục tọa độ trong không gian"], "cue_use": "needed in reasoning", "evidence_uncertainty": null}, {"ref": "adb051fd8253|P1|12|None", "part": "P1", "idx": 12, "sub": null, "topic": "Tìm GTLN và GTNN của hàm số: đọc đồ thị trên đoạn", "grade": 12, "given": "Đồ thị có vạch chiếu tọa độ và một đoạn xét giá trị.", "task": "Tính tổng giá trị lớn nhất và nhỏ nhất trên đoạn.", "reasoning": ["Quan sát toàn bộ phần đồ thị thuộc đoạn, kể cả các đầu mút.", "Đọc tung độ lớn nhất và nhỏ nhất.", "Cộng các giá trị đọc được."], "combines": ["Đọc đồ thị", "Giá trị lớn nhất và giá trị nhỏ nhất"], "cue_use": "needed in reasoning", "evidence_uncertainty": null}]}
