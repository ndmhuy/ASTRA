 nhóm có cùng trạng thái được dùng làm điều kiện.", "Xác định phần giao với kết quả phân loại cần xét.", "Lập tỉ số trong nhóm điều kiện và so sánh với ngưỡng."], "combines": ["Xác suất có điều kiện", "Xác suất biên", "Đọc dữ liệu chéo"], "cue_use": "needed in reasoning", "evidence_uncertainty": null}, {"ref": "023e74626dd8|P2|4|a", "part": "P2", "idx": 4, "sub": "a", "topic": "Biểu thức tọa độ của vectơ trong không gian", "grade": 12, "given": "Tọa độ các đầu mút của một chuyển động thẳng và một vectơ dịch chuyển được đề xuất.", "task": "Kiểm tra tọa độ vectơ nối điểm xuất phát tới điểm kết thúc.", "reasoning": ["Lấy tọa độ điểm kết thúc trừ tọa độ điểm xuất phát.", "Đối chiếu từng thành phần của vectơ."], "combines": ["Tọa độ điểm", "Hiệu tọa độ"], "cue_use": "needed in reasoning", "evidence_uncertainty": null}, {"ref": "023e74626dd8|P2|4|b", "part": "P2", "idx": 4, "sub": "b", "topic": "Phương trình tham số của đường thẳng trong không gian", "grade": 12, "given": "Các điểm xác định một đường thẳng và một hệ phương trình tham số được đề xuất.", "task": "Kiểm tra hệ tham số có biểu diễn đúng đường thẳng hay không.", "reasoning": ["Xác định vectơ chỉ phương từ các điểm đã cho.", "Kiểm tra điểm đi qua của hệ tham số.", "Đối chiếu cả tọa độ không đổi với dữ kiện không gian."], "combines": ["Vectơ chỉ phương", "Phương trình tham số", "Điều kiện điểm thuộc đường thẳng"], "cue_use": "needed in reasoning", "evidence_uncertainty": null}, {"ref": "023e74626dd8|P2|4|c", "part": "P2", "idx": 4, "sub": "c", "topic": "Khoảng cách từ điểm chuyển động đến đường tròn trong không gian", "grade": 12, "given": "Một đường tròn nằm trong mặt phẳng tọa độ, một đoạn chuyển động ở độ cao không đổi, tỉ lệ đổi đơn vị và một giá trị khoảng cách nhỏ nhất đề xuất.", "task": "Kiểm tra khoảng cách nhỏ nhất từ điểm chuyển động tới đường tròn.", "reasoning": ["Chiếu chuyển động xuống mặt phẳng chứa đường tròn.", "Biểu diễn khoảng cách đến đường tròn qua khoảng cách từ hình chiếu tới tâm và độ cao.