": "none", "evidence_uncertainty": null}, {"ref": "686833f78102|P2|2|d", "part": "P2", "idx": 2, "sub": "d", "topic": "Thành tựu và bài học của công cuộc Đổi mới: độc lập tự chủ và hội nhập kinh tế", "grade": 12, "given": "Tư liệu nêu đồng thời yêu cầu tự chủ và chủ động tham gia kinh tế quốc tế.", "task": "Đánh giá quan hệ giữa tăng cường tự chủ và mức độ hội nhập.", "reasoning": ["Nhận diện các yêu cầu phát triển đồng thời trong tư liệu.", "Kiểm tra suy luận biến một yêu cầu thành lí do hạn chế yêu cầu kia."], "combines": ["Độc lập tự chủ kinh tế", "Hội nhập kinh tế quốc tế"], "cue_use": "none", "evidence_uncertainty": null}, {"ref": "686833f78102|P2|3|a", "part": "P2", "idx": 3, "sub": "a", "topic": "Cộng đồng ASEAN: mục tiêu nâng cao vị thế và vai trò quốc tế", "grade": 12, "given": "Bảng sự kiện về biến đổi trật tự thế giới, liên kết khu vực và chính sách kinh tế quốc tế.", "task": "Đánh giá động lực liên kết nhằm tăng khả năng tham gia các vấn đề chung.", "reasoning": ["Xác định sự kiện thể hiện quá trình tăng cường liên kết.", "Liên hệ hạn chế ảnh hưởng của từng quốc gia với lợi ích hành động tập thể.", "Đánh giá mục tiêu nâng cao vị thế chung."], "combines": ["Mục tiêu của cộng đồng khu vực", "Vị thế quốc tế của các nước vừa và nhỏ"], "cue_use": "given as a cue", "evidence_uncertainty": null}, {"ref": "686833f78102|P2|3|b", "part": "P2", "idx": 3, "sub": "b", "topic": "Trật tự thế giới sau Chiến tranh lạnh: chuyển biến quốc tế và khu vực", "grade": 12, "given": "Bảng thông tin gồm các mốc cùng sự kiện chính trị, kinh tế ở nhiều phạm vi.", "task": "Xác định phạm vi thời gian và nội dung chung của bảng.", "reasoning": ["Đối chiếu các mốc với ranh giới phân kì lịch sử.", "Khái quát phạm vi thế giới và khu vực của các sự kiện."], "combines": ["Phân kì trật tự thế giới", "Đọc bảng sự kiện lịch sử"], "cue_use": "needed in reasoning", "evidence_uncertainty": null}, {"ref": "686833f78102|P2|3|c", "part": "P2", "idx": 3, "sub": "c", "topic": "Cộng đồng ASEAN: thách thức kinh tế và yêu cầu tăng cường tự cường", "grade": 12, "given": "Bảng sự kiện có một biện pháp thương mại đơn phương tác động rộng cùng thông tin liên kết khu vực.", "task": "Đánh giá đồng thời rủi ro kinh tế và động lực điều chỉnh của các quốc gia chịu tác động.", "reasoning": ["Xác định cơ chế gây trở ngại cho trao đổi và tăng trưởng.", "Liên hệ cú sốc bên ngoài với nhu cầu giảm lệ thuộc và tăng sức chống chịu.", "Kiểm tra cả hệ quả bất lợi lẫn phản ứng thích nghi trong nhận định."], "combines": ["Liên kết kinh tế khu vực", "Tác động của bảo hộ thương mại", "Tự cường kinh tế"], "cue_use": "given as a cue", "evidence_uncertainty": "Bảng nêu sự kiện chính sách nhưng không cung cấp dữ liệu đo tác động; nhận định được xét theo cơ chế và khóa đáp án đã ghép."}, {"ref": "686833f78102|P2|3|d", "part": "P2", "idx": 3, "sub": "d", "topic": "Trật tự thế giới sau Chiến tranh lạnh: phân biệt nguyên nhân và biểu hiện chuyển biến", "grade": 12, "given": "Bảng sắp xếp sự tan rã của trật tự cũ cùng những chuyển biến diễn ra tiếp theo.", "task": "Kiểm tra tính hợp lí của việc dùng các biến đổi về sau để giải thích sự kiện trước đó.", "reasoning": ["Sắp xếp các hiện tượng theo thứ tự thời gian.", "Phân biệt nguyên nhân làm tan rã trật tự với biểu hiện của thời kì sau.", "Đánh giá quan hệ nhân quả được đề xuất."], "combines": ["Sự tan rã của trật tự hai cực", "Liên kết kinh tế và thay đổi tương quan sức mạnh", "Quan hệ thời gian và nhân quả"], "cue_use": "needed in reasoning", "evidence_uncertainty": null}, {"ref": "686833f78102|P2|4|a", "part": "P2", "idx": 4, "sub": "a", "topic": "Cách mạng tháng Tám và kháng chiến chống Mỹ: sự hình thành và chớp thời cơ", "grade": 12, "given": "Tư liệu chỉ đạo kết thúc chiến tranh cùng nhận định so sánh với một cuộc cách mạng trước đó.", "task": "Đánh giá điểm tương đồng về quá trình hình thành thời cơ.", "reasoning": ["Khôi phục quá trình phát triển thời cơ ở từng sự kiện.", "Phân biệt quá trình chuẩn bị, tạo thế với thời điểm hành động.", "Đối chiếu điểm chung được nhận định."], "combines": ["Thời cơ trong cách mạng giành chính quyền", "Thời cơ trong chiến tranh giải phóng"], "cue_use": "needed in reasoning", "evidence_uncertainty": null}, {"ref": "686833f78102|P2|4|b", "part": "P2", "idx": 4, "sub": "b", "topic": "Kháng chiến chống Mỹ: quyết tâm kết thúc chiến tranh khi thời cơ xuất hiện", "grade": 12, "given": "Tư liệu nhấn mạnh yêu cầu hành động khẩn trương cùng một nhận định về chủ trương trì hoãn.", "task": "Kiểm tra nhận định có phù hợp với ý chí chỉ đạo trong tư liệu hay không.", "reasoning": ["Xác định yêu cầu về tốc độ và thời điểm hành động.", "Đối chiếu với xu hướng kéo dài được nêu trong nhận định."], "combines": ["Đọc hiểu chỉ đạo chiến lược"], "cue_use": "none", "evidence_uncertainty": null}, {"ref": "686833f78102|P2|4|c", "part": "P2", "idx": 4, "sub": "c", "topic": "Kháng chiến chống Mỹ: kế thừa và phát triển nghệ thuật quân sự", "grade": 12, "given": "Tư liệu nêu phương thức tiến công khẩn trương, tập trung và tạo bất ngờ.", "task": "Đánh giá tính kế thừa và mục tiêu chiến lược của phương thức tác chiến.", "reasoning": ["Nhận diện các đặc điểm tác chiến từ tư liệu.", "Liên hệ với kinh nghiệm quân sự của những chiến dịch trước.", "Đánh giá sự phát triển của kinh nghiệm đó trong yêu cầu kết thúc chiến tranh."], "combines": ["Nghệ thuật quân sự", "Kinh nghiệm chiến dịch", "Mục tiêu chiến lược"], "cue_use": "given as a cue", "evidence_uncertainty": null}, {"ref": "686833f78102|P2|4|d", "part": "P2", "idx": 4, "sub": "d", "topic": "Kháng chiến chống Mỹ: chớp thời cơ chiến lược trong giai đoạn kết thúc", "grade": 12, "given": "Tư liệu chỉ đạo có thông tin xuất xứ, thời điểm và yêu cầu tác chiến.", "task": "Đối chiếu thời điểm ban hành cùng mục đích của phương châm hành động.", "reasoning": ["Đọc thời điểm từ phần xuất xứ và yêu cầu hành động trong tư liệu.", "Đối chiếu nhận định với mục đích tận dụng thời cơ đã nêu."], "combines": ["Đọc xuất xứ tư liệu", "Chỉ đạo chớp thời cơ"], "cue_use": "given as a cue", "evidence_uncertainty": null}]}
